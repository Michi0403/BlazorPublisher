.vs/
**/bin/
**/obj/
artifacts/
*.user
*.suo
*.db
*.pfx
*.snk
*.licx
PublisherStudio/runtime/
src/PublisherStudio.Web/node_modules/
src/PublisherStudio.Web/wwwroot/vendor/devextreme-dist/
src/PublisherStudio.Web/wwwroot/vendor/devexpress-aspnetcore-spreadsheet/
src/PublisherStudio.Web/wwwroot/vendor/jquery/
src/PublisherStudio.Web/wwwroot/vendor/devextreme-license.js
src/PublisherStudio.Web/wwwroot/vendor/devextreme-license.generated.js
src/PublisherStudio.Web/wwwroot/vendor/devextreme-license.meta.json
src/PublisherStudio.Web/wwwroot/vendor/devextreme-license.version
**/SpreadsheetHibernation/

# Downloaded authoritative LocalGPT protocol release package
packages/*.nupkg
packages/*.download

# Keep maintained build gates and localization catalogs visible to Git.
!Directory.Build.targets
!Build-LocalDevelopment.ps1
!Build-Release.ps1
!New-VerifiedSourcePackage.ps1
!build/
!build/*.ps1
!build/*.json
!build/*.sha256
!src/PublisherStudio.Web/Localization/
!src/PublisherStudio.Web/Localization/*.json

# Generated DocFX inputs, tool caches, print workspaces, and outputs
docs/input/
docs/api/
docs/_site/
docs/.tools/
docs/.print-book/
src/PublisherStudio.Web/wwwroot/help-docs/


!Update-GitHubPagesSnapshot.cmd

# Generated source/package staging and Python caches
__pycache__/
*.pyc
.publisherstudio-pages-*/

# The tracked Pages ZIP is maintained under .github/pages; generated site trees stay ignored.
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.github/scripts/
!.github/scripts/*.py
!.github/pages/
!.github/pages/README.md
!.github/pages/publisherstudio-kawaii-docs.zip
