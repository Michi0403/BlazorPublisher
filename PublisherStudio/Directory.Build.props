<Project>
  <PropertyGroup>
    <Authors>Michael Fleischer (Michi0403)</Authors>
    <RepositoryUrl>https://github.com/Michi0403/BlazorPublisher</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <LocalGptWireProtocolVersion>2.1.1</LocalGptWireProtocolVersion>
    <LocalGptWireProtocolPackageDirectory Condition="'$(LocalGptWireProtocolPackageDirectory)' == ''">$(MSBuildThisFileDirectory)packages</LocalGptWireProtocolPackageDirectory>
  </PropertyGroup>
</Project>
