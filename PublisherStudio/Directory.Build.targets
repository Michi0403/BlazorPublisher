<Project>
  <!--
    Direct Windows/Visual Studio builds must not bypass the monotonic logging baseline.
    The guard is Windows PowerShell 5.1 compatible. Release/development scripts run
    the same guard once and set SkipLoggingIntegrityGuard for nested MSBuild calls.
  -->
  <PropertyGroup>
    <LoggingIntegrityScript>$(MSBuildThisFileDirectory)build\Assert-LoggingIntegrity.ps1</LoggingIntegrityScript>
  </PropertyGroup>


  <PropertyGroup>
    <WireProtocolBootstrapScript>$(MSBuildThisFileDirectory)build\Ensure-WireProtocolPackage.ps1</WireProtocolBootstrapScript>
  </PropertyGroup>

  <Target Name="EnsurePublisherWireProtocolPackage"
          BeforeTargets="Restore;_GenerateRestoreProjectSpec;_GenerateRestoreGraphProjectEntry"
          Condition="'$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(SkipWireProtocolBootstrap)' != 'true' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(WireProtocolBootstrapScript)')"
           Text="LocalGPT protocol package bootstrap script is missing: $(WireProtocolBootstrapScript)" />
    <Exec Condition="Exists('$(WireProtocolBootstrapScript)')"
          Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(WireProtocolBootstrapScript)&quot; -Version &quot;$(LocalGptWireProtocolVersion)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherLoggingIntegrity"
          BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipLoggingIntegrityGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(LoggingIntegrityScript)')"
           Text="Logging integrity guard script is missing: $(LoggingIntegrityScript)" />
    <Exec Condition="Exists('$(LoggingIntegrityScript)')"
          Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(LoggingIntegrityScript)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
  </Target>

  <PropertyGroup>
    <OneWireArchitectureScript>$(MSBuildThisFileDirectory)build\Assert-OneWireArchitecture.ps1</OneWireArchitectureScript>
  </PropertyGroup>

  <Target Name="AssertPublisherOneWireArchitecture"
          BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipOneWireArchitectureGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(OneWireArchitectureScript)')"
           Text="1-Wire architecture guard script is missing: $(OneWireArchitectureScript)" />
    <Exec Condition="Exists('$(OneWireArchitectureScript)')"
          Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(OneWireArchitectureScript)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
  </Target>


  <PropertyGroup>
    <LocalizationIntegrityScript>$(MSBuildThisFileDirectory)build\Assert-LocalizationIntegrity.ps1</LocalizationIntegrityScript>
  </PropertyGroup>

  <Target Name="AssertPublisherLocalizationIntegrity"
          BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipLocalizationIntegrityGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(LocalizationIntegrityScript)')"
           Text="Localization integrity guard script is missing: $(LocalizationIntegrityScript)" />
    <Exec Condition="Exists('$(LocalizationIntegrityScript)')"
          Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(LocalizationIntegrityScript)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
  </Target>

</Project>
