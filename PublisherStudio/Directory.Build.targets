<Project>
  <PropertyGroup>
    <WireProtocolBootstrapScript>$(MSBuildThisFileDirectory)build\Ensure-WireProtocolPackage.ps1</WireProtocolBootstrapScript>
    <LoggingIntegrityScript>$(MSBuildThisFileDirectory)build\Assert-LoggingIntegrity.ps1</LoggingIntegrityScript>
    <OneWireArchitectureScript>$(MSBuildThisFileDirectory)build\Assert-OneWireArchitecture.ps1</OneWireArchitectureScript>
    <RuntimeValueOwnershipScript>$(MSBuildThisFileDirectory)build\Assert-RuntimeValueOwnership.ps1</RuntimeValueOwnershipScript>
    <LocalizationIntegrityScript>$(MSBuildThisFileDirectory)build\Assert-LocalizationIntegrity.ps1</LocalizationIntegrityScript>
    <OperationalDiagnosticsScript>$(MSBuildThisFileDirectory)build\Assert-OperationalDiagnostics.ps1</OperationalDiagnosticsScript>
    <InteractiveServerRenderModeScript>$(MSBuildThisFileDirectory)build\Assert-InteractiveServerRenderModes.ps1</InteractiveServerRenderModeScript>
    <AsyncContinuationScript>$(MSBuildThisFileDirectory)build\Assert-AsyncContinuationPolicy.ps1</AsyncContinuationScript>
    <ComponentDiagnosticsScript>$(MSBuildThisFileDirectory)build\Assert-ComponentDiagnostics.ps1</ComponentDiagnosticsScript>
    <MethodDiagnosticsPolicyScript>$(MSBuildThisFileDirectory)build\Assert-MethodDiagnostics.ps1</MethodDiagnosticsPolicyScript>
    <ApplicationStaticPolicyScript>$(MSBuildThisFileDirectory)build\Assert-ApplicationStaticPolicy.ps1</ApplicationStaticPolicyScript>
    <TextServiceOwnershipScript>$(MSBuildThisFileDirectory)build\Assert-TextServiceOwnership.ps1</TextServiceOwnershipScript>
    <IteratorExceptionPolicyScript>$(MSBuildThisFileDirectory)build\Assert-IteratorExceptionPolicy.ps1</IteratorExceptionPolicyScript>
    <SystemVariableInitializationScript>$(MSBuildThisFileDirectory)build\Assert-SystemVariableInitialization.ps1</SystemVariableInitializationScript>
    <PanelStudioInteractionLifecycleScript>$(MSBuildThisFileDirectory)build\Assert-PanelStudioInteractionLifecycle.ps1</PanelStudioInteractionLifecycleScript>
    <JavaScriptDiagnosticsScript>$(MSBuildThisFileDirectory)build\Assert-JavaScriptDiagnostics.ps1</JavaScriptDiagnosticsScript>
    <PublishConfigurationScript>$(MSBuildThisFileDirectory)build\Assert-PublishConfiguration.ps1</PublishConfigurationScript>
    <InstallerWorkflowScript>$(MSBuildThisFileDirectory)build\Assert-InstallerWorkflow.ps1</InstallerWorkflowScript>
    <GitSourceVisibilityScript>$(MSBuildThisFileDirectory)build\Assert-GitSourceVisibility.ps1</GitSourceVisibilityScript>
  </PropertyGroup>

  <Target Name="EnsurePublisherWireProtocolPackage"
          BeforeTargets="Restore;_GenerateRestoreProjectSpec;_GenerateRestoreGraphProjectEntry"
          Condition="'$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(SkipWireProtocolBootstrap)' != 'true' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(WireProtocolBootstrapScript)')" Text="LocalGPT protocol package bootstrap script is missing: $(WireProtocolBootstrapScript)" />
    <Exec Condition="Exists('$(WireProtocolBootstrapScript)')"
          Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(WireProtocolBootstrapScript)&quot; -Version &quot;$(LocalGptWireProtocolVersion)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true"
          StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherLoggingIntegrity"
          BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipLoggingIntegrityGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(LoggingIntegrityScript)')" Text="Logging integrity guard script is missing: $(LoggingIntegrityScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(LoggingIntegrityScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherOneWireArchitecture"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherLoggingIntegrity"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipOneWireArchitectureGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(OneWireArchitectureScript)')" Text="1-Wire architecture guard script is missing: $(OneWireArchitectureScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(OneWireArchitectureScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherRuntimeValueOwnership"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherOneWireArchitecture"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipRuntimeValueOwnershipGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(RuntimeValueOwnershipScript)')" Text="Runtime-value ownership script is missing: $(RuntimeValueOwnershipScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(RuntimeValueOwnershipScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherLocalizationIntegrity"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherRuntimeValueOwnership"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipLocalizationIntegrityGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(LocalizationIntegrityScript)')" Text="Localization integrity guard script is missing: $(LocalizationIntegrityScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(LocalizationIntegrityScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherOperationalDiagnostics"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherLocalizationIntegrity"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipOperationalDiagnosticsGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(OperationalDiagnosticsScript)')" Text="Operational diagnostics guard script is missing: $(OperationalDiagnosticsScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(OperationalDiagnosticsScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherInteractiveServerRenderModes"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherOperationalDiagnostics"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipInteractiveServerRenderModeGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(InteractiveServerRenderModeScript)')" Text="InteractiveServer render-mode guard script is missing: $(InteractiveServerRenderModeScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(InteractiveServerRenderModeScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherAsyncContinuationPolicy"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherInteractiveServerRenderModes"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipAsyncContinuationGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(AsyncContinuationScript)')" Text="Async continuation guard script is missing: $(AsyncContinuationScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(AsyncContinuationScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherComponentDiagnostics"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherAsyncContinuationPolicy"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipComponentDiagnosticsGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(ComponentDiagnosticsScript)')" Text="Component diagnostics guard script is missing: $(ComponentDiagnosticsScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ComponentDiagnosticsScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherMethodDiagnosticsPolicy"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherComponentDiagnostics"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipMethodDiagnosticsPolicyGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(MethodDiagnosticsPolicyScript)')" Text="Method diagnostics policy script is missing: $(MethodDiagnosticsPolicyScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MethodDiagnosticsPolicyScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherApplicationStaticPolicy"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherMethodDiagnosticsPolicy"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipApplicationStaticPolicyGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(ApplicationStaticPolicyScript)')" Text="Application static policy script is missing: $(ApplicationStaticPolicyScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ApplicationStaticPolicyScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherTextServiceOwnership"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherApplicationStaticPolicy"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipTextServiceOwnershipGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(TextServiceOwnershipScript)')" Text="Text-service ownership script is missing: $(TextServiceOwnershipScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(TextServiceOwnershipScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherIteratorExceptionPolicy"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherTextServiceOwnership"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipIteratorExceptionPolicyGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(IteratorExceptionPolicyScript)')" Text="Iterator exception policy script is missing: $(IteratorExceptionPolicyScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(IteratorExceptionPolicyScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherSystemVariableInitialization"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherIteratorExceptionPolicy"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipSystemVariableInitializationGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(SystemVariableInitializationScript)')" Text="System-variable initialization guard script is missing: $(SystemVariableInitializationScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(SystemVariableInitializationScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherPanelStudioInteractionLifecycle"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherSystemVariableInitialization"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipPanelStudioInteractionLifecycleGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(PanelStudioInteractionLifecycleScript)')" Text="Panel Studio interaction lifecycle guard script is missing: $(PanelStudioInteractionLifecycleScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(PanelStudioInteractionLifecycleScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherJavaScriptDiagnostics"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherPanelStudioInteractionLifecycle"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipJavaScriptDiagnosticsGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(JavaScriptDiagnosticsScript)')" Text="JavaScript diagnostics guard script is missing: $(JavaScriptDiagnosticsScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(JavaScriptDiagnosticsScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <!--<Target Name="AssertPublisherPublishConfiguration"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherJavaScriptDiagnostics"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipPublishConfigurationGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(PublishConfigurationScript)')" Text="Publish configuration guard script is missing: $(PublishConfigurationScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(PublishConfigurationScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>-->

  <Target Name="AssertPublisherInstallerWorkflow"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherPublishConfiguration"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipInstallerWorkflowGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(InstallerWorkflowScript)')" Text="Installer workflow guard script is missing: $(InstallerWorkflowScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(InstallerWorkflowScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertPublisherGitSourceVisibility"
          BeforeTargets="BeforeBuild" AfterTargets="AssertPublisherInstallerWorkflow"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipGitSourceVisibilityGuard)' != 'true' and '$(MSBuildProjectName)' == 'PublisherStudio.Web' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(GitSourceVisibilityScript)')" Text="Git source-visibility guard script is missing: $(GitSourceVisibilityScript)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(GitSourceVisibilityScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>
</Project>
