    private void TrimRangeChanged(RangeSelectorValueChangedEventArgs args)
    {
        if (!double.IsFinite(_duration) || _duration <= 0) return;
        var values = new List<double>(2);
        foreach (var value in args.CurrentRange)
        {
            if (!TryRangeValue(value, out var number)) return;
            values.Add(number);
        }
        if (values.Count < 2) return;
        ApplyTrimRange(Math.Min(values[0], values[1]), Math.Max(values[0], values[1]));
    }

    private static bool TryRangeValue(object? value, out double number)
    {
        try
        {
            number = Convert.ToDouble(value, CultureInfo.InvariantCulture);
            if (double.IsFinite(number)) return true;
        }
        catch (Exception ex) when (ex is FormatException or InvalidCastException or OverflowException) { }

        var text = Convert.ToString(value, CultureInfo.CurrentCulture);
        return double.TryParse(text, NumberStyles.Float, CultureInfo.CurrentCulture, out number) && double.IsFinite(number);
    }

    private static (double Start, double End) NormalizeTrimRange(double start, double end, double duration)
    {
        var safeDuration = double.IsFinite(duration) ? Math.Max(0, duration) : 0;
        if (safeDuration <= 0) return (0, 0);

        var minimumSpan = Math.Min(.01, safeDuration);
        var maximumStart = Math.Max(0, safeDuration - minimumSpan);
        var safeStart = double.IsFinite(start) ? Math.Clamp(start, 0, maximumStart) : 0;
        var requestedEnd = double.IsFinite(end) ? end : safeDuration;
        var minimumEnd = Math.Min(safeDuration, safeStart + minimumSpan);
        var safeEnd = Math.Clamp(requestedEnd, minimumEnd, safeDuration);
        return (safeStart, safeEnd);
    }

    private void SetVideoSelectionRange(double start, double end, bool pointSelection)
    {
        if (!IsVideo) return;
        var minimum = Math.Max(0, Math.Min(_duration, _trimStart));
        var maximum = Math.Max(minimum, Math.Min(Math.Max(.01, _duration), _trimEnd));
        if (pointSelection || maximum - minimum < .01)
        {
            _videoSelectionIsPoint = true;
            _videoSelectionPointSeconds = Math.Clamp(double.IsFinite(start) ? start : minimum, minimum, maximum);
            _videoSelectionStartSeconds = _videoSelectionPointSeconds;
            _videoSelectionEndSeconds = _videoSelectionPointSeconds;
            return;
        }

        var minimumSpan = Math.Min(.01, maximum - minimum);
        var maximumStart = Math.Max(minimum, maximum - minimumSpan);
        var safeStart = Math.Clamp(double.IsFinite(start) ? start : minimum, minimum, maximumStart);
        var minimumEnd = Math.Min(maximum, safeStart + minimumSpan);
        var safeEnd = Math.Clamp(double.IsFinite(end) ? end : maximum, minimumEnd, maximum);
        _videoSelectionIsPoint = false;
        _videoSelectionStartSeconds = safeStart;
        _videoSelectionEndSeconds = safeEnd;
        _videoSelectionPointSeconds = safeStart;
    }

    private async Task SeekVideoSelectionStartAsync()
    {
        if (!IsVideo || !HasSource) return;
        _playhead = SourcePositionToTimeline(VideoSelectionStart);
        try
        {
            var module = await EnsureMediaModuleAsync();
            await module.InvokeVoidAsync("seekMedia", "media-studio-preview", VideoSelectionStart);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or JSException) { }
    }

    private async Task ChangeVideoSelectionMode(ChangeEventArgs args)
    {
        if (!IsVideo) return;
        var point = string.Equals(Text(args), "Point", StringComparison.OrdinalIgnoreCase);
        if (point)
        {
            SetVideoSelectionRange(VideoSelectionStart, VideoSelectionStart, pointSelection: true);
        }
        else
        {
            var start = Math.Clamp(_videoSelectionPointSeconds, _trimStart, _trimEnd);
            var end = Math.Min(_trimEnd, start + Math.Max(.01, (_trimEnd - _trimStart) / 4));
            if (end - start < .01)
            {
                end = _trimEnd;
                start = Math.Max(_trimStart, end - .01);
            }
            SetVideoSelectionRange(start, end, pointSelection: false);
        }
        await SeekVideoSelectionStartAsync();
    }

    private async Task ChangeVideoSelectionStart(ChangeEventArgs args)
    {
        if (!TryDouble(args, out var value)) return;
        SetVideoSelectionRange(value, _videoSelectionIsPoint ? value : VideoSelectionEnd, _videoSelectionIsPoint);
        await SeekVideoSelectionStartAsync();
    }

    private async Task ChangeVideoSelectionEnd(ChangeEventArgs args)
    {
        if (!TryDouble(args, out var value) || _videoSelectionIsPoint) return;
        SetVideoSelectionRange(VideoSelectionStart, value, pointSelection: false);
        await SeekVideoSelectionStartAsync();
    }

    private async Task SetVideoFitModeAsync(PublicationVideoFitMode mode)
    {
        if (!IsVideo) return;
        _videoFitMode = mode;
        await InvokeAsync(StateHasChanged);
        try
        {
            var module = await EnsureMediaModuleAsync();
            await module.InvokeVoidAsync("refreshMediaStudioOverlay", "media-studio-preview");
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or JSException) { }
    }

    private Task VideoFitContain() => SetVideoFitModeAsync(PublicationVideoFitMode.Contain);
    private Task VideoFitCover() => SetVideoFitModeAsync(PublicationVideoFitMode.Cover);
    private Task VideoFitStretch() => SetVideoFitModeAsync(PublicationVideoFitMode.Stretch);
    private async Task ChangeVideoFitMode(ChangeEventArgs args)
    {
        if (Enum.TryParse<PublicationVideoFitMode>(Text(args), out var mode)) await SetVideoFitModeAsync(mode);
    }

    private static string VideoFitModeName(PublicationVideoFitMode mode) => mode switch
    {
        PublicationVideoFitMode.Cover => "Fill canvas (crop)",
        PublicationVideoFitMode.Stretch => "Stretch to canvas",
        _ => "Fit whole video"
    };

    private void ApplyTrimRange(double start, double end, bool commit = true)
    {
        if (commit && _pendingInsertSegment is not null) ClearPendingInsert();
        var trim = NormalizeTrimRange(start, end, _duration);
        _trimStart = trim.Start;
        _trimEnd = trim.End;
        if (IsVideo) SetVideoSelectionRange(VideoSelectionStart, VideoSelectionEnd, _videoSelectionIsPoint);
        ClampFades();
        if (commit) CommitSelectedSegment();
    }

    private void ChangeName(ChangeEventArgs args) { _name = string.IsNullOrWhiteSpace(Text(args)) ? (IsVideo ? "Video" : "Audio") : Text(args); CommitSelectedSegment(); }
    private void ChangeTrimStart(ChangeEventArgs args) { if (TryDouble(args, out var value)) ApplyTrimRange(value, _trimEnd); }
    private void ChangeTrimEnd(ChangeEventArgs args) { if (TryDouble(args, out var value)) ApplyTrimRange(_trimStart, value); }
    private void ChangePlaybackRate(ChangeEventArgs args) { if (TryDouble(args, out var value)) { _playbackRate = Math.Clamp(value, .25, 2); ClampFades(); } }
    private void ChangeVolume(ChangeEventArgs args) { if (TryDouble(args, out var value)) _volume = Math.Clamp(value, 0, 1); }
    private void ChangeFadeIn(ChangeEventArgs args) { if (TryDouble(args, out var value)) _fadeIn = Math.Clamp(value, 0, MaxFade); }
    private void ChangeFadeOut(ChangeEventArgs args) { if (TryDouble(args, out var value)) _fadeOut = Math.Clamp(value, 0, MaxFade); }
    private void ToggleMuted(ChangeEventArgs args) => _muted = Bool(args);
    private void ToggleLoop(ChangeEventArgs args) => _loop = Bool(args);
    private void ToggleAutoPlay(ChangeEventArgs args) => _autoPlay = Bool(args);
    private void ChangePlaybackTrigger(ChangeEventArgs args) { if (Enum.TryParse<PublicationMediaPlaybackTrigger>(Text(args), out var value)) _playbackTrigger = value; }
    private void ClampFades() { _fadeIn = Math.Min(_fadeIn, MaxFade); _fadeOut = Math.Min(_fadeOut, MaxFade); }

    private async Task DownloadRecording()
    {
        if (!HasRetainedRecording) return;
        try
        {
            var module = await EnsureMediaModuleAsync();
            await module.InvokeVoidAsync("downloadRetainedRecording", "media-studio-preview", _retainedRecordingFileName);
            _warning = $"Downloaded {_retainedRecordingFileName} ({FormatBytes(_retainedRecordingSizeBytes)}).";
        }
        catch (Exception ex)
        {
            _error = $"The completed recording could not be downloaded: {ex.Message}";
        }
    }

    private async Task Save()
    {
        if (_saving || _embedding || !HasSource || _recording) return;
        _saving = true;
        _error = null;
        var applied = false;
        await InvokeAsync(StateHasChanged);
        try
        {
            var module = await EnsureMediaModuleAsync();
            try { await module.InvokeVoidAsync("pauseMedia", "media-studio-preview"); }
            catch (JSException) { }
            catch (TaskCanceledException) { }

            if (HasRetainedRecording && string.IsNullOrWhiteSpace(_dataUrl))
            {
                _embedding = true;
                _embeddingProgress = 0;
                _warning = $"Embedding {FormatBytes(_retainedRecordingSizeBytes)} in chunks. The original remains downloadable.";
                await InvokeAsync(StateHasChanged);
                try
                {
                    await module.InvokeAsync<bool>("embedRetainedRecording", "media-studio-preview");
                }
                catch (Exception embedError)
                {
                    _embedding = false;
                    _recordingBuffer = null;
                    _recordingId = null;
                    try
                    {
                        await module.InvokeVoidAsync("downloadRetainedRecording", "media-studio-preview", _retainedRecordingFileName);
                        _error = $"Embedding failed, so the completed recording was downloaded instead and remains available here. {embedError.Message}";
                    }
                    catch (Exception downloadError)
                    {
                        _error = $"Embedding failed, but the completed recording remains available through Download recording. {embedError.Message} Download error: {downloadError.Message}";
                    }
                    return;
                }
            }

            if (string.IsNullOrWhiteSpace(_dataUrl) && _segments.Count == 0)
                throw new InvalidDataException("The completed recording has not been embedded yet.");

            CommitSelectedSegment();
            var normalizedSegments = TimelineEdits.Normalize(_segments, IsVideo);
            if (normalizedSegments.Count == 0)
                throw new InvalidDataException("The media sequence does not contain an insertable section.");
            var firstSegment = normalizedSegments[0];

            await Saved.InvokeAsync(new MediaEditorResult
            {
                Kind = Kind,
                Name = firstSegment.Name,
                DataUrl = firstSegment.DataUrl,
                MimeType = firstSegment.MimeType,
                PosterDataUrl = firstSegment.PosterDataUrl,
                PreviewAssetId = _previewAssetId,
                DurationSeconds = firstSegment.DurationSeconds,
                TrimStartSeconds = firstSegment.TrimStartSeconds,
                TrimEndSeconds = firstSegment.EffectiveTrimEndSeconds,
                Volume = _volume,
                PlaybackRate = _playbackRate,
                FadeInSeconds = _fadeIn,
                FadeOutSeconds = _fadeOut,
                Muted = _muted,
                Loop = _loop,
                AutoPlay = _autoPlay,
                PlaybackTrigger = _playbackTrigger,
                VideoFitMode = _videoFitMode,
                WaveformSamples = [.. firstSegment.WaveformSamples],
                Segments = normalizedSegments,
                FrameClipPolygon = CloneFramePoints(_frameClipPolygon)
            });
            applied = true;
            MediaAssets.Remove(_previewAssetId);
            try
            {
                await module.InvokeVoidAsync("disposeMediaStudio", "media-studio-preview");
                _initializedSession = Guid.Empty;
            }
            catch (JSException) { }
            catch (TaskCanceledException) { }
        }
        catch (JSDisconnectedException)
        {
            _error = "The browser connection closed before the media could be inserted. A completed browser recording remains downloadable while this studio is open.";
        }
        catch (TaskCanceledException)
        {
            _error = "The media insert operation was cancelled. A completed browser recording remains downloadable while this studio is open.";
        }
        catch (Exception ex)
        {
            _error = $"The media could not be inserted: {ex.Message}";
        }
        finally
        {
            _embedding = false;
            _saving = false;
            if (!applied)
            {
                try { await InvokeAsync(StateHasChanged); }
                catch (JSDisconnectedException) { }
                catch (TaskCanceledException) { }
                catch (ObjectDisposedException) { }
            }
        }
    }

    private async Task Cancel()
    {
        _recording = false;
        _saving = false;
        _embedding = false;
        _recordingBuffer = null;
        _recordingId = null;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeMediaStudio", "media-studio-preview");
                _initializedSession = Guid.Empty;
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }
        await Cancelled.InvokeAsync();
    }

    private static string CreateToneDataUrl(double durationSeconds, double frequency, double volume)
    {
        const int sampleRate = 44_100;
        var frames = Math.Max(1, (int)Math.Floor(sampleRate * Math.Max(.1, durationSeconds)));
        using var stream = new MemoryStream(44 + frames * 2);
        using var writer = new BinaryWriter(stream, Encoding.ASCII, leaveOpen: true);
        writer.Write(Encoding.ASCII.GetBytes("RIFF"));
        writer.Write(36 + frames * 2);
        writer.Write(Encoding.ASCII.GetBytes("WAVE"));
        writer.Write(Encoding.ASCII.GetBytes("fmt "));
        writer.Write(16);
        writer.Write((short)1);
        writer.Write((short)1);
        writer.Write(sampleRate);
        writer.Write(sampleRate * 2);
        writer.Write((short)2);
        writer.Write((short)16);
        writer.Write(Encoding.ASCII.GetBytes("data"));
        writer.Write(frames * 2);
        var attack = (int)(sampleRate * .025);
        var release = (int)(sampleRate * .12);
        for (var frame = 0; frame < frames; frame++)
        {
            var attackGain = Math.Min(1, frame / (double)Math.Max(1, attack));
            var releaseGain = Math.Min(1, (frames - frame) / (double)Math.Max(1, release));
            var envelope = Math.Min(attackGain, releaseGain);
            var sample = Math.Sin(2 * Math.PI * frequency * frame / sampleRate) * Math.Clamp(volume, 0, 1) * envelope;
            writer.Write((short)Math.Round(sample * short.MaxValue));
        }
        writer.Flush();
        return $"data:audio/wav;base64,{Convert.ToBase64String(stream.ToArray())}";
    }

    private static string ResolveImportedMimeType(string fileName, string? declaredMimeType, bool video)
    {
        var fallback = video ? "video/mp4" : "audio/mpeg";
        var declared = NormalizeMimeType(declaredMimeType, string.Empty);
        if (declared.StartsWith(video ? "video/" : "audio/", StringComparison.OrdinalIgnoreCase))
            return declared;

        return Path.GetExtension(fileName).ToLowerInvariant() switch
        {
            ".mp4" => video ? "video/mp4" : "audio/mp4",
            ".m4v" => "video/x-m4v",
            ".webm" => video ? "video/webm" : "audio/webm",
            ".ogv" => "video/ogg",
            ".ogg" or ".oga" => video ? "video/ogg" : "audio/ogg",
            ".mov" => "video/quicktime",
            ".mp3" => "audio/mpeg",
            ".m4a" or ".aac" => "audio/mp4",
            ".wav" => "audio/wav",
            ".flac" => "audio/flac",
            _ => fallback
        };
    }

    private static string NormalizeMimeType(string? mimeType, string fallback)
    {
        var value = mimeType?.Trim() ?? string.Empty;
        var separator = value.IndexOf(';');
        if (separator >= 0) value = value[..separator].Trim();
        return value.Contains('/') ? value.ToLowerInvariant() : fallback;
    }

    private static string NormalizeMediaDataUrl(string? dataUrl, string fallbackMimeType)
    {
        if (string.IsNullOrWhiteSpace(dataUrl) || !dataUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
            return dataUrl ?? string.Empty;
        var marker = dataUrl.LastIndexOf(";base64,", StringComparison.OrdinalIgnoreCase);
        if (marker < 0) return dataUrl;
        var header = dataUrl.Substring(5, marker - 5);
        var mimeType = NormalizeMimeType(header, fallbackMimeType);
        return $"data:{mimeType};base64,{dataUrl[(marker + 8)..]}";
    }

    private static string RecordingName(string mimeType, bool isVideo)
    {
        var extension = mimeType.ToLowerInvariant() switch
        {
            var value when value.Contains("mp4", StringComparison.Ordinal) => "mp4",
            var value when value.Contains("ogg", StringComparison.Ordinal) => "ogg",
            var value when value.Contains("wav", StringComparison.Ordinal) => "wav",
            _ => "webm"
        };
        return $"Recorded {(isVideo ? "Video" : "Audio")}.{extension}";
    }

    private static string PlaybackTriggerName(PublicationMediaPlaybackTrigger value) => value switch
    {
        PublicationMediaPlaybackTrigger.OnPageEnter => "When the page opens",
        PublicationMediaPlaybackTrigger.OnClick => "When the media object is clicked",
        _ => "With the object animation"
    };
    private static string WaveHeight(double value) => $"{Math.Clamp(value, .05, 1) * 100:0.#}%";
    private static string Time(double value) => TimeSpan.FromSeconds(Math.Max(0, value)).ToString(value >= 3600 ? @"h\:mm\:ss\.f" : @"m\:ss\.f", CultureInfo.InvariantCulture);
    private static string Inv(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static string Text(ChangeEventArgs args) => args.Value?.ToString() ?? string.Empty;
    private static bool Bool(ChangeEventArgs args) => args.Value is bool value ? value : bool.TryParse(Text(args), out var parsed) && parsed;
    private static bool TryDouble(ChangeEventArgs args, out double value) =>
        double.TryParse(Text(args), NumberStyles.Float, CultureInfo.InvariantCulture, out value) && double.IsFinite(value);
    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var value = Math.Max(0, bytes);
        var unit = 0;
        var display = (double)value;
        while (display >= 1024 && unit < units.Length - 1)
        {
            display /= 1024;
            unit++;
        }
        return $"{display:0.##} {units[unit]}";
    }

