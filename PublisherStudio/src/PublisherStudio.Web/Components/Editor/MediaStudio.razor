        public List<double> WaveformSamples { get; set; } = [];
        public string PosterDataUrl { get; set; } = string.Empty;
        public string MetadataWarning { get; set; } = string.Empty;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        MediaAssets.Remove(_previewAssetId);
        try
        {
            if (_module is not null) await _module.InvokeVoidAsync("disposeMediaStudio", "media-studio-preview");
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
        finally
        {
            _self?.Dispose();
        }

        try
        {
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }
