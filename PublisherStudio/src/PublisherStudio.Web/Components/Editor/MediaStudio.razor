@namespace PublisherStudio.Components.Editor
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject PublicationMediaAssetStore MediaAssets
@inject MediaTimelineEditService TimelineEdits
@inject VideoProjectImportService VideoProjectImporter
@inject VideoLayerInterchangeService VideoLayerInterchange

@if (Visible)
{
    <div class="editor-modal-backdrop media-studio-backdrop">
        <section id="media-studio-window" class="media-studio-window" tabindex="0" role="dialog" aria-modal="true" aria-label="@(IsVideo ? "Video Studio" : "Audio Studio")">
            <header class="media-studio-titlebar">
                <div>
                    <strong>@(IsVideo ? "Video Studio" : "Audio Studio")</strong>
                    <span>@(EditingExisting ? "Edit the selected media object" : IsVideo ? "Import or record a video" : "Import, record, trim, and mix a simple audio clip")</span>
                </div>
                <button type="button" title="Close" @onclick="Cancel">×</button>
            </header>

            <DxRibbon CssClass="media-studio-ribbon categorized-ribbon" SizeMode="SizeMode.Small" AdaptivityAutoCollapseItemsToGroups="true">
                <DxRibbonTab Text="Home">
                    <DxRibbonGroup Text="Source" IconCssClass="pub-icon pub-icon-media">
                        <DxRibbonItem Text="@ImportMenuText" IconCssClass="pub-icon pub-icon-open" IsPrimary="true" Enabled="@(!_recording)" Click="OpenMediaPicker" />
                        @if (IsVideo)
                        {
                            <DxRibbonItem Text="Import open project…" IconCssClass="pub-icon pub-icon-open" Enabled="@(!_recording)" Click="OpenVideoProjectPicker" />
                            <DxRibbonItem Text="Relink project media…" IconCssClass="pub-icon pub-icon-refresh" Enabled="@HasVideoProject" Click="OpenVideoProjectMediaPicker" />
                            <DxRibbonItem Text="Record camera" IconCssClass="pub-icon pub-icon-video" Enabled="@(!_recording)" Click="RecordCamera" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-video" Text="Record screen" Enabled="@(!_recording)" Click="RecordScreen" />
                        }
                        else
                        {
                            <DxRibbonItem Text="Record microphone" IconCssClass="pub-icon pub-icon-audio" Enabled="@(!_recording)" Click="RecordMicrophone" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-audio" Text="Generate tone" Enabled="@(!_recording)" Click="GenerateTone" />
                        }
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-stop" Text="Stop recording" Enabled="@_recording" Click="StopRecording" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-download" Text="Download recording" Enabled="@HasRetainedRecording" Click="DownloadRecording" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-media" Text="Send selection to converter" Enabled="@HasSelectedSegment" Click="SendSelectedMediaToConverter" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Pointer mode" IconCssClass="pub-icon pub-icon-select">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-select" Text="@MouseModeText(MediaStudioMouseMode.SelectSection, "Select time")" Click="SelectSectionMode" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-line" Text="@MouseModeText(MediaStudioMouseMode.PlacePlayhead, "Place playhead")" Enabled="@HasSource" Click="PlacePlayheadMode" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-crop" Text="@MouseModeText(MediaStudioMouseMode.AddCutLine, "Add cutline")" Enabled="@HasSource" Click="AddCutLineMode" />
                        @if (IsVideo)
                        {
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-select" Text="@MouseModeText(MediaStudioMouseMode.FrameRegion, "Frame region")" Enabled="@HasSource" Click="FrameRegionMode" />
                        }
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Playback">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-play" Text="Play range" Enabled="@HasSource" Click="PlaySelection" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-pause" Text="Pause" Enabled="@HasSource" Click="PausePreview" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-crop" Text="To trim start" Enabled="@HasSource" Click="SeekStart" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Trim">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-play" Text="Start at playhead" Enabled="@HasSource" Click="SetTrimStartAtPlayhead" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-play" Text="End at playhead" Enabled="@HasSource" Click="SetTrimEndAtPlayhead" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-crop" Text="Reset trim" Enabled="@HasSource" Click="ResetTrim" />
                    </DxRibbonGroup>
                    @if (IsVideo)
                    {
                        <DxRibbonGroup Text="Selection">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-line" Text="Cut selection" Enabled="@CanCutVideoSelection" Click="CutVideoSelection" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-crop" Text="Trim to selection" Enabled="@CanUseVideoSelectionAsTrim" Click="UseVideoSelectionAsTrim" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-copy" Text="Copy selection" Enabled="@CanCopyVideoSelection" Click="CopyVideoSelection" />
                        </DxRibbonGroup>
                        <DxRibbonGroup Text="Cut sections" IconCssClass="pub-icon pub-icon-line">
                            <DxRibbonItem Text="Save as cut section" Enabled="@CanSaveCutSection" Click="SaveSelectedRangeAsCutSection" />
                            <DxRibbonItem Text="Use saved section" Enabled="@(SelectedCutSection is not null)" Click="UseSelectedCutSection" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text="Remove saved section" Enabled="@(SelectedCutSection is not null)" Click="RemoveSelectedCutSection" />
                        </DxRibbonGroup>
                        <DxRibbonGroup Text="Video layers" IconCssClass="pub-icon pub-icon-layers">
                            <DxRibbonItem Text="Add layer" Enabled="@HasSelectedSegment" Click="AddVideoLayer" />
                            <DxRibbonItem Text="Duplicate layer" Enabled="@(SelectedVideoLayer is not null)" Click="DuplicateVideoLayer" />
                            <DxRibbonItem Text="Selection → new layer" Enabled="@CanCreateSelectionLayer" Click="CreateSelectionLayer" />
                            <DxRibbonItem Text="Selection → layer" Enabled="@CanApplySelectionToLayer" Click="ApplySelectionToSelectedVideoLayer" />
                            <DxRibbonItem Text="3D blob" Enabled="@(SelectedVideoLayer is not null)" Click="ConvertSelectedLayerToBlob" />
                            <DxRibbonItem Text="3D → Mainframe" Enabled="@CanInsertLayerIntoMainframe" Click="InsertSelectedLayerIntoMainframe" />
                            <DxRibbonItem Text="Layer up" Enabled="@CanMoveVideoLayerUp" Click="MoveVideoLayerUp" />
                            <DxRibbonItem Text="Layer down" Enabled="@CanMoveVideoLayerDown" Click="MoveVideoLayerDown" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text="Delete layer" Enabled="@CanDeleteVideoLayer" Click="DeleteVideoLayer" />
                        </DxRibbonGroup>
                        <DxRibbonGroup Text="Live filters" IconCssClass="pub-icon pub-icon-effects">
                            <DxRibbonItem Text="Chroma key" Enabled="@(SelectedVideoLayer is not null)" Click="AddChromaKeyFilter" />
                            <DxRibbonItem Text="Color adjustment" Enabled="@(SelectedVideoLayer is not null)" Click="AddColorAdjustmentFilters" />
                            <DxRibbonItem Text="Vignette" Enabled="@(SelectedVideoLayer is not null)" Click="AddVignetteFilter" />
                        </DxRibbonGroup>
                        <DxRibbonGroup Text="Video canvas" IconCssClass="pub-icon pub-icon-video">
                            <DxRibbonItem Text="@VideoFitModeText(PublicationVideoFitMode.Stretch, "Stretch")" Enabled="@HasSource" Click="VideoFitStretch" />
                            <DxRibbonItem Text="@VideoFitModeText(PublicationVideoFitMode.Cover, "Fill canvas")" Enabled="@HasSource" Click="VideoFitCover" />
                            <DxRibbonItem Text="@VideoFitModeText(PublicationVideoFitMode.Contain, "Fit whole")" Enabled="@HasSource" Click="VideoFitContain" />
                        </DxRibbonGroup>
                    }
                    <DxRibbonGroup Text="Sections">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-line" Text="Cut at playhead" Enabled="@CanAddCutLine" Click="AddCutLineAtPlayhead" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text="Remove cutline" Enabled="@CanRemoveCutLine" Click="RemoveCutLine" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-copy" Text="Copy" Enabled="@HasSelectedSegment" Click="CopySelectedSection" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-paste" Text="Paste" Enabled="@CanPasteSection" Click="PasteSection" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text="Delete" Enabled="@CanDeleteSection" Click="DeleteSelectedSection" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-insert" Text="Insert into range…" Enabled="@HasSource" Click="OpenInsertMediaPicker" />
                    </DxRibbonGroup>
                </DxRibbonTab>
            </DxRibbon>
            <div class="media-studio-source-state" role="status">@SourceStatus</div>

            <div class="media-studio-body">
                <div class="media-studio-preview-column">
                    <div class="media-studio-preview-shell @(IsVideo ? "video" : "audio") @(_mouseMode == MediaStudioMouseMode.FrameRegion ? "frame-region-mode" : null)"
                         @oncontextmenu="ShowMediaContextMenu" @oncontextmenu:preventDefault>
                        @if (IsVideo)
                        {
                            <div id="media-studio-frame-stage" class="media-studio-frame-stage">
                                <video id="media-studio-preview"
                                       src="@_previewSource"
                                       poster="@_posterDataUrl"
                                       playsinline
                                       preload="metadata"
                                       disablepictureinpicture
                                       controlslist="nofullscreen nodownload noremoteplayback"
                                       class="media-studio-video-surface"
                                       style="@VideoPreviewStyle"></video>
                                <canvas id="media-studio-video-effects" class="media-studio-video-effects" aria-hidden="true"></canvas>
                                <div class="media-video-mode-hud" aria-live="polite">
                                    <b>@MouseModeLabel</b>
                                    <span>@VideoCanvasModeHelp</span>
                                </div>
                                <div id="media-studio-video-time-overlay"
                                     class="media-video-time-overlay @(_videoSelectionIsPoint ? "point-selection" : "range-selection") @(_mouseMode == MediaStudioMouseMode.FrameRegion ? "disabled" : null)"
                                     data-duration="@Inv(_duration)"
                                     data-trim-start="@Inv(_trimStart)"
                                     data-trim-end="@Inv(_trimEnd)"
                                     data-selection-start="@Inv(VideoSelectionStart)"
                                     data-selection-end="@Inv(VideoSelectionEnd)"
                                     data-selection-point="@(_videoSelectionIsPoint ? "true" : "false")"
                                     data-clip-name="@SelectedClipName"
                                     data-sequence-duration="@Inv(SequenceDuration)"
                                     data-segment-timeline-start="@Inv(SelectedSegmentTimelineStart)"
                                     data-segment-source-start="@Inv(SelectedSegmentSourceStart)"
                                     data-playback-rate="@Inv(_playbackRate)"
                                     data-volume="@Inv(_volume)"
                                     data-muted="@(_muted ? "true" : "false")"
                                     data-loop="@(_loop ? "true" : "false")"
                                     data-mouse-mode="@_mouseMode"
                                     style="@VideoTimeOverlayStyle"
                                     role="application"
                                     aria-label="Video timestamp and range selector">
                                    <div class="media-video-time-track" data-video-time-track aria-label="Selected video timestamp or range">
                                        <span class="media-video-time-selected" aria-hidden="true"></span>
                                        <span class="media-video-time-handle start" data-video-time-handle="start" title="Drag selection start"></span>
                                        <span class="media-video-time-handle end" data-video-time-handle="end" title="Drag selection end"></span>
                                        <span class="media-video-time-point" aria-hidden="true"></span>
                                        <span class="media-video-time-playhead" aria-hidden="true"></span>
                                        <span class="media-video-time-drop-marker" aria-hidden="true"></span>
                                    </div>
                                    @foreach (var cutSection in SelectedCutSections)
                                    {
                                        <button type="button"
                                                class="media-video-cut-section @(cutSection.Id == _selectedCutSectionId ? "selected" : null)"
                                                style="@VideoCutSectionStyle(cutSection)"
                                                title="@($"{cutSection.Name}: {Time(cutSection.StartSeconds)} — {Time(cutSection.EndSeconds)}")"
                                                data-video-time-control
                                                @onclick="() => SelectCutSection(cutSection.Id)"
                                                @onclick:stopPropagation></button>
                                    }
                                    <div class="media-video-time-toolbar media-video-transport-dock" data-video-time-control>
                                        <div class="media-video-transport-buttons">
                                            <button type="button" title="Play selected range" data-video-command="play">▶</button>
                                            <button type="button" title="Pause video" data-video-command="pause">Ⅱ</button>
                                        </div>
                                        <label class="media-video-pointer-mode">
                                            <span>Pointer</span>
                                            <select value="@_mouseMode" @onchange="ChangeVideoCanvasMouseMode">
                                                <option value="@MediaStudioMouseMode.SelectSection">Select time</option>
                                                <option value="@MediaStudioMouseMode.PlacePlayhead">Place playhead</option>
                                                <option value="@MediaStudioMouseMode.AddCutLine">Add cutline</option>
                                                <option value="@MediaStudioMouseMode.FrameRegion">Frame region</option>
                                            </select>
                                        </label>
                                        <span class="media-video-time-readout">
                                            <b id="media-studio-video-selection-label">@VideoSelectionLabel</b>
                                            <span id="media-studio-video-current-time">@Time(VideoSelectionStart)</span>
                                            <span id="media-studio-video-selection-readout">@VideoSelectionReadout</span>
                                        </span>
                                        <span class="media-video-time-help">@SelectedClipName · @VideoCanvasModeHelp</span>
                                    </div>

                                    @if (_pendingInsertSegment is not null)
                                    {
                                        <div class="media-video-insert-placement" data-video-time-control @onpointerdown:stopPropagation @onclick:stopPropagation>
                                            <div>
                                                <b>Insert dropped video</b>
                                                <span>@_pendingInsertSegment.Name</span>
                                            </div>
                                            @if (PendingInsertHasRange)
                                            {
                                                <label>
                                                    Position inside selection
                                                    <input type="range"
                                                           min="@Inv(_pendingInsertMinimumSourceSeconds)"
                                                           max="@Inv(_pendingInsertMaximumSourceSeconds)"
                                                           step="0.01"
                                                           value="@Inv(_pendingInsertSourceSeconds)"
                                                           @oninput="ChangePendingInsertPosition" />
                                                </label>
                                            }
                                            else
                                            {
                                                <span class="media-video-insert-fixed">The selected timestamp is fixed.</span>
                                            }
                                            <div class="media-video-insert-actions">
                                                <time>@Time(_pendingInsertSourceSeconds)</time>
                                                <button type="button" @onclick="ConfirmPendingInsert">Insert here</button>
                                                <button type="button" @onclick="CancelPendingInsert">Cancel</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div id="media-studio-frame-overlay-host"
                                     class="media-studio-frame-overlay-host @(_mouseMode == MediaStudioMouseMode.FrameRegion ? "active" : null)"
                                     role="application"
                                     aria-label="Video frame region selection"
                                     @onpointerdown="FrameOverlayPointerDown"
                                     @onpointerdown:preventDefault
                                     @onpointerdown:stopPropagation
                                     @ondblclick="FinishFrameRegion"
                                     @ondblclick:preventDefault
                                     @ondblclick:stopPropagation
                                     @oncontextmenu="ShowMediaContextMenu"
                                     @oncontextmenu:preventDefault
                                     @oncontextmenu:stopPropagation>
                                    <svg class="media-studio-frame-overlay" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
                                        <path class="media-frame-dim" d="@FrameDimPath" fill-rule="evenodd" />
                                        @if (ActiveFramePoints.Count >= 2)
                                        {
                                            <polyline class="media-frame-cutline" points="@FramePolylinePoints" />
                                        }
                                        @if (ActiveFramePoints.Count >= 3)
                                        {
                                            <polygon class="media-frame-selection" points="@FramePolygonPoints" />
                                        }
                                        @for (var pointIndex = 0; pointIndex < ActiveFramePoints.Count; pointIndex++)
                                        {
                                            var point = ActiveFramePoints[pointIndex];
                                            <circle class="media-frame-node @(pointIndex == _selectedFramePointIndex ? "selected" : null)" data-frame-node-index="@pointIndex" cx="@Inv(point.X * 1000)" cy="@Inv(point.Y * 1000)" r="9" />
                                        }
                                    </svg>
                                    <span class="media-frame-cursor-ring" aria-hidden="true"></span>
                                    <div class="media-frame-mode-help">
                                        <b>@(_editingMorphRegion ? "Morph target mode" : "Frame region mode")</b>
                                        <span>Click selects or adds a point · drag moves it · Delete removes the selected point</span>
                                    </div>
                                    <div class="media-frame-overlay-actions" @onpointerdown:stopPropagation>
                                        <button type="button" disabled="@(!CanFinishFrameRegion)" @onclick="FinishFrameRegion">Apply region</button>
                                        <button type="button" disabled="@(SelectedFramePoint is null)" @onclick="RemoveSelectedFramePoint">Delete point</button>
                                        <button type="button" disabled="@(!_frameRegionEditing || _frameDraft.Count == 0)" @onclick="RemoveLastFramePoint">Undo point</button>
                                        <button type="button" @onclick="CancelFrameRegion">Exit mode</button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="media-studio-audio-card">
                                <div class="media-studio-waveform" aria-label="Audio waveform">
                                    @foreach (var sample in DisplayWaveform)
                                    {
                                        <i style="height:@WaveHeight(sample)"></i>
                                    }
                                </div>
                                <audio id="media-studio-preview" src="@_previewSource" controls preload="metadata"></audio>
                            </div>
                        }
                    </div>

                    <div class="media-transport-status" role="status">
                        <strong id="media-studio-selection-title">@VideoOrAudioSelectionTitle</strong>
                        <span id="media-studio-selection-summary">@VideoOrAudioSelectionSummary</span>
                    </div>

                    @if (HasSource)
                    {
                        <div class="media-sequence-editor">
                            <div class="media-range-caption"><b>Sequence</b><span>@Time(SequenceDuration) · @_segments.Count section@(_segments.Count == 1 ? string.Empty : "s")</span></div>
                            <div id="media-studio-sequence-timeline" class="media-sequence-timeline mode-@_mouseMode.ToString().ToLowerInvariant()" tabindex="0"
                                 @onpointerdown="TimelinePointerDown"
                                 @oncontextmenu="ShowTimelineContextMenu" @oncontextmenu:preventDefault>
                                @foreach (var segment in _segments)
                                {
                                    <button type="button" class="media-sequence-segment @(segment.Id == _selectedSegmentId ? "selected" : null) @(segment.IsGap ? "gap" : string.IsNullOrWhiteSpace(segment.DataUrl) ? "offline" : null)"
                                            style="@SegmentStyle(segment)" title="@SegmentTitle(segment)">
                                        <span>@segment.Name</span>
                                    </button>
                                }
                                @foreach (var boundary in CutBoundaryPositions)
                                {
                                    <i class="media-cutline" style="left:@Percent(boundary / Math.Max(.01, SequenceDuration))"></i>
                                }
                                @if (IsVideo && HasSelectedSegment)
                                {
                                    <i id="media-studio-sequence-selection"
                                       class="media-sequence-selection @(_videoSelectionIsPoint ? "point" : "range")"
                                       style="@VideoSequenceSelectionStyle"
                                       title="@VideoSequenceSelectionTitle"></i>
                                }
                                <i id="media-studio-sequence-playhead" class="media-playhead" style="left:@Percent(_playhead / Math.Max(.01, SequenceDuration))"></i>
                            </div>
                            <div class="media-sequence-status">
                                <span><b>Mode:</b> @MouseModeLabel</span>
                                <span><b>Playhead:</b> @Time(_playhead)</span>
                                <span><b>Selected:</b> @SelectedSectionSummary</span>
                            </div>
                        </div>

                        @if (!IsVideo)
                        {
                            <div class="media-range-selector" @oncontextmenu="ShowMediaContextMenu" @oncontextmenu:preventDefault>
                                <div class="media-range-caption"><b>Trim range</b><span>@Time(_trimEnd - _trimStart) selected</span></div>
                                <DxRangeSelector Height="96px"
                                                 SelectedRangeStartValue="@_trimStart"
                                                 SelectedRangeEndValue="@_trimEnd"
                                                 ValueChanged="TrimRangeChanged"
                                                 ValueChangeMode="RangeSelectorValueChangeMode.OnHandleMove"
                                                 AllowMouseSelection="true"
                                                 MoveSelectedRangeByClick="true">
                                    <DxRangeSelectorScale StartValue="@(0d)"
                                                          EndValue="@RangeSelectorEnd"
                                                          ValueType="ChartAxisDataType.Numeric"
                                                          TickInterval="@MajorTick"
                                                          MinorTickInterval="@MinorTick"
                                                          MinRange="@RangeSelectorMinRange">
                                        <DxRangeSelectorScaleMarker Visible="false" />
                                    </DxRangeSelectorScale>
                                    <DxRangeSelectorSliderMarker Visible="true" />
                                </DxRangeSelector>
                            </div>
                        }
                    }
                </div>

                <aside class="media-studio-properties">
                    <section>
                        <h3>Clip</h3>
                        <label>Name<input value="@_name" @onchange="ChangeName" /></label>
                        <div class="property-grid two">
                            <label>Trim start<input type="number" min="0" max="@Inv(_duration)" step="0.01" value="@Inv(_trimStart)" @onchange="ChangeTrimStart" /></label>
                            <label>Trim end<input type="number" min="0" max="@Inv(_duration)" step="0.01" value="@Inv(_trimEnd)" @onchange="ChangeTrimEnd" /></label>
                        </div>
                        <label>Playback rate <b>@_playbackRate.ToString("0.##", CultureInfo.InvariantCulture)×</b>
                            <input type="range" min="0.25" max="2" step="0.05" value="@Inv(_playbackRate)" @oninput="ChangePlaybackRate" />
                        </label>
                        <label>Volume <b>@Math.Round(_volume * 100)%</b>
                            <input type="range" min="0" max="1" step="0.01" value="@Inv(_volume)" @oninput="ChangeVolume" />
                        </label>
                        <label class="check-row"><input type="checkbox" checked="@_muted" @onchange="ToggleMuted" /> Muted</label>
                        <label class="check-row"><input type="checkbox" checked="@_loop" @onchange="ToggleLoop" /> Loop selected range</label>
                    </section>

                    @if (IsVideo)
                    {
                        @if (HasVideoProject)
                        {
                            <section class="media-video-project-properties">
                                <h3>Imported video project</h3>
                                <p class="property-note"><b>@VideoProjectTitle</b> · @VideoProjectFormatSummary</p>
                                <div class="media-video-project-summary">
                                    <span>@VideoProjectCanvasSummary</span>
                                    <span>@VideoProjectTrackSummary</span>
                                    <span>@VideoProjectMissingSummary</span>
                                </div>
                                <label>Editable video track
                                    <select value="@_activeProjectTrackId" @onchange="ChangeProjectTrack">
                                        @foreach (var track in ProjectVideoTracks)
                                        {
                                            <option value="@track.Id">@track.Name (@track.Segments.Count clips)</option>
                                        }
                                    </select>
                                </label>
                                <div class="property-action-row">
                                    <DxButton Text="Import another project" Click="OpenVideoProjectPicker" />
                                    <DxButton Text="Relink media" Enabled="@(VideoProjectMissingMediaCount > 0)" Click="OpenVideoProjectMediaPicker" />
                                </div>
                                @if (_videoProjectIssues.Count > 0)
                                {
                                    <details class="media-video-project-report">
                                        <summary>Compatibility report · @_videoProjectIssues.Count item@(_videoProjectIssues.Count == 1 ? string.Empty : "s")</summary>
                                        @foreach (var issue in _videoProjectIssues.Take(12))
                                        {
                                            <p class="issue-@issue.Severity.ToString().ToLowerInvariant()"><b>@issue.Code</b> · @issue.Message</p>
                                        }
                                    </details>
                                }
                                <p class="property-note">All imported tracks, gaps, source references, markers and transitions stay in the canonical project. This editor displays and edits the selected video-track projection; preserved audio and additional video tracks remain available for later orchestration.</p>
                            </section>
                        }
                        <section class="media-video-selection-properties">
                            <h3>Selected clip time</h3>
                            <p class="property-note"><b>@SelectedClipName</b> · source timestamps stay linked to the highlighted clip in the project sequence.</p>
                            <label>Selection type
                                <select id="media-studio-video-selection-mode" value="@(_videoSelectionIsPoint ? "Point" : "Range")" @onchange="ChangeVideoSelectionMode">
                                    <option value="Point">Single timestamp</option>
                                    <option value="Range">Time range</option>
                                </select>
                            </label>
                            <div class="property-grid two">
                                <label>Selection start
                                    <input id="media-studio-video-selection-start"
                                           type="number"
                                           min="@Inv(_trimStart)"
                                           max="@Inv(_trimEnd)"
                                           step="0.01"
                                           value="@Inv(VideoSelectionStart)"
                                           @onchange="ChangeVideoSelectionStart" />
                                </label>
                                <label>Selection end
                                    <input id="media-studio-video-selection-end"
                                           type="number"
                                           min="@Inv(_trimStart)"
                                           max="@Inv(_trimEnd)"
                                           step="0.01"
                                           value="@Inv(VideoSelectionEnd)"
                                           disabled="@_videoSelectionIsPoint"
                                           @onchange="ChangeVideoSelectionEnd" />
                                </label>
                            </div>
                            <div class="media-video-selection-value" id="media-studio-video-selection-value">@VideoSelectionDetailedSummary</div>
                            <div class="property-action-row">
                                <DxButton Text="Cut selection" Enabled="@CanCutVideoSelection" Click="CutVideoSelection" />
                                <DxButton Text="Use as trim" Enabled="@CanUseVideoSelectionAsTrim" Click="UseVideoSelectionAsTrim" />
                                <DxButton Text="Copy area" Enabled="@CanCopyVideoSelection" Click="CopyVideoSelection" />
                                <DxButton Text="New selection layer" Enabled="@CanCreateSelectionLayer" Click="CreateSelectionLayer" />
                                <DxButton Text="Apply to layer" Enabled="@CanApplySelectionToLayer" Click="ApplySelectionToSelectedVideoLayer" />
                            </div>
                            <label class="check-row"><input type="checkbox" checked="@_autoCreateSelectionLayers" @onchange="ToggleAutoCreateSelectionLayers" /> Create/reuse one effect layer for every committed range</label>
                            <p class="property-note">A point creates one cutline. A range is persisted on its own selection layer, so filters and frame regions render only inside that time span. Dropped video is inserted only inside this selection.</p>
                        </section>

                        <section class="media-cut-sections-properties">
                            <h3>Saved cut sections</h3>
                            <p class="property-note">The current selection stays editable. Save any number of independent ranges as cut sections without replacing the active selection.</p>
                            <div class="media-cut-section-list">
                                @foreach (var section in SelectedCutSections)
                                {
                                    <button type="button" class="@(section.Id == _selectedCutSectionId ? "selected" : null)" @onclick="() => SelectCutSection(section.Id)">
                                        <span>@section.Name</span>
                                        <small>@Time(section.StartSeconds) — @Time(section.EndSeconds)</small>
                                    </button>
                                }
                                @if (SelectedCutSections.Count == 0)
                                {
                                    <span class="media-empty-list">No saved cut sections yet.</span>
                                }
                            </div>
                            <div class="property-action-row">
                                <DxButton Text="Save as cut section" Enabled="@CanSaveCutSection" Click="SaveSelectedRangeAsCutSection" />
                                <DxButton Text="Use section" Enabled="@(SelectedCutSection is not null)" Click="UseSelectedCutSection" />
                                <DxButton Text="Remove" Enabled="@(SelectedCutSection is not null)" Click="RemoveSelectedCutSection" />
                            </div>
                        </section>

                        <section class="media-video-layer-properties">
                            <h3>Video layers</h3>
                            <p class="property-note">Each layer owns its frame region, temporal range and live filter stack. Layers are rendered from bottom to top.</p>
                            <div class="media-video-layer-list">
                                @for (var layerIndex = 0; layerIndex < SelectedVideoLayers.Count; layerIndex++)
                                {
                                    var layer = SelectedVideoLayers[layerIndex];
                                    <div class="media-video-layer-row @(layer.Id == _selectedVideoLayerId ? "selected" : null)">
                                        <button type="button" class="media-video-layer-select" @onclick="() => SelectVideoLayer(layer.Id)">
                                            <span>@layer.Name</span>
                                            <small>@VideoLayerKindName(layer.Kind) · @(layer.Region.IsFullFrame ? "Full frame" : $"{layer.Region.Points.Count} region points") · @layer.Filters.Count filter@(layer.Filters.Count == 1 ? string.Empty : "s")@(layer.HasTemporalRange ? $" · {Time(layer.TemporalStartSeconds)}—{Time(layer.TemporalEndSeconds)}" : " · full clip")</small>
                                            <em class="media-html-support @HtmlSupportCss(layer.HtmlExportSupport)">@HtmlSupportLabel(layer.HtmlExportSupport)</em>
                                        </button>
                                        <button type="button" class="media-video-layer-visibility" title="Toggle layer visibility" @onclick="() => ToggleVideoLayerVisibility(layer.Id)">@(layer.Visible ? "●" : "○")</button>
                                    </div>
                                }
                            </div>
                            <div class="property-action-row">
                                <DxButton Text="Add" Click="AddVideoLayer" />
                                <DxButton Text="Duplicate" Enabled="@(SelectedVideoLayer is not null)" Click="DuplicateVideoLayer" />
                                <DxButton Text="Up" Enabled="@CanMoveVideoLayerUp" Click="MoveVideoLayerUp" />
                                <DxButton Text="Down" Enabled="@CanMoveVideoLayerDown" Click="MoveVideoLayerDown" />
                                <DxButton Text="Delete" Enabled="@CanDeleteVideoLayer" Click="DeleteVideoLayer" />
                            </div>
                            @if (SelectedVideoLayer is { } selectedLayer)
                            {
                                <label>Layer name<input value="@selectedLayer.Name" @onchange="ChangeVideoLayerName" /></label>
                                <label>Layer type
                                    <select value="@selectedLayer.Kind" @onchange="ChangeVideoLayerKind">
                                        @foreach (var layerKind in Enum.GetValues<VideoEffectLayerKind>())
                                        {
                                            <option value="@layerKind">@VideoLayerKindName(layerKind)</option>
                                        }
                                    </select>
                                </label>
                                <div class="media-export-compatibility @HtmlSupportCss(selectedLayer.HtmlExportSupport)">
                                    <b>@HtmlSupportLabel(selectedLayer.HtmlExportSupport)</b>
                                    <span>@selectedLayer.HtmlExportNote</span>
                                </div>
                                <label>Opacity <b>@Math.Round(selectedLayer.Opacity * 100)%</b>
                                    <input type="range" min="0" max="1" step="0.01" value="@Inv(selectedLayer.Opacity)" @oninput="ChangeVideoLayerOpacity" />
                                </label>
                                <label>Blend mode
                                    <select value="@selectedLayer.BlendMode" @onchange="ChangeVideoLayerBlendMode">
                                        @foreach (var blend in Enum.GetValues<VideoEffectBlendMode>())
                                        {
                                            <option value="@blend">@blend</option>
                                        }
                                    </select>
                                </label>
                                <label class="check-row"><input type="checkbox" checked="@selectedLayer.HasTemporalRange" @onchange="ToggleVideoLayerTemporalRange" /> Apply only in a time range</label>
                                @if (selectedLayer.HasTemporalRange)
                                {
                                    <div class="property-grid two">
                                        <label>Layer start<input type="number" min="@Inv(_trimStart)" max="@Inv(_trimEnd)" step="0.01" value="@Inv(selectedLayer.TemporalStartSeconds)" @onchange="ChangeVideoLayerTemporalStart" /></label>
                                        <label>Layer end<input type="number" min="@Inv(_trimStart)" max="@Inv(_trimEnd)" step="0.01" value="@Inv(selectedLayer.TemporalEndSeconds)" @onchange="ChangeVideoLayerTemporalEnd" /></label>
                                    </div>
                                    <DxButton Text="Apply selected range" Enabled="@CanApplySelectionToLayer" Click="ApplySelectionToSelectedVideoLayer" CssClass="wide-button" />
                                }
                                @if (selectedLayer.Kind == VideoEffectLayerKind.Blob3D)
                                {
                                    <div class="property-action-row">
                                        <DxButton Text="Edit source area" Click="BeginFrameRegion" />
                                        <DxButton Text="Draw morph target" Click="BeginMorphRegion" />
                                    </div>
                                    <label class="check-row"><input type="checkbox" checked="@selectedLayer.MorphEnabled" @onchange="ToggleVideoLayerMorph" /> Morph between both areas</label>
                                    <label class="check-row"><input type="checkbox" checked="@selectedLayer.AnimateMorph" @onchange="ToggleVideoLayerMorphAnimation" /> Animate morph in preview and HTML</label>
                                    <label>Morph amount <b>@Inv(selectedLayer.MorphAmount)</b><input type="range" min="0" max="1" step="0.01" value="@Inv(selectedLayer.MorphAmount)" @oninput="ChangeVideoLayerMorphAmount" /></label>
                                    <label>Animation speed <b>@Inv(selectedLayer.AnimationSpeed)</b><input type="range" min="0" max="8" step="0.05" value="@Inv(selectedLayer.AnimationSpeed)" @oninput="ChangeVideoLayerAnimationSpeed" /></label>
                                    <label>Depth <b>@Inv(selectedLayer.Depth)</b><input type="range" min="0.02" max="0.5" step="0.01" value="@Inv(selectedLayer.Depth)" @oninput="ChangeVideoLayerDepth" /></label>
                                    <label>Roundness <b>@Inv(selectedLayer.Roundness)</b><input type="range" min="0" max="0.5" step="0.01" value="@Inv(selectedLayer.Roundness)" @oninput="ChangeVideoLayerRoundness" /></label>
                                    <div class="property-action-row">
                                        <DxButton Text="Refresh OpenSCAD" Click="RefreshSelectedLayerOpenScad" />
                                        <DxButton Text="Insert in Mainframe" Enabled="@CanInsertLayerIntoMainframe" Click="InsertSelectedLayerIntoMainframe" />
                                    </div>
                                    <label>OpenSCAD interchange<textarea rows="7" readonly>@selectedLayer.OpenScadScript</textarea></label>
                                    <div class="media-export-compatibility render">
                                        <b>@HtmlSupportLabel(PublicationHtmlExportSupport.RenderBeforeExport)</b>
                                        <span>Native OpenSCAD mesh, Minkowski rounding and boolean-solid output are interchange/render sources. Bake them to image or video before HTML export; the interactive canvas fallback stays available.</span>
                                    </div>
                                    <p class="property-note">The canvas blob remains interactive in HTML export. The OpenSCAD solid is an interchange/render source and must be baked for native mesh-quality video output.</p>
                                }
                            }
                        </section>

                        <section class="media-video-filter-properties">
                            <h3>Layer filters</h3>
                            <div class="media-video-filter-add">
                                <select value="@_newVideoFilterKind" @onchange="ChangeNewVideoFilterKind">
                                    @foreach (var filterKind in Enum.GetValues<VideoEffectFilterKind>())
                                    {
                                        <option value="@filterKind">@VideoFilterKindName(filterKind)</option>
                                    }
                                </select>
                                <DxButton Text="Add filter" Enabled="@(SelectedVideoLayer is not null)" Click="AddSelectedVideoFilter" />
                            </div>
                            <div class="media-video-filter-list">
                                @foreach (var filter in SelectedVideoFilters)
                                {
                                    <div class="media-video-filter-row @(filter.Id == _selectedVideoFilterId ? "selected" : null)">
                                        <button type="button" @onclick="() => SelectVideoFilter(filter.Id)">
                                            <span>@filter.Name</span><small>@VideoFilterSummary(filter) · @HtmlSupportLabel(filter.HtmlExportSupport)</small>
                                        </button>
                                        <button type="button" title="Enable or disable filter" @onclick="() => ToggleVideoFilter(filter.Id)">@(filter.Enabled ? "●" : "○")</button>
                                    </div>
                                }
                                @if (SelectedVideoFilters.Count == 0)
                                {
                                    <span class="media-empty-list">The selected layer has no filters.</span>
                                }
                            </div>
                            @if (SelectedVideoFilter is { } selectedFilter)
                            {
                                <label>Filter name<input value="@selectedFilter.Name" @onchange="ChangeVideoFilterName" /></label>
                                <div class="media-export-compatibility @HtmlSupportCss(selectedFilter.HtmlExportSupport)"><b>@HtmlSupportLabel(selectedFilter.HtmlExportSupport)</b><span>@selectedFilter.HtmlExportNote</span></div>
                                @if (selectedFilter.Kind == VideoEffectFilterKind.ChromaKey)
                                {
                                    <label>Key color<input type="color" value="@selectedFilter.Color" @oninput="ChangeVideoFilterColor" /></label>
                                    <label>Similarity <b>@Inv(selectedFilter.Amount)</b><input type="range" min="0" max="1" step="0.01" value="@Inv(selectedFilter.Amount)" @oninput="ChangeVideoFilterAmount" /></label>
                                    <label>Smoothness <b>@Inv(selectedFilter.SecondaryAmount)</b><input type="range" min="0.001" max="1" step="0.01" value="@Inv(selectedFilter.SecondaryAmount)" @oninput="ChangeVideoFilterSecondaryAmount" /></label>
                                    <label>Spill reduction <b>@Inv(selectedFilter.TertiaryAmount)</b><input type="range" min="0" max="1" step="0.01" value="@Inv(selectedFilter.TertiaryAmount)" @oninput="ChangeVideoFilterTertiaryAmount" /></label>
                                    <label>Residual opacity <b>@Inv(selectedFilter.ResidualOpacity)</b><input type="range" min="0" max="1" step="0.01" value="@Inv(selectedFilter.ResidualOpacity)" @oninput="ChangeVideoFilterResidualOpacity" /></label>
                                }
                                else if (selectedFilter.Kind == VideoEffectFilterKind.Vignette)
                                {
                                    <label>Strength <b>@Inv(selectedFilter.Amount)</b><input type="range" min="0" max="1" step="0.01" value="@Inv(selectedFilter.Amount)" @oninput="ChangeVideoFilterAmount" /></label>
                                    <label>Softness <b>@Inv(selectedFilter.SecondaryAmount)</b><input type="range" min="0" max="1" step="0.01" value="@Inv(selectedFilter.SecondaryAmount)" @oninput="ChangeVideoFilterSecondaryAmount" /></label>
                                }
                                else
                                {
                                    <label>@VideoFilterAmountLabel(selectedFilter.Kind) <b>@Inv(selectedFilter.Amount)</b>
                                        <input type="range" min="@Inv(VideoFilterMinimum(selectedFilter.Kind))" max="@Inv(VideoFilterMaximum(selectedFilter.Kind))" step="@Inv(VideoFilterStep(selectedFilter.Kind))" value="@Inv(selectedFilter.Amount)" @oninput="ChangeVideoFilterAmount" />
                                    </label>
                                    @if (selectedFilter.Kind == VideoEffectFilterKind.ColorWash)
                                    {
                                        <label>Wash color<input type="color" value="@selectedFilter.Color" @oninput="ChangeVideoFilterColor" /></label>
                                    }
                                }
                                <div class="property-action-row">
                                    <DxButton Text="Filter up" Enabled="@CanMoveVideoFilterUp" Click="MoveVideoFilterUp" />
                                    <DxButton Text="Filter down" Enabled="@CanMoveVideoFilterDown" Click="MoveVideoFilterDown" />
                                    <DxButton Text="Remove filter" Click="RemoveSelectedVideoFilter" />
                                </div>
                            }
                        </section>

                        <section>
                            <h3>Video inside play canvas</h3>
                            <label>Fit mode
                                <select value="@_videoFitMode" @onchange="ChangeVideoFitMode">
                                    @foreach (var fitMode in Enum.GetValues<PublicationVideoFitMode>())
                                    {
                                        <option value="@fitMode">@VideoFitModeName(fitMode)</option>
                                    }
                                </select>
                            </label>
                            <div class="property-action-row">
                                <DxButton Text="Fit whole" Click="VideoFitContain" />
                                <DxButton Text="Fill canvas" Click="VideoFitCover" />
                                <DxButton Text="Stretch" Click="VideoFitStretch" />
                            </div>
                            <p class="property-note">Fit whole preserves the full frame, Fill canvas crops overflow, and Stretch fills the play canvas without preserving the source aspect ratio. The selected mode is saved with the publication video.</p>
                        </section>
                    }

                    <section>
                        <h3>Timeline playback</h3>
                        <label>Start behavior
                            <select value="@_playbackTrigger" @onchange="ChangePlaybackTrigger">
                                @foreach (var value in Enum.GetValues<PublicationMediaPlaybackTrigger>())
                                {
                                    <option value="@value">@PlaybackTriggerName(value)</option>
                                }
                            </select>
                        </label>
                        <label class="check-row"><input type="checkbox" checked="@_autoPlay" @onchange="ToggleAutoPlay" /> Play during page preview/export</label>
                    </section>

                    @if (!IsVideo)
                    {
                        <section>
                            <h3>Simple mix</h3>
                            <label>Fade in <b>@Time(_fadeIn)</b><input type="range" min="0" max="@Inv(MaxFade)" step="0.05" value="@Inv(_fadeIn)" @oninput="ChangeFadeIn" /></label>
                            <label>Fade out <b>@Time(_fadeOut)</b><input type="range" min="0" max="@Inv(MaxFade)" step="0.05" value="@Inv(_fadeOut)" @oninput="ChangeFadeOut" /></label>
                            <p class="property-note">Edits are non-destructive. The source stays embedded while the selected range, fades, volume, and playback rate are stored in the publication timeline.</p>
                        </section>
                    }
                    else
                    {
                        <section>
                            <h3>Video frame region</h3>
                            <p class="property-note">Editing the <b>@ActiveFrameRegionName</b> on <b>@(SelectedVideoLayer?.Name ?? "the selected video layer")</b>. A grabbed point remains selected until another point or the canvas is selected. Delete/Backspace removes that exact point.</p>
                            @if (SelectedVideoLayer is not null)
                            {
                                <label class="check-row"><input type="checkbox" checked="@ActiveFrameRegionInverted" @onchange="ToggleFrameRegionInverted" /> Invert the active region</label>
                            }
                            <div class="property-action-row">
                                <DxButton Text="Edit source region" Enabled="@HasSource" Click="BeginFrameRegion" />
                                <DxButton Text="Edit morph target" Enabled="@(SelectedVideoLayer is not null)" Click="BeginMorphRegion" />
                                <DxButton Text="Apply" Enabled="@CanFinishFrameRegion" Click="FinishFrameRegion" />
                                <DxButton Text="Clear active" Enabled="@(HasFrameRegion || HasMorphRegion)" Click="ClearFrameRegion" />
                            </div>
                            <div class="property-action-row">
                                <DxButton Text="Copy active region" Enabled="@(ActiveFramePoints.Count >= 3)" Click="CopyFrameRegion" />
                                <DxButton Text="Paste active region" Enabled="@CanPasteFrameRegion" Click="PasteFrameRegion" />
                                <DxButton Text="Delete selected point" Enabled="@(SelectedFramePoint is not null)" Click="RemoveSelectedFramePoint" />
                            </div>
                            @if (SelectedFramePoint is { } selectedPoint)
                            {
                                <div class="media-frame-point-properties">
                                    <h4>Selected point @(_selectedFramePointIndex.GetValueOrDefault() + 1)</h4>
                                    <div class="property-grid two">
                                        <label>X (0–1)<input type="number" min="0" max="1" step="0.001" value="@Inv(selectedPoint.X)" @onchange="ChangeSelectedFramePointX" /></label>
                                        <label>Y (0–1)<input type="number" min="0" max="1" step="0.001" value="@Inv(selectedPoint.Y)" @onchange="ChangeSelectedFramePointY" /></label>
                                    </div>
                                </div>
                            }
                        </section>
                        <section>
                            <h3>Video</h3>
                            <p class="property-note">Camera and screen recording use the browser’s MediaRecorder. Completed recordings stay in the browser until this studio closes, remain downloadable at their original size, and are embedded only when you insert or apply them.</p>
                            @if (HasRetainedRecording)
                            {
                                <p class="property-note"><b>Completed recording:</b> @FormatBytes(_retainedRecordingSizeBytes). Download remains available even if embedding fails because the browser or computer runs out of memory.</p>
                            }
                        </section>
                    }
                </aside>
            </div>

            <footer class="media-studio-footer">
                <span>@FooterStatus</span>
                <div>
                    @if (HasRetainedRecording)
                    {
                        <DxButton Text="Download recording" Click="DownloadRecording" />
                    }
                    <DxButton Text="Cancel" Click="Cancel" />
                    <DxButton Text="@ApplyButtonText" Enabled="@(HasSource && !_recording && !_saving && !_embedding)" Click="Save" RenderStyle="ButtonRenderStyle.Primary" />
                </div>
            </footer>
        </section>
    </div>
}

<DxContextMenu @ref="_mediaContextMenu">
    <Items>
        <DxContextMenuItem Text="@ImportMenuText" Enabled="@(!_recording)" Click="OpenMediaPicker" />
        @if (IsVideo)
        {
            <DxContextMenuItem Text="Import open video project…" Enabled="@(!_recording)" Click="OpenVideoProjectPicker" />
            <DxContextMenuItem Text="Relink project media…" Enabled="@HasVideoProject" Click="OpenVideoProjectMediaPicker" />
            <DxContextMenuItem Text="Record camera…" Enabled="@(!_recording)" Click="RecordCamera" />
            <DxContextMenuItem Text="Record screen…" Enabled="@(!_recording)" Click="RecordScreen" />
        }
        else
        {
            <DxContextMenuItem Text="Record microphone…" Enabled="@(!_recording)" Click="RecordMicrophone" />
            <DxContextMenuItem Text="Generate example tone" Enabled="@(!_recording)" Click="GenerateTone" />
        }
        <DxContextMenuItem Text="Stop recording" Enabled="@_recording" Click="StopRecording" />
        <DxContextMenuItem Text="Download completed recording" Enabled="@HasRetainedRecording" Click="DownloadRecording" />
        <DxContextMenuItem Text="Play selected range" Enabled="@HasSource" BeginGroup="true" Click="PlaySelection" />
        <DxContextMenuItem Text="Pause" Enabled="@HasSource" Click="PausePreview" />
        <DxContextMenuItem Text="Jump to trim start" Enabled="@HasSource" Click="SeekStart" />
        <DxContextMenuItem Text="Set trim start at playhead" Enabled="@HasSource" BeginGroup="true" Click="SetTrimStartAtPlayhead" />
        <DxContextMenuItem Text="Set trim end at playhead" Enabled="@HasSource" Click="SetTrimEndAtPlayhead" />
        <DxContextMenuItem Text="Reset trim to full clip" Enabled="@HasSource" Click="ResetTrim" />
        <DxContextMenuItem Text="@MouseModeText(MediaStudioMouseMode.SelectSection, "Pointer: select timestamp/range")" BeginGroup="true" Click="SelectSectionMode" />
        <DxContextMenuItem Text="@MouseModeText(MediaStudioMouseMode.PlacePlayhead, "Pointer: place playhead")" Enabled="@HasSource" Click="PlacePlayheadMode" />
        <DxContextMenuItem Text="@MouseModeText(MediaStudioMouseMode.AddCutLine, "Pointer: add cutline")" Enabled="@HasSource" Click="AddCutLineMode" />
        @if (IsVideo)
        {
            <DxContextMenuItem Text="@MouseModeText(MediaStudioMouseMode.FrameRegion, "Pointer: frame region")" Enabled="@HasSource" Click="FrameRegionMode" />
            <DxContextMenuItem Text="@VideoFitModeText(PublicationVideoFitMode.Stretch, "Canvas: stretch")" Enabled="@HasSource" BeginGroup="true" Click="VideoFitStretch" />
            <DxContextMenuItem Text="@VideoFitModeText(PublicationVideoFitMode.Cover, "Canvas: fill and crop")" Enabled="@HasSource" Click="VideoFitCover" />
            <DxContextMenuItem Text="@VideoFitModeText(PublicationVideoFitMode.Contain, "Canvas: fit whole")" Enabled="@HasSource" Click="VideoFitContain" />
            <DxContextMenuItem Text="Cut selected timestamp/range" Enabled="@CanCutVideoSelection" BeginGroup="true" Click="CutVideoSelection" />
            <DxContextMenuItem Text="Use selected range as trim" Enabled="@CanUseVideoSelectionAsTrim" Click="UseVideoSelectionAsTrim" />
            <DxContextMenuItem Text="Copy selected range" Enabled="@CanCopyVideoSelection" Click="CopyVideoSelection" />
            <DxContextMenuItem Text="Save selection as cut section" Enabled="@CanSaveCutSection" Click="SaveSelectedRangeAsCutSection" />
            <DxContextMenuItem Text="Use selected saved section" Enabled="@(SelectedCutSection is not null)" Click="UseSelectedCutSection" />
            <DxContextMenuItem Text="Remove selected saved section" Enabled="@(SelectedCutSection is not null)" Click="RemoveSelectedCutSection" />
            <DxContextMenuItem Text="Create layer from selected range" Enabled="@CanCreateSelectionLayer" BeginGroup="true" Click="CreateSelectionLayer" />
            <DxContextMenuItem Text="Add video layer" Enabled="@HasSelectedSegment" Click="AddVideoLayer" />
            <DxContextMenuItem Text="Duplicate selected layer" Enabled="@(SelectedVideoLayer is not null)" Click="DuplicateVideoLayer" />
            <DxContextMenuItem Text="Apply selected range to layer" Enabled="@CanApplySelectionToLayer" Click="ApplySelectionToSelectedVideoLayer" />
            <DxContextMenuItem Text="Move layer up" Enabled="@CanMoveVideoLayerUp" Click="MoveVideoLayerUp" />
            <DxContextMenuItem Text="Move layer down" Enabled="@CanMoveVideoLayerDown" Click="MoveVideoLayerDown" />
            <DxContextMenuItem Text="Delete selected layer" Enabled="@CanDeleteVideoLayer" Click="DeleteVideoLayer" />
            <DxContextMenuItem Text="Convert selected layer to animated 3D blob" Enabled="@(SelectedVideoLayer is not null)" Click="ConvertSelectedLayerToBlob" />
            <DxContextMenuItem Text="Insert selected 3D blob into Mainframe" Enabled="@CanInsertLayerIntoMainframe" Click="InsertSelectedLayerIntoMainframe" />
            <DxContextMenuItem Text="Add chroma key filter" Enabled="@(SelectedVideoLayer is not null)" BeginGroup="true" Click="AddChromaKeyFilter" />
            <DxContextMenuItem Text="Add color adjustment filters" Enabled="@(SelectedVideoLayer is not null)" Click="AddColorAdjustmentFilters" />
            <DxContextMenuItem Text="Add vignette filter" Enabled="@(SelectedVideoLayer is not null)" Click="AddVignetteFilter" />
        }
        <DxContextMenuItem Text="Add cutline at playhead" Enabled="@CanAddCutLine" BeginGroup="true" Click="AddCutLineAtPlayhead" />
        <DxContextMenuItem Text="Remove cutline before selected section" Enabled="@CanRemoveCutLine" Click="RemoveCutLine" />
        <DxContextMenuItem Text="Copy selected section" Enabled="@HasSelectedSegment" Click="CopySelectedSection" />
        <DxContextMenuItem Text="Paste section after selection" Enabled="@CanPasteSection" Click="PasteSection" />
        <DxContextMenuItem Text="Delete selected section" Enabled="@CanDeleteSection" Click="DeleteSelectedSection" />
        <DxContextMenuItem Text="Insert media into selected range…" Enabled="@HasSource" Click="OpenInsertMediaPicker" />
        @if (IsVideo)
        {
            <DxContextMenuItem Text="Edit frame region" Enabled="@HasSource" BeginGroup="true" Click="BeginFrameRegion" />
            <DxContextMenuItem Text="Apply frame region" Enabled="@CanFinishFrameRegion" Click="FinishFrameRegion" />
            <DxContextMenuItem Text="Edit morph target region" Enabled="@(SelectedVideoLayer is not null)" Click="BeginMorphRegion" />
            <DxContextMenuItem Text="Delete selected region point" Enabled="@(SelectedFramePoint is not null)" Click="RemoveSelectedFramePoint" />
            <DxContextMenuItem Text="Clear active region" Enabled="@(HasFrameRegion || HasMorphRegion)" Click="ClearFrameRegion" />
        }
        <DxContextMenuItem Text="@(_muted ? "Unmute" : "Mute")" BeginGroup="true" Click="ToggleMutedFromMenu" />
        <DxContextMenuItem Text="@(_loop ? "Disable loop" : "Loop selected range")" Click="ToggleLoopFromMenu" />
        <DxContextMenuItem Text="@SendToConverterMenuText" Enabled="@HasSelectedSegment" BeginGroup="true" Click="SendSelectedMediaToConverter" />
        <DxContextMenuItem Text="Import replacement…" Enabled="@(!_recording)" BeginGroup="true" Click="OpenMediaPicker" />
    </Items>
</DxContextMenu>

<InputFile id="media-studio-file-input" class="hidden-file-input" accept="@Accept" OnChange="LoadFile" />
<InputFile id="media-studio-insert-file-input" class="hidden-file-input" accept="@Accept" OnChange="LoadInsertedFile" />
<InputFile id="media-studio-project-input" class="hidden-file-input" accept=".otio,.otioz,.mlt,.kdenlive,.xges,.osp,.edl" OnChange="LoadVideoProject" />
<InputFile id="media-studio-project-media-input" class="hidden-file-input" accept="video/*,audio/*,image/*" multiple OnChange="RelinkVideoProjectMedia" />

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public Guid SessionId { get; set; }
    [Parameter] public PublicationElementKind Kind { get; set; } = PublicationElementKind.Audio;
    [Parameter] public PublicationMediaElement? InitialMedia { get; set; }
    [Parameter] public PublicationMediaSegment? InitialInsertedSegment { get; set; }
    [Parameter] public bool EditingExisting { get; set; }
    [Parameter] public EventCallback<MediaEditorResult> Saved { get; set; }
    [Parameter] public EventCallback<MediaConversionInsertRequest> SendToMediaConverter { get; set; }
    [Parameter] public EventCallback<VideoLayerMainframeInsertRequest> InsertLayerIntoMainframe { get; set; }
    [Parameter] public EventCallback Cancelled { get; set; }

    private DotNetObjectReference<MediaStudio>? _self;
    private DxContextMenu _mediaContextMenu = default!;
    private IJSObjectReference? _module;
    private Guid _loadedSession;
    private Guid _initializedSession;
    private string _name = "Audio";
    private string _dataUrl = string.Empty;
    private string _mimeType = string.Empty;
    private string _posterDataUrl = string.Empty;
    private Guid _previewAssetId = Guid.NewGuid();
    private string _previewSource = string.Empty;
    private double _duration;
    private double _trimStart;
    private double _trimEnd;
    private double _volume = 1;
    private double _playbackRate = 1;
    private double _fadeIn;
    private double _fadeOut;
    private PublicationVideoFitMode _videoFitMode = PublicationVideoFitMode.Stretch;
    private bool _muted;
    private bool _loop;
    private bool _autoPlay = true;
    private bool _recording;
    private bool _saving;
    private bool _embedding;
    private double _embeddingProgress;
    private bool _hasRetainedRecording;
    private long _retainedRecordingSizeBytes;
    private string _retainedRecordingFileName = string.Empty;
    private string _retainedRecordingObjectUrl = string.Empty;
