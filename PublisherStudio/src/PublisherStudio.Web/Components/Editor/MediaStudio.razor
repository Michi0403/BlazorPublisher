    private double VideoSelectionTimelineStart => SourcePositionToTimeline(VideoSelectionStart);
    private double VideoSelectionTimelineEnd => SourcePositionToTimeline(VideoSelectionEnd);
    private string VideoSelectionDetailedSummary => _videoSelectionIsPoint
        ? $"Source timestamp {Time(VideoSelectionStart)} · project timestamp {Time(VideoSelectionTimelineStart)}"
        : $"Source {Time(VideoSelectionStart)} — {Time(VideoSelectionEnd)} · project {Time(VideoSelectionTimelineStart)} — {Time(VideoSelectionTimelineEnd)} · {Time(VideoSelectionEnd - VideoSelectionStart)} selected";
    private string VideoOrAudioSelectionTitle => IsVideo && _videoSelectionIsPoint ? "Selected timestamp" : "Selected range";
    private string VideoOrAudioSelectionSummary => IsVideo && _videoSelectionIsPoint
        ? $"{SelectedClipName} · {Time(_videoSelectionPointSeconds)} / {Time(_duration)}"
        : IsVideo
            ? $"{SelectedClipName} · {Time(VideoSelectionStart)} — {Time(VideoSelectionEnd)} / {Time(_duration)}"
            : $"{Time(_trimStart)} — {Time(_trimEnd)} / {Time(_duration)}";
    private string SelectedClipName => SelectedSegment?.Name ?? (IsVideo ? "No selected video clip" : "No selected audio clip");
    private double SelectedSegmentTimelineStart => SelectedSegmentIndex >= 0
        ? TimelineEdits.SegmentTimelineStart(_segments, SelectedSegmentIndex, _playbackRate)
        : 0;
    private double SelectedSegmentSourceStart => SelectedSegment?.TrimStartSeconds ?? 0;
    private bool PendingInsertHasRange => _pendingInsertMaximumSourceSeconds - _pendingInsertMinimumSourceSeconds > .01;
    private string VideoTimeOverlayStyle
    {
        get
        {
            var duration = Math.Max(.01, _duration);
            var start = Math.Clamp(VideoSelectionStart / duration, 0, 1);
            var end = Math.Clamp(VideoSelectionEnd / duration, 0, 1);
            var point = Math.Clamp((_videoSelectionIsPoint ? _videoSelectionPointSeconds : _trimStart) / duration, 0, 1);
            return $"--video-time-start:{Percent(start)};--video-time-end:{Percent(end)};--video-time-playhead:{Percent(point)};";
        }
    }
    private string VideoSequenceSelectionStyle
    {
        get
        {
            var index = SelectedSegmentIndex;
            if (index < 0 || index >= _segments.Count) return "left:0;width:0";
            var sequenceDuration = Math.Max(.01, SequenceDuration);
            var segment = _segments[index];
            var segmentStart = TimelineEdits.SegmentTimelineStart(_segments, index, _playbackRate);
            var rate = Math.Max(.1, _playbackRate);
            var start = segmentStart + (Math.Clamp(VideoSelectionStart, segment.TrimStartSeconds, segment.EffectiveTrimEndSeconds) - segment.TrimStartSeconds) / rate;
            var end = segmentStart + (Math.Clamp(VideoSelectionEnd, segment.TrimStartSeconds, segment.EffectiveTrimEndSeconds) - segment.TrimStartSeconds) / rate;
            if (_videoSelectionIsPoint) return $"left:{Percent(start / sequenceDuration)};width:2px";
            return $"left:{Percent(start / sequenceDuration)};width:{Percent(Math.Max(0, end - start) / sequenceDuration)}";
        }
    }
    private string VideoSequenceSelectionTitle => _videoSelectionIsPoint
        ? $"{SelectedClipName}: timestamp {Time(VideoSelectionStart)}"
        : $"{SelectedClipName}: selected {Time(VideoSelectionStart)} — {Time(VideoSelectionEnd)}";
    private string FramePolylinePoints => string.Join(" ", ActiveFramePoints.Select(point => $"{Inv(point.X * 1000)},{Inv(point.Y * 1000)}"));
    private string FramePolygonPoints => FramePolylinePoints;
    private string FrameDimPath => ActiveFramePoints.Count >= 3
        ? $"M 0 0 H 1000 V 1000 H 0 Z M {string.Join(" L ", ActiveFramePoints.Select(point => $"{Inv(point.X * 1000)} {Inv(point.Y * 1000)}"))} Z"
        : "M 0 0 H 1000 V 1000 H 0 Z";
    private string VideoPreviewStyle
    {
        get
        {
            var fit = _videoFitMode switch
            {
                PublicationVideoFitMode.Cover => "cover",
                PublicationVideoFitMode.Stretch => "fill",
                _ => "contain"
            };
            var clip = !_frameRegionEditing && _frameClipPolygon.Count >= 3
                ? $"clip-path:{FrameClipCss(_frameClipPolygon)};"
                : string.Empty;
            return $"object-fit:{fit};{clip}";
        }
    }
    private string MouseModeLabel => _mouseMode switch
    {
        MediaStudioMouseMode.SelectSection => "Select section",
        MediaStudioMouseMode.PlacePlayhead => "Place playhead",
        MediaStudioMouseMode.AddCutLine => "Add cutline",
        MediaStudioMouseMode.FrameRegion => "Frame region",
        _ => "Select section"
    };
    private string SelectedSectionSummary => SelectedSegment is { } segment
        ? $"{segment.Name} · {Time(segment.SourceLengthSeconds / Math.Max(.1, _playbackRate))}"
        : "None";
    private string ImportMenuText => $"Import {(IsVideo ? "video" : "audio")}…";
    private string Accept => IsVideo ? "video/mp4,video/webm,video/ogg,video/quicktime" : "audio/mpeg,audio/wav,audio/ogg,audio/webm,audio/mp4,audio/aac,audio/flac";
    private string MimeLabel => string.IsNullOrWhiteSpace(_mimeType) ? (IsVideo ? "Video" : "Audio") : _mimeType;
    private string SourceStatus => _recording
        ? "Recording…"
        : _embedding
            ? $"Embedding recording · {_embeddingProgress:0}%"
            : HasRetainedRecording
                ? $"Recording ready · {FormatBytes(_retainedRecordingSizeBytes)} · download protected"
                : HasSource ? $"Ready · {Time(_trimEnd - _trimStart)} selected" : "No source";
    private string ApplyButtonText => _embedding ? $"Embedding {_embeddingProgress:0}%" : _saving ? "Applying…" : EditingExisting ? "Apply media" : "Insert media";
    private string FooterStatus => _error ?? _warning ??
        (HasRetainedRecording
            ? $"{MimeLabel} · {Time(_duration)} · {FormatBytes(_retainedRecordingSizeBytes)} · available to download"
            : HasSource ? $"{MimeLabel} · {Time(_duration)}" : "Import or record a source to begin.");
    private IEnumerable<double> DisplayWaveform => _waveform.Count > 0 ? _waveform : Enumerable.Repeat(.22, 64);
    private double MaxFade => Math.Max(.05, Math.Min(10, (_trimEnd - _trimStart) / Math.Max(.25, _playbackRate) / 2));
    private double RangeSelectorEnd => Math.Max(.01, double.IsFinite(_duration) ? _duration : 0);
    private double RangeSelectorMinRange => Math.Min(.05, RangeSelectorEnd);
    private double MajorTick => _duration switch { <= 10 => 1, <= 30 => 5, <= 120 => 10, <= 600 => 60, _ => 300 };
    private double MinorTick => Math.Max(.1, MajorTick / 5);

    protected override void OnParametersSet()
    {
        if (!Visible || SessionId == Guid.Empty || SessionId == _loadedSession) return;
        _loadedSession = SessionId;
        MediaAssets.Remove(_previewAssetId);
        _previewAssetId = Guid.NewGuid();
        _previewSource = string.Empty;
        _error = null;
        _warning = null;
        _recording = false;
        _saving = false;
        _embedding = false;
        _embeddingProgress = 0;
        _hasRetainedRecording = false;
        _retainedRecordingSizeBytes = 0;
        _retainedRecordingFileName = string.Empty;
        _retainedRecordingObjectUrl = string.Empty;
        _segments.Clear();
        _selectedSegmentId = null;
        _playhead = 0;
        _mouseMode = MediaStudioMouseMode.SelectSection;
        _frameClipPolygon.Clear();
        _frameDraft.Clear();
        _frameRegionEditing = false;
        _videoSelectionIsPoint = false;
        _videoSelectionPointSeconds = 0;
        _videoSelectionStartSeconds = 0;
        _videoSelectionEndSeconds = 0;
        _videoFitMode = PublicationVideoFitMode.Contain;
        ClearPendingInsert();

        if (InitialMedia is { } media)
        {
            _volume = media.Volume;
            _playbackRate = media.PlaybackRate;
            _fadeIn = media.FadeInSeconds;
            _fadeOut = media.FadeOutSeconds;
            _muted = media.Muted;
            _loop = media.Loop;
            _autoPlay = media.AutoPlay;
            _playbackTrigger = media.PlaybackTrigger;
            var sourceSegments = media.Segments is { Count: > 0 }
                ? media.Segments
                : [new PublicationMediaSegment
                {
                    Name = media.Name,
                    DataUrl = media.DataUrl,
                    MimeType = media.MimeType,
                    PosterDataUrl = media is VideoElement legacyVideo ? legacyVideo.PosterDataUrl : string.Empty,
                    DurationSeconds = media.DurationSeconds,
                    TrimStartSeconds = media.TrimStartSeconds,
                    TrimEndSeconds = media.EffectiveTrimEndSeconds,
                    WaveformSamples = [.. media.WaveformSamples]
                }];
            _segments.AddRange(TimelineEdits.Normalize(sourceSegments, IsVideo));
