@namespace PublisherStudio.Components.Editor
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject PublicationMediaAssetStore MediaAssets
@inject MediaTimelineEditService TimelineEdits

@if (Visible)
{
    <div class="editor-modal-backdrop media-studio-backdrop">
        <section id="media-studio-window" class="media-studio-window" tabindex="0" role="dialog" aria-modal="true" aria-label="@(IsVideo ? "Video Studio" : "Audio Studio")">
            <header class="media-studio-titlebar">
                <div>
                    <strong>@(IsVideo ? "Video Studio" : "Audio Studio")</strong>
                    <span>@(EditingExisting ? "Edit the selected media object" : IsVideo ? "Import or record a video" : "Import, record, trim, and mix a simple audio clip")</span>
                </div>
                <button type="button" title="Close" @onclick="Cancel">×</button>
            </header>

            <DxRibbon CssClass="media-studio-ribbon categorized-ribbon" SizeMode="SizeMode.Small" AdaptivityAutoCollapseItemsToGroups="true">
                <DxRibbonTab Text="Home">
                    <DxRibbonGroup Text="Source" IconCssClass="pub-icon pub-icon-media">
                        <DxRibbonItem Text="@ImportMenuText" IconCssClass="pub-icon pub-icon-open" IsPrimary="true" Enabled="@(!_recording)" Click="OpenMediaPicker" />
                        @if (IsVideo)
                        {
                            <DxRibbonItem Text="Record camera" IconCssClass="pub-icon pub-icon-video" Enabled="@(!_recording)" Click="RecordCamera" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-video" Text="Record screen" Enabled="@(!_recording)" Click="RecordScreen" />
                        }
                        else
                        {
                            <DxRibbonItem Text="Record microphone" IconCssClass="pub-icon pub-icon-audio" Enabled="@(!_recording)" Click="RecordMicrophone" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-audio" Text="Generate tone" Enabled="@(!_recording)" Click="GenerateTone" />
                        }
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-stop" Text="Stop recording" Enabled="@_recording" Click="StopRecording" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-download" Text="Download recording" Enabled="@HasRetainedRecording" Click="DownloadRecording" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Playback">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-play" Text="Play range" Enabled="@HasSource" Click="PlaySelection" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-pause" Text="Pause" Enabled="@HasSource" Click="PausePreview" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-crop" Text="To trim start" Enabled="@HasSource" Click="SeekStart" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Trim">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-play" Text="Start at playhead" Enabled="@HasSource" Click="SetTrimStartAtPlayhead" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-play" Text="End at playhead" Enabled="@HasSource" Click="SetTrimEndAtPlayhead" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-crop" Text="Reset trim" Enabled="@HasSource" Click="ResetTrim" />
                    </DxRibbonGroup>
                    @if (IsVideo)
                    {
                        <DxRibbonGroup Text="Selection">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-line" Text="Cut selection" Enabled="@CanCutVideoSelection" Click="CutVideoSelection" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-crop" Text="Trim to selection" Enabled="@CanUseVideoSelectionAsTrim" Click="UseVideoSelectionAsTrim" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-copy" Text="Copy selection" Enabled="@CanCopyVideoSelection" Click="CopyVideoSelection" />
                        </DxRibbonGroup>
                    }
                    <DxRibbonGroup Text="Gestures">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-select" Text="@MouseModeText(MediaStudioMouseMode.SelectSection, "Select section")" Click="SelectSectionMode" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-line" Text="@MouseModeText(MediaStudioMouseMode.PlacePlayhead, "Place playhead")" Click="PlacePlayheadMode" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-crop" Text="@MouseModeText(MediaStudioMouseMode.AddCutLine, "Add cutline")" Enabled="@HasSource" Click="AddCutLineMode" />
                        @if (IsVideo)
                        {
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-select" Text="@MouseModeText(MediaStudioMouseMode.FrameRegion, "Frame region")" Enabled="@HasSource" Click="FrameRegionMode" />
                        }
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Sections">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-line" Text="Cut at playhead" Enabled="@CanAddCutLine" Click="AddCutLineAtPlayhead" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text="Remove cutline" Enabled="@CanRemoveCutLine" Click="RemoveCutLine" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-copy" Text="Copy" Enabled="@HasSelectedSegment" Click="CopySelectedSection" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-paste" Text="Paste" Enabled="@CanPasteSection" Click="PasteSection" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text="Delete" Enabled="@CanDeleteSection" Click="DeleteSelectedSection" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-insert" Text="Insert into range…" Enabled="@HasSource" Click="OpenInsertMediaPicker" />
                    </DxRibbonGroup>
                </DxRibbonTab>
            </DxRibbon>
            <div class="media-studio-source-state" role="status">@SourceStatus</div>

            <div class="media-studio-body">
                <div class="media-studio-preview-column">
                    <div class="media-studio-preview-shell @(IsVideo ? "video" : "audio") @(_mouseMode == MediaStudioMouseMode.FrameRegion ? "frame-region-mode" : null)"
                         @oncontextmenu="ShowMediaContextMenu" @oncontextmenu:preventDefault>
                        @if (IsVideo)
                        {
                            <div id="media-studio-frame-stage" class="media-studio-frame-stage">
                                <video id="media-studio-preview"
                                       src="@_previewSource"
                                       poster="@_posterDataUrl"
                                       playsinline
                                       preload="metadata"
                                       disablepictureinpicture
                                       controlslist="nofullscreen nodownload noremoteplayback"
                                       style="@VideoPreviewStyle"></video>
                                <div id="media-studio-video-time-overlay"
                                     class="media-video-time-overlay @(_videoSelectionIsPoint ? "point-selection" : "range-selection") @(_mouseMode == MediaStudioMouseMode.FrameRegion ? "disabled" : null)"
                                     data-duration="@Inv(_duration)"
                                     data-trim-start="@Inv(_trimStart)"
                                     data-trim-end="@Inv(_trimEnd)"
                                     data-selection-start="@Inv(VideoSelectionStart)"
                                     data-selection-end="@Inv(VideoSelectionEnd)"
                                     data-selection-point="@(_videoSelectionIsPoint ? "true" : "false")"
                                     data-clip-name="@SelectedClipName"
                                     data-sequence-duration="@Inv(SequenceDuration)"
                                     data-segment-timeline-start="@Inv(SelectedSegmentTimelineStart)"
                                     data-segment-source-start="@Inv(SelectedSegmentSourceStart)"
                                     data-playback-rate="@Inv(_playbackRate)"
                                     style="@VideoTimeOverlayStyle"
                                     role="application"
                                     aria-label="Video timestamp and range selector">
                                    <div class="media-video-time-toolbar" data-video-time-control>
                                        <button type="button" title="Play selected range" @onclick="PlaySelection" @onclick:stopPropagation>▶</button>
                                        <button type="button" title="Pause video" @onclick="PausePreview" @onclick:stopPropagation>Ⅱ</button>
                                        <span class="media-video-time-readout">
                                            <b id="media-studio-video-selection-label">@VideoSelectionLabel</b>
                                            <span id="media-studio-video-current-time">@Time(VideoSelectionStart)</span>
                                            <span id="media-studio-video-selection-readout">@VideoSelectionReadout</span>
                                        </span>
                                    </div>
                                    <div class="media-video-time-track" data-video-time-track>
                                        <span class="media-video-time-selected" aria-hidden="true"></span>
                                        <span class="media-video-time-handle start" data-video-time-handle="start" title="Drag selection start"></span>
                                        <span class="media-video-time-handle end" data-video-time-handle="end" title="Drag selection end"></span>
                                        <span class="media-video-time-point" aria-hidden="true"></span>
                                        <span class="media-video-time-playhead" aria-hidden="true"></span>
                                        <span class="media-video-time-drop-marker" aria-hidden="true"></span>
                                    </div>
                                    <div class="media-video-time-help">Click for one timestamp · drag for a range · the selection follows the active sequence clip</div>

                                    @if (_pendingInsertSegment is not null)
                                    {
                                        <div class="media-video-insert-placement" data-video-time-control @onpointerdown:stopPropagation @onclick:stopPropagation>
                                            <div>
                                                <b>Insert dropped video</b>
                                                <span>@_pendingInsertSegment.Name</span>
                                            </div>
                                            @if (PendingInsertHasRange)
                                            {
                                                <label>
                                                    Position inside selection
                                                    <input type="range"
                                                           min="@Inv(_pendingInsertMinimumSourceSeconds)"
                                                           max="@Inv(_pendingInsertMaximumSourceSeconds)"
                                                           step="0.01"
                                                           value="@Inv(_pendingInsertSourceSeconds)"
                                                           @oninput="ChangePendingInsertPosition" />
                                                </label>
                                            }
                                            else
                                            {
                                                <span class="media-video-insert-fixed">The selected timestamp is fixed.</span>
                                            }
                                            <div class="media-video-insert-actions">
                                                <time>@Time(_pendingInsertSourceSeconds)</time>
                                                <button type="button" @onclick="ConfirmPendingInsert">Insert here</button>
                                                <button type="button" @onclick="CancelPendingInsert">Cancel</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div id="media-studio-frame-overlay-host"
                                     class="media-studio-frame-overlay-host @(_mouseMode == MediaStudioMouseMode.FrameRegion ? "active" : null)"
                                     role="application"
                                     aria-label="Video frame region selection"
                                     @onpointerdown="FrameOverlayPointerDown"
                                     @onpointerdown:preventDefault
                                     @onpointerdown:stopPropagation
                                     @ondblclick="FinishFrameRegion"
                                     @ondblclick:preventDefault
                                     @ondblclick:stopPropagation
                                     @oncontextmenu="ShowMediaContextMenu"
                                     @oncontextmenu:preventDefault
                                     @oncontextmenu:stopPropagation>
                                    <svg class="media-studio-frame-overlay" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
                                        <path class="media-frame-dim" d="@FrameDimPath" fill-rule="evenodd" />
                                        @if (ActiveFramePoints.Count >= 2)
                                        {
                                            <polyline class="media-frame-cutline" points="@FramePolylinePoints" />
                                        }
                                        @if (ActiveFramePoints.Count >= 3)
                                        {
                                            <polygon class="media-frame-selection" points="@FramePolygonPoints" />
                                        }
                                        @for (var pointIndex = 0; pointIndex < ActiveFramePoints.Count; pointIndex++)
                                        {
                                            var point = ActiveFramePoints[pointIndex];
                                            <circle class="media-frame-node" cx="@Inv(point.X * 1000)" cy="@Inv(point.Y * 1000)" r="9" />
                                        }
                                    </svg>
                                    <span class="media-frame-cursor-ring" aria-hidden="true"></span>
                                    <div class="media-frame-mode-help">
                                        <b>Frame region mode</b>
                                        <span>Click/tap vertices · Enter or double-click applies · Esc cancels</span>
                                    </div>
                                    <div class="media-frame-overlay-actions" @onpointerdown:stopPropagation>
                                        <button type="button" disabled="@(!CanFinishFrameRegion)" @onclick="FinishFrameRegion">Apply region</button>
                                        <button type="button" disabled="@(!_frameRegionEditing || _frameDraft.Count == 0)" @onclick="RemoveLastFramePoint">Undo point</button>
                                        <button type="button" @onclick="CancelFrameRegion">Exit mode</button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="media-studio-audio-card">
                                <div class="media-studio-waveform" aria-label="Audio waveform">
                                    @foreach (var sample in DisplayWaveform)
                                    {
                                        <i style="height:@WaveHeight(sample)"></i>
                                    }
                                </div>
                                <audio id="media-studio-preview" src="@_previewSource" controls preload="metadata"></audio>
                            </div>
                        }
                    </div>

                    <div class="media-transport-status" role="status">
                        <strong id="media-studio-selection-title">@VideoOrAudioSelectionTitle</strong>
                        <span id="media-studio-selection-summary">@VideoOrAudioSelectionSummary</span>
                    </div>

                    @if (HasSource)
                    {
                        <div class="media-sequence-editor">
                            <div class="media-range-caption"><b>Sequence</b><span>@Time(SequenceDuration) · @_segments.Count section@(_segments.Count == 1 ? string.Empty : "s")</span></div>
                            <div id="media-studio-sequence-timeline" class="media-sequence-timeline mode-@_mouseMode.ToString().ToLowerInvariant()" tabindex="0"
                                 @onpointerdown="TimelinePointerDown"
                                 @oncontextmenu="ShowTimelineContextMenu" @oncontextmenu:preventDefault>
                                @foreach (var segment in _segments)
                                {
                                    <button type="button" class="media-sequence-segment @(segment.Id == _selectedSegmentId ? "selected" : null)"
                                            style="@SegmentStyle(segment)" title="@segment.Name · @Time(segment.SourceLengthSeconds / Math.Max(.1, _playbackRate))">
                                        <span>@segment.Name</span>
                                    </button>
                                }
                                @foreach (var boundary in CutBoundaryPositions)
                                {
                                    <i class="media-cutline" style="left:@Percent(boundary / Math.Max(.01, SequenceDuration))"></i>
                                }
                                @if (IsVideo && HasSelectedSegment)
                                {
                                    <i id="media-studio-sequence-selection"
                                       class="media-sequence-selection @(_videoSelectionIsPoint ? "point" : "range")"
                                       style="@VideoSequenceSelectionStyle"
                                       title="@VideoSequenceSelectionTitle"></i>
                                }
                                <i class="media-playhead" style="left:@Percent(_playhead / Math.Max(.01, SequenceDuration))"></i>
                            </div>
                            <div class="media-sequence-status">
                                <span><b>Mode:</b> @MouseModeLabel</span>
                                <span><b>Playhead:</b> @Time(_playhead)</span>
                                <span><b>Selected:</b> @SelectedSectionSummary</span>
                            </div>
                        </div>

                        @if (!IsVideo)
                        {
                            <div class="media-range-selector" @oncontextmenu="ShowMediaContextMenu" @oncontextmenu:preventDefault>
                                <div class="media-range-caption"><b>Trim range</b><span>@Time(_trimEnd - _trimStart) selected</span></div>
                                <DxRangeSelector Height="96px"
                                                 SelectedRangeStartValue="@_trimStart"
                                                 SelectedRangeEndValue="@_trimEnd"
                                                 ValueChanged="TrimRangeChanged"
                                                 ValueChangeMode="RangeSelectorValueChangeMode.OnHandleMove"
                                                 AllowMouseSelection="true"
                                                 MoveSelectedRangeByClick="true">
                                    <DxRangeSelectorScale StartValue="@(0d)"
                                                          EndValue="@RangeSelectorEnd"
                                                          ValueType="ChartAxisDataType.Numeric"
                                                          TickInterval="@MajorTick"
                                                          MinorTickInterval="@MinorTick"
                                                          MinRange="@RangeSelectorMinRange">
                                        <DxRangeSelectorScaleMarker Visible="false" />
                                    </DxRangeSelectorScale>
                                    <DxRangeSelectorSliderMarker Visible="true" />
                                </DxRangeSelector>
                            </div>
                        }
                    }
                </div>

                <aside class="media-studio-properties">
                    <section>
                        <h3>Clip</h3>
                        <label>Name<input value="@_name" @onchange="ChangeName" /></label>
                        <div class="property-grid two">
                            <label>Trim start<input type="number" min="0" max="@Inv(_duration)" step="0.01" value="@Inv(_trimStart)" @onchange="ChangeTrimStart" /></label>
                            <label>Trim end<input type="number" min="0" max="@Inv(_duration)" step="0.01" value="@Inv(_trimEnd)" @onchange="ChangeTrimEnd" /></label>
                        </div>
                        <label>Playback rate <b>@_playbackRate.ToString("0.##", CultureInfo.InvariantCulture)×</b>
                            <input type="range" min="0.25" max="2" step="0.05" value="@Inv(_playbackRate)" @oninput="ChangePlaybackRate" />
                        </label>
                        <label>Volume <b>@Math.Round(_volume * 100)%</b>
                            <input type="range" min="0" max="1" step="0.01" value="@Inv(_volume)" @oninput="ChangeVolume" />
                        </label>
                        <label class="check-row"><input type="checkbox" checked="@_muted" @onchange="ToggleMuted" /> Muted</label>
                        <label class="check-row"><input type="checkbox" checked="@_loop" @onchange="ToggleLoop" /> Loop selected range</label>
                    </section>

                    @if (IsVideo)
                    {
                        <section class="media-video-selection-properties">
                            <h3>Selected clip time</h3>
                            <p class="property-note"><b>@SelectedClipName</b> · source timestamps stay linked to the highlighted clip in the project sequence.</p>
                            <label>Selection type
                                <select id="media-studio-video-selection-mode" value="@(_videoSelectionIsPoint ? "Point" : "Range")" @onchange="ChangeVideoSelectionMode">
                                    <option value="Point">Single timestamp</option>
                                    <option value="Range">Time range</option>
                                </select>
                            </label>
                            <div class="property-grid two">
                                <label>Selection start
                                    <input id="media-studio-video-selection-start"
                                           type="number"
                                           min="@Inv(_trimStart)"
                                           max="@Inv(_trimEnd)"
                                           step="0.01"
                                           value="@Inv(VideoSelectionStart)"
                                           @onchange="ChangeVideoSelectionStart" />
                                </label>
                                <label>Selection end
                                    <input id="media-studio-video-selection-end"
                                           type="number"
                                           min="@Inv(_trimStart)"
                                           max="@Inv(_trimEnd)"
                                           step="0.01"
                                           value="@Inv(VideoSelectionEnd)"
                                           disabled="@_videoSelectionIsPoint"
                                           @onchange="ChangeVideoSelectionEnd" />
                                </label>
                            </div>
                            <div class="media-video-selection-value" id="media-studio-video-selection-value">@VideoSelectionDetailedSummary</div>
                            <div class="property-action-row">
                                <DxButton Text="Cut selection" Enabled="@CanCutVideoSelection" Click="CutVideoSelection" />
                                <DxButton Text="Use as trim" Enabled="@CanUseVideoSelectionAsTrim" Click="UseVideoSelectionAsTrim" />
                                <DxButton Text="Copy area" Enabled="@CanCopyVideoSelection" Click="CopyVideoSelection" />
                            </div>
                            <p class="property-note">A point creates one cutline. A range creates cutlines at both boundaries and selects the resulting middle clip. Dropped video is inserted only inside this selection.</p>
                        </section>

                        <section>
                            <h3>Video inside play canvas</h3>
                            <label>Fit mode
                                <select value="@_videoFitMode" @onchange="ChangeVideoFitMode">
                                    @foreach (var fitMode in Enum.GetValues<PublicationVideoFitMode>())
                                    {
                                        <option value="@fitMode">@VideoFitModeName(fitMode)</option>
                                    }
                                </select>
                            </label>
                            <div class="property-action-row">
                                <DxButton Text="Fit whole" Click="VideoFitContain" />
                                <DxButton Text="Fill canvas" Click="VideoFitCover" />
                                <DxButton Text="Stretch" Click="VideoFitStretch" />
                            </div>
                            <p class="property-note">Fit whole preserves the full frame, Fill canvas crops overflow, and Stretch fills the play canvas without preserving the source aspect ratio. The selected mode is saved with the publication video.</p>
                        </section>
                    }

                    <section>
                        <h3>Timeline playback</h3>
                        <label>Start behavior
                            <select value="@_playbackTrigger" @onchange="ChangePlaybackTrigger">
                                @foreach (var value in Enum.GetValues<PublicationMediaPlaybackTrigger>())
                                {
                                    <option value="@value">@PlaybackTriggerName(value)</option>
                                }
                            </select>
                        </label>
                        <label class="check-row"><input type="checkbox" checked="@_autoPlay" @onchange="ToggleAutoPlay" /> Play during page preview/export</label>
                    </section>

                    @if (!IsVideo)
                    {
                        <section>
                            <h3>Simple mix</h3>
                            <label>Fade in <b>@Time(_fadeIn)</b><input type="range" min="0" max="@Inv(MaxFade)" step="0.05" value="@Inv(_fadeIn)" @oninput="ChangeFadeIn" /></label>
                            <label>Fade out <b>@Time(_fadeOut)</b><input type="range" min="0" max="@Inv(MaxFade)" step="0.05" value="@Inv(_fadeOut)" @oninput="ChangeFadeOut" /></label>
                            <p class="property-note">Edits are non-destructive. The source stays embedded while the selected range, fades, volume, and playback rate are stored in the publication timeline.</p>
                        </section>
                    }
                    else
                    {
                        <section>
                            <h3>Video frame region</h3>
                            <p class="property-note">A polygon region uses normalized frame coordinates, so every angle and video dimension remains stable in the Mainframe and every PublisherStudio export.</p>
                            <div class="property-action-row">
                                <DxButton Text="Edit region" Enabled="@HasSource" Click="BeginFrameRegion" />
                                <DxButton Text="Apply" Enabled="@CanFinishFrameRegion" Click="FinishFrameRegion" />
                                <DxButton Text="Clear" Enabled="@HasFrameRegion" Click="ClearFrameRegion" />
                            </div>
                            <div class="property-action-row">
                                <DxButton Text="Copy region" Enabled="@HasFrameRegion" Click="CopyFrameRegion" />
                                <DxButton Text="Paste region" Enabled="@CanPasteFrameRegion" Click="PasteFrameRegion" />
                                <DxButton Text="Remove last line" Enabled="@(_frameRegionEditing && _frameDraft.Count > 0)" Click="RemoveLastFramePoint" />
                            </div>
                        </section>
                        <section>
                            <h3>Video</h3>
                            <p class="property-note">Camera and screen recording use the browser’s MediaRecorder. Completed recordings stay in the browser until this studio closes, remain downloadable at their original size, and are embedded only when you insert or apply them.</p>
                            @if (HasRetainedRecording)
                            {
                                <p class="property-note"><b>Completed recording:</b> @FormatBytes(_retainedRecordingSizeBytes). Download remains available even if embedding fails because the browser or computer runs out of memory.</p>
                            }
                        </section>
                    }
                </aside>
            </div>

            <footer class="media-studio-footer">
                <span>@FooterStatus</span>
                <div>
                    @if (HasRetainedRecording)
                    {
                        <DxButton Text="Download recording" Click="DownloadRecording" />
                    }
                    <DxButton Text="Cancel" Click="Cancel" />
                    <DxButton Text="@ApplyButtonText" Enabled="@(HasSource && !_recording && !_saving && !_embedding)" Click="Save" RenderStyle="ButtonRenderStyle.Primary" />
                </div>
            </footer>
        </section>
    </div>
}

<DxContextMenu @ref="_mediaContextMenu">
    <Items>
        <DxContextMenuItem Text="@ImportMenuText" Enabled="@(!_recording)" Click="OpenMediaPicker" />
        @if (IsVideo)
        {
            <DxContextMenuItem Text="Record camera…" Enabled="@(!_recording)" Click="RecordCamera" />
            <DxContextMenuItem Text="Record screen…" Enabled="@(!_recording)" Click="RecordScreen" />
        }
        else
        {
            <DxContextMenuItem Text="Record microphone…" Enabled="@(!_recording)" Click="RecordMicrophone" />
            <DxContextMenuItem Text="Generate example tone" Enabled="@(!_recording)" Click="GenerateTone" />
        }
        <DxContextMenuItem Text="Stop recording" Enabled="@_recording" Click="StopRecording" />
        <DxContextMenuItem Text="Download completed recording" Enabled="@HasRetainedRecording" Click="DownloadRecording" />
        <DxContextMenuItem Text="Play selected range" Enabled="@HasSource" BeginGroup="true" Click="PlaySelection" />
        <DxContextMenuItem Text="Pause" Enabled="@HasSource" Click="PausePreview" />
        <DxContextMenuItem Text="Jump to trim start" Enabled="@HasSource" Click="SeekStart" />
        <DxContextMenuItem Text="Set trim start at playhead" Enabled="@HasSource" BeginGroup="true" Click="SetTrimStartAtPlayhead" />
        <DxContextMenuItem Text="Set trim end at playhead" Enabled="@HasSource" Click="SetTrimEndAtPlayhead" />
        <DxContextMenuItem Text="Reset trim to full clip" Enabled="@HasSource" Click="ResetTrim" />
        @if (IsVideo)
        {
            <DxContextMenuItem Text="Cut selected timestamp/range" Enabled="@CanCutVideoSelection" BeginGroup="true" Click="CutVideoSelection" />
            <DxContextMenuItem Text="Use selected range as trim" Enabled="@CanUseVideoSelectionAsTrim" Click="UseVideoSelectionAsTrim" />
            <DxContextMenuItem Text="Copy selected range" Enabled="@CanCopyVideoSelection" Click="CopyVideoSelection" />
        }
        <DxContextMenuItem Text="Add cutline at playhead" Enabled="@CanAddCutLine" BeginGroup="true" Click="AddCutLineAtPlayhead" />
        <DxContextMenuItem Text="Remove cutline before selected section" Enabled="@CanRemoveCutLine" Click="RemoveCutLine" />
        <DxContextMenuItem Text="Copy selected section" Enabled="@HasSelectedSegment" Click="CopySelectedSection" />
        <DxContextMenuItem Text="Paste section after selection" Enabled="@CanPasteSection" Click="PasteSection" />
        <DxContextMenuItem Text="Delete selected section" Enabled="@CanDeleteSection" Click="DeleteSelectedSection" />
        <DxContextMenuItem Text="Insert media into selected range…" Enabled="@HasSource" Click="OpenInsertMediaPicker" />
        @if (IsVideo)
        {
            <DxContextMenuItem Text="Edit frame region" Enabled="@HasSource" BeginGroup="true" Click="BeginFrameRegion" />
            <DxContextMenuItem Text="Apply frame region" Enabled="@CanFinishFrameRegion" Click="FinishFrameRegion" />
            <DxContextMenuItem Text="Clear frame region" Enabled="@HasFrameRegion" Click="ClearFrameRegion" />
        }
        <DxContextMenuItem Text="@(_muted ? "Unmute" : "Mute")" BeginGroup="true" Click="ToggleMutedFromMenu" />
        <DxContextMenuItem Text="@(_loop ? "Disable loop" : "Loop selected range")" Click="ToggleLoopFromMenu" />
        <DxContextMenuItem Text="Import replacement…" Enabled="@(!_recording)" BeginGroup="true" Click="OpenMediaPicker" />
    </Items>
</DxContextMenu>

<InputFile id="media-studio-file-input" class="hidden-file-input" accept="@Accept" OnChange="LoadFile" />
<InputFile id="media-studio-insert-file-input" class="hidden-file-input" accept="@Accept" OnChange="LoadInsertedFile" />

