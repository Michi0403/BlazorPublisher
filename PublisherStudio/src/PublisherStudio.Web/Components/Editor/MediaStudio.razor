    protected override void OnParametersSet()
    {
        if (!Visible || SessionId == Guid.Empty || SessionId == _loadedSession) return;
        _loadedSession = SessionId;
        MediaAssets.Remove(_previewAssetId);
        _previewAssetId = Guid.NewGuid();
        _previewSource = string.Empty;
        _error = null;
        _warning = null;
        _recording = false;
        _saving = false;
        _embedding = false;
        _embeddingProgress = 0;
        _hasRetainedRecording = false;
        _retainedRecordingSizeBytes = 0;
        _retainedRecordingFileName = string.Empty;
        _retainedRecordingObjectUrl = string.Empty;
        _segments.Clear();
        _selectedSegmentId = null;
        _playhead = 0;
        _mouseMode = MediaStudioMouseMode.SelectSection;
        _frameClipPolygon.Clear();
        _morphClipPolygon.Clear();
        _frameDraft.Clear();
        _frameRegionEditing = false;
        _editingMorphRegion = false;
        _selectedFramePointIndex = null;
        _selectedVideoLayerId = null;
        _selectedVideoFilterId = null;
        _selectedCutSectionId = null;
        _newVideoFilterKind = VideoEffectFilterKind.ChromaKey;
        _videoSelectionIsPoint = false;
        _videoSelectionPointSeconds = 0;
        _videoSelectionStartSeconds = 0;
        _videoSelectionEndSeconds = 0;
        _videoFitMode = PublicationVideoFitMode.Stretch;
        _videoProject = null;
        _activeProjectTrackId = Guid.Empty;
        _videoProjectIssues = [];
        ClearPendingInsert();

        if (InitialMedia is { } media)
        {
            _volume = media.Volume;
            _playbackRate = media.PlaybackRate;
            _fadeIn = media.FadeInSeconds;
            _fadeOut = media.FadeOutSeconds;
            _muted = media.Muted;
            _loop = media.Loop;
            _autoPlay = media.AutoPlay;
            _playbackTrigger = media.PlaybackTrigger;
            IEnumerable<PublicationMediaSegment> sourceSegments;
            if (media is VideoElement projectVideo && projectVideo.VideoProject is { Tracks.Count: > 0 } project)
            {
                _videoProject = TimelineEdits.CloneVideoProject(project);
                _activeProjectTrackId = ResolveActiveProjectTrackId(_videoProject);
                sourceSegments = TimelineEdits.CreateTrackProjection(_videoProject, _activeProjectTrackId);
            }
            else
            {
                sourceSegments = media.Segments is { Count: > 0 }
                    ? media.Segments
                    : [new PublicationMediaSegment
                    {
                        Name = media.Name,
                        DataUrl = media.DataUrl,
                        MimeType = media.MimeType,
                        PosterDataUrl = media is VideoElement legacyVideo ? legacyVideo.PosterDataUrl : string.Empty,
                        DurationSeconds = media.DurationSeconds,
                        TrimStartSeconds = media.TrimStartSeconds,
                        TrimEndSeconds = media.EffectiveTrimEndSeconds,
                        WaveformSamples = [.. media.WaveformSamples]
                    }];
            }
            _segments.AddRange(TimelineEdits.Normalize(sourceSegments, IsVideo));
            if (media is VideoElement video)
            {
                _videoFitMode = video.FitModeExplicit || video.FitMode != PublicationVideoFitMode.Contain
                    ? video.FitMode
                    : PublicationVideoFitMode.Stretch;
                var legacyRegion = CloneFramePoints(video.FrameClipPolygon);
                var firstVideoLayer = _segments.FirstOrDefault()?.VideoLayers.FirstOrDefault();
                if (legacyRegion.Count >= 3 && firstVideoLayer is not null && firstVideoLayer.Region.IsFullFrame)
                {
                    firstVideoLayer.Region.Name = "Legacy frame region";
                    firstVideoLayer.Region.Points = legacyRegion;
                }
            }
        }
        else
        {
            _volume = 1;
            _playbackRate = 1;
            _fadeIn = _fadeOut = 0;
            _muted = _loop = false;
            _autoPlay = true;
            _playbackTrigger = PublicationMediaPlaybackTrigger.OnPageEnter;
        }

        if (InitialInsertedSegment is { } inserted)
        {
            var normalizedInsert = TimelineEdits.Normalize([inserted], IsVideo).FirstOrDefault();
            if (normalizedInsert is not null)
            {
                normalizedInsert.Id = Guid.NewGuid();
                _segments.Add(normalizedInsert);
                _warning = $"Added {normalizedInsert.Name} to the {(IsVideo ? "video" : "audio")} sequence.";
            }
        }

        if (_segments.Count > 0)
        {
            var initial = _segments.FirstOrDefault(IsPlayableSegment)
                ?? _segments.FirstOrDefault(segment => !segment.IsGap)
                ?? _segments[0];
            SelectSegment(initial.Id, seek: false);
        }
        else ClearSelectedSegmentFields();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Visible || _disposed || SessionId == Guid.Empty) return;
        try
        {
            var module = await EnsureMediaModuleAsync();
            if (IsVideo && HasSource) await SyncVideoEffectsAsync(module);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (JSException ex)
        {
            _error = $"Media Studio could not initialize: {ex.Message}";
            try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { }
        }
    }

    private async Task<IJSObjectReference> EnsureMediaModuleAsync()
    {
        if (_disposed) throw new ObjectDisposedException(nameof(MediaStudio));
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/mediaStudioInterop.js");
        _self ??= DotNetObjectReference.Create(this);
        if (SessionId != Guid.Empty && SessionId != _initializedSession)
        {
            await _module.InvokeVoidAsync(
                "initializeMediaStudio",
                "media-studio-preview",
                _self,
                SessionId.ToString("N"),
                "media-studio-window",
                IsVideo ? "media-studio-frame-stage" : string.Empty,
                IsVideo ? "media-studio-frame-overlay-host" : string.Empty,
                IsVideo ? "media-studio-video-time-overlay" : string.Empty,
                "media-studio-file-input",
                "media-studio-insert-file-input",
                IsVideo ? "media-studio-project-input" : string.Empty,
                IsVideo ? "video" : "audio");
            _initializedSession = SessionId;
        }
        return _module;
    }

    private async Task SyncVideoEffectsAsync(IJSObjectReference? module = null)
    {
        if (!IsVideo || !HasSource || SelectedSegment is null || !IsPlayableSegment(SelectedSegment)) return;
        module ??= await EnsureMediaModuleAsync();
        await module.InvokeVoidAsync("configureVideoEffects", "media-studio-preview", "media-studio-video-effects", new
        {
            fitMode = _videoFitMode switch
            {
                PublicationVideoFitMode.Cover => "cover",
                PublicationVideoFitMode.Stretch => "stretch",
                _ => "contain"
            },
            forceCanvas = true,
            layers = VideoLayerPayload(SelectedSegment.VideoLayers)
        });
    }

    private object[] VideoLayerPayload(IEnumerable<VideoEffectLayer> layers) => layers
        .Where(layer => layer is not null)
        .Select(layer =>
        {
            var sourceRegion = layer.Region ?? new VideoFrameRegion();
            var morphRegion = layer.MorphRegion ?? new VideoFrameRegion { Name = "Morph target" };
            IReadOnlyList<MediaFramePoint> sourcePoints = sourceRegion.Points;
            IReadOnlyList<MediaFramePoint> morphPoints = morphRegion.Points;
            if (layer.Id == _selectedVideoLayerId && _frameRegionEditing)
            {
                if (_editingMorphRegion) morphPoints = ActiveFramePoints;
                else sourcePoints = ActiveFramePoints;
            }
            return (object)new
            {
                id = layer.Id.ToString("D"),
                layer.Name,
                layer.Visible,
                kind = layer.Kind.ToString(),
                layer.Opacity,
                blendMode = layer.BlendMode.ToString(),
                layer.HasTemporalRange,
                layer.TemporalStartSeconds,
                layer.TemporalEndSeconds,
                layer.MorphEnabled,
                layer.AnimateMorph,
                layer.MorphAmount,
                layer.AnimationSpeed,
                layer.Depth,
                layer.Roundness,
                htmlExportSupport = layer.HtmlExportSupport.ToString(),
                region = new
                {
                    sourceRegion.Inverted,
                    points = sourcePoints.Select(point => new { point.X, point.Y }).ToArray()
                },
                morphRegion = new
                {
                    morphRegion.Inverted,
                    points = morphPoints.Select(point => new { point.X, point.Y }).ToArray()
                },
                filters = (layer.Filters ?? []).Select(filter => new
                {
                    id = filter.Id.ToString("D"),
                    kind = filter.Kind.ToString(),
                    filter.Enabled,
                    filter.Amount,
                    filter.SecondaryAmount,
                    filter.TertiaryAmount,
                    filter.ResidualOpacity,
                    filter.Color,
                    htmlExportSupport = filter.HtmlExportSupport.ToString()
                }).ToArray()
            };
        })
        .ToArray();

    private void CommitSelectedSegment(bool refreshVideoEffects = false)
    {
        var segment = SelectedSegment;
        if (segment is null) return;
        CommitFrameRegionToSelectedLayer();
        if (segment.IsGap)
        {
            var gapDuration = Math.Max(.01, double.IsFinite(_duration) ? _duration : segment.TimelineDurationSeconds);
            segment.Name = "Gap";
            segment.DataUrl = string.Empty;
            segment.MimeType = string.Empty;
            segment.DurationSeconds = gapDuration;
            segment.TrimStartSeconds = 0;
            segment.TrimEndSeconds = gapDuration;
            segment.TimelineDurationSeconds = gapDuration;
            segment.HasTemporalSelection = false;
            segment.TemporalSelectionCommitted = false;
            segment.VideoLayers.Clear();
            return;
        }
        segment.Name = string.IsNullOrWhiteSpace(_name) ? (IsVideo ? "Video clip" : "Audio clip") : _name.Trim();
        segment.DataUrl = NormalizeMediaDataUrl(_dataUrl, IsVideo ? "video/webm" : "audio/webm");
        segment.MimeType = NormalizeMimeType(_mimeType, IsVideo ? "video/webm" : "audio/webm");
        segment.PosterDataUrl = _posterDataUrl;
        segment.DurationSeconds = Math.Max(.01, double.IsFinite(_duration) ? _duration : 0);
        var trim = NormalizeTrimRange(_trimStart, _trimEnd, segment.DurationSeconds);
        segment.TrimStartSeconds = trim.Start;
        segment.TrimEndSeconds = trim.End;
        segment.HasTemporalSelection = IsVideo;
        segment.TemporalSelectionCommitted = IsVideo && _videoSelectionUserCommitted;
        segment.TemporalSelectionIsPoint = _videoSelectionIsPoint;
        segment.TemporalSelectionStartSeconds = VideoSelectionStart;
        segment.TemporalSelectionEndSeconds = VideoSelectionEnd;
        if (IsVideo)
            segment.VideoLayers = TimelineEdits.NormalizeVideoLayers(segment.VideoLayers, segment.TrimStartSeconds, segment.EffectiveTrimEndSeconds, segment.Name);
        segment.WaveformSamples = [.. _waveform];
        if (refreshVideoEffects) QueueVideoEffectsRefresh();
    }

    private void SelectSegment(Guid id, bool seek = true, bool forceReload = false)
    {
        var reloadingCurrent = _selectedSegmentId == id && SelectedSegment is not null;
        if (reloadingCurrent && !forceReload)
        {
            if (seek) _ = SeekSelectedAtPlayheadAsync();
            return;
        }
        if (_pendingInsertSegment is not null) ClearPendingInsert();
        if (!reloadingCurrent) CommitSelectedSegment();
        var segment = _segments.FirstOrDefault(item => item.Id == id);
        if (segment is null) return;
        _selectedSegmentId = segment.Id;
        _name = segment.Name;
        _dataUrl = segment.DataUrl;
        _mimeType = segment.MimeType;
        _posterDataUrl = segment.PosterDataUrl;
        _duration = Math.Max(.01, segment.DurationSeconds);
        _trimStart = segment.TrimStartSeconds;
        _trimEnd = segment.EffectiveTrimEndSeconds;
        var hasSelection = IsVideo && segment.HasTemporalSelection;
        _videoSelectionUserCommitted = hasSelection && (segment.TemporalSelectionCommitted || SegmentHasExplicitTemporalSelection(segment));
        _videoSelectionIsPoint = hasSelection && segment.TemporalSelectionIsPoint;
        _videoSelectionPointSeconds = hasSelection ? segment.TemporalSelectionStartSeconds : _trimStart;
        _videoSelectionStartSeconds = hasSelection ? segment.TemporalSelectionStartSeconds : _trimStart;
        _videoSelectionEndSeconds = hasSelection ? segment.TemporalSelectionEndSeconds : _trimEnd;
        _waveform = [.. segment.WaveformSamples];
        ApplyTrimRange(_trimStart, _trimEnd, commit: false);
        SetVideoSelectionRange(_videoSelectionStartSeconds, _videoSelectionEndSeconds, _videoSelectionIsPoint);
        _selectedCutSectionId = null;
        SelectInitialVideoLayer(segment);
        RefreshPreviewSource();
        if (seek) _ = SeekSelectedAtPlayheadAsync();
    }

    private void ClearSelectedSegmentFields()
    {
        _selectedSegmentId = null;
        _name = IsVideo ? "Untitled Video" : "Untitled Audio";
        _dataUrl = string.Empty;
        _mimeType = string.Empty;
        _posterDataUrl = string.Empty;
        _duration = _trimStart = _trimEnd = 0;
        _videoSelectionIsPoint = false;
        _videoSelectionPointSeconds = 0;
        _videoSelectionStartSeconds = 0;
        _videoSelectionEndSeconds = 0;
        _videoSelectionUserCommitted = false;
        _selectedVideoLayerId = null;
        _selectedVideoFilterId = null;
        _selectedCutSectionId = null;
        _frameClipPolygon.Clear();
        _morphClipPolygon.Clear();
        _frameDraft.Clear();
        _editingMorphRegion = false;
        _selectedFramePointIndex = null;
        ClearPendingInsert();
        _waveform = [];
        RefreshPreviewSource();
    }

    private PublicationMediaSegment CurrentFieldsAsSegment()
    {
        var segment = new PublicationMediaSegment
        {
            Name = _name,
            DataUrl = _dataUrl,
            MimeType = _mimeType,
            PosterDataUrl = _posterDataUrl,
            DurationSeconds = _duration,
            TrimStartSeconds = _trimStart,
            TrimEndSeconds = _trimEnd,
            HasTemporalSelection = IsVideo,
            TemporalSelectionCommitted = IsVideo && _videoSelectionUserCommitted,
            TemporalSelectionIsPoint = _videoSelectionIsPoint,
            TemporalSelectionStartSeconds = VideoSelectionStart,
            TemporalSelectionEndSeconds = VideoSelectionEnd,
            CutSections = SelectedSegment?.CutSections.Select(CloneTemporalSection).ToList() ?? [],
            VideoLayers = IsVideo
                ? (SelectedSegment?.VideoLayers.Select(TimelineEdits.CloneVideoLayer).ToList() ?? [TimelineEdits.CreateDefaultVideoLayer(_name)])
                : [],
            WaveformSamples = [.. _waveform]
        };
        return TimelineEdits.Normalize([segment], IsVideo).First();
    }

    private void ReplaceOrAddCurrentSegment()
    {
        var next = CurrentFieldsAsSegment();
        var index = SelectedSegmentIndex;
        if (index >= 0)
        {
            next.Id = _segments[index].Id;
            _segments[index] = next;
        }
        else
        {
            _segments.Add(next);
        }
        SelectSegment(next.Id, seek: false);
        _playhead = Math.Clamp(_playhead, 0, SequenceDuration);
    }

    private static double Distance(MediaFramePoint first, MediaFramePoint second)
    {
        var x = first.X - second.X;
        var y = first.Y - second.Y;
        return Math.Sqrt(x * x + y * y);
    }

    private static List<MediaFramePoint> CloneFramePoints(IEnumerable<MediaFramePoint>? points) =>
        (points ?? []).Select(point => new MediaFramePoint
        {
            X = Math.Clamp(point.X, 0, 1),
            Y = Math.Clamp(point.Y, 0, 1)
        }).ToList();

    private static string FrameClipCss(IReadOnlyList<MediaFramePoint> points) =>
        $"polygon({string.Join(',', points.Select(point => $"{point.X * 100:0.###}% {point.Y * 100:0.###}%"))})";

    private static string Percent(double value) => $"{Math.Clamp(value, 0, 1) * 100:0.###}%";

    private string SegmentStyle(PublicationMediaSegment segment)
    {
        var duration = Math.Max(.01, SequenceDuration);
        var segmentDuration = segment.TimelineDurationSeconds > 0
            ? segment.TimelineDurationSeconds
            : segment.SourceLengthSeconds / Math.Max(.1, Math.Abs(segment.Speed) * _playbackRate);
        return $"width:{Percent(segmentDuration / duration)}";
    }

    private string SegmentTitle(PublicationMediaSegment segment)
    {
        var length = segment.TimelineDurationSeconds > 0
            ? segment.TimelineDurationSeconds
            : segment.SourceLengthSeconds / Math.Max(.1, Math.Abs(segment.Speed) * _playbackRate);
        if (segment.IsGap) return $"Gap · {Time(length)}";
        if (!IsPlayableSegment(segment))
        {
            var reference = string.IsNullOrWhiteSpace(segment.SourceReference.OriginalPath)
                ? segment.SourceReference.Uri
                : segment.SourceReference.OriginalPath;
            return $"{segment.Name} · missing media · {Time(length)} · {reference}";
        }
        return $"{segment.Name} · {Time(length)}";
    }

    private static bool IsPlayableSegment(PublicationMediaSegment segment) =>
        !segment.IsGap && !string.IsNullOrWhiteSpace(segment.DataUrl);

    private string MouseModeText(MediaStudioMouseMode mode, string label) => _mouseMode == mode ? $"✓ {label}" : label;
    private void SelectSectionMode() => SetMouseMode(MediaStudioMouseMode.SelectSection);
    private void PlacePlayheadMode() => SetMouseMode(MediaStudioMouseMode.PlacePlayhead);
    private void AddCutLineMode() => SetMouseMode(MediaStudioMouseMode.AddCutLine);
    private void FrameRegionMode() => BeginFrameRegion();
    private void ChangeVideoCanvasMouseMode(ChangeEventArgs args)
    {
        if (!Enum.TryParse<MediaStudioMouseMode>(Text(args), out var mode)) return;
        if (mode == MediaStudioMouseMode.FrameRegion) BeginFrameRegion();
        else SetMouseMode(mode);
    }
    private void SetMouseMode(MediaStudioMouseMode mode)
    {
        if (!IsVideo && mode == MediaStudioMouseMode.FrameRegion) mode = MediaStudioMouseMode.SelectSection;
        if (_frameRegionEditing && mode != MediaStudioMouseMode.FrameRegion) _frameDraft.Clear();
        _frameRegionEditing = mode == MediaStudioMouseMode.FrameRegion && _frameRegionEditing;
        _mouseMode = mode;
    }

    private async Task TimelinePointerDown(PointerEventArgs args)
    {
        if (args.Button != 0 || !HasSource) return;
        var module = await EnsureMediaModuleAsync();
        var ratio = await module.InvokeAsync<double>("horizontalRatio", "media-studio-sequence-timeline", args.ClientX);
        await ActivateTimelinePosition(ratio, allowCut: true);
    }

    private async Task ShowTimelineContextMenu(MouseEventArgs args)
    {
        if (HasSource)
        {
            var module = await EnsureMediaModuleAsync();
            var ratio = await module.InvokeAsync<double>("horizontalRatio", "media-studio-sequence-timeline", args.ClientX);
            await ActivateTimelinePosition(ratio, allowCut: false);
        }
        await _mediaContextMenu.ShowAsync(args);
    }

    private async Task ActivateTimelinePosition(double ratio, bool allowCut)
    {
        CommitSelectedSegment();
        if (_segments.Count == 0) return;
        _playhead = Math.Clamp(ratio, 0, 1) * SequenceDuration;
        var index = TimelineEdits.SegmentIndexAt(_segments, _playbackRate, _playhead);
        if (index >= 0) SelectSegment(_segments[index].Id, seek: false);
        if (allowCut && _mouseMode == MediaStudioMouseMode.AddCutLine)
        {
            var rightId = TimelineEdits.SplitAt(_segments, _playbackRate, _playhead);
            if (rightId is Guid id) SelectSegment(id, seek: false);
        }
        await SeekSelectedAtPlayheadAsync();
    }

    private async Task SeekSelectedAtPlayheadAsync()
    {
        if (_module is null || _segments.Count == 0 || SelectedSegmentIndex < 0) return;
        try
        {
            var sourcePosition = TimelineEdits.SourcePositionAt(_segments, SelectedSegmentIndex, _playbackRate, _playhead);
            await _module.InvokeVoidAsync("seekMedia", "media-studio-preview", sourcePosition);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (JSException) { }
    }

    private void AddCutLineAtPlayhead()
    {
        CommitSelectedSegment();
        var rightId = TimelineEdits.SplitAt(_segments, _playbackRate, _playhead);
        if (rightId is Guid id) SelectSegment(id, seek: false);
    }

    private void RemoveCutLine()
    {
        CommitSelectedSegment();
        var index = SelectedSegmentIndex;
        if (!TimelineEdits.MergeBoundary(_segments, index)) return;
        SelectSegment(_segments[index - 1].Id, seek: false);
        _playhead = Math.Clamp(_playhead, 0, SequenceDuration);
    }

    private void CopySelectedSection()
    {
        CommitSelectedSegment();
        if (SelectedSegment is { } segment) _clipClipboard = TimelineEdits.Clone(segment);
    }

    private void CopyVideoSelection()
    {
        if (!CanCopyVideoSelection || SelectedSegment is not { } segment) return;
        CommitSelectedSegment();
        var copy = TimelineEdits.Clone(segment);
        copy.TrimStartSeconds = VideoSelectionStart;
        copy.TrimEndSeconds = VideoSelectionEnd;
        copy.Name = $"{segment.Name} (selection)";
        _clipClipboard = copy;
        _warning = $"Copied {Time(copy.SourceLengthSeconds)} from {segment.Name}. Paste inserts it after the selected sequence clip.";
    }

    private void UseVideoSelectionAsTrim()
    {
        if (!CanUseVideoSelectionAsTrim) return;
        var start = VideoSelectionStart;
        var end = VideoSelectionEnd;
        ApplyTrimRange(start, end);
        SetVideoSelectionRange(_trimStart, _trimEnd, pointSelection: false);
        _videoSelectionUserCommitted = true;
        CommitSelectedSegment();
        _playhead = SourcePositionToTimeline(_trimStart);
        _warning = $"Trimmed {SelectedClipName} to {Time(_trimStart)} — {Time(_trimEnd)}.";
    }

    private void CutVideoSelection()
    {
        if (!CanCutVideoSelection) return;
        CommitSelectedSegment();
        var start = VideoSelectionStart;
        var end = VideoSelectionEnd;
        var startTimeline = SourcePositionToTimeline(start);

        if (_videoSelectionIsPoint)
        {
            var rightId = TimelineEdits.SplitAt(_segments, _playbackRate, startTimeline);
            if (rightId is Guid id) SelectSegment(id, seek: false);
            _playhead = Math.Clamp(startTimeline, 0, SequenceDuration);
            _warning = $"Added a cutline at {Time(startTimeline)} in the project sequence.";
            return;
        }

        var endTimeline = SourcePositionToTimeline(end);
        TimelineEdits.SplitAt(_segments, _playbackRate, endTimeline);
        TimelineEdits.SplitAt(_segments, _playbackRate, startTimeline);
        var middleTimeline = startTimeline + Math.Max(.001, endTimeline - startTimeline) / 2;
        var middleIndex = TimelineEdits.SegmentIndexAt(_segments, _playbackRate, middleTimeline);
        if (middleIndex >= 0) SelectSegment(_segments[middleIndex].Id, seek: false);
        _playhead = Math.Clamp(startTimeline, 0, SequenceDuration);
        _warning = $"Created clip boundaries around {Time(startTimeline)} — {Time(endTimeline)} and selected the middle clip.";
    }

    private void PasteSection()
    {
        if (_clipClipboard is null) return;
        CommitSelectedSegment();
        var clone = TimelineEdits.Duplicate(_clipClipboard);
        var index = SelectedSegmentIndex;
        _segments.Insert(index >= 0 ? index + 1 : _segments.Count, clone);
        SelectSegment(clone.Id, seek: false);
        _playhead = TimelineEdits.SegmentTimelineStart(_segments, _segments.IndexOf(clone), _playbackRate);
    }

    private void DeleteSelectedSection()
    {
        if (!CanDeleteSection) return;
        CommitSelectedSegment();
        var index = SelectedSegmentIndex;
        _segments.RemoveAt(index);
        if (_segments.Count == 0)
        {
            ClearSelectedSegmentFields();
            _selectedSegmentId = null;
            _playhead = 0;
            return;
        }

        var nextIndex = Math.Clamp(index, 0, _segments.Count - 1);
        SelectSegment(_segments[nextIndex].Id, seek: false);
        _playhead = TimelineEdits.SegmentTimelineStart(_segments, nextIndex, _playbackRate);
    }

    private async Task OpenInsertMediaPicker()
    {
        try
        {
            _pendingDropSourceSeconds = null;
            _pendingDropIsPoint = _videoSelectionIsPoint;
            var module = await EnsureMediaModuleAsync();
            await module.InvokeVoidAsync("clickElement", "media-studio-insert-file-input");
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or JSException)
        {
            _error = $"The insert picker could not be opened: {ex.Message}";
        }
    }

    [JSInvokable]
    public Task VideoTimeSelectionCommitted(double startSeconds, double endSeconds, bool pointSelection, double sourceDurationSeconds)
    {
        if (!IsVideo || !HasSource) return Task.CompletedTask;
        if (_pendingInsertSegment is not null) ClearPendingInsert();
        ReconcileVideoDuration(sourceDurationSeconds, preserveCurrentSelection: true);
        SetVideoSelectionRange(startSeconds, endSeconds, pointSelection);
        _videoSelectionUserCommitted = true;
        CommitSelectedSegment();
        if (_autoCreateSelectionLayers && !pointSelection) CreateOrReuseSelectionLayer(forceNew: false, announce: false);
        _playhead = SourcePositionToTimeline(VideoSelectionStart);
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task VideoSourceDurationResolved(double durationSeconds)
    {
        if (!IsVideo || SelectedSegment is null) return;
        var placeholderDuration = _duration <= .05 || SelectedSegment.DurationSeconds <= .05;
        if (!ReconcileVideoDuration(durationSeconds, preserveCurrentSelection: false)) return;
        CommitSelectedSegment();
        _warning = placeholderDuration
            ? $"Recovered the browser video duration ({Time(durationSeconds)}) without replacing the committed selection."
            : $"Updated the selected clip duration to {Time(durationSeconds)} from browser metadata.";
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task VideoPlayheadCommitted(double sourceSeconds)
    {
        if (!IsVideo || !HasSource) return;
        var source = Math.Clamp(double.IsFinite(sourceSeconds) ? sourceSeconds : _trimStart, _trimStart, _trimEnd);
        _playhead = SourcePositionToTimeline(source);
        var module = await EnsureMediaModuleAsync();
        await module.InvokeVoidAsync("seekMedia", "media-studio-preview", source);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task VideoCutlineCommitted(double sourceSeconds)
    {
        if (!IsVideo || !HasSource) return;
        var source = Math.Clamp(double.IsFinite(sourceSeconds) ? sourceSeconds : _trimStart, _trimStart, _trimEnd);
        _playhead = SourcePositionToTimeline(source);
        AddCutLineAtPlayhead();
        await SeekSelectedAtPlayheadAsync();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task MediaStudioDropInsertionPointSelected(double sourceSeconds, bool pointSelection)
    {
        if (!IsVideo || !HasSource) return Task.CompletedTask;
        var minimum = pointSelection ? sourceSeconds : VideoSelectionStart;
        var maximum = pointSelection ? sourceSeconds : VideoSelectionEnd;
        if (maximum < minimum) (minimum, maximum) = (maximum, minimum);
        _pendingDropSourceSeconds = Math.Clamp(
            double.IsFinite(sourceSeconds) ? sourceSeconds : minimum,
            Math.Max(0, minimum),
            Math.Max(Math.Max(0, minimum), maximum));
        _pendingDropIsPoint = pointSelection;
        return Task.CompletedTask;
    }

    private double SourcePositionToTimeline(double sourceSeconds)
    {
        var index = SelectedSegmentIndex;
        if (index < 0 || index >= _segments.Count) return Math.Clamp(_playhead, 0, SequenceDuration);
        var segment = _segments[index];
        var source = Math.Clamp(
            double.IsFinite(sourceSeconds) ? sourceSeconds : segment.TrimStartSeconds,
            segment.TrimStartSeconds,
            segment.EffectiveTrimEndSeconds);
        return TimelineEdits.SegmentTimelineStart(_segments, index, _playbackRate)
            + (source - segment.TrimStartSeconds) / (Math.Max(.1, _playbackRate) * Math.Max(.0001, Math.Abs(segment.Speed)));
    }

    private void PreparePendingInsert(PublicationMediaSegment segment)
    {
        var pointSelection = _pendingDropSourceSeconds.HasValue ? _pendingDropIsPoint : _videoSelectionIsPoint;
        var minimum = pointSelection ? (_pendingDropSourceSeconds ?? _videoSelectionPointSeconds) : _trimStart;
        if (!pointSelection) minimum = VideoSelectionStart;
        var maximum = pointSelection ? minimum : VideoSelectionEnd;
        if (maximum < minimum) (minimum, maximum) = (maximum, minimum);
        minimum = Math.Clamp(minimum, 0, Math.Max(.01, _duration));
        maximum = Math.Clamp(maximum, minimum, Math.Max(minimum, _duration));

        _pendingInsertSegment = segment;
        _pendingInsertMinimumSourceSeconds = minimum;
        _pendingInsertMaximumSourceSeconds = maximum;
        var suggested = _pendingDropSourceSeconds ?? (pointSelection ? minimum : minimum + (maximum - minimum) / 2);
        _pendingInsertSourceSeconds = Math.Clamp(suggested, minimum, maximum);
        _pendingDropSourceSeconds = null;
        _pendingDropIsPoint = false;
        _warning = pointSelection
            ? $"Choose Insert here to place {segment.Name} at {Time(_pendingInsertSourceSeconds)}."
            : $"Choose the exact timestamp inside the selected range for {segment.Name}.";
    }

    private void ChangePendingInsertPosition(ChangeEventArgs args)
    {
        if (!TryDouble(args, out var value)) return;
        _pendingInsertSourceSeconds = Math.Clamp(
            value,
            _pendingInsertMinimumSourceSeconds,
            Math.Max(_pendingInsertMinimumSourceSeconds, _pendingInsertMaximumSourceSeconds));
    }

    private void ConfirmPendingInsert()
    {
        if (_pendingInsertSegment is null) return;
        CommitSelectedSegment();
        var insertionTimeline = SourcePositionToTimeline(_pendingInsertSourceSeconds);
        var inserted = _pendingInsertSegment;
        TimelineEdits.InsertAt(_segments, _playbackRate, insertionTimeline, inserted);
        var insertedIndex = _segments.FindIndex(segment => segment.Id == inserted.Id);
        ClearPendingInsert();
        SelectSegment(inserted.Id, seek: false);
        _playhead = insertedIndex >= 0
            ? TimelineEdits.SegmentTimelineStart(_segments, insertedIndex, _playbackRate)
            : Math.Clamp(insertionTimeline, 0, SequenceDuration);
        _warning = $"Inserted {inserted.Name} at {Time(insertionTimeline)} in the sequence.";
    }

    private void CancelPendingInsert()
    {
        var name = _pendingInsertSegment?.Name;
        ClearPendingInsert();
        if (!string.IsNullOrWhiteSpace(name)) _warning = $"Cancelled insertion of {name}.";
    }

    private void ClearPendingInsert()
    {
        _pendingInsertSegment = null;
        _pendingInsertSourceSeconds = 0;
        _pendingInsertMinimumSourceSeconds = 0;
        _pendingInsertMaximumSourceSeconds = 0;
        _pendingDropSourceSeconds = null;
        _pendingDropIsPoint = false;
    }

    private void BeginFrameRegion() => BeginActiveFrameRegion(editMorph: false);

    private void BeginMorphRegion() => BeginActiveFrameRegion(editMorph: true);

    private void BeginActiveFrameRegion(bool editMorph)
    {
        if (!IsVideo || !HasSource || SelectedVideoLayer is null) return;
        CommitFrameRegionToSelectedLayer();
        LoadFrameRegionFromSelectedLayer();
        _editingMorphRegion = editMorph;
        _frameDraft.Clear();
        _frameDraft.AddRange(CloneFramePoints(StoredActiveFramePoints));
        _selectedFramePointIndex = null;
        _frameRegionEditing = true;
        _mouseMode = MediaStudioMouseMode.FrameRegion;
        var label = editMorph ? "morph target" : "source region";
        _warning = $"Editing the {label} owned by {SelectedVideoLayer.Name}. A grabbed point stays selected until another point or the canvas is selected.";
    }

    private async Task FrameOverlayPointerDown(PointerEventArgs args)
    {
        if (!IsVideo || args.Button != 0 || _mouseMode != MediaStudioMouseMode.FrameRegion) return;
        if (!_frameRegionEditing) BeginActiveFrameRegion(_editingMorphRegion);
        _selectedFramePointIndex = null;
        var module = await EnsureMediaModuleAsync();
        var point = await module.InvokeAsync<MediaFramePoint>(
            "normalizedPoint",
            "media-studio-frame-overlay-host",
            args.ClientX,
            args.ClientY);
        point.X = Math.Clamp(point.X, 0, 1);
        point.Y = Math.Clamp(point.Y, 0, 1);
        if (_frameDraft.Count == 0 || Distance(_frameDraft[^1], point) > .003)
        {
            _frameDraft.Add(point);
            _selectedFramePointIndex = _frameDraft.Count - 1;
        }
    }

    private Task FinishFrameRegion()
    {
        if (!CanFinishFrameRegion) return Task.CompletedTask;
        if (_frameDraft.Count > 3 && Distance(_frameDraft[0], _frameDraft[^1]) < .015)
            _frameDraft.RemoveAt(_frameDraft.Count - 1);
        if (_frameDraft.Count < 3) return Task.CompletedTask;
        var target = StoredActiveFramePoints;
        target.Clear();
        target.AddRange(CloneFramePoints(_frameDraft));
        _selectedFramePointIndex = Math.Clamp(_selectedFramePointIndex ?? target.Count - 1, 0, target.Count - 1);
        _frameDraft.Clear();
        _frameRegionEditing = false;
        _mouseMode = MediaStudioMouseMode.SelectSection;
        CommitFrameRegionToSelectedLayer();
        RefreshSelectedLayerOpenScad(commit: false);
        CommitSelectedSegment(refreshVideoEffects: true);
        _warning = $"Applied the {(_editingMorphRegion ? "morph target" : "source region")} to {SelectedVideoLayer?.Name}.";
        return Task.CompletedTask;
    }

    private void CancelFrameRegion()
    {
        _frameDraft.Clear();
        _frameRegionEditing = false;
        _selectedFramePointIndex = null;
        if (_mouseMode == MediaStudioMouseMode.FrameRegion) _mouseMode = MediaStudioMouseMode.SelectSection;
    }

    private void ClearFrameRegion()
    {
        var label = _editingMorphRegion ? "morph target" : "source region";
        StoredActiveFramePoints.Clear();
        _frameDraft.Clear();
        _frameRegionEditing = false;
        _selectedFramePointIndex = null;
        if (_mouseMode == MediaStudioMouseMode.FrameRegion) _mouseMode = MediaStudioMouseMode.SelectSection;
        CommitFrameRegionToSelectedLayer();
        RefreshSelectedLayerOpenScad(commit: false);
        CommitSelectedSegment(refreshVideoEffects: true);
        _warning = $"Cleared the {label} on {SelectedVideoLayer?.Name}.";
    }

    private void RemoveLastFramePoint()
    {
        if (_frameDraft.Count == 0) return;
        _frameDraft.RemoveAt(_frameDraft.Count - 1);
        _selectedFramePointIndex = _frameDraft.Count == 0 ? null : _frameDraft.Count - 1;
    }

    private void RemoveSelectedFramePoint()
    {
        if (_selectedFramePointIndex is not int index) return;
        var points = _frameRegionEditing ? _frameDraft : StoredActiveFramePoints;
        if (index < 0 || index >= points.Count) return;
        points.RemoveAt(index);
        _selectedFramePointIndex = points.Count == 0 ? null : Math.Min(index, points.Count - 1);
        if (!_frameRegionEditing)
        {
            CommitFrameRegionToSelectedLayer();
            RefreshSelectedLayerOpenScad(commit: false);
            CommitSelectedSegment(refreshVideoEffects: true);
        }
        _warning = $"Removed point {index + 1} from the {(_editingMorphRegion ? "morph target" : "source region")}.";
    }

    private void CopyFrameRegion()
    {
        var points = ActiveFramePoints;
        if (points.Count < 3) return;
        _frameClipboard.Clear();
        _frameClipboard.AddRange(CloneFramePoints(points));
    }

    private void PasteFrameRegion()
    {
        if (!CanPasteFrameRegion || SelectedVideoLayer is null) return;
        var target = _frameRegionEditing ? _frameDraft : StoredActiveFramePoints;
        target.Clear();
        target.AddRange(CloneFramePoints(_frameClipboard));
        _selectedFramePointIndex = target.Count - 1;
        if (!_frameRegionEditing)
        {
            CommitFrameRegionToSelectedLayer();
            RefreshSelectedLayerOpenScad(commit: false);
            CommitSelectedSegment(refreshVideoEffects: true);
        }
    }

    private static MediaTemporalSection CloneTemporalSection(MediaTemporalSection section) => new()
    {
        Id = section.Id == Guid.Empty ? Guid.NewGuid() : section.Id,
        Name = string.IsNullOrWhiteSpace(section.Name) ? "Cut section" : section.Name.Trim(),
        Enabled = section.Enabled,
        StartSeconds = section.StartSeconds,
        EndSeconds = section.EndSeconds
    };

    private string VideoCutSectionStyle(MediaTemporalSection section)
    {
        var visibleStart = Math.Max(0, Math.Min(_duration, _trimStart));
        var visibleEnd = Math.Max(visibleStart + .01, Math.Min(Math.Max(.01, _duration), _trimEnd));
        var visibleSpan = Math.Max(.01, visibleEnd - visibleStart);
        var start = Math.Clamp((section.StartSeconds - visibleStart) / visibleSpan, 0, 1);
        var end = Math.Clamp((section.EndSeconds - visibleStart) / visibleSpan, start, 1);
        return $"left:{Percent(start)};width:{Percent(Math.Max(.001, end - start))}";
    }

    private void SaveSelectedRangeAsCutSection()
    {
        if (!CanSaveCutSection || SelectedSegment is not { } segment) return;
        _videoSelectionUserCommitted = true;
        CommitSelectedSegment();
        segment = SelectedSegment!;
        var section = new MediaTemporalSection
        {
            Name = $"Cut section {segment.CutSections.Count + 1}",
            StartSeconds = VideoSelectionStart,
            EndSeconds = VideoSelectionEnd
        };
        segment.CutSections.Add(section);
        _selectedCutSectionId = section.Id;
        CommitSelectedSegment(refreshVideoEffects: true);
        _warning = $"Saved {section.Name}: {Time(section.StartSeconds)} — {Time(section.EndSeconds)}.";
    }

    private void SelectCutSection(Guid id)
    {
        if (SelectedSegment?.CutSections.Any(section => section.Id == id) != true) return;
        _selectedCutSectionId = id;
    }

    private void UseSelectedCutSection()
    {
        if (SelectedCutSection is not { } section) return;
        SetVideoSelectionRange(section.StartSeconds, section.EndSeconds, pointSelection: false);
        _videoSelectionUserCommitted = true;
        CommitSelectedSegment(refreshVideoEffects: true);
        _playhead = SourcePositionToTimeline(VideoSelectionStart);
        _ = SeekVideoSelectionStartAsync();
        _warning = $"Loaded {section.Name} into the current selection.";
    }

    private void RemoveSelectedCutSection()
    {
        if (SelectedSegment is not { } segment || _selectedCutSectionId is not Guid id) return;
        var index = segment.CutSections.FindIndex(section => section.Id == id);
        if (index < 0) return;
        var removed = segment.CutSections[index].Name;
        segment.CutSections.RemoveAt(index);
        _selectedCutSectionId = segment.CutSections.Count == 0
            ? null
            : segment.CutSections[Math.Clamp(index, 0, segment.CutSections.Count - 1)].Id;
        CommitSelectedSegment(refreshVideoEffects: true);
        _warning = $"Removed {removed}. The current selection was not changed.";
    }

    private void SelectInitialVideoLayer(PublicationMediaSegment segment)
    {
        if (!IsVideo)
        {
            _selectedVideoLayerId = null;
            _selectedVideoFilterId = null;
            _frameClipPolygon.Clear();
            _frameDraft.Clear();
            return;
        }

        segment.VideoLayers = TimelineEdits.NormalizeVideoLayers(
            segment.VideoLayers,
            segment.TrimStartSeconds,
            segment.EffectiveTrimEndSeconds,
            segment.Name);
        var selected = segment.VideoLayers.FirstOrDefault(layer => layer.Id == _selectedVideoLayerId)
            ?? segment.VideoLayers.FirstOrDefault();
        _selectedVideoLayerId = selected?.Id;
        _selectedVideoFilterId = selected?.Filters.FirstOrDefault(filter => filter.Id == _selectedVideoFilterId)?.Id
            ?? selected?.Filters.FirstOrDefault()?.Id;
        LoadFrameRegionFromSelectedLayer();
    }

    private void LoadFrameRegionFromSelectedLayer()
    {
        _frameClipPolygon.Clear();
        _morphClipPolygon.Clear();
        _frameDraft.Clear();
        _frameRegionEditing = false;
        _selectedFramePointIndex = null;
        if (SelectedVideoLayer?.Region?.Points is { } points)
            _frameClipPolygon.AddRange(CloneFramePoints(points));
        if (SelectedVideoLayer?.MorphRegion?.Points is { } morphPoints)
            _morphClipPolygon.AddRange(CloneFramePoints(morphPoints));
    }

    private void CommitFrameRegionToSelectedLayer()
    {
        if (!IsVideo || SelectedVideoLayer is not { } layer) return;
        layer.Region ??= new VideoFrameRegion();
        layer.Region.Points = CloneFramePoints(_frameClipPolygon);
        layer.MorphRegion ??= new VideoFrameRegion { Name = "Morph target" };
        layer.MorphRegion.Points = CloneFramePoints(_morphClipPolygon);
        layer.MorphEnabled = layer.MorphEnabled && layer.MorphRegion.Points.Count >= 3;
    }

