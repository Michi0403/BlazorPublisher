    [JSInvokable]
    public async Task VideoTimeSelectionCommitted(double startSeconds, double endSeconds, bool pointSelection)
    {
        if (!IsVideo || !HasSource) return;
        if (_pendingInsertSegment is not null) ClearPendingInsert();
        SetVideoSelectionRange(startSeconds, endSeconds, pointSelection);
        _playhead = SourcePositionToTimeline(VideoSelectionStart);
        var module = await EnsureMediaModuleAsync();
        await module.InvokeVoidAsync("seekMedia", "media-studio-preview", VideoSelectionStart);
        await InvokeAsync(StateHasChanged);
