    private void ChangeNavigation(ChangeEventArgs args) { if (_draft is not null && Enum.TryParse<PublicationPanelNavigationMode>(Text(args), out var mode)) _draft.NavigationMode = mode; }
    private void ChangeLayoutMode(ChangeEventArgs args) { if (_draft is not null && Enum.TryParse<PublicationPanelLayoutMode>(Text(args), out var mode)) _draft.LayoutMode = mode; }
