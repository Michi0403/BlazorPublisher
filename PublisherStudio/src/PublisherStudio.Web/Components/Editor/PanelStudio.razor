    private void ChangeVisualDataObject(ChangeEventArgs args) { if (SelectedElement is DataVisualElement visual && Guid.TryParse(Text(args), out var id)) visual.DataObjectId = id; }
    private void ChangeVisualValueFields(ChangeEventArgs args) { if (SelectedElement is DataVisualElement visual) visual.ValueFields = Text(args).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(); }
    private void ChangeComponentKind(ChangeEventArgs args) { if (SelectedElement is DevExtremeComponentElement component && Enum.TryParse<PublicationComponentKind>(Text(args), out var kind)) { component.ComponentKind = kind; Components.Normalize(Document, component); } }
    private void ChangeComponentDataMode(ChangeEventArgs args) { if (SelectedElement is DevExtremeComponentElement component && Enum.TryParse<PublicationComponentDataMode>(Text(args), out var mode)) component.Connection.Mode = mode; }
    private void ChangeComponentDataObject(ChangeEventArgs args) { if (SelectedElement is DevExtremeComponentElement component && Guid.TryParse(Text(args), out var id)) component.Connection.DataObjectId = id; }
    private void ChangeChatDisplayMode(ChangeEventArgs args) { if (SelectedElement is DevExtremeComponentElement component && Enum.TryParse<PublicationChatDisplayMode>(Text(args), out var mode)) component.ChatDisplayMode = mode; }
    private void ChangeLiveSourceKind(ChangeEventArgs args) { if (SelectedElement is LiveSourceElement live && Enum.TryParse<PublicationLiveSourceKind>(Text(args), out var kind)) live.SourceKind = kind; }
    private void ToggleViewEnabled(ChangeEventArgs args) { if (CurrentView is not null) CurrentView.Enabled = AsBool(args); }

    private static bool AsBool(ChangeEventArgs args) => args.Value is bool value ? value : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
    private static string Text(ChangeEventArgs args) => args.Value?.ToString() ?? string.Empty;
    private static string Inv(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static void ChangeNumber(ChangeEventArgs args, Action<double> update) { if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value)) update(value); }
    private static void ChangeInt(ChangeEventArgs args, Action<int> update) { if (int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var value)) update(value); }

    private async Task Save()
    {
        if (_draft is null) return;
        Panels.Normalize(Document, _draft);
        await Saved.InvokeAsync(_draft);
    }

    private Task Cancel() => Cancelled.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("publisherStudio.unbindPanelStudioDropSurface", _canvasElement); } catch { }
        _dropSurfaceBound = false;
        _self?.Dispose();
        _self = null;
    }

