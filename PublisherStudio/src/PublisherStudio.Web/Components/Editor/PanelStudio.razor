    private void AddTool(string toolId)
    {
        var element = CreateToolElement(toolId);
        if (element is null || _draft is null) return;
        element.X = Math.Max(0, (_draft.CanvasWidth - element.Width) / 2);
        element.Y = Math.Max(0, (_draft.CanvasHeight - element.Height) / 2);
        AddElement(element);
    }

    private PublicationElement? CreateToolElement(string toolId)
    {
        if (toolId.StartsWith("template:", StringComparison.OrdinalIgnoreCase)
            && Guid.TryParse(toolId["template:".Length..], out var templateId))
        {
            var template = Document.ComponentTemplates.FirstOrDefault(item => item.Id == templateId);
            if (template is null) return null;
            _selectedTemplateId = template.Id;
            var clone = Files.CloneElement(template.Prototype);
            clone.Id = Guid.NewGuid();
            return clone;
        }
        return Panels.CreateComponentTool(Document, toolId);
    }

    private void BeginPaletteDrag(PanelComponentToolDescriptor tool)
    {
        _dragToolId = tool.Id;
        _dragExistingId = null;
        _dragPrototype = CreateToolElement(tool.Id);
    }

    private void BeginExistingDrag(Guid id)
    {
        SelectElement(id);
        _dragToolId = string.Empty;
        _dragExistingId = id;
        _dragPrototype = SelectedElement is null ? null : Files.CloneElement(SelectedElement);
    }

    private async Task DropDraggedElement(DragEventArgs args)
    {
        if (_draft is null || CurrentView is null || _dragPrototype is null) return;
        var point = await ResolveCanvasPoint(args);
        var pointX = point.X * Math.Max(1, _draft.CanvasWidth);
        var pointY = point.Y * Math.Max(1, _draft.CanvasHeight);
        if (_dragExistingId is { } existingId && CurrentView.Elements.FirstOrDefault(element => element.Id == existingId) is { } existing)
        {
            existing.X = Math.Clamp(pointX - existing.Width / 2, 0, Math.Max(0, _draft.CanvasWidth - existing.Width));
            existing.Y = Math.Clamp(pointY - existing.Height / 2, 0, Math.Max(0, _draft.CanvasHeight - existing.Height));
            SelectElement(existing.Id);
        }
        else
        {
            var element = _dragPrototype;
            element.Id = Guid.NewGuid();
            element.X = Math.Clamp(pointX - element.Width / 2, 0, Math.Max(0, _draft.CanvasWidth - element.Width));
            element.Y = Math.Clamp(pointY - element.Height / 2, 0, Math.Max(0, _draft.CanvasHeight - element.Height));
            AddElement(element);
        }
        EndDrag();
    }

    [JSInvokable]
    public Task CommitPanelElementBounds(string elementId, double x, double y, double width, double height)
    {
        if (_draft is null || CurrentView is null || !Guid.TryParse(elementId, out var id)) return Task.CompletedTask;
        var element = CurrentView.Elements.FirstOrDefault(candidate => candidate.Id == id);
        if (element is null) return Task.CompletedTask;
        var canvasWidth = Math.Max(1, _draft.CanvasWidth);
        var canvasHeight = Math.Max(1, _draft.CanvasHeight);
        element.Width = Math.Clamp(width * canvasWidth, 1, canvasWidth);
        element.Height = Math.Clamp(height * canvasHeight, 1, canvasHeight);
        element.X = Math.Clamp(x * canvasWidth, 0, Math.Max(0, canvasWidth - element.Width));
        element.Y = Math.Clamp(y * canvasHeight, 0, Math.Max(0, canvasHeight - element.Height));
        _selectedElementId = element.Id;
        RefreshAdvancedJson();
        return InvokeAsync(StateHasChanged);
    }

    private async Task<PanelCanvasPoint> ResolveCanvasPoint(DragEventArgs args)
    {
        try
        {
            return await JS.InvokeAsync<PanelCanvasPoint>("publisherStudio.panelStudioPoint", _canvasElement, args.ClientX, args.ClientY);
        }
        catch (JSException)
        {
            var x = Math.Clamp(args.OffsetX / 960d, 0, 1);
            var y = Math.Clamp(args.OffsetY / 540d, 0, 1);
            return new PanelCanvasPoint { X = x, Y = y };
        }
    }

    private void EndDrag()
    {
        _dragToolId = string.Empty;
        _dragExistingId = null;
        _dragPrototype = null;
    }

    private string DragGhostStyle
    {
        get
        {
            if (_draft is null || _dragPrototype is null) return "display:none";
            var width = Math.Clamp(_dragPrototype.Width / Math.Max(1, _draft.CanvasWidth) * 100, 1, 100);
            var height = Math.Clamp(_dragPrototype.Height / Math.Max(1, _draft.CanvasHeight) * 100, 1, 100);
            return $"left:50%;top:50%;width:{Inv(width)}%;height:{Inv(height)}%;transform:translate(-50%,-50%)";
        }
    }

    private string HitStyle(PublicationElement element)
    {
        if (_draft is null) return string.Empty;
        var left = element.X / Math.Max(1, _draft.CanvasWidth) * 100;
        var top = element.Y / Math.Max(1, _draft.CanvasHeight) * 100;
        var width = element.Width / Math.Max(1, _draft.CanvasWidth) * 100;
        var height = element.Height / Math.Max(1, _draft.CanvasHeight) * 100;
        return $"left:{Inv(left)}%;top:{Inv(top)}%;width:{Inv(width)}%;height:{Inv(height)}%;z-index:{element.ZIndex + 10000};transform:rotate({Inv(element.Rotation)}deg)";
    }

    private async Task ImportHtml(InputFileChangeEventArgs args)
    {
        _error = string.Empty;
        try
        {
            var file = args.File;
            await using var source = file.OpenReadStream(long.MaxValue);
            using var reader = new StreamReader(source, Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
            var markup = await reader.ReadToEndAsync();
            AddElement(new HtmlEmbedElement
            {
                Name = Path.GetFileNameWithoutExtension(file.Name), Html = markup,
                Css = "html,body{margin:0;min-height:100%}", JavaScript = string.Empty, AllowScripts = false,
                X = 0, Y = 0, Width = _draft?.CanvasWidth ?? 160, Height = _draft?.CanvasHeight ?? 90
            });
        }
        catch (Exception exception)
        {
            _error = $"HTML import failed: {exception.Message}";
        }
    }

    private async Task ReplaceSelectedMedia(InputFileChangeEventArgs args)
    {
        if (SelectedElement is not { } selected) return;
        _error = string.Empty;
        try
        {
            var file = args.File;
            await using var source = file.OpenReadStream(long.MaxValue);
            using var memory = new MemoryStream();
            await source.CopyToAsync(memory);
            var mime = PublicationMediaData.NormalizeMimeType(file.ContentType, "application/octet-stream");
            var dataUrl = $"data:{mime};base64,{Convert.ToBase64String(memory.ToArray())}";
            switch (selected)
            {
                case ImageFrameElement image:
                    image.DataUrl = dataUrl;
                    image.OriginalDataUrl = dataUrl;
                    image.Name = Path.GetFileNameWithoutExtension(file.Name);
                    break;
                case PublicationMediaElement media:
                    media.DataUrl = dataUrl;
                    media.MimeType = mime;
                    media.Name = Path.GetFileNameWithoutExtension(file.Name);
                    media.DurationSeconds = Math.Max(.01, media.DurationSeconds);
                    media.TrimStartSeconds = 0;
                    media.TrimEndSeconds = media.DurationSeconds;
                    media.Segments = [];
                    break;
            }
            RefreshAdvancedJson();
        }
        catch (Exception exception)
        {
            _error = $"Media import failed: {exception.Message}";
        }
    }

    private void AddElement(PublicationElement element)
    {
        if (CurrentView is null) return;
        element.ZIndex = CurrentView.Elements.Count + 1;
        CurrentView.Elements.Add(element);
        if (_draft is not null) Panels.Normalize(Document, _draft);
        SelectElement(element.Id);
    }

    private void DuplicateElement()
    {
        if (CurrentView is null || SelectedElement is null) return;
        var clone = Files.CloneElement(SelectedElement);
        clone.Id = Guid.NewGuid();
        clone.Name += " copy";
        clone.X += 4;
        clone.Y += 4;
        clone.ZIndex = CurrentView.Elements.Count + 1;
        CurrentView.Elements.Add(clone);
        SelectElement(clone.Id);
    }

    private void DeleteElement()
    {
        if (CurrentView is null || SelectedElement is null) return;
        CurrentView.Elements.Remove(SelectedElement);
        SelectElement(CurrentView.Elements.LastOrDefault()?.Id);
    }

    private void MoveElementUp() => MoveElement(1);
    private void MoveElementDown() => MoveElement(-1);

    private void MoveElement(int delta)
    {
        if (CurrentView is null || SelectedElement is null) return;
        var ordered = CurrentView.Elements.OrderBy(element => element.ZIndex).ToList();
        var index = ordered.IndexOf(SelectedElement);
        var target = Math.Clamp(index + delta, 0, ordered.Count - 1);
        if (target == index) return;
        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);
        for (var i = 0; i < ordered.Count; i++) ordered[i].ZIndex = i + 1;
        CurrentView.Elements = ordered;
    }

    private void SelectTemplate(Guid id)
    {
        var template = Document.ComponentTemplates.FirstOrDefault(item => item.Id == id);
        if (template is null) return;
        _selectedTemplateId = template.Id;
        _templateName = template.Name;
        _templateCategory = template.Category;
        _templateDescription = template.Description;
    }

    private void SaveSelectedAsTemplate()
    {
        if (SelectedElement is null) return;
        var name = string.IsNullOrWhiteSpace(_templateName) ? SelectedElement.Name : _templateName.Trim();
        var template = _selectedTemplateId is { } selectedId
            ? Document.ComponentTemplates.FirstOrDefault(item => item.Id == selectedId)
            : null;
        template ??= new PublicationElementTemplate();
        var isNew = !Document.ComponentTemplates.Contains(template);
        template.Name = name;
        template.Description = _templateDescription.Trim();
        template.Category = string.IsNullOrWhiteSpace(_templateCategory) ? "My modules" : _templateCategory.Trim();
        template.IconCssClass = IconFor(SelectedElement);
        template.Prototype = Files.CloneElement(SelectedElement);
        template.Prototype.Id = Guid.NewGuid();
        template.ModifiedUtc = DateTimeOffset.UtcNow;
        Panels.NormalizeTemplate(Document, template);
        if (isNew) Document.ComponentTemplates.Add(template);
        SelectTemplate(template.Id);
    }

    private void SaveSelectedAsNewTemplate()
    {
        _selectedTemplateId = null;
        SaveSelectedAsTemplate();
    }

    private void DeleteSelectedTemplate()
    {
        if (_selectedTemplateId is not { } id) return;
        Document.ComponentTemplates.RemoveAll(template => template.Id == id);
        _selectedTemplateId = null;
        _templateName = SelectedElement?.Name ?? string.Empty;
        _templateCategory = "My modules";
        _templateDescription = SelectedElement is null ? string.Empty : $"Reusable {SelectedElement.Kind} configured in Panel Studio.";
    }

    private static string IconFor(PublicationElement element) => element switch
    {
        TextFrameElement => "pub-icon pub-icon-text",
        ImageFrameElement => "pub-icon pub-icon-picture",
        VideoElement => "pub-icon pub-icon-video",
        AudioElement => "pub-icon pub-icon-audio",
        DataVisualElement => "pub-icon pub-icon-chart",
        DevExtremeComponentElement component when component.ComponentKind == PublicationComponentKind.Chat => "pub-icon pub-icon-chat",
        DevExtremeComponentElement => "pub-icon pub-icon-data",
        LiveSourceElement => "pub-icon pub-icon-video",
        HtmlEmbedElement => "pub-icon pub-icon-web",
        PanelElement => "pub-icon pub-icon-panel",
        _ => "pub-icon pub-icon-panel"
    };

    private void RefreshAdvancedJson()
    {
        try { _advancedElementJson = SelectedElement is null ? string.Empty : Files.SerializeElement(SelectedElement); }
        catch (Exception exception) { _error = exception.Message; }
    }

    private void ApplyAdvancedJson()
    {
        if (CurrentView is null || SelectedElement is null || string.IsNullOrWhiteSpace(_advancedElementJson)) return;
        try
        {
            var replacement = Files.DeserializeElement(_advancedElementJson);
            replacement.Id = SelectedElement.Id;
            replacement.ZIndex = SelectedElement.ZIndex;
            var index = CurrentView.Elements.IndexOf(SelectedElement);
            CurrentView.Elements[index] = replacement;
            if (_draft is not null) Panels.Normalize(Document, _draft);
            SelectElement(replacement.Id);
            _error = string.Empty;
        }
        catch (Exception exception)
        {
            _error = $"Component configuration could not be applied: {exception.Message}";
        }
    }

