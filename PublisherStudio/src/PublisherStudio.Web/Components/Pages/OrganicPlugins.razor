@page "/organic-plugins"
@rendermode InteractiveServer
@using System.Text.Json
@implements IDisposable
@inject ILocalGptDiscoveryRegistry Discovery
@inject ILocalGptConnectionService Connection
@inject IOrganicCapabilityCatalog CapabilityCatalog
@inject IOrganicPermissionStore PermissionStore
@inject IOrganicWorkCoordinator WorkCoordinator
@inject IOrganicResultStore ResultStore
@inject IRecurringScreenReaderService RecurringScreenReader
@inject IUserNotificationService Notifications
@inject ILogger<OrganicPlugins> Logger
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>LocalGPT Organic Plugins</PageTitle>
<UserNotificationHost />

<main class="organic-plugin-page">
    <header class="organic-plugin-header">
        <div>
            <p class="organic-plugin-kicker">PublisherStudio · LocalGPT</p>
            <h1>Organic plugin control</h1>
            <p>Discover LocalGPT, negotiate capabilities, approve eye/hand actions, and start a role-based Council round.</p>
        </div>
        <button type="button" class="organic-secondary" @onclick="BackToPublisher">Back to Publisher</button>
    </header>

    <section class="organic-status-strip" aria-live="polite">
        <strong>@(Connection.State.IsLinked ? "Connected and linked" : Connection.State.IsConnected ? "Awaiting LocalGPT approval" : "Not connected")</strong>
        <span>@(Connection.State.IsConnected ? Connection.State.DisplayName : "Waiting for UDP discovery on port 51141")</span>
        @if (!string.IsNullOrWhiteSpace(Connection.State.LastError) && !Connection.State.IsConnected)
        {
            <span class="organic-error">@Connection.State.LastError</span>
        }
        else if (Connection.State.IsConnected && !Connection.State.IsLinked)
        {
            <span class="organic-note">Open LocalGPT and approve the pending link in its Human Collaboration Inbox.</span>
        }
        @if (Connection.State.IsConnected)
        {
            <button type="button" class="organic-secondary" disabled="@(!Connection.State.IsLinked)" @onclick="RunRoundTripTestAsync">Test 1-Wire round trip</button>
            @if (Connection.State.IsLinked)
            {
                <button type="button" class="@(_browserAutomationEnabled ? "organic-danger" : "organic-primary")" @onclick="ToggleBrowserAutomationAsync">
                    @(_browserAutomationEnabled ? "Disable browser automation" : "Enable browser automation for this tab")
                </button>
            }
            <button type="button" class="organic-danger" @onclick="DisconnectAsync">Disconnect</button>
        }
        @if (!string.IsNullOrWhiteSpace(_roundTripStatus))
        {
            <span class="organic-note">@_roundTripStatus</span>
        }
    </section>

    <OrganicSecurityPanel />

    <div class="organic-grid organic-grid-two">
        <section class="organic-card">
            <h2>Discovered LocalGPT instances</h2>
            @if (_peers.Count == 0)
            {
                <p class="organic-empty">No LocalGPT broadcast has been received yet. LocalGPT remains available on its normal application port; organic discovery is optional.</p>
            }
            else
            {
                <div class="organic-list">
                    @foreach (var peer in _peers)
                    {
                        <article class="organic-peer" @key="peer.PeerId">
                            <div>
                                <strong>@peer.DisplayName</strong>
                                <span>@peer.HostName · @peer.Address:@peer.ServicePort</span>
                                <small>@peer.ApplicationVersion · seen @peer.SeenUtc.LocalDateTime.ToString("T")</small>
                            </div>
                            <button type="button" disabled="@Connection.State.IsConnected" @onclick="() => ConnectAsync(peer.PeerId)">Connect</button>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="organic-card">
            <h2>Start an AI Council round</h2>
            <label>
                Council team
                <select @bind="_councilRequest.TeamKey" disabled="@(!CanRunCouncil)">
                    @foreach (var team in CouncilTeams)
                    {
                        <option value="@team.Key">@team.Name</option>
                    }
                </select>
            </label>
            <label>
                User assignment
                <textarea rows="7" @bind="_councilRequest.Prompt" @bind:event="oninput" placeholder="Example: Build an OpenSCAD assembly from blocks and forms, or help me inspect this spreadsheet through a sequential eye/hand workflow."></textarea>
            </label>
            <label>
                External project context (JSON)
                <textarea rows="3" @bind="_councilRequest.ExternalProjectContextJson" @bind:event="oninput"></textarea>
            </label>
            <div class="organic-inline-fields">
                <label>Rounds <input type="number" min="1" max="20" @bind="_councilRequest.MaxRounds" /></label>
                <label>Parallel models <input type="number" min="1" max="8" @bind="_councilRequest.MaxParallelModels" /></label>
            </div>
            <button type="button" class="organic-primary" disabled="@(!CanRunCouncil || string.IsNullOrWhiteSpace(_councilRequest.Prompt))" @onclick="SendCouncilAsync">Submit with user authorization</button>
            <p class="organic-note">The request only enters LocalGPT after this explicit frontend action. Any required PublisherStudio eye/hand call is still checked against the permission matrix below.</p>
        </section>
    </div>

    <section class="organic-card" data-testid="publisher-ai-text-generation">
        <h2>Generate a text proposal through LocalGPT</h2>
        <p class="organic-note">This starts the selected LocalGPT Council from PublisherStudio and requires it to return the generated text through <code>publisher.text.insert.propose</code>. The proposal is reviewable and is never inserted automatically.</p>
        <div class="organic-form-grid">
            <label>Target document/component <input @bind="_textGenerationTarget" placeholder="Publication intro, selected text component, article body…" /></label>
            <label>Learning/Council team
                <select @bind="_textGenerationTeamKey">
                    @foreach (var team in CouncilTeams)
                    {
                        <option value="@team.Key">@team.Name</option>
                    }
                </select>
            </label>
            <label class="organic-form-wide">Prompt <textarea rows="5" @bind="_textGenerationPrompt" @bind:event="oninput" placeholder="Write the requested text and return it as a reviewable PublisherStudio insertion proposal."></textarea></label>
        </div>
        <button type="button" class="organic-primary" disabled="@(!CanGenerateTextProposal)" @onclick="GenerateTextProposalAsync">Generate reviewable text proposal</button>
    </section>

    @if (Connection.State.IsConnected)
    {
        <section class="organic-card">
            <h2>Negotiated LocalGPT surface</h2>
            <div class="organic-capability-grid">
                <article class="organic-capability">
                    <strong>Remote capabilities</strong>
                    <p>@string.Join(", ", Connection.State.RemoteCapabilities.Where(item => item.IsEnabled && item.IsOnline).Select(item => item.Key).OrderBy(item => item))</p>
                </article>
                <article class="organic-capability">
                    <strong>Remote skills</strong>
                    <p>@string.Join(", ", Connection.State.RemoteSkills.Where(item => item.IsEnabled && item.IsOnline).Select(item => item.Key).OrderBy(item => item))</p>
                </article>
                <article class="organic-capability">
                    <strong>Hardware roads</strong>
                    <p>@(Connection.State.RemoteHardware.Count == 0 ? "Not advertised" : string.Join(", ", Connection.State.RemoteHardware.Where(item => item.IsOnline).Select(item => item.LaneKey)))</p>
                </article>
            </div>
        </section>
    }

    <section class="organic-card">
        <h2>PublisherStudio organ capabilities</h2>
        <div class="organic-capability-grid">
            @foreach (var capability in _capabilities)
            {
                <article class="organic-capability" @key="capability.Key">
                    <div class="organic-capability-title">
                        <strong>@capability.DisplayName</strong>
                        <span class="organic-badge">@string.Join(" / ", capability.Organs)</span>
                    </div>
                    <p>@capability.Description</p>
                    <small>@capability.Key · @(capability.RequiresHumanConfirmation ? "confirmation required by default" : "read-only/no confirmation")</small>
                </article>
            }
        </div>
    </section>

    <section class="organic-card">
        <h2>Recurring screen-reader help</h2>
        <p class="organic-note">Single-flight scheduling waits for capture and LocalGPT response before the next tick. Intervals are clamped to at least 15 seconds, so requests cannot pile up.</p>
        <div class="organic-form-grid">
            <label>Selector <input @bind="_screenReaderSelector" placeholder="body" /></label>
            <label>Interval seconds <input type="number" min="15" max="3600" @bind="_screenReaderIntervalSeconds" /></label>
            <label class="organic-form-wide">Instruction <textarea rows="3" @bind="_screenReaderPrompt" @bind:event="oninput"></textarea></label>
        </div>
        <button type="button" class="organic-primary" disabled="@(!CanUseScreenReader)" @onclick="StartScreenReaderAsync">Start recurring help</button>
        @if (_screenReaderSessions.Count > 0)
        {
            <div class="organic-list organic-session-list">
                @foreach (var session in _screenReaderSessions)
                {
                    <article class="organic-work" @key="session.Id">
                        <div>
                            <strong>@session.Selector · every @session.IntervalSeconds seconds</strong>
                            <span>@(session.IsActive ? "Active" : "Stopped") · completed @session.CompletedExecutions</span>
                            @if (!string.IsNullOrWhiteSpace(session.LastError)) { <span class="organic-error">@session.LastError</span> }
                            @if (!string.IsNullOrWhiteSpace(session.LastResultJson)) { <details><summary>Latest guidance</summary><pre>@session.LastResultJson</pre></details> }
                        </div>
                        @if (session.IsActive)
                        {
                            <button type="button" class="organic-danger" @onclick="() => StopScreenReaderAsync(session.Id)">Stop</button>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <div class="organic-grid organic-grid-two">
        <section class="organic-card">
            <h2>Permission matrix</h2>
            <div class="organic-form-grid">
                <label>
                    LocalGPT peer
                    <input @bind="_permission.PeerId" placeholder="localgpt:machine" />
                </label>
                <label>
                    Capability
                    <select @bind="_permission.CapabilityKey">
                        <option value="">Select capability</option>
                        @foreach (var capability in _capabilities)
                        {
                            <option value="@capability.Key">@capability.Key</option>
                        }
                    </select>
                </label>
                <label>
                    Organ
                    <select @bind="_permission.Organ">
                        <option value="">All declared organs</option>
                        <option value="eyes">eyes</option>
                        <option value="hands">hands</option>
                        <option value="brain">brain</option>
                    </select>
                </label>
                <label>
                    Approval
                    <select @bind="_permission.ApprovalMode">
                        @foreach (var mode in Enum.GetValues<OrganicApprovalMode>())
                        {
                            <option value="@mode">@mode</option>
                        }
                    </select>
                </label>
                @if (_permission.ApprovalMode == OrganicApprovalMode.CurrentWorkOrder)
                {
                    <label>
                        Work-order key
                        <input @bind="_permission.WorkOrderKey" />
                    </label>
                }
                <label class="organic-check"><input type="checkbox" @bind="_permission.IsExposed" /> Reveal capability to this peer</label>
                <label class="organic-check"><input type="checkbox" @bind="_permission.AllowInvocation" /> Allow this peer to invoke it</label>
                <label class="organic-check"><input type="checkbox" @bind="_permission.RequiresFrontendConfirmation" /> Always require this PublisherStudio frontend</label>
                <label class="organic-check"><input type="checkbox" @bind="_permission.RequireLinkedPeer" /> Require explicit frontend connection</label>
                <label>
                    Human input editor
                    <select @bind="_permission.InteractionEditor">
                        @foreach (var editor in Enum.GetValues<OrganicInteractionEditor>())
                        {
                            <option value="@editor">@editor</option>
                        }
                    </select>
                </label>
            </div>
            <button type="button" class="organic-primary" @onclick="SavePermission">Save permission</button>
            <p class="organic-note">The receiving frontend is authoritative. A matching rule controls discovery, invocation and the editor shown for requested human information. Scheduled and sequential spool work cannot bypass it.</p>

            @if (_permissions.Count > 0)
            {
                <div class="organic-table-wrap">
                    <table class="organic-table">
                        <thead><tr><th>Peer</th><th>Capability</th><th>Organ</th><th>Exposed</th><th>Invoke</th><th>Frontend</th><th>Editor</th><th>Approval</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var rule in _permissions)
                            {
                                <tr @key="@(rule.PeerId + rule.CapabilityKey + rule.Organ)">
                                    <td>@rule.PeerId</td><td>@rule.CapabilityKey</td><td>@(string.IsNullOrWhiteSpace(rule.Organ) ? "*" : rule.Organ)</td>
                                    <td>@(rule.IsExposed ? "yes" : "no")</td><td>@(rule.AllowInvocation ? "yes" : "no")</td><td>@(rule.RequiresFrontendConfirmation ? "required" : "saved policy")</td><td>@rule.InteractionEditor</td><td>@rule.ApprovalMode</td>
                                    <td><button type="button" class="organic-link-danger" @onclick="() => DeletePermission(rule)">Remove</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="organic-card">
            <h2>Pending and recent organ work</h2>
            @if (_work.Count == 0)
            {
                <p class="organic-empty">No external organ work has arrived.</p>
            }
            else
            {
                <div class="organic-list">
                    @foreach (var item in _work)
                    {
                        <article class="organic-work" @key="item.Id">
                            <div>
                                <strong>@item.CapabilityKey</strong>
                                <span>@item.Status · @item.UpdatedUtc.LocalDateTime.ToString("g")</span>
                                <small>Work order: @(string.IsNullOrWhiteSpace(item.Request.WorkOrderKey) ? item.Id.ToString("N") : item.Request.WorkOrderKey)</small>
                                @if (!string.IsNullOrWhiteSpace(item.Error)) { <span class="organic-error">@item.Error</span> }
                            </div>
                            @if (item.Status == OrganicWorkStatus.PendingApproval)
                            {
                                <div class="organic-actions">
                                    <button type="button" class="organic-primary" @onclick="() => ApproveAsync(item.Id)">Approve once</button>
                                    <button type="button" class="organic-danger" @onclick="() => DeclineAsync(item.Id)">Decline</button>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>
    </div>

    <section class="organic-card">
        <h2>Council responses and proposals</h2>
        @if (_results.Count == 0 && _textProposals.Count == 0)
        {
            <p class="organic-empty">No responses have been received from LocalGPT.</p>
        }
        @foreach (var proposal in _textProposals)
        {
            <article class="organic-result" @key="proposal.Id">
                <strong>Text proposal for @proposal.Target</strong>
                <p>@proposal.Text</p>
                <small>@proposal.Reason · requires explicit insertion by the user</small>
            </article>
        }
        @foreach (var result in _results.Take(25))
        {
            <details class="organic-result" @key="result.Id">
                <summary>@result.Request.MessageType · @result.CapabilityKey · @result.UpdatedUtc.LocalDateTime.ToString("g")</summary>
                @if (!string.IsNullOrWhiteSpace(result.Error)) { <p class="organic-error">@result.Error</p> }
                @if (!string.IsNullOrWhiteSpace(result.ResultJson)) { <pre>@result.ResultJson</pre> }
            </details>
        }
    </section>
</main>

@code {
    private IReadOnlyList<OrganicPeerAdvertisement> _peers = [];
    private IReadOnlyList<OrganicCapabilityDescriptor> _capabilities = [];
    private IReadOnlyList<OrganicPermissionRule> _permissions = [];
    private IReadOnlyList<OrganicPluginWorkItem> _work = [];
    private IReadOnlyList<OrganicPluginWorkItem> _results = [];
    private IReadOnlyList<OrganicTextInsertionProposal> _textProposals = [];
    private IReadOnlyList<RecurringScreenReaderSession> _screenReaderSessions = [];
    private string _screenReaderSelector = "body";
    private string _screenReaderPrompt = "Describe meaningful screen changes and suggest the next safe action.";
    private int _screenReaderIntervalSeconds = 15;
    private string _textGenerationTarget = "PublisherStudio text component";
    private string _textGenerationPrompt = string.Empty;
    private string _textGenerationTeamKey = "general";
    private OrganicCouncilPromptRequest _councilRequest = null!;
    private OrganicPermissionRule _permission = null!;
    private string _roundTripStatus = string.Empty;
    private bool _browserAutomationEnabled;
    private bool _automationStateLoaded;

    protected override async Task OnInitializedAsync()
    {
        _councilRequest = NewCouncilRequest("general");
        _permission = NewPermission(string.Empty);
        Discovery.Changed += OnServiceChanged;
        Connection.Changed += OnServiceChanged;
        WorkCoordinator.Changed += OnServiceChanged;
        ResultStore.Changed += OnServiceChanged;
        RecurringScreenReader.Changed += OnServiceChanged;
        _capabilities = await CapabilityCatalog.GetCapabilitiesAsync();
        Refresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _automationStateLoaded) return;
        _automationStateLoaded = true;
        try { _browserAutomationEnabled = await JS.InvokeAsync<bool>("publisherAutomation.isEnabled"); }
        catch (JSException exception) { Logger.LogDebug(exception, "Browser automation state is not available before JavaScript startup completes."); }
        await InvokeAsync(StateHasChanged);
    }

    private bool CanRunCouncil => Connection.State.IsLinked && Connection.State.HasCapability("council.run");
    private bool CanGenerateTextProposal => CanRunCouncil
        && _capabilities.Any(item => item.IsEnabled && item.IsOnline && string.Equals(item.Key, "publisher.text.insert.propose", StringComparison.OrdinalIgnoreCase))
        && !string.IsNullOrWhiteSpace(_textGenerationPrompt)
        && !string.IsNullOrWhiteSpace(_textGenerationTarget);
    private bool CanUseScreenReader => Connection.State.IsConnected && Connection.State.IsLinked
        && Connection.State.HasCapability("localgpt.screenreader.help")
        && _capabilities.Any(item => item.IsEnabled && item.IsOnline && string.Equals(item.Key, "publisher.screen.capture", StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<(string Key, string Name)> CouncilTeams
    {
        get
        {
            var keys = Connection.State.RemoteCapabilities
                .Where(item => item.IsEnabled && item.IsOnline && string.Equals(item.Key, "council.run", StringComparison.OrdinalIgnoreCase))
                .SelectMany(item => item.Skills)
                .Where(key => !string.IsNullOrWhiteSpace(key))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            if (keys.Count == 0) keys.Add("general");
            return keys.Select(key => (key, key switch
            {
                "general" => "General Council",
                "openscad-team" => "OpenSCAD Team",
                "spreadsheet-team" => "Spreadsheet Team",
                "learning-round" => "Learning Round",
                _ => key
            })).ToList();
        }
    }

    private void BackToPublisher() => Navigation.NavigateTo("/");

    private void Refresh()
    {
        _peers = Discovery.GetPeers();
        _permissions = PermissionStore.GetRules();
        _work = WorkCoordinator.GetWork();
        _results = ResultStore.GetResults();
        _textProposals = ResultStore.GetTextProposals();
        _screenReaderSessions = RecurringScreenReader.GetSessions();
        if (!CouncilTeams.Any(team => string.Equals(team.Key, _councilRequest.TeamKey, StringComparison.OrdinalIgnoreCase)))
            _councilRequest.TeamKey = CouncilTeams.First().Key;
        if (!CouncilTeams.Any(team => string.Equals(team.Key, _textGenerationTeamKey, StringComparison.OrdinalIgnoreCase)))
            _textGenerationTeamKey = CouncilTeams.First().Key;
        if (string.IsNullOrWhiteSpace(_permission.PeerId))
            _permission.PeerId = Connection.State.PeerId.Length > 0 ? Connection.State.PeerId : _peers.FirstOrDefault()?.PeerId ?? "localgpt";
    }

    private void OnServiceChanged() => _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });

    private async Task ConnectAsync(string peerId)
    {
        try
        {
            var state = await Connection.ConnectAsync(peerId);
            if (state.IsConnected)
            {
                _permission.PeerId = peerId;
                Notifications.Information($"Transport opened to {state.DisplayName}. Approve the pending link in LocalGPT to finish connecting.", "LocalGPT link requested", nameof(OrganicPlugins));
            }
            else Notifications.Error(state.LastError, "LocalGPT connection failed", nameof(OrganicPlugins));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "PublisherStudio could not connect to LocalGPT peer {PeerId}.", peerId);
            Notifications.Error(ex.Message, "LocalGPT connection failed", nameof(OrganicPlugins));
        }
        Refresh();
    }

    private async Task RunRoundTripTestAsync()
    {
        if (!Connection.State.IsConnected) return;
        try
        {
            _roundTripStatus = "Testing protocol negotiation…";
            var envelope = new OrganicWireEnvelope
            {
                MessageType = OrganicWireMessageType.CapabilityRequest,
                TargetPeerId = Connection.State.PeerId,
                CapabilityKey = "onewire.capabilities",
                UserConfirmed = true,
                ExpiresUtc = DateTimeOffset.UtcNow.AddSeconds(10)
            };
            var correlationId = await Connection.SendEnvelopeAsync(envelope);
            var result = await Connection.WaitForResultAsync(correlationId, TimeSpan.FromSeconds(10));
            var capabilityCount = result.Properties is not null && result.Properties.TryGetValue("Capabilities", out var value) && value.ValueKind == JsonValueKind.Array
                ? value.GetArrayLength()
                : Connection.State.RemoteCapabilities.Count;
            _roundTripStatus = $"1-Wire {result.ProtocolVersion} round trip succeeded; LocalGPT reported {capabilityCount} capabilities.";
            Notifications.Success(_roundTripStatus, "Organic connection verified", nameof(OrganicPlugins));
        }
        catch (Exception exception)
        {
            _roundTripStatus = $"Round-trip test failed: {exception.Message}";
            Notifications.Error(_roundTripStatus, "Organic connection test", nameof(OrganicPlugins));
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleBrowserAutomationAsync()
    {
        if (!Connection.State.IsLinked)
        {
            Notifications.Warning("Approve and link LocalGPT before enabling browser automation.", "Browser automation", nameof(OrganicPlugins));
            return;
        }
        _browserAutomationEnabled = _browserAutomationEnabled
            ? await JS.InvokeAsync<bool>("publisherAutomation.disableForSession")
            : await JS.InvokeAsync<bool>("publisherAutomation.enableForSession");
        Notifications.Information(
            _browserAutomationEnabled
                ? "Browser automation is enabled only for this browser tab and only while the 1-Wire peer remains linked."
                : "Browser automation polling is disabled for this browser tab.",
            "Browser automation", nameof(OrganicPlugins));
    }

    private async Task DisconnectAsync()
    {
        if (_browserAutomationEnabled)
        {
            _browserAutomationEnabled = await JS.InvokeAsync<bool>("publisherAutomation.disableForSession");
        }
        await Connection.DisconnectAsync();
        Notifications.Information("PublisherStudio disconnected from LocalGPT.", source: nameof(OrganicPlugins));
        Refresh();
    }

    private async Task SendCouncilAsync()
    {
        try
        {
            _councilRequest.RequestedOrganicCapabilities = _councilRequest.TeamKey switch
            {
                "openscad-team" => ["publisher.business-context", "publisher.openscad.generate", "publisher.screen.capture", "publisher.screen.capture.result"],
                "spreadsheet-team" => ["publisher.business-context", "publisher.spreadsheet.inspect", "publisher.screen.capture", "publisher.screen.capture.result", "publisher.input.execute", "publisher.input.result"],
                "learning-round" => ["publisher.business-context"],
                _ => ["publisher.business-context"]
            };
            var id = await Connection.SendCouncilRequestAsync(_councilRequest);
            Notifications.Success($"Council request {id} was submitted.", "Council round started", nameof(OrganicPlugins));
            var team = _councilRequest.TeamKey;
            _councilRequest = NewCouncilRequest(team);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not submit the LocalGPT council request.");
            Notifications.Error(ex.Message, "Council request failed", nameof(OrganicPlugins));
        }
    }

    private async Task GenerateTextProposalAsync()
    {
        if (!CanGenerateTextProposal)
            return;

        try
        {
            var request = NewCouncilRequest(_textGenerationTeamKey);
            request.RequestedOrganicCapabilities = ["publisher.business-context", "publisher.text.insert.propose"];
            request.ExternalProjectContextJson = System.Text.Json.JsonSerializer.Serialize(new
            {
                Source = "PublisherStudio",
                Target = _textGenerationTarget,
                Workflow = "Reviewable text insertion proposal"
            });
            request.Prompt = $"""
PublisherStudio user request:
{_textGenerationPrompt.Trim()}

Required result contract:
1. Generate the final text for target '{_textGenerationTarget.Trim()}'.
2. Before completing the Council run, invoke the LocalGPT DX function publisher.text.proposal.request with JSON parameters containing target, text and a concise reason.
3. Do not insert or mutate the publication automatically. The PublisherStudio user reviews the proposal and performs the final insertion.
""";
            var id = await Connection.SendCouncilRequestAsync(request);
            Notifications.Success($"Text-generation Council request {id} was submitted.", "Text proposal requested", nameof(OrganicPlugins));
            _textGenerationPrompt = string.Empty;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not submit the PublisherStudio text-generation request to LocalGPT.");
            Notifications.Error(ex.Message, "Text proposal request failed", nameof(OrganicPlugins));
        }
    }

    private async Task StartScreenReaderAsync()
    {
        try
        {
            var session = await RecurringScreenReader.StartAsync(
                Connection.State.PeerId, _screenReaderSelector, _screenReaderPrompt, _screenReaderIntervalSeconds);
            Notifications.Success($"Recurring screen-reader session {session.Id} started.", "Screen reader", nameof(OrganicPlugins));
            Refresh();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not start recurring screen-reader help.");
            Notifications.Error(ex.Message, "Screen reader did not start", nameof(OrganicPlugins));
        }
    }

    private async Task StopScreenReaderAsync(Guid id)
    {
        if (await RecurringScreenReader.StopAsync(id))
            Notifications.Information("Recurring screen-reader help stopped.", source: nameof(OrganicPlugins));
        Refresh();
    }

    private void SavePermission()
    {
        try
        {
            PermissionStore.Save(_permission);
            Notifications.Success("The organ permission was saved.", source: nameof(OrganicPlugins));
            _permission = NewPermission(Connection.State.PeerId.Length > 0 ? Connection.State.PeerId : _permission.PeerId);
            Refresh();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save an organic plugin permission.");
            Notifications.Error(ex.Message, "Permission was not saved", nameof(OrganicPlugins));
        }
    }

    private void DeletePermission(OrganicPermissionRule rule)
    {
        PermissionStore.Delete(rule.PeerId, rule.CapabilityKey, rule.Organ);
        Refresh();
    }

    private async Task ApproveAsync(Guid id)
    {
        var item = await WorkCoordinator.ApproveAsync(id);
        if (item is null) return;
        await Connection.SendWorkResultAsync(item);
        Notifications.Success($"{item.CapabilityKey} completed with one-time approval.", "Organic work", nameof(OrganicPlugins));
        Refresh();
    }

    private async Task DeclineAsync(Guid id)
    {
        if (!WorkCoordinator.Decline(id, "Declined by the PublisherStudio user.")) return;
        var item = WorkCoordinator.Get(id);
        if (item is not null) await Connection.SendWorkResultAsync(item);
        Notifications.Warning("The requested organ action was declined.", "Organic work", nameof(OrganicPlugins));
        Refresh();
    }

    private OrganicPermissionRule NewPermission(string peerId) => new()
    {
        PeerId = peerId,
        IsExposed = true,
        AllowInvocation = true,
        RequiresFrontendConfirmation = true,
        RequireLinkedPeer = true,
        InteractionEditor = OrganicInteractionEditor.ConfirmationOnly,
        ApprovalMode = OrganicApprovalMode.AskEveryTime
    };

    private OrganicCouncilPromptRequest NewCouncilRequest(string team) => new()
    {
        TeamKey = team,
        ExternalProjectContextJson = "{}",
        MaxRounds = 1,
        MaxOutputTokens = 262144,
        MaxContextTokens = 262144,
        MaxParallelModels = 1,
        IncludeMemory = true,
        SaveToMemory = true
    };

    public void Dispose()
    {
        Discovery.Changed -= OnServiceChanged;
        Connection.Changed -= OnServiceChanged;
        WorkCoordinator.Changed -= OnServiceChanged;
        ResultStore.Changed -= OnServiceChanged;
        RecurringScreenReader.Changed -= OnServiceChanged;
    }
}
