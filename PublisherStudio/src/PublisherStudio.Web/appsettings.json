{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Twitch": {
    "ClientId": ""
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "PublisherStudio": {
    "FFmpegPath": "",
    "Paths": {
      "Images": "",
      "Video": "",
      "Audio": "",
      "Documents": "",
      "Exports": "",
      "OpenScad": "",
      "Projects": ""
    },
    "Port": 58071,
    "SystemVariables": {
      "Application.DefaultPort": "58071",
      "Application.PortEnvironmentVariable": "PUBLISHERSTUDIO_PORT",
      "Application.DefaultCulture": "en-US",
      "Application.CorsPolicyName": "PublisherExport",
      "Application.DataProtectionDirectoryName": "DataProtection",
      "Application.DataProtectionApplicationName": "PublisherStudio",
      "Application.RuntimeDirectoryName": "runtime",
      "Application.RuntimeEndpointFileName": "server.json",
      "Spreadsheet.HibernationDirectoryName": "SpreadsheetHibernation",
