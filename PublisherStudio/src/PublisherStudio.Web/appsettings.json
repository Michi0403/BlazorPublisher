        "OverrideFileName": "panel-text-patterns.json"
      }
    }
  },
  "OrganicPlugins": {
    "Enabled": true,
    "EnableDiscovery": true,
    "DiscoveryPort": 51141,
    "PeerExpirySeconds": 30,
    "DiscoveryReceivePollSeconds": 5,
    "MaximumMessageBytes": 8388608,
    "ServicePort": 51140,
    "BroadcastAddress": "255.255.255.255",
    "LoopbackBeaconAddress": "127.0.0.1",
    "AutoConnectDiscoveredPeer": true
