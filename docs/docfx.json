{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "PublisherStudio.Web.dll"
          ],
          "src": "input"
        }
      ],
      "dest": "api",
      "namespaceLayout": "nested",
      "memberLayout": "samePage",
      "outputFormat": "mref"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "input/**",
          "templates/**",
          ".tools/**",
          "internal-notes/**",
          ".print-book/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "pdf-cover.html",
          "PublisherStudio-*.pdf"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "PublisherStudio Documentation",
      "_appTitle": "PublisherStudio Documentation",
      "_appFooter": "PublisherStudio 3.1.7 Â· generated documentation",
      "publisherstudioVersion": "3.1.7"
    }
  }
}
