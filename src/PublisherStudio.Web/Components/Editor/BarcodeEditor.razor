@using System.Text.Json
@using System.Xml.Linq
@namespace PublisherStudio.Components.Editor
@implements IAsyncDisposable
@inject IJSRuntime JS

@inject ILogger<BarcodeEditor> Logger
@if (Visible && Item is not null)
{
    <div class="modal-backdrop">
        <section class="barcode-editor-dialog" role="dialog" aria-modal="true" aria-label="Barcode editor">
            <header><div><strong>Barcode Studio</strong><span>@FormatSummary</span></div><button type="button" class="window-close" @onclick="Cancel">×</button></header>
            <DxRibbon CssClass="barcode-editor-ribbon categorized-ribbon" SizeMode="SizeMode.Small" AdaptivityAutoCollapseItemsToGroups="false">
                <DxRibbonTab Text="Barcode">
                    <DxRibbonGroup Text="Format" IconCssClass="pub-icon pub-icon-barcode">
                        <DxRibbonItem Text="QR Code" IconCssClass="pub-icon pub-icon-barcode" Click="SetQrCode" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-barcode" Text="Code 128" Click="SetCode128" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-barcode" Text="Code 39" Click="SetCode39" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-barcode" Text="EAN-13" Click="SetEan13" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="More formats">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-barcode" Text="UPC-A" Click="SetUpcA" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-barcode" Text="ITF-14" Click="SetItf14" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-barcode" Text="Codabar" Click="SetCodabar" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Generate">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-random" Text="Regenerate" Click="RefreshNow" />
                    </DxRibbonGroup>
                </DxRibbonTab>
                <DxRibbonTab Text="Design">
                    <DxRibbonGroup Text="Colors">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-color" Text="Swap foreground / background" Click="SwapColors" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-command" Text="@TransparencyCommandText" Click="ToggleTransparency" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Module / bar design">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-properties" Text="Square" Click="SetSquare" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-command" Text="Rounded" Click="SetRounded" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-command" Text="Dots" Enabled="@(_draft.Format == PublicationBarcodeFormat.QrCode)" Click="SetDots" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="QR correction">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-command" Text="Low (L)" Enabled="@(_draft.Format == PublicationBarcodeFormat.QrCode)" Click="SetLowCorrection" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-command" Text="Medium (M)" Enabled="@(_draft.Format == PublicationBarcodeFormat.QrCode)" Click="SetMediumCorrection" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-command" Text="Quartile (Q)" Enabled="@(_draft.Format == PublicationBarcodeFormat.QrCode)" Click="SetQuartileCorrection" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-command" Text="High (H)" Enabled="@(_draft.Format == PublicationBarcodeFormat.QrCode)" Click="SetHighCorrection" />
                    </DxRibbonGroup>
                </DxRibbonTab>
            </DxRibbon>
            <div class="barcode-editor-body">
                <div class="barcode-editor-preview" @oncontextmenu="ShowContextMenu" @oncontextmenu:preventDefault>
                    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="barcode-error">@_error</div> }
                    else { @((MarkupString)_svg) }
                </div>
                <div class="barcode-editor-properties">
                    <label>Format<select value="@_draft.Format" @onchange="ChangeFormat">@foreach (var format in Enum.GetValues<PublicationBarcodeFormat>()) { <option value="@format">@FormatName(format)</option> }</select></label>
                    <label>Value<textarea rows="4" @oninput="ChangeValue">@_draft.Value</textarea></label>
                    <label class="barcode-file-picker">Import value from CSV, TSV, JSON, XML, or TXT
                        <InputFile accept=".csv,.tsv,.txt,.json,.xml,text/csv,text/tab-separated-values,application/json,application/xml,text/xml,text/plain" OnChange="ImportValueFile" />
                    </label>
                    @if (!string.IsNullOrWhiteSpace(_importInfo)) { <small class="barcode-import-info">@_importInfo</small> }
                    <div class="picture-property-grid"><label>Foreground<input type="color" value="@_draft.ForegroundColor" @oninput="ChangeForeground" /></label><label>Background<input type="color" value="@_draft.BackgroundColor" @oninput="ChangeBackground" /></label></div>
                    <label><input type="checkbox" checked="@_draft.TransparentBackground" @onchange="ChangeTransparent" /> Transparent background</label>
                    @if (_draft.Format == PublicationBarcodeFormat.QrCode)
                    {
                        <label>Error correction<select value="@_draft.ErrorCorrection" @onchange="ChangeCorrection">@foreach (var level in Enum.GetValues<PublicationBarcodeErrorCorrection>()) { <option value="@level">@level</option> }</select></label>
                        <label>Module design<select value="@_draft.ModuleShape" @onchange="ChangeShape">@foreach (var shape in Enum.GetValues<PublicationBarcodeModuleShape>()) { <option value="@shape">@shape</option> }</select></label>
                    }
                    else
                    {
                        <label><input type="checkbox" checked="@_draft.ShowText" @onchange="ChangeShowText" /> Show readable text</label>
                        <div class="picture-property-grid"><label>Line width<input type="number" min="1" max="8" value="@_draft.LineWidth" @onchange="ChangeLineWidth" /></label><label>Bar height<input type="number" min="24" max="400" value="@_draft.BarHeight" @onchange="ChangeBarHeight" /></label><label>Font size<input type="number" min="8" max="72" value="@_draft.FontSize" @onchange="ChangeFontSize" /></label><label>Bar design<select value="@_draft.ModuleShape" @onchange="ChangeShape"><option value="Square">Square</option><option value="Rounded">Rounded</option></select></label></div>
                    }
                    <label>Margin<input type="range" min="0" max="32" step="1" value="@_draft.Margin" @oninput="ChangeMargin" /><span>@_draft.Margin</span></label>
                </div>
            </div>
            <footer><DxButton Text="Cancel" Click="Cancel" /><DxButton Text="Insert / Apply" RenderStyle="ButtonRenderStyle.Primary" Enabled="@string.IsNullOrWhiteSpace(_error)" Click="Save" /></footer>
        </section>
    </div>

    <DxContextMenu @ref="_menu"><Items>
        <DxContextMenuItem Text="Regenerate" Click="RefreshNow" />
        <DxContextMenuItem Text="Swap colors" Click="SwapColors" />
        <DxContextMenuItem Text="@TransparencyCommandText" Click="ToggleTransparency" />
        @if (_draft.Format == PublicationBarcodeFormat.QrCode)
        {
            <DxContextMenuItem Text="High error correction" Click="SetHighCorrection" />
            <DxContextMenuItem Text="Square modules" Click="SetSquare" />
            <DxContextMenuItem Text="Rounded modules" Click="SetRounded" />
            <DxContextMenuItem Text="Dot modules" Click="SetDots" />
        }
    </Items></DxContextMenu>
}

@code {

    /// <summary>
    /// Gets or sets a value indicating whether the value is visible applies to the barcode editor state.
    /// </summary>
    /// <value>The visible value exposed by <see cref="BarcodeEditor"/>.</value>
    [Parameter] public bool Visible { get; set; }
    /// <summary>
    /// Gets or sets the item value that forms part of the barcode editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The item value exposed by <see cref="BarcodeEditor"/>.</value>
    [Parameter] public BarcodeElement? Item { get; set; }
    /// <summary>
    /// Gets or sets the saved value that forms part of the barcode editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The saved value exposed by <see cref="BarcodeEditor"/>.</value>
    [Parameter] public EventCallback<BarcodeElement> Saved { get; set; }
    /// <summary>
    /// Gets or sets the cancelled value that forms part of the barcode editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The cancelled value exposed by <see cref="BarcodeEditor"/>.</value>
    [Parameter] public EventCallback Cancelled { get; set; }
    /// <summary>
    /// Stores the internal draft state used by <see cref="BarcodeEditor"/> while executing its surrounding workflow.
    /// </summary>
    private readonly BarcodeElement _draft = new();
    /// <summary>
    /// Stores the internal loaded identifier state used by <see cref="BarcodeEditor"/> while executing its surrounding workflow.
    /// </summary>
    private Guid _loadedId;
    /// <summary>
    /// Stores the internal SVG state used by <see cref="BarcodeEditor"/> while executing its surrounding workflow.
    /// </summary>
    private string _svg = string.Empty;
    /// <summary>
    /// Stores the internal error state used by <see cref="BarcodeEditor"/> while executing its surrounding workflow.
    /// </summary>
    private string? _error;
    /// <summary>
    /// Stores the internal import info state used by <see cref="BarcodeEditor"/> while executing its surrounding workflow.
    /// </summary>
    private string? _importInfo;
    /// <summary>
    /// Stores the internal refresh state used by <see cref="BarcodeEditor"/> while executing its surrounding workflow.
    /// </summary>
    private bool _refresh;
    /// <summary>
    /// Stores the internal generation request state used by <see cref="BarcodeEditor"/> while executing its surrounding workflow.
    /// </summary>
    private int _generationRequest;
    /// <summary>
    /// Stores the internal menu state used by <see cref="BarcodeEditor"/> while executing its surrounding workflow.
    /// </summary>
    private DxContextMenu _menu = default!;
    /// <summary>
    /// Stores the JavaScript object reference dependency used by <see cref="BarcodeEditor"/> to delegate that application responsibility to its owning collaborator.
    /// </summary>
    private IJSObjectReference? _module;

    /// <summary>
    /// Handles the parameters set lifecycle or event notification for <see cref="BarcodeEditor"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnParametersSet()
    {
        try
        {
            if (!Visible || Item is null || Item.Id == _loadedId) return;
            _loadedId = Item.Id;
            Copy(Item, _draft);
            _svg = Item.SvgMarkup ?? string.Empty;
            _importInfo = null;
            _generationRequest++;
            _refresh = true;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(OnParametersSet)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Handles the after render async lifecycle or event notification for <see cref="BarcodeEditor"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="firstRender">Value indicating whether first render should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!Visible || !_refresh) return;
            _refresh = false;
            await Generate().ConfigureAwait(true);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(OnAfterRenderAsync)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Performs generate for <see cref="BarcodeEditor"/>, keeping the operation consistent with the state and invariants of the surrounding barcode editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task Generate()
    {
        try
        {
            var request = _generationRequest;
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/publisherInterop.js").ConfigureAwait(true);
                var svg = await _module.InvokeAsync<string>("generateBarcodeSvg", _draft).ConfigureAwait(true);
                if (request != _generationRequest) return;
                _svg = svg;
                _error = null;
            }
            catch (Exception ex)
            {
                if (request != _generationRequest) return;
                _svg = string.Empty;
                _error = ex.Message;
            }
            await InvokeAsync(StateHasChanged).ConfigureAwait(true);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(Generate)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Performs queue for <see cref="BarcodeEditor"/>, keeping the operation consistent with the state and invariants of the surrounding barcode editor workflow.
    /// </summary>
    private void Queue() {
        try
        {
     _generationRequest++; _refresh = true; StateHasChanged(); 
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(Queue)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Refreshes now for <see cref="BarcodeEditor"/>, keeping the operation consistent with the state and invariants of the surrounding barcode editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task RefreshNow() {
        try
        {
     _generationRequest++; return Generate(); 
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(RefreshNow)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Performs show context menu for <see cref="BarcodeEditor"/>, keeping the operation consistent with the state and invariants of the surrounding barcode editor workflow.
    /// </summary>
    /// <param name="args">Args value supplied to the barcode editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task ShowContextMenu(MouseEventArgs args) {
        try
        {
            return _menu.ShowAsync(args);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(ShowContextMenu)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Performs save for <see cref="BarcodeEditor"/>, keeping the operation consistent with the state and invariants of the surrounding barcode editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task Save() {
        try
        {
     _draft.SvgMarkup = _svg; await Saved.InvokeAsync(Clone(_draft)).ConfigureAwait(true); 
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(Save)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Determines whether cel for <see cref="BarcodeEditor"/>, keeping the operation consistent with the state and invariants of the surrounding barcode editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task Cancel() {
        try
        {
            return Cancelled.InvokeAsync();
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(Cancel)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Imports value file for <see cref="BarcodeEditor"/>, keeping the operation consistent with the state and invariants of the surrounding barcode editor workflow.
    /// </summary>
    /// <param name="args">Input file change event args dependency used by the barcode editor workflow to provide the corresponding application capability.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ImportValueFile(InputFileChangeEventArgs args)
    {
        try
        {
            try
            {
                var file = args.File;
                var stream = file.OpenReadStream(long.MaxValue);
                await using var configuredStreamAsyncDisposal = stream.ConfigureAwait(true);
                using var reader = new StreamReader(stream, detectEncodingFromByteOrderMarks: true);
                var source = await reader.ReadToEndAsync().ConfigureAwait(true);
                var extension = Path.GetExtension(file.Name).ToLowerInvariant();
                _draft.Value = extension switch
                {
                    ".json" => FirstJsonScalar(source),
                    ".xml" => FirstXmlScalar(source),
                    ".csv" => FirstDelimitedValue(source, GuessDelimiter(source)),
                    ".tsv" => FirstDelimitedValue(source, '\t'),
                    _ => source.Trim()
                };
                if (string.IsNullOrWhiteSpace(_draft.Value)) throw new InvalidDataException("The imported file does not contain a usable barcode value.");
                _draft.Value = NormalizeValueForFormat(_draft.Format, _draft.Value, out var adjusted);
                _importInfo = adjusted ? $"Loaded and adjusted a value from {file.Name} for {FormatName(_draft.Format)}." : $"Loaded first usable value from {file.Name}.";
                _error = null;
                Queue();
            }
            catch (Exception ex)
            {
                _importInfo = null;
                _error = ex.Message;
                await InvokeAsync(StateHasChanged).ConfigureAwait(true);
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(ImportValueFile)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs first JSON scalar for <see cref="BarcodeEditor"/>, keeping the operation consistent with the state and invariants of the surrounding barcode editor workflow.
    /// </summary>
    /// <param name="source">Source value supplied to the barcode editor operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string FirstJsonScalar(string source)
    {
        try
        {
            using var document = JsonDocument.Parse(source, new JsonDocumentOptions { AllowTrailingCommas = true, CommentHandling = JsonCommentHandling.Skip });
            return FindJsonScalar(document.RootElement) ?? string.Empty;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(FirstJsonScalar)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Finds JSON scalar for <see cref="BarcodeEditor"/>, keeping the operation consistent with the state and invariants of the surrounding barcode editor workflow.
    /// </summary>
    /// <param name="value">Value value supplied to the barcode editor operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string? FindJsonScalar(JsonElement value)
    {
        try
        {
            return value.ValueKind switch
            {
                JsonValueKind.String => value.GetString(),
                JsonValueKind.Number or JsonValueKind.True or JsonValueKind.False => value.GetRawText(),
                JsonValueKind.Array => value.EnumerateArray().Select(FindJsonScalar).FirstOrDefault(item => !string.IsNullOrWhiteSpace(item)),
                JsonValueKind.Object => value.EnumerateObject().Select(property => FindJsonScalar(property.Value)).FirstOrDefault(item => !string.IsNullOrWhiteSpace(item)),
                _ => null
            };
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(FindJsonScalar)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs first XML scalar for <see cref="BarcodeEditor"/>, keeping the operation consistent with the state and invariants of the surrounding barcode editor workflow.
    /// </summary>
    /// <param name="source">Source value supplied to the barcode editor operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string FirstXmlScalar(string source)
    {
        try
        {
            var document = XDocument.Parse(source);
            var leaf = document.Root?.DescendantsAndSelf().FirstOrDefault(element => !element.HasElements && !string.IsNullOrWhiteSpace(element.Value));
            return leaf?.Value.Trim() ?? document.Root?.Attributes().FirstOrDefault()?.Value?.Trim() ?? string.Empty;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(FirstXmlScalar)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs guess delimiter for <see cref="BarcodeEditor"/>, keeping the operation consistent with the state and invariants of the surrounding barcode editor workflow.
    /// </summary>
    /// <param name="source">Source value supplied to the barcode editor operation and used when producing its result.</param>
    /// <returns>The char produced by the operation.</returns>
    private char GuessDelimiter(string source)
    {
        try
        {
            var firstLine = source.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? string.Empty;
            return new[] { ',', ';', '\t', '|' }.OrderByDescending(candidate => firstLine.Count(character => character == candidate)).First();
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(GuessDelimiter)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs first delimited value for <see cref="BarcodeEditor"/>, keeping the operation consistent with the state and invariants of the surrounding barcode editor workflow.
    /// </summary>
    /// <param name="source">Source value supplied to the barcode editor operation and used when producing its result.</param>
    /// <param name="delimiter">Delimiter value supplied to the barcode editor operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string FirstDelimitedValue(string source, char delimiter)
    {
        try
        {
            var rows = source.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries)
                .Select(line => ParseDelimitedLine(line, delimiter))
                .Where(row => row.Count > 0)
                .Take(2)
                .ToList();
            if (rows.Count == 0) return string.Empty;
            var headers = rows[0];
            var preferred = headers.FindIndex(value => value.Trim().Equals("value", StringComparison.OrdinalIgnoreCase)
                || value.Trim().Equals("barcode", StringComparison.OrdinalIgnoreCase)
                || value.Trim().Equals("code", StringComparison.OrdinalIgnoreCase)
                || value.Trim().Equals("content", StringComparison.OrdinalIgnoreCase));
            if (rows.Count > 1 && preferred >= 0 && preferred < rows[1].Count) return rows[1][preferred].Trim();
            if (rows.Count > 1 && headers.All(value => value.Any(char.IsLetter))) return rows[1].FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? string.Empty;
            return headers.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? string.Empty;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(FirstDelimitedValue)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Parses delimited line for <see cref="BarcodeEditor"/>, keeping the operation consistent with the state and invariants of the surrounding barcode editor workflow.
    /// </summary>
    /// <param name="line">Line value supplied to the barcode editor operation and used when producing its result.</param>
    /// <param name="delimiter">Delimiter value supplied to the barcode editor operation and used when producing its result.</param>
    /// <returns>The collection produced by the operation.</returns>
    private List<string> ParseDelimitedLine(string line, char delimiter)
    {
        try
        {
            var values = new List<string>();
            var value = new StringBuilder();
            var quoted = false;
            for (var index = 0; index < line.Length; index++)
            {
                var character = line[index];
                if (character == '"')
                {
                    if (quoted && index + 1 < line.Length && line[index + 1] == '"') { value.Append('"'); index++; }
                    else quoted = !quoted;
                }
                else if (character == delimiter && !quoted) { values.Add(value.ToString()); value.Clear(); }
                else value.Append(character);
            }
            values.Add(value.ToString());
            return values;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(ParseDelimitedLine)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Gets the transparency command text value that forms part of the barcode editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The transparency command text value exposed by <see cref="BarcodeEditor"/>.</value>
    private string TransparencyCommandText => _draft.TransparentBackground ? "Use solid background" : "Use transparent background";
    /// <summary>
    /// Gets the format summary value that forms part of the barcode editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The format summary value exposed by <see cref="BarcodeEditor"/>.</value>
    private string FormatSummary => _draft.Format == PublicationBarcodeFormat.QrCode
        ? $"QR Code · correction {_draft.ErrorCorrection} · {_draft.ModuleShape} · {(_draft.TransparentBackground ? "transparent" : "solid background")}"
        : $"{FormatName(_draft.Format)} · {_draft.ModuleShape} bars · {(_draft.TransparentBackground ? "transparent" : "solid background")}";
    /// <summary>
    /// Sets format for <see cref="BarcodeEditor"/>, keeping the operation consistent with the state and invariants of the surrounding barcode editor workflow.
    /// </summary>
    /// <param name="format">Format value supplied to the barcode editor operation and used when producing its result.</param>
    private void SetFormat(PublicationBarcodeFormat format)
    {
        try
        {
            _draft.Format = format;
            _draft.Value = NormalizeValueForFormat(format, _draft.Value, out var adjusted);
            _importInfo = adjusted ? $"Value adjusted to a valid {FormatName(format)} example. You can replace it now." : null;
            if (format != PublicationBarcodeFormat.QrCode && _draft.ModuleShape == PublicationBarcodeModuleShape.Dots)
                _draft.ModuleShape = PublicationBarcodeModuleShape.Square;
            Queue();
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(SetFormat)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Sets QR code for <see cref="BarcodeEditor"/>, keeping the operation consistent with the state and invariants of the surrounding barcode editor workflow.
    /// </summary>
    private void SetQrCode() {
        try
        {
            SetFormat(PublicationBarcodeFormat.QrCode);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(SetQrCode)} failed.");
