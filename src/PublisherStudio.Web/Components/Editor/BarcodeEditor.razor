    /// <summary>
    /// Normalizes value for format for <see cref="BarcodeEditor"/>, keeping the operation consistent with the state and invariants of the surrounding barcode editor workflow.
    /// </summary>
    /// <param name="format">Format value supplied to the barcode editor operation and used when producing its result.</param>
    /// <param name="source">Source value supplied to the barcode editor operation and used when producing its result.</param>
    /// <param name="adjusted">Value indicating whether adjusted should apply to this operation.</param>
    /// <returns>The string produced by the operation.</returns>
    private string NormalizeValueForFormat(PublicationBarcodeFormat format, string? source, out bool adjusted)
    {
        try
        {
            var original = source?.Trim() ?? string.Empty;
            string value;
            switch (format)
            {
                case PublicationBarcodeFormat.Code39:
                    value = new string(original.ToUpperInvariant().Where(character => char.IsAsciiLetterOrDigit(character) || "-. $/+%".Contains(character)).ToArray());
                    if (string.IsNullOrWhiteSpace(value)) value = "PUBLISHER";
                    break;
                case PublicationBarcodeFormat.Ean13:
                    value = Digits(original);
                    if (value.Length is not (12 or 13)) value = "590123412345";
                    break;
                case PublicationBarcodeFormat.UpcA:
                    value = Digits(original);
                    if (value.Length == 12 && !HasValidUpcAChecksum(value)) value = value[..11];
                    if (value.Length is not (11 or 12)) value = "12345678901";
                    break;
                case PublicationBarcodeFormat.Itf14:
                    value = Digits(original);
                    if (value.Length != 14) value = "10012345000017";
                    break;
                case PublicationBarcodeFormat.Codabar:
                    value = original.ToUpperInvariant();
                    var body = new string(value.Where(character => char.IsDigit(character) || "-$:/.+".Contains(character)).ToArray());
                    if (string.IsNullOrWhiteSpace(body)) body = "123456";
                    value = $"A{body}A";
                    break;
                default:
                    value = string.IsNullOrWhiteSpace(original) ? (format == PublicationBarcodeFormat.QrCode ? "https://github.com/Michi0403/BlazorPublisher" : "PublisherStudio") : original;
                    break;
            }
            adjusted = !string.Equals(original, value, StringComparison.Ordinal);
            return value;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(BarcodeEditor)}.{nameof(NormalizeValueForFormat)} failed.");
            throw;
        }
    }
