@namespace PublisherStudio.Components.Editor

@inject ILogger<BarcodeView> Logger
<div class="razor-component-boundary">
<DxFormLayout CssClass="razor-component-layout-owner BarcodeView">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext001">
<div class="barcode-view" aria-label="@Item.Name">
    @if (string.IsNullOrWhiteSpace(Item.SvgMarkup))
    {
        <div class="barcode-placeholder"><strong>Barcode</strong><span>@Item.Value</span></div>
    }
    else
    {
        @((MarkupString)Item.SvgMarkup)
    }
</div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
</div>


@code {

    /// <summary>
    /// Gets or sets the item value that forms part of the barcode view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The item value exposed by <see cref="BarcodeView"/>.</value>
    [Parameter, EditorRequired] public BarcodeElement Item { get; set; } = default!;

}
