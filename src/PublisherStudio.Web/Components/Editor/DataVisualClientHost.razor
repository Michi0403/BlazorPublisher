@namespace PublisherStudio.Components.Editor
@implements IAsyncDisposable
@inject PublicationDataService DataService
@inject IJSRuntime JS

@inject ILogger<DataVisualClientHost> Logger
<div id="@ElementId" class="data-visual-client-host"></div>

@code {

    /// <summary>
    /// Gets or sets the document value that forms part of the data visual client host state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The document value exposed by <see cref="DataVisualClientHost"/>.</value>
    [Parameter, EditorRequired] public PublicationDocument Document { get; set; } = default!;
    /// <summary>
    /// Gets or sets the item value that forms part of the data visual client host state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The item value exposed by <see cref="DataVisualClientHost"/>.</value>
    [Parameter, EditorRequired] public DataVisualElement Item { get; set; } = default!;
    /// <summary>
    /// Gets or sets the stable current page identifier used to identify or correlate this data visual client host instance with related application state.
    /// </summary>
    /// <value>The current page identifier value exposed by <see cref="DataVisualClientHost"/>.</value>
    [Parameter] public Guid CurrentPageId { get; set; }

    /// <summary>
    /// Stores the internal instance identifier state used by <see cref="DataVisualClientHost"/> while executing its surrounding workflow.
    /// </summary>
    private readonly string _instanceId = Guid.NewGuid().ToString("N");
    /// <summary>
    /// Gets the stable element identifier used to identify or correlate this data visual client host instance with related application state.
    /// </summary>
    /// <value>The element identifier value exposed by <see cref="DataVisualClientHost"/>.</value>
    private string ElementId => $"ps-data-visual-{Item.Id:N}-{_instanceId}";
    /// <summary>
    /// Gets the client config value that forms part of the data visual client host state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The client config value exposed by <see cref="DataVisualClientHost"/>.</value>
    private object ClientConfig => DataService.BuildClientVisualConfiguration(Document, Item, CurrentPageId);
    /// <summary>
    /// Stores the internal last client config JSON state used by <see cref="DataVisualClientHost"/> while executing its surrounding workflow.
    /// </summary>
    private string? _lastClientConfigJson;
    /// <summary>
    /// Tracks whether this component instance successfully attached its visual to the browser runtime; static prerender instances remain false.
    /// </summary>
    private bool _browserAttached;

    /// <summary>
    /// Handles the after render async lifecycle or event notification for <see cref="DataVisualClientHost"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="firstRender">Value indicating whether first render should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            var config = ClientConfig;
            var configJson = System.Text.Json.JsonSerializer.Serialize(config);
            if (!firstRender && string.Equals(configJson, _lastClientConfigJson, StringComparison.Ordinal))
                return;

            _lastClientConfigJson = configJson;
            try
            {
                await JS.InvokeVoidAsync("PublisherStudioLiveDataRuntime.renderVisualById", ElementId, config).ConfigureAwait(true);
                _browserAttached = true;
            }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(DataVisualClientHost)}.{nameof(OnAfterRenderAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Releases resources owned by <see cref="DataVisualClientHost"/> and leaves the data visual client host workflow in a safely disposed state.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    public async ValueTask DisposeAsync()
    {
        try
        {
            try
            {
                if (_browserAttached)
                {
                    await JS.InvokeVoidAsync("PublisherStudioLiveDataRuntime.disposeById", ElementId).ConfigureAwait(true);
                    _browserAttached = false;
                }
            }
            catch (JSDisconnectedException) { _browserAttached = false; }
            catch (InvalidOperationException) { _browserAttached = false; }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(DataVisualClientHost)}.{nameof(DisposeAsync)} failed.");
            throw;
        }
    }

}
