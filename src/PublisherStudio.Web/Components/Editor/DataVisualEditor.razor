@namespace PublisherStudio.Components.Editor
@inject PublicationDataService DataService
@inject IFileLocalizationService Localization

@inject ILogger<DataVisualEditor> Logger
<div class="razor-component-boundary">
<DxFormLayout CssClass="razor-component-layout-owner DataVisualEditor">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext001">
@if (Visible && _draft is not null)
{
    <DxPopup Visible="true"
         Width="min(1800px, 98vw)"
         Height="min(1180px, 96vh)"
         MaxHeight="96vh"
         CloseOnOutsideClick="false"
         CloseOnEscape="false"
         ShowHeader="false">
    <BodyContentTemplate Context="publisherPopupContext">
        <DxFormLayout CssClass="razor-section-layout-owner">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext002">
        <div class="data-visual-editor-dialog" aria-label='@LT("Data visual editor")'>
            <header>
                <div>
                    <strong>@LT("Insert / edit data visual")</strong>
                    <span>@LT("The complete DevExtreme chart-series workbench plus pies, polar charts, sparklines, gauges, Sankey, funnel, pyramid, tree map, range selector, grid, and KPI.")</span>
                </div>
                <DxButton CssClass="window-close" Click="Cancel" Text="×" />
            </header>

            <DxRibbon CssClass="data-visual-editor-ribbon categorized-ribbon" SizeMode="SizeMode.Small" AdaptivityAutoCollapseItemsToGroups="true">
                <DxRibbonTab Text='@LT("Visual")'>
                    <DxRibbonGroup Text='@LT("Data")' IconCssClass="pub-icon pub-icon-data">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-chart" Text='@LT("Manage publication data")' IsPrimary="true" Click="RequestManage" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-chart" Text='@LT("Refresh live data")' Click="Refresh" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-chart" Text='@LT("Auto-map fields")' Click="AutoMapFields" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text='@LT("Options")'>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-chart" Text='@LT("Reset visual options")' Click="ResetVisualOptions" />
                    </DxRibbonGroup>
                </DxRibbonTab>
            </DxRibbon>

            <div class="data-visual-editor-body">
                <aside class="visual-type-list">
                    @foreach (var kind in Enum.GetValues<DataVisualKind>())
                    {
                        <DxButton CssClass="@(_draft.VisualKind == kind ? "selected" : null)" Click="@(() => SetKind(kind))">
                            <span class="visual-type-icon">@KindIcon(kind)</span>
                            <strong>@KindName(kind)</strong>
                            <small>@KindDescription(kind)</small>
                        </DxButton>
                    }
                </aside>

                <main class="visual-settings">
                    <div class="data-form-grid">
                        <label>@LT("Title")
                            <DxTextBox Text="@_draft.Title" TextChanged="@((string value) => ChangeTitle(new ChangeEventArgs { Value = value }))" CssClass="data-visual-devexpress-editor" />
                        </label>
                        <label>@LT("Data object")
                            <DxComboBox Data="@State.Document.DataObjects"
                                        Value="@_draft.DataObjectId"
                                        ValueChanged="@((Guid value) => ChangeDataObject(new ChangeEventArgs { Value = value }))"
                                        TextFieldName="@nameof(PublicationDataObject.Name)"
                                        ValueFieldName="@nameof(PublicationDataObject.Id)"
                                        CssClass="data-visual-devexpress-editor">
                                <ItemDisplayTemplate>
                                    <span>@context.DataItem.Name (@LT(Friendly(context.DataItem.SourceKind.ToString())))</span>
                                </ItemDisplayTemplate>
                            </DxComboBox>
                        </label>
                    </div>

                    @if (CurrentData is null)
                    {
                        <div class="inline-error">@LT("No data object is available. Open the data manager and create one.")</div>
                    }
                    else
                    {
                        <div class="data-form-grid">
                            <label>@LT("Argument / category")
                                <DxComboBox Data="@Columns"
                                            Value="@_draft.ArgumentField"
                                            ValueChanged="@((string value) => ChangeArgumentField(new ChangeEventArgs { Value = value }))"
                                            TextFieldName="@nameof(PublicationDataColumn.Name)"
                                            ValueFieldName="@nameof(PublicationDataColumn.Name)"
                                            CssClass="data-visual-devexpress-editor" />
                            </label>
                            <label>@LT("Series grouping (optional)")
                                <DxComboBox Data="@Columns"
                                            Value="@_draft.SeriesField"
                                            ValueChanged="@((string value) => ChangeSeriesField(new ChangeEventArgs { Value = value }))"
                                            TextFieldName="@nameof(PublicationDataColumn.Name)"
                                            ValueFieldName="@nameof(PublicationDataColumn.Name)"
                                            NullText='@LT("None")'
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            CssClass="data-visual-devexpress-editor" />
                            </label>
                        </div>

                        @if (_draft.VisualKind != DataVisualKind.DataTable)
                        {
                            <div class="data-form-grid chart-data-semantics">
                                <label>@LT("Argument axis")
                                    <DxComboBox Data="@ArgumentModeOptions"
                                                Value="@_draft.ArgumentMode"
                                                ValueChanged="@((DataVisualArgumentMode value) => ChangeArgumentMode(new ChangeEventArgs { Value = value.ToString() }))"
                                                CssClass="data-visual-devexpress-editor">
                                        <ItemDisplayTemplate>@LT(Friendly(context.DataItem.ToString()))</ItemDisplayTemplate>
                                    </DxComboBox>
                                </label>
                                <label>@LT("Repeated categories")
                                    <DxComboBox Data="@AggregationModeOptions"
                                                Value="@_draft.AggregationMode"
                                                ValueChanged="@((DataVisualAggregationMode value) => ChangeAggregationMode(new ChangeEventArgs { Value = value.ToString() }))"
                                                Enabled="@SupportsAggregation"
                                                CssClass="data-visual-devexpress-editor">
                                        <ItemDisplayTemplate>@LT(AggregationLabel(context.DataItem))</ItemDisplayTemplate>
                                    </DxComboBox>
                                </label>
                                <label>@LT("Point order")
                                    <DxComboBox Data="@SortModeOptions"
                                                Value="@_draft.SortMode"
                                                ValueChanged="@((DataVisualSortMode value) => ChangeSortMode(new ChangeEventArgs { Value = value.ToString() }))"
                                                CssClass="data-visual-devexpress-editor">
                                        <ItemDisplayTemplate>@LT(Friendly(context.DataItem.ToString()))</ItemDisplayTemplate>
                                    </DxComboBox>
                                </label>
                                <div class="chart-mapping-advice"><strong>@LT("Mapping check")</strong><span>@LT(MappingAdvice)</span><DxButton Text='@LT("Auto-map")' Click="AutoMapFields" /></div>
                            </div>

                            <fieldset class="value-field-picker">
                                <legend>@LT(AllowsMultipleValueFields ? "Data fields" : "Data field")</legend>
                                @foreach (var column in MeasureColumns)
                                {
                                    <label class="check-row">
                                        <DxCheckBox Checked="@_draft.ValueFields.Contains(column.Name, StringComparer.OrdinalIgnoreCase)"
                                                    CheckedChanged="@((bool value) => ToggleValueField(column.Name, new ChangeEventArgs { Value = value }))" />
                                        @column.Name <small>@LT(Friendly(column.ValueKind.ToString()))</small>
                                    </label>
                                }
                                @if (MeasureColumns.Count == 0)
                                {
                                    <small>@LT("No field was detected in this data object.")</small>
                                }
                                else
                                {
                                    <small class="field-measure-help">@LT("Numbers are plotted directly, Boolean values use 1/0, and non-empty text or date values count as 1.")</small>
                                }
                            </fieldset>
                        }

                        @if (_draft.VisualKind == DataVisualKind.CartesianChart)
                        {
                            <label>@LT("Chart subtype")
                                <DxComboBox Data="@CartesianStyleOptions"
                                            Value="@_draft.CartesianStyle"
                                            ValueChanged="@((CartesianChartStyle value) => ChangeCartesianStyle(new ChangeEventArgs { Value = value.ToString() }))"
                                            CssClass="data-visual-devexpress-editor">
                                    <ItemDisplayTemplate>@LT(Friendly(context.DataItem.ToString()))</ItemDisplayTemplate>
                                </DxComboBox>
                            </label>
                        }
                        else if (_draft.VisualKind == DataVisualKind.PieChart)
                        {
                            <label>@LT("Pie subtype")
                                <DxComboBox Data="@PieStyleOptions"
                                            Value="@_draft.PieStyle"
                                            ValueChanged="@((PieChartStyle value) => ChangePieStyle(new ChangeEventArgs { Value = value.ToString() }))"
                                            CssClass="data-visual-devexpress-editor">
                                    <ItemDisplayTemplate>@LT(Friendly(context.DataItem.ToString()))</ItemDisplayTemplate>
                                </DxComboBox>
                            </label>
                        }
                        else if (_draft.VisualKind == DataVisualKind.PolarChart)
                        {
                            <label>@LT("Polar subtype")
                                <DxComboBox Data="@PolarStyleOptions"
                                            Value="@_draft.PolarStyle"
                                            ValueChanged="@((PolarChartStyle value) => ChangePolarStyle(new ChangeEventArgs { Value = value.ToString() }))"
                                            CssClass="data-visual-devexpress-editor">
                                    <ItemDisplayTemplate>@LT(Friendly(context.DataItem.ToString()))</ItemDisplayTemplate>
                                </DxComboBox>
                            </label>
                        }
                        else if (_draft.VisualKind == DataVisualKind.Sparkline)
                        {
                            <label>@LT("Sparkline subtype")
                                <DxComboBox Data="@SparklineStyleOptions"
                                            Value="@_draft.SparklineStyle"
                                            ValueChanged="@((SparklineChartStyle value) => ChangeSparklineStyle(new ChangeEventArgs { Value = value.ToString() }))"
                                            CssClass="data-visual-devexpress-editor">
                                    <ItemDisplayTemplate>@LT(Friendly(context.DataItem.ToString()))</ItemDisplayTemplate>
                                </DxComboBox>
                            </label>
                        }

                        @if (_draft.VisualKind == DataVisualKind.CartesianChart && (_draft.CartesianStyle is CartesianChartStyle.RangeArea or CartesianChartStyle.RangeBar))
                        {
                            <div class="data-form-grid">
                                <label>@LT("Low value")<DxComboBox Data="@NumericColumns" Value="@_draft.LowValueField" ValueChanged="@((string? value) => ChangeLowValueField(new ChangeEventArgs { Value = value }))" TextFieldName="@nameof(PublicationDataColumn.Name)" ValueFieldName="@nameof(PublicationDataColumn.Name)" CssClass="data-visual-devexpress-editor" /></label>
                                <label>@LT("High value")<DxComboBox Data="@NumericColumns" Value="@_draft.HighValueField" ValueChanged="@((string? value) => ChangeHighValueField(new ChangeEventArgs { Value = value }))" TextFieldName="@nameof(PublicationDataColumn.Name)" ValueFieldName="@nameof(PublicationDataColumn.Name)" CssClass="data-visual-devexpress-editor" /></label>
                            </div>
                        }
                        @if (_draft.VisualKind == DataVisualKind.CartesianChart && _draft.CartesianStyle == CartesianChartStyle.Bubble)
                        {
                            <label>@LT("Bubble size")<DxComboBox Data="@NumericColumns" Value="@_draft.SizeField" ValueChanged="@((string? value) => ChangeSizeField(new ChangeEventArgs { Value = value }))" TextFieldName="@nameof(PublicationDataColumn.Name)" ValueFieldName="@nameof(PublicationDataColumn.Name)" CssClass="data-visual-devexpress-editor" /></label>
                        }
                        @if (_draft.VisualKind == DataVisualKind.CartesianChart && (_draft.CartesianStyle is CartesianChartStyle.Candlestick or CartesianChartStyle.Stock))
                        {
                            <div class="data-form-grid financial-field-grid">
                                <label>@LT("Open")<DxComboBox Data="@NumericColumns" Value="@_draft.OpenValueField" ValueChanged="@((string? value) => ChangeOpenValueField(new ChangeEventArgs { Value = value }))" TextFieldName="@nameof(PublicationDataColumn.Name)" ValueFieldName="@nameof(PublicationDataColumn.Name)" CssClass="data-visual-devexpress-editor" /></label>
                                <label>@LT("High")<DxComboBox Data="@NumericColumns" Value="@_draft.HighValueField" ValueChanged="@((string? value) => ChangeHighValueField(new ChangeEventArgs { Value = value }))" TextFieldName="@nameof(PublicationDataColumn.Name)" ValueFieldName="@nameof(PublicationDataColumn.Name)" CssClass="data-visual-devexpress-editor" /></label>
                                <label>@LT("Low")<DxComboBox Data="@NumericColumns" Value="@_draft.LowValueField" ValueChanged="@((string? value) => ChangeLowValueField(new ChangeEventArgs { Value = value }))" TextFieldName="@nameof(PublicationDataColumn.Name)" ValueFieldName="@nameof(PublicationDataColumn.Name)" CssClass="data-visual-devexpress-editor" /></label>
                                <label>@LT("Close")<DxComboBox Data="@NumericColumns" Value="@_draft.CloseValueField" ValueChanged="@((string? value) => ChangeCloseValueField(new ChangeEventArgs { Value = value }))" TextFieldName="@nameof(PublicationDataColumn.Name)" ValueFieldName="@nameof(PublicationDataColumn.Name)" CssClass="data-visual-devexpress-editor" /></label>
                            </div>
                        }
                        @if (_draft.VisualKind == DataVisualKind.Sankey)
                        {
                            <label>@LT("Target node")<DxComboBox Data="@Columns" Value="@_draft.TargetField" ValueChanged="@((string? value) => ChangeTargetField(new ChangeEventArgs { Value = value }))" TextFieldName="@nameof(PublicationDataColumn.Name)" ValueFieldName="@nameof(PublicationDataColumn.Name)" CssClass="data-visual-devexpress-editor" /></label>
                        }
                        @if (_draft.VisualKind == DataVisualKind.TreeMap)
                        {
                            <label>@LT("Parent field (optional)")<DxComboBox Data="@Columns" Value="@_draft.ParentField" ValueChanged="@((string? value) => ChangeParentField(new ChangeEventArgs { Value = value }))" TextFieldName="@nameof(PublicationDataColumn.Name)" ValueFieldName="@nameof(PublicationDataColumn.Name)" NullText='@LT("None")' ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="data-visual-devexpress-editor" /></label>
                        }

                        @if (_draft.VisualKind is DataVisualKind.BarGauge or DataVisualKind.CircularGauge or DataVisualKind.LinearGauge or DataVisualKind.KpiProgress)
                        {
                            <div class="data-form-grid">
                                <label>@LT("Minimum")<DxSpinEdit T="double" Value="@_draft.MinimumValue" ValueChanged="@((double value) => ChangeMinimum(new ChangeEventArgs { Value = value }))" CssClass="data-visual-devexpress-editor" /></label>
                                <label>@LT("Maximum")<DxSpinEdit T="double" Value="@_draft.MaximumValue" ValueChanged="@((double value) => ChangeMaximum(new ChangeEventArgs { Value = value }))" CssClass="data-visual-devexpress-editor" /></label>
                            </div>
                        }
                        @if (_draft.VisualKind == DataVisualKind.DataTable)
                        {
                            <div class="data-form-grid">
                                <label>@LT("Maximum rows")<DxSpinEdit T="int" MinValue="1" MaxValue="100" Value="@_draft.RowLimit" ValueChanged="@((int value) => ChangeRowLimit(new ChangeEventArgs { Value = value }))" CssClass="data-visual-devexpress-editor" /></label>
                                <label class="check-row"><DxCheckBox Checked="@_draft.TableShowFilterRow" CheckedChanged="@((bool value) => ToggleFilterRow(new ChangeEventArgs { Value = value }))" /> @LT("Interactive filter row")</label>
                            </div>
                        }

                        <div class="visual-option-grid">
                            <label class="check-row"><DxCheckBox Checked="@_draft.ShowTitle" CheckedChanged="@((bool value) => ToggleTitle(new ChangeEventArgs { Value = value }))" /> @LT("Show title")</label>
                            @if (_draft.VisualKind is DataVisualKind.CartesianChart or DataVisualKind.PieChart or DataVisualKind.PolarChart or DataVisualKind.BarGauge or DataVisualKind.Sankey)
                            {
                                <label class="check-row"><DxCheckBox Checked="@_draft.ShowLegend" CheckedChanged="@((bool value) => ToggleLegend(new ChangeEventArgs { Value = value }))" /> @LT("Show legend")</label>
                            }
                            @if (_draft.VisualKind is DataVisualKind.PieChart or DataVisualKind.PolarChart or DataVisualKind.Sankey or DataVisualKind.Funnel or DataVisualKind.Pyramid)
                            {
                                <label class="check-row"><DxCheckBox Checked="@_draft.ShowLabels" CheckedChanged="@((bool value) => ToggleLabels(new ChangeEventArgs { Value = value }))" /> @LT("Show point labels")</label>
                            }
                        </div>
                    }
                </main>

                <DxFormLayout CssClass="razor-section-layout-owner">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext003">
        <div class="visual-live-preview">
                    <div class="pane-heading"><strong>@LT("Live preview")</strong><span>@CurrentData?.Name</span></div>
                    <div class="visual-preview-frame"
                         tabindex="0"
                         title='@LT("Right-click for visual commands")'
                         @oncontextmenu="ShowVisualContextMenu"
                         @oncontextmenu:preventDefault
                         @oncontextmenu:stopPropagation>
                        <DataVisualView Document="State.Document" Item="_draft" CurrentPageId="State.SelectedPageId" />
                    </div>
                    <p>@LT("Visuals remain live DevExpress components on the publication canvas. Web bindings are refreshed by the local monolith and standalone HTML can optionally continue polling with embedded JavaScript.")</p>
                </div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
            </div>

            <footer>
                <span>@ValidationText</span>
                <div><DxButton Text='@LT("Cancel")' Click="Cancel" /><DxButton Text='@LT("Apply to object")' Click="Save" RenderStyle="ButtonRenderStyle.Primary" Enabled="@CanSave" /></div>
            </footer>
        </div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
        </BodyContentTemplate>
</DxPopup>

    <DxContextMenu @ref="_visualContextMenu">
        <Items>
            <DxContextMenuItem Text='@LT("Apply changes")' IconCssClass="pub-icon pub-icon-edit" Enabled="@CanSave" Click="Save" />
            <DxContextMenuItem Text='@LT("Refresh live data")' IconCssClass="pub-icon pub-icon-data" Click="Refresh" />
            <DxContextMenuItem Text='@LT("Manage publication data…")' IconCssClass="pub-icon pub-icon-data" Click="RequestManage" />
            <DxContextMenuItem Text='@LT("Visual type")' BeginGroup="true">
                <Items>
                    <DxContextMenuItem Text="@(CheckedText(_draft.VisualKind == DataVisualKind.CartesianChart, KindName(DataVisualKind.CartesianChart)))" Click="SetCartesianChart" />
                    <DxContextMenuItem Text="@(CheckedText(_draft.VisualKind == DataVisualKind.PieChart, KindName(DataVisualKind.PieChart)))" Click="SetPieChart" />
                    <DxContextMenuItem Text="@(CheckedText(_draft.VisualKind == DataVisualKind.PolarChart, KindName(DataVisualKind.PolarChart)))" Click="SetPolarChart" />
                    <DxContextMenuItem Text="@(CheckedText(_draft.VisualKind == DataVisualKind.Sparkline, KindName(DataVisualKind.Sparkline)))" Click="SetSparkline" />
                    <DxContextMenuItem Text="@(CheckedText(_draft.VisualKind == DataVisualKind.BarGauge, KindName(DataVisualKind.BarGauge)))" Click="SetBarGauge" />
                    <DxContextMenuItem Text="@(CheckedText(_draft.VisualKind == DataVisualKind.CircularGauge, KindName(DataVisualKind.CircularGauge)))" Click="SetCircularGauge" />
                    <DxContextMenuItem Text="@(CheckedText(_draft.VisualKind == DataVisualKind.LinearGauge, KindName(DataVisualKind.LinearGauge)))" Click="SetLinearGauge" />
                    <DxContextMenuItem Text="@(CheckedText(_draft.VisualKind == DataVisualKind.RangeSelector, KindName(DataVisualKind.RangeSelector)))" Click="SetRangeSelector" />
                    <DxContextMenuItem Text="@(CheckedText(_draft.VisualKind == DataVisualKind.Sankey, KindName(DataVisualKind.Sankey)))" Click="SetSankey" />
                    <DxContextMenuItem Text="@(CheckedText(_draft.VisualKind == DataVisualKind.Funnel, KindName(DataVisualKind.Funnel)))" Click="SetFunnel" />
                    <DxContextMenuItem Text="@(CheckedText(_draft.VisualKind == DataVisualKind.Pyramid, KindName(DataVisualKind.Pyramid)))" Click="SetPyramid" />
                    <DxContextMenuItem Text="@(CheckedText(_draft.VisualKind == DataVisualKind.TreeMap, KindName(DataVisualKind.TreeMap)))" Click="SetTreeMap" />
                    <DxContextMenuItem Text="@(CheckedText(_draft.VisualKind == DataVisualKind.DataTable, KindName(DataVisualKind.DataTable)))" Click="SetDataTable" />
                    <DxContextMenuItem Text="@(CheckedText(_draft.VisualKind == DataVisualKind.KpiProgress, KindName(DataVisualKind.KpiProgress)))" Click="SetKpiProgress" />
                </Items>
            </DxContextMenuItem>
            <DxContextMenuItem Text="@(CheckedText(_draft.ShowTitle, LT("Show title")))" Click="ToggleTitleMenu" />
            @if (_draft.VisualKind is DataVisualKind.CartesianChart or DataVisualKind.PieChart or DataVisualKind.PolarChart or DataVisualKind.BarGauge or DataVisualKind.Sankey)
            {
                <DxContextMenuItem Text="@(CheckedText(_draft.ShowLegend, LT("Show legend")))" Click="ToggleLegendMenu" />
            }
            @if (_draft.VisualKind is DataVisualKind.PieChart or DataVisualKind.PolarChart or DataVisualKind.Sankey or DataVisualKind.Funnel or DataVisualKind.Pyramid)
            {
                <DxContextMenuItem Text="@(CheckedText(_draft.ShowLabels, LT("Show point labels")))" Click="ToggleLabelsMenu" />
            }
            @if (_draft.VisualKind == DataVisualKind.DataTable)
            {
                <DxContextMenuItem Text="@(CheckedText(_draft.TableShowFilterRow, LT("Interactive filter row")))" Click="ToggleFilterRowMenu" />
            }
            <DxContextMenuItem Text='@LT("Reset visual options")' BeginGroup="true" Click="ResetVisualOptions" />
        </Items>
    </DxContextMenu>
}
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
</div>


@code {

    /// <summary>
    /// Gets or sets a value indicating whether the value is visible applies to the data visual editor state.
    /// </summary>
    /// <value>The visible value exposed by <see cref="DataVisualEditor"/>.</value>
    [Parameter] public bool Visible { get; set; }
    /// <summary>
    /// Gets or sets the state value that forms part of the data visual editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The state value exposed by <see cref="DataVisualEditor"/>.</value>
    [Parameter, EditorRequired] public EditorStateService State { get; set; } = default!;
    /// <summary>
    /// Gets or sets the saved value that forms part of the data visual editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The saved value exposed by <see cref="DataVisualEditor"/>.</value>
    [Parameter] public EventCallback Saved { get; set; }
    /// <summary>
    /// Gets or sets the cancelled value that forms part of the data visual editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The cancelled value exposed by <see cref="DataVisualEditor"/>.</value>
    [Parameter] public EventCallback Cancelled { get; set; }
    /// <summary>
    /// Gets or sets the manage data requested value that forms part of the data visual editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The manage data requested value exposed by <see cref="DataVisualEditor"/>.</value>
    [Parameter] public EventCallback ManageDataRequested { get; set; }

    /// <summary>
    /// Stores the internal visual context menu state used by <see cref="DataVisualEditor"/> while executing its surrounding workflow.
    /// </summary>
    private DxContextMenu _visualContextMenu = default!;
    /// <summary>
    /// Stores the internal was visible state used by <see cref="DataVisualEditor"/> while executing its surrounding workflow.
    /// </summary>
    private bool _wasVisible;
    /// <summary>
    /// Stores the internal target identifier state used by <see cref="DataVisualEditor"/> while executing its surrounding workflow.
    /// </summary>
    private Guid? _targetId;
    /// <summary>
    /// Stores the internal draft state used by <see cref="DataVisualEditor"/> while executing its surrounding workflow.
    /// </summary>
    private DataVisualElement? _draft;
    /// <summary>Gets the stable argument-mode options bound to the DevExpress combo box.</summary>
    /// <value>The argument-mode options prepared outside Razor attribute syntax.</value>
    private IReadOnlyList<DataVisualArgumentMode> ArgumentModeOptions { get; } = Enum.GetValues<DataVisualArgumentMode>();
    /// <summary>Gets the stable aggregation-mode options bound to the DevExpress combo box.</summary>
    /// <value>The aggregation-mode options prepared outside Razor attribute syntax.</value>
    private IReadOnlyList<DataVisualAggregationMode> AggregationModeOptions { get; } = Enum.GetValues<DataVisualAggregationMode>();
    /// <summary>Gets the stable sort-mode options bound to the DevExpress combo box.</summary>
    /// <value>The sort-mode options prepared outside Razor attribute syntax.</value>
    private IReadOnlyList<DataVisualSortMode> SortModeOptions { get; } = Enum.GetValues<DataVisualSortMode>();
    /// <summary>Gets the stable Cartesian chart-style options bound to the DevExpress combo box.</summary>
    /// <value>The Cartesian chart-style options prepared outside Razor attribute syntax.</value>
    private IReadOnlyList<CartesianChartStyle> CartesianStyleOptions { get; } = Enum.GetValues<CartesianChartStyle>();
    /// <summary>Gets the stable pie chart-style options bound to the DevExpress combo box.</summary>
    /// <value>The pie chart-style options prepared outside Razor attribute syntax.</value>
    private IReadOnlyList<PieChartStyle> PieStyleOptions { get; } = Enum.GetValues<PieChartStyle>();
    /// <summary>Gets the stable polar chart-style options bound to the DevExpress combo box.</summary>
    /// <value>The polar chart-style options prepared outside Razor attribute syntax.</value>
    private IReadOnlyList<PolarChartStyle> PolarStyleOptions { get; } = Enum.GetValues<PolarChartStyle>();
    /// <summary>Gets the stable sparkline chart-style options bound to the DevExpress combo box.</summary>
    /// <value>The sparkline chart-style options prepared outside Razor attribute syntax.</value>
    private IReadOnlyList<SparklineChartStyle> SparklineStyleOptions { get; } = Enum.GetValues<SparklineChartStyle>();

    /// <summary>
    /// Gets the current data value that forms part of the data visual editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The current data value exposed by <see cref="DataVisualEditor"/>.</value>
    private PublicationDataObject? CurrentData => GetCurrentDataForRender();
    /// <summary>
    /// Gets the columns collection maintained or exposed by this data visual editor instance for downstream processing.
    /// </summary>
    /// <value>The columns value exposed by <see cref="DataVisualEditor"/>.</value>
    private IReadOnlyList<PublicationDataColumn> Columns => GetColumnsForRender();
    /// <summary>
    /// Gets the measure columns collection maintained or exposed by this data visual editor instance for downstream processing.
    /// </summary>
    /// <value>The measure columns value exposed by <see cref="DataVisualEditor"/>.</value>
    private IReadOnlyList<PublicationDataColumn> MeasureColumns => GetMeasureColumnsForRender();
    /// <summary>
    /// Gets the numeric columns collection maintained or exposed by this data visual editor instance for downstream processing.
    /// </summary>
    /// <value>The numeric columns value exposed by <see cref="DataVisualEditor"/>.</value>
    private IReadOnlyList<PublicationDataColumn> NumericColumns => GetNumericColumnsForRender();
    /// <summary>
    /// Gets a value indicating whether allows multiple value fields applies to the data visual editor state.
    /// </summary>
    /// <value>The allows multiple value fields value exposed by <see cref="DataVisualEditor"/>.</value>
    private bool AllowsMultipleValueFields => GetAllowsMultipleValueFieldsForRender();
    /// <summary>
    /// Gets a value indicating whether aggregation applies to the data visual editor state.
