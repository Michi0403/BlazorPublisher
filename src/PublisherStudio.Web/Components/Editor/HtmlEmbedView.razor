@namespace PublisherStudio.Components.Editor

@inject ILogger<HtmlEmbedView> Logger
@inject PublicationEditorTextService EditorText
<div class="publication-html-embed-shell @(DesignerMode ? "designer-object-mode" : "interaction-mode")">
    <iframe class="publication-html-embed"
            title="@Item.Name"
            sandbox="@Item.Sandbox"
            srcdoc="@SourceDocument"
            loading="eager"
            referrerpolicy="no-referrer"
            style="background:@Item.Background"></iframe>
    @if (DesignerMode)
    {
        <div class="publication-html-design-shield"
             data-designer-object-shield
             title="Arrange web content. Double-click to edit; use preview mode to interact."
             aria-label="Arrange @Item.Name"></div>
    }
</div>

@code {

    /// <summary>
    /// Gets or sets the item value that forms part of the HTML embed view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The item value exposed by <see cref="HtmlEmbedView"/>.</value>
    [Parameter, EditorRequired] public HtmlEmbedElement Item { get; set; } = default!;
    /// <summary>
    /// Gets or sets a value indicating whether designer mode applies to the HTML embed view state.
    /// </summary>
    /// <value>The designer mode value exposed by <see cref="HtmlEmbedView"/>.</value>
    [Parameter] public bool DesignerMode { get; set; }

    /// <summary>
    /// Gets the source document value that forms part of the HTML embed view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The source document value exposed by <see cref="HtmlEmbedView"/>.</value>
    private string SourceDocument
    {
        get
        {
            var script = Item.AllowScripts && !string.IsNullOrWhiteSpace(Item.JavaScript)
                ? $"<script>{SafeScript(Item.JavaScript)}</script>"
                : string.Empty;
            return $"<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>{Item.Css}</style></head><body>{Item.Html}{script}</body></html>";
        }
    }

    /// <summary>
    /// Performs safe script for <see cref="HtmlEmbedView"/>, keeping the operation consistent with the state and invariants of the surrounding HTML embed view workflow.
    /// </summary>
    /// <param name="value">Value value supplied to the HTML embed view operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string SafeScript(string value) {
        try
        {
            return EditorText.EscapeEmbeddedScriptClosingTag(value);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(HtmlEmbedView)}.{nameof(SafeScript)} failed.");
            throw;
        }
    }

}
