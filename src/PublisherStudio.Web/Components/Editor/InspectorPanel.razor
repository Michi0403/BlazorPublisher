    /// <summary>
    /// Refreshes streaming device profiles for <see cref="InspectorPanel"/>, keeping the operation consistent with the state and invariants of the surrounding inspector panel workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task RefreshStreamingDeviceProfiles()
    {
        try
        {
            var machine = await StreamingProfiles.LoadAsync().ConfigureAwait(true);
            _streamingDeviceProfiles = machine.Devices
                .OrderBy(profile => profile.Kind)
                .ThenBy(profile => profile.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            _streamingProfilesLoaded = true;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(InspectorPanel)}.{nameof(RefreshStreamingDeviceProfiles)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs change live device profile for <see cref="InspectorPanel"/>, keeping the operation consistent with the state and invariants of the surrounding inspector panel workflow.
    /// </summary>
    /// <param name="args">Args value supplied to the inspector panel operation and used when producing its result.</param>
    private void ChangeLiveDeviceProfile(ChangeEventArgs args)
    {
        try
        {
            var id = ParseGuid(args);
            if (id is null)
            {
                UpdateLiveSource(source => source.DeviceProfileId = null);
                return;
            }

            var profile = _streamingDeviceProfiles.FirstOrDefault(item => item.Id == id.Value);
            if (profile is null) return;
            UpdateLiveSource(source =>
            {
                source.DeviceProfileId = profile.Id;
                source.SourceKind = profile.Kind;
                source.DeviceId = profile.DeviceId;
                source.AudioDeviceId = profile.AudioDeviceId;
                source.ApplicationId = profile.ApplicationId;
                source.WindowTitle = profile.WindowTitle;
                source.CaptureBackend = profile.CaptureBackend;
                source.NativeBackend = profile.NativeBackend;
                source.UseDeviceTimestamp = profile.UseDeviceTimestamps;
            });
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(InspectorPanel)}.{nameof(ChangeLiveDeviceProfile)} failed.");
            throw;
        }
    }

