    /// <summary>
    /// Imports word art picture for <see cref="InspectorPanel"/>, keeping the operation consistent with the state and invariants of the surrounding inspector panel workflow.
    /// </summary>
    /// <param name="args">Input file change event args dependency used by the inspector panel workflow to provide the corresponding application capability.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ImportWordArtPicture(InputFileChangeEventArgs args)
    {
        try
        {
            var file = args.File;
            var mimeType = PictureMimeType(file.Name, file.ContentType);
            if (string.IsNullOrWhiteSpace(mimeType)) return;
            var input = file.OpenReadStream(long.MaxValue);
            await using var configuredInputAsyncDisposal = input.ConfigureAwait(true);
            using var buffer = new MemoryStream();
            await input.CopyToAsync(buffer).ConfigureAwait(true);
            var bytes = buffer.ToArray();
            if (mimeType == "image/svg+xml")
            {
                var sourceSvg = new UTF8Encoding(false, true).GetString(bytes);
                bytes = Encoding.UTF8.GetBytes(SvgSanitizer.Sanitize(sourceSvg));
            }
            var dataUrl = $"data:{mimeType};base64,{Convert.ToBase64String(bytes)}";
            SetWordArt(item =>
            {
                item.FillKind = WordArtFillKind.Picture;
                item.GradientFill = false;
                item.FillMediaDataUrl = dataUrl;
                item.FillMediaMimeType = mimeType;
                item.FillMediaPosterDataUrl = string.Empty;
            });
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(InspectorPanel)}.{nameof(ImportWordArtPicture)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Imports word art video for <see cref="InspectorPanel"/>, keeping the operation consistent with the state and invariants of the surrounding inspector panel workflow.
    /// </summary>
    /// <param name="args">Input file change event args dependency used by the inspector panel workflow to provide the corresponding application capability.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ImportWordArtVideo(InputFileChangeEventArgs args)
    {
        try
        {
            var file = args.File;
            var mimeType = VideoMimeType(file.Name, file.ContentType);
            if (string.IsNullOrWhiteSpace(mimeType)) return;
            var input = file.OpenReadStream(long.MaxValue);
            await using var configuredInputAsyncDisposal = input.ConfigureAwait(true);
            using var buffer = new MemoryStream();
            await input.CopyToAsync(buffer).ConfigureAwait(true);
            var bytes = buffer.ToArray();
            var dataUrl = $"data:{mimeType};base64,{Convert.ToBase64String(bytes)}";
            var inspectionId = Guid.NewGuid();
            var poster = string.Empty;
            try
            {
                _mediaModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/mediaStudioInterop.js?v=3.1.5").ConfigureAwait(true);
                var localUrl = MediaAssets.RegisterBytes(inspectionId, bytes, mimeType);
                try
                {
                    var info = await _mediaModule.InvokeAsync<MediaSourceInfo>("inspectMediaDataUrl", localUrl, "video").ConfigureAwait(true);
                    poster = info.PosterDataUrl ?? string.Empty;
                }
                catch (JSException)
                {
                    // Keep the playable fill even when this browser cannot decode a representative poster frame.
                    poster = string.Empty;
                }
            }
            finally
            {
                MediaAssets.Remove(inspectionId);
            }
            SetWordArt(item =>
            {
                item.FillKind = WordArtFillKind.Video;
                item.GradientFill = false;
                item.FillMediaDataUrl = dataUrl;
                item.FillMediaMimeType = mimeType;
                item.FillMediaPosterDataUrl = poster;
                item.FillMediaLoop = true;
            });
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(InspectorPanel)}.{nameof(ImportWordArtVideo)} failed.");
            throw;
        }
    }

