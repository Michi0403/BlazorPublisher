    /// <summary>Recursively exposes Panel Studio children to the same signal target catalog used by top-level publication objects.</summary>
    /// <param name="element">Top-level or nested publication element.</param>
    /// <returns>The element and every nested panel child.</returns>
    private IReadOnlyList<PublicationElement> FlattenSignalTarget(PublicationElement element)
    {
        try
        {
            Logger.LogTrace("Collecting signal targets from publication element {ElementId}.", element.Id);
            var result = new List<PublicationElement> { element };
            if (element is not PanelElement panel) return result;
            foreach (var view in panel.Views)
            foreach (var child in view.Elements)
                result.AddRange(FlattenSignalTarget(child));
            return result;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Collecting signal targets from publication element {ElementId} failed.", element.Id);
            throw;
        }
    }

    /// <summary>Returns the maintained public object methods appropriate to the selected signal completion target.</summary>
    /// <param name="connector">Signal connector being edited.</param>
    /// <returns>Allow-listed methods supported by the target object.</returns>
    private IReadOnlyList<string> SignalCompletionMethods(ConnectorElement connector)
    {
        try
        {
            var targetId = connector.Signal.CompletionTargetElementId;
            if (targetId is null && connector.Target.Kind == ConnectorEndpointKind.Element) targetId = connector.Target.ElementId;
            var target = targetId is { } id ? SignalTargetElements(connector).FirstOrDefault(item => item.Id == id) : null;
            return target is null
                ? ["click", "focus", "blur", "change", "show", "hide", "toggleVisibility"]
                : Behaviors.CommonMethods(target);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(InspectorPanel)}.{nameof(SignalCompletionMethods)} failed.");
            throw;
        }
    }

    /// <summary>Keeps a signal Call Method selection valid after the action or completion target changes.</summary>
    /// <param name="connector">Signal connector being edited.</param>
    private void NormalizeSignalCompletionMethod(ConnectorElement connector)
    {
        try
        {
            Logger.LogTrace("Normalizing signal completion method for connector {ConnectorId}.", connector.Id);
            if (connector.Signal.CompletionAction != SignalCompletionAction.CallMethod) return;
            var methods = SignalCompletionMethods(connector);
            if (methods.Count == 0)
            {
                connector.Signal.CompletionMethod = string.Empty;
                return;
            }
            if (!methods.Contains(connector.Signal.CompletionMethod, StringComparer.OrdinalIgnoreCase))
                connector.Signal.CompletionMethod = methods[0];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Normalizing signal completion method for connector {ConnectorId} failed.", connector.Id);
            throw;
        }
    }

