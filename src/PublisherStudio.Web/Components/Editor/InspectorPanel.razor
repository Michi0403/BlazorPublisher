@namespace PublisherStudio.Components.Editor
@using PublisherStudio.Services.PictureStudio.Import
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject StreamingProfileStore StreamingProfiles
@inject PublicationMediaAssetStore MediaAssets
@inject PublisherStudio.Services.MediaStudio.UseCases.MediaTimelineEditService TimelineEdits
@inject PublisherStudio.Services.Configuration.IFileLocalizationService Localization
@inject NavigationManager Navigation
@inject PublicationComponentService Components
@inject PublicationBehaviorService Behaviors
@inject IPagePresetCatalog PagePresets

@inject ILogger<InspectorPanel> Logger
<aside class="inspector-panel">
    <div class="inspector-tabs four">
        <button class="@PropertiesTabClass" @onclick="ShowProperties">@LT("Properties")</button>
        <button class="@PageTabClass" @onclick="ShowPage">@LT("Page")</button>
        <button class="@LayersTabClass" @onclick="ShowLayers">@LT("Layers")</button>
        <button class="@AnimationsTabClass" @onclick="ShowAnimations">@LT("Animations")</button>
    </div>

    @if (_tab == "animations")
    {
        <AnimationPanel State="State" />
    }
    else if (_tab == "layers")
    {
        <div class="layers-panel">
            <div class="layer-help"><strong>@LT("Objects are layers")</strong><span>@LT("Higher rows appear in front. Drag rows to reorder layers; use the eye and lock buttons per object.")</span></div>
            <div class="layer-create-bar">
                <button title='@LT("Add text box")' @onclick="AddText"><i class="pub-icon pub-icon-text" aria-hidden="true"></i></button>
                <button title='@LT("Add WordArt")' @onclick="AddWordArt"><i class="pub-icon pub-icon-wordart" aria-hidden="true"></i></button>
                <button title='@LT("Add picture")' @onclick="RequestInsertPicture"><i class="pub-icon pub-icon-picture" aria-hidden="true"></i></button>
                <button title='@LT("Create picture in Picture Studio")' @onclick="RequestCreatePicture"><i class="pub-icon pub-icon-create-picture" aria-hidden="true"></i></button>
                <button title='@LT("Open spreadsheet")' @onclick="RequestInsertSpreadsheet"><i class="pub-icon pub-icon-spreadsheet" aria-hidden="true"></i></button>
                <button title='@LT("Create spreadsheet")' @onclick="RequestCreateSpreadsheet"><i class="pub-icon pub-icon-spreadsheet" aria-hidden="true"></i></button>
                <button title='@LT("Insert video")' @onclick="RequestInsertVideo"><i class="pub-icon pub-icon-video" aria-hidden="true"></i></button>
                <button title='@LT("Insert audio")' @onclick="RequestInsertAudio"><i class="pub-icon pub-icon-audio" aria-hidden="true"></i></button>
                <button title='@LT("Create video")' @onclick="RequestCreateVideo"><i class="pub-icon pub-icon-video" aria-hidden="true"></i></button>
                <button title='@LT("Create audio")' @onclick="RequestCreateAudio"><i class="pub-icon pub-icon-audio" aria-hidden="true"></i></button>
                <button title='@LT("Add rectangle")' @onclick="AddRectangle"><i class="pub-icon pub-icon-rectangle" aria-hidden="true"></i></button>
                <button title='@LT("Insert chart")' @onclick="AddChart"><i class="pub-icon pub-icon-chart" aria-hidden="true"></i></button>
                <button title='@LT("Insert professional Data Grid")' @onclick="AddComponentDataGrid"><i class="pub-icon pub-icon-data" aria-hidden="true"></i></button>
                <button title='@LT("Insert reusable panel or dashboard")' @onclick="RequestInsertPanel"><i class="pub-icon pub-icon-panel" aria-hidden="true"></i></button>
                <button title='@LT("Open Media Converter Studio")' @onclick="RequestMediaConverter"><i class="pub-icon pub-icon-media" aria-hidden="true"></i></button>
                <button title='@LT("Draw connector: click, then drag between object ports")' @onclick="StartConnector"><i class="pub-icon pub-icon-connector" aria-hidden="true"></i></button>
                <button title='@LT("Delete selected layer")' disabled="@(State.SelectedElement is null || State.SelectedElement.Locked)" @onclick="State.DeleteSelected"><i class="pub-icon pub-icon-delete" aria-hidden="true"></i></button>
            </div>
            <div class="layer-arrange-bar">
                <button title='@LT("Bring to front")' disabled="@(State.SelectedElement is null)" @onclick="State.BringToFront">@LT("Front")</button>
                <button title='@LT("Bring forward")' disabled="@(State.SelectedElement is null)" @onclick="State.BringForward">@LT("Up")</button>
                <button title='@LT("Send backward")' disabled="@(State.SelectedElement is null)" @onclick="State.SendBackward">@LT("Down")</button>
                <button title='@LT("Send to back")' disabled="@(State.SelectedElement is null)" @onclick="State.SendToBack">@LT("Back")</button>
            </div>
            <div class="layers-list">
                @foreach (var item in State.CurrentPage.Elements.OrderByDescending(element => element.ZIndex))
                {
                    <div class="layer-row @(State.IsSelected(item.Id) ? "selected" : null) @(item.Id == State.SelectedElementId ? "selection-primary" : null) @(_draggedLayerId == item.Id ? "layer-dragging" : null) @(_layerDropTargetId == item.Id ? "layer-drop-target" : null)"
                         draggable="true"
                         @ondragstart="() => BeginLayerDrag(item)"
                         @ondragenter="() => EnterLayerDropTarget(item)"
                         @ondragover:preventDefault
                         @ondrop="() => DropLayer(item)"
                         @ondragend="EndLayerDrag"
                         @oncontextmenu="args => ShowLayerContextMenu(item, args)" @oncontextmenu:preventDefault>
                        <button class="layer-select" title="@($"{LT("Select")} {item.Name}")" @onclick="args => SelectLayer(item, args)">
                            <span class="layer-drag-handle" title='@LT("Drag to reorder layer")' aria-hidden="true">⋮⋮</span>
                            <span class="layer-kind"><i class="@KindIconCss(item)" aria-hidden="true"></i></span>
                            <span class="layer-name">@item.Name</span>
                        </button>
                        <button class="layer-toggle @(item.Visible ? "active" : null)" title="@(item.Visible ? LT("Hide") : LT("Show"))" @onclick="() => ToggleLayerVisibility(item)"><i class="pub-icon pub-icon-visible" aria-hidden="true"></i></button>
                        <button class="layer-toggle @(item.Locked ? "active" : null)" title="@(item.Locked ? LT("Unlock") : LT("Lock"))" @onclick="() => ToggleLayerLock(item)"><i class="pub-icon pub-icon-lock" aria-hidden="true"></i></button>
                    </div>
                }
                @if (State.CurrentPage.Elements.Count == 0)
                {
                    <div class="empty-panel">@LT("This page has no objects.")</div>
                }
            </div>
        </div>
    }
    else if (_tab == "page")
    {
        <div class="property-scroll">
            <section class="property-section">
                <h3>@LT("View language")</h3>
                <label>@LT("Application language")
                    <select value="@ApplicationCulture" @onchange="ChangeApplicationCulture">
                        @foreach (var culture in Localization.GetAvailableCultures())
                        {
                            <option value="@culture">@CultureLabel(culture)</option>
                        }
                    </select>
                </label>
                <label>@LT("Publication language")
                    <select value="@PublicationCulture" @onchange="ChangePublicationCulture">
                        @foreach (var culture in Localization.GetAvailableCultures())
                        {
                            <option value="@culture">@CultureLabel(culture)</option>
                        }
                    </select>
                </label>
                <div class="property-button-row">
                    <button type="button" @onclick="OpenTranslationEditor">@LT("Edit all application strings")</button>
                </div>
                <p class="property-note">@LT("The application choice is stored for this browser. The publication choice controls standalone HTML language metadata and remains editable per document.")</p>
            </section>

            <section class="property-section">
                <h3>@LT("Page format")</h3>
                <label>@LT("Preset")
                    <select value="@CurrentPresetKey" @onchange="ChangePagePreset">
                        <option value="custom">@LT("Custom")</option>
                        @foreach (var preset in PagePresets.GetAll())
                        {
                            <option value="@preset.Key">@preset.Name</option>
                        }
                    </select>
                </label>
                <div class="property-grid two">
                    <label>@LT("Width (mm)")<input type="number" min="10" max="2000" step="0.1" value="@Inv(State.CurrentPage.WidthMm)" @onchange="ChangePageWidth" /></label>
                    <label>@LT("Height (mm)")<input type="number" min="10" max="2000" step="0.1" value="@Inv(State.CurrentPage.HeightMm)" @onchange="ChangePageHeight" /></label>
                </div>
                <DxButton Text='@LT("Swap width / height")' Click="SwapOrientation" CssClass="wide-button" />
                <label>@LT("Background")
                    <span class="color-field"><input type="color" value="@UsableColor(State.CurrentPage.Background)" @onchange="ChangePageBackground" /><code>@State.CurrentPage.Background</code></span>
                </label>
                <div class="property-button-row">
                    <DxButton Text='@LT("Transparent")' Click="SetTransparentPage" />
                    <DxButton Text='@LT("White")' Click="SetWhitePage" />
                </div>
            </section>

            <section class="property-section">
                <h3>@LT("Presentation timeline")</h3>
                <label>@LT("Page duration (seconds)")
                    <input type="number" min="1" max="3600" step="0.1" value="@Inv(State.CurrentPage.TimelineDurationSeconds)" @onchange="ChangePageTimelineDuration" />
                </label>
                <div class="property-button-row">
                    <DxButton Text='@LT("Fit to content")' Click="FitPageTimelineToContent" />
                    <DxButton Text='@LT("10 seconds")' Click="SetTenSecondTimeline" />
                </div>
                <p class="property-note">@LT("Effective duration:") @Time(State.EffectivePageTimelineDuration()). @LT("The timeline expands automatically when media or animation clips extend beyond the page duration.")</p>
            </section>

            <section class="property-section">
                <h3>@LT("Canvas and rulers")</h3>
                <label>@LT("Ruler unit")
                    <select value="@State.Document.View.RulerUnit" @onchange="ChangeRulerUnit">
                        <option value="Millimeter">@LT("Millimetres")</option>
                        <option value="Centimeter">@LT("Centimetres")</option>
                        <option value="Inch">@LT("Inches")</option>
                        <option value="Pixel">@LT("Pixels")</option>
                    </select>
                </label>
                <label>@LT("Grid spacing (mm)")<input type="number" min="0.5" max="100" step="0.5" value="@Inv(State.Document.View.GridSpacingMm)" @onchange="ChangeGridSpacing" /></label>
                <label class="check-row"><input type="checkbox" checked="@State.Document.View.RulersVisible" @onchange="ToggleRulers" /> @LT("Show rulers")</label>
                <label class="check-row"><input type="checkbox" checked="@State.Document.View.GridVisible" @onchange="ToggleGrid" /> @LT("Show grid")</label>
                <label class="check-row"><input type="checkbox" checked="@State.Document.View.GuidesVisible" @onchange="ToggleGuides" /> @LT("Show guides")</label>
                <label class="check-row"><input type="checkbox" checked="@State.Document.View.SnapToGrid" @onchange="ToggleSnapGrid" /> @LT("Snap to grid")</label>
                <label class="check-row"><input type="checkbox" checked="@State.Document.View.SnapToGuides" @onchange="ToggleSnapGuides" /> @LT("Snap to guides")</label>
                <label class="check-row"><input type="checkbox" checked="@State.Document.View.SnapToPage" @onchange="ToggleSnapPage" /> @LT("Snap to page edges")</label>
                <label class="check-row"><input type="checkbox" checked="@State.Document.View.SnapToObjects" @onchange="ToggleSnapObjects" /> @LT("Snap to other objects")</label>
                <div class="property-button-row">
                    <DxButton Text='@LT("Vertical guide")' Click="AddVerticalGuide" />
                    <DxButton Text='@LT("Horizontal guide")' Click="AddHorizontalGuide" />
                </div>
                <DxButton Text='@LT("Clear guides")' Enabled="@(State.CurrentPage.Guides.Count > 0)" Click="ClearGuides" CssClass="wide-button" />
            </section>

            <section class="property-section">
                <h3>@LT("Export")</h3>
                <label>@LT("Raster export DPI")
                    <select value="@State.Document.View.ExportDpi" @onchange="ChangeExportDpi">
                        <option value="96">@LT("96 DPI — screen")</option>
                        <option value="150">@LT("150 DPI — draft print")</option>
                        <option value="300">@LT("300 DPI — print")</option>
                        <option value="600">@LT("600 DPI — high resolution")</option>
                    </select>
                </label>
                <label>JPEG quality · @Math.Round(State.Document.View.RasterJpegQuality * 100)%
                    <input type="range" min="0.35" max="1" step="0.01" value="@Inv(State.Document.View.RasterJpegQuality)" @oninput="ChangeRasterJpegQuality" />
                </label>
                <label class="check-row"><input type="checkbox" checked="@State.Document.View.CompressPageArchives" @onchange="ToggleCompressPageArchives" /> @LT("Compress multi-page ZIP archives")</label>
                <p class="property-note">@LT("PNG preserves page and image transparency. JPEG always receives a white background. Multi-page image archives reuse the structured-website ZIP compressor when enabled.")</p>
            </section>
        </div>
    }
    else if (State.SelectedElement is { } element)
    {
        <div class="property-scroll">
            @if (element is PanelElement panelElement)
            {
                <section class="property-section">
                    <h3>@LT("Panel / dashboard")</h3>
                    <p class="property-note">@panelElement.Views.Count authored view(s), rendered with the same components in Mainframe, Panel Studio and HTML exports.</p>
                    <DxButton Text='@LT("Edit in Panel Studio")' Click="RequestEditPanel" CssClass="wide-button" />
                </section>
            }
            @if (element is HtmlEmbedElement htmlEmbed)
            {
                <section class="property-section">
                    <h3>@LT("Web content")</h3>
                    <div class="media-export-compatibility @HtmlSupportCss(htmlEmbed.HtmlExportSupport)">
                        <b>@HtmlSupportLabel(htmlEmbed.HtmlExportSupport)</b>
                        <span>@htmlEmbed.HtmlExportNote</span>
                    </div>
                    @if (string.Equals(htmlEmbed.InterchangeFormat, "OpenSCAD", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="media-export-compatibility render">
                            <b>@HtmlSupportLabel(PublicationHtmlExportSupport.RenderBeforeExport)</b>
                            <span>@LT("Native OpenSCAD mesh/solid output is embedded as interchange source and must be rendered before HTML export. The canvas object itself remains interactive.")</span>
                        </div>
                    }
                    <p class="property-note">@LT("Edit isolated HTML, CSS and optional JavaScript inside Panel Studio.")</p>
                    <DxButton Text='@LT("Edit in Panel Studio")' Click="RequestEditPanel" CssClass="wide-button" />
                </section>
            }
            <section class="property-section">
                <h3>@LT("Object")</h3>
                <label>@LT("Name")<input value="@element.Name" @onchange="ChangeName" /></label>
                @if (element is not ConnectorElement)
                {
                    <div class="property-grid two">
                        @NumberField("X", element.X, "x")
                        @NumberField("Y", element.Y, "y")
                        @NumberField("Width", element.Width, "width")
                        @NumberField("Height", element.Height, "height")
                        @NumberField("Rotation", element.Rotation, "rotation")
                        @NumberField("Layer", element.ZIndex, "z")
                    </div>
                }
                else
                {
                    <div class="property-grid two">@NumberField("Layer", element.ZIndex, "z")</div>
                }
                <label class="check-row"><input type="checkbox" checked="@element.Visible" @onchange="ToggleVisible" /> @LT("Visible")</label>
                <label class="check-row"><input type="checkbox" checked="@element.Locked" @onchange="ToggleLocked" /> @LT("Locked")</label>
            </section>

            @if (element is ImageFrameElement image)
            {
                <section class="property-section picture-properties">
                    <h3>@LT("Picture")</h3>
                    <DxButton Text='@LT("Edit in Picture Studio")' Click="RequestEditPicture" CssClass="wide-button" />
                    <div class="property-button-row">
                        <DxButton Text='@LT("Replace…")' Click="RequestReplacePicture" />
                        <DxButton Text="@(State.CropMode ? "Finish crop" : "Crop")" Click="ToggleCrop" />
                    </div>
                    <div class="property-button-row">
                        <DxButton Text='@LT("Fit")' Click="PictureFit" />
                        <DxButton Text='@LT("Fill")' Click="PictureFill" />
                        <DxButton Text='@LT("Reset")' Click="ResetPicture" />
                    </div>
                    @RangeField("Crop zoom", image.CropScale, .2, 8, .02, "cropScale")
                    @RangeField("Picture rotation", image.ImageRotation, -180, 180, 1, "imageRotation")
                    @RangeField("Opacity", image.Opacity, 0, 1, .01, "opacity")
                    @RangeField("Brightness", image.Brightness, 0, 2, .01, "brightness")
                    @RangeField("Contrast", image.Contrast, 0, 2, .01, "contrast")
                    @RangeField("Saturation", image.Saturation, 0, 2, .01, "saturation")
                    @RangeField("Hue", image.HueRotation, -180, 180, 1, "hue")
                    @RangeField("Invert", image.Invert, 0, 1, .01, "invert")
                    @RangeField("Grayscale", image.Grayscale, 0, 1, .01, "grayscale")
                    @RangeField("Sepia", image.Sepia, 0, 1, .01, "sepia")
                    @RangeField("Blur", image.Blur, 0, 12, .1, "blur")
                </section>

                <section class="property-section picture-color-tools">
                    <h3>@LT("Recolor and transparency")</h3>
                    <label>@LT("Color treatment")
                        <select value="@image.TintMode" @onchange="ChangeTintMode">
                            <option value="Overlay">@LT("Tint overlay")</option>
                            <option value="Recolor">@LT("Full recolor")</option>
                        </select>
                    </label>
                    <label>@LT("Blend mode")
                        <select value="@image.BlendMode" @onchange="ChangeBlendMode">
                            <option value="Normal">@LT("Normal")</option>
                            <option value="Multiply">@LT("Multiply")</option>
                            <option value="Screen">@LT("Screen")</option>
                            <option value="Darken">@LT("Darken")</option>
                            <option value="Lighten">@LT("Lighten")</option>
                        </select>
                    </label>
                    @ColorField("Tint color", image.TintColor, "tintColor")
                    @RangeField("Tint strength", image.TintOpacity, 0, 1, .01, "tintOpacity")
                    <div class="color-preset-row">
                        <button @onclick="TintBlue">@LT("Blue")</button>
                        <button @onclick="TintWarm">@LT("Warm")</button>
                        <button @onclick="TintGreen">@LT("Green")</button>
                        <button @onclick="ClearTint">@LT("Clear")</button>
                    </div>
                    @ColorField("Color to remove", image.TransparentColor, "transparentColor")
                    @RangeField("Color tolerance", image.TransparentColorTolerance, 0, 255, 1, "transparentTolerance")
                    <div class="property-button-row">
                        <DxButton Text='@LT("Make transparent")' Click="RequestApplyTransparentColor" />
                        <DxButton Text='@LT("Restore original")' Click="RequestRestoreOriginalPicture" />
                    </div>
                    <p class="property-note">@LT("Recolor and tint preserve the picture's alpha channel. “Make transparent” edits a copy; Restore Original keeps the imported source.")</p>
                </section>

                <section class="property-section">
                    <h3>@LT("Picture frame")</h3>
                    <label>@LT("Mask")
                        <select value="@image.MaskShape" @onchange="ChangeImageMask">
                            <option value="Rectangle">@LT("Rectangle")</option>
                            <option value="RoundedRectangle">@LT("Rounded rectangle")</option>
                            <option value="Ellipse">@LT("Ellipse")</option>
                        </select>
                    </label>
                    @RangeField("Rounded corners", image.CornerRadiusMm, 0, 30, .1, "corner")
                    @ColorField("Border", image.BorderColor, "imageBorder")
                    @RangeField("Border width", image.BorderWidthMm, 0, 5, .05, "imageBorderWidth")
                    <label class="check-row"><input type="checkbox" checked="@image.ShadowEnabled" @onchange="ToggleImageShadow" /> @LT("Drop shadow")</label>
                    <label class="check-row"><input type="checkbox" checked="@image.FlipHorizontal" @onchange="ToggleFlipHorizontal" /> @LT("Flip horizontal")</label>
                    <label class="check-row"><input type="checkbox" checked="@image.FlipVertical" @onchange="ToggleFlipVertical" /> @LT("Flip vertical")</label>
                    <label>@LT("Alt text")<input value="@image.AltText" @onchange="ChangeAltText" /></label>
                </section>
            }
            else if (element is TextFrameElement text)
            {
                <section class="property-section">
                    <h3>@LT("Text frame")</h3>
                    @RangeField("Padding", text.PaddingMm, 0, 20, .1, "padding")
                    @ColorField("Background", text.Background, "textBackground")
                    @ColorField("Border", text.BorderColor, "textBorder")
                    @RangeField("Frame border width (mm)", text.BorderWidth, 0, 5, .05, "textBorderWidth")
                    <label>@LT("Content sizing")
                        <select value="@text.ContentFit" @onchange="ChangeTextContentFit">
                            <option value="Clip">@LT("Natural / clip fragments")</option>
                            <option value="Fit">@LT("Fit whole text")</option>
                            <option value="Fill">@LT("Fill and crop")</option>
                            <option value="Stretch">@LT("Stretch to frame")</option>
                        </select>
                    </label>
                    <DxButton Text='@LT("Edit story")' Click="RequestEditStory" CssClass="wide-button" />
                </section>
            }
            else if (element is WordArtElement wordArt)
            {
                <section class="property-section wordart-properties">
                    <h3>@LT("WordArt / LogoArt")</h3>
                    <label>@LT("Text")<textarea rows="3" value="@wordArt.Text" @onchange="ChangeWordArtText"></textarea></label>
                    <label>@LT("Font family")
                        <SystemFontPicker Value="@wordArt.FontFamily" Changed="ChangeWordArtFont" />
                    </label>
                    @RangeField("Font size", wordArt.FontSizePt, 8, 180, 1, "wordFontSize")
                    @RangeField("Letter spacing", wordArt.LetterSpacing, -5, 30, .5, "wordLetterSpacing")
                    <label>@LT("Fill type")
                        <select value="@wordArt.FillKind" @onchange="ChangeWordArtFillKind">
                            <option value="Solid">@LT("Solid color")</option>
                            <option value="Gradient">@LT("Gradient")</option>
                            <option value="Picture">@LT("Picture")</option>
                            <option value="Video">@LT("Video")</option>
                        </select>
                    </label>
                    @ColorField("Fallback / solid fill", wordArt.FillColor, "wordFill")
                    @if (wordArt.FillKind == WordArtFillKind.Gradient)
                    {
                        @ColorField("Second color", wordArt.SecondaryColor, "wordSecondary")
                    }
                    @if (wordArt.FillKind is WordArtFillKind.Picture or WordArtFillKind.Video)
                    {
                        <div class="property-button-row">
                            @if (wordArt.FillKind == WordArtFillKind.Picture)
                            {
                                <DxButton Text='@LT("Choose picture…")' Click="RequestWordArtPicture" />
                            }
                            else
                            {
                                <DxButton Text='@LT("Choose video…")' Click="RequestWordArtVideo" />
                            }
                            <DxButton Text='@LT("Clear media")' Enabled="@(!string.IsNullOrWhiteSpace(wordArt.FillMediaDataUrl))" Click="ClearWordArtMedia" />
                        </div>
                        <label>@LT("Media fit")
                            <select value="@wordArt.FillMediaFitMode" @onchange="ChangeWordArtMediaFit">
                                <option value="Cover">@LT("Cover letters")</option>
                                <option value="Contain">@LT("Contain in letters")</option>
                                <option value="Stretch">@LT("Stretch")</option>
                            </select>
                        </label>
                        @RangeField("Media scale", wordArt.FillMediaScale, .1, 10, .01, "wordMediaScale")
                        @RangeField("Horizontal offset", wordArt.FillMediaOffsetXPercent, -100, 100, 1, "wordMediaOffsetX")
                        @RangeField("Vertical offset", wordArt.FillMediaOffsetYPercent, -100, 100, 1, "wordMediaOffsetY")
                        @if (wordArt.FillKind == WordArtFillKind.Video)
                        {
                            <label class="check-row"><input type="checkbox" checked="@wordArt.FillMediaLoop" @onchange="ToggleWordArtMediaLoop" /> @LT("Loop video fill")</label>
                            <p class="property-note">@LT("Interactive HTML keeps the video live. Static exports use the generated poster frame so PDF, print, PNG, JPEG and SVG remain deterministic.")</p>
                        }
                        else
                        {
                            <p class="property-note">@LT("The original picture remains embedded in the publication and is clipped through the WordArt glyphs in every export.")</p>
                        }
                    }
                    @ColorField("Outline", wordArt.OutlineColor, "wordOutline")
                    @RangeField("Outline width", wordArt.OutlineWidth, 0, 12, .25, "wordOutlineWidth")
                    @ColorField("3D color", wordArt.ExtrudeColor, "wordExtrude")
                    @RangeField("3D depth", wordArt.ExtrudeDepth, 0, 18, .5, "wordExtrudeDepth")
                    <label>@LT("Warp")
                        <select value="@wordArt.Warp" @onchange="ChangeWordArtWarp">
                            <option value="None">@LT("Straight")</option>
                            <option value="ArchUp">@LT("Arch up")</option>
                            <option value="ArchDown">@LT("Arch down")</option>
                            <option value="Wave">@LT("Wave")</option>
                            <option value="Custom">@LT("Custom drawn path")</option>
                        </select>
                    </label>
                    @if (wordArt.Warp == WordArtWarp.Custom)
                    {
                        <WordArtPathEditor @key="wordArt.Id" Item="wordArt" PathChanged="ChangeWordArtPath" />
                    }
                    @if (wordArt.Warp != WordArtWarp.None)
                    {
                        @RangeField("Text position on path", wordArt.PathStartOffsetPercent, 0, 100, 1, "wordPathStart")
                        @RangeField("Distance from path", wordArt.PathBaselineOffset, -80, 80, 1, "wordPathOffset")
                    }
                    <label class="check-row"><input type="checkbox" checked="@wordArt.Bold" @onchange="ToggleWordArtBold" /> @LT("Bold")</label>
                    <label class="check-row"><input type="checkbox" checked="@wordArt.Italic" @onchange="ToggleWordArtItalic" /> @LT("Italic")</label>
                    <label class="check-row"><input type="checkbox" checked="@wordArt.ShadowEnabled" @onchange="ToggleWordArtShadow" /> @LT("Shadow")</label>
                </section>
            }
            else if (element is PublicationMediaElement media)
            {
                <section class="property-section media-properties">
                    <h3>@(media is VideoElement ? "Video" : "Audio")</h3>
                    <DxButton Text='@LT("Edit in Media Studio")' Click="RequestEditMedia" RenderStyle="ButtonRenderStyle.Primary" CssClass="wide-button" />
                    <div class="property-grid two">
                        <label>@LT("Timeline start")<input type="number" min="0" max="3600" step="0.01" value="@Inv(media.TimelineStartSeconds)" @onchange="ChangeMediaTimelineStart" /></label>
                        <label>@LT("Playback rate")<input type="number" min="0.25" max="4" step="0.05" value="@Inv(media.PlaybackRate)" @onchange="ChangeMediaPlaybackRate" /></label>
                        <label>@LT("Trim start")<input type="number" min="0" max="@Inv(media.DurationSeconds)" step="0.01" value="@Inv(media.TrimStartSeconds)" @onchange="ChangeMediaTrimStart" /></label>
                        <label>@LT("Trim end")<input type="number" min="0" max="@Inv(media.DurationSeconds)" step="0.01" value="@Inv(media.EffectiveTrimEndSeconds)" @onchange="ChangeMediaTrimEnd" /></label>
                    </div>
                    @RangeField("Volume", media.Volume, 0, 1, .01, "mediaVolume")
                    @if (media is AudioElement)
                    {
                        @RangeField("Fade in", media.FadeInSeconds, 0, Math.Max(.05, media.TimelineLengthSeconds / 2), .05, "mediaFadeIn")
                        @RangeField("Fade out", media.FadeOutSeconds, 0, Math.Max(.05, media.TimelineLengthSeconds / 2), .05, "mediaFadeOut")
                    }
                    <label>@LT("Start behavior")
                        <select value="@media.PlaybackTrigger" @onchange="ChangeMediaTrigger">
                            <option value="OnPageEnter">@LT("On page entry")</option>
                            <option value="OnClick">@LT("On click")</option>
                            <option value="WithAnimation">@LT("With animation timeline")</option>
                        </select>
                    </label>
                    <label class="check-row"><input type="checkbox" checked="@media.Muted" @onchange="ToggleMediaMuted" /> @LT("Muted")</label>
                    <label class="check-row"><input type="checkbox" checked="@media.Loop" @onchange="ToggleMediaLoop" /> @LT("Loop selected range")</label>
                    <label class="check-row"><input type="checkbox" checked="@media.AutoPlay" @onchange="ToggleMediaAutoPlay" /> @LT("Play during presentation")</label>
                    @if (media is VideoElement video)
                    {
                        <label>@LT("Video fit")
                            <select value="@video.FitMode" @onchange="ChangeVideoFit">
                                <option value="Contain">@LT("Fit inside frame")</option>
                                <option value="Cover">@LT("Fill frame")</option>
                                <option value="Stretch">@LT("Stretch")</option>
                            </select>
                        </label>
                        <label class="check-row"><input type="checkbox" checked="@video.ShowControls" @onchange="ToggleVideoControls" /> @LT("Show controls")</label>
                    }
                    else if (media is AudioElement audio)
                    {
                        <label>@LT("Audio appearance")
                            <select value="@audio.DisplayKind" @onchange="ChangeAudioDisplay">
                                <option value="Waveform">@LT("Waveform")</option>
                                <option value="Compact">@LT("Compact")</option>
                                <option value="Hidden">@LT("Hidden during presentation")</option>
                            </select>
                        </label>
                        @ColorField("Accent", audio.AccentColor, "audioAccent")
                        <label class="check-row"><input type="checkbox" checked="@audio.ShowControls" @onchange="ToggleAudioControls" /> @LT("Show controls")</label>
                    }
                    <p class="property-note">@LT("The source remains embedded. Trimming, fades, playback rate, and timeline placement are non-destructive.")</p>
                </section>
            }
            else if (element is LiveSourceElement liveSource)
            {
                <section class="property-section live-source-properties">
                    <h3>@LT("Live source")</h3>
                    <div class="data-source-summary">
                        <span><b>@LT("Kind:")</b> @liveSource.SourceKind</span>
                        <span><b>@LT("Clock:")</b> @(liveSource.UseDeviceTimestamp ? LT("Device timestamp") : LT("Session clock"))</span>
                    </div>
                    <label>@LT("Saved device profile")
                        <select value="@GuidText(liveSource.DeviceProfileId)" @onchange="ChangeLiveDeviceProfile">
                            <option value="">@LT("Custom settings")</option>
                            @foreach (var profile in _streamingDeviceProfiles)
                            {
                                <option value="@profile.Id">@profile.Name · @profile.Kind</option>
                            }
                        </select>
                    </label>
                    <button type="button" class="wide-button" @onclick="RefreshStreamingDeviceProfiles">@LT("Refresh saved profiles")</button>
                    <label>@LT("Capture backend")
                        <select value="@liveSource.CaptureBackend" @onchange="ChangeLiveCaptureBackend">
                            @foreach (var value in Enum.GetValues<PublicationCaptureBackend>()) { <option value="@value">@value</option> }
                        </select>
                    </label>
                    @if (liveSource.CaptureBackend == PublicationCaptureBackend.Native)
                    {
                        <label>@LT("Native backend")<input value="@liveSource.NativeBackend" @onchange="ChangeLiveNativeBackend" placeholder="dshow, avfoundation, v4l2, wasapi-process-loopback" /></label>
                    }
                    <label>@LT("Source kind")
                        <select value="@liveSource.SourceKind" @onchange="ChangeLiveSourceKind">
                            @foreach (var value in Enum.GetValues<PublicationLiveSourceKind>()) { <option value="@value">@value</option> }
                        </select>
                    </label>
                    @if (liveSource.SourceKind is PublicationLiveSourceKind.Camera or PublicationLiveSourceKind.CaptureDevice or PublicationLiveSourceKind.Microphone)
                    {
                        <label>@LT("Video / primary device ID")<input value="@liveSource.DeviceId" @onchange="ChangeLiveDeviceId" placeholder="Blank uses the default device" /></label>
                    }
                    @if (liveSource.SourceKind is PublicationLiveSourceKind.Camera or PublicationLiveSourceKind.CaptureDevice)
                    {
                        <label>@LT("Audio device ID")<input value="@liveSource.AudioDeviceId" @onchange="ChangeLiveAudioDeviceId" placeholder="Optional paired capture-card audio device" /></label>
                    }
                    @if (liveSource.SourceKind == PublicationLiveSourceKind.ApplicationAudio)
                    {
                        <label>@LT("Application / process")<input value="@liveSource.ApplicationId" @onchange="ChangeLiveApplicationId" placeholder="discord.exe or another process" /></label>
                        <label>@LT("Window-title hint")<input value="@liveSource.WindowTitle" @onchange="ChangeLiveWindowTitle" /></label>
                    }
                    @if (liveSource.SourceKind == PublicationLiveSourceKind.NetworkMedia)
                    {
                        <label>@LT("Network URL")<input value="@liveSource.NetworkUrl" @onchange="ChangeLiveNetworkUrl" placeholder="https, rtsp, srt, or provider URL" /></label>
                    }
                    @if (liveSource.SourceKind == PublicationLiveSourceKind.NowPlaying)
                    {
                        <label>@LT("Watched music directory")<input value="@liveSource.NowPlayingDirectory" @onchange="ChangeNowPlayingDirectory" /></label>
                    }
                    @if (liveSource.IsVisual)
                    {
                        var authoredLiveLayers = LiveEffectLayers(liveSource);
                        var selectedLiveLayer = SelectedLiveEffectLayer(liveSource);
                        var selectedLiveFilter = SelectedLiveEffectFilter(liveSource);

                        <label>@LT("Capture width")<input type="number" min="320" max="7680" step="2" value="@liveSource.CaptureWidth" @onchange="ChangeLiveCaptureWidth" /></label>
                        <label>@LT("Capture height")<input type="number" min="180" max="4320" step="2" value="@liveSource.CaptureHeight" @onchange="ChangeLiveCaptureHeight" /></label>
                        <label>@LT("Capture FPS")<input type="number" min="15" max="120" value="@liveSource.CaptureFrameRate" @onchange="ChangeLiveCaptureFrameRate" /></label>
                        <label>@LT("Fit")
                            <select value="@liveSource.FitMode" @onchange="ChangeLiveFit">
                                @foreach (var value in Enum.GetValues<PublicationLiveSourceFitMode>()) { <option value="@value">@value</option> }
                            </select>
                        </label>
                        @RangeField("Brightness", liveSource.Brightness, 0, 4, .01, "liveBrightness")
                        @RangeField("Contrast", liveSource.Contrast, 0, 4, .01, "liveContrast")
                        @RangeField("Saturation", liveSource.Saturation, 0, 4, .01, "liveSaturation")
                        @RangeField("Hue", liveSource.HueRotation, -360, 360, 1, "liveHue")
                        @RangeField("Blur", liveSource.Blur, 0, 64, .1, "liveBlur")
                        <label class="check-row"><input type="checkbox" checked="@liveSource.ChromaKeyEnabled" @onchange="ToggleLiveChroma" /> @LT("Chroma key")</label>
                        @if (liveSource.ChromaKeyEnabled)
                        {
                            @ColorField("Key color", liveSource.ChromaKeyColor, "liveChromaColor")
                            @RangeField("Similarity", liveSource.ChromaSimilarity, 0, 1, .01, "liveChromaSimilarity")
                            @RangeField("Smoothness", liveSource.ChromaSmoothness, 0, 1, .01, "liveChromaSmoothness")
                            @RangeField("Spill reduction", liveSource.ChromaSpill, 0, 1, .01, "liveChromaSpill")
                            @RangeField("Keyed residual opacity", liveSource.ChromaResidualOpacity, 0, 1, .01, "liveChromaResidual")
                        }

                        <div class="live-video-effect-editor">
                            <h4>@LT("Layered streaming effects")</h4>
                            <p class="property-note">@LT("These authored layers render live on camera, screen, window, browser-tab, capture-device, and network-video inputs. The compatibility controls above remain in their own protected layer.")</p>
                            <div class="media-video-layer-stack compact">
                                @foreach (var layer in authoredLiveLayers)
                                {
                                    <div class="media-video-layer-row @(selectedLiveLayer?.Id == layer.Id ? "selected" : null)">
                                        <button type="button" class="media-video-layer-select" @onclick="() => SelectLiveEffectLayer(layer.Id)">
                                            <span>@layer.Name</span>
                                            <small>@layer.Filters.Count filter@(layer.Filters.Count == 1 ? string.Empty : "s") · @Math.Round(layer.Opacity * 100)%</small>
                                        </button>
                                        <button type="button" class="media-video-layer-visibility" title='@LT("Toggle live layer visibility")' @onclick="() => ToggleLiveEffectLayer(layer.Id)"><i class="pub-icon pub-icon-visible" aria-hidden="true"></i></button>
                                    </div>
                                }
                                @if (authoredLiveLayers.Count == 0)
                                {
                                    <p class="property-note">@LT("No authored streaming-effect layer yet.")</p>
                                }
                            </div>
                            <div class="property-button-row">
                                <DxButton Text='@LT("Add layer")' Click="AddLiveEffectLayer" />
                                <DxButton Text='@LT("Duplicate")' Enabled="@(selectedLiveLayer is not null)" Click="DuplicateLiveEffectLayer" />
                                <DxButton Text='@LT("Up")' Enabled="@(CanMoveLiveEffectLayer(liveSource, 1))" Click="MoveLiveEffectLayerUp" />
                                <DxButton Text='@LT("Down")' Enabled="@(CanMoveLiveEffectLayer(liveSource, -1))" Click="MoveLiveEffectLayerDown" />
                                <DxButton Text='@LT("Remove")' Enabled="@(selectedLiveLayer is not null)" Click="RemoveLiveEffectLayer" />
                            </div>
                            @if (selectedLiveLayer is not null)
                            {
                                <label>@LT("Layer name")<input value="@selectedLiveLayer.Name" @onchange="ChangeLiveEffectLayerName" /></label>
                                <label>@LT("Layer opacity") <b>@Math.Round(selectedLiveLayer.Opacity * 100)%</b>
                                    <input type="range" min="0" max="1" step="0.01" value="@Inv(selectedLiveLayer.Opacity)" @onchange="ChangeLiveEffectLayerOpacity" />
                                </label>
                                <label>@LT("Blend mode")
                                    <select value="@selectedLiveLayer.BlendMode" @onchange="ChangeLiveEffectLayerBlendMode">
                                        @foreach (var blend in Enum.GetValues<VideoEffectBlendMode>())
                                        {
                                            <option value="@blend">@blend</option>
                                        }
                                    </select>
                                </label>
                                <div class="property-inline-actions">
                                    <select value="@_newLiveFilterKind" @onchange="ChangeNewLiveFilterKind">
                                        @foreach (var kind in Enum.GetValues<VideoEffectFilterKind>())
                                        {
                                            <option value="@kind">@LiveFilterKindName(kind)</option>
                                        }
                                    </select>
                                    <DxButton Text='@LT("Add filter")' Click="AddLiveEffectFilter" />
                                </div>
                                <div class="media-video-filter-stack compact">
                                    @foreach (var filter in selectedLiveLayer.Filters)
                                    {
                                        <div class="media-video-filter-row @(selectedLiveFilter?.Id == filter.Id ? "selected" : null)">
                                            <button type="button" @onclick="() => SelectLiveEffectFilter(filter.Id)"><span>@filter.Name</span><small>@LiveFilterSummary(filter)</small></button>
                                            <button type="button" title='@LT("Enable or disable live filter")' @onclick="() => ToggleLiveEffectFilter(filter.Id)"><i class="pub-icon pub-icon-visible" aria-hidden="true"></i></button>
                                        </div>
                                    }
                                    @if (selectedLiveLayer.Filters.Count == 0)
                                    {
                                        <p class="property-note">@LT("This layer has no filters.")</p>
                                    }
                                </div>
                                @if (selectedLiveFilter is not null)
                                {
                                    <label>@LT("Filter name")<input value="@selectedLiveFilter.Name" @onchange="ChangeLiveEffectFilterName" /></label>
                                    @if (selectedLiveFilter.Kind == VideoEffectFilterKind.ChromaKey)
                                    {
                                        <label>@LT("Key color")<input type="color" value="@selectedLiveFilter.Color" @onchange="ChangeLiveEffectFilterColor" /></label>
                                        <label>@LT("Similarity")<input type="range" min="0" max="1" step="0.01" value="@Inv(selectedLiveFilter.Amount)" @onchange="ChangeLiveEffectFilterAmount" /></label>
                                        <label>@LT("Smoothness")<input type="range" min="0.001" max="1" step="0.01" value="@Inv(selectedLiveFilter.SecondaryAmount)" @onchange="ChangeLiveEffectFilterSecondaryAmount" /></label>
                                        <label>@LT("Spill reduction")<input type="range" min="0" max="1" step="0.01" value="@Inv(selectedLiveFilter.TertiaryAmount)" @onchange="ChangeLiveEffectFilterTertiaryAmount" /></label>
                                        <label>@LT("Residual opacity")<input type="range" min="0" max="1" step="0.01" value="@Inv(selectedLiveFilter.ResidualOpacity)" @onchange="ChangeLiveEffectFilterResidualOpacity" /></label>
                                    }
                                    else
                                    {
                                        <label>@LiveFilterAmountLabel(selectedLiveFilter.Kind)
                                            <input type="range" min="@Inv(LiveFilterMinimum(selectedLiveFilter.Kind))" max="@Inv(LiveFilterMaximum(selectedLiveFilter.Kind))" step="@Inv(LiveFilterStep(selectedLiveFilter.Kind))" value="@Inv(selectedLiveFilter.Amount)" @onchange="ChangeLiveEffectFilterAmount" />
                                        </label>
                                        @if (selectedLiveFilter.Kind == VideoEffectFilterKind.Vignette)
                                        {
                                            <label>@LT("Softness")<input type="range" min="0" max="1" step="0.01" value="@Inv(selectedLiveFilter.SecondaryAmount)" @onchange="ChangeLiveEffectFilterSecondaryAmount" /></label>
                                        }
                                        @if (selectedLiveFilter.Kind == VideoEffectFilterKind.ColorWash)
                                        {
                                            <label>@LT("Wash color")<input type="color" value="@selectedLiveFilter.Color" @onchange="ChangeLiveEffectFilterColor" /></label>
                                        }
                                    }
                                    <div class="property-button-row">
                                        <DxButton Text='@LT("Filter up")' Enabled="@(CanMoveLiveEffectFilter(liveSource, 1))" Click="MoveLiveEffectFilterUp" />
                                        <DxButton Text='@LT("Filter down")' Enabled="@(CanMoveLiveEffectFilter(liveSource, -1))" Click="MoveLiveEffectFilterDown" />
                                        <DxButton Text='@LT("Remove filter")' Click="RemoveLiveEffectFilter" />
                                    </div>
                                }
                            }
                        </div>
                    }
                    @RangeField("Volume", liveSource.Volume, 0, 1, .01, "liveVolume")
                    <label>@LT("Audio delay (ms)")<input type="number" min="-10000" max="10000" step="1" value="@Inv(liveSource.AudioDelayMilliseconds)" @onchange="ChangeLiveAudioDelay" /></label>
                    <label class="check-row"><input type="checkbox" checked="@liveSource.IncludeAudio" @onchange="ToggleLiveAudio" /> @LT("Include source audio")</label>
                    <label class="check-row"><input type="checkbox" checked="@liveSource.Muted" @onchange="ToggleLiveMuted" /> @LT("Mute preview / visual source")</label>
                    <label class="check-row"><input type="checkbox" checked="@liveSource.UseDeviceTimestamp" @onchange="ToggleLiveDeviceTimestamp" /> @LT("Use device timestamps")</label>
                    <p class="property-note">@LT("Camera, screen, window, tab, microphone, and network media can preview through browser APIs. Isolated application/system audio and native devices are resolved by PublisherStudio's integrated streaming runtime.")</p>
                </section>
            }
            else if (element is SpreadsheetElement spreadsheet)
            {
                <section class="property-section spreadsheet-properties">
                    <h3>@LT("Spreadsheet")</h3>
                    <div class="data-source-summary">
                        <span><b>@LT("Workbook:")</b> @spreadsheet.WorkbookFileName</span>
                        <span><b>@LT("Active sheet:")</b> @spreadsheet.ActiveSheetName</span>
                        <span><b>@LT("Stored format:")</b> @spreadsheet.StorageFormat</span>
                    </div>
                    <DxButton Text='@LT("Edit spreadsheet")' Click="RequestEditSpreadsheet" RenderStyle="ButtonRenderStyle.Primary" CssClass="wide-button" />
                    <div class="property-button-row">
                        <DxButton Text='@LT("Download workbook")' Click="RequestDownloadSpreadsheet" />
                        <DxButton Text='@LT("Insert another…")' Click="RequestInsertSpreadsheet" />
                    </div>
                    <DxButton Text='@LT("Create blank spreadsheet")' Click="RequestCreateSpreadsheet" CssClass="wide-button" />
                    <label class="check-row"><input type="checkbox" checked="@spreadsheet.ShowGridLines" @onchange="ToggleSpreadsheetGridLines" /> @LT("Show grid lines on canvas")</label>
                    <label class="check-row"><input type="checkbox" checked="@spreadsheet.ShowSheetName" @onchange="ToggleSpreadsheetSheetName" /> @LT("Show worksheet name on canvas")</label>
                    <label>@LT("Content sizing")
                        <select value="@spreadsheet.ContentFit" @onchange="ChangeSpreadsheetContentFit">
                            <option value="Clip">@LT("Natural / crop fragments")</option>
                            <option value="Fit">@LT("Fit whole worksheet")</option>
                            <option value="Fill">@LT("Fill and crop")</option>
                            <option value="Stretch">@LT("Stretch to frame")</option>
                        </select>
                    </label>
                    @ColorField("Background", spreadsheet.Background, "spreadsheetBackground")
                    @ColorField("Border", spreadsheet.BorderColor, "spreadsheetBorder")
                    @RangeField("Border width", spreadsheet.BorderWidthMm, 0, 5, .05, "spreadsheetBorderWidth")
                    <p class="property-note">@LT("Double-click the frame to open the full DevExpress Spreadsheet component. Workbook content stays embedded in the publication.")</p>
                </section>
            }
            else if (element is BarcodeElement barcode)
            {
                <section class="property-section barcode-properties">
                    <h3>@LT("Barcode / QR")</h3>
                    <div class="inspector-barcode-preview"><BarcodeView Item="barcode" /></div>
                    <p class="property-note"><b>@barcode.Format</b> · @barcode.Value</p>
                    <DxButton Text='@LT("Edit barcode")' Click="RequestEditBarcode" RenderStyle="ButtonRenderStyle.Primary" CssClass="wide-button" />
                    <DxButton Text='@LT("Insert another barcode")' Click="RequestInsertBarcode" CssClass="wide-button" />
                </section>
            }
            else if (element is DataVisualElement dataVisual)
            {
                <section class="property-section data-visual-properties">
                    <h3>@LT("Data visual")</h3>
                    <p class="property-note">@DataVisualDescription(dataVisual). The source is stored once in the publication and may be reused by several visuals.</p>
                    <label>@LT("Title")<input value="@dataVisual.Title" @onchange="ChangeDataVisualTitle" /></label>
                    <div class="data-source-summary">
                        <span><b>@LT("Component:")</b> @Friendly(dataVisual.VisualKind.ToString())</span>
                        <span><b>@LT("Data:")</b> @DataObjectName(dataVisual.DataObjectId)</span>
                        <span><b>@LT("Category:")</b> @dataVisual.ArgumentField</span>
                        <span><b>@LT("Values:")</b> @Components.JoinDisplayValues(dataVisual.ValueFields)</span>
                    </div>
                    <DxButton Text='@LT("Edit data visual")' Click="RequestEditDataVisual" RenderStyle="ButtonRenderStyle.Primary" CssClass="wide-button" />
                    <DxButton Text='@LT("Manage publication data")' Click="RequestManageData" CssClass="wide-button" />
                    <DxButton Text='@LT("Refresh data")' Click="RefreshData" CssClass="wide-button" />
                    <label class="check-row"><input type="checkbox" checked="@dataVisual.ShowTitle" @onchange="ToggleDataTitle" /> @LT("Show title")</label>
                    <label class="check-row"><input type="checkbox" checked="@dataVisual.ShowLegend" @onchange="ToggleDataLegend" /> @LT("Show legend")</label>
                    <label class="check-row"><input type="checkbox" checked="@dataVisual.ShowLabels" @onchange="ToggleDataLabels" /> @LT("Show point labels")</label>
                    @ColorField("Background", dataVisual.Background, "dataBackground")
                    @ColorField("Border", dataVisual.BorderColor, "dataBorder")
                    @RangeField("Border width", dataVisual.BorderWidthMm, 0, 5, .05, "dataBorderWidth")
                </section>
            }
            else if (element is DevExtremeComponentElement component)
            {
                <section class="property-section component-properties">
                    <h3>@LT("Interactive component")</h3>
                    <p class="property-note">@LT("Browser-native") @Components.ComponentName(component.ComponentKind), @LT("exported with the same embedded DevExtreme runtime as the interactive charts.")</p>
                    <div class="data-source-summary">
                        <span><b>@LT("Control:")</b> @Components.ComponentName(component.ComponentKind)</span>
                        <span><b>@LT("Scope:")</b> @(component.Scope == PublicationComponentScope.Document ? LT("All pages") : LT("This page"))</span>
                        <span><b>@LT("Source:")</b> @ComponentSource(component)</span>
                        <span><b>@LT("Fields:")</b> @component.Fields.Count</span>
                    </div>
                    <DxButton Text='@LT("Open Component Studio")' Click="RequestEditComponent" RenderStyle="ButtonRenderStyle.Primary" CssClass="wide-button" />
                    <DxButton Text='@LT("Manage publication data")' Click="RequestManageData" CssClass="wide-button" />
                    <DxButton Text='@LT("Refresh component data")' Click="RefreshData" CssClass="wide-button" />
                    <label class="check-row"><input type="checkbox" checked="@component.ShowTitle" @onchange="ToggleComponentTitle" /> @LT("Show component title")</label>
                    <label class="check-row"><input type="checkbox" checked="@(component.Scope == PublicationComponentScope.Document)" @onchange="ToggleComponentScope" /> @LT("Synchronize content on all pages")</label>
                    @ColorField("Background", component.Background, "componentBackground")
                    @ColorField("Border", component.BorderColor, "componentBorder")
                    @RangeField("Border width", component.BorderWidthMm, 0, 5, .05, "componentBorderWidth")
                </section>
            }
            else if (element is ConnectorElement connector)
            {
                <section class="property-section connector-properties">
                    <h3>@(connector.Signal.Enabled ? "Signal Arrow / Connector" : "Connector")</h3>
                    <p class="property-note">@LT("Normal connectors snap object-to-object. Signal connectors may also end at an exact canvas point and execute offline click, hover, transform, visibility, media, highlight, CSS-class, animation, or chained-signal actions in HTML and video output.")</p>
                    <label>@LT("Path")
                        <select value="@connector.PathKind" @onchange="ChangeConnectorPath">
                            <option value="Straight">@LT("Straight")</option>
                            <option value="Elbow">@LT("Elbow")</option>
                            <option value="Curved">@LT("Curved")</option>
                        </select>
                    </label>
                    <label>@LT("Line style")
                        <select value="@connector.DashStyle" @onchange="ChangeConnectorDash">
                            <option value="Solid">@LT("Solid")</option>
                            <option value="Dash">@LT("Dashed")</option>
                            <option value="Dot">@LT("Dotted")</option>
                        </select>
                    </label>
                    @ColorField("Line color", connector.Stroke, "connectorStroke")
                    @RangeField("Line width", connector.StrokeWidthMm, .15, 6, .05, "connectorWidth")
                    <div class="property-grid two">
                        <label>@LT("Start marker")
                            <select value="@connector.StartMarker" @onchange="ChangeConnectorStartMarker">
                                <option value="None">@LT("None")</option>
                                <option value="Arrow">@LT("Arrow")</option>
                                <option value="Triangle">@LT("Triangle")</option>
                                <option value="Diamond">@LT("Diamond")</option>
                            </select>
                        </label>
                        <label>@LT("End marker")
                            <select value="@connector.EndMarker" @onchange="ChangeConnectorEndMarker">
                                <option value="None">@LT("None")</option>
                                <option value="Arrow">@LT("Arrow")</option>
                                <option value="Triangle">@LT("Triangle")</option>
                                <option value="Diamond">@LT("Diamond")</option>
                            </select>
                        </label>
                    </div>
                    <div class="connector-endpoint-summary">
                        <span><b>@LT("From:")</b> @EndpointName(connector.Source)</span>
                        <span><b>@LT("To:")</b> @EndpointName(connector.Target)</span>
                    </div>
                    <label>@LT("Start inner selector")
                        <input value="@connector.Source.TargetSelector" placeholder="Optional CSS selector, e.g. [data-cell='B4']" @onchange="ChangeSignalStartSelector" />
                    </label>
                    <label>@LT("End inner selector")
                        <input value="@connector.Target.TargetSelector" placeholder="Optional CSS selector inside the endpoint object" @onchange="ChangeSignalEndSelector" />
                    </label>
                    @if (connector.Source.Kind == ConnectorEndpointKind.Canvas || connector.Target.Kind == ConnectorEndpointKind.Canvas)
                    {
                        <div class="property-grid two">
                            @if (connector.Source.Kind == ConnectorEndpointKind.Canvas)
                            {
                                <label>@LT("Start X (mm)")<input type="number" step=".1" value="@Inv(connector.Source.X)" @onchange="ChangeSignalStartX" /></label>
                                <label>@LT("Start Y (mm)")<input type="number" step=".1" value="@Inv(connector.Source.Y)" @onchange="ChangeSignalStartY" /></label>
                            }
                            @if (connector.Target.Kind == ConnectorEndpointKind.Canvas)
                            {
                                <label>@LT("End X (mm)")<input type="number" step=".1" value="@Inv(connector.Target.X)" @onchange="ChangeSignalEndX" /></label>
                                <label>@LT("End Y (mm)")<input type="number" step=".1" value="@Inv(connector.Target.Y)" @onchange="ChangeSignalEndY" /></label>
                            }
                        </div>
                    }
                </section>

                <section class="property-section signal-connector-properties">
                    <h3>@LT("Signal runtime")</h3>
                    <label class="check-row"><input type="checkbox" checked="@connector.Signal.Enabled" @onchange="ToggleSignalEnabled" /> @LT("Enable dynamic signal")</label>
                    <label class="check-row"><input type="checkbox" checked="@connector.Signal.LineVisible" @onchange="ToggleSignalLineVisible" /> @LT("Draw arrow / connector while it runs")</label>
                    <div class="property-grid two">
                        <label>@LT("Trigger")
                            <select value="@connector.Signal.Trigger" @onchange="ChangeSignalTrigger">
                                @foreach (var trigger in Enum.GetValues<SignalConnectorTrigger>())
                                {
                                    <option value="@trigger">@Friendly(trigger.ToString())</option>
                                }
                            </select>
                        </label>
                        <label>@LT("Visual")
                            <select value="@connector.Signal.Visual" @onchange="ChangeSignalVisual">
                                @foreach (var visual in Enum.GetValues<SignalConnectorVisual>())
                                {
                                    <option value="@visual">@Friendly(visual.ToString())</option>
                                }
                            </select>
                        </label>
                        <label>@LT("Start gesture")
                            <select value="@connector.Signal.StartGesture" @onchange="ChangeSignalStartGesture">
                                @foreach (var gesture in Enum.GetValues<SignalGesture>())
                                {
                                    <option value="@gesture">@gesture</option>
                                }
                            </select>
                        </label>
                        <label>@LT("End gesture")
                            <select value="@connector.Signal.EndGesture" @onchange="ChangeSignalEndGesture">
                                @foreach (var gesture in Enum.GetValues<SignalGesture>())
                                {
                                    <option value="@gesture">@gesture</option>
                                }
                            </select>
                        </label>
                        <label>@LT("Delay (s)")<input type="number" min="0" max="3600" step=".05" value="@Inv(connector.Signal.DelaySeconds)" @onchange="ChangeSignalDelay" /></label>
                        <label>@LT("Travel time (s)")<input type="number" min=".05" max="3600" step=".05" value="@Inv(connector.Signal.DurationSeconds)" @onchange="ChangeSignalDuration" /></label>
                        <label>@LT("Repeats")<input type="number" min="1" max="1000" step="1" value="@connector.Signal.RepeatCount" @onchange="ChangeSignalRepeat" /></label>
                        <label class="check-row"><input type="checkbox" checked="@connector.Signal.Loop" @onchange="ToggleSignalLoop" /> @LT("Loop")</label>
                        <label class="check-row"><input type="checkbox" checked="@connector.Signal.AutoReverse" @onchange="ToggleSignalAutoReverse" /> @LT("Auto reverse")</label>
                    </div>
                    <DxButton Text='@LT("Preview signal now")' Click="PreviewSignal" RenderStyle="ButtonRenderStyle.Primary" CssClass="wide-button" />
                </section>

                <section class="property-section signal-motion-properties">
                    <h3>@LT("Travel morph / transform")</h3>
                    <label>@LT("Target object")
                        <select value="@GuidText(connector.Signal.MotionTargetElementId)" @onchange="ChangeSignalMotionTarget">
                            <option value="">@LT("No transform target")</option>
                            @foreach (var target in SignalTargetElements(connector))
                            {
                                <option value="@target.Id">@target.Name</option>
                            }
                        </select>
                    </label>
                    <label>@LT("Inner selector")
                        <input value="@connector.Signal.MotionTargetSelector" placeholder="Optional: img, [data-content-fit-source], .dx-chart" @onchange="ChangeSignalMotionSelector" />
                    </label>
                    <div class="property-grid two">
                        <label>@LT("Move X (%)")<input type="number" step=".1" value="@Inv(connector.Signal.TranslateXPercent)" @onchange="ChangeSignalMoveX" /></label>
                        <label>@LT("Move Y (%)")<input type="number" step=".1" value="@Inv(connector.Signal.TranslateYPercent)" @onchange="ChangeSignalMoveY" /></label>
                        <label>@LT("Scale")<input type="number" min=".01" max="100" step=".01" value="@Inv(connector.Signal.Scale)" @onchange="ChangeSignalScale" /></label>
                        <label>@LT("Resize width (%)")<input type="number" min=".01" max="10000" step=".1" value="@Inv(connector.Signal.ResizeWidthPercent)" @onchange="ChangeSignalResizeWidth" /></label>
                        <label>@LT("Resize height (%)")<input type="number" min=".01" max="10000" step=".1" value="@Inv(connector.Signal.ResizeHeightPercent)" @onchange="ChangeSignalResizeHeight" /></label>
                        <label>@LT("Rotation (°)")<input type="number" step=".1" value="@Inv(connector.Signal.RotationDegrees)" @onchange="ChangeSignalRotation" /></label>
                        <label>@LT("Opacity")<input type="number" min="0" max="1" step=".01" value="@Inv(connector.Signal.Opacity)" @onchange="ChangeSignalOpacity" /></label>
                        <label class="check-row"><input type="checkbox" checked="@connector.Signal.RestoreMotionAfterRun" @onchange="ToggleSignalRestoreMotion" /> @LT("Restore afterwards")</label>
                    </div>
                </section>

                <section class="property-section signal-completion-properties">
                    <h3>@LT("At destination")</h3>
                    <label>@LT("Action target")
                        <select value="@GuidText(connector.Signal.CompletionTargetElementId)" @onchange="ChangeSignalCompletionTarget">
                            <option value="">@LT("Endpoint / current object")</option>
                            @foreach (var target in SignalTargetElements(connector))
                            {
                                <option value="@target.Id">@target.Name</option>
                            }
                        </select>
                    </label>
                    <label>@LT("Inner selector")
                        <input value="@connector.Signal.CompletionTargetSelector" placeholder="Cell, chart point, button, or any exported HTML selector" @onchange="ChangeSignalCompletionSelector" />
                    </label>
                    <label>@LT("Action")
                        <select value="@connector.Signal.CompletionAction" @onchange="ChangeSignalCompletionAction">
                            @foreach (var action in Enum.GetValues<SignalCompletionAction>())
                            {
                                <option value="@action">@Friendly(action.ToString())</option>
                            }
                        </select>
                    </label>
                    @if (connector.Signal.CompletionAction == SignalCompletionAction.CallMethod)
                    {
                        <label>@LT("Method")
                            <select value="@connector.Signal.CompletionMethod" @onchange="ChangeSignalCompletionMethod">
                                @foreach (var method in SignalCompletionMethods(connector))
                                {
                                    <option value="@method">@Friendly(method)</option>
                                }
                            </select>
                        </label>
                    }
                    <label>@LT("Action value")
                        <input value="@connector.Signal.CompletionValue" placeholder="Method argument, opacity, CSS class, or highlight color" @onchange="ChangeSignalCompletionValue" />
                    </label>
                    <label>@LT("Action duration (s)")
                        <input type="number" min=".01" max="3600" step=".05" value="@Inv(connector.Signal.CompletionDurationSeconds)" @onchange="ChangeSignalCompletionDuration" />
                    </label>
                    <label>@LT("Continue with signal")
                        <select value="@GuidText(connector.Signal.NextConnectorId)" @onchange="ChangeSignalNextConnector">
                            <option value="">@LT("Stop here")</option>
                            @foreach (var next in State.CurrentPage.Elements.OfType<ConnectorElement>().Where(item => item.Id != connector.Id && item.Signal.Enabled))
                            {
                                <option value="@next.Id">@next.Name</option>
                            }
                        </select>
                    </label>
                    <p class="property-note">@LT("Selectors are evaluated locally inside the exported file. No server or network request is needed. Use one chained signal per cell/chart part when a sequence must highlight several targets in order.")</p>
                </section>
            }
            else if (element is ShapeElement shape)
            {
                <section class="property-section">
                    <h3>@LT("Shape")</h3>
                    @ColorField("Fill", shape.Fill, "shapeFill")
                    @ColorField("Outline", shape.Stroke, "shapeStroke")
                    @RangeField("Outline width", shape.StrokeWidth, 0, 8, .05, "shapeStrokeWidth")
                    @RangeField("Corner radius", shape.CornerRadiusMm, 0, 30, .1, "shapeCorner")
                </section>
            }
        </div>
    }
    else
    {
        <div class="empty-panel selection-help">
            <strong>@LT("No object selected")</strong>
            <span>@LT("Select a text box, picture, WordArt, or shape. Page and ruler settings are available on the Page tab.")</span>
        </div>
    }
    <DxContextMenu @ref="_layerContextMenu">
        <Items>
            <DxContextMenuItem Text='@LT("Select layer")' Click="SelectContextLayer" />
            @if (ContextLayer is BarcodeElement)
            {
                <DxContextMenuItem Text='@LT("Edit barcode")' BeginGroup="true" Click="EditContextBarcode" />
            }
            @if (ContextLayer is SpreadsheetElement)
            {
                <DxContextMenuItem Text='@LT("Edit spreadsheet")' BeginGroup="true" Click="EditContextSpreadsheet" />
                <DxContextMenuItem Text='@LT("Download workbook")' Click="DownloadContextSpreadsheet" />
            }
            @if (ContextLayer is PublicationMediaElement contextMedia)
            {
                <DxContextMenuItem Text='@LT("Edit in Media Studio")' BeginGroup="true" Click="EditContextMedia" />
                <DxContextMenuItem Text="@(CheckedText(contextMedia.Muted, "Muted"))" Click="ToggleContextMediaMuted" />
                <DxContextMenuItem Text="@(CheckedText(contextMedia.Loop, "Loop clip"))" Click="ToggleContextMediaLoop" />
            }
            @if (State.CanGroupSelection)
            {
                <DxContextMenuItem Text='@LT("Group selected objects")' BeginGroup="true" Click="State.GroupSelected" />
            }
            @if (State.CanUngroupSelection)
            {
                <DxContextMenuItem Text='@LT("Ungroup objects")' BeginGroup="true" Click="State.UngroupSelected" />
            }
            <DxContextMenuItem Text='@LT("Duplicate")' BeginGroup="true" Click="DuplicateContextLayer" />
            <DxContextMenuItem Text='@LT("Delete")' Enabled="@(ContextLayer is { Locked: false })" Click="DeleteContextLayer" />
            <DxContextMenuItem Text='@LT("Bring to front")' BeginGroup="true" Click="ContextBringToFront" />
            <DxContextMenuItem Text='@LT("Bring forward")' Click="ContextBringForward" />
            <DxContextMenuItem Text='@LT("Send backward")' Click="ContextSendBackward" />
            <DxContextMenuItem Text='@LT("Send to back")' Click="ContextSendToBack" />
            <DxContextMenuItem Text="@(ContextLayer?.Visible == true ? "Hide" : "Show")" BeginGroup="true" Click="ToggleContextVisibility" />
            <DxContextMenuItem Text="@(ContextLayer?.Locked == true ? "Unlock" : "Lock")" Click="ToggleContextLock" />
        </Items>
    </DxContextMenu>
</aside>

<InputFile id="wordart-picture-fill-input" class="hidden-file-input" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml" OnChange="ImportWordArtPicture" />
