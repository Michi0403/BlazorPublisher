    /// Performs change number for <see cref="InspectorPanel"/>, keeping the operation consistent with the state and invariants of the surrounding inspector panel workflow.
    /// </summary>
    /// <param name="field">Field value supplied to the inspector panel operation and used when producing its result.</param>
    /// <param name="args">Args value supplied to the inspector panel operation and used when producing its result.</param>
    private void ChangeNumber(string field, ChangeEventArgs args)
    {
        try
        {
            if (!TryDouble(args, out var value)) return;
            if (field == "z")
            {
                State.SetSelectedLayerPosition((int)Math.Round(value));
                return;
            }
            if (State.SelectedElement is PublicationMediaElement media && IsMediaNumberField(field))
            {
                State.UpdateMedia(media.Id, item => ApplyNumber(item, field, value));
                return;
            }
            State.UpdateSelected(element =>
            {
                ApplyNumber(element, field, value);
                if (element is LiveSourceElement live) TimelineEdits.SynchronizeLiveSourceLayer(live);
            });
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(InspectorPanel)}.{nameof(ChangeNumber)} failed.");
            throw;
        }
    }

