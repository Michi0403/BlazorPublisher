    private string PictureMimeType(string fileName, string? declared) {
        try
        {
            return Path.GetExtension(fileName).ToLowerInvariant() switch
    {
        ".png" => "image/png",
        ".jpg" or ".jpeg" => "image/jpeg",
        ".gif" => "image/gif",
        ".webp" => "image/webp",
        ".svg" => "image/svg+xml",
        _ when declared?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true => MediaData.NormalizeMimeType(declared, "image/png"),
        _ => string.Empty
    };
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(InspectorPanel)}.{nameof(PictureMimeType)} failed.");
