    /// Refreshes data for <see cref="InspectorPanel"/>, keeping the operation consistent with the state and invariants of the surrounding inspector panel workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task RefreshData()
    {
        try
        {
            Guid? dataObjectId = State.SelectedElement switch
            {
                DataVisualElement visual => visual.DataObjectId,
                DevExtremeComponentElement component
                    when component.Connection.Mode ==
                         PublicationComponentDataMode.PublicationDataObject
                    => component.Connection.DataObjectId,
                _ => null
            };

            await State.RefreshWebDataAsync(dataObjectId, true).ConfigureAwait(true);
            State.RefreshDataVisuals();
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(InspectorPanel)}.{nameof(RefreshData)} failed.");
            throw;
        }
    }
