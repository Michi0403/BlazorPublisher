    /// </summary>
    /// <param name="offset">Offset value supplied to the inspector panel operation and used when producing its result.</param>
    private void MoveLiveEffectLayer(int offset)
    {
        try
        {
            if (State.SelectedElement is not LiveSourceElement source || SelectedLiveEffectLayer(source) is not { } selected) return;
            var selectedId = selected.Id;
            UpdateLiveSource(item =>
            {
                var authored = LiveEffectLayers(item);
                var index = authored.FindIndex(layer => layer.Id == selectedId);
                var target = index - offset;
                if (index < 0 || target < 0 || target >= authored.Count) return;
                var targetId = authored[target].Id;
                var sourceIndex = item.VideoLayers.FindIndex(layer => layer.Id == selectedId);
                var targetIndex = item.VideoLayers.FindIndex(layer => layer.Id == targetId);
                if (sourceIndex < 0 || targetIndex < 0) return;
                (item.VideoLayers[sourceIndex], item.VideoLayers[targetIndex]) = (item.VideoLayers[targetIndex], item.VideoLayers[sourceIndex]);
            });
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(InspectorPanel)}.{nameof(MoveLiveEffectLayer)} failed.");
