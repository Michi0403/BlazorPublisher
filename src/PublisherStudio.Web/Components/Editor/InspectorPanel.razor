    /// </summary>
    private void DuplicateLiveEffectLayer()
    {
        try
        {
            if (State.SelectedElement is not LiveSourceElement source || SelectedLiveEffectLayer(source) is not { } selected) return;
            var selectedId = selected.Id;
            UpdateLiveSource(item =>
            {
                var layers = LiveEffectLayers(item);
                var original = layers.FirstOrDefault(layer => layer.Id == selectedId);
                if (original is null) return;
                var clone = TimelineEdits.CloneVideoLayer(original);
                clone.Id = Guid.NewGuid();
                clone.Region.Id = Guid.NewGuid();
                clone.Name = $"{original.Name} copy";
                foreach (var filter in clone.Filters) filter.Id = Guid.NewGuid();
                var sourceIndex = item.VideoLayers.FindIndex(layer => layer.Id == original.Id);
                item.VideoLayers.Insert(Math.Max(0, sourceIndex) + 1, clone);
                _selectedLiveEffectLayerId = clone.Id;
                _selectedLiveEffectFilterId = clone.Filters.FirstOrDefault()?.Id;
            });
    
        }
