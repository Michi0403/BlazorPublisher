    /// <summary>Begins a drag reorder operation for a Mainframe layer.</summary>
    /// <param name="item">Layer being dragged.</param>
    private void BeginLayerDrag(PublicationElement item)
    {
        try
        {
            if (!State.IsSelected(item.Id)) State.SelectElement(item.Id);
            _draggedLayerId = item.Id;
            _layerDropTargetId = item.Id;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Beginning layer drag failed for {LayerId}.", item.Id);
            OperationalNotifications.Error(ex.Message, LT("Layer reorder failed"), nameof(InspectorPanel));
        }
    }

    /// <summary>Marks a Mainframe layer row as the active drop target.</summary>
    /// <param name="item">Layer row under the pointer.</param>
    private void EnterLayerDropTarget(PublicationElement item)
    {
        try
        {
            if (_draggedLayerId.HasValue) _layerDropTargetId = item.Id;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Updating the layer drop target failed for {LayerId}.", item.Id);
            OperationalNotifications.Error(ex.Message, LT("Layer reorder failed"), nameof(InspectorPanel));
        }
    }

    /// <summary>Drops the selected layer block at the requested front-to-back row.</summary>
    /// <param name="target">Layer row receiving the drop.</param>
    private void DropLayer(PublicationElement target)
    {
        try
        {
            if (!_draggedLayerId.HasValue || State.IsSelected(target.Id)) return;
            var frontToBack = State.CurrentPage.Elements.OrderByDescending(element => element.ZIndex).ToList();
            var displayIndex = frontToBack.FindIndex(element => element.Id == target.Id);
            if (displayIndex < 0) return;
            var oneBasedBackToFrontPosition = Math.Max(1, frontToBack.Count - displayIndex);
            State.SetSelectedLayerPosition(oneBasedBackToFrontPosition);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Dropping layer {LayerId} onto {TargetLayerId} failed.", _draggedLayerId, target.Id);
            OperationalNotifications.Error(ex.Message, LT("Layer reorder failed"), nameof(InspectorPanel));
        }
        finally
        {
            EndLayerDrag();
        }
    }

    /// <summary>Clears transient Mainframe layer drag state.</summary>
    private void EndLayerDrag()
    {
        try
        {
            _draggedLayerId = null;
            _layerDropTargetId = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ending the layer drag operation failed.");
            OperationalNotifications.Error(ex.Message, LT("Layer reorder failed"), nameof(InspectorPanel));
        }
    }

