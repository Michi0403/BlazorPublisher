@namespace PublisherStudio.Components.Editor
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject StreamingProfileStore ProfileStore

@inject ILogger<LiveSourceView> Logger
<div class="live-source-frame source-@Item.SourceKind.ToString().ToLowerInvariant() @(Item.IsVisual ? "visual" : "audio-only")"
     style="@FrameStyle" data-live-source-id="@Item.Id">
    @if (Item.SourceKind == PublicationLiveSourceKind.NowPlaying)
    {
        <div id="@MetadataId" class="live-source-now-playing">
            <img data-now-playing-cover alt="" hidden />
            <div><b data-now-playing-title>Waiting for music…</b><span data-now-playing-artist></span><small data-now-playing-album>@SourceDescription</small></div>
        </div>
    }
    else if (Item.IsVisual)
    {
        <video id="@VideoId" class="live-source-video" autoplay playsinline muted="@Item.Muted"></video>
        <canvas id="@CanvasId" class="live-source-filter-canvas"></canvas>
    }
    else
    {
        <div class="live-source-audio-visual">
            <span class="live-source-kind-icon">@SourceIcon</span>
            <div><b>@Item.Name</b><small>@SourceDescription</small></div>
            <meter id="@MeterId" min="0" max="1" value="0"></meter>
        </div>
    }
    @if (!_active)
    {
        <button id="@ActivateButtonId" type="button" class="live-source-activate" @onclick="Activate" @onclick:stopPropagation title="Activate live source">
            <span>@SourceIcon</span><b>Activate @SourceLabel</b><small>@ActivationHint</small>
        </button>
    }
    else
    {
        <span class="live-source-active-badge">● LIVE SOURCE</span>
    }
</div>

@code {

    /// <summary>
    /// Gets or sets the item value that forms part of the live source view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The item value exposed by <see cref="LiveSourceView"/>.</value>
    [Parameter, EditorRequired] public LiveSourceElement Item { get; set; } = default!;
    /// <summary>
    /// Gets or sets a value indicating whether designer mode applies to the live source view state.
    /// </summary>
    /// <value>The designer mode value exposed by <see cref="LiveSourceView"/>.</value>
    [Parameter] public bool DesignerMode { get; set; }

    /// <summary>
    /// Stores the internal active state used by <see cref="LiveSourceView"/> while executing its surrounding workflow.
    /// </summary>
    private bool _active;
    /// <summary>
    /// Stores the internal runtime instance identifier state used by <see cref="LiveSourceView"/> while executing its surrounding workflow.
    /// </summary>
    private readonly string _runtimeInstanceId = Guid.NewGuid().ToString("N");
    /// <summary>
    /// Gets the stable runtime source identifier used to identify or correlate this live source view instance with related application state.
    /// </summary>
    /// <value>The runtime source identifier value exposed by <see cref="LiveSourceView"/>.</value>
    private string RuntimeSourceId => $"{Item.Id:N}-{_runtimeInstanceId}";
    /// <summary>
    /// Gets the stable activate button identifier used to identify or correlate this live source view instance with related application state.
    /// </summary>
    /// <value>The activate button identifier value exposed by <see cref="LiveSourceView"/>.</value>
    private string ActivateButtonId => $"live-source-activate-{Item.Id:N}";
    /// <summary>
    /// Gets the stable video identifier used to identify or correlate this live source view instance with related application state.
    /// </summary>
    /// <value>The video identifier value exposed by <see cref="LiveSourceView"/>.</value>
    private string VideoId => $"live-source-video-{RuntimeSourceId}";
    /// <summary>
    /// Gets the stable canvas identifier used to identify or correlate this live source view instance with related application state.
    /// </summary>
    /// <value>The canvas identifier value exposed by <see cref="LiveSourceView"/>.</value>
    private string CanvasId => $"live-source-canvas-{RuntimeSourceId}";
    /// <summary>
    /// Gets the stable meter identifier used to identify or correlate this live source view instance with related application state.
    /// </summary>
    /// <value>The meter identifier value exposed by <see cref="LiveSourceView"/>.</value>
    private string MeterId => $"live-source-meter-{RuntimeSourceId}";
    /// <summary>
    /// Gets the stable metadata identifier used to identify or correlate this live source view instance with related application state.
    /// </summary>
    /// <value>The metadata identifier value exposed by <see cref="LiveSourceView"/>.</value>
    private string MetadataId => $"live-source-metadata-{RuntimeSourceId}";
    /// <summary>
    /// Gets the source label value that forms part of the live source view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The source label value exposed by <see cref="LiveSourceView"/>.</value>
    private string SourceLabel => Item.SourceKind switch
    {
        PublicationLiveSourceKind.BrowserTab => "browser tab",
        PublicationLiveSourceKind.CaptureDevice => "capture device",
        PublicationLiveSourceKind.ApplicationAudio => "application audio",
        PublicationLiveSourceKind.SystemAudio => "system audio",
        PublicationLiveSourceKind.NetworkMedia => "network media",
        PublicationLiveSourceKind.NowPlaying => "Now Playing",
        _ => Item.SourceKind.ToString().ToLowerInvariant()
    };
    /// <summary>
    /// Gets the source icon value that forms part of the live source view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The source icon value exposed by <see cref="LiveSourceView"/>.</value>
    private string SourceIcon => Item.SourceKind switch
    {
        PublicationLiveSourceKind.Camera => "📷",
        PublicationLiveSourceKind.Screen => "▣",
        PublicationLiveSourceKind.Window => "▤",
        PublicationLiveSourceKind.BrowserTab => "▱",
        PublicationLiveSourceKind.CaptureDevice => "◉",
        PublicationLiveSourceKind.Microphone => "🎙",
        PublicationLiveSourceKind.SystemAudio => "🔊",
        PublicationLiveSourceKind.ApplicationAudio => "♫",
        PublicationLiveSourceKind.NetworkMedia => "⌁",
        PublicationLiveSourceKind.NowPlaying => "♪",
        _ => "●"
    };
    /// <summary>
    /// Gets the source description value that forms part of the live source view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The source description value exposed by <see cref="LiveSourceView"/>.</value>
    private string SourceDescription => Item.SourceKind switch
    {
        PublicationLiveSourceKind.ApplicationAudio when !string.IsNullOrWhiteSpace(Item.ApplicationId) => Item.ApplicationId,
        PublicationLiveSourceKind.NetworkMedia when !string.IsNullOrWhiteSpace(Item.NetworkUrl) => Item.NetworkUrl,
        PublicationLiveSourceKind.NowPlaying when !string.IsNullOrWhiteSpace(Item.NowPlayingDirectory) => Item.NowPlayingDirectory,
        _ => Item.UseDeviceTimestamp ? "Device timestamps enabled" : "Session timestamps"
    };
    /// <summary>
    /// Gets the activation hint value that forms part of the live source view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The activation hint value exposed by <see cref="LiveSourceView"/>.</value>
    private string ActivationHint => Item.SourceKind switch
    {
        PublicationLiveSourceKind.ApplicationAudio or PublicationLiveSourceKind.SystemAudio => "Uses the browser audio picker when available; native isolated capture remains the fallback",
        PublicationLiveSourceKind.NowPlaying => "Reads current MP3 tags through PublisherStudio's integrated streaming runtime",
        _ => "Browser permission may be requested"
    };
    /// <summary>
    /// Gets the frame style value that forms part of the live source view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The frame style value exposed by <see cref="LiveSourceView"/>.</value>
    private string FrameStyle => $"background:{Item.Background};--live-brightness:{Inv(Item.Brightness)};--live-contrast:{Inv(Item.Contrast)};--live-saturation:{Inv(Item.Saturation)};--live-hue:{Inv(Item.HueRotation)}deg;--live-blur:{Inv(Item.Blur)}px";

    /// <summary>
    /// Performs activate for <see cref="LiveSourceView"/>, keeping the operation consistent with the state and invariants of the surrounding live source view workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task Activate()
    {
        try
        {
            try
            {
                var machine = await ProfileStore.LoadAsync().ConfigureAwait(true);
                var profile = Item.DeviceProfileId is Guid profileId
                    ? machine.Devices.FirstOrDefault(candidate => candidate.Id == profileId)
                    : null;
                var sourceKind = Item.SourceKind;
                var deviceId = string.IsNullOrWhiteSpace(Item.DeviceId) ? profile?.DeviceId ?? string.Empty : Item.DeviceId;
                var audioDeviceId = string.IsNullOrWhiteSpace(Item.AudioDeviceId) ? profile?.AudioDeviceId ?? string.Empty : Item.AudioDeviceId;
                var applicationId = string.IsNullOrWhiteSpace(Item.ApplicationId) ? profile?.ApplicationId ?? string.Empty : Item.ApplicationId;
                var windowTitle = string.IsNullOrWhiteSpace(Item.WindowTitle) ? profile?.WindowTitle ?? string.Empty : Item.WindowTitle;
                var useDeviceTimestamp = Item.UseDeviceTimestamp;
                var captureBackend = Item.CaptureBackend == PublicationCaptureBackend.Auto ? profile?.CaptureBackend ?? PublicationCaptureBackend.Auto : Item.CaptureBackend;
                var nativeBackend = string.IsNullOrWhiteSpace(Item.NativeBackend) ? profile?.NativeBackend ?? string.Empty : Item.NativeBackend;

                _active = await JS.InvokeAsync<bool>("publisherStreaming.attachSource", new
                {
                    id = RuntimeSourceId,
                    videoId = VideoId,
                    canvasId = CanvasId,
                    meterId = MeterId,
                    metadataId = MetadataId,
                    kind = sourceKind.ToString(),
                    deviceId,
                    audioDeviceId,
                    applicationId,
                    windowTitle,
                    captureBackend = captureBackend.ToString(),
                    nativeBackend,
                    networkUrl = Item.NetworkUrl,
                    nowPlayingDirectory = Item.NowPlayingDirectory,
                    mediaHostUrl = string.Empty,
                    ffmpegPath = machine.FfmpegPath,
                    includeAudio = Item.IncludeAudio,
                    muted = Item.Muted,
                    volume = Item.Volume,
                    audioDelayMilliseconds = Item.AudioDelayMilliseconds,
                    fitMode = Item.FitMode.ToString().ToLowerInvariant(),
                    captureWidth = Item.CaptureWidth,
                    captureHeight = Item.CaptureHeight,
                    captureFrameRate = Item.CaptureFrameRate,
                    useDeviceTimestamp,
                    brightness = Item.Brightness,
                    contrast = Item.Contrast,
                    saturation = Item.Saturation,
                    hueRotation = Item.HueRotation,
                    blur = Item.Blur,
                    videoLayers = VideoLayerPayload(),
                    chromaKeyEnabled = Item.ChromaKeyEnabled,
                    chromaKeyColor = Item.ChromaKeyColor,
                    chromaSimilarity = Item.ChromaSimilarity,
                    chromaSmoothness = Item.ChromaSmoothness,
                    chromaSpill = Item.ChromaSpill,
                    chromaResidualOpacity = Item.ChromaResidualOpacity
                }).ConfigureAwait(true);
            }
            catch { _active = false; }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(LiveSourceView)}.{nameof(Activate)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Handles the after render async lifecycle or event notification for <see cref="LiveSourceView"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="firstRender">Value indicating whether first render should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!_active || !Item.IsVisual) return;
            try
            {
                await JS.InvokeVoidAsync("publisherStreaming.updateSourceEffects", new
                {
                    id = RuntimeSourceId,
                    videoId = VideoId,
                    canvasId = CanvasId,
                    fitMode = Item.FitMode.ToString().ToLowerInvariant(),
                    brightness = Item.Brightness,
                    contrast = Item.Contrast,
                    saturation = Item.Saturation,
                    hueRotation = Item.HueRotation,
                    blur = Item.Blur,
                    videoLayers = VideoLayerPayload(),
                    chromaKeyEnabled = Item.ChromaKeyEnabled,
                    chromaKeyColor = Item.ChromaKeyColor,
                    chromaSimilarity = Item.ChromaSimilarity,
                    chromaSmoothness = Item.ChromaSmoothness,
                    chromaSpill = Item.ChromaSpill,
                    chromaResidualOpacity = Item.ChromaResidualOpacity
                }).ConfigureAwait(true);
            }
            catch { }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(LiveSourceView)}.{nameof(OnAfterRenderAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs video layer payload for <see cref="LiveSourceView"/>, keeping the operation consistent with the state and invariants of the surrounding live source view workflow.
    /// </summary>
    /// <returns>The object produced by the operation.</returns>
    private object[] VideoLayerPayload() {
        try
        {
            return (Item.VideoLayers ?? [])
        .Where(layer => layer is not null)
        .Select(layer => (object)new
        {
            id = layer.Id.ToString("D"),
            layer.Name,
            layer.Visible,
            layer.Opacity,
            blendMode = layer.BlendMode.ToString(),
            layer.HasTemporalRange,
            layer.TemporalStartSeconds,
            layer.TemporalEndSeconds,
            region = new
            {
                layer.Region.Inverted,
                points = (layer.Region.Points ?? []).Select(point => new { point.X, point.Y }).ToArray()
            },
            filters = (layer.Filters ?? []).Select(filter => new
            {
                id = filter.Id.ToString("D"),
                kind = filter.Kind.ToString(),
                filter.Enabled,
                filter.Amount,
                filter.SecondaryAmount,
                filter.TertiaryAmount,
                filter.ResidualOpacity,
                filter.Color
            }).ToArray()
        })
        .ToArray();
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(LiveSourceView)}.{nameof(VideoLayerPayload)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Releases resources owned by <see cref="LiveSourceView"/> and leaves the live source view workflow in a safely disposed state.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_active)
            {
                try { await JS.InvokeVoidAsync("publisherStreaming.detachSource", RuntimeSourceId).ConfigureAwait(true); }
                catch { }
                finally { _active = false; }
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(LiveSourceView)}.{nameof(DisposeAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs inv for <see cref="LiveSourceView"/>, keeping the operation consistent with the state and invariants of the surrounding live source view workflow.
    /// </summary>
    /// <param name="value">Value value supplied to the live source view operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string Inv(double value) {
        try
        {
            return value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(LiveSourceView)}.{nameof(Inv)} failed.");
            throw;
        }
    }

}
