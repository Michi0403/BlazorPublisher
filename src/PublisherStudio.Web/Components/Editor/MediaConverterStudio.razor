    /// <summary>
    /// Opens source in studio for <see cref="MediaConverterStudio"/>, keeping the operation consistent with the state and invariants of the surrounding media converter studio workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task OpenSourceInStudio()
    {
        try
        {
            try
            {
                _error = string.Empty;
                if (!CanOpenSourceInStudio) throw new InvalidOperationException("Only image, audio, or video sources can be opened in a Studio.");
                MediaConversionInsertRequest request;
                if (_memorySource is not null)
                {
                    request = new MediaConversionInsertRequest(_memorySource.FileName, ResolveMimeType(_memorySource.MimeType, _memorySource.FileName), _memorySource.Content.ToArray(), _memorySource.Origin);
                }
                else if (_file is not null)
                {
                    var source = _file.OpenReadStream(long.MaxValue);
                    await using var configuredSourceAsyncDisposal = source.ConfigureAwait(true);
                    using var memory = new MemoryStream();
                    await source.CopyToAsync(memory).ConfigureAwait(true);
                    var mime = ResolveMimeType(_file.ContentType, _file.Name);
                    request = new MediaConversionInsertRequest(_file.Name, mime, memory.ToArray(), "Media Converter source");
                }
                else
                {
                    return;
                }
                await OpenedInStudio.InvokeAsync(request).ConfigureAwait(true);
            }
            catch (Exception exception)
            {
                _error = exception.Message;
            }
    
        }
