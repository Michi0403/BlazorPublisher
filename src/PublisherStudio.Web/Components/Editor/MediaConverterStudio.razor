    /// <summary>
    /// Applies preset guidance for <see cref="MediaConverterStudio"/>, keeping the operation consistent with the state and invariants of the surrounding media converter studio workflow.
    /// </summary>
    /// <param name="overwriteEncoderFields">Value indicating whether overwrite encoder fields should apply to this operation.</param>
    private void ApplyPresetGuidance(bool overwriteEncoderFields)
    {
        try
        {
            var preset = SelectedPreset;
            if (preset is null) return;
            var inputKind = preset.InputKind.Trim().ToLowerInvariant();
            var encoders = preset.RequiredEncoders.Where(value => !string.IsNullOrWhiteSpace(value)).ToArray();
            var videoEncoder = inputKind is "video" or "image" ? encoders.FirstOrDefault() ?? string.Empty : string.Empty;
            var audioEncoder = inputKind == "audio" ? encoders.FirstOrDefault() ?? string.Empty : encoders.Skip(1).FirstOrDefault() ?? string.Empty;
            if (overwriteEncoderFields || string.IsNullOrWhiteSpace(_options.VideoCodec)) _options.VideoCodec = videoEncoder;
            if (overwriteEncoderFields || string.IsNullOrWhiteSpace(_options.AudioCodec)) _options.AudioCodec = audioEncoder;
            if (overwriteEncoderFields || string.IsNullOrWhiteSpace(_options.OutputExtension)) _options.OutputExtension = preset.OutputExtension;
            if (overwriteEncoderFields || string.IsNullOrWhiteSpace(_options.OutputMimeType)) _options.OutputMimeType = preset.OutputMimeType;
            if (overwriteEncoderFields || string.IsNullOrWhiteSpace(_options.VideoEncoderPreset)) _options.VideoEncoderPreset = preset.RecommendedVideoEncoderPreset;
            if (overwriteEncoderFields || string.IsNullOrWhiteSpace(_options.PixelFormat)) _options.PixelFormat = preset.RecommendedPixelFormat;
            if (overwriteEncoderFields || _options.Crf is null) _options.Crf = preset.RecommendedCrf;
            if (overwriteEncoderFields || _options.AudioBitrateKbps is null) _options.AudioBitrateKbps = preset.RecommendedAudioBitrateKbps;

            var guidance = _profiles
                .Where(profile => profile.BuiltIn && string.Equals(profile.PresetId, preset.Id, StringComparison.OrdinalIgnoreCase))
                .OrderBy(profile => profile.Options.Target == _options.Target ? 0 : 1)
                .ThenBy(profile => profile.Name.Contains("balanced", StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                .FirstOrDefault();
            if (guidance is null) return;
            var options = guidance.Options;
            if (overwriteEncoderFields || string.IsNullOrWhiteSpace(_options.VideoEncoderPreset)) _options.VideoEncoderPreset = options.VideoEncoderPreset;
            if (overwriteEncoderFields || string.IsNullOrWhiteSpace(_options.PixelFormat)) _options.PixelFormat = options.PixelFormat;
            if (overwriteEncoderFields || _options.Crf is null) _options.Crf = options.Crf;
            if (overwriteEncoderFields || _options.AudioBitrateKbps is null) _options.AudioBitrateKbps = options.AudioBitrateKbps;
            if (overwriteEncoderFields || _options.VideoBitrateKbps is null) _options.VideoBitrateKbps = options.VideoBitrateKbps;
            if (overwriteEncoderFields || _options.MaximumVideoBitrateKbps is null) _options.MaximumVideoBitrateKbps = options.MaximumVideoBitrateKbps;
            if (overwriteEncoderFields || _options.VideoBufferKbps is null) _options.VideoBufferKbps = options.VideoBufferKbps;
            if (overwriteEncoderFields) _options.FastStart = options.FastStart;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(MediaConverterStudio)}.{nameof(ApplyPresetGuidance)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs start for <see cref="MediaConverterStudio"/>, keeping the operation consistent with the state and invariants of the surrounding media converter studio workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task Start()
    {
        try
        {
            if (!CanStart) return;
            try
            {
                _error = string.Empty;
                MediaConversionJobInfo job;
                if (_file is not null)
                {
                    var source = _file.OpenReadStream(long.MaxValue);
                    await using var configuredSourceAsyncDisposal = source.ConfigureAwait(true);
                    job = await Conversions.QueueAsync(source, _file.Name, _file.ContentType, _presetId, _options).ConfigureAwait(true);
                }
                else if (_memorySource is not null)
                {
                    var source = new MemoryStream(_memorySource.Content, writable: false);
                    await using var configuredSourceAsyncDisposal = source.ConfigureAwait(true);
                    job = await Conversions.QueueAsync(source, _memorySource.FileName, _memorySource.MimeType, _presetId, _options).ConfigureAwait(true);
                }
                else return;
                _jobs.RemoveAll(existing => existing.Id == job.Id);
                _jobs.Insert(0, job);
                _selectedJobId = job.Id;
                StartPolling();
            }
            catch (Exception exception)
            {
                _error = exception.Message;
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(MediaConverterStudio)}.{nameof(Start)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Starts polling for <see cref="MediaConverterStudio"/>, keeping the operation consistent with the state and invariants of the surrounding media converter studio workflow.
    /// </summary>
    private void StartPolling()
    {
        try
        {
            if (_polling is not null) return;
            _polling = new CancellationTokenSource();
            TaskRunner.Run(
                nameof(MediaConverterStudio),
                nameof(PollAsync),
                _ => PollAsync(_polling.Token),
                _polling.Token);
    
        }
        catch (Exception __componentMethodException)
        {
