            throw;
        }
    }
    /// <summary>
    /// Performs poll for <see cref="MediaConverterStudio"/>, keeping the operation consistent with the state and invariants of the surrounding media converter studio workflow.
    /// </summary>
    /// <param name="cancellationToken">Cancellation token that allows the caller to stop the asynchronous operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            try
            {
                while (!cancellationToken.IsCancellationRequested)
                {
                    await Task.Delay(500, cancellationToken).ConfigureAwait(false);
                    await InvokeAsync(() =>
                    {
                        RefreshJobs();
                        StateHasChanged();
                    }).ConfigureAwait(false);
                    if (_jobs.All(job => job.Status is not (MediaConversionJobStatus.Queued or MediaConversionJobStatus.Running))) break;
                }
            }
            catch (OperationCanceledException exception) when (cancellationToken.IsCancellationRequested)
            {
                Logger.LogDebug(exception, "Media Converter polling was canceled by its owning Studio lifetime.");
            }
            finally
            {
                _polling?.Dispose();
                _polling = null;
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(MediaConverterStudio)}.{nameof(PollAsync)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Refreshes jobs for <see cref="MediaConverterStudio"/>, keeping the operation consistent with the state and invariants of the surrounding media converter studio workflow.
    /// </summary>
    private void RefreshJobs()
    {
        try
        {
            var latest = Conversions.GetJobs().ToDictionary(job => job.Id);
            for (var index = 0; index < _jobs.Count; index++) if (latest.TryGetValue(_jobs[index].Id, out var job)) _jobs[index] = job;
            foreach (var job in latest.Values.OrderByDescending(job => job.CreatedUtc)) if (_jobs.All(existing => existing.Id != job.Id)) _jobs.Add(job);
            if (_selectedJobId is null && _jobs.Count > 0) _selectedJobId = _jobs[0].Id;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(MediaConverterStudio)}.{nameof(RefreshJobs)} failed.");
            throw;
        }
    }
