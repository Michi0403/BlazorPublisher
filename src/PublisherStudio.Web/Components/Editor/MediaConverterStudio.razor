@namespace PublisherStudio.Components.Editor
@implements IAsyncDisposable
@inject IMediaConversionService Conversions
@inject IJSRuntime JS
@inject PublicationMediaAssetStore MediaAssets
@inject IPublisherRuntimePolicyDataService RuntimePolicy

@inject ILogger<MediaConverterStudio> Logger
@inject ISupervisedTaskRunner TaskRunner
@if (Visible)
{
    <div class="modal-backdrop data-modal-backdrop media-converter-backdrop">
        <section class="data-visual-editor-dialog media-converter-dialog" role="dialog" aria-modal="true" aria-label="Media Converter Studio"
                 @oncontextmenu="ShowConverterContextMenu" @oncontextmenu:preventDefault>
            <header>
                <div>
                    <strong>Media Converter Studio</strong>
                    <span>Reusable FFmpeg pipeline for Mainframe exports, VideoStudio, PictureStudio, audio, streaming and controller clients.</span>
                </div>
                <button type="button" class="window-close" title="Close Media Converter Studio" aria-label="Close Media Converter Studio" @onclick="Close">×</button>
            </header>

            <DxRibbon CssClass="media-converter-ribbon categorized-ribbon" SizeMode="SizeMode.Small" AdaptivityAutoCollapseItemsToGroups="true">
                <DxRibbonTab Text="Home">
                    <DxRibbonGroup Text="Source" IconCssClass="pub-icon pub-icon-open">
                        <DxRibbonItem Text="Open media…" IconCssClass="pub-icon pub-icon-open" IsPrimary="true" Click="OpenSourcePicker" />
                        <DxRibbonItem Text="@SourceStudioCommand" IconCssClass="pub-icon pub-icon-media" Enabled="@CanOpenSourceInStudio" Click="OpenSourceInStudio" />
                        <DxRibbonItem Text="Clear source" IconCssClass="pub-icon pub-icon-delete" Enabled="@HasSource" Click="ClearSource" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Convert" IconCssClass="pub-icon pub-icon-media">
                        <DxRibbonItem Text="Convert" IconCssClass="pub-icon pub-icon-play" IsPrimary="true" Enabled="@CanStart" Click="Start" />
                        <DxRibbonItem Text="Cancel selected" IconCssClass="pub-icon pub-icon-stop" Enabled="@SelectedJobRunning" Click="CancelSelected" />
                        <DxRibbonItem Text="Refresh jobs" IconCssClass="pub-icon pub-icon-refresh" Click="RefreshJobsCommand" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Result" IconCssClass="pub-icon pub-icon-download">
                        <DxRibbonItem Text="Download" IconCssClass="pub-icon pub-icon-download" Enabled="@SelectedJobCompleted" Click="DownloadSelected" />
                        <DxRibbonItem Text="Insert Mainframe" IconCssClass="pub-icon pub-icon-insert" Enabled="@SelectedJobCompleted" Click="InsertSelected" />
                        <DxRibbonItem Text="@SelectedStudioCommand" IconCssClass="pub-icon pub-icon-media" Enabled="@CanOpenSelectedInStudio" Click="OpenSelectedInStudio" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Profiles" IconCssClass="pub-icon pub-icon-save">
                        <DxRibbonItem Text="Save profile" IconCssClass="pub-icon pub-icon-save" Click="SaveProfile" />
                        <DxRibbonItem Text="Delete profile" IconCssClass="pub-icon pub-icon-delete" Enabled="@CanDeleteProfile" Click="DeleteProfile" />
                    </DxRibbonGroup>
                </DxRibbonTab>
                <DxRibbonTab Text="Video">
                    <DxRibbonGroup Text="Resolution" IconCssClass="pub-icon pub-icon-video">
                        <DxRibbonItem Text="Keep source" Click="ResolutionSource" />
                        <DxRibbonItem Text="2160p" Click="Resolution2160" />
                        <DxRibbonItem Text="1440p" Click="Resolution1440" />
                        <DxRibbonItem Text="1080p" Click="Resolution1080" />
                        <DxRibbonItem Text="720p" Click="Resolution720" />
                        <DxRibbonItem Text="480p" Click="Resolution480" />
                        <DxRibbonItem Text="Vertical 1080×1920" Click="ResolutionVertical" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Canvas mapping" IconCssClass="pub-icon pub-icon-select">
                        <DxRibbonItem Text="Fit" Click="ScaleFit" />
                        <DxRibbonItem Text="Fill" Click="ScaleFill" />
                        <DxRibbonItem Text="Stretch" Click="ScaleStretch" />
                        <DxRibbonItem Text="Preserve" Click="ScalePreserve" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Web output" IconCssClass="pub-icon pub-icon-web">
                        <DxRibbonItem Text="PublisherStudio HTML" Click="PublisherStudioWebDefaults" />
                        <DxRibbonItem Text="Broad browser MP4" Click="BroadWebDefaults" />
                        <DxRibbonItem Text="Editing intermediate" Click="EditingDefaults" />
                        <DxRibbonItem Text="Lossless archive" Click="ArchiveDefaults" />
                    </DxRibbonGroup>
                </DxRibbonTab>
                <DxRibbonTab Text="Audio & filters">
                    <DxRibbonGroup Text="Audio" IconCssClass="pub-icon pub-icon-audio">
                        <DxRibbonItem Text="Normalize loudness" Click="ToggleNormalizeAudio" />
                        <DxRibbonItem Text="Stereo" Click="AudioStereo" />
                        <DxRibbonItem Text="Mono" Click="AudioMono" />
                        <DxRibbonItem Text="Mute output" Click="ToggleDisableAudio" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Video processing" IconCssClass="pub-icon pub-icon-effects">
                        <DxRibbonItem Text="Deinterlace" Click="ToggleDeinterlace" />
                        <DxRibbonItem Text="30 fps" Click="FrameRate30" />
                        <DxRibbonItem Text="60 fps" Click="FrameRate60" />
                        <DxRibbonItem Text="Keep frame rate" Click="FrameRateSource" />
                    </DxRibbonGroup>
                </DxRibbonTab>
            </DxRibbon>

            <InputFile id="media-converter-source-input" class="hidden-file-input" OnChange="SelectFile" accept="image/*,video/*,audio/*,.mkv,.mxf,.avi,.tif,.tiff,.heic,.heif,.flac,.wav,.mov,.mp4,.webm,.ogg,.m4v,.mts,.m2ts,.vob,.gif,.bmp,.exr" />

            <div class="media-converter-layout">
                <aside class="media-converter-sidebar visual-settings">
                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="inline-error"><strong>Media conversion error</strong><p>@_error</p></div>
                    }
                    @if (_capabilities is null)
                    {
                        <p>Checking FFmpeg…</p>
                    }
                    else if (!_capabilities.Available)
                    {
                        <div class="inline-error"><strong>FFmpeg is not available</strong><p>@_capabilities.InstallationHint</p></div>
                    }
                    else
                    {
                        <div class="inline-success"><strong>@_capabilities.Version</strong><small>@_capabilities.Executable</small></div>
                    }

                    <section class="converter-source-card" @ref="_sourceDropZone" @ondblclick="OpenSourcePicker"
                             @oncontextmenu="ShowConverterContextMenu" @oncontextmenu:preventDefault @oncontextmenu:stopPropagation>
                        <span class="pub-icon pub-icon-media"></span>
                        @if (HasSource)
                        {
                            <div><strong>@SourceName</strong><small>@EffectiveSourceMimeType · @FormatBytes(SourceSize)</small><small>@SourceOrigin</small></div>
                        }
                        else
                        {
                            <div><strong>Drop/open a media source</strong><small>No application-defined file-size ceiling.</small></div>
                        }
                        <div class="converter-source-actions">
                            <button type="button" title="Choose a local image, audio, or video source" @onclick="OpenSourcePicker">Browse…</button>
                            @if (CanOpenSourceInStudio)
                            {
                                <button type="button" title="@SourceStudioTooltip" @onclick="OpenSourceInStudio">@SourceStudioButtonText</button>
                            }
                        </div>
                    </section>

                    <label>Saved profile
                        <select value="@_selectedProfileId" @onchange="SelectProfile">
                            <option value="@Guid.Empty">Custom settings</option>
                            @foreach (var profile in _profiles.OrderByDescending(profile => profile.BuiltIn).ThenBy(profile => profile.Name))
                            {
                                <option value="@profile.Id">@(profile.BuiltIn ? "Built-in · " : "My profile · ")@profile.Name</option>
                            }
                        </select>
                    </label>
                    <label>Base preset
                        <select value="@_presetId" @onchange="ChangePreset">
                            @foreach (var preset in MatchingPresets)
                            {
                                <option value="@preset.Id" disabled="@(!preset.Available)">@preset.Name@(!preset.Available ? " · unavailable" : null)</option>
                            }
                        </select>
                    </label>
                    @if (SelectedPreset is { } selectedPreset)
                    {
                        <p>@selectedPreset.Description</p>
                        <small>@(selectedPreset.Lossless ? "Lossless output" : "Re-encoded output") · @selectedPreset.OutputMimeType</small>
                        @if (!selectedPreset.Available) { <div class="inline-error">@selectedPreset.UnavailableReason</div> }
                    }

                    <label>Profile name<input @bind="_profileName" /></label>
                    <label>Profile description<textarea rows="2" @bind="_profileDescription"></textarea></label>
                    <div class="panel-inline-actions">
                        <button type="button" @onclick="SaveProfile">Save profile</button>
                        <button type="button" @onclick="DeleteProfile" disabled="@(!CanDeleteProfile)">Delete</button>
                    </div>
                    @if (_capabilities is not null)
                    {
                        <p class="field-help">@_capabilities.LicenseNotice</p>
                    }
                </aside>

                <main class="media-converter-workspace">
                    <div class="media-converter-settings-grid">
                        <details open>
                            <summary>Output and web compatibility</summary>
                            <div class="data-form-grid">
                                <label>Workflow target
                                    <select value="@_options.Target" @onchange="ChangeTarget">
                                        @foreach (var target in Enum.GetValues<MediaConversionTarget>()) { <option value="@target">@target</option> }
                                    </select>
                                </label>
                                <label>Output filename<input value="@_options.OutputFileName" @onchange="args => _options.OutputFileName = Text(args)" placeholder="Source name + extension" /></label>
                                <label>Extension<input value="@_options.OutputExtension" @onchange="args => _options.OutputExtension = Text(args)" placeholder="Preset default" /></label>
                                <label>MIME type<input value="@_options.OutputMimeType" @onchange="args => _options.OutputMimeType = Text(args)" placeholder="Preset default" /></label>
                                <label class="check-row"><input type="checkbox" checked="@_options.FastStart" @onchange="args => _options.FastStart = Bool(args)" /> MP4 fast-start</label>
                                <label class="check-row"><input type="checkbox" checked="@_options.CopyMetadata" @onchange="args => _options.CopyMetadata = Bool(args)" /> Preserve metadata</label>
                            </div>
                        </details>

                        <details open>
                            <summary>Trim, resolution and frame rate</summary>
                            <div class="data-form-grid">
                                <label>Start seconds<input type="number" min="0" step="0.001" value="@NullableNumber(_options.StartSeconds)" @onchange="args => _options.StartSeconds = NullableDouble(args)" /></label>
                                <label>Duration seconds<input type="number" min="0" step="0.001" value="@NullableNumber(_options.DurationSeconds)" @onchange="args => _options.DurationSeconds = NullableDouble(args)" /></label>
                                <label>Width<input type="number" min="1" step="1" value="@NullableNumber(_options.Width)" @onchange="args => _options.Width = NullableInt(args)" /></label>
                                <label>Height<input type="number" min="1" step="1" value="@NullableNumber(_options.Height)" @onchange="args => _options.Height = NullableInt(args)" /></label>
                                <label>Scale mode
                                    <select value="@_options.ScaleMode" @onchange="ChangeScaleMode">
                                        @foreach (var mode in Enum.GetValues<MediaConversionScaleMode>()) { <option value="@mode">@mode</option> }
                                    </select>
                                </label>
                                <label>Frame rate<input type="number" min="1" max="1000" step="0.001" value="@NullableNumber(_options.FrameRate)" @onchange="args => _options.FrameRate = NullableDouble(args)" /></label>
                                <label class="check-row"><input type="checkbox" checked="@_options.PreserveAspectRatio" @onchange="args => _options.PreserveAspectRatio = Bool(args)" /> Preserve aspect ratio</label>
                                <label class="check-row"><input type="checkbox" checked="@_options.Deinterlace" @onchange="args => _options.Deinterlace = Bool(args)" /> Deinterlace</label>
                            </div>
                        </details>

                        <details open>
                            <summary>Video encoder</summary>
                            <div class="data-form-grid">
                                <label>Encoder<input value="@_options.VideoCodec" @onchange="args => _options.VideoCodec = Text(args)" placeholder="Preset encoder" list="ffmpeg-encoders" /></label>
                                <label>Encoder preset<input value="@_options.VideoEncoderPreset" @onchange="args => _options.VideoEncoderPreset = Text(args)" placeholder="Preset/encoder default" list="ffmpeg-encoder-presets" /><small class="field-help">Common speed/quality presets are suggested; support remains encoder-specific and the field stays editable.</small></label>
                                <label>CRF / quality<input type="number" min="0" max="63" value="@NullableNumber(_options.Crf)" @onchange="args => _options.Crf = NullableInt(args)" /></label>
                                <label>Bitrate kbit/s<input type="number" min="1" value="@NullableNumber(_options.VideoBitrateKbps)" @onchange="args => _options.VideoBitrateKbps = NullableInt(args)" /></label>
                                <label>Max bitrate kbit/s<input type="number" min="1" value="@NullableNumber(_options.MaximumVideoBitrateKbps)" @onchange="args => _options.MaximumVideoBitrateKbps = NullableInt(args)" /></label>
                                <label>Buffer kbit<input type="number" min="1" value="@NullableNumber(_options.VideoBufferKbps)" @onchange="args => _options.VideoBufferKbps = NullableInt(args)" /></label>
                                <label>Pixel format<input value="@_options.PixelFormat" @onchange="args => _options.PixelFormat = Text(args)" placeholder="Preset/source default" list="ffmpeg-pixel-formats" /><small class="field-help">The selected preset supplies a compatibility-oriented suggestion when known. Any pixel format supported by the installed FFmpeg build can still be entered.</small></label>
                                <label class="check-row"><input type="checkbox" checked="@_options.DisableVideo" @onchange="args => _options.DisableVideo = Bool(args)" /> Remove video</label>
                            </div>
                        </details>

                        <details>
                            <summary>Audio encoder and loudness</summary>
                            <div class="data-form-grid">
                                <label>Encoder<input value="@_options.AudioCodec" @onchange="args => _options.AudioCodec = Text(args)" placeholder="Preset encoder" list="ffmpeg-encoders" /></label>
                                <label>Bitrate kbit/s<input type="number" min="1" value="@NullableNumber(_options.AudioBitrateKbps)" @onchange="args => _options.AudioBitrateKbps = NullableInt(args)" /></label>
                                <label>Sample rate<input type="number" min="1" value="@NullableNumber(_options.AudioSampleRate)" @onchange="args => _options.AudioSampleRate = NullableInt(args)" /></label>
                                <label>Channels<input type="number" min="1" max="32" value="@NullableNumber(_options.AudioChannels)" @onchange="args => _options.AudioChannels = NullableInt(args)" /></label>
                                <label class="check-row"><input type="checkbox" checked="@_options.NormalizeAudio" @onchange="args => _options.NormalizeAudio = Bool(args)" /> EBU loudness normalization</label>
                                <label>Target LUFS<input type="number" min="-70" max="-5" step="0.1" value="@Number(_options.LoudnessTargetLufs)" @onchange="args => _options.LoudnessTargetLufs = Double(args, -16)" /></label>
                                <label class="check-row"><input type="checkbox" checked="@_options.DisableAudio" @onchange="args => _options.DisableAudio = Bool(args)" /> Remove audio</label>
                            </div>
                        </details>

                        <details>
                            <summary>Filters, metadata and any FFmpeg parameter</summary>
                            <label>Video filter graph<textarea rows="3" value="@_options.VideoFilter" @onchange="args => _options.VideoFilter = Text(args)" placeholder="eq=contrast=1.1:saturation=1.2,unsharp=5:5:0.5"></textarea></label>
                            <label>Audio filter graph<textarea rows="3" value="@_options.AudioFilter" @onchange="args => _options.AudioFilter = Text(args)" placeholder="highpass=f=80,acompressor"></textarea></label>
                            <label>Metadata (one key=value per line)<textarea rows="4" value="@MetadataText" @onchange="ChangeMetadata"></textarea></label>
                            <label>Advanced FFmpeg arguments<textarea rows="5" value="@_options.AdvancedArguments" @onchange="args => _options.AdvancedArguments = Text(args)" placeholder="-threads 8 -g 60 -sc_threshold 0"></textarea></label>
                            <p class="field-help">Advanced arguments are passed through <code>ProcessStartInfo.ArgumentList</code>, never through a shell. PublisherStudio blocks input/output/progress arguments it must own, while codec, muxer, mapping, filter, color, hardware and quality options remain available.</p>
                        </details>
                    </div>

                    <datalist id="ffmpeg-encoders">
                        @foreach (var encoder in _capabilities?.Encoders ?? Array.Empty<string>()) { <option value="@encoder"></option> }
                    </datalist>
                    <datalist id="ffmpeg-encoder-presets">
                        @foreach (var preset in EncoderPresetSuggestions) { <option value="@preset"></option> }
                    </datalist>
                    <datalist id="ffmpeg-pixel-formats">
                        @foreach (var format in PixelFormatSuggestions) { <option value="@format"></option> }
                    </datalist>

                    <section class="media-converter-jobs">
                        <header><div><strong>Conversion jobs</strong><span>Click to select; right-click for job actions; double-click completed image, audio, or video output to open its Studio.</span></div></header>
                        @if (_jobs.Count == 0)
                        {
                            <div class="data-visual-empty"><strong>No conversions yet</strong><span>Choose a source, profile or preset, then use Convert in the ribbon.</span></div>
                        }
                        @foreach (var job in _jobs)
                        {
                            <article class="media-converter-job @(job.Id == _selectedJobId ? "selected" : null)"
                                     role="button" tabindex="0" title="Select job; right-click for available actions" @onclick="() => SelectJob(job.Id)" @ondblclick="() => DefaultJobAction(job)"
                                     @oncontextmenu="args => ShowJobContextMenu(job, args)" @oncontextmenu:preventDefault @oncontextmenu:stopPropagation>
                                <div><strong>@job.SourceFileName</strong><br /><small>@PresetName(job.PresetId) · @job.Message</small></div>
                                <span class="converter-status @job.Status.ToString().ToLowerInvariant()">@job.Status</span>
                                <progress max="1" value="@job.Progress"></progress>
                                <div class="panel-inline-actions">
                                    @if (job.Status == MediaConversionJobStatus.Completed)
                                    {
                                        <button type="button" title="Download converted output" @onclick:stopPropagation @onclick="() => Download(job)">Download</button>
                                        <button type="button" title="Insert converted output into the Mainframe" @onclick:stopPropagation @onclick="() => Insert(job)">Insert</button>
                                        @if (CanOpenInStudio(job.OutputMimeType))
                                        {
                                            <button type="button" class="primary" title="@StudioTooltip(job.OutputMimeType)" @onclick:stopPropagation @onclick="() => OpenInStudio(job)">@StudioName(job.OutputMimeType)</button>
                                        }
                                    }
                                    else if (job.Status is MediaConversionJobStatus.Queued or MediaConversionJobStatus.Running)
                                    {
                                        <button type="button" title="Cancel this conversion job" @onclick:stopPropagation @onclick="() => Cancel(job.Id)">Cancel</button>
                                    }
                                    else
                                    {
                                        <button type="button" title="Remove this job from the list" @onclick:stopPropagation @onclick="() => Remove(job.Id)">Remove</button>
                                    }
                                </div>
                                @if (job.OutputSize > 0) { <small>@job.OutputFileName · @FormatBytes(job.OutputSize)</small> }
                            </article>
                        }
                    </section>
                </main>
            </div>
            <footer>
                <span>@(HasSource ? $"Ready: {SourceName}" : "Select a source or send a Mainframe export into the converter.")</span>
                <button type="button" title="Close Media Converter Studio" @onclick="Close">Close</button>
                <button type="button" class="primary" title="Start conversion with the current preset and options" @onclick="Start" disabled="@(!CanStart)">Convert</button>
            </footer>
        </section>
        <DxContextMenu @ref="_contextMenu">
            <Items>
                <DxContextMenuItem Text="Open media…" IconCssClass="pub-icon pub-icon-open" Click="OpenSourcePicker" />
                <DxContextMenuItem Text="@SourceStudioContextCommand" IconCssClass="pub-icon pub-icon-media" Enabled="@CanOpenSourceInStudio" Click="OpenSourceInStudio" />
                <DxContextMenuItem Text="Convert with current settings" IconCssClass="pub-icon pub-icon-play" BeginGroup="true" Enabled="@CanStart" Click="Start" />
                <DxContextMenuItem Text="Save current settings as profile" IconCssClass="pub-icon pub-icon-save" Click="SaveProfile" />
                <DxContextMenuItem Text="Download selected result" IconCssClass="pub-icon pub-icon-download" BeginGroup="true" Enabled="@SelectedJobCompleted" Click="DownloadSelected" />
                <DxContextMenuItem Text="Insert selected result into Mainframe" IconCssClass="pub-icon pub-icon-insert" Enabled="@SelectedJobCompleted" Click="InsertSelected" />
                <DxContextMenuItem Text="@SelectedStudioContextCommand" IconCssClass="pub-icon pub-icon-media" Enabled="@CanOpenSelectedInStudio" Click="OpenSelectedInStudio" />
                <DxContextMenuItem Text="Cancel selected job" IconCssClass="pub-icon pub-icon-stop" BeginGroup="true" Enabled="@SelectedJobRunning" Click="CancelSelected" />
                <DxContextMenuItem Text="Remove selected job" IconCssClass="pub-icon pub-icon-delete" Enabled="@(SelectedJob is not null && !SelectedJobRunning)" Click="RemoveSelected" />
            </Items>
        </DxContextMenu>
    </div>
}

@code {

    /// <summary>
    /// Gets or sets a value indicating whether the value is visible applies to the media converter studio state.
    /// </summary>
    /// <value>The visible value exposed by <see cref="MediaConverterStudio"/>.</value>
    [Parameter] public bool Visible { get; set; }
    /// <summary>
    /// Gets or sets the initial source value that forms part of the media converter studio state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The initial source value exposed by <see cref="MediaConverterStudio"/>.</value>
    [Parameter] public MediaConversionInsertRequest? InitialSource { get; set; }
    /// <summary>
    /// Gets or sets the closed value that forms part of the media converter studio state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The closed value exposed by <see cref="MediaConverterStudio"/>.</value>
    [Parameter] public EventCallback Closed { get; set; }
    /// <summary>
    /// Gets or sets the inserted value that forms part of the media converter studio state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The inserted value exposed by <see cref="MediaConverterStudio"/>.</value>
    [Parameter] public EventCallback<MediaConversionInsertRequest> Inserted { get; set; }
    /// <summary>
    /// Gets or sets the opened in studio value that forms part of the media converter studio state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The opened in studio value exposed by <see cref="MediaConverterStudio"/>.</value>
    [Parameter] public EventCallback<MediaConversionInsertRequest> OpenedInStudio { get; set; }

    /// <summary>
    /// Stores the internal capabilities state used by <see cref="MediaConverterStudio"/> while executing its surrounding workflow.
    /// </summary>
    private MediaConversionCapabilities? _capabilities;
    /// <summary>
    /// Stores the browser file dependency used by <see cref="MediaConverterStudio"/> to delegate that application responsibility to its owning collaborator.
    /// </summary>
    private IBrowserFile? _file;
    /// <summary>
    /// Stores the internal memory source state used by <see cref="MediaConverterStudio"/> while executing its surrounding workflow.
    /// </summary>
    private MediaConversionInsertRequest? _memorySource;
    /// <summary>
    /// Stores the internal last initial source state used by <see cref="MediaConverterStudio"/> while executing its surrounding workflow.
    /// </summary>
    private MediaConversionInsertRequest? _lastInitialSource;
    /// <summary>
    /// Stores the internal preset identifier state used by <see cref="MediaConverterStudio"/> while executing its surrounding workflow.
    /// </summary>
    private string _presetId = string.Empty;
    /// <summary>
    /// Stores the internal options state used by <see cref="MediaConverterStudio"/> while executing its surrounding workflow.
    /// </summary>
    private MediaConversionOptions _options = new();
    /// <summary>
    /// Gets the encoder preset suggestions collection maintained or exposed by this media converter studio instance for downstream processing.
    /// </summary>
    /// <value>The encoder preset suggestions value exposed by <see cref="MediaConverterStudio"/>.</value>
    private IReadOnlyList<string> EncoderPresetSuggestions => RuntimePolicy.GetCollection(PublisherRuntimeCollection.FfmpegEncoderPresetSuggestions);
    /// <summary>
    /// Gets the pixel format suggestions collection maintained or exposed by this media converter studio instance for downstream processing.
    /// </summary>
    /// <value>The pixel format suggestions value exposed by <see cref="MediaConverterStudio"/>.</value>
    private IReadOnlyList<string> PixelFormatSuggestions => RuntimePolicy.GetCollection(PublisherRuntimeCollection.FfmpegPixelFormatSuggestions);
    /// <summary>
    /// Stores the in-memory jobs collection maintained internally by <see cref="MediaConverterStudio"/> for its current workflow state.
    /// </summary>
    private readonly List<MediaConversionJobInfo> _jobs = [];
    /// <summary>
    /// Stores the in-memory profiles collection maintained internally by <see cref="MediaConverterStudio"/> for its current workflow state.
    /// </summary>
    private readonly List<MediaConversionProfile> _profiles = [];
    /// <summary>
    /// Stores the internal selected profile identifier state used by <see cref="MediaConverterStudio"/> while executing its surrounding workflow.
    /// </summary>
    private Guid _selectedProfileId;
    /// <summary>
    /// Stores the internal selected job identifier state used by <see cref="MediaConverterStudio"/> while executing its surrounding workflow.
    /// </summary>
    private Guid? _selectedJobId;
    /// <summary>
    /// Stores the internal profile name state used by <see cref="MediaConverterStudio"/> while executing its surrounding workflow.
    /// </summary>
    private string _profileName = "My conversion profile";
    /// <summary>
    /// Stores the internal profile description state used by <see cref="MediaConverterStudio"/> while executing its surrounding workflow.
    /// </summary>
    private string _profileDescription = string.Empty;
    /// <summary>
    /// Stores the cancellation source used by <see cref="MediaConverterStudio"/> to stop its current background or asynchronous operation.
    /// </summary>
    private CancellationTokenSource? _polling;
    /// <summary>
    /// Stores the internal self state used by <see cref="MediaConverterStudio"/> while executing its surrounding workflow.
    /// </summary>
    private DotNetObjectReference<MediaConverterStudio>? _self;
    /// <summary>
    /// Stores the internal source drop zone state used by <see cref="MediaConverterStudio"/> while executing its surrounding workflow.
    /// </summary>
    private ElementReference _sourceDropZone;
    /// <summary>
    /// Stores the internal context menu state used by <see cref="MediaConverterStudio"/> while executing its surrounding workflow.
    /// </summary>
    private DxContextMenu _contextMenu = default!;
    /// <summary>
    /// Stores the internal drop bound state used by <see cref="MediaConverterStudio"/> while executing its surrounding workflow.
