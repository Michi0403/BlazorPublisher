@namespace PublisherStudio.Components.Editor
@using PublisherStudio.Services.Configuration
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject PublicationMediaAssetStore MediaAssets
@inject MediaTimelineEditService TimelineEdits
@inject VideoProjectImportService VideoProjectImporter
@inject VideoLayerInterchangeService VideoLayerInterchange
@inject IPublisherRuntimePolicyDataService RuntimePolicy
@inject IPanelStudioPreviewPresetService PreviewPresets
@inject IFileLocalizationService Localization
@inject ILogger<MediaStudio> Logger
@inject PublicationEditorTextService EditorText

@inject ISupervisedTaskRunner TaskRunner
@if (Visible)
{
    <div class="editor-modal-backdrop media-studio-backdrop">
        <section id="media-studio-window" class="media-studio-window" tabindex="0" role="dialog" aria-modal="true" aria-label="@(IsVideo ? LT("Video Studio") : LT("Audio Studio"))">
            <header class="media-studio-titlebar">
                <div>
                    <strong>@(IsVideo ? LT("Video Studio") : LT("Audio Studio"))</strong>
                    <span>@(EditingExisting ? LT("Edit the selected media object") : IsVideo ? LT("Import or record a video") : LT("Import, record, trim, and mix a simple audio clip"))</span>
                </div>
                <button type="button" title='@LT("Close")' @onclick="Cancel">×</button>
            </header>

            <DxRibbon CssClass="media-studio-ribbon categorized-ribbon" SizeMode="SizeMode.Medium" AdaptivityAutoCollapseItemsToGroups="true">
                <DxRibbonTab Text='@LT("Home")'>
                    <DxRibbonGroup Text='@LT("Source")' IconCssClass="pub-icon pub-icon-media">
                        <DxRibbonItem Text="@ImportMenuText" IconCssClass="pub-icon pub-icon-open" IsPrimary="true" Enabled="@(!_recording && !_recordingStopping)" Click="OpenMediaPicker" />
                        @if (IsVideo)
                        {
                            <DxRibbonItem Text='@LT("Import project…")' IconCssClass="pub-icon pub-icon-open" Enabled="@(!_recording && !_recordingStopping)" Click="OpenVideoProjectPicker" />
                            <DxRibbonItem Text='@LT("Relink media…")' IconCssClass="pub-icon pub-icon-refresh" Enabled="@HasVideoProject" Click="OpenVideoProjectMediaPicker" />
                            <DxRibbonItem Text='@LT("Record camera")' IconCssClass="pub-icon pub-icon-video" Enabled="@(!_recording && !_recordingStopping && !_recordingPlacementRequired && !_recordingStartPlacementRequired)" Click="RecordCamera" />
                            <DxRibbonItem Text='@LT("Record screen")' IconCssClass="pub-icon pub-icon-video" Enabled="@(!_recording && !_recordingStopping && !_recordingPlacementRequired && !_recordingStartPlacementRequired)" Click="RecordScreen" />
                        }
                        else
                        {
                            <DxRibbonItem Text='@LT("Record microphone")' IconCssClass="pub-icon pub-icon-audio" Enabled="@(!_recording && !_recordingStopping && !_recordingPlacementRequired)" Click="RecordMicrophone" />
                            <DxRibbonItem Text='@LT("Generate tone")' IconCssClass="pub-icon pub-icon-audio" Enabled="@(!_recording && !_recordingStopping)" Click="GenerateTone" />
                        }
                        <DxRibbonItem Text='@LT("Stop recording")' IconCssClass="pub-icon pub-icon-stop" Enabled="@(_recording && !_recordingStopping)" Click="StopRecording" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text='@LT("Playback")' IconCssClass="pub-icon pub-icon-play">
                        <DxRibbonItem Text='@LT("Play range")' IconCssClass="pub-icon pub-icon-play" Enabled="@HasSource" Click="PlaySelection" />
                        <DxRibbonItem Text='@LT("Pause")' IconCssClass="pub-icon pub-icon-pause" Enabled="@HasSource" Click="PausePreview" />
                        <DxRibbonItem Text='@LT("To trim start")' IconCssClass="pub-icon pub-icon-crop" Enabled="@HasSource" Click="SeekStart" />
                    </DxRibbonGroup>
                    @if (IsVideo)
                    {
                        <DxRibbonGroup Text='@LT("Canvas")' IconCssClass="pub-icon pub-icon-video">
                            <DxRibbonItem Text="@VideoFitModeText(PublicationVideoFitMode.Stretch, "Stretch")" Enabled="@HasSource" Click="VideoFitStretch" />
                            <DxRibbonItem Text="@VideoFitModeText(PublicationVideoFitMode.Cover, "Fill canvas")" Enabled="@HasSource" Click="VideoFitCover" />
                            <DxRibbonItem Text="@VideoFitModeText(PublicationVideoFitMode.Contain, "Fit whole")" Enabled="@HasSource" Click="VideoFitContain" />
                        </DxRibbonGroup>
                    }
                </DxRibbonTab>
                <DxRibbonTab Text='@LT("Edit")'>
                    <DxRibbonGroup Text='@LT("Pointer")' IconCssClass="pub-icon pub-icon-select">
                        <DxRibbonItem Text="@MouseModeText(MediaStudioMouseMode.SelectSection, "Select time")" IconCssClass="pub-icon pub-icon-select" Click="SelectSectionMode" />
                        <DxRibbonItem Text="@MouseModeText(MediaStudioMouseMode.PlacePlayhead, "Place playhead")" IconCssClass="pub-icon pub-icon-line" Enabled="@HasSource" Click="PlacePlayheadMode" />
                        <DxRibbonItem Text="@MouseModeText(MediaStudioMouseMode.AddCutLine, "Add cutline")" IconCssClass="pub-icon pub-icon-crop" Enabled="@HasSource" Click="AddCutLineMode" />
                        @if (IsVideo)
                        {
                            <DxRibbonItem Text="@MouseModeText(MediaStudioMouseMode.FrameRegion, "Frame region")" IconCssClass="pub-icon pub-icon-select" Enabled="@HasSource" Click="FrameRegionMode" />
                        }
                    </DxRibbonGroup>
                    <DxRibbonGroup Text='@LT("Trim")' IconCssClass="pub-icon pub-icon-crop">
                        <DxRibbonItem Text='@LT("Start at playhead")' Enabled="@HasSource" Click="SetTrimStartAtPlayhead" />
                        <DxRibbonItem Text='@LT("End at playhead")' Enabled="@HasSource" Click="SetTrimEndAtPlayhead" />
                        <DxRibbonItem Text='@LT("Reset trim")' Enabled="@HasSource" Click="ResetTrim" />
                    </DxRibbonGroup>
                    @if (IsVideo)
                    {
                        <DxRibbonGroup Text='@LT("Selection")'>
                            <DxRibbonItem Text='@LT("Cut selection")' IconCssClass="pub-icon pub-icon-line" Enabled="@CanCutVideoSelection" Click="CutVideoSelection" />
                            <DxRibbonItem Text='@LT("Trim to selection")' IconCssClass="pub-icon pub-icon-crop" Enabled="@CanUseVideoSelectionAsTrim" Click="UseVideoSelectionAsTrim" />
                            <DxRibbonItem Text='@LT("Copy selection")' IconCssClass="pub-icon pub-icon-copy" Enabled="@CanCopyVideoSelection" Click="CopyVideoSelection" />
                        </DxRibbonGroup>
                        <DxRibbonGroup Text='@LT("Saved sections")' IconCssClass="pub-icon pub-icon-line">
                            <DxRibbonItem Text='@LT("Save section")' Enabled="@CanSaveCutSection" Click="SaveSelectedRangeAsCutSection" />
                            <DxRibbonItem Text='@LT("Use section")' Enabled="@(SelectedCutSection is not null)" Click="UseSelectedCutSection" />
                            <DxRibbonItem Text='@LT("Remove section")' IconCssClass="pub-icon pub-icon-delete" Enabled="@(SelectedCutSection is not null)" Click="RemoveSelectedCutSection" />
                        </DxRibbonGroup>
                    }
                    <DxRibbonGroup Text='@LT("Sequence")' IconCssClass="pub-icon pub-icon-line">
                        <DxRibbonItem Text='@LT("Cut at playhead")' Enabled="@CanAddCutLine" Click="AddCutLineAtPlayhead" />
                        <DxRibbonItem Text='@LT("Remove cutline")' Enabled="@CanRemoveCutLine" Click="RemoveCutLine" />
                        <DxRibbonItem Text='@LT("Copy")' IconCssClass="pub-icon pub-icon-copy" Enabled="@HasSelectedSegment" Click="CopySelectedSection" />
                        <DxRibbonItem Text='@LT("Paste")' IconCssClass="pub-icon pub-icon-paste" Enabled="@CanPasteSection" Click="PasteSection" />
                        <DxRibbonItem Text='@LT("Delete")' IconCssClass="pub-icon pub-icon-delete" Enabled="@CanDeleteSection" Click="DeleteSelectedSection" />
                        <DxRibbonItem Text='@LT("Insert media…")' IconCssClass="pub-icon pub-icon-insert" Enabled="@HasSource" Click="OpenInsertMediaPicker" />
                    </DxRibbonGroup>
                </DxRibbonTab>
                @if (IsVideo)
                {
                    <DxRibbonTab Text='@LT("Layers")'>
                        <DxRibbonGroup Text='@LT("Layer stack")' IconCssClass="pub-icon pub-icon-layers">
                            <DxRibbonItem Text='@LT("Add layer")' Enabled="@HasSelectedSegment" Click="AddVideoLayer" />
                            <DxRibbonItem Text='@LT("Duplicate")' Enabled="@(SelectedVideoLayer is not null)" Click="DuplicateVideoLayer" />
                            <DxRibbonItem Text='@LT("Selection → new layer")' Enabled="@CanCreateSelectionLayer" Click="CreateSelectionLayer" />
                            <DxRibbonItem Text='@LT("Selection → layer")' Enabled="@CanApplySelectionToLayer" Click="ApplySelectionToSelectedVideoLayer" />
                            <DxRibbonItem Text='@LT("Layer up")' Enabled="@CanMoveVideoLayerUp" Click="MoveVideoLayerUp" />
                            <DxRibbonItem Text='@LT("Layer down")' Enabled="@CanMoveVideoLayerDown" Click="MoveVideoLayerDown" />
                            <DxRibbonItem Text='@LT("Delete layer")' IconCssClass="pub-icon pub-icon-delete" Enabled="@CanDeleteVideoLayer" Click="DeleteVideoLayer" />
                        </DxRibbonGroup>
                        <DxRibbonGroup Text='@LT("3D surface")' IconCssClass="pub-icon pub-icon-effects">
                            <DxRibbonItem Text='@LT("Extrude selected layer")' Enabled="@(SelectedVideoLayer is not null)" Click="ConvertSelectedLayerToBlob" />
                            <DxRibbonItem Text='@LT("Insert 3D in Mainframe")' Enabled="@CanInsertLayerIntoMainframe" Click="InsertSelectedLayerIntoMainframe" />
                        </DxRibbonGroup>
                    </DxRibbonTab>
                    <DxRibbonTab Text='@LT("Effects")'>
                        <DxRibbonGroup Text='@LT("Quick effects")' IconCssClass="pub-icon pub-icon-effects">
                            <DxRibbonItem Text='@LT("Chroma key")' Enabled="@(SelectedVideoLayer is not null)" Click="AddChromaKeyFilter" />
                            <DxRibbonItem Text='@LT("Vignette")' Enabled="@(SelectedVideoLayer is not null)" Click="AddVignetteFilter" />
                            <DxRibbonItem Text='@LT("Blur")' Enabled="@(SelectedVideoLayer is not null)" Click="AddBlurFilter" />
                            <DxRibbonItem Text='@LT("Film grain")' Enabled="@(SelectedVideoLayer is not null)" Click="AddGrainFilter" />
                            <DxRibbonItem Text='@LT("Color adjustment")' Enabled="@(SelectedVideoLayer is not null)" Click="AddColorAdjustmentFilters" />
                        </DxRibbonGroup>
                        <DxRibbonGroup Text='@LT("Effect stack")' IconCssClass="pub-icon pub-icon-layers">
                            <DxRibbonItem Text='@LT("Add selected effect")' Enabled="@(SelectedVideoLayer is not null)" Click="AddSelectedVideoFilter" />
                            <DxRibbonItem Text='@LT("Effect up")' Enabled="@CanMoveVideoFilterUp" Click="MoveVideoFilterUp" />
                            <DxRibbonItem Text='@LT("Effect down")' Enabled="@CanMoveVideoFilterDown" Click="MoveVideoFilterDown" />
                            <DxRibbonItem Text='@LT("Remove effect")' IconCssClass="pub-icon pub-icon-delete" Enabled="@(SelectedVideoFilter is not null)" Click="RemoveSelectedVideoFilter" />
                        </DxRibbonGroup>
                    </DxRibbonTab>
                }
                <DxRibbonTab Text='@LT("Output")'>
                    <DxRibbonGroup Text='@LT("Recording")' IconCssClass="pub-icon pub-icon-download">
                        <DxRibbonItem Text="@DownloadMediaText" IconCssClass="pub-icon pub-icon-download" Enabled="@CanDownloadCurrentMedia" Click="DownloadRecording" />
                    </DxRibbonGroup>
                    @if (IsVideo)
                    {
                        <DxRibbonGroup Text='@LT("Rendered video")' IconCssClass="pub-icon pub-icon-effects">
                            <DxRibbonItem Text='@LT("Render selected range to video…")' IconCssClass="pub-icon pub-icon-download" Enabled="@(HasSource && !_renderingVideoExport && !_renderingTimelineSelectionExport)" Click="RenderEffectsToVideo" />
                            <DxRibbonItem Text='@LT("Export selected ranges separately…")' IconCssClass="pub-icon pub-icon-download" Enabled="@CanExportSelectedTimelineRanges" Click="ExportSelectedTimelineRangesSeparately" />
                            <DxRibbonItem Text='@LT("Export selected ranges combined…")' IconCssClass="pub-icon pub-icon-download" Enabled="@CanExportSelectedTimelineRanges" Click="ExportSelectedTimelineRangesCombined" />
                            <DxRibbonItem Text='@LT("Cancel rendered export")' IconCssClass="pub-icon pub-icon-stop" Enabled="@(_renderingVideoExport || _renderingTimelineSelectionExport)" Click="CancelRenderedVideoExport" />
                        </DxRibbonGroup>
                    }
                    <DxRibbonGroup Text='@LT("Convert")' IconCssClass="pub-icon pub-icon-media">
                        <DxRibbonItem Text='@LT("Send selection to converter")' Enabled="@HasSelectedSegment" Click="SendSelectedMediaToConverter" />
                    </DxRibbonGroup>
                </DxRibbonTab>
            </DxRibbon>
            <div class="media-studio-source-state" role="status">@SourceStatus</div>

            <div class="media-studio-body">
                <div class="media-studio-preview-column">
                    <div class="media-studio-preview-shell @(IsVideo ? "video" : "audio") @(_mouseMode == MediaStudioMouseMode.FrameRegion ? "frame-region-mode" : null)"
                         @oncontextmenu="ShowMediaContextMenu" @oncontextmenu:preventDefault>
                        @if (IsVideo)
                        {
                            <div id="media-studio-frame-stage" class="media-studio-frame-stage">
                                <video id="media-studio-preview"
                                       src="@_previewSource"
                                       poster="@_posterDataUrl"
                                       playsinline
                                       preload="metadata"
                                       disablepictureinpicture
                                       controlslist="nofullscreen nodownload noremoteplayback"
                                       class="media-studio-video-surface"
                                       style="@VideoPreviewStyle"></video>
                                <canvas id="media-studio-video-effects" class="media-studio-video-effects" aria-hidden="true"></canvas>
                                <div class="media-video-mode-hud" aria-live="polite">
                                    <b>@MouseModeLabel</b>
                                    <span>@VideoCanvasModeHelp</span>
                                </div>
                                <div id="media-studio-video-time-overlay"
                                     class="media-video-time-overlay @(_videoSelectionIsPoint ? "point-selection" : "range-selection") @(_mouseMode == MediaStudioMouseMode.FrameRegion ? "disabled" : null)"
                                     data-duration="@Inv(_duration)"
                                     data-trim-start="@Inv(_trimStart)"
                                     data-trim-end="@Inv(_trimEnd)"
                                     data-selection-start="@Inv(VideoSelectionStart)"
                                     data-selection-end="@Inv(VideoSelectionEnd)"
                                     data-selection-point="@(_videoSelectionIsPoint ? "true" : "false")"
                                     data-clip-name="@SelectedClipName"
                                     data-sequence-duration="@Inv(SequenceDuration)"
                                     data-segment-timeline-start="@Inv(SelectedSegmentTimelineStart)"
                                     data-segment-source-start="@Inv(SelectedSegmentSourceStart)"
                                     data-playback-rate="@Inv(_playbackRate)"
                                     data-volume="@Inv(_volume)"
                                     data-muted="@(_muted ? "true" : "false")"
                                     data-loop="@(_loop ? "true" : "false")"
                                     data-mouse-mode="@_mouseMode"
                                     style="@VideoTimeOverlayStyle"
                                     role="application"
                                     aria-label='@LT("Video timestamp and range selector")'>
                                    <div class="media-video-time-track" data-video-time-track aria-label='@LT("Selected video timestamp or range")'>
                                        <span class="media-video-time-selected" aria-hidden="true"></span>
                                        <span class="media-video-time-handle start" data-video-time-handle="start" title='@LT("Drag selection start")'></span>
                                        <span class="media-video-time-handle end" data-video-time-handle="end" title='@LT("Drag selection end")'></span>
                                        <span class="media-video-time-point" aria-hidden="true"></span>
                                        <span class="media-video-time-playhead" aria-hidden="true"></span>
                                        <span class="media-video-time-drop-marker" aria-hidden="true"></span>
                                    </div>
                                    @foreach (var cutSection in SelectedCutSections)
                                    {
                                        <button type="button"
                                                class="media-video-cut-section @(cutSection.Id == _selectedCutSectionId ? "selected" : null)"
                                                style="@VideoCutSectionStyle(cutSection)"
                                                title="@($"{cutSection.Name}: {Time(cutSection.StartSeconds)} — {Time(cutSection.EndSeconds)}")"
                                                data-video-time-control
                                                @onclick="() => SelectCutSection(cutSection.Id)"
                                                @onclick:stopPropagation></button>
                                    }
                                    <div class="media-video-time-toolbar media-video-transport-dock" data-video-time-control>
                                        <div class="media-video-transport-buttons">
                                            <button type="button" title='@LT("Play selected range")' data-video-command="play"><i class="pub-icon pub-icon-play" aria-hidden="true"></i></button>
                                            <button type="button" title='@LT("Pause video")' data-video-command="pause"><i class="pub-icon pub-icon-pause" aria-hidden="true"></i></button>
                                        </div>
                                        <label class="media-video-pointer-mode">
                                            <span>@LT("Pointer")</span>
                                            <select value="@_mouseMode" @onchange="ChangeVideoCanvasMouseMode">
                                                <option value="@MediaStudioMouseMode.SelectSection">@LT("Select time")</option>
                                                <option value="@MediaStudioMouseMode.PlacePlayhead">@LT("Place playhead")</option>
                                                <option value="@MediaStudioMouseMode.AddCutLine">@LT("Add cutline")</option>
                                                <option value="@MediaStudioMouseMode.FrameRegion">@LT("Frame region")</option>
                                            </select>
                                        </label>
                                        <span class="media-video-time-readout">
                                            <b id="media-studio-video-selection-label">@VideoSelectionLabel</b>
                                            <span id="media-studio-video-current-time">@Time(VideoSelectionStart)</span>
                                            <span id="media-studio-video-selection-readout">@VideoSelectionReadout</span>
                                        </span>
                                        <span class="media-video-time-help">@SelectedClipName · @VideoCanvasModeHelp</span>
                                    </div>

                                    @if (_pendingInsertSegment is not null)
                                    {
                                        <div class="media-video-insert-placement" data-video-time-control @onpointerdown:stopPropagation @onclick:stopPropagation>
                                            <div>
                                                <b>@LT("Insert dropped video")</b>
                                                <span>@_pendingInsertSegment.Name</span>
                                            </div>
                                            @if (_pendingInsertTimelineSeconds.HasValue)
                                            {
                                                <span class="media-video-insert-fixed">@LT("Timeline drop position is fixed at") @Time(_pendingInsertTimelineSeconds.Value).</span>
                                            }
                                            else if (PendingInsertHasRange)
                                            {
                                                <label>
                                                    @LT("Position inside selection")
                                                    <input type="range"
                                                           min="@Inv(_pendingInsertMinimumSourceSeconds)"
                                                           max="@Inv(_pendingInsertMaximumSourceSeconds)"
                                                           step="0.01"
                                                           value="@Inv(_pendingInsertSourceSeconds)"
                                                           @oninput="ChangePendingInsertPosition" /> </label>
                                            }
                                            else
                                            {
                                                <span class="media-video-insert-fixed">@LT("The selected timestamp is fixed.")</span>
                                            }
                                            <div class="media-video-insert-actions">
                                                <time>@Time(_pendingInsertTimelineSeconds ?? _pendingInsertSourceSeconds)</time>
                                                <button type="button" @onclick="ConfirmPendingInsert">@LT("Insert here")</button>
                                                <button type="button" @onclick="CancelPendingInsert">@LT("Cancel")</button>
                                            </div>
                                        </div>
                                    }
                                    @if (_recordingStartPlacementRequired && IsVideo)
                                    {
                                        <div class="media-video-insert-placement media-recording-placement" data-video-time-control @onpointerdown:stopPropagation @onclick:stopPropagation>
                                            <div>
                                                <b>@LT("Place next recording")</b>
                                                <span>@LT("Choose the sequence boundary before the browser starts recording. The finished recording will keep this position selected for insertion.")</span>
                                            </div>
                                            <label>
                                                @LT("Recording position")
                                                <select value="@_recordingStartPlacementBoundary" @onchange="ChangeRecordingStartPlacementBoundary">
                                                    @for (var boundary = 0; boundary <= _segments.Count; boundary++)
                                                    {
                                                        <option value="@boundary">@RecordingPlacementLabel(boundary)</option>
                                                    }
                                                </select>
                                            </label>
                                            <div class="media-video-insert-actions">
                                                <button type="button" @onclick="ConfirmRecordingStartPlacement">@LT("Start recording here")</button>
                                                <button type="button" @onclick="CancelRecordingStartPlacement">@LT("Cancel")</button>
                                            </div>
                                        </div>
                                    }
                                    @if (_recordingPlacementRequired && HasRetainedRecording)
                                    {
                                        <div class="media-video-insert-placement media-recording-placement" data-video-time-control @onpointerdown:stopPropagation @onclick:stopPropagation>
                                            <div>
                                                <b>@LT("Place new recording")</b>
                                                <span>@LT("Choose where the completed recording belongs in the existing video sequence.")</span>
                                            </div>
                                            <label>
                                                @LT("Recording position")
                                                <select value="@_recordingPlacementBoundary" @onchange="ChangeRecordingPlacementBoundary">
                                                    @for (var boundary = 0; boundary <= _segments.Count; boundary++)
                                                    {
                                                        <option value="@boundary">@RecordingPlacementLabel(boundary)</option>
                                                    }
                                                </select>
                                            </label>
                                            <div class="media-video-insert-actions">
                                                <button type="button" disabled="@_embedding" @onclick="ConfirmRecordingPlacement">@LT("Insert recording")</button>
                                                <button type="button" disabled="@_embedding" @onclick="CancelRecordingPlacement">@LT("Keep uninserted")</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div id="media-studio-frame-overlay-host"
                                     class="media-studio-frame-overlay-host @(_mouseMode == MediaStudioMouseMode.FrameRegion ? "active" : null)"
                                     role="application"
                                     aria-label='@LT("Video frame region selection")'
                                     @onpointerdown="FrameOverlayPointerDown"
                                     @onpointerdown:preventDefault
                                     @onpointerdown:stopPropagation
                                     @ondblclick="FinishFrameRegion"
                                     @ondblclick:preventDefault
                                     @ondblclick:stopPropagation
                                     @oncontextmenu="ShowMediaContextMenu"
                                     @oncontextmenu:preventDefault
                                     @oncontextmenu:stopPropagation>
                                    <svg class="media-studio-frame-overlay" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
                                        <path class="media-frame-dim" d="@FrameDimPath" fill-rule="evenodd" />
                                        @if (ActiveFramePoints.Count >= 2)
                                        {
                                            <polyline class="media-frame-cutline" points="@FramePolylinePoints" />
                                        }
                                        @if (ActiveFramePoints.Count >= 3)
                                        {
                                            <polygon class="media-frame-selection" points="@FramePolygonPoints" />
                                        }
                                        @for (var pointIndex = 0; pointIndex < ActiveFramePoints.Count; pointIndex++)
                                        {
                                            var point = ActiveFramePoints[pointIndex];
                                            <circle class="media-frame-node @(pointIndex == _selectedFramePointIndex ? "selected" : null)" data-frame-node-index="@pointIndex" cx="@Inv(point.X * 1000)" cy="@Inv(point.Y * 1000)" r="9" />
                                        }
                                    </svg>
                                    <span class="media-frame-cursor-ring" aria-hidden="true"></span>
                                    <div class="media-frame-mode-help">
                                        <b>@(_editingMorphRegion ? LT("Morph target mode") : LT("Frame region mode"))</b>
                                        <span>@LT("Click selects or adds a point · drag moves it · Delete removes the selected point")</span>
                                    </div>
                                    <div class="media-frame-overlay-actions" @onpointerdown:stopPropagation>
                                        <button type="button" disabled="@(!CanFinishFrameRegion)" @onclick="FinishFrameRegion">@LT("Apply region")</button>
                                        <button type="button" disabled="@(SelectedFramePoint is null)" @onclick="RemoveSelectedFramePoint">@LT("Delete point")</button>
                                        <button type="button" disabled="@(!_frameRegionEditing || _frameDraft.Count == 0)" @onclick="RemoveLastFramePoint">@LT("Undo point")</button>
                                        <button type="button" @onclick="CancelFrameRegion">@LT("Exit mode")</button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="media-studio-audio-card">
                                <div class="media-studio-waveform" aria-label='@LT("Audio waveform")'>
                                    @foreach (var sample in DisplayWaveform)
                                    {
                                        <i style="height:@WaveHeight(sample)"></i>
                                    }
                                </div>
                                <audio id="media-studio-preview" src="@_previewSource" controls preload="metadata"></audio>
                            </div>
                        }
                    </div>

                    <div class="media-transport-status" role="status">
                        <strong id="media-studio-selection-title">@VideoOrAudioSelectionTitle</strong>
                        <span id="media-studio-selection-summary">@VideoOrAudioSelectionSummary</span>
                    </div>

                    @if (HasSource)
                    {
                        <div class="media-sequence-editor">
                            <div class="media-range-caption"><b>@LT("Sequence")</b><span>@Time(SequenceDuration) · @_segments.Count @(_segments.Count == 1 ? LT("section") : LT("sections"))</span></div>
                            <div id="media-studio-sequence-timeline" class="media-sequence-timeline mode-@_mouseMode.ToString().ToLowerInvariant()" tabindex="0"
                                 data-sequence-duration="@Inv(SequenceDuration)"
                                 data-segment-timeline-start="@Inv(SelectedSegmentTimelineStart)"
                                 data-segment-source-start="@Inv(SelectedSegmentSourceStart)"
                                 data-segment-source-end="@Inv(SelectedSegmentSourceEnd)"
                                 data-segment-effective-rate="@Inv(SelectedSegmentEffectiveRate)"
                                 data-selected-segment-id="@(_selectedSegmentId?.ToString() ?? string.Empty)"
                                 @onpointerdown="TimelinePointerDown"
                                 @oncontextmenu="ShowTimelineContextMenu" @oncontextmenu:preventDefault>
                                @foreach (var segment in _segments)
                                {
                                    <button type="button" class="media-sequence-segment @(_selectedSegmentIds.Contains(segment.Id) ? "selected" : null) @(segment.Id == _selectedSegmentId ? "primary-selected" : null) @(segment.IsGap ? "gap" : string.IsNullOrWhiteSpace(segment.DataUrl) ? "offline" : null)"
                                            style="@SegmentStyle(segment)" title="@SegmentTitle(segment)"
                                            data-media-segment-id="@segment.Id"
                                            data-media-segment-name="@segment.Name"
                                            data-media-segment-mime="@segment.MimeType"
                                            draggable="@(!segment.IsGap)"
                                            @onpointerdown:stopPropagation
                                            @onclick="(MouseEventArgs args) => SelectTimelineSegment(segment.Id, args)">
                                        <span>@segment.Name</span>
                                    </button>
                                }
                                @foreach (var boundary in CutBoundaryPositions)
                                {
                                    <i class="media-cutline" style="left:@Percent(boundary / Math.Max(.01, SequenceDuration))"></i>
                                }
                                @if (IsVideo && HasSelectedSegment)
                                {
                                    <i id="media-studio-sequence-selection"
                                       class="media-sequence-selection @(_videoSelectionIsPoint ? "point" : "range")"
                                       style="@VideoSequenceSelectionStyle"
                                       title="@VideoSequenceSelectionTitle"></i>
                                    <button id="media-studio-sequence-selection-start" type="button"
                                            class="media-sequence-selection-boundary start"
                                            data-sequence-selection-handle="start"
                                            style="@VideoSequenceSelectionStartStyle"
                                            title='@LT("Drag selection start")' aria-label='@LT("Drag video selection start")'
                                            hidden="@_videoSelectionIsPoint"></button>
                                    <button id="media-studio-sequence-selection-end" type="button"
                                            class="media-sequence-selection-boundary end"
                                            data-sequence-selection-handle="end"
                                            style="@VideoSequenceSelectionEndStyle"
                                            title='@LT("Drag selection end")' aria-label='@LT("Drag video selection end")'
                                            hidden="@_videoSelectionIsPoint"></button>
                                }
                                <i id="media-studio-sequence-playhead" class="media-playhead" style="left:@Percent(_playhead / Math.Max(.01, SequenceDuration))"></i>
                            </div>
                            <div class="media-sequence-status">
                                <span><b>@LT("Mode:")</b> @MouseModeLabel</span>
                                <span><b>@LT("Playhead:")</b> @Time(_playhead)</span>
                                <span><b>@LT("Selected:")</b> @SelectedSectionSummary</span>
                            </div>
                        </div>

                        @if (!IsVideo)
                        {
                            <div class="media-range-selector" @oncontextmenu="ShowMediaContextMenu" @oncontextmenu:preventDefault>
                                <div class="media-range-caption"><b>@LT("Trim range")</b><span>@Time(_trimEnd - _trimStart) @LT("selected")</span></div>
                                <DxRangeSelector Height="96px"
                                                 SelectedRangeStartValue="@_trimStart"
                                                 SelectedRangeEndValue="@_trimEnd"
                                                 ValueChanged="TrimRangeChanged"
                                                 ValueChangeMode="RangeSelectorValueChangeMode.OnHandleMove"
                                                 AllowMouseSelection="true"
                                                 MoveSelectedRangeByClick="true">
                                    <DxRangeSelectorScale StartValue="@(0d)"
                                                          EndValue="@RangeSelectorEnd"
                                                          ValueType="ChartAxisDataType.Numeric"
                                                          TickInterval="@MajorTick"
                                                          MinorTickInterval="@MinorTick"
                                                          MinRange="@RangeSelectorMinRange">
                                        <DxRangeSelectorScaleMarker Visible="false" />
                                    </DxRangeSelectorScale>
                                    <DxRangeSelectorSliderMarker Visible="true" />
                                </DxRangeSelector>
                            </div>
                        }
                    }
                </div>

                <aside class="media-studio-properties">
                    <section>
                        <h3>@LT("Clip")</h3>
                        <label>@LT("Name")<input value="@_name" @onchange="ChangeName" /></label>
                        <div class="property-grid two">
                            <label>@LT("Trim start")<input type="number" min="0" max="@Inv(_duration)" step="0.01" value="@Inv(_trimStart)" @onchange="ChangeTrimStart" /></label>
                            <label>@LT("Trim end")<input type="number" min="0" max="@Inv(_duration)" step="0.01" value="@Inv(_trimEnd)" @onchange="ChangeTrimEnd" /></label>
                        </div>
                        <label>@LT("Playback rate") <b>@_playbackRate.ToString("0.##", CultureInfo.InvariantCulture)×</b>
                            <input type="range" min="0.25" max="2" step="0.05" value="@Inv(_playbackRate)" @oninput="ChangePlaybackRate" /> </label>
                        <label>@LT("Volume") <b>@Math.Round(_volume * 100)%</b>
                            <input type="range" min="0" max="1" step="0.01" value="@Inv(_volume)" @oninput="ChangeVolume" /> </label>
                        <label class="check-row"><input type="checkbox" checked="@_muted" @onchange="ToggleMuted" /> @LT("Muted")</label>
                        <label class="check-row"><input type="checkbox" checked="@_loop" @onchange="ToggleLoop" /> @LT("Loop selected range")</label>
                    </section>

                    @if (IsVideo)
                    {
                        @if (HasVideoProject)
                        {
                            <section class="media-video-project-properties">
                                <h3>@LT("Imported video project")</h3>
                                <p class="property-note"><b>@VideoProjectTitle</b> · @VideoProjectFormatSummary</p>
                                <div class="media-video-project-summary">
                                    <span>@VideoProjectCanvasSummary</span>
                                    <span>@VideoProjectTrackSummary</span>
                                    <span>@VideoProjectMissingSummary</span>
                                </div>
                                <label>@LT("Editable video track")
                                    <select value="@_activeProjectTrackId" @onchange="ChangeProjectTrack">
                                        @foreach (var track in ProjectVideoTracks)
                                        {
                                            <option value="@track.Id">@track.Name (@track.Segments.Count clips)</option>
                                        }
                                    </select>
                                </label>
                                <div class="property-action-row">
                                    <DxButton Text='@LT("Import another project")' Click="OpenVideoProjectPicker" />
                                    <DxButton Text='@LT("Relink media")' Enabled="@(VideoProjectMissingMediaCount > 0)" Click="OpenVideoProjectMediaPicker" />
                                </div>
                                @if (_videoProjectIssues.Count > 0)
                                {
                                    <details class="media-video-project-report">
                                        <summary>@LT("Compatibility report") · @_videoProjectIssues.Count @(_videoProjectIssues.Count == 1 ? LT("item") : LT("items"))</summary>
                                        @foreach (var issue in _videoProjectIssues.Take(12))
                                        {
                                            <p class="issue-@issue.Severity.ToString().ToLowerInvariant()"><b>@issue.Code</b> · @issue.Message</p>
                                        }
                                    </details>
                                }
                                <p class="property-note">@LT("All imported tracks, gaps, source references, markers and transitions stay in the canonical project. This editor displays and edits the selected video-track projection; preserved audio and additional video tracks remain available for later orchestration.")</p>
                            </section>
                        }
                        <section class="media-video-selection-properties">
                            <h3>@LT("Selected clip time")</h3>
                            <p class="property-note"><b>@SelectedClipName</b> · @LT("source timestamps stay linked to the highlighted clip in the project sequence.")</p>
                            <label>@LT("Selection type")
                                <select id="media-studio-video-selection-mode" value="@(_videoSelectionIsPoint ? "Point" : "Range")" @onchange="ChangeVideoSelectionMode">
                                    <option value="Point">@LT("Single timestamp")</option>
                                    <option value="Range">@LT("Time range")</option>
                                </select>
                            </label>
                            <div class="property-grid two">
                                <label>@LT("Selection start")
                                    <input id="media-studio-video-selection-start"
                                           type="number"
                                           min="@Inv(_trimStart)"
                                           max="@Inv(_trimEnd)"
                                           step="0.01"
                                           value="@Inv(VideoSelectionStart)"
                                           @onchange="ChangeVideoSelectionStart" /> </label>
                                <label>@LT("Selection end")
                                    <input id="media-studio-video-selection-end"
                                           type="number"
                                           min="@Inv(_trimStart)"
                                           max="@Inv(_trimEnd)"
                                           step="0.01"
                                           value="@Inv(VideoSelectionEnd)"
                                           disabled="@_videoSelectionIsPoint"
                                           @onchange="ChangeVideoSelectionEnd" /> </label>
                            </div>
                            <div class="media-video-selection-value" id="media-studio-video-selection-value">@VideoSelectionDetailedSummary</div>
                            <div class="property-action-row">
                                <DxButton Text='@LT("Cut selection")' Enabled="@CanCutVideoSelection" Click="CutVideoSelection" />
                                <DxButton Text='@LT("Use as trim")' Enabled="@CanUseVideoSelectionAsTrim" Click="UseVideoSelectionAsTrim" />
                                <DxButton Text='@LT("Copy area")' Enabled="@CanCopyVideoSelection" Click="CopyVideoSelection" />
                                <DxButton Text='@LT("New selection layer")' Enabled="@CanCreateSelectionLayer" Click="CreateSelectionLayer" />
                                <DxButton Text='@LT("Apply to layer")' Enabled="@CanApplySelectionToLayer" Click="ApplySelectionToSelectedVideoLayer" />
                            </div>
                            <label class="check-row"><input type="checkbox" checked="@_autoCreateSelectionLayers" @onchange="ToggleAutoCreateSelectionLayers" /> @LT("Create/reuse one effect layer for every committed range")</label>
                            <p class="property-note">@LT("A point creates one cutline. A range is persisted on its own selection layer, so filters and frame regions render only inside that time span. Dropped video is inserted only inside this selection.")</p>
                        </section>

                        <section class="media-cut-sections-properties">
                            <h3>@LT("Saved cut sections")</h3>
                            <p class="property-note">@LT("The current selection stays editable. Save any number of independent ranges as cut sections without replacing the active selection.")</p>
                            <div class="media-cut-section-list">
                                @foreach (var section in SelectedCutSections)
                                {
                                    <button type="button" class="@(section.Id == _selectedCutSectionId ? "selected" : null)" @onclick="() => SelectCutSection(section.Id)">
                                        <span>@section.Name</span>
                                        <small>@Time(section.StartSeconds) — @Time(section.EndSeconds)</small>
                                    </button>
                                }
                                @if (SelectedCutSections.Count == 0)
                                {
                                    <span class="media-empty-list">@LT("No saved cut sections yet.")</span>
                                }
                            </div>
                            <div class="property-action-row">
                                <DxButton Text='@LT("Save as cut section")' Enabled="@CanSaveCutSection" Click="SaveSelectedRangeAsCutSection" />
                                <DxButton Text='@LT("Use section")' Enabled="@(SelectedCutSection is not null)" Click="UseSelectedCutSection" />
                                <DxButton Text='@LT("Remove")' Enabled="@(SelectedCutSection is not null)" Click="RemoveSelectedCutSection" />
                            </div>
                        </section>

                        <section class="media-video-layer-properties">
                            <h3>@LT("Video layers")</h3>
                            <p class="property-note">@LT("Each layer owns its frame region, temporal range and live filter stack. Layers are rendered from bottom to top.")</p>
                            <div class="media-video-layer-list">
                                @for (var layerIndex = 0; layerIndex < SelectedVideoLayers.Count; layerIndex++)
                                {
                                    var layer = SelectedVideoLayers[layerIndex];
                                    <div class="media-video-layer-row @(layer.Id == _selectedVideoLayerId ? "selected" : null)" data-video-layer-id="@layer.Id" draggable="true">
                                        <button type="button" class="media-video-layer-select" @onclick="() => SelectVideoLayer(layer.Id)">
                                            <span>@layer.Name</span>
                                            <small>@VideoLayerSummary(layer)</small>
                                            <em class="media-html-support @HtmlSupportCss(layer.HtmlExportSupport)">@HtmlSupportLabel(layer.HtmlExportSupport)</em>
                                        </button>
                                        <button type="button" class="media-video-layer-visibility" title='@LT("Toggle layer visibility")' @onclick="() => ToggleVideoLayerVisibility(layer.Id)"><i class="pub-icon pub-icon-visible" aria-hidden="true"></i></button>
                                    </div>
                                }
                            </div>
                            <div class="property-action-row">
                                <DxButton Text='@LT("Add")' Click="AddVideoLayer" />
                                <DxButton Text='@LT("Duplicate")' Enabled="@(SelectedVideoLayer is not null)" Click="DuplicateVideoLayer" />
                                <DxButton Text='@LT("Up")' Enabled="@CanMoveVideoLayerUp" Click="MoveVideoLayerUp" />
                                <DxButton Text='@LT("Down")' Enabled="@CanMoveVideoLayerDown" Click="MoveVideoLayerDown" />
                                <DxButton Text='@LT("Delete")' Enabled="@CanDeleteVideoLayer" Click="DeleteVideoLayer" />
                            </div>
                            @if (SelectedVideoLayer is { } selectedLayer)
                            {
                                <label>@LT("Layer name")<input value="@selectedLayer.Name" @onchange="ChangeVideoLayerName" /></label>
                                <label>@LT("Layer type")
                                    <select value="@selectedLayer.Kind" @onchange="ChangeVideoLayerKind">
                                        @foreach (var layerKind in Enum.GetValues<VideoEffectLayerKind>())
                                        {
                                            <option value="@layerKind">@VideoLayerKindName(layerKind)</option>
                                        }
                                    </select>
                                </label>
                                <div class="media-export-compatibility @HtmlSupportCss(selectedLayer.HtmlExportSupport)">
                                    <b>@HtmlSupportLabel(selectedLayer.HtmlExportSupport)</b>
                                    <span>@selectedLayer.HtmlExportNote</span>
                                </div>
                                <label>@LT("Opacity") <b>@Math.Round(selectedLayer.Opacity * 100)%</b>
                                    <input type="range" min="0" max="1" step="0.01" value="@Inv(selectedLayer.Opacity)" @oninput="ChangeVideoLayerOpacity" /> </label>
                                <label>@LT("Blend mode")
                                    <select value="@selectedLayer.BlendMode" @onchange="ChangeVideoLayerBlendMode">
                                        @foreach (var blend in Enum.GetValues<VideoEffectBlendMode>())
                                        {
                                            <option value="@blend">@VideoBlendModeName(blend)</option>
                                        }
                                    </select>
                                </label>
                                <label class="check-row"><input type="checkbox" checked="@selectedLayer.HasTemporalRange" @onchange="ToggleVideoLayerTemporalRange" /> @LT("Apply only in a time range")</label>
                                @if (selectedLayer.HasTemporalRange)
                                {
                                    <div class="property-grid two">
                                        <label>@LT("Layer start")<input type="number" min="@Inv(_trimStart)" max="@Inv(_trimEnd)" step="0.01" value="@Inv(selectedLayer.TemporalStartSeconds)" @onchange="ChangeVideoLayerTemporalStart" /></label>
                                        <label>@LT("Layer end")<input type="number" min="@Inv(_trimStart)" max="@Inv(_trimEnd)" step="0.01" value="@Inv(selectedLayer.TemporalEndSeconds)" @onchange="ChangeVideoLayerTemporalEnd" /></label>
                                    </div>
                                    <DxButton Text='@LT("Apply selected range")' Enabled="@CanApplySelectionToLayer" Click="ApplySelectionToSelectedVideoLayer" CssClass="wide-button" />
                                }
                                @if (selectedLayer.Kind == VideoEffectLayerKind.Blob3D)
                                {
                                    <div class="property-action-row">
                                        <DxButton Text='@LT("Edit source area")' Click="BeginFrameRegion" />
                                        <DxButton Text='@LT("Draw morph target")' Click="BeginMorphRegion" />
                                    </div>
                                    <label class="check-row"><input type="checkbox" checked="@selectedLayer.MorphEnabled" @onchange="ToggleVideoLayerMorph" /> @LT("Morph between both areas")</label>
                                    <label class="check-row"><input type="checkbox" checked="@selectedLayer.AnimateMorph" @onchange="ToggleVideoLayerMorphAnimation" /> @LT("Animate morph in preview and HTML")</label>
                                    <label>@LT("Morph amount") <b>@Inv(selectedLayer.MorphAmount)</b><input type="range" min="0" max="1" step="0.01" value="@Inv(selectedLayer.MorphAmount)" @oninput="ChangeVideoLayerMorphAmount" /></label>
                                    <label>@LT("Animation speed") <b>@Inv(selectedLayer.AnimationSpeed)</b><input type="range" min="0" max="8" step="0.05" value="@Inv(selectedLayer.AnimationSpeed)" @oninput="ChangeVideoLayerAnimationSpeed" /></label>
                                    <label>@LT("Depth") <b>@Inv(selectedLayer.Depth)</b><input type="range" min="0.02" max="0.5" step="0.01" value="@Inv(selectedLayer.Depth)" @oninput="ChangeVideoLayerDepth" /></label>
                                    <label>@LT("Roundness") <b>@Inv(selectedLayer.Roundness)</b><input type="range" min="0" max="0.5" step="0.01" value="@Inv(selectedLayer.Roundness)" @oninput="ChangeVideoLayerRoundness" /></label>
                                    <div class="property-action-row">
                                        <DxButton Text='@LT("Refresh OpenSCAD")' Click="RefreshSelectedLayerOpenScad" />
                                        <DxButton Text='@LT("Insert in Mainframe")' Enabled="@CanInsertLayerIntoMainframe" Click="InsertSelectedLayerIntoMainframe" />
                                    </div>
                                    <label>@LT("OpenSCAD interchange")<textarea rows="7" readonly>@selectedLayer.OpenScadScript</textarea></label>
                                    <div class="media-export-compatibility render">
                                        <b>@HtmlSupportLabel(PublicationHtmlExportSupport.RenderBeforeExport)</b>
                                        <span>@LT("Native OpenSCAD mesh, Minkowski rounding and boolean-solid output are interchange/render sources. Bake them to image or video before HTML export; the interactive canvas fallback stays available.")</span>
                                    </div>
                                    <p class="property-note">@LT("The canvas blob remains interactive in HTML export. The OpenSCAD solid is an interchange/render source and must be baked for native mesh-quality video output.")</p>
                                }
                            }
                        </section>

                        <section class="media-video-filter-properties">
                            <h3>@LT("Effect stack")</h3>
                            <p class="property-note">@LT("Drag effects to reorder them. Every effect remains non-destructive and belongs to the selected video layer.")</p>
                            <div class="media-video-filter-add">
                                <select value="@_newVideoFilterKind" @onchange="ChangeNewVideoFilterKind">
                                    @foreach (var filterKind in Enum.GetValues<VideoEffectFilterKind>())
                                    {
                                        <option value="@filterKind">@VideoFilterKindName(filterKind)</option>
                                    }
                                </select>
                                <DxButton Text='@LT("Add filter")' Enabled="@(SelectedVideoLayer is not null)" Click="AddSelectedVideoFilter" />
                            </div>
                            <div class="media-video-filter-list">
                                @foreach (var filter in SelectedVideoFilters)
                                {
                                    <div class="media-video-filter-row @(filter.Id == _selectedVideoFilterId ? "selected" : null)" data-video-filter-id="@filter.Id" draggable="true">
                                        <button type="button" @onclick="() => SelectVideoFilter(filter.Id)">
                                            <span><i class="pub-icon pub-icon-effects media-effect-drag-handle" aria-hidden="true"></i>@LT(filter.Name)</span><small>@VideoFilterSummary(filter) · @HtmlSupportLabel(filter.HtmlExportSupport)</small>
                                        </button>
                                        <button type="button" title='@LT("Enable or disable filter")' @onclick="() => ToggleVideoFilter(filter.Id)"><i class="pub-icon pub-icon-visible" aria-hidden="true"></i></button>
                                    </div>
                                }
                                @if (SelectedVideoFilters.Count == 0)
                                {
                                    <span class="media-empty-list">@LT("The selected layer has no filters.")</span>
                                }
                            </div>
                            @if (SelectedVideoFilter is { } selectedFilter)
                            {
                                <label>@LT("Filter name")<input value="@selectedFilter.Name" @onchange="ChangeVideoFilterName" /></label>
                                <div class="media-export-compatibility @HtmlSupportCss(selectedFilter.HtmlExportSupport)"><b>@HtmlSupportLabel(selectedFilter.HtmlExportSupport)</b><span>@selectedFilter.HtmlExportNote</span></div>
                                @if (selectedFilter.Kind == VideoEffectFilterKind.ChromaKey)
                                {
                                    <label>@LT("Key color")<input type="color" value="@selectedFilter.Color" @oninput="ChangeVideoFilterColor" /></label>
                                    <label>@LT("Similarity") <b>@Inv(selectedFilter.Amount)</b><input type="range" min="0" max="1" step="0.01" value="@Inv(selectedFilter.Amount)" @oninput="ChangeVideoFilterAmount" /></label>
                                    <label>@LT("Smoothness") <b>@Inv(selectedFilter.SecondaryAmount)</b><input type="range" min="0.001" max="1" step="0.01" value="@Inv(selectedFilter.SecondaryAmount)" @oninput="ChangeVideoFilterSecondaryAmount" /></label>
                                    <label>@LT("Spill reduction") <b>@Inv(selectedFilter.TertiaryAmount)</b><input type="range" min="0" max="1" step="0.01" value="@Inv(selectedFilter.TertiaryAmount)" @oninput="ChangeVideoFilterTertiaryAmount" /></label>
                                    <label>@LT("Residual opacity") <b>@Inv(selectedFilter.ResidualOpacity)</b><input type="range" min="0" max="1" step="0.01" value="@Inv(selectedFilter.ResidualOpacity)" @oninput="ChangeVideoFilterResidualOpacity" /></label>
                                }
                                else if (selectedFilter.Kind == VideoEffectFilterKind.Vignette)
                                {
                                    <label>@LT("Strength") <b>@Inv(selectedFilter.Amount)</b><input type="range" min="0" max="1" step="0.01" value="@Inv(selectedFilter.Amount)" @oninput="ChangeVideoFilterAmount" /></label>
                                    <label>@LT("Softness") <b>@Inv(selectedFilter.SecondaryAmount)</b><input type="range" min="0" max="1" step="0.01" value="@Inv(selectedFilter.SecondaryAmount)" @oninput="ChangeVideoFilterSecondaryAmount" /></label>
                                }
                                else
                                {
                                    <label>@VideoFilterAmountLabel(selectedFilter.Kind) <b>@Inv(selectedFilter.Amount)</b>
                                        <input type="range" min="@Inv(VideoFilterMinimum(selectedFilter.Kind))" max="@Inv(VideoFilterMaximum(selectedFilter.Kind))" step="@Inv(VideoFilterStep(selectedFilter.Kind))" value="@Inv(selectedFilter.Amount)" @oninput="ChangeVideoFilterAmount" /> </label>
                                    @if (selectedFilter.Kind == VideoEffectFilterKind.ColorWash)
                                    {
                                        <label>@LT("Wash color")<input type="color" value="@selectedFilter.Color" @oninput="ChangeVideoFilterColor" /></label>
                                    }
                                }
                                <div class="property-action-row">
                                    <DxButton Text='@LT("Filter up")' Enabled="@CanMoveVideoFilterUp" Click="MoveVideoFilterUp" />
                                    <DxButton Text='@LT("Filter down")' Enabled="@CanMoveVideoFilterDown" Click="MoveVideoFilterDown" />
                                    <DxButton Text='@LT("Remove filter")' Click="RemoveSelectedVideoFilter" />
                                </div>
                            }
                        </section>

                        <section>
                            <h3>@LT("Video inside play canvas")</h3>
                            <label>@LT("Fit mode")
                                <select value="@_videoFitMode" @onchange="ChangeVideoFitMode">
                                    @foreach (var fitMode in Enum.GetValues<PublicationVideoFitMode>())
                                    {
                                        <option value="@fitMode">@VideoFitModeName(fitMode)</option>
                                    }
                                </select>
                            </label>
                            <div class="property-action-row">
                                <DxButton Text='@LT("Fit whole")' Click="VideoFitContain" />
                                <DxButton Text='@LT("Fill canvas")' Click="VideoFitCover" />
                                <DxButton Text='@LT("Stretch")' Click="VideoFitStretch" />
                            </div>
                            <p class="property-note">@LT("Fit whole preserves the full frame, Fill canvas crops overflow, and Stretch fills the play canvas without preserving the source aspect ratio. The selected mode is saved with the publication video.")</p>
                        </section>
                    }

                    <section>
                        <h3>@LT("Timeline playback")</h3>
                        <label>@LT("Start behavior")
                            <select value="@_playbackTrigger" @onchange="ChangePlaybackTrigger">
                                @foreach (var value in Enum.GetValues<PublicationMediaPlaybackTrigger>())
                                {
                                    <option value="@value">@PlaybackTriggerName(value)</option>
                                }
                            </select>
                        </label>
                        <label class="check-row"><input type="checkbox" checked="@_autoPlay" @onchange="ToggleAutoPlay" /> @LT("Play during page preview/export")</label>
                    </section>

                    @if (!IsVideo)
                    {
                        <section>
                            <h3>@LT("Simple mix")</h3>
                            <label>@LT("Fade in") <b>@Time(_fadeIn)</b><input type="range" min="0" max="@Inv(MaxFade)" step="0.05" value="@Inv(_fadeIn)" @oninput="ChangeFadeIn" /></label>
                            <label>@LT("Fade out") <b>@Time(_fadeOut)</b><input type="range" min="0" max="@Inv(MaxFade)" step="0.05" value="@Inv(_fadeOut)" @oninput="ChangeFadeOut" /></label>
                            <p class="property-note">@LT("Edits are non-destructive. The source stays embedded while the selected range, fades, volume, and playback rate are stored in the publication timeline.")</p>
                        </section>
                    }
                    else
                    {
                        <section>
                            <h3>@LT("Video frame region")</h3>
                            <p class="property-note">@LT("Editing the") <b>@ActiveFrameRegionName</b> @LT("on") <b>@(SelectedVideoLayer?.Name ?? LT("the selected video layer"))</b>. @LT("A grabbed point remains selected until another point or the canvas is selected. Delete/Backspace removes that exact point.")</p>
                            @if (SelectedVideoLayer is not null)
                            {
                                <label class="check-row"><input type="checkbox" checked="@ActiveFrameRegionInverted" @onchange="ToggleFrameRegionInverted" /> @LT("Invert the active region")</label>
                            }
                            <div class="property-action-row">
                                <DxButton Text='@LT("Edit source region")' Enabled="@HasSource" Click="BeginFrameRegion" />
                                <DxButton Text='@LT("Edit morph target")' Enabled="@(SelectedVideoLayer is not null)" Click="BeginMorphRegion" />
                                <DxButton Text='@LT("Apply")' Enabled="@CanFinishFrameRegion" Click="FinishFrameRegion" />
                                <DxButton Text='@LT("Clear active")' Enabled="@(HasFrameRegion || HasMorphRegion)" Click="ClearFrameRegion" />
                            </div>
                            <div class="property-action-row">
                                <DxButton Text='@LT("Copy active region")' Enabled="@(ActiveFramePoints.Count >= 3)" Click="CopyFrameRegion" />
                                <DxButton Text='@LT("Paste active region")' Enabled="@CanPasteFrameRegion" Click="PasteFrameRegion" />
                                <DxButton Text='@LT("Delete selected point")' Enabled="@(SelectedFramePoint is not null)" Click="RemoveSelectedFramePoint" />
                            </div>
                            @if (SelectedFramePoint is { } selectedPoint)
                            {
                                <div class="media-frame-point-properties">
                                    <h4>@LT("Selected point") @(_selectedFramePointIndex.GetValueOrDefault() + 1)</h4>
                                    <div class="property-grid two">
                                        <label>@LT("X (0–1)")<input type="number" min="0" max="1" step="0.001" value="@Inv(selectedPoint.X)" @onchange="ChangeSelectedFramePointX" /></label>
                                        <label>@LT("Y (0–1)")<input type="number" min="0" max="1" step="0.001" value="@Inv(selectedPoint.Y)" @onchange="ChangeSelectedFramePointY" /></label>
                                    </div>
                                </div>
                            }
                        </section>
                        <section>
                            <h3>@LT("Recording capture quality")</h3>
                            <div class="property-grid two">
                                <label>@LT("Quality selection")
                                    <select value="@(_recordingAdaptiveQuality ? "adaptive" : "manual")" @onchange="ChangeRecordingQualityMode" disabled="@(_recording || _recordingStopping)">
                                        <option value="adaptive">@LT("Smart adaptive")</option>
                                        <option value="manual">@LT("Manual")</option>
                                    </select>
                                </label>
                                <label>@LT("Adaptive priority")
                                    <select @bind="_recordingAdaptiveProfile" disabled="@(!_recordingAdaptiveQuality || _recording || _recordingStopping)">
                                        <option value="efficiency">@LT("Efficiency")</option>
                                        <option value="balanced">@LT("Balanced")</option>
                                        <option value="quality">@LT("Quality")</option>
                                    </select>
                                </label>
                            </div>
                            @if (_recordingAdaptiveQuality)
                            {
                                <div class="property-grid two">
                                    <label class="check-row"><input type="checkbox" @bind="_recordingAdaptVideo" disabled="@(_recording || _recordingStopping)" /> @LT("Adapt video automatically")</label>
                                    <label class="check-row"><input type="checkbox" @bind="_recordingAdaptAudio" disabled="@(_recording || _recordingStopping)" /> @LT("Adapt audio automatically")</label>
                                    <label class="check-row"><input type="checkbox" @bind="_recordingUseBrowserCapabilityProbe" disabled="@(_recording || _recordingStopping)" /> @LT("Use browser capability probe")</label>
                                    <label class="check-row"><input type="checkbox" @bind="_recordingPreserveNativeResolution" disabled="@(_recording || _recordingStopping)" /> @LT("Preserve native source resolution")</label>
                                    <label class="check-row"><input type="checkbox" @bind="_recordingAllowFrameRateReduction" disabled="@(_recording || _recordingStopping)" /> @LT("Allow smoothness FPS fallback")</label>
                                    <label class="check-row"><input type="checkbox" @bind="_recordingAllowResolutionReduction" disabled="@(_recording || _recordingStopping)" /> @LT("Allow last-resort resolution fallback")</label>
                                </div>
                            }
                            <label>@LT("Capture size")
                                <select value="@_recordingSizeMode" @onchange="ChangeRecordingSizeMode" disabled="@(_recording || _recordingStopping)">
                                    <optgroup label='@LT("Source")'>
                                        <option value="source">@LT("Source/native")</option>
                                    </optgroup>
                                    <optgroup label='@LT("Video standards")'>
                                        <option value="video-8k">8K UHD · 7680 × 4320 · 16:9</option>
                                        <option value="video-4k">4K UHD · 3840 × 2160 · 16:9</option>
                                        <option value="video-dci4k">DCI 4K · 4096 × 2160 · 256:135</option>
                                        <option value="video-uwqhd">UWQHD · 3440 × 1440 · 43:18</option>
                                        <option value="video-qhd">QHD · 2560 × 1440 · 16:9</option>
                                        <option value="video-fhd">Full HD · 1920 × 1080 · 16:9</option>
                                        <option value="video-hd">HD · 1280 × 720 · 16:9</option>
                                        <option value="video-vertical4k">@LT("Vertical 4K") · 2160 × 3840 · 9:16</option>
                                        <option value="video-verticalfhd">@LT("Vertical Full HD") · 1080 × 1920 · 9:16</option>
                                        <option value="video-square2k">@LT("Square 2K") · 2160 × 2160 · 1:1</option>
                                        <option value="video-square">@LT("Square Full HD") · 1080 × 1080 · 1:1</option>
                                    </optgroup>
                                    @if (_recordingViewportPresets.Count > 0)
                                    {
                                        <optgroup label='@LT("Panel / Div viewport presets")'>
                                            @foreach (var preset in _recordingViewportPresets)
                                            {
                                                <option value="@RecordingViewportPresetValue(preset.Key)">@LT(preset.Name) · @preset.Width × @preset.Height · @AspectRatioLabel(preset.Width, preset.Height)</option>
                                            }
                                        </optgroup>
                                    }
                                    <optgroup label='@LT("Streaming presets")'>
                                        <option value="master">@LT("Streaming master") · @RecordingPolicy.MasterWidth × @RecordingPolicy.MasterHeight · @AspectRatioLabel(RecordingPolicy.MasterWidth, RecordingPolicy.MasterHeight)</option>
                                        <option value="output">@LT("Streaming output") · @RecordingPolicy.OutputWidth × @RecordingPolicy.OutputHeight · @AspectRatioLabel(RecordingPolicy.OutputWidth, RecordingPolicy.OutputHeight)</option>
                                    </optgroup>
                                    <option value="custom">@LT("Custom")</option>
                                </select>
                            </label>
                            @if (_recordingSizeMode == "custom")
                            {
                                <div class="property-grid two">
                                    <label>@LT("Capture width")<input type="number" min="@RecordingPolicy.MinimumWidth" max="@RecordingPolicy.MaximumWidth" step="1" @bind="_recordingCustomWidth" disabled="@(_recording || _recordingStopping)" /></label>
                                    <label>@LT("Capture height")<input type="number" min="@RecordingPolicy.MinimumHeight" max="@RecordingPolicy.MaximumHeight" step="1" @bind="_recordingCustomHeight" disabled="@(_recording || _recordingStopping)" /></label>
                                </div>
                            }
                            <div class="property-grid two">
                                <label>@LT("Frame-rate preset")
                                    <select value="@RecordingFrameRatePresetKey" @onchange="ChangeRecordingFrameRatePreset" disabled="@(_recording || _recordingStopping)">
                                        @if (_recordingAdaptiveQuality)
                                        {
                                            <option value="source">@LT("Source/native FPS")</option>
                                        }
                                        <option value="23.976">23.976 fps</option>
                                        <option value="24">24 fps</option>
                                        <option value="25">25 fps</option>
                                        <option value="29.97">29.97 fps</option>
                                        <option value="30">30 fps</option>
                                        <option value="48">48 fps</option>
                                        <option value="50">50 fps</option>
                                        <option value="59.94">59.94 fps</option>
                                        <option value="60">60 fps</option>
                                        <option value="90">90 fps</option>
                                        <option value="120">120 fps</option>
                                        <option value="144">144 fps</option>
                                        <option value="165">165 fps</option>
                                        <option value="240">240 fps</option>
                                        <option value="custom">@LT("Custom FPS")</option>
                                    </select>
                                </label>
                                <label>@(_recordingAdaptiveQuality ? LT("Automatic FPS ceiling (0 = source)") : LT("Capture frame rate"))<input type="number" min="@(_recordingAdaptiveQuality ? 0 : RecordingPolicy.MinimumFrameRate)" max="@RecordingPolicy.MaximumFrameRate" step="0.001" value="@Inv(_recordingFrameRate)" @onchange="ChangeRecordingFrameRate" disabled="@(_recording || _recordingStopping)" /></label>
                                <label>@LT("Recording codec")
                                    <select @bind="_recordingCodecPreference" disabled="@(_recording || _recordingStopping)">
                                        <option value="auto">@LT("Auto (browser-capability ranked)")</option>
                                        <option value="vp9">VP9</option>
                                        <option value="vp8">VP8</option>
                                    </select>
                                </label>
                                <label>@LT("Recording video bitrate (kbps)")<input type="number" min="@RecordingPolicy.MinimumVideoBitrateKbps" max="@RecordingPolicy.MaximumVideoBitrateKbps" step="250" @bind="_recordingVideoBitrateKbps" disabled="@((_recordingAdaptiveQuality && _recordingAdaptVideo) || _recording || _recordingStopping)" /></label>
                                <label>@LT("Recording audio bitrate (kbps)")<input type="number" min="@Math.Max(32, RecordingPolicy.AdaptiveQuality.MinimumAudioBitrateKbps)" max="@Math.Max(32, RecordingPolicy.AdaptiveQuality.MaximumAudioBitrateKbps)" step="16" @bind="_recordingAudioBitrateKbps" disabled="@((_recordingAdaptiveQuality && _recordingAdaptAudio) || _recording || _recordingStopping)" /></label>
                            </div>
                            <p class="property-note"><b>@RecordingSizeSummary</b> · @(_recordingAdaptiveQuality ? LT("smart bitrate / codec selection") : $"{_recordingFrameRate} fps · {_recordingVideoBitrateKbps} kbps"). @LT("The browser share picker still decides which screen, window, or tab is captured; PublisherStudio never assumes one user's monitor resolution.")</p>
                            <p class="property-note">@LT("Smart adaptive mode waits for the real capture-track settings, then uses browser MediaCapabilities where available plus configurable runtime quality policy to select codec, video bitrate, audio bitrate, and smoothness fallbacks. Manual mode keeps every explicit control available.")</p>
                        </section>
                        <section>
                            <h3>@LT("Video")</h3>
                            <p class="property-note">@LT("Camera and screen recording use the browser’s MediaRecorder. Completed recordings stay in the browser until this studio closes, remain downloadable at their original size, and are embedded only when you insert or apply them.")</p>
                            @if (HasRetainedRecording)
                            {
                                <p class="property-note"><b>@LT("Completed recording:")</b> @FormatBytes(_retainedRecordingSizeBytes). @LT("Download remains available even if embedding fails because the browser or computer runs out of memory.")</p>
                            }
                        </section>
                    }
                </aside>
            </div>

            <footer class="media-studio-footer">
                <span>@FooterStatus</span>
                <div>
                    @if (CanDownloadCurrentMedia)
                    {
                        <DxButton Text="@DownloadMediaText" Click="DownloadRecording" />
                    }
                    <DxButton Text='@LT("Cancel")' Click="Cancel" />
                    <DxButton Text="@ApplyButtonText" Enabled="@(HasSource && !_recording && !_recordingStopping && !_recordingPlacementRequired && !_recordingStartPlacementRequired && !_renderingVideoExport && !_saving && !_embedding)" Click="Save" RenderStyle="ButtonRenderStyle.Primary" />
                </div>
            </footer>
        </section>
    </div>
}

<DxContextMenu @ref="_mediaContextMenu">
    <Items>
        <DxContextMenuItem Text="@ImportMenuText" Enabled="@(!_recording && !_recordingStopping)" Click="OpenMediaPicker" />
        @if (IsVideo)
        {
            <DxContextMenuItem Text='@LT("Import open video project…")' Enabled="@(!_recording && !_recordingStopping)" Click="OpenVideoProjectPicker" />
            <DxContextMenuItem Text='@LT("Relink project media…")' Enabled="@HasVideoProject" Click="OpenVideoProjectMediaPicker" />
            <DxContextMenuItem Text='@LT("Record camera…")' Enabled="@(!_recording && !_recordingStopping && !_recordingPlacementRequired && !_recordingStartPlacementRequired)" Click="RecordCamera" />
            <DxContextMenuItem Text='@LT("Record screen…")' Enabled="@(!_recording && !_recordingStopping && !_recordingPlacementRequired && !_recordingStartPlacementRequired)" Click="RecordScreen" />
        }
        else
        {
            <DxContextMenuItem Text='@LT("Record microphone…")' Enabled="@(!_recording && !_recordingStopping && !_recordingPlacementRequired)" Click="RecordMicrophone" />
            <DxContextMenuItem Text='@LT("Generate example tone")' Enabled="@(!_recording && !_recordingStopping)" Click="GenerateTone" />
        }
        <DxContextMenuItem Text='@LT("Stop recording")' Enabled="@(_recording && !_recordingStopping)" Click="StopRecording" />
        <DxContextMenuItem Text="@DownloadMediaText" Enabled="@CanDownloadCurrentMedia" Click="DownloadRecording" />
        <DxContextMenuItem Text='@LT("Play selected range")' Enabled="@HasSource" BeginGroup="true" Click="PlaySelection" />
        <DxContextMenuItem Text='@LT("Pause")' Enabled="@HasSource" Click="PausePreview" />
        <DxContextMenuItem Text='@LT("Jump to trim start")' Enabled="@HasSource" Click="SeekStart" />
        <DxContextMenuItem Text='@LT("Set trim start at playhead")' Enabled="@HasSource" BeginGroup="true" Click="SetTrimStartAtPlayhead" />
        <DxContextMenuItem Text='@LT("Set trim end at playhead")' Enabled="@HasSource" Click="SetTrimEndAtPlayhead" />
        <DxContextMenuItem Text='@LT("Reset trim to full clip")' Enabled="@HasSource" Click="ResetTrim" />
        <DxContextMenuItem Text="@MouseModeText(MediaStudioMouseMode.SelectSection, "Pointer: select timestamp/range")" BeginGroup="true" Click="SelectSectionMode" />
        <DxContextMenuItem Text="@MouseModeText(MediaStudioMouseMode.PlacePlayhead, "Pointer: place playhead")" Enabled="@HasSource" Click="PlacePlayheadMode" />
        <DxContextMenuItem Text="@MouseModeText(MediaStudioMouseMode.AddCutLine, "Pointer: add cutline")" Enabled="@HasSource" Click="AddCutLineMode" />
        @if (IsVideo)
        {
            <DxContextMenuItem Text="@MouseModeText(MediaStudioMouseMode.FrameRegion, "Pointer: frame region")" Enabled="@HasSource" Click="FrameRegionMode" />
            <DxContextMenuItem Text="@VideoFitModeText(PublicationVideoFitMode.Stretch, "Canvas: stretch")" Enabled="@HasSource" BeginGroup="true" Click="VideoFitStretch" />
            <DxContextMenuItem Text="@VideoFitModeText(PublicationVideoFitMode.Cover, "Canvas: fill and crop")" Enabled="@HasSource" Click="VideoFitCover" />
            <DxContextMenuItem Text="@VideoFitModeText(PublicationVideoFitMode.Contain, "Canvas: fit whole")" Enabled="@HasSource" Click="VideoFitContain" />
            <DxContextMenuItem Text='@LT("Cut selected timestamp/range")' Enabled="@CanCutVideoSelection" BeginGroup="true" Click="CutVideoSelection" />
            <DxContextMenuItem Text='@LT("Use selected range as trim")' Enabled="@CanUseVideoSelectionAsTrim" Click="UseVideoSelectionAsTrim" />
            <DxContextMenuItem Text='@LT("Copy selected range")' Enabled="@CanCopyVideoSelection" Click="CopyVideoSelection" />
            <DxContextMenuItem Text='@LT("Save selection as cut section")' Enabled="@CanSaveCutSection" Click="SaveSelectedRangeAsCutSection" />
            <DxContextMenuItem Text='@LT("Use selected saved section")' Enabled="@(SelectedCutSection is not null)" Click="UseSelectedCutSection" />
            <DxContextMenuItem Text='@LT("Remove selected saved section")' Enabled="@(SelectedCutSection is not null)" Click="RemoveSelectedCutSection" />
            <DxContextMenuItem Text='@LT("Create layer from selected range")' Enabled="@CanCreateSelectionLayer" BeginGroup="true" Click="CreateSelectionLayer" />
            <DxContextMenuItem Text='@LT("Add video layer")' Enabled="@HasSelectedSegment" Click="AddVideoLayer" />
            <DxContextMenuItem Text='@LT("Duplicate selected layer")' Enabled="@(SelectedVideoLayer is not null)" Click="DuplicateVideoLayer" />
            <DxContextMenuItem Text='@LT("Apply selected range to layer")' Enabled="@CanApplySelectionToLayer" Click="ApplySelectionToSelectedVideoLayer" />
            <DxContextMenuItem Text='@LT("Move layer up")' Enabled="@CanMoveVideoLayerUp" Click="MoveVideoLayerUp" />
            <DxContextMenuItem Text='@LT("Move layer down")' Enabled="@CanMoveVideoLayerDown" Click="MoveVideoLayerDown" />
            <DxContextMenuItem Text='@LT("Delete selected layer")' Enabled="@CanDeleteVideoLayer" Click="DeleteVideoLayer" />
            <DxContextMenuItem Text='@LT("Convert selected layer to animated 3D blob")' Enabled="@(SelectedVideoLayer is not null)" Click="ConvertSelectedLayerToBlob" />
            <DxContextMenuItem Text='@LT("Insert selected 3D blob into Mainframe")' Enabled="@CanInsertLayerIntoMainframe" Click="InsertSelectedLayerIntoMainframe" />
            <DxContextMenuItem Text='@LT("Add chroma key filter")' Enabled="@(SelectedVideoLayer is not null)" BeginGroup="true" Click="AddChromaKeyFilter" />
            <DxContextMenuItem Text='@LT("Add color adjustment filters")' Enabled="@(SelectedVideoLayer is not null)" Click="AddColorAdjustmentFilters" />
            <DxContextMenuItem Text='@LT("Add vignette filter")' Enabled="@(SelectedVideoLayer is not null)" Click="AddVignetteFilter" />
        }
        <DxContextMenuItem Text='@LT("Add cutline at playhead")' Enabled="@CanAddCutLine" BeginGroup="true" Click="AddCutLineAtPlayhead" />
        <DxContextMenuItem Text='@LT("Remove cutline before selected section")' Enabled="@CanRemoveCutLine" Click="RemoveCutLine" />
        <DxContextMenuItem Text='@LT("Copy selected section")' Enabled="@HasSelectedSegment" Click="CopySelectedSection" />
        <DxContextMenuItem Text='@LT("Paste section after selection")' Enabled="@CanPasteSection" Click="PasteSection" />
        <DxContextMenuItem Text='@LT("Delete selected section")' Enabled="@CanDeleteSection" Click="DeleteSelectedSection" />
        <DxContextMenuItem Text='@LT("Insert media into selected range…")' Enabled="@HasSource" Click="OpenInsertMediaPicker" />
        @if (IsVideo)
        {
            <DxContextMenuItem Text='@LT("Edit frame region")' Enabled="@HasSource" BeginGroup="true" Click="BeginFrameRegion" />
            <DxContextMenuItem Text='@LT("Apply frame region")' Enabled="@CanFinishFrameRegion" Click="FinishFrameRegion" />
            <DxContextMenuItem Text='@LT("Edit morph target region")' Enabled="@(SelectedVideoLayer is not null)" Click="BeginMorphRegion" />
            <DxContextMenuItem Text='@LT("Delete selected region point")' Enabled="@(SelectedFramePoint is not null)" Click="RemoveSelectedFramePoint" />
            <DxContextMenuItem Text='@LT("Clear active region")' Enabled="@(HasFrameRegion || HasMorphRegion)" Click="ClearFrameRegion" />
        }
        <DxContextMenuItem Text="@(_muted ? LT("Unmute") : LT("Mute"))" BeginGroup="true" Click="ToggleMutedFromMenu" />
        <DxContextMenuItem Text="@(_loop ? LT("Disable loop") : LT("Loop selected range"))" Click="ToggleLoopFromMenu" />
        <DxContextMenuItem Text="@SendToConverterMenuText" Enabled="@HasSelectedSegment" BeginGroup="true" Click="SendSelectedMediaToConverter" />
        <DxContextMenuItem Text='@LT("Import replacement…")' Enabled="@(!_recording && !_recordingStopping)" BeginGroup="true" Click="OpenMediaPicker" />
    </Items>
</DxContextMenu>

<InputFile id="media-studio-file-input" class="hidden-file-input" accept="@Accept" OnChange="LoadFile" />
<InputFile id="media-studio-insert-file-input" class="hidden-file-input" accept="@Accept" OnChange="LoadInsertedFile" />
<InputFile id="media-studio-project-input" class="hidden-file-input" accept=".otio,.otioz,.mlt,.kdenlive,.xges,.osp,.edl" OnChange="LoadVideoProject" />
<InputFile id="media-studio-project-media-input" class="hidden-file-input" accept="video/*,audio/*,image/*" multiple OnChange="RelinkVideoProjectMedia" />

@code {

    /// <summary>
    /// Gets or sets a value indicating whether the value is visible applies to the media studio state.
    /// </summary>
    /// <value>The visible value exposed by <see cref="MediaStudio"/>.</value>
    [Parameter] public bool Visible { get; set; }
    /// <summary>
    /// Gets or sets the stable session identifier used to identify or correlate this media studio instance with related application state.
    /// </summary>
    /// <value>The session identifier value exposed by <see cref="MediaStudio"/>.</value>
    [Parameter] public Guid SessionId { get; set; }
    /// <summary>
    /// Gets or sets the kind value that forms part of the media studio state consumed or produced by the surrounding workflow.
    /// </summary>
