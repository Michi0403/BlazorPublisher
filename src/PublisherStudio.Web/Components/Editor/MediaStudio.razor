<InputFile id="media-studio-project-media-input" class="hidden-file-input" accept="video/*,audio/*,image/*" multiple OnChange="RelinkVideoProjectMedia" />

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public Guid SessionId { get; set; }
    [Parameter] public PublicationElementKind Kind { get; set; } = PublicationElementKind.Audio;
    [Parameter] public PublicationMediaElement? InitialMedia { get; set; }
    [Parameter] public PublicationMediaSegment? InitialInsertedSegment { get; set; }
    [Parameter] public bool EditingExisting { get; set; }
    [Parameter] public EventCallback<MediaEditorResult> Saved { get; set; }
    [Parameter] public EventCallback<MediaConversionInsertRequest> SendToMediaConverter { get; set; }
    [Parameter] public EventCallback<VideoLayerMainframeInsertRequest> InsertLayerIntoMainframe { get; set; }
    [Parameter] public EventCallback Cancelled { get; set; }

    private DotNetObjectReference<MediaStudio>? _self;
    private DxContextMenu _mediaContextMenu = default!;
    private IJSObjectReference? _module;
    private Guid _loadedSession;
    private Guid _initializedSession;
    private Guid _recordingRecoveryAttemptedSession;
    private string _name = "Audio";
    private string _dataUrl = string.Empty;
    private string _mimeType = string.Empty;
    private string _posterDataUrl = string.Empty;
    private Guid _previewAssetId = Guid.NewGuid();
    private string _previewSource = string.Empty;
    private double _duration;
    private double _trimStart;
    private double _trimEnd;
    private double _volume = 1;
    private double _playbackRate = 1;
    private double _fadeIn;
    private double _fadeOut;
    private PublicationVideoFitMode _videoFitMode = PublicationVideoFitMode.Stretch;
    private bool _muted;
    private bool _loop;
    private bool _autoPlay = true;
    private bool _recording;
    private bool _recordingStopping;
    private bool _renderingVideoExport;
    private bool _recordingAdaptiveQuality = true;
    private string _recordingAdaptiveProfile = "quality";
    private bool _recordingAdaptVideo = true;
    private bool _recordingAdaptAudio = true;
    private bool _recordingUseBrowserCapabilityProbe = true;
    private bool _recordingPreserveNativeResolution = true;
    private bool _recordingAllowFrameRateReduction = true;
    private bool _recordingAllowResolutionReduction;
    private string _recordingSizeMode = "source";
    private int _recordingCustomWidth;
    private int _recordingCustomHeight;
    private int _recordingFrameRate;
    private int _recordingVideoBitrateKbps;
    private int _recordingAudioBitrateKbps;
    private string _recordingCodecPreference = "auto";
    private bool _saving;
    private bool _embedding;
    private double _embeddingProgress;
    private bool _hasRetainedRecording;
    private long _retainedRecordingSizeBytes;
    private string _retainedRecordingFileName = string.Empty;
    private string _retainedRecordingObjectUrl = string.Empty;
    private PublicationMediaPlaybackTrigger _playbackTrigger = PublicationMediaPlaybackTrigger.OnPageEnter;
    private List<double> _waveform = [];
    private string? _error;
    private string? _warning;
    private bool _disposed;
    private StringBuilder? _recordingBuffer;
    private string? _recordingId;
    private int _recordingExpectedChunks;
    private int _recordingNextChunk;
    private long _recordingExpectedBytes;
    private readonly List<PublicationMediaSegment> _segments = [];
    private Guid? _selectedSegmentId;
    private PublicationMediaSegment? _clipClipboard;
    private MediaStudioMouseMode _mouseMode = MediaStudioMouseMode.SelectSection;
    private double _playhead;
    private readonly List<MediaFramePoint> _frameClipPolygon = [];
    private readonly List<MediaFramePoint> _morphClipPolygon = [];
    private readonly List<MediaFramePoint> _frameDraft = [];
    private readonly List<MediaFramePoint> _frameClipboard = [];
    private bool _frameRegionEditing;
    private bool _editingMorphRegion;
    private int? _selectedFramePointIndex;
    private bool _autoCreateSelectionLayers = true;
    private Guid? _selectedVideoLayerId;
    private Guid? _selectedVideoFilterId;
    private Guid? _selectedCutSectionId;
    private VideoEffectFilterKind _newVideoFilterKind = VideoEffectFilterKind.ChromaKey;
    private bool _videoSelectionIsPoint;
    private double _videoSelectionPointSeconds;
    private double _videoSelectionStartSeconds;
    private double _videoSelectionEndSeconds;
    private bool _videoSelectionUserCommitted;
    private PublicationMediaSegment? _pendingInsertSegment;
    private double _pendingInsertSourceSeconds;
    private double _pendingInsertMinimumSourceSeconds;
    private double _pendingInsertMaximumSourceSeconds;
    private double? _pendingInsertTimelineSeconds;
    private double? _pendingDropSourceSeconds;
    private double? _pendingDropTimelineSeconds;
    private bool _pendingDropIsPoint;
    private VideoProjectDocument? _videoProject;
    private Guid _activeProjectTrackId;
    private List<InterchangeIssue> _videoProjectIssues = [];

    private bool IsVideo => Kind == PublicationElementKind.Video;
    private bool HasRetainedRecording => _hasRetainedRecording && _retainedRecordingSizeBytes > 0;
    private PublisherMediaSessionDefaultsPolicy RecordingPolicy => RuntimePolicy.MediaSessionDefaults;
    private int RecordingTargetWidth => _recordingSizeMode switch
    {
        "master" => RecordingPolicy.MasterWidth,
        "output" => RecordingPolicy.OutputWidth,
        "custom" => _recordingCustomWidth,
        _ => 0
    };
    private int RecordingTargetHeight => _recordingSizeMode switch
    {
        "master" => RecordingPolicy.MasterHeight,
        "output" => RecordingPolicy.OutputHeight,
        "custom" => _recordingCustomHeight,
        _ => 0
    };
    private string RecordingSizeSummary => _recordingSizeMode switch
    {
        "master" => $"{LT("Streaming master")} · {RecordingPolicy.MasterWidth} × {RecordingPolicy.MasterHeight}",
        "output" => $"{LT("Streaming output")} · {RecordingPolicy.OutputWidth} × {RecordingPolicy.OutputHeight}",
        "custom" => $"{LT("Custom")} · {_recordingCustomWidth} × {_recordingCustomHeight}",
        _ => LT("Source/native")
    };
    private bool HasVideoProject => IsVideo && _videoProject is { Tracks.Count: > 0 };
    private IReadOnlyList<MediaTimelineTrack> ProjectVideoTracks => _videoProject?.Tracks
        .Where(track => track.Kind == MediaTimelineTrackKind.Video)
        .OrderBy(track => track.Order)
        .ToList() ?? [];
    private int VideoProjectMissingMediaCount => _videoProject?.Tracks
        .SelectMany(track => track.Segments)
        .Count(segment => !segment.IsGap && string.IsNullOrWhiteSpace(segment.DataUrl) && segment.SourceReference.Missing) ?? 0;
    private string VideoProjectTitle => _videoProject?.Name ?? "Video project";
    private string VideoProjectFormatSummary => _videoProject is null
        ? string.Empty
        : string.IsNullOrWhiteSpace(_videoProject.SourceFormatVersion)
            ? _videoProject.SourceFormat
            : $"{_videoProject.SourceFormat} {_videoProject.SourceFormatVersion}";
    private string VideoProjectCanvasSummary => _videoProject is null
        ? string.Empty
        : $"{_videoProject.Width} × {_videoProject.Height} · {_videoProject.FrameRate:0.###} fps";
    private string VideoProjectTrackSummary => _videoProject is null
        ? string.Empty
        : $"{_videoProject.Tracks.Count} track{(_videoProject.Tracks.Count == 1 ? string.Empty : "s")} · {_videoProject.Transitions.Count} transition{(_videoProject.Transitions.Count == 1 ? string.Empty : "s")}";
    private string VideoProjectMissingSummary => VideoProjectMissingMediaCount == 0
        ? "All referenced media linked"
        : $"{VideoProjectMissingMediaCount} missing media reference{(VideoProjectMissingMediaCount == 1 ? string.Empty : "s")}";
    private PublicationMediaSegment? SelectedSegment => _segments.FirstOrDefault(segment => segment.Id == _selectedSegmentId);
    private IReadOnlyList<VideoEffectLayer> SelectedVideoLayers => SelectedSegment?.VideoLayers ?? [];
    private VideoEffectLayer? SelectedVideoLayer => SelectedSegment?.VideoLayers.FirstOrDefault(layer => layer.Id == _selectedVideoLayerId);
    private IReadOnlyList<VideoEffectFilter> SelectedVideoFilters => SelectedVideoLayer?.Filters ?? [];
    private VideoEffectFilter? SelectedVideoFilter => SelectedVideoLayer?.Filters.FirstOrDefault(filter => filter.Id == _selectedVideoFilterId);
    private IReadOnlyList<MediaTemporalSection> SelectedCutSections => SelectedSegment?.CutSections ?? [];
    private MediaTemporalSection? SelectedCutSection => SelectedSegment?.CutSections.FirstOrDefault(section => section.Id == _selectedCutSectionId);
    private int SelectedSegmentIndex => _selectedSegmentId is Guid id ? _segments.FindIndex(segment => segment.Id == id) : -1;
    private bool HasSelectedSegment => SelectedSegment is not null;
    private bool HasSource => (_segments.Count > 0 || !string.IsNullOrWhiteSpace(_dataUrl) || HasRetainedRecording || HasVideoProject) && (_duration > 0 || _segments.Count > 0 || HasVideoProject);
    private bool CanPasteSection => _clipClipboard is not null;
    private bool CanDeleteSection => _segments.Count > 0 && HasSelectedSegment;
    private bool CanAddCutLine => HasSource && _segments.Count > 0;
    private bool CanRemoveCutLine => SelectedSegmentIndex > 0 && TimelineEdits.CanMergeBoundary(_segments, SelectedSegmentIndex);
    private bool CanCutVideoSelection => IsVideo && HasSelectedSegment && (_videoSelectionIsPoint || VideoSelectionEnd - VideoSelectionStart >= .01);
    private bool CanUseVideoSelectionAsTrim => IsVideo && HasSelectedSegment && !_videoSelectionIsPoint && VideoSelectionEnd - VideoSelectionStart >= .01;
    private bool CanCopyVideoSelection => CanUseVideoSelectionAsTrim;
    private bool CanSaveCutSection => IsVideo && HasSelectedSegment && !_videoSelectionIsPoint && VideoSelectionEnd - VideoSelectionStart >= .01;
    private bool CanApplySelectionToLayer => CanSaveCutSection && SelectedVideoLayer is not null;
    private int SelectedVideoLayerIndex => SelectedSegment?.VideoLayers.FindIndex(layer => layer.Id == _selectedVideoLayerId) ?? -1;
    private bool CanMoveVideoLayerUp => SelectedVideoLayerIndex >= 0 && SelectedVideoLayerIndex < (SelectedSegment?.VideoLayers.Count ?? 0) - 1;
    private bool CanMoveVideoLayerDown => SelectedVideoLayerIndex > 0;
    private bool CanDeleteVideoLayer => SelectedVideoLayer is not null && (SelectedSegment?.VideoLayers.Count ?? 0) > 1;
    private int SelectedVideoFilterIndex => SelectedVideoLayer?.Filters.FindIndex(filter => filter.Id == _selectedVideoFilterId) ?? -1;
    private bool CanMoveVideoFilterUp => SelectedVideoFilterIndex >= 0 && SelectedVideoFilterIndex < (SelectedVideoLayer?.Filters.Count ?? 0) - 1;
    private bool CanMoveVideoFilterDown => SelectedVideoFilterIndex > 0;
    private double SequenceDuration => Math.Max(.01, TimelineEdits.TimelineLength(_segments, _playbackRate));
    private IEnumerable<double> CutBoundaryPositions
    {
        get
        {
            for (var index = 1; index < _segments.Count; index++)
                yield return TimelineEdits.SegmentTimelineStart(_segments, index, _playbackRate);
        }
    }
    private List<MediaFramePoint> StoredActiveFramePoints => _editingMorphRegion ? _morphClipPolygon : _frameClipPolygon;
    private IReadOnlyList<MediaFramePoint> ActiveFramePoints => _frameRegionEditing ? _frameDraft : StoredActiveFramePoints;
    private MediaFramePoint? SelectedFramePoint => _selectedFramePointIndex is int index && index >= 0 && index < ActiveFramePoints.Count ? ActiveFramePoints[index] : null;
    private bool HasFrameRegion => _frameClipPolygon.Count >= 3;
    private bool HasMorphRegion => _morphClipPolygon.Count >= 3;
    private bool ActiveFrameRegionInverted => _editingMorphRegion
        ? SelectedVideoLayer?.MorphRegion?.Inverted == true
        : SelectedVideoLayer?.Region?.Inverted == true;
    private string ActiveFrameRegionName => _editingMorphRegion ? "morph target" : "source region";
    private bool CanFinishFrameRegion => _frameRegionEditing && _frameDraft.Count >= 3;
    private bool CanPasteFrameRegion => _frameClipboard.Count >= 3;
    private bool CanCreateSelectionLayer => CanSaveCutSection;
    private bool CanInsertLayerIntoMainframe => SelectedVideoLayer is { Kind: VideoEffectLayerKind.Blob3D };
    private double VideoSelectionStart => _videoSelectionIsPoint ? _videoSelectionPointSeconds : _videoSelectionStartSeconds;
    private double VideoSelectionEnd => _videoSelectionIsPoint ? _videoSelectionPointSeconds : _videoSelectionEndSeconds;
    private string VideoSelectionLabel => _videoSelectionIsPoint ? LT("Timestamp") : LT("Range");
    private string VideoSelectionReadout => _videoSelectionIsPoint
        ? $"/ {Time(_duration)}"
        : $"— {Time(VideoSelectionEnd)} / {Time(_duration)}";
    private double VideoSelectionTimelineStart => SourcePositionToTimeline(VideoSelectionStart);
    private double VideoSelectionTimelineEnd => SourcePositionToTimeline(VideoSelectionEnd);
    private string VideoSelectionDetailedSummary => _videoSelectionIsPoint
        ? $"Source timestamp {Time(VideoSelectionStart)} · project timestamp {Time(VideoSelectionTimelineStart)}"
        : $"Source {Time(VideoSelectionStart)} — {Time(VideoSelectionEnd)} · project {Time(VideoSelectionTimelineStart)} — {Time(VideoSelectionTimelineEnd)} · {Time(VideoSelectionEnd - VideoSelectionStart)} selected";
    private string VideoOrAudioSelectionTitle => IsVideo && _videoSelectionIsPoint ? LT("Selected timestamp") : LT("Selected range");
    private string VideoOrAudioSelectionSummary => IsVideo && _videoSelectionIsPoint
        ? $"{SelectedClipName} · {Time(_videoSelectionPointSeconds)} / {Time(_duration)}"
        : IsVideo
            ? $"{SelectedClipName} · {Time(VideoSelectionStart)} — {Time(VideoSelectionEnd)} / {Time(_duration)}"
            : $"{Time(_trimStart)} — {Time(_trimEnd)} / {Time(_duration)}";
    private string SelectedClipName => SelectedSegment?.Name ?? (IsVideo ? LT("No selected video clip") : LT("No selected audio clip"));
    private string SendToConverterMenuText => IsVideo ? LT("Send selected clip/range to Media Converter") : LT("Send selected audio clip to Media Converter");
    private double SelectedSegmentTimelineStart => SelectedSegmentIndex >= 0
        ? TimelineEdits.SegmentTimelineStart(_segments, SelectedSegmentIndex, _playbackRate)
        : 0;
    private double SelectedSegmentSourceStart => SelectedSegment?.TrimStartSeconds ?? 0;
    private double SelectedSegmentSourceEnd => SelectedSegment?.EffectiveTrimEndSeconds ?? 0;
    private double SelectedSegmentEffectiveRate => Math.Max(.0001, Math.Max(.1, _playbackRate) * Math.Max(.0001, Math.Abs(SelectedSegment?.Speed ?? 1)));
    private bool PendingInsertHasRange => _pendingInsertMaximumSourceSeconds - _pendingInsertMinimumSourceSeconds > .01;
    private string VideoTimeOverlayStyle
    {
        get
        {
            var visibleStart = Math.Max(0, Math.Min(_duration, _trimStart));
            var visibleEnd = Math.Max(visibleStart + .01, Math.Min(Math.Max(.01, _duration), _trimEnd));
            var visibleSpan = Math.Max(.01, visibleEnd - visibleStart);
            var start = Math.Clamp((VideoSelectionStart - visibleStart) / visibleSpan, 0, 1);
            var end = Math.Clamp((VideoSelectionEnd - visibleStart) / visibleSpan, 0, 1);
            var point = Math.Clamp(((_videoSelectionIsPoint ? _videoSelectionPointSeconds : visibleStart) - visibleStart) / visibleSpan, 0, 1);
            return $"--video-time-start:{Percent(start)};--video-time-end:{Percent(end)};--video-time-playhead:{Percent(point)};";
        }
    }
    private string VideoSequenceSelectionStyle
    {
        get
        {
            var index = SelectedSegmentIndex;
            if (index < 0 || index >= _segments.Count) return "left:0;width:0";
            var sequenceDuration = Math.Max(.01, SequenceDuration);
            var segment = _segments[index];
            var segmentStart = TimelineEdits.SegmentTimelineStart(_segments, index, _playbackRate);
            var rate = Math.Max(.1, _playbackRate) * Math.Max(.0001, Math.Abs(segment.Speed));
            var start = segmentStart + (Math.Clamp(VideoSelectionStart, segment.TrimStartSeconds, segment.EffectiveTrimEndSeconds) - segment.TrimStartSeconds) / rate;
            var end = segmentStart + (Math.Clamp(VideoSelectionEnd, segment.TrimStartSeconds, segment.EffectiveTrimEndSeconds) - segment.TrimStartSeconds) / rate;
            if (_videoSelectionIsPoint) return $"left:{Percent(start / sequenceDuration)};width:2px";
            return $"left:{Percent(start / sequenceDuration)};width:{Percent(Math.Max(0, end - start) / sequenceDuration)}";
        }
    }
    private string VideoSequenceSelectionStartStyle => $"left:{Percent(VideoSelectionTimelineStart / Math.Max(.01, SequenceDuration))}";
    private string VideoSequenceSelectionEndStyle => $"left:{Percent(VideoSelectionTimelineEnd / Math.Max(.01, SequenceDuration))}";
    private string VideoSequenceSelectionTitle => _videoSelectionIsPoint
        ? $"{SelectedClipName}: timestamp {Time(VideoSelectionStart)}"
        : $"{SelectedClipName}: selected {Time(VideoSelectionStart)} — {Time(VideoSelectionEnd)}";
    private string FramePolylinePoints => string.Join(" ", ActiveFramePoints.Select(point => $"{Inv(point.X * 1000)},{Inv(point.Y * 1000)}"));
    private string FramePolygonPoints => FramePolylinePoints;
    private string FrameDimPath => ActiveFramePoints.Count >= 3
