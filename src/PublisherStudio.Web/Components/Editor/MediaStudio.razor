    private double MinorTick => Math.Max(.1, MajorTick / 5);

    protected override void OnParametersSet()
    {
        try
        {
            if (!Visible || SessionId == Guid.Empty || SessionId == _loadedSession) return;
            _loadedSession = SessionId;
            _recordingRecoveryAttemptedSession = Guid.Empty;
            MediaAssets.Remove(_previewAssetId);
            _previewAssetId = Guid.NewGuid();
            _previewSource = string.Empty;
            _error = null;
            _warning = null;
            _recording = false;
            _recordingStopping = false;
            _renderingVideoExport = false;
            _recordingAdaptiveQuality = RecordingPolicy.AdaptiveQuality.Enabled;
            _recordingAdaptiveProfile = NormalizeAdaptiveProfile(RecordingPolicy.AdaptiveQuality.DefaultProfile);
            _recordingAdaptVideo = true;
            _recordingAdaptAudio = true;
            _recordingUseBrowserCapabilityProbe = RecordingPolicy.AdaptiveQuality.BrowserCapabilityProbeEnabled;
            _recordingPreserveNativeResolution = RecordingPolicy.AdaptiveQuality.PreserveNativeResolution;
            _recordingAllowFrameRateReduction = RecordingPolicy.AdaptiveQuality.AllowFrameRateReduction;
            _recordingAllowResolutionReduction = RecordingPolicy.AdaptiveQuality.AllowResolutionReduction;
            _recordingSizeMode = "source";
            _recordingCustomWidth = Math.Clamp(RecordingPolicy.MasterWidth, RecordingPolicy.MinimumWidth, RecordingPolicy.MaximumWidth);
            _recordingCustomHeight = Math.Clamp(RecordingPolicy.MasterHeight, RecordingPolicy.MinimumHeight, RecordingPolicy.MaximumHeight);
            _recordingFrameRate = RecordingPolicy.AdaptiveQuality.MaximumAutomaticFrameRate > 0
                ? Math.Clamp(RecordingPolicy.AdaptiveQuality.MaximumAutomaticFrameRate, RecordingPolicy.MinimumFrameRate, RecordingPolicy.MaximumFrameRate)
                : 0;
            _recordingVideoBitrateKbps = Math.Clamp(
                RecordingPolicy.BrowserRecordingVideoBitrateKbps > 0 ? RecordingPolicy.BrowserRecordingVideoBitrateKbps : RecordingPolicy.VideoBitrateKbps,
                RecordingPolicy.MinimumVideoBitrateKbps,
                RecordingPolicy.MaximumVideoBitrateKbps);
            _recordingAudioBitrateKbps = Math.Max(32, RecordingPolicy.BrowserRecordingAudioBitrateKbps > 0 ? RecordingPolicy.BrowserRecordingAudioBitrateKbps : RecordingPolicy.AudioBitrateKbps);
            _recordingCodecPreference = NormalizeRecordingCodecPreference(RecordingPolicy.BrowserRecordingCodecPreference);
            _saving = false;
            _embedding = false;
            _embeddingProgress = 0;
            _hasRetainedRecording = false;
            _retainedRecordingSizeBytes = 0;
            _retainedRecordingFileName = string.Empty;
            _retainedRecordingObjectUrl = string.Empty;
            _segments.Clear();
            _selectedSegmentId = null;
            _playhead = 0;
            _mouseMode = MediaStudioMouseMode.SelectSection;
            _frameClipPolygon.Clear();
            _morphClipPolygon.Clear();
            _frameDraft.Clear();
            _frameRegionEditing = false;
            _editingMorphRegion = false;
            _selectedFramePointIndex = null;
            _selectedVideoLayerId = null;
            _selectedVideoFilterId = null;
            _selectedCutSectionId = null;
            _newVideoFilterKind = VideoEffectFilterKind.ChromaKey;
            _videoSelectionIsPoint = false;
            _videoSelectionPointSeconds = 0;
            _videoSelectionStartSeconds = 0;
            _videoSelectionEndSeconds = 0;
            _videoFitMode = PublicationVideoFitMode.Stretch;
            _videoProject = null;
            _activeProjectTrackId = Guid.Empty;
            _videoProjectIssues = [];
            ClearPendingInsert();

            if (InitialMedia is { } media)
            {
                _volume = media.Volume;
                _playbackRate = media.PlaybackRate;
                _fadeIn = media.FadeInSeconds;
                _fadeOut = media.FadeOutSeconds;
                _muted = media.Muted;
                _loop = media.Loop;
                _autoPlay = media.AutoPlay;
                _playbackTrigger = media.PlaybackTrigger;
                IEnumerable<PublicationMediaSegment> sourceSegments;
                if (media is VideoElement projectVideo && projectVideo.VideoProject is { Tracks.Count: > 0 } project)
                {
                    _videoProject = TimelineEdits.CloneVideoProject(project);
                    _activeProjectTrackId = ResolveActiveProjectTrackId(_videoProject);
                    sourceSegments = TimelineEdits.CreateTrackProjection(_videoProject, _activeProjectTrackId);
                }
                else
                {
                    sourceSegments = media.Segments is { Count: > 0 }
                        ? media.Segments
                        : [new PublicationMediaSegment
                        {
                            Name = media.Name,
                            DataUrl = media.DataUrl,
                            MimeType = media.MimeType,
                            PosterDataUrl = media is VideoElement legacyVideo ? legacyVideo.PosterDataUrl : string.Empty,
                            DurationSeconds = media.DurationSeconds,
                            TrimStartSeconds = media.TrimStartSeconds,
                            TrimEndSeconds = media.EffectiveTrimEndSeconds,
                            WaveformSamples = [.. media.WaveformSamples]
                        }];
                }
                _segments.AddRange(TimelineEdits.Normalize(sourceSegments, IsVideo));
                if (media is VideoElement video)
                {
                    _videoFitMode = video.FitModeExplicit || video.FitMode != PublicationVideoFitMode.Contain
                        ? video.FitMode
                        : PublicationVideoFitMode.Stretch;
                    var legacyRegion = CloneFramePoints(video.FrameClipPolygon);
                    var firstVideoLayer = _segments.FirstOrDefault()?.VideoLayers.FirstOrDefault();
                    if (legacyRegion.Count >= 3 && firstVideoLayer is not null && firstVideoLayer.Region.IsFullFrame)
                    {
                        firstVideoLayer.Region.Name = "Legacy frame region";
                        firstVideoLayer.Region.Points = legacyRegion;
                    }
                }
            }
            else
            {
                _volume = 1;
                _playbackRate = 1;
                _fadeIn = _fadeOut = 0;
                _muted = _loop = false;
                _autoPlay = true;
                _playbackTrigger = PublicationMediaPlaybackTrigger.OnPageEnter;
            }

            if (InitialInsertedSegment is { } inserted)
            {
                var normalizedInsert = TimelineEdits.Normalize([inserted], IsVideo).FirstOrDefault();
                if (normalizedInsert is not null)
                {
                    normalizedInsert.Id = Guid.NewGuid();
                    _segments.Add(normalizedInsert);
                    _warning = $"Added {normalizedInsert.Name} to the {(IsVideo ? "video" : "audio")} sequence.";
                }
            }

            if (_segments.Count > 0)
            {
                var initial = _segments.FirstOrDefault(IsPlayableSegment)
                    ?? _segments.FirstOrDefault(segment => !segment.IsGap)
                    ?? _segments[0];
                SelectSegment(initial.Id, seek: false);
            }
            else ClearSelectedSegmentFields();
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(MediaStudio)}.{nameof(OnParametersSet)} failed.");
            throw;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!Visible || _disposed || SessionId == Guid.Empty) return;
            var stateChanged = false;
            try
            {
                var module = await EnsureMediaModuleAsync().ConfigureAwait(true);
                var shouldRefreshRecordingOwnership = _recordingRecoveryAttemptedSession != SessionId || _recording || _recordingStopping;
                if (shouldRefreshRecordingOwnership)
                {
                    _recordingRecoveryAttemptedSession = SessionId;
                    var stateInvocation = module.InvokeAsync<BrowserMediaRecordingState>(
                        "getMediaRecordingState",
                        "media-studio-preview",
                        _self);
                    var browserState = await stateInvocation.ConfigureAwait(true);
                    if (browserState.RetainedRecording is { SizeBytes: > 0 } retainedRecording)
                    {
                        var changed = !HasRetainedRecording
                            || _recording
                            || _recordingStopping
                            || !string.Equals(_retainedRecordingObjectUrl, retainedRecording.ObjectUrl, StringComparison.Ordinal);
                        ApplyRetainedRecordingInfo(retainedRecording);
                        stateChanged |= changed;
                        if (changed)
                        {
                            Logger.LogInformation(
                                "Recovered retained {MediaKind} recording {FileName} ({SizeBytes} bytes) after Media Studio render/circuit attachment.",
                                IsVideo ? "video" : "audio",
                                retainedRecording.FileName,
                                retainedRecording.SizeBytes);
                        }
                    }
                    else if (browserState.IsFinalizing)
                    {
                        var changed = !_recording || !_recordingStopping;
                        _recording = true;
                        _recordingStopping = true;
                        _warning = "Browser recording is finalizing after the UI reconnected.";
                        stateChanged |= changed;
                        if (changed)
                        {
                            Logger.LogInformation(
                                "Recovered finalizing {MediaKind} recording state after Media Studio render/circuit attachment.",
                                IsVideo ? "video" : "audio");
                        }
                    }
                    else if (browserState.IsRecording)
                    {
                        var changed = !_recording || _recordingStopping;
                        _recording = true;
                        _recordingStopping = false;
                        _warning = "Browser recording is still active after the UI reconnected.";
                        stateChanged |= changed;
                        if (changed)
                        {
                            Logger.LogInformation(
                                "Recovered active {MediaKind} recording state after Media Studio render/circuit attachment.",
                                IsVideo ? "video" : "audio");
                        }
                    }

                    if (!string.IsNullOrWhiteSpace(browserState.FinalizationError))
                    {
                        _recording = false;
                        _recordingStopping = false;
                        _error = $"Recording finalization failed in the browser: {browserState.FinalizationError}";
                        stateChanged = true;
                        Logger.LogError(
                            "Browser reported a retained recording finalization error after Media Studio reconnect: {RecordingError}",
                            browserState.FinalizationError);
                    }
                }

                if (IsVideo && HasSource) await SyncVideoEffectsAsync(module).ConfigureAwait(true);
                if (stateChanged) await InvokeAsync(StateHasChanged).ConfigureAwait(true);
            }
            catch (JSDisconnectedException ex)
            {
                Logger.LogWarning(ex, "Media Studio browser connection disconnected while attaching or recovering recording state.");
            }
            catch (TaskCanceledException ex)
            {
                Logger.LogWarning(ex, "Media Studio browser attachment or recording-state recovery was canceled.");
            }
            catch (ObjectDisposedException ex)
            {
                Logger.LogDebug(ex, "Media Studio was disposed while browser attachment or recording-state recovery was in progress.");
            }
            catch (JSException ex)
            {
                Logger.LogError(ex, "Media Studio browser initialization failed.");
                _error = $"Media Studio could not initialize: {ex.Message}";
                try { await InvokeAsync(StateHasChanged).ConfigureAwait(true); }
                catch (ObjectDisposedException disposedException)
                {
                    Logger.LogDebug(disposedException, "Media Studio was disposed before its initialization error could be rendered.");
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Unexpected Media Studio render/recovery failure.");
                _error = $"Media Studio could not restore browser media state: {ex.Message}";
                try { await InvokeAsync(StateHasChanged).ConfigureAwait(true); }
                catch (ObjectDisposedException disposedException)
                {
                    Logger.LogDebug(disposedException, "Media Studio was disposed before its recovery error could be rendered.");
                }
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(MediaStudio)}.{nameof(OnAfterRenderAsync)} failed.");
            throw;
        }
    }

    private async Task<IJSObjectReference> EnsureMediaModuleAsync()
    {
        try
        {
            if (_disposed) throw new ObjectDisposedException(nameof(MediaStudio));
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/mediaStudioInterop.js?v=2.8.6").ConfigureAwait(true);
            _self ??= DotNetObjectReference.Create(this);
            if (SessionId != Guid.Empty)
            {
                // The sequence timeline and its two selection handles are rendered only after a source exists.
                // Rebinding is intentionally idempotent so a session that started empty becomes fully interactive
                // immediately after import, and so rerendered selected segments remain clickable/adjustable.
                await _module.InvokeVoidAsync(
                    "initializeMediaStudio",
                    "media-studio-preview",
                    _self,
                    SessionId.ToString("N"),
                    "media-studio-window",
                    IsVideo ? "media-studio-frame-stage" : string.Empty,
                    IsVideo ? "media-studio-frame-overlay-host" : string.Empty,
                    IsVideo ? "media-studio-video-time-overlay" : string.Empty,
                    "media-studio-sequence-timeline",
                    "media-studio-file-input",
                    "media-studio-insert-file-input",
                    IsVideo ? "media-studio-project-input" : string.Empty,
                    IsVideo ? "video" : "audio").ConfigureAwait(true);
                _initializedSession = SessionId;
            }
            return _module;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(MediaStudio)}.{nameof(EnsureMediaModuleAsync)} failed.");
            throw;
        }
    }

