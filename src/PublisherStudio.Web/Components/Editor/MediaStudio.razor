        <DxContextMenuItem Text="@(_muted ? LT("Unmute") : LT("Mute"))" BeginGroup="true" Click="ToggleMutedFromMenu" />
        <DxContextMenuItem Text="@(_loop ? LT("Disable loop") : LT("Loop selected range"))" Click="ToggleLoopFromMenu" />
        <DxContextMenuItem Text="@SendToConverterMenuText" Enabled="@HasSelectedSegment" BeginGroup="true" Click="SendSelectedMediaToConverter" />
        <DxContextMenuItem Text='@LT("Import replacement…")' Enabled="@(!_recording && !_recordingStopping)" BeginGroup="true" Click="OpenMediaPicker" />
    </Items>
</DxContextMenu>

<InputFile id="media-studio-file-input" class="hidden-file-input" accept="@Accept" OnChange="LoadFile" />
<InputFile id="media-studio-insert-file-input" class="hidden-file-input" accept="@Accept" OnChange="LoadInsertedFile" />
