                next.Id = _segments[index].Id;
                _segments[index] = next;
            }
            else
            {
                _segments.Add(next);
            }
            SelectSegment(next.Id, seek: false);
            _playhead = Math.Clamp(_playhead, 0, SequenceDuration);
    
        }
