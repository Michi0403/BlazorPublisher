                                    <label>@LT("Smoothness") <b>@Inv(selectedFilter.SecondaryAmount)</b><input type="range" min="0.001" max="1" step="0.01" value="@Inv(selectedFilter.SecondaryAmount)" @oninput="ChangeVideoFilterSecondaryAmount" /></label>
                                    <label>@LT("Spill reduction") <b>@Inv(selectedFilter.TertiaryAmount)</b><input type="range" min="0" max="1" step="0.01" value="@Inv(selectedFilter.TertiaryAmount)" @oninput="ChangeVideoFilterTertiaryAmount" /></label>
                                    <label>@LT("Residual opacity") <b>@Inv(selectedFilter.ResidualOpacity)</b><input type="range" min="0" max="1" step="0.01" value="@Inv(selectedFilter.ResidualOpacity)" @oninput="ChangeVideoFilterResidualOpacity" /></label>
                                }
                                else if (selectedFilter.Kind == VideoEffectFilterKind.Vignette)
                                {
                                    <label>@LT("Strength") <b>@Inv(selectedFilter.Amount)</b><input type="range" min="0" max="1" step="0.01" value="@Inv(selectedFilter.Amount)" @oninput="ChangeVideoFilterAmount" /></label>
                                    <label>@LT("Softness") <b>@Inv(selectedFilter.SecondaryAmount)</b><input type="range" min="0" max="1" step="0.01" value="@Inv(selectedFilter.SecondaryAmount)" @oninput="ChangeVideoFilterSecondaryAmount" /></label>
                                }
                                else
                                {
                                    <label>@VideoFilterAmountLabel(selectedFilter.Kind) <b>@Inv(selectedFilter.Amount)</b>
                                        <input type="range" min="@Inv(VideoFilterMinimum(selectedFilter.Kind))" max="@Inv(VideoFilterMaximum(selectedFilter.Kind))" step="@Inv(VideoFilterStep(selectedFilter.Kind))" value="@Inv(selectedFilter.Amount)" @oninput="ChangeVideoFilterAmount" /> </label>
                                    @if (selectedFilter.Kind == VideoEffectFilterKind.ColorWash)
                                    {
                                        <label>@LT("Wash color")<DevExpressColorPicker Value="@selectedFilter.Color" Changed="ChangeVideoFilterColor" /></label>
                                    }
                                }
                                <div class="property-action-row">
                                    <DxButton Text='@LT("Filter up")' Enabled="@CanMoveVideoFilterUp" Click="MoveVideoFilterUp" />
                                    <DxButton Text='@LT("Filter down")' Enabled="@CanMoveVideoFilterDown" Click="MoveVideoFilterDown" />
                                    <DxButton Text='@LT("Remove filter")' Click="RemoveSelectedVideoFilter" />
                                </div>
                            }
                        </div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>

                        <DxFormLayout CssClass="razor-section-layout-owner">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext009">
        <div>
                            <h3>@LT("Video inside play canvas")</h3>
