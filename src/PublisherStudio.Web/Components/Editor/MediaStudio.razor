        <DxContextMenuItem Text='@LT("Play selected range")' Enabled="@HasSource" BeginGroup="true" Click="PlaySelection" />
        <DxContextMenuItem Text='@LT("Pause")' Enabled="@HasSource" Click="PausePreview" />
        <DxContextMenuItem Text='@LT("Jump to trim start")' Enabled="@HasSource" Click="SeekStart" />
        <DxContextMenuItem Text='@LT("Set trim start at playhead")' Enabled="@HasSource" BeginGroup="true" Click="SetTrimStartAtPlayhead" />
        <DxContextMenuItem Text='@LT("Set trim end at playhead")' Enabled="@HasSource" Click="SetTrimEndAtPlayhead" />
        <DxContextMenuItem Text='@LT("Reset trim to full clip")' Enabled="@HasSource" Click="ResetTrim" />
        <DxContextMenuItem Text="@MouseModeText(MediaStudioMouseMode.SelectSection, "Pointer: select timestamp/range")" BeginGroup="true" Click="SelectSectionMode" />
        <DxContextMenuItem Text="@MouseModeText(MediaStudioMouseMode.PlacePlayhead, "Pointer: place playhead")" Enabled="@HasSource" Click="PlacePlayheadMode" />
        <DxContextMenuItem Text="@MouseModeText(MediaStudioMouseMode.AddCutLine, "Pointer: add cutline")" Enabled="@HasSource" Click="AddCutLineMode" />
        @if (IsVideo)
        {
            <DxContextMenuItem Text="@MouseModeText(MediaStudioMouseMode.FrameRegion, "Pointer: frame region")" Enabled="@HasSource" Click="FrameRegionMode" />
            <DxContextMenuItem Text="@VideoFitModeText(PublicationVideoFitMode.Stretch, "Canvas: stretch")" Enabled="@HasSource" BeginGroup="true" Click="VideoFitStretch" />
            <DxContextMenuItem Text="@VideoFitModeText(PublicationVideoFitMode.Cover, "Canvas: fill and crop")" Enabled="@HasSource" Click="VideoFitCover" />
            <DxContextMenuItem Text="@VideoFitModeText(PublicationVideoFitMode.Contain, "Canvas: fit whole")" Enabled="@HasSource" Click="VideoFitContain" />
            <DxContextMenuItem Text='@LT("Cut selected timestamp/range")' Enabled="@CanCutVideoSelection" BeginGroup="true" Click="CutVideoSelection" />
            <DxContextMenuItem Text='@LT("Use selected range as trim")' Enabled="@CanUseVideoSelectionAsTrim" Click="UseVideoSelectionAsTrim" />
            <DxContextMenuItem Text='@LT("Copy selected range")' Enabled="@CanCopyVideoSelection" Click="CopyVideoSelection" />
            <DxContextMenuItem Text='@LT("Save selection as cut section")' Enabled="@CanSaveCutSection" Click="SaveSelectedRangeAsCutSection" />
            <DxContextMenuItem Text='@LT("Use selected saved section")' Enabled="@(SelectedCutSection is not null)" Click="UseSelectedCutSection" />
            <DxContextMenuItem Text='@LT("Remove selected saved section")' Enabled="@(SelectedCutSection is not null)" Click="RemoveSelectedCutSection" />
            <DxContextMenuItem Text='@LT("Create layer from selected range")' Enabled="@CanCreateSelectionLayer" BeginGroup="true" Click="CreateSelectionLayer" />
            <DxContextMenuItem Text='@LT("Add video layer")' Enabled="@HasSelectedSegment" Click="AddVideoLayer" />
            <DxContextMenuItem Text='@LT("Duplicate selected layer")' Enabled="@(SelectedVideoLayer is not null)" Click="DuplicateVideoLayer" />
            <DxContextMenuItem Text='@LT("Apply selected range to layer")' Enabled="@CanApplySelectionToLayer" Click="ApplySelectionToSelectedVideoLayer" />
            <DxContextMenuItem Text='@LT("Move layer up")' Enabled="@CanMoveVideoLayerUp" Click="MoveVideoLayerUp" />
            <DxContextMenuItem Text='@LT("Move layer down")' Enabled="@CanMoveVideoLayerDown" Click="MoveVideoLayerDown" />
            <DxContextMenuItem Text='@LT("Delete selected layer")' Enabled="@CanDeleteVideoLayer" Click="DeleteVideoLayer" />
            <DxContextMenuItem Text='@LT("Convert selected layer to animated 3D blob")' Enabled="@(SelectedVideoLayer is not null)" Click="ConvertSelectedLayerToBlob" />
            <DxContextMenuItem Text='@LT("Insert selected 3D blob into Mainframe")' Enabled="@CanInsertLayerIntoMainframe" Click="InsertSelectedLayerIntoMainframe" />
            <DxContextMenuItem Text='@LT("Add chroma key filter")' Enabled="@(SelectedVideoLayer is not null)" BeginGroup="true" Click="AddChromaKeyFilter" />
            <DxContextMenuItem Text='@LT("Add color adjustment filters")' Enabled="@(SelectedVideoLayer is not null)" Click="AddColorAdjustmentFilters" />
            <DxContextMenuItem Text='@LT("Add vignette filter")' Enabled="@(SelectedVideoLayer is not null)" Click="AddVignetteFilter" />
