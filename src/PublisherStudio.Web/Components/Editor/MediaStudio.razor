@namespace PublisherStudio.Components.Editor
@using PublisherStudio.Services.Configuration
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject PublicationMediaAssetStore MediaAssets
@inject MediaTimelineEditService TimelineEdits
@inject VideoProjectImportService VideoProjectImporter
@inject VideoLayerInterchangeService VideoLayerInterchange
@inject IPublisherRuntimePolicyDataService RuntimePolicy
@inject IPanelStudioPreviewPresetService PreviewPresets
@inject IFileLocalizationService Localization
@inject ILogger<MediaStudio> Logger
@inject PublicationEditorTextService EditorText

@inject ISupervisedTaskRunner TaskRunner
@if (Visible)
{
<div class="razor-component-boundary">
<DxFormLayout CssClass="razor-component-layout-owner MediaStudio">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext001">
@if (Visible)
{
    <DxPopup Visible="true"
         Width="92vw"
         Height="90dvh"
         MaxHeight="90dvh"
         CloseOnOutsideClick="false"
         CloseOnEscape="false"
         ShowHeader="false">
    <BodyContentTemplate Context="publisherPopupContext">
        <div id="media-studio-window" class="media-studio-window" tabindex="0" aria-label="@(IsVideo ? LT("Video Studio") : LT("Audio Studio"))">
            <MediaStudioTitlebar Title="@StudioTitle" Subtitle="@StudioSubtitle" CloseLabel='@LT("Close")' CloseRequested="Cancel" />

            <DxRibbon CssClass="media-studio-ribbon categorized-ribbon" SizeMode="SizeMode.Medium" AdaptivityAutoCollapseItemsToGroups="true">
                <DxRibbonTab Text='@LT("Home")'>
                    <DxRibbonGroup Text='@LT("Source")' IconCssClass="pub-icon pub-icon-media">
                        <DxRibbonItem Text="@ImportMenuText" IconCssClass="pub-icon pub-icon-open" IsPrimary="true" Enabled="@(!_recording && !_recordingStopping)" Click="OpenMediaPicker" />
                        @if (IsVideo)
                        {
                            <DxRibbonItem Text='@LT("Import project…")' IconCssClass="pub-icon pub-icon-open" Enabled="@(!_recording && !_recordingStopping)" Click="OpenVideoProjectPicker" />
                            <DxRibbonItem Text='@LT("Relink media…")' IconCssClass="pub-icon pub-icon-refresh" Enabled="@HasVideoProject" Click="OpenVideoProjectMediaPicker" />
                            <DxRibbonItem Text='@LT("Record camera")' IconCssClass="pub-icon pub-icon-video" Enabled="@(!_recording && !_recordingStopping && !_recordingPlacementRequired && !_recordingStartPlacementRequired)" Click="RecordCamera" />
                            <DxRibbonItem Text='@LT("Record screen")' IconCssClass="pub-icon pub-icon-video" Enabled="@(!_recording && !_recordingStopping && !_recordingPlacementRequired && !_recordingStartPlacementRequired)" Click="RecordScreen" />
                        }
                        else
                        {
                            <DxRibbonItem Text='@LT("Record microphone")' IconCssClass="pub-icon pub-icon-audio" Enabled="@(!_recording && !_recordingStopping && !_recordingPlacementRequired)" Click="RecordMicrophone" />
                            <DxRibbonItem Text='@LT("Generate tone")' IconCssClass="pub-icon pub-icon-audio" Enabled="@(!_recording && !_recordingStopping)" Click="GenerateTone" />
                        }
                        <DxRibbonItem Text='@LT("Stop recording")' IconCssClass="pub-icon pub-icon-stop" Enabled="@(_recording && !_recordingStopping)" Click="StopRecording" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text='@LT("Playback")' IconCssClass="pub-icon pub-icon-play">
                        <DxRibbonItem Text='@LT("Play range")' IconCssClass="pub-icon pub-icon-play" Enabled="@HasSource" Click="PlaySelection" />
                        <DxRibbonItem Text='@LT("Pause")' IconCssClass="pub-icon pub-icon-pause" Enabled="@HasSource" Click="PausePreview" />
                        <DxRibbonItem Text='@LT("To trim start")' IconCssClass="pub-icon pub-icon-crop" Enabled="@HasSource" Click="SeekStart" />
                    </DxRibbonGroup>
                    @if (IsVideo)
                    {
                        <DxRibbonGroup Text='@LT("Canvas")' IconCssClass="pub-icon pub-icon-video">
                            <DxRibbonItem Text="@VideoFitModeText(PublicationVideoFitMode.Stretch, "Stretch")" Enabled="@HasSource" Click="VideoFitStretch" />
                            <DxRibbonItem Text="@VideoFitModeText(PublicationVideoFitMode.Cover, "Fill canvas")" Enabled="@HasSource" Click="VideoFitCover" />
                            <DxRibbonItem Text="@VideoFitModeText(PublicationVideoFitMode.Contain, "Fit whole")" Enabled="@HasSource" Click="VideoFitContain" />
                        </DxRibbonGroup>
                    }
                </DxRibbonTab>
                <DxRibbonTab Text='@LT("Edit")'>
                    <DxRibbonGroup Text='@LT("Pointer")' IconCssClass="pub-icon pub-icon-select">
                        <DxRibbonItem Text="@MouseModeText(MediaStudioMouseMode.SelectSection, "Select time")" IconCssClass="pub-icon pub-icon-select" Click="SelectSectionMode" />
                        <DxRibbonItem Text="@MouseModeText(MediaStudioMouseMode.PlacePlayhead, "Place playhead")" IconCssClass="pub-icon pub-icon-line" Enabled="@HasSource" Click="PlacePlayheadMode" />
                        <DxRibbonItem Text="@MouseModeText(MediaStudioMouseMode.AddCutLine, "Add cutline")" IconCssClass="pub-icon pub-icon-crop" Enabled="@HasSource" Click="AddCutLineMode" />
                        @if (IsVideo)
                        {
                            <DxRibbonItem Text="@MouseModeText(MediaStudioMouseMode.FrameRegion, "Frame region")" IconCssClass="pub-icon pub-icon-select" Enabled="@HasSource" Click="FrameRegionMode" />
                        }
                    </DxRibbonGroup>
                    <DxRibbonGroup Text='@LT("Trim")' IconCssClass="pub-icon pub-icon-crop">
                        <DxRibbonItem Text='@LT("Start at playhead")' Enabled="@HasSource" Click="SetTrimStartAtPlayhead" />
                        <DxRibbonItem Text='@LT("End at playhead")' Enabled="@HasSource" Click="SetTrimEndAtPlayhead" />
                        <DxRibbonItem Text='@LT("Reset trim")' Enabled="@HasSource" Click="ResetTrim" />
                    </DxRibbonGroup>
                    @if (IsVideo)
                    {
                        <DxRibbonGroup Text='@LT("Selection")'>
                            <DxRibbonItem Text='@LT("Cut selection")' IconCssClass="pub-icon pub-icon-line" Enabled="@CanCutVideoSelection" Click="CutVideoSelection" />
                            <DxRibbonItem Text='@LT("Trim to selection")' IconCssClass="pub-icon pub-icon-crop" Enabled="@CanUseVideoSelectionAsTrim" Click="UseVideoSelectionAsTrim" />
                            <DxRibbonItem Text='@LT("Copy selection")' IconCssClass="pub-icon pub-icon-copy" Enabled="@CanCopyVideoSelection" Click="CopyVideoSelection" />
                        </DxRibbonGroup>
                        <DxRibbonGroup Text='@LT("Saved sections")' IconCssClass="pub-icon pub-icon-line">
                            <DxRibbonItem Text='@LT("Save section")' Enabled="@CanSaveCutSection" Click="SaveSelectedRangeAsCutSection" />
                            <DxRibbonItem Text='@LT("Use section")' Enabled="@(SelectedCutSection is not null)" Click="UseSelectedCutSection" />
                            <DxRibbonItem Text='@LT("Remove section")' IconCssClass="pub-icon pub-icon-delete" Enabled="@(SelectedCutSection is not null)" Click="RemoveSelectedCutSection" />
                        </DxRibbonGroup>
                    }
                    <DxRibbonGroup Text='@LT("Sequence")' IconCssClass="pub-icon pub-icon-line">
                        <DxRibbonItem Text='@LT("Cut at playhead")' Enabled="@CanAddCutLine" Click="AddCutLineAtPlayhead" />
                        <DxRibbonItem Text='@LT("Remove cutline")' Enabled="@CanRemoveCutLine" Click="RemoveCutLine" />
                        <DxRibbonItem Text='@LT("Copy")' IconCssClass="pub-icon pub-icon-copy" Enabled="@HasSelectedSegment" Click="CopySelectedSection" />
                        <DxRibbonItem Text='@LT("Paste")' IconCssClass="pub-icon pub-icon-paste" Enabled="@CanPasteSection" Click="PasteSection" />
                        <DxRibbonItem Text='@LT("Delete")' IconCssClass="pub-icon pub-icon-delete" Enabled="@CanDeleteSection" Click="DeleteSelectedSection" />
                        <DxRibbonItem Text='@LT("Insert media…")' IconCssClass="pub-icon pub-icon-insert" Enabled="@HasSource" Click="OpenInsertMediaPicker" />
                    </DxRibbonGroup>
                </DxRibbonTab>
                @if (IsVideo)
                {
                    <DxRibbonTab Text='@LT("Layers")'>
                        <DxRibbonGroup Text='@LT("Layer stack")' IconCssClass="pub-icon pub-icon-layers">
                            <DxRibbonItem Text='@LT("Add layer")' Enabled="@HasSelectedSegment" Click="AddVideoLayer" />
                            <DxRibbonItem Text='@LT("Duplicate")' Enabled="@(SelectedVideoLayer is not null)" Click="DuplicateVideoLayer" />
                            <DxRibbonItem Text='@LT("Selection → new layer")' Enabled="@CanCreateSelectionLayer" Click="CreateSelectionLayer" />
                            <DxRibbonItem Text='@LT("Selection → layer")' Enabled="@CanApplySelectionToLayer" Click="ApplySelectionToSelectedVideoLayer" />
                            <DxRibbonItem Text='@LT("Layer up")' Enabled="@CanMoveVideoLayerUp" Click="MoveVideoLayerUp" />
                            <DxRibbonItem Text='@LT("Layer down")' Enabled="@CanMoveVideoLayerDown" Click="MoveVideoLayerDown" />
                            <DxRibbonItem Text='@LT("Delete layer")' IconCssClass="pub-icon pub-icon-delete" Enabled="@CanDeleteVideoLayer" Click="DeleteVideoLayer" />
                        </DxRibbonGroup>
                        <DxRibbonGroup Text='@LT("3D surface")' IconCssClass="pub-icon pub-icon-effects">
                            <DxRibbonItem Text='@LT("Extrude selected layer")' Enabled="@(SelectedVideoLayer is not null)" Click="ConvertSelectedLayerToBlob" />
                            <DxRibbonItem Text='@LT("Insert 3D in Mainframe")' Enabled="@CanInsertLayerIntoMainframe" Click="InsertSelectedLayerIntoMainframe" />
                        </DxRibbonGroup>
                    </DxRibbonTab>
                    <DxRibbonTab Text='@LT("Effects")'>
                        <DxRibbonGroup Text='@LT("Quick effects")' IconCssClass="pub-icon pub-icon-effects">
                            <DxRibbonItem Text='@LT("Chroma key")' Enabled="@(SelectedVideoLayer is not null)" Click="AddChromaKeyFilter" />
                            <DxRibbonItem Text='@LT("Vignette")' Enabled="@(SelectedVideoLayer is not null)" Click="AddVignetteFilter" />
                            <DxRibbonItem Text='@LT("Blur")' Enabled="@(SelectedVideoLayer is not null)" Click="AddBlurFilter" />
                            <DxRibbonItem Text='@LT("Film grain")' Enabled="@(SelectedVideoLayer is not null)" Click="AddGrainFilter" />
                            <DxRibbonItem Text='@LT("Color adjustment")' Enabled="@(SelectedVideoLayer is not null)" Click="AddColorAdjustmentFilters" />
                        </DxRibbonGroup>
                        <DxRibbonGroup Text='@LT("Effect stack")' IconCssClass="pub-icon pub-icon-layers">
                            <DxRibbonItem Text='@LT("Add selected effect")' Enabled="@(SelectedVideoLayer is not null)" Click="AddSelectedVideoFilter" />
                            <DxRibbonItem Text='@LT("Effect up")' Enabled="@CanMoveVideoFilterUp" Click="MoveVideoFilterUp" />
                            <DxRibbonItem Text='@LT("Effect down")' Enabled="@CanMoveVideoFilterDown" Click="MoveVideoFilterDown" />
                            <DxRibbonItem Text='@LT("Remove effect")' IconCssClass="pub-icon pub-icon-delete" Enabled="@(SelectedVideoFilter is not null)" Click="RemoveSelectedVideoFilter" />
                        </DxRibbonGroup>
                    </DxRibbonTab>
                }
                <DxRibbonTab Text='@LT("Output")'>
                    <DxRibbonGroup Text='@LT("Recording")' IconCssClass="pub-icon pub-icon-download">
                        <DxRibbonItem Text="@DownloadMediaText" IconCssClass="pub-icon pub-icon-download" Enabled="@CanDownloadCurrentMedia" Click="DownloadRecording" />
                    </DxRibbonGroup>
                    @if (IsVideo)
                    {
                        <DxRibbonGroup Text='@LT("Rendered video")' IconCssClass="pub-icon pub-icon-effects">
                            <DxRibbonItem Text='@LT("Render selected range to video…")' IconCssClass="pub-icon pub-icon-download" Enabled="@(HasSource && !_renderingVideoExport && !_renderingTimelineSelectionExport)" Click="RenderEffectsToVideo" />
                            <DxRibbonItem Text='@LT("Render selected range to animated GIF…")' IconCssClass="pub-icon pub-icon-download" Enabled="@(HasSource && !_renderingVideoExport && !_renderingTimelineSelectionExport)" Click="RenderEffectsToGif" />
                            <DxRibbonItem Text='@LT("Export selected ranges separately…")' IconCssClass="pub-icon pub-icon-download" Enabled="@CanExportSelectedTimelineRanges" Click="ExportSelectedTimelineRangesSeparately" />
                            <DxRibbonItem Text='@LT("Export selected ranges combined…")' IconCssClass="pub-icon pub-icon-download" Enabled="@CanExportSelectedTimelineRanges" Click="ExportSelectedTimelineRangesCombined" />
                            <DxRibbonItem Text='@LT("Cancel rendered export")' IconCssClass="pub-icon pub-icon-stop" Enabled="@(_renderingVideoExport || _renderingTimelineSelectionExport)" Click="CancelRenderedVideoExport" />
                        </DxRibbonGroup>
                    }
                    <DxRibbonGroup Text='@LT("Convert")' IconCssClass="pub-icon pub-icon-media">
                        <DxRibbonItem Text='@LT("Send selection to converter")' Enabled="@HasSelectedSegment" Click="SendSelectedMediaToConverter" />
                    </DxRibbonGroup>
                </DxRibbonTab>
            </DxRibbon>
            <div class="media-studio-source-state" role="status">@SourceStatus</div>

            <div class="media-studio-body">
                <div class="media-studio-preview-column">
                    <div class="media-studio-preview-shell @(IsVideo ? "video" : "audio") @(_mouseMode == MediaStudioMouseMode.FrameRegion ? "frame-region-mode" : null)"
                         @oncontextmenu="ShowMediaContextMenu" @oncontextmenu:preventDefault>
                        @if (IsVideo)
                        {
                            <div id="media-studio-frame-stage" class="media-studio-frame-stage">
                                <video id="media-studio-preview"
                                       src="@_previewSource"
                                       poster="@_posterDataUrl"
                                       playsinline
                                       preload="metadata"
                                       disablepictureinpicture
                                       controlslist="nofullscreen nodownload noremoteplayback"
                                       class="media-studio-video-surface"
                                       style="@VideoPreviewStyle"></video>
                                <canvas id="media-studio-video-effects" class="media-studio-video-effects" aria-hidden="true"></canvas>
                                <div class="media-video-mode-hud" aria-live="polite">
                                    <b>@MouseModeLabel</b>
                                    <span>@VideoCanvasModeHelp</span>
                                </div>
                                <div id="media-studio-video-time-overlay"
                                     class="media-video-time-overlay @(_videoSelectionIsPoint ? "point-selection" : "range-selection") @(_mouseMode == MediaStudioMouseMode.FrameRegion ? "disabled" : null)"
                                     data-duration="@Inv(_duration)"
                                     data-trim-start="@Inv(_trimStart)"
                                     data-trim-end="@Inv(_trimEnd)"
                                     data-selection-start="@Inv(VideoSelectionStart)"
                                     data-selection-end="@Inv(VideoSelectionEnd)"
                                     data-selection-point="@(_videoSelectionIsPoint ? "true" : "false")"
                                     data-clip-name="@SelectedClipName"
                                     data-sequence-duration="@Inv(SequenceDuration)"
                                     data-segment-timeline-start="@Inv(SelectedSegmentTimelineStart)"
                                     data-segment-source-start="@Inv(SelectedSegmentSourceStart)"
                                     data-playback-rate="@Inv(_playbackRate)"
                                     data-volume="@Inv(_volume)"
                                     data-muted="@(_muted ? "true" : "false")"
                                     data-loop="@(_loop ? "true" : "false")"
                                     data-mouse-mode="@_mouseMode"
                                     style="@VideoTimeOverlayStyle"
                                     role="application"
                                     aria-label='@LT("Video timestamp and range selector")'>
                                    <div class="media-video-time-track" data-video-time-track aria-label='@LT("Selected video timestamp or range")'>
                                        <span class="media-video-time-selected" aria-hidden="true"></span>
                                        <span class="media-video-time-handle start" data-video-time-handle="start" title='@LT("Drag selection start")'></span>
                                        <span class="media-video-time-handle end" data-video-time-handle="end" title='@LT("Drag selection end")'></span>
                                        <span class="media-video-time-point" aria-hidden="true"></span>
                                        <span class="media-video-time-playhead" aria-hidden="true"></span>
                                        <span class="media-video-time-drop-marker" aria-hidden="true"></span>
                                    </div>
                                    @foreach (var cutSection in SelectedCutSections)
                                    {
                                        <button type="button"
                                                class="media-video-cut-section @(cutSection.Id == _selectedCutSectionId ? "selected" : null)"
                                                style="@VideoCutSectionStyle(cutSection)"
                                                title="@($"{cutSection.Name}: {Time(cutSection.StartSeconds)} — {Time(cutSection.EndSeconds)}")"
                                                data-video-time-control
                                                @onclick="() => SelectCutSection(cutSection.Id)"
                                                @onclick:stopPropagation></button>
                                    }
                                    <div class="media-video-time-toolbar media-video-transport-dock" data-video-time-control>
                                        <div class="media-video-transport-buttons">
                                            <button type="button" title='@LT("Play selected range")' data-video-command="play"><i class="pub-icon pub-icon-play" aria-hidden="true"></i></button>
                                            <button type="button" title='@LT("Pause video")' data-video-command="pause"><i class="pub-icon pub-icon-pause" aria-hidden="true"></i></button>
                                        </div>
                                        <label class="media-video-pointer-mode">
                                            <span>@LT("Pointer")</span>
                                            <select value="@_mouseMode" @onchange="ChangeVideoCanvasMouseMode">
                                                <option value="@MediaStudioMouseMode.SelectSection">@LT("Select time")</option>
                                                <option value="@MediaStudioMouseMode.PlacePlayhead">@LT("Place playhead")</option>
                                                <option value="@MediaStudioMouseMode.AddCutLine">@LT("Add cutline")</option>
                                                <option value="@MediaStudioMouseMode.FrameRegion">@LT("Frame region")</option>
                                            </select>
                                        </label>
                                        <span class="media-video-time-readout">
                                            <b id="media-studio-video-selection-label">@VideoSelectionLabel</b>
                                            <span id="media-studio-video-current-time">@Time(VideoSelectionStart)</span>
                                            <span id="media-studio-video-selection-readout">@VideoSelectionReadout</span>
                                        </span>
                                        <span class="media-video-time-help">@SelectedClipName · @VideoCanvasModeHelp</span>
                                    </div>

                                    @if (_pendingInsertSegment is not null)
                                    {
                                        <div class="media-video-insert-placement" data-video-time-control @onpointerdown:stopPropagation @onclick:stopPropagation>
                                            <div>
                                                <b>@LT("Insert dropped video")</b>
                                                <span>@_pendingInsertSegment.Name</span>
                                            </div>
                                            @if (_pendingInsertTimelineSeconds.HasValue)
                                            {
                                                <span class="media-video-insert-fixed">@LT("Timeline drop position is fixed at") @Time(_pendingInsertTimelineSeconds.Value).</span>
                                            }
                                            else if (PendingInsertHasRange)
                                            {
                                                <label>
                                                    @LT("Position inside selection")
                                                    <input type="range"
                                                           min="@Inv(_pendingInsertMinimumSourceSeconds)"
                                                           max="@Inv(_pendingInsertMaximumSourceSeconds)"
                                                           step="0.01"
                                                           value="@Inv(_pendingInsertSourceSeconds)"
                                                           @oninput="ChangePendingInsertPosition" /> </label>
                                            }
                                            else
                                            {
                                                <span class="media-video-insert-fixed">@LT("The selected timestamp is fixed.")</span>
                                            }
                                            <div class="media-video-insert-actions">
                                                <time>@Time(_pendingInsertTimelineSeconds ?? _pendingInsertSourceSeconds)</time>
                                                <button type="button" @onclick="ConfirmPendingInsert">@LT("Insert here")</button>
                                                <button type="button" @onclick="CancelPendingInsert">@LT("Cancel")</button>
                                            </div>
                                        </div>
                                    }
                                    @if (_recordingStartPlacementRequired && IsVideo)
                                    {
                                        <div class="media-video-insert-placement media-recording-placement" data-video-time-control @onpointerdown:stopPropagation @onclick:stopPropagation>
                                            <div>
                                                <b>@LT("Place next recording")</b>
                                                <span>@LT("Choose the sequence boundary before the browser starts recording. The finished recording will keep this position selected for insertion.")</span>
                                            </div>
                                            <label>
                                                @LT("Recording position")
                                                <select value="@_recordingStartPlacementBoundary" @onchange="ChangeRecordingStartPlacementBoundary">
                                                    @for (var boundary = 0; boundary <= _segments.Count; boundary++)
                                                    {
                                                        <option value="@boundary">@RecordingPlacementLabel(boundary)</option>
                                                    }
                                                </select>
                                            </label>
                                            <div class="media-video-insert-actions">
                                                <button type="button" @onclick="ConfirmRecordingStartPlacement">@LT("Start recording here")</button>
                                                <button type="button" @onclick="CancelRecordingStartPlacement">@LT("Cancel")</button>
                                            </div>
                                        </div>
                                    }
                                    @if (_recordingPlacementRequired && HasRetainedRecording)
                                    {
                                        <div class="media-video-insert-placement media-recording-placement" data-video-time-control @onpointerdown:stopPropagation @onclick:stopPropagation>
                                            <div>
                                                <b>@LT("Place new recording")</b>
                                                <span>@LT("Choose where the completed recording belongs in the existing video sequence.")</span>
                                            </div>
                                            <label>
                                                @LT("Recording position")
                                                <select value="@_recordingPlacementBoundary" @onchange="ChangeRecordingPlacementBoundary">
                                                    @for (var boundary = 0; boundary <= _segments.Count; boundary++)
                                                    {
                                                        <option value="@boundary">@RecordingPlacementLabel(boundary)</option>
                                                    }
                                                </select>
                                            </label>
                                            <div class="media-video-insert-actions">
                                                <button type="button" disabled="@_embedding" @onclick="ConfirmRecordingPlacement">@LT("Insert recording")</button>
                                                <button type="button" disabled="@_embedding" @onclick="CancelRecordingPlacement">@LT("Keep uninserted")</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div id="media-studio-frame-overlay-host"
                                     class="media-studio-frame-overlay-host @(_mouseMode == MediaStudioMouseMode.FrameRegion ? "active" : null)"
                                     role="application"
                                     aria-label='@LT("Video frame region selection")'
                                     @onpointerdown="FrameOverlayPointerDown"
                                     @onpointerdown:preventDefault
                                     @onpointerdown:stopPropagation
                                     @ondblclick="FinishFrameRegion"
                                     @ondblclick:preventDefault
                                     @ondblclick:stopPropagation
                                     @oncontextmenu="ShowMediaContextMenu"
                                     @oncontextmenu:preventDefault
                                     @oncontextmenu:stopPropagation>
                                    <svg class="media-studio-frame-overlay" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
                                        <path class="media-frame-dim" d="@FrameDimPath" fill-rule="evenodd" />
                                        @if (ActiveFramePoints.Count >= 2)
                                        {
                                            <polyline class="media-frame-cutline" points="@FramePolylinePoints" />
                                        }
                                        @if (ActiveFramePoints.Count >= 3)
                                        {
                                            <polygon class="media-frame-selection" points="@FramePolygonPoints" />
                                        }
                                        @for (var pointIndex = 0; pointIndex < ActiveFramePoints.Count; pointIndex++)
                                        {
                                            var point = ActiveFramePoints[pointIndex];
                                            <circle class="media-frame-node @(pointIndex == _selectedFramePointIndex ? "selected" : null)" data-frame-node-index="@pointIndex" cx="@Inv(point.X * 1000)" cy="@Inv(point.Y * 1000)" r="9" />
                                        }
                                    </svg>
                                    <span class="media-frame-cursor-ring" aria-hidden="true"></span>
                                    <div class="media-frame-mode-help">
                                        <b>@(_editingMorphRegion ? LT("Morph target mode") : LT("Frame region mode"))</b>
                                        <span>@LT("Click selects or adds a point · drag moves it · Delete removes the selected point")</span>
                                    </div>
                                    <div class="media-frame-overlay-actions" @onpointerdown:stopPropagation>
                                        <button type="button" disabled="@(!CanFinishFrameRegion)" @onclick="FinishFrameRegion">@LT("Apply region")</button>
                                        <button type="button" disabled="@(SelectedFramePoint is null)" @onclick="RemoveSelectedFramePoint">@LT("Delete point")</button>
                                        <button type="button" disabled="@(!_frameRegionEditing || _frameDraft.Count == 0)" @onclick="RemoveLastFramePoint">@LT("Undo point")</button>
                                        <button type="button" @onclick="CancelFrameRegion">@LT("Exit mode")</button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="media-studio-audio-card">
                                <div class="media-studio-waveform" aria-label='@LT("Audio waveform")'>
                                    @foreach (var sample in DisplayWaveform)
                                    {
                                        <i style="height:@WaveHeight(sample)"></i>
                                    }
                                </div>
                                <audio id="media-studio-preview" src="@_previewSource" controls preload="metadata"></audio>
                            </div>
                        }
                    </div>

                    <div class="media-transport-status" role="status">
                        <strong id="media-studio-selection-title">@VideoOrAudioSelectionTitle</strong>
                        <span id="media-studio-selection-summary">@VideoOrAudioSelectionSummary</span>
                    </div>

                    @if (HasSource)
                    {
                        <div class="media-sequence-editor">
                            <div class="media-range-caption"><b>@LT("Sequence")</b><span>@Time(SequenceDuration) · @_segments.Count @(_segments.Count == 1 ? LT("section") : LT("sections"))</span></div>
                            <div id="media-studio-sequence-timeline" class="media-sequence-timeline mode-@_mouseMode.ToString().ToLowerInvariant()" tabindex="0"
                                 data-sequence-duration="@Inv(SequenceDuration)"
                                 data-segment-timeline-start="@Inv(SelectedSegmentTimelineStart)"
                                 data-segment-source-start="@Inv(SelectedSegmentSourceStart)"
                                 data-segment-source-end="@Inv(SelectedSegmentSourceEnd)"
                                 data-segment-effective-rate="@Inv(SelectedSegmentEffectiveRate)"
                                 data-selected-segment-id="@(_selectedSegmentId?.ToString() ?? string.Empty)"
                                 @onpointerdown="TimelinePointerDown"
                                 @oncontextmenu="ShowTimelineContextMenu" @oncontextmenu:preventDefault>
                                @foreach (var segment in _segments)
                                {
                                    <button type="button" class="media-sequence-segment @(_selectedSegmentIds.Contains(segment.Id) ? "selected" : null) @(segment.Id == _selectedSegmentId ? "primary-selected" : null) @(segment.IsGap ? "gap" : string.IsNullOrWhiteSpace(segment.DataUrl) ? "offline" : null)"
                                            style="@SegmentStyle(segment)" title="@SegmentTitle(segment)"
                                            data-media-segment-id="@segment.Id"
                                            data-media-segment-name="@segment.Name"
                                            data-media-segment-mime="@segment.MimeType"
                                            draggable="@(!segment.IsGap)"
                                            @onpointerdown:stopPropagation
                                            @onclick="(MouseEventArgs args) => SelectTimelineSegment(segment.Id, args)">
                                        <span>@segment.Name</span>
                                    </button>
                                }
                                @foreach (var boundary in CutBoundaryPositions)
                                {
                                    <i class="media-cutline" style="left:@Percent(boundary / Math.Max(.01, SequenceDuration))"></i>
                                }
                                @if (IsVideo && HasSelectedSegment)
                                {
                                    <i id="media-studio-sequence-selection"
                                       class="media-sequence-selection @(_videoSelectionIsPoint ? "point" : "range")"
                                       style="@VideoSequenceSelectionStyle"
                                       title="@VideoSequenceSelectionTitle"></i>
                                    <button id="media-studio-sequence-selection-start" type="button"
                                            class="media-sequence-selection-boundary start"
                                            data-sequence-selection-handle="start"
                                            style="@VideoSequenceSelectionStartStyle"
                                            title='@LT("Drag selection start")' aria-label='@LT("Drag video selection start")'
                                            hidden="@_videoSelectionIsPoint"></button>
                                    <button id="media-studio-sequence-selection-end" type="button"
                                            class="media-sequence-selection-boundary end"
                                            data-sequence-selection-handle="end"
                                            style="@VideoSequenceSelectionEndStyle"
                                            title='@LT("Drag selection end")' aria-label='@LT("Drag video selection end")'
                                            hidden="@_videoSelectionIsPoint"></button>
                                }
                                <i id="media-studio-sequence-playhead" class="media-playhead" style="left:@Percent(_playhead / Math.Max(.01, SequenceDuration))"></i>
                            </div>
                            <div class="media-sequence-status">
                                <span><b>@LT("Mode:")</b> @MouseModeLabel</span>
                                <span><b>@LT("Playhead:")</b> @Time(_playhead)</span>
                                <span><b>@LT("Selected:")</b> @SelectedSectionSummary</span>
                            </div>
                        </div>

                        @if (!IsVideo)
                        {
                            <div class="media-range-selector" @oncontextmenu="ShowMediaContextMenu" @oncontextmenu:preventDefault>
                                <div class="media-range-caption"><b>@LT("Trim range")</b><span>@Time(_trimEnd - _trimStart) @LT("selected")</span></div>
                                <DxRangeSelector Height="96px"
                                                 SelectedRangeStartValue="@_trimStart"
                                                 SelectedRangeEndValue="@_trimEnd"
                                                 ValueChanged="TrimRangeChanged"
                                                 ValueChangeMode="RangeSelectorValueChangeMode.OnHandleRelease"
                                                 AllowMouseSelection="true"
                                                 MoveSelectedRangeByClick="true">
                                    <DxRangeSelectorScale StartValue="@(0d)"
                                                          EndValue="@RangeSelectorEnd"
                                                          ValueType="ChartAxisDataType.Numeric"
                                                          TickInterval="@MajorTick"
                                                          MinorTickInterval="@MinorTick"
                                                          MinRange="@RangeSelectorMinRange">
                                        <DxRangeSelectorScaleMarker Visible="false" />
                                    </DxRangeSelectorScale>
                                    <DxRangeSelectorSliderMarker Visible="true" />
                                </DxRangeSelector>
                            </div>
                        }
                    }
                </div>

                <aside class="media-studio-properties">
                    <DxFormLayout CssClass="razor-section-layout-owner">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext003">
        <div>
                        <h3>@LT("Clip")</h3>
                        <label>@LT("Name")<input value="@_name" @onchange="ChangeName" /></label>
                        <div class="property-grid two">
                            <label>@LT("Trim start")<input type="number" min="0" max="@Inv(_duration)" step="0.01" value="@Inv(_trimStart)" @onchange="ChangeTrimStart" /></label>
                            <label>@LT("Trim end")<input type="number" min="0" max="@Inv(_duration)" step="0.01" value="@Inv(_trimEnd)" @onchange="ChangeTrimEnd" /></label>
                        </div>
                        <label>@LT("Playback rate") <b>@_playbackRate.ToString("0.##", CultureInfo.InvariantCulture)×</b>
                            <input type="range" min="0.25" max="2" step="0.05" value="@Inv(_playbackRate)" @oninput="ChangePlaybackRate" /> </label>
                        <label>@LT("Volume") <b>@Math.Round(_volume * 100)%</b>
                            <input type="range" min="0" max="1" step="0.01" value="@Inv(_volume)" @oninput="ChangeVolume" /> </label>
                        <label class="check-row"><input type="checkbox" checked="@_muted" @onchange="ToggleMuted" /> @LT("Muted")</label>
                        <label class="check-row"><input type="checkbox" checked="@_loop" @onchange="ToggleLoop" /> @LT("Loop selected range")</label>
                    </div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>

                    @if (IsVideo)
                    {
                        @if (HasVideoProject)
                        {
                            <DxFormLayout CssClass="razor-section-layout-owner">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext004">
        <div class="media-video-project-properties">
                                <h3>@LT("Imported video project")</h3>
                                <p class="property-note"><b>@VideoProjectTitle</b> · @VideoProjectFormatSummary</p>
                                <div class="media-video-project-summary">
                                    <span>@VideoProjectCanvasSummary</span>
                                    <span>@VideoProjectTrackSummary</span>
                                    <span>@VideoProjectMissingSummary</span>
                                </div>
                                <label>@LT("Editable video track")
                                    <select value="@_activeProjectTrackId" @onchange="ChangeProjectTrack">
                                        @foreach (var track in ProjectVideoTracks)
                                        {
                                            <option value="@track.Id">@track.Name (@track.Segments.Count clips)</option>
                                        }
                                    </select>
                                </label>
                                <div class="property-action-row">
                                    <DxButton Text='@LT("Import another project")' Click="OpenVideoProjectPicker" />
                                    <DxButton Text='@LT("Relink media")' Enabled="@(VideoProjectMissingMediaCount > 0)" Click="OpenVideoProjectMediaPicker" />
                                </div>
                                @if (_videoProjectIssues.Count > 0)
                                {
                                    <details class="media-video-project-report">
                                        <summary>@LT("Compatibility report") · @_videoProjectIssues.Count @(_videoProjectIssues.Count == 1 ? LT("item") : LT("items"))</summary>
                                        @foreach (var issue in _videoProjectIssues.Take(12))
                                        {
                                            <p class="issue-@issue.Severity.ToString().ToLowerInvariant()"><b>@issue.Code</b> · @issue.Message</p>
                                        }
                                    </details>
