                _trimStart = 0;
                _trimEnd = _duration;
                _posterDataUrl = info.PosterDataUrl ?? string.Empty;
                _waveform = info.WaveformSamples ?? [];
                _fadeIn = _fadeOut = 0;
                _error = null;
                ReplaceOrAddCurrentSegment();
            }
            catch (Exception ex)
