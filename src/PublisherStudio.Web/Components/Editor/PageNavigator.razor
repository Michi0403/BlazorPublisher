@namespace PublisherStudio.Components.Editor
@inject IFileLocalizationService Localization

@inject ILogger<PageNavigator> Logger
<aside class="page-navigator">
    <div class="pane-heading" @oncontextmenu="ShowNavigatorMenu" @oncontextmenu:preventDefault>
        <strong>@LT("Pages")</strong>
        <span>@State.Document.Pages.Count</span>
    </div>
    <div class="page-thumbnail-list" @oncontextmenu="ShowNavigatorMenu" @oncontextmenu:preventDefault>
        @for (var index = 0; index < State.Document.Pages.Count; index++)
        {
            var publicationPage = State.Document.Pages[index];
            <button class="page-thumbnail @(publicationPage.Id == State.SelectedPageId ? "selected" : null)"
                    @onclick="() => State.SelectPage(publicationPage.Id)"
                    @oncontextmenu="args => ShowPageMenu(publicationPage, args)"
                    @oncontextmenu:preventDefault
                    @oncontextmenu:stopPropagation>
                <span class="page-number">@(index + 1)</span>
                <span class="mini-page" style="@MiniPageStyle(publicationPage)">
                    @foreach (var connector in publicationPage.Elements.OfType<ConnectorElement>().Where(e => e.Visible).OrderBy(e => e.ZIndex))
                    {
                        if (ConnectorGeometryService.TryResolve(publicationPage, connector, out var sourcePoint, out var targetPoint))
                        {
                            <svg class="mini-connectors" viewBox="0 0 @Inv(publicationPage.WidthMm) @Inv(publicationPage.HeightMm)" preserveAspectRatio="none">
                                <path d="@ConnectorGeometryService.Path(connector, sourcePoint, targetPoint)" fill="none" stroke="@connector.Stroke" stroke-width="@Inv(Math.Max(.8, connector.StrokeWidthMm * 2))"></path>
                            </svg>
                        }
                    }
                    @foreach (var item in publicationPage.Elements.Where(e => e.Visible && e is not ConnectorElement).OrderBy(e => e.ZIndex))
                    {
                        <span class="mini-element mini-@item.Kind.ToString().ToLowerInvariant()" style="@MiniElementStyle(item, publicationPage)"></span>
                    }
                </span>
                <span class="page-name">@publicationPage.Name</span>
            </button>
        }
    </div>
    <div class="pane-actions">
        <DxButton Text='@LT("Add")' Click="@(() => State.AddPage())" />
        <DxButton Text='@LT("Copy")' Enabled="State.Document.Pages.Count > 0" Click="@(() => State.DuplicatePage())" />
        <DxButton Text='@LT("Delete")' Enabled="State.Document.Pages.Count > 1" Click="@(() => State.DeletePage())" />
    </div>
</aside>

<DxContextMenu @ref="_pageContextMenu">
    <Items>
        @if (ContextPage is not null)
        {
            <DxContextMenuItem Text='@LT("Select page")' Click="SelectContextPage" />
            <DxContextMenuItem Text='@LT("Duplicate page")' Click="DuplicateContextPage" />
            <DxContextMenuItem Text='@LT("Add new page")' Click="AddPage" />
            <DxContextMenuItem Text='@LT("Delete page")' Enabled="@(State.Document.Pages.Count > 1)" Click="DeleteContextPage" />
            <DxContextMenuItem Text='@LT("Page transition")' BeginGroup="true">
                <Items>
                    <DxContextMenuItem Text="@TransitionText(PublicationPageTransitionKind.None)" Click="TransitionNone" />
                    <DxContextMenuItem Text="@TransitionText(PublicationPageTransitionKind.Fade)" Click="TransitionFade" />
                    <DxContextMenuItem Text="@TransitionText(PublicationPageTransitionKind.Push)" Click="TransitionPush" />
                    <DxContextMenuItem Text="@TransitionText(PublicationPageTransitionKind.Wipe)" Click="TransitionWipe" />
                    <DxContextMenuItem Text="@TransitionText(PublicationPageTransitionKind.Zoom)" Click="TransitionZoom" />
                    <DxContextMenuItem Text="@TransitionText(PublicationPageTransitionKind.Flip)" Click="TransitionFlip" />
                </Items>
            </DxContextMenuItem>
            <DxContextMenuItem Text='@LT("Timeline")'>
                <Items>
                    <DxContextMenuItem Text="@TimelineCommandText" Click="ToggleTimeline" />
                    <DxContextMenuItem Text='@LT("Fit duration to page content")' BeginGroup="true" Click="FitTimelineToContent" />
                    <DxContextMenuItem Text='@LT("Set duration to 10 seconds")' Click="SetTenSecondTimeline" />
                </Items>
            </DxContextMenuItem>
        }
        else
        {
            <DxContextMenuItem Text='@LT("Add new page")' Click="AddPage" />
            <DxContextMenuItem Text='@LT("Duplicate selected page")' Enabled="@(State.Document.Pages.Count > 0)" Click="DuplicateSelectedPage" />
            <DxContextMenuItem Text="@TimelineCommandText" BeginGroup="true" Click="ToggleTimeline" />
        }
    </Items>
</DxContextMenu>

@code {
    private string LT(string text) {
        try
        {
            return Localization.GetText(text);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(LT)} failed.");
            throw;
        }
    }

    [Parameter, EditorRequired] public EditorStateService State { get; set; } = default!;
    [Parameter] public bool TimelineVisible { get; set; }
    [Parameter] public EventCallback RequestToggleTimeline { get; set; }

    private string TimelineCommandText => TimelineVisible ? $"✓ {LT("Timeline pane")}" : LT("Timeline pane");

    private DxContextMenu _pageContextMenu = default!;
    private Guid? _contextPageId;
    private PublicationPage? ContextPage => _contextPageId is { } id ? State.Document.Pages.FirstOrDefault(page => page.Id == id) : null;

    private async Task ShowPageMenu(PublicationPage publicationPage, MouseEventArgs args)
    {
        try
        {
            _contextPageId = publicationPage.Id;
            State.SelectPage(publicationPage.Id);
            await InvokeAsync(StateHasChanged).ConfigureAwait(true);
            await _pageContextMenu.ShowAsync(args).ConfigureAwait(true);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(ShowPageMenu)} failed.");
            throw;
        }
    }

    private async Task ShowNavigatorMenu(MouseEventArgs args)
    {
        try
        {
            _contextPageId = null;
            await InvokeAsync(StateHasChanged).ConfigureAwait(true);
            await _pageContextMenu.ShowAsync(args).ConfigureAwait(true);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(ShowNavigatorMenu)} failed.");
            throw;
        }
    }

    private void SelectContextPage()
    {
        try
        {
            if (_contextPageId is { } id) State.SelectPage(id);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(SelectContextPage)} failed.");
            throw;
        }
    }

    private void DuplicateContextPage()
    {
        try
        {
            SelectContextPage();
            State.DuplicatePage();
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(DuplicateContextPage)} failed.");
            throw;
        }
    }

    private void DeleteContextPage()
    {
        try
        {
            SelectContextPage();
            State.DeletePage();
            _contextPageId = State.SelectedPageId;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(DeleteContextPage)} failed.");
            throw;
        }
    }

    private void AddPage() {
        try
        {
            State.AddPage();
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(AddPage)} failed.");
            throw;
        }
    }
    private Task ToggleTimeline() {
        try
        {
            return RequestToggleTimeline.InvokeAsync();
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(ToggleTimeline)} failed.");
            throw;
        }
    }
    private void DuplicateSelectedPage() {
        try
        {
            State.DuplicatePage();
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(DuplicateSelectedPage)} failed.");
            throw;
        }
    }

    private void SetTransition(PublicationPageTransitionKind kind)
    {
        try
        {
            SelectContextPage();
            State.UpdatePageTransition(transition => transition.Kind = kind);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(SetTransition)} failed.");
            throw;
        }
    }

    private void TransitionNone() {
        try
        {
            SetTransition(PublicationPageTransitionKind.None);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(TransitionNone)} failed.");
            throw;
        }
    }
    private void TransitionFade() {
        try
        {
            SetTransition(PublicationPageTransitionKind.Fade);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(TransitionFade)} failed.");
            throw;
        }
    }
    private void TransitionPush() {
        try
        {
            SetTransition(PublicationPageTransitionKind.Push);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(TransitionPush)} failed.");
            throw;
        }
    }
    private void TransitionWipe() {
        try
        {
            SetTransition(PublicationPageTransitionKind.Wipe);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(TransitionWipe)} failed.");
            throw;
        }
    }
    private void TransitionZoom() {
        try
        {
            SetTransition(PublicationPageTransitionKind.Zoom);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(TransitionZoom)} failed.");
            throw;
        }
    }
    private void TransitionFlip() {
        try
        {
            SetTransition(PublicationPageTransitionKind.Flip);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(TransitionFlip)} failed.");
            throw;
        }
    }

    private void FitTimelineToContent()
    {
        try
        {
            SelectContextPage();
            State.SetPageTimelineDuration(Math.Max(1, TimelineContentEnd + .5));
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(FitTimelineToContent)} failed.");
            throw;
        }
    }

    private void SetTenSecondTimeline()
    {
        try
        {
            SelectContextPage();
            State.SetPageTimelineDuration(10);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(SetTenSecondTimeline)} failed.");
            throw;
        }
    }

    private double TimelineContentEnd => Math.Max(
        State.CurrentPage.Elements.SelectMany(item => item.Animations)
            .Select(item => State.EffectiveAnimationStart(item) + Math.Max(.05, item.DurationSeconds) * Math.Max(1, item.RepeatCount) * (item.AutoReverse ? 2 : 1))
            .DefaultIfEmpty(0).Max(),
        State.CurrentPage.Elements.OfType<PublicationMediaElement>()
            .Select(item => item.TimelineStartSeconds + item.TimelineLengthSeconds)
            .DefaultIfEmpty(0).Max());

    private string TransitionText(PublicationPageTransitionKind kind) {
        try
        {
            return State.CurrentPage.Transition.Kind == kind ? $"✓ {TransitionName(kind)}" : TransitionName(kind);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(TransitionText)} failed.");
            throw;
        }
    }

    private string TransitionName(PublicationPageTransitionKind kind) {
        try
        {
            return LT(kind switch
    {
        PublicationPageTransitionKind.None => "None",
        PublicationPageTransitionKind.Fade => "Fade",
        PublicationPageTransitionKind.Push => "Push",
        PublicationPageTransitionKind.Wipe => "Wipe",
        PublicationPageTransitionKind.Zoom => "Zoom",
        PublicationPageTransitionKind.Flip => "Flip",
        _ => kind.ToString()
    });
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(TransitionName)} failed.");
            throw;
        }
    }

    private string MiniPageStyle(PublicationPage page) {
        try
        {
            return $"aspect-ratio:{page.WidthMm.ToString(CultureInfo.InvariantCulture)}/{page.HeightMm.ToString(CultureInfo.InvariantCulture)};background:{page.Background}";
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(MiniPageStyle)} failed.");
            throw;
        }
    }
    private string MiniElementStyle(PublicationElement element, PublicationPage page) {
        try
        {
            return $"left:{Inv(element.X / page.WidthMm * 100)}%;top:{Inv(element.Y / page.HeightMm * 100)}%;width:{Inv(element.Width / page.WidthMm * 100)}%;height:{Inv(element.Height / page.HeightMm * 100)}%;transform:rotate({Inv(element.Rotation)}deg)";
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(MiniElementStyle)} failed.");
            throw;
        }
    }
    private string Inv(double value) {
        try
        {
            return value.ToString("0.##", CultureInfo.InvariantCulture);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageNavigator)}.{nameof(Inv)} failed.");
            throw;
        }
    }
}
