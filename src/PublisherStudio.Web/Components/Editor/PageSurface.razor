    /// Opens element context menu for <see cref="PageSurface"/>, keeping the operation consistent with the state and invariants of the surrounding page surface workflow.
    /// </summary>
    /// <param name="id">Identifier of the resource to use for this operation.</param>
    /// <param name="clientX">Client x value supplied to the page surface operation and used when producing its result.</param>
