    /// </summary>
    /// <param name="element">Element value supplied to the page surface operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task DoubleClick(PublicationElement element)
    {
        try
        {
            if (element is TextFrameElement) return EditTextRequested.InvokeAsync(element.Id);
            if (element is ImageFrameElement) State.ToggleCropMode();
            if (element is DataVisualElement) return RequestEditDataVisual.InvokeAsync();
            if (element is DevExtremeComponentElement) return RequestEditComponent.InvokeAsync();
            if (element is SpreadsheetElement) return RequestEditSpreadsheet.InvokeAsync();
            if (element is PublicationMediaElement) return RequestEditMedia.InvokeAsync();
            if (element is BarcodeElement) return RequestEditBarcode.InvokeAsync();
            if (element is PanelElement or HtmlEmbedElement) return RequestEditPanel.InvokeAsync();
            if (element is LiveSourceElement liveSource) return ActivateLiveSource(liveSource);
            return Task.CompletedTask;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageSurface)}.{nameof(DoubleClick)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs show element context menu for <see cref="PageSurface"/>, keeping the operation consistent with the state and invariants of the surrounding page surface workflow.
    /// </summary>
    /// <param name="element">Element value supplied to the page surface operation and used when producing its result.</param>
    /// <param name="args">Args value supplied to the page surface operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ShowElementContextMenu(PublicationElement element, MouseEventArgs args)
    {
        try
        {
            if (!InteractionEnabled) return;
            State.SetPrimarySelection(element.Id);
            if (element is not ConnectorElement)
            {
                try
                {
                    _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/publisherInterop.js").ConfigureAwait(true);
                    var point = await _module.InvokeAsync<double[]>("elementRelativePoint", "publisher-page", element.Id.ToString("D"), args.ClientX, args.ClientY).ConfigureAwait(true);
                    if (point.Length >= 2)
                    {
                        _contextPortX = Math.Clamp(point[0], 0, 1);
                        _contextPortY = Math.Clamp(point[1], 0, 1);
                    }
                }
                catch { _contextPortX = _contextPortY = .5; }
            }
            await InvokeAsync(StateHasChanged).ConfigureAwait(true);
            await _contextMenu.ShowAsync(args).ConfigureAwait(true);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageSurface)}.{nameof(ShowElementContextMenu)} failed.");
            throw;
        }
    }

