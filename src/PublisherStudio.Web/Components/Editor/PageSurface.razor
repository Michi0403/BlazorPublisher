            Notifications.Warning(safeMessage, safeOperation, nameof(PageSurface));
            return Task.CompletedTask;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageSurface)}.{nameof(ReportCanvasInteractionError)} failed.");
            throw;
        }
    }

