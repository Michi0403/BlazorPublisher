    /// <param name="pageX">Page x value supplied to the page surface operation and used when producing its result.</param>
    /// <param name="pageY">Page y value supplied to the page surface operation and used when producing its result.</param>
    /// <param name="screenX">Screen x value supplied to the page surface operation and used when producing its result.</param>
    /// <param name="screenY">Screen y value supplied to the page surface operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    [JSInvokable]
    public async Task OpenElementContextMenu(string id, double clientX, double clientY, double pageX, double pageY, double screenX, double screenY)
    {
        try
        {
            if (!Guid.TryParse(id, out var guid)) return;
            var element = State.CurrentPage.Elements.FirstOrDefault(item => item.Id == guid);
            if (element is null) return;
            // DevExpress positions a context menu from PageX/PageY. Supplying only
            // ClientX/ClientY caused the menu to jump to stale or zero page coordinates.
            var args = new MouseEventArgs
            {
                Type = "contextmenu",
                Button = 2,
                Buttons = 2,
                ClientX = clientX,
                ClientY = clientY,
                PageX = pageX,
                PageY = pageY,
                ScreenX = screenX,
                ScreenY = screenY
            };
            await ShowElementContextMenu(element, args).ConfigureAwait(true);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageSurface)}.{nameof(OpenElementContextMenu)} failed.");
            throw;
        }
    }
