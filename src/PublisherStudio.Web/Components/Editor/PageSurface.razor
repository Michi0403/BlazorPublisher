    private async Task ShowElementContextMenu(PublicationElement element, MouseEventArgs args)
    {
        try
        {
            if (!InteractionEnabled) return;
            State.SetPrimarySelection(element.Id);
            if (element is not ConnectorElement)
            {
                try
                {
                    _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/publisherInterop.js").ConfigureAwait(true);
                    var point = await _module.InvokeAsync<double[]>("elementRelativePoint", "publisher-page", element.Id.ToString("D"), args.ClientX, args.ClientY).ConfigureAwait(true);
                    if (point.Length >= 2)
                    {
                        _contextPortX = Math.Clamp(point[0], 0, 1);
                        _contextPortY = Math.Clamp(point[1], 0, 1);
                    }
                }
                catch { _contextPortX = _contextPortY = .5; }
            }
            await InvokeAsync(StateHasChanged).ConfigureAwait(true);
            await _contextMenu.ShowAsync(args).ConfigureAwait(true);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageSurface)}.{nameof(ShowElementContextMenu)} failed.");
            throw;
        }
    }

