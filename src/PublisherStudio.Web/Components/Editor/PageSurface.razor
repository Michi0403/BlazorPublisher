    {
        get
        {
            var grid = Math.Max(.5, State.Document.View.GridSpacingMm) * PixelsPerMm;
            var gridStyle = State.Document.View.GridVisible
                ? $"background-image:linear-gradient(#0000 calc(100% - 1px),#00000010 calc(100% - 1px)),linear-gradient(90deg,#0000 calc(100% - 1px),#00000010 calc(100% - 1px));background-size:{Px(grid)} {Px(grid)};"
                : "background-image:none;";
            return $"width:{Px(State.CurrentPage.WidthMm * PixelsPerMm)};height:{Px(State.CurrentPage.HeightMm * PixelsPerMm)};background-color:{State.CurrentPage.Background};{gridStyle}";
        }
    }

    /// <summary>
    /// Handles the after render async lifecycle or event notification for <see cref="PageSurface"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="firstRender">Value indicating whether first render should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (_disposed || _canvasInitializationInProgress) return;

            _canvasInitializationInProgress = true;
            try
            {
                var selectedElementIds = EditorText.BuildCanvasSelectedElementIds(SelectionVisualsEnabled, State.SelectedElementIds);
                var selectionKey = EditorText.BuildCanvasSelectionKey(SelectionVisualsEnabled, InteractionEnabled, selectedElementIds);
                var clipboardKey = $"{State.CanPaste}:{State.ClipboardRevision}";
                var initializationKey = $"{State.CurrentPage.Id:N}|" +
                    $"{State.Document.Zoom.ToString("R", CultureInfo.InvariantCulture)}|{State.Document.View.CanvasZoomMode}|{State.CropMode}|{State.ContentPanMode}|{State.Document.View.RulerUnit}|" +
                    $"{State.Document.View.RulersVisible}|{State.Document.View.GuidesVisible}|{State.Document.View.SnapToGrid}|" +
                    $"{State.Document.View.SnapToGuides}|{State.Document.View.SnapToPage}|{State.Document.View.SnapToObjects}|{State.Document.View.SnapInObjects}|" +
                    $"{State.Document.View.GridSpacingMm.ToString("R", CultureInfo.InvariantCulture)}|{State.ConnectorTool}|{selectionKey}|{clipboardKey}";
                var dataVisualLayoutKey = $"{State.CurrentPage.Id:N}|{State.Revision}|{State.Document.Zoom.ToString("R", CultureInfo.InvariantCulture)}|{State.Document.View.CanvasZoomMode}";

                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/publisherInterop.js").ConfigureAwait(true);
                if (initializationKey != _canvasInitializationKey)
                {
                    _self ??= DotNetObjectReference.Create(this);
                    var initialized = await _module.InvokeAsync<bool>("initializeCanvas",
                        "publisher-stage", "publisher-scroll-area", "publisher-page", "publisher-horizontal-ruler", "publisher-vertical-ruler", _self,
                        new
                        {
                            pxPerMm = PixelsPerMm,
                            zoomMode = State.Document.View.CanvasZoomMode.ToString(),
                            cropMode = State.CropMode,
                            contentPanMode = State.ContentPanMode,
                            unit = State.Document.View.RulerUnit.ToString(),
                            rulersVisible = State.Document.View.RulersVisible,
                            guidesVisible = State.Document.View.GuidesVisible,
                            snapToGrid = State.Document.View.SnapToGrid,
                            snapToGuides = State.Document.View.SnapToGuides,
                            snapToPage = State.Document.View.SnapToPage,
                            snapToObjects = State.Document.View.SnapToObjects,
                            snapInObjects = State.Document.View.SnapInObjects,
                            gridSpacingMm = State.Document.View.GridSpacingMm,
                            connectorTool = State.ConnectorTool.ToString(),
                            interactionEnabled = InteractionEnabled,
                            selectedElementIds,
                            internalClipboardAvailable = State.CanPaste,
                            clipboardRevision = State.ClipboardRevision
                        }).ConfigureAwait(true);
                    if (initialized) _canvasInitializationKey = initializationKey;
                }

                if (dataVisualLayoutKey != _dataVisualLayoutKey)
                {
                    _dataVisualLayoutKey = dataVisualLayoutKey;
                    if (State.CurrentPage.Elements.Any(element => element is DataVisualElement))
                        await _module.InvokeVoidAsync("refreshDataVisualLayout", "publisher-page").ConfigureAwait(true);
                    await _module.InvokeVoidAsync("initializeSignalConnectors", "publisher-page", new { autoStart = false, editor = true }).ConfigureAwait(true);
                }
            }
            catch (JSDisconnectedException exception)
            {
                Logger.LogDebug(exception, "Publisher canvas initialization stopped because the InteractiveServer circuit disconnected.");
            }
            catch (TaskCanceledException exception)
            {
                Logger.LogDebug(exception, "Publisher canvas initialization was canceled.");
            }
            catch (ObjectDisposedException exception)
            {
                Logger.LogDebug(exception, "Publisher canvas initialization stopped because an interop resource was disposed.");
            }
            catch (InvalidOperationException exception)
            {
                Logger.LogWarning(exception, "Publisher canvas initialization could not complete because the interactive renderer was not ready.");
            }
            catch (JSException exception)
            {
                Logger.LogError(exception, "Publisher canvas JavaScript initialization failed.");
                Notifications.Warning("Canvas interaction could not initialize completely. Review the local log if the problem continues.", "Canvas warning", nameof(PageSurface));
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Publisher canvas initialization failed unexpectedly.");
                Notifications.Error("Canvas initialization failed. Review the local application log for technical details.", "Canvas error", nameof(PageSurface));
            }
            finally
            {
                _canvasInitializationInProgress = false;
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PageSurface)}.{nameof(OnAfterRenderAsync)} failed.");
            throw;
        }
    }

