    private async Task CancelPanelPointerAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("publisherStudio.cancelPanelStudioPointer", _canvasElement, true).ConfigureAwait(true);
        }
        catch (JSDisconnectedException exception)
        {
            Logger.LogTrace(exception, $"Panel Studio pointer cancellation observed a disconnected circuit. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")}.");
        }
        catch (OperationCanceledException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio pointer cancellation was cancelled while the interaction surface was changing. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} TokenCancellationRequested:{exception.CancellationToken.IsCancellationRequested}.");
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio pointer cancellation observed an unavailable renderer or browser surface. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")}.");
        }
        catch (JSException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio pointer cancellation was unavailable while the interaction surface was changing. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")}.");
        }
    }

