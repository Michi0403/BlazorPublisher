    private void AddTool(string toolId)
    {
        var element = CreateToolElement(toolId);
        if (element is null || _draft is null) return;
        element.X = Math.Max(0, (_draft.CanvasWidth - element.Width) / 2);
        element.Y = Math.Max(0, (_draft.CanvasHeight - element.Height) / 2);
        AddElement(element);
    }

    private PublicationElement? CreateToolElement(string toolId)
    {
        if (toolId.StartsWith("template:", StringComparison.OrdinalIgnoreCase)
            && Guid.TryParse(toolId["template:".Length..], out var templateId))
        {
            var template = Document.ComponentTemplates.FirstOrDefault(item => item.Id == templateId);
            if (template is null) return null;
            _selectedTemplateId = template.Id;
            var clone = Files.CloneElement(template.Prototype);
            clone.Id = Guid.NewGuid();
            return clone;
        }
        return Panels.CreateComponentTool(Document, toolId);
    }

    private void BeginPaletteDrag(PanelComponentToolDescriptor tool)
    {
        _dragToolId = tool.Id;
        _dragExistingId = null;
        _dragPrototype = CreateToolElement(tool.Id);
    }

    private void BeginExistingDrag(Guid id)
    {
        SelectElement(id);
        _dragToolId = string.Empty;
        _dragExistingId = id;
        _dragPrototype = SelectedElement is null ? null : Files.CloneElement(SelectedElement);
    }

    private async Task DropDraggedElement(DragEventArgs args)
    {
        // Snapshot the complete transaction before awaiting JS. HTML dragend can fire while
        // ResolveCanvasPoint is suspended and clear the component fields.
        var draft = _draft;
        var view = CurrentView;
        var prototype = _dragPrototype;
        var existingId = _dragExistingId;
        if (draft is null || view is null || prototype is null)
        {
            EndDrag();
            return;
        }

        try
        {
            var point = await ResolveCanvasPoint(args).ConfigureAwait(true);
            if (_disposed || !ReferenceEquals(_draft, draft) || !draft.Views.Contains(view)) return;

            var canvasWidth = Math.Max(1, draft.CanvasWidth);
            var canvasHeight = Math.Max(1, draft.CanvasHeight);
            var pointX = point.X * canvasWidth;
            var pointY = point.Y * canvasHeight;

            if (existingId is { } id && view.Elements.FirstOrDefault(element => element.Id == id) is { } existing)
            {
                Layout.ApplyBounds(existing, new PublicationCanvasBounds
                {
                    X = pointX - existing.Width / 2,
                    Y = pointY - existing.Height / 2,
                    Width = existing.Width,
                    Height = existing.Height
                }, canvasWidth, canvasHeight);
                SelectElement(existing.Id);
                return;
            }

            var element = Files.CloneElement(prototype);
            element.Id = Guid.NewGuid();
            Layout.ApplyBounds(element, new PublicationCanvasBounds
            {
                X = pointX - element.Width / 2,
                Y = pointY - element.Height / 2,
                Width = element.Width,
                Height = element.Height
            }, canvasWidth, canvasHeight);
            AddElement(view, element);
        }
        catch (JSDisconnectedException exception)
        {
            Logger.LogDebug(exception, "Panel Studio drop ended because the browser circuit disconnected.");
        }
        catch (TaskCanceledException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio drop was cancelled. Binding:{_interactionBindingId} View:{_selectedViewId} DragTool:{_dragToolId} ExistingElement:{_dragExistingId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} TokenCancellationRequested:{exception.CancellationToken.IsCancellationRequested}.");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Panel Studio element drop failed.");
            _error = "The component could not be placed. Existing panel content was kept unchanged.";
            Notifications.Error(_error, "Component placement failed", nameof(PanelStudio), persistent: true);
        }
        finally
        {
            EndDrag();
        }
    }

    [JSInvokable]
    public Task CommitPanelElementBounds(string elementId, double x, double y, double width, double height) =>
        RunPanelInteropAsync("CommitBounds", () =>
        {
            var draft = _draft;
            var view = CurrentView;
            if (_disposed || draft is null || view is null || !Guid.TryParse(elementId, out var id))
                return;
            var element = view.Elements.FirstOrDefault(candidate => candidate.Id == id);
            if (element is null)
                return;
            Layout.ApplyBounds(element, new PublicationCanvasBounds
            {
                X = x * Math.Max(1, draft.CanvasWidth),
                Y = y * Math.Max(1, draft.CanvasHeight),
                Width = width * Math.Max(1, draft.CanvasWidth),
                Height = height * Math.Max(1, draft.CanvasHeight)
            }, draft.CanvasWidth, draft.CanvasHeight);
            _selectedElementId = element.Id;
            RefreshAdvancedJson();
        });

    [JSInvokable]
    public Task SelectPanelElement(string elementId) =>
        RunPanelInteropAsync("SelectElement", () =>
        {
            if (Guid.TryParse(elementId, out var id))
                SelectElement(id);
        });

    [JSInvokable]
    public Task ActivatePanelElement(string elementId)
    {
        if (!Guid.TryParse(elementId, out var id))
            return Task.CompletedTask;
        return RunPanelInteropAsync("ActivateElement", () => ActivateElementInteraction(id));
    }

    [JSInvokable]
    public Task PanelStudioCommand(string command, double amount = 1) =>
        RunPanelInteropAsync("Command", () =>
        {
            if (_disposed || _interactionPreview)
                return;
            switch ((command ?? string.Empty).Trim().ToLowerInvariant())
            {
                case "left": NudgeSelected(-amount, 0); break;
                case "right": NudgeSelected(amount, 0); break;
                case "up": NudgeSelected(0, -amount); break;
                case "down": NudgeSelected(0, amount); break;
                case "delete": DeleteElement(); break;
                case "duplicate": DuplicateElement(); break;
                case "front": BringElementToFront(); break;
                case "forward": MoveElementUp(); break;
                case "backward": MoveElementDown(); break;
                case "back": SendElementToBack(); break;
            }
        });

    private async Task RunPanelInteropAsync(string operation, Action action)
    {
        try
        {
            action();
            await InvokeAsync(StateHasChanged).ConfigureAwait(true);
            Logger.LogDebug("Panel Studio browser operation {Operation} completed.", operation);
        }
        catch (OperationCanceledException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio browser operation {operation} was cancelled. Binding:{_interactionBindingId} View:{_selectedViewId} Selected:{_selectedElementId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} Visible:{Visible} Disposed:{_disposed} TokenCancellationRequested:{exception.CancellationToken.IsCancellationRequested}.");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Panel Studio browser operation {Operation} failed.", operation);
            Notifications.Error("The panel interaction failed. Existing component data was kept unchanged.", "Panel Studio interaction", nameof(PanelStudio));
        }
    }

