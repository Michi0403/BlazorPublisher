@namespace PublisherStudio.Components.Editor
@using System.Text.Json
@using System.Text.Json.Nodes
@using System.Net
@implements IAsyncDisposable
@inject PanelDocumentService Panels
@inject PublicationFileService Files
@inject PublicationComponentService Components
@inject IJSRuntime JS
@inject IPublicationElementLayoutService Layout
@inject IUserNotificationService Notifications
@inject PanelStudioTextService PanelText
@inject ILogger<PanelStudio> Logger

@if (Visible && _draft is not null)
{
    <div class="modal-backdrop data-modal-backdrop panel-studio-backdrop">
        <section class="data-visual-editor-dialog panel-studio-dialog" role="dialog" aria-modal="true" aria-label="Panel Studio">
            <header>
                <div>
                    <strong>Panel / Div Studio</strong>
                    <span>Build reusable live modules from the same components, data connections and web runtimes used by the Mainframe and exports.</span>
                </div>
                <button type="button" class="window-close" @onclick="Cancel">×</button>
            </header>

            <DxRibbon CssClass="data-visual-editor-ribbon categorized-ribbon panel-studio-ribbon" SizeMode="SizeMode.Small" AdaptivityAutoCollapseItemsToGroups="true">
                <DxRibbonTab Text="Home">
                    <DxRibbonGroup Text="Views" IconCssClass="pub-icon pub-icon-page">
                        <DxRibbonItem Text="Add view" IconCssClass="pub-icon pub-icon-page" Click="AddView" />
                        <DxRibbonItem Text="Duplicate view" IconCssClass="pub-icon pub-icon-copy" Click="DuplicateView" Enabled="@(CurrentView is not null)" />
                        <DxRibbonItem Text="Delete view" IconCssClass="pub-icon pub-icon-delete" Click="DeleteView" Enabled="@(_draft.Views.Count > 1)" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Designer" IconCssClass="pub-icon pub-icon-select">
                        <DxRibbonItem Text="@(_interactionPreview ? "✓ Test interactions" : "Arrange components")" IconCssClass="pub-icon pub-icon-select" Click="ToggleInteractionPreview" />
                        <DxRibbonItem Text="Edit content" IconCssClass="pub-icon pub-icon-edit" Click="EditSelectedComponent" Enabled="@(SelectedElement is not null)" />
                        <DxRibbonItem Text="Refresh preview" IconCssClass="pub-icon pub-icon-refresh" Click="RefreshPreview" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Layer" IconCssClass="pub-icon pub-icon-layers">
                        <DxRibbonItem Text="Duplicate" IconCssClass="pub-icon pub-icon-copy" Click="DuplicateElement" Enabled="@(SelectedElement is not null)" />
                        <DxRibbonItem Text="Bring to front" IconCssClass="pub-icon pub-icon-up" Click="BringElementToFront" Enabled="@(SelectedElement is not null)" />
                        <DxRibbonItem Text="Bring forward" IconCssClass="pub-icon pub-icon-up" Click="MoveElementUp" Enabled="@(SelectedElement is not null)" />
                        <DxRibbonItem Text="Send backward" IconCssClass="pub-icon pub-icon-down" Click="MoveElementDown" Enabled="@(SelectedElement is not null)" />
                        <DxRibbonItem Text="Send to back" IconCssClass="pub-icon pub-icon-down" Click="SendElementToBack" Enabled="@(SelectedElement is not null)" />
                        <DxRibbonItem Text="Delete" IconCssClass="pub-icon pub-icon-delete" Click="DeleteElement" Enabled="@(SelectedElement is not null)" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Reusable module" IconCssClass="pub-icon pub-icon-panel">
                        <DxRibbonItem Text="Save/update module" IconCssClass="pub-icon pub-icon-save" Click="SaveSelectedAsTemplate" Enabled="@(SelectedElement is not null)" />
                        <DxRibbonItem Text="Save as new module" IconCssClass="pub-icon pub-icon-copy" Click="SaveSelectedAsNewTemplate" Enabled="@(SelectedElement is not null)" />
                        <DxRibbonItem Text="Delete saved module" IconCssClass="pub-icon pub-icon-delete" Click="DeleteSelectedTemplate" Enabled="@(_selectedTemplateId is not null)" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Open interchange" IconCssClass="pub-icon pub-icon-download">
                        <DxRibbonItem Text="Export JSON Canvas" IconCssClass="pub-icon pub-icon-download" Click="ExportJsonCanvasAsync" Enabled="@(CurrentView is not null)" />
                        <DxRibbonItem Text="Export panel JSON" IconCssClass="pub-icon pub-icon-download" Click="ExportPanelJsonAsync" Enabled="@(_draft is not null)" />
                    </DxRibbonGroup>
                </DxRibbonTab>
                <DxRibbonTab Text="Insert">
                    <DxRibbonGroup Text="Content">
                        <DxRibbonItem Text="Text" IconCssClass="pub-icon pub-icon-text" Click="AddText" />
                        <DxRibbonItem Text="Picture" IconCssClass="pub-icon pub-icon-picture" Click="AddPicture" />
                        <DxRibbonItem Text="Video" IconCssClass="pub-icon pub-icon-video" Click="AddVideo" />
                        <DxRibbonItem Text="Audio" IconCssClass="pub-icon pub-icon-audio" Click="AddAudio" />
                        <DxRibbonItem Text="Shape" IconCssClass="pub-icon pub-icon-shape" Click="AddShape" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Data">
                        <DxRibbonItem Text="KPI" IconCssClass="pub-icon pub-icon-chart" Click="AddKpi" />
                        <DxRibbonItem Text="Chart" IconCssClass="pub-icon pub-icon-chart" Click="AddChart" />
                        <DxRibbonItem Text="Data table" IconCssClass="pub-icon pub-icon-data" Click="AddTable" />
                        <DxRibbonItem Text="Data Grid" IconCssClass="pub-icon pub-icon-data" Click="AddDataGrid" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Interactive">
                        <DxRibbonItem Text="Button" IconCssClass="pub-icon pub-icon-button" Click="AddButton" />
                        <DxRibbonItem Text="Menu" IconCssClass="pub-icon pub-icon-menu" Click="AddMenu" />
                        <DxRibbonItem Text="Chat" IconCssClass="pub-icon pub-icon-chat" Click="AddChat" />
                        <DxRibbonItem Text="Map" IconCssClass="pub-icon pub-icon-map" Click="AddMap" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Live and web">
                        <DxRibbonItem Text="Live camera" IconCssClass="pub-icon pub-icon-video" Click="AddCamera" />
                        <DxRibbonItem Text="Screen capture" IconCssClass="pub-icon pub-icon-screen" Click="AddScreen" />
                        <DxRibbonItem Text="HTML experience" IconCssClass="pub-icon pub-icon-web" Click="AddHtml" />
                        <DxRibbonItem Text="Nested panel" IconCssClass="pub-icon pub-icon-panel" Click="AddNestedPanel" />
                    </DxRibbonGroup>
                </DxRibbonTab>
            </DxRibbon>

            <div class="panel-component-ribbon" aria-label="Draggable panel components">
                @foreach (var category in PaletteTools.GroupBy(tool => tool.Category))
                {
                    <section class="panel-component-ribbon-group">
                        <strong>@category.Key</strong>
                        <div>
                            @foreach (var tool in category)
                            {
                                <button type="button"
                                        class="panel-component-tool @(_selectedTemplateId == tool.TemplateId ? "selected-template" : null) @(_dragToolId == tool.Id ? "dragging" : null)"
                                        draggable="true"
                                        title="@tool.Description"
                                        @ondragstart="() => BeginPaletteDrag(tool)"
                                        @ondragend="EndDrag"
                                        @onclick="() => AddTool(tool.Id)">
                                    <span class="@tool.IconCssClass"></span>
                                    <b>@tool.Name</b>
                                    <small>@tool.Description</small>
                                </button>
                            }
                        </div>
                    </section>
                }
            </div>

            <div class="data-visual-editor-body panel-studio-grid">
                <aside class="visual-type-list panel-studio-sidebar">
                    <strong>Views</strong>
                    @foreach (var view in _draft.Views)
                    {
                        <button type="button" class="@(view.Id == _selectedViewId ? "selected" : null)" @onclick="() => SelectView(view.Id)">
                            <strong>@view.Name</strong>
                            <small>@view.Slug · @(view.Enabled ? "enabled" : "disabled")</small>
                        </button>
                    }
                    <label class="check-row">
                        <input type="checkbox" checked="@(CurrentView?.Enabled == true)" @onchange="ToggleViewEnabled" /> View enabled
                    </label>
                    <label>Navigation
                        <select value="@_draft.NavigationMode" @onchange="ChangeNavigation">
                            @foreach (var mode in Enum.GetValues<PublicationPanelNavigationMode>())
                            {
                                <option value="@mode">@mode</option>
                            }
                        </select>
                    </label>
                    <label>Layout
                        <select value="@_draft.LayoutMode" @onchange="ChangeLayoutMode">
                            @foreach (var mode in Enum.GetValues<PublicationPanelLayoutMode>())
                            {
                                <option value="@mode">@mode</option>
                            }
                        </select>
                    </label>
                    <label>Panel name<input value="@_draft.Name" @onchange="ChangePanelName" /></label>
                    <label>View name<input value="@CurrentView?.Name" @onchange="ChangeViewName" /></label>
                    <label>Canvas width<input type="number" min="16" step="1" value="@Inv(_draft.CanvasWidth)" @onchange="args => ChangeNumber(args, value => _draft.CanvasWidth = value)" /></label>
                    <label>Canvas height<input type="number" min="9" step="1" value="@Inv(_draft.CanvasHeight)" @onchange="args => ChangeNumber(args, value => _draft.CanvasHeight = value)" /></label>
                    <label class="panel-html-import">Import standalone HTML into this view
                        <InputFile accept=".html,.htm,text/html" OnChange="ImportHtml" />
                    </label>
                    <label class="panel-html-import">Import JSON Canvas or PublisherStudio panel JSON
                        <InputFile accept=".canvas,.json,application/json" OnChange="ImportPanelInterchangeAsync" />
                    </label>
                    @if (Document.ComponentTemplates.Count > 0)
                    {
                        <strong>Saved modules</strong>
                        @foreach (var template in Document.ComponentTemplates.OrderBy(template => template.Category).ThenBy(template => template.Name))
                        {
                            <button type="button" class="@(_selectedTemplateId == template.Id ? "selected" : null)" @onclick="() => SelectTemplate(template.Id)">
                                <strong>@template.Name</strong>
                                <small>@template.Category · @template.Prototype.Kind</small>
                            </button>
                        }
                    }
                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="inline-error">@_error</div>
                    }
                </aside>

                <main class="visual-settings panel-studio-workspace">
                    <div class="panel-studio-canvas-shell @(_interactionPreview ? "interaction-preview" : "arrange-preview")">
                        <div class="panel-studio-mode-banner">
                            <div>
                                <b>@(_interactionPreview ? "Interaction mode" : "Arrange mode")</b>
                                <span>@(_interactionPreview ? "Live content receives mouse, touch and keyboard input." : "Move or resize components. Double-click a component to interact with its real content.")</span>
                            </div>
                            <div class="panel-studio-mode-actions" role="group" aria-label="Panel Studio interaction mode">
                                <button type="button" class="@(!_interactionPreview ? "active" : null)" @onclick="DisableInteractionPreview">Arrange</button>
                                <button type="button" class="@(_interactionPreview ? "active" : null)" @onclick="EnableInteractionPreview">Interact</button>
                            </div>
                        </div>
                        <div class="panel-studio-canvas" @ref="_canvasElement" tabindex="0"
                             data-panel-studio-arrange="@((!_interactionPreview).ToString().ToLowerInvariant())"
                             data-panel-studio-binding-id="@_interactionBindingId"
                             aria-label="Panel arrangement canvas"
                             @ondragover:preventDefault
                             @ondrop="DropDraggedElement" @ondrop:preventDefault>
                            <PanelView @key="(_draft.Id, _selectedViewId, _interactionPreview, _previewRevision)" Document="Document" Item="_draft" CurrentPageId="CurrentPageId" DesignerMode="false" DesignPreviewOnly="false" />

                            @if (!_interactionPreview && CurrentView is not null)
                            {
                                <div class="panel-studio-hit-layer" aria-label="Panel component arrangement surface">
                                    @foreach (var element in CurrentView.Elements.Where(element => element.Visible).OrderBy(element => element.ZIndex))
                                    {
                                        <button @key="element.Id" type="button"
                                                class="panel-studio-hitbox @(element.Id == _selectedElementId ? "selected" : null)"
                                                style="@HitStyle(element)"
                                                data-panel-element-id="@element.Id"
                                                data-panel-element-x="@NormalizedX(element)"
                                                data-panel-element-y="@NormalizedY(element)"
                                                data-panel-element-width="@NormalizedWidth(element)"
                                                data-panel-element-height="@NormalizedHeight(element)"
                                                data-panel-element-z="@element.ZIndex"
                                                title="Move @element.Name. Double-click to interact with its live content."
                                                @oncontextmenu="args => ShowElementContextMenu(element.Id, args)"
                                                @oncontextmenu:preventDefault
                                                @oncontextmenu:stopPropagation>
                                            <span>@element.Name</span>
                                            <i data-resize="nw" title="Resize from top left"></i>
                                            <i data-resize="ne" title="Resize from top right"></i>
                                            <i data-resize="se" title="Resize from bottom right"></i>
                                            <i data-resize="sw" title="Resize from bottom left"></i>
                                        </button>
                                    }
                                </div>
                            }

                            @if (_interactionPreview)
                            {
                                <button type="button" class="panel-studio-return-arrange" @onclick="DisableInteractionPreview" title="Return to component arrangement">Return to Arrange</button>
                            }

                            @if (_dragPrototype is not null)
                            {
                                <div class="panel-studio-drop-layer">
                                    <div class="panel-studio-drag-ghost" style="@DragGhostStyle">
                                        <PanelElementPreview Item="_dragPrototype" />
                                        <span>@_dragPrototype.Name</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <p class="field-help">The canvas uses the same DataVisual, DevExtreme, media, live-source, HTML and nested-panel renderers used by Mainframe, presentation, standalone HTML and structured website export.</p>
                </main>

                <aside class="visual-settings panel-studio-inspector">
                    <strong>Components in @CurrentView?.Name</strong>
                    <div class="panel-studio-element-list">
                        @foreach (var element in CurrentView?.Elements.OrderByDescending(element => element.ZIndex) ?? Enumerable.Empty<PublicationElement>())
                        {
                            <button type="button" class="@(element.Id == _selectedElementId ? "selected" : null)" @onclick="() => SelectElement(element.Id)">
                                <strong>@element.Name</strong>
                                <small>@element.Kind · @element.X.ToString("0.#")/@element.Y.ToString("0.#")</small>
                            </button>
                        }
                    </div>

                    @if (SelectedElement is { } selected)
                    {
                        <section class="panel-inspector-section">
                            <strong>Layout and identity</strong>
                            <div class="data-form-grid" style="grid-template-columns:1fr 1fr">
                                <label style="grid-column:1/-1">Name<input value="@selected.Name" @onchange="ChangeElementName" /></label>
                                <label>X<input type="number" step="1" value="@Inv(selected.X)" @onchange="args => ChangeNumber(args, value => selected.X = value)" /></label>
                                <label>Y<input type="number" step="1" value="@Inv(selected.Y)" @onchange="args => ChangeNumber(args, value => selected.Y = value)" /></label>
                                <label>Width<input type="number" min="1" step="1" value="@Inv(selected.Width)" @onchange="args => ChangeNumber(args, value => selected.Width = value)" /></label>
                                <label>Height<input type="number" min="1" step="1" value="@Inv(selected.Height)" @onchange="args => ChangeNumber(args, value => selected.Height = value)" /></label>
                                <label>Rotation<input type="number" step="1" value="@Inv(selected.Rotation)" @onchange="args => ChangeNumber(args, value => selected.Rotation = value)" /></label>
                                <label class="check-row"><input type="checkbox" checked="@selected.Visible" @onchange="args => selected.Visible = AsBool(args)" /> Visible</label>
                            </div>
                        </section>

                        @if (selected is DataVisualElement visual)
                        {
                            <section class="panel-inspector-section">
                                <strong>Data visual</strong>
                                <label>Visual type
                                    <select value="@visual.VisualKind" @onchange="ChangeVisualKind">
                                        @foreach (var kind in Enum.GetValues<DataVisualKind>())
                                        {
                                            <option value="@kind">@kind</option>
                                        }
                                    </select>
                                </label>
                                <label>Title<input value="@visual.Title" @onchange="args => visual.Title = Text(args)" /></label>
                                <label>Data source
                                    <select value="@visual.DataObjectId" @onchange="ChangeVisualDataObject">
                                        @foreach (var dataObject in Document.DataObjects)
                                        {
                                            <option value="@dataObject.Id">@dataObject.Name</option>
                                        }
                                    </select>
                                </label>
                                <label>Argument field<input value="@visual.ArgumentField" @onchange="args => visual.ArgumentField = Text(args)" /></label>
                                <label>Value fields<input value="@string.Join(", ", visual.ValueFields)" @onchange="ChangeVisualValueFields" /></label>
                                <label>Target field<input value="@visual.TargetField" @onchange="args => visual.TargetField = Text(args)" /></label>
                                <label>Rows<input type="number" min="1" max="10000" value="@visual.RowLimit" @onchange="args => ChangeInt(args, value => visual.RowLimit = value)" /></label>
                                <label class="check-row"><input type="checkbox" checked="@visual.ShowLegend" @onchange="args => visual.ShowLegend = AsBool(args)" /> Legend</label>
                                <label class="check-row"><input type="checkbox" checked="@visual.ShowLabels" @onchange="args => visual.ShowLabels = AsBool(args)" /> Labels</label>
                            </section>
                        }

                        @if (selected is DevExtremeComponentElement component)
                        {
                            <section class="panel-inspector-section">
                                <strong>Interactive component</strong>
                                <label>Component
                                    <select value="@component.ComponentKind" @onchange="ChangeComponentKind">
                                        @foreach (var kind in Enum.GetValues<PublicationComponentKind>())
                                        {
                                            <option value="@kind">@kind</option>
                                        }
                                    </select>
                                </label>
                                <label>Title<input value="@component.Title" @onchange="args => component.Title = Text(args)" /></label>
                                <label>Data mode
                                    <select value="@component.Connection.Mode" @onchange="ChangeComponentDataMode">
                                        @foreach (var mode in Enum.GetValues<PublicationComponentDataMode>())
                                        {
                                            <option value="@mode">@mode</option>
                                        }
                                    </select>
                                </label>
                                <label>Publication data
                                    <select value="@component.Connection.DataObjectId" @onchange="ChangeComponentDataObject">
                                        <option value="@Guid.Empty">None</option>
                                        @foreach (var dataObject in Document.DataObjects)
                                        {
                                            <option value="@dataObject.Id">@dataObject.Name</option>
                                        }
                                    </select>
                                </label>
                                <label>REST/OData URL<input value="@component.Connection.Url" @onchange="args => component.Connection.Url = Text(args)" /></label>
                                <label>JSON path<input value="@component.Connection.JsonPath" @onchange="args => component.Connection.JsonPath = Text(args)" /></label>
                                <label>Advanced DevExtreme options<textarea rows="5" value="@component.AdvancedOptionsJson" @onchange="args => component.AdvancedOptionsJson = Text(args)"></textarea></label>
                                <label>Custom CSS<textarea rows="4" value="@component.CustomCss" @onchange="args => component.CustomCss = Text(args)"></textarea></label>
                                @if (component.ComponentKind == PublicationComponentKind.Chat)
                                {
                                    <label>Chat surface
                                        <select value="@component.ChatDisplayMode" @onchange="ChangeChatDisplayMode">
                                            @foreach (var mode in Enum.GetValues<PublicationChatDisplayMode>())
                                            {
                                                <option value="@mode">@mode</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="check-row"><input type="checkbox" checked="@component.ChatAllowSending" @onchange="args => component.ChatAllowSending = AsBool(args)" /> Allow operator sending</label>
                                }
                            </section>
                        }

                        @if (selected is LiveSourceElement live)
                        {
                            <section class="panel-inspector-section">
                                <strong>Live source</strong>
                                <label>Source
                                    <select value="@live.SourceKind" @onchange="ChangeLiveSourceKind">
                                        @foreach (var kind in Enum.GetValues<PublicationLiveSourceKind>())
                                        {
                                            <option value="@kind">@kind</option>
                                        }
                                    </select>
                                </label>
                                <label>Capture width<input type="number" min="1" value="@live.CaptureWidth" @onchange="args => ChangeInt(args, value => live.CaptureWidth = value)" /></label>
                                <label>Capture height<input type="number" min="1" value="@live.CaptureHeight" @onchange="args => ChangeInt(args, value => live.CaptureHeight = value)" /></label>
                                <label>Frame rate<input type="number" min="1" max="240" value="@live.CaptureFrameRate" @onchange="args => ChangeInt(args, value => live.CaptureFrameRate = value)" /></label>
                                <label class="check-row"><input type="checkbox" checked="@live.Muted" @onchange="args => live.Muted = AsBool(args)" /> Muted</label>
                            </section>
                        }

                        @if (selected is ImageFrameElement or PublicationMediaElement)
                        {
                            <section class="panel-inspector-section">
                                <strong>Media source</strong>
                                <InputFile OnChange="ReplaceSelectedMedia" accept="image/*,video/*,audio/*,.mkv,.mov,.avi,.mxf,.heic,.heif,.tif,.tiff,.flac,.wav" />
                                <p class="field-help">PublisherStudio imposes no application file-size ceiling. Very large embedded media remains the user's memory and disk responsibility.</p>
                            </section>
                        }

                        @if (selected is HtmlEmbedElement html)
                        {
                            <section class="panel-inspector-section">
                                <strong>HTML experience</strong>
                                <label>HTML<textarea rows="7" value="@html.Html" @onchange="args => html.Html = Text(args)"></textarea></label>
                                <label>CSS<textarea rows="5" value="@html.Css" @onchange="args => html.Css = Text(args)"></textarea></label>
                                <label>JavaScript<textarea rows="5" value="@html.JavaScript" @onchange="args => html.JavaScript = Text(args)"></textarea></label>
                                <label class="check-row"><input type="checkbox" checked="@html.AllowScripts" @onchange="args => html.AllowScripts = AsBool(args)" /> Enable JavaScript inside sandbox</label>
                                <label class="check-row"><input type="checkbox" checked="@html.AllowForms" @onchange="args => html.AllowForms = AsBool(args)" /> Allow forms</label>
                                <label class="check-row"><input type="checkbox" checked="@html.AllowPopups" @onchange="args => html.AllowPopups = AsBool(args)" /> Allow popups</label>
                                <p class="field-help">Imported scripts stay disabled until explicitly enabled. Each experience remains isolated in its own iframe sandbox.</p>
                            </section>
                        }

                        @if (selected is PanelElement nested)
                        {
                            <section class="panel-inspector-section">
                                <strong>Nested panel</strong>
                                <label>Nested navigation
                                    <select value="@nested.NavigationMode" @onchange="ChangeNestedNavigation">
                                        @foreach (var mode in Enum.GetValues<PublicationPanelNavigationMode>())
                                        {
                                            <option value="@mode">@mode</option>
                                        }
                                    </select>
                                </label>
                            </section>
                        }

                        <details class="panel-inspector-section panel-advanced-json">
                            <summary>Complete component configuration</summary>
                            <p class="field-help">This is the complete persisted module state, including data/web connections, chart settings, fields, actions, filters and advanced options.</p>
                            <textarea rows="12" @bind="_advancedElementJson"></textarea>
                            <div class="panel-inline-actions">
                                <button type="button" @onclick="RefreshAdvancedJson">Refresh JSON</button>
                                <button type="button" class="primary" @onclick="ApplyAdvancedJson">Apply JSON</button>
                            </div>
                        </details>

                        <section class="panel-inspector-section">
                            <strong>Save for reuse</strong>
                            <label>Module name<input @bind="_templateName" /></label>
                            <label>Category<input @bind="_templateCategory" /></label>
                            <label>Description<textarea rows="3" @bind="_templateDescription"></textarea></label>
                            <div class="panel-inline-actions">
                                <button type="button" class="primary" @onclick="SaveSelectedAsTemplate">@(_selectedTemplateId is null ? "Save configured module" : "Update saved module")</button>
                                <button type="button" @onclick="SaveSelectedAsNewTemplate">Save as new</button>
                            </div>
                        </section>
                    }
                </aside>
            </div>
            <footer>
                <button type="button" @onclick="Cancel">Cancel</button>
                <button type="button" class="primary" @onclick="Save">Save panel</button>
            </footer>
        </section>
    </div>

    <PictureEditor Visible="@_pictureEditorVisible"
                   SessionId="@_pictureEditorSessionId"
                   InitialDocument="@PanelPictureDocument"
                   InitialRasterDataUrl="@PanelPictureRaster"
                   InitialName="@PanelPictureName"
                   EditingExisting="true"
                   Saved="SavePanelPicture"
                   Cancelled="ClosePanelPictureEditor" />

    <DxContextMenu @ref="_elementContextMenu">
        <Items>
            <DxContextMenuItem Text="Edit content" IconCssClass="pub-icon pub-icon-edit" Click="EditSelectedComponent" />
            <DxContextMenuItem Text="Duplicate" IconCssClass="pub-icon pub-icon-copy" Click="DuplicateElement" />
            <DxContextMenuItem Text="Delete" IconCssClass="pub-icon pub-icon-delete" Click="DeleteElement" />
            <DxContextMenuItem Text="Arrange" BeginGroup="true">
                <Items>
                    <DxContextMenuItem Text="Bring to front" Click="BringElementToFront" />
                    <DxContextMenuItem Text="Bring forward" Click="MoveElementUp" />
                    <DxContextMenuItem Text="Send backward" Click="MoveElementDown" />
                    <DxContextMenuItem Text="Send to back" Click="SendElementToBack" />
                </Items>
            </DxContextMenuItem>
            <DxContextMenuItem Text="Test interactions" BeginGroup="true" Click="EnableInteractionPreview" />
        </Items>
    </DxContextMenu>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter, EditorRequired] public PublicationDocument Document { get; set; } = default!;
    [Parameter] public Guid CurrentPageId { get; set; }
    [Parameter] public PanelElement? InitialPanel { get; set; }
    [Parameter] public EventCallback<PanelElement> Saved { get; set; }
