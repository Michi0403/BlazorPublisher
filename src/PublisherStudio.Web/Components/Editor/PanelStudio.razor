        {
            var detail = string.IsNullOrWhiteSpace(message) ? "Unknown browser interaction error." : message.Trim();
            if (_disposed || IsExpectedInteractionShutdown(detail))
            {
                Logger.LogDebug($"Panel Studio browser interaction ended normally. Binding:{_interactionBindingId} View:{_selectedViewId} Selected:{_selectedElementId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} Detail:{detail}");
                return Task.CompletedTask;
            }

            Logger.LogWarning("Panel Studio browser interaction failed: {Message}", detail);
            Notifications.Warning(detail, "Panel Studio interaction", nameof(PanelStudio));
            return Task.CompletedTask;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PanelStudio)}.{nameof(ReportPanelInteractionError)} failed.");
            throw;
        }
    }

