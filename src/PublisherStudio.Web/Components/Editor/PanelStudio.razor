    /// <summary>
    /// Performs panel studio command for <see cref="PanelStudio"/>, keeping the operation consistent with the state and invariants of the surrounding panel studio workflow.
    /// </summary>
    /// <param name="command">Command value supplied to the panel studio operation and used when producing its result.</param>
    /// <param name="amount">Amount value supplied to the panel studio operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    [JSInvokable]
    public Task PanelStudioCommand(string command, double amount = 1) {
        try
        {
            return RunPanelInteropAsync("Command", () =>
        {
            if (_disposed || _interactionPreview)
                return;
            switch ((command ?? string.Empty).Trim().ToLowerInvariant())
            {
                case "left": NudgeSelected(-amount, 0); break;
                case "right": NudgeSelected(amount, 0); break;
                case "up": NudgeSelected(0, -amount); break;
                case "down": NudgeSelected(0, amount); break;
                case "delete": DeleteElement(); break;
                case "duplicate": DuplicateElement(); break;
                case "front": BringElementToFront(); break;
                case "forward": MoveElementUp(); break;
                case "backward": MoveElementDown(); break;
                case "back": SendElementToBack(); break;
            }
        });
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PanelStudio)}.{nameof(PanelStudioCommand)} failed.");
            throw;
        }
    }

