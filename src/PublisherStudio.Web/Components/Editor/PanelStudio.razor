    /// <summary>
    /// Persists selected as template for <see cref="PanelStudio"/>, keeping the operation consistent with the state and invariants of the surrounding panel studio workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task SaveSelectedAsTemplate()
    {
        try
        {
            if (SelectedElement is null) return;
            var name = string.IsNullOrWhiteSpace(_templateName) ? SelectedElement.Name : _templateName.Trim();
            var template = _selectedTemplateId is { } selectedId
                ? Document.ComponentTemplates.FirstOrDefault(item => item.Id == selectedId)
                : null;
            template ??= new PublicationElementTemplate();
            var isNew = !Document.ComponentTemplates.Contains(template);

            // Pointer-up commits are serialized by browser interop. Flush immediately before
            // cloning so the reusable prototype contains the exact last arranged bounds.
            await FlushPanelStudioInteractionsAsync().ConfigureAwait(false);
            template.Prototype = Files.CloneElement(SelectedElement);
            template.Prototype.Id = Guid.NewGuid();
            template.Name = name;
            template.Description = _templateDescription.Trim();
            template.Category = string.IsNullOrWhiteSpace(_templateCategory) ? "My modules" : _templateCategory.Trim();
            template.IconCssClass = IconFor(SelectedElement);
            template.ModifiedUtc = DateTimeOffset.UtcNow;
            Panels.NormalizeTemplate(Document, template);
            if (isNew) Document.ComponentTemplates.Add(template);
            SelectTemplate(template.Id);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PanelStudio)}.{nameof(SaveSelectedAsTemplate)} failed.");
            throw;
        }
    }

