    /// <summary>
    /// Releases resources owned by <see cref="PanelStudio"/> and leaves the panel studio workflow in a safely disposed state.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    public async ValueTask DisposeAsync()
    {
        try
        {
            _disposed = true;
            ClosePanelPictureEditor();
            try
            {
                if (_dropSurfaceBound)
                {
                    await JS.InvokeVoidAsync("publisherStudio.unbindPanelStudioDropSurface", _canvasElement).ConfigureAwait(false);
                    Logger.LogDebug($"{nameof(DisposeAsync)} unbound the Panel Studio browser interaction surface.");
                }
                else
                {
                    Logger.LogDebug($"{nameof(DisposeAsync)} skipped browser unbind because this Panel Studio instance never attached during an interactive render.");
                }
            }
            catch (JSDisconnectedException exception)
            {
                Logger.LogDebug(exception, $"{nameof(DisposeAsync)} observed a disconnected browser circuit while unbinding Panel Studio.");
            }
            catch (OperationCanceledException exception)
            {
                Logger.LogDebug(exception, $"{nameof(DisposeAsync)} observed cancellation while unbinding Panel Studio. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} TokenCancellationRequested:{exception.CancellationToken.IsCancellationRequested}.");
            }
            catch (InvalidOperationException exception)
            {
                Logger.LogDebug(exception, $"{nameof(DisposeAsync)} observed an unavailable renderer while unbinding Panel Studio.");
            }
            catch (JSException exception)
            {
                Logger.LogDebug(exception, $"{nameof(DisposeAsync)} observed a browser-side shutdown while unbinding Panel Studio.");
            }
            _dropSurfaceBound = false;
            _dropSurfaceBindingKey = null;
            _self?.Dispose();
            _self = null;
            Logger.LogDebug($"{nameof(DisposeAsync)} completed Panel Studio disposal.");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, $"{nameof(DisposeAsync)} failed while releasing Panel Studio resources.");
        }
    }

