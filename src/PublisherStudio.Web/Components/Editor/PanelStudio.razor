    private string? PanelPictureRaster => PanelPictureTarget?.DataUrl;
    private string PanelPictureName => PanelPictureTarget?.Name ?? "Picture";

    protected override void OnParametersSet()
    {
        if (!Visible)
        {
            _loadedId = null;
            _dropSurfaceBound = false;
            _pictureEditorVisible = false;
            _pictureEditorTargetId = null;
            return;
        }

        var id = InitialPanel?.Id;
        if (_draft is not null && _loadedId == id) return;
        _draft = InitialPanel is null ? Panels.CreateBlank() : (PanelElement)Files.CloneElement(InitialPanel);
        Panels.Normalize(Document, _draft);
        _selectedViewId = _draft.ActiveViewId;
        _selectedElementId = CurrentView?.Elements.OrderByDescending(element => element.ZIndex).FirstOrDefault()?.Id;
        _loadedId = id;
        _error = string.Empty;
        _interactionPreview = false;
        RefreshAdvancedJson();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var bindingKey = _draft is null ? null : _interactionBindingId;
        if (!Visible || _draft is null || (_dropSurfaceBound && string.Equals(_dropSurfaceBindingKey, bindingKey, StringComparison.Ordinal))) return;
        try
        {
            _self ??= DotNetObjectReference.Create(this);
            _dropSurfaceBound = await JS.InvokeAsync<bool>("publisherStudio.bindPanelStudioDropSurface", _canvasElement, _self, _interactionBindingId).ConfigureAwait(true);
            _dropSurfaceBindingKey = _dropSurfaceBound ? bindingKey : null;
            if (!_dropSurfaceBound)
                throw new InvalidOperationException("The Panel Studio browser interaction surface rejected its binding.");
            Logger.LogInformation($"Panel Studio pointer, keyboard, context-menu, and gamepad interaction binding is active. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} PreviewRevision:{_previewRevision}.");
        }
        catch (JSDisconnectedException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio interaction binding ended because the browser circuit disconnected. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} Visible:{Visible} Disposed:{_disposed}.");
        }
        catch (OperationCanceledException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio interaction binding was cancelled. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} Visible:{Visible} Disposed:{_disposed} TokenCancellationRequested:{exception.CancellationToken.IsCancellationRequested}.");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Panel Studio interaction binding failed.");
            _error = "The Panel Studio interaction surface could not be initialized.";
            Notifications.Error(_error, "Panel Studio", nameof(PanelStudio));
        }
    }

    private void SelectView(Guid id)
    {
        _selectedViewId = id;
        _previewRevision++;
        if (_draft is not null) _draft.ActiveViewId = id;
        SelectElement(CurrentView?.Elements.LastOrDefault()?.Id);
    }

    private void SelectElement(Guid? id)
    {
        _selectedElementId = id;
        if (SelectedElement is { } selected)
        {
            _templateName = selected.Name;
            _templateDescription = $"Reusable {selected.Kind} configured in Panel Studio.";
        }
        RefreshAdvancedJson();
    }

    private void AddView()
    {
        if (_draft is null) return;
        var view = new PublicationPanelView { Name = $"View {_draft.Views.Count + 1}", Slug = $"view-{_draft.Views.Count + 1}" };
        _draft.Views.Add(view);
        SelectView(view.Id);
    }

    private void DuplicateView()
    {
        if (_draft is null || CurrentView is null) return;
        var clone = new PublicationPanelView
        {
            Name = CurrentView.Name + " copy",
            Slug = CurrentView.Slug + "-copy",
            Background = CurrentView.Background,
            Elements = CurrentView.Elements.Select(Files.CloneElement).ToList()
        };
        _draft.Views.Add(clone);
        SelectView(clone.Id);
    }

    private void DeleteView()
    {
        if (_draft is null || CurrentView is null || _draft.Views.Count <= 1) return;
        _draft.Views.Remove(CurrentView);
        SelectView(_draft.Views[0].Id);
    }

