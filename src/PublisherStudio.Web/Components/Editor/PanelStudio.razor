    private async Task ImportHtml(InputFileChangeEventArgs args)
    {
        _error = string.Empty;
        try
        {
            var file = args.File;
            await using var source = file.OpenReadStream(long.MaxValue);
            using var reader = new StreamReader(source, Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
            var markup = await reader.ReadToEndAsync().ConfigureAwait(true);
            AddElement(new HtmlEmbedElement
            {
                Name = Path.GetFileNameWithoutExtension(file.Name), Html = markup,
                Css = "html,body{margin:0;min-height:100%}", JavaScript = string.Empty, AllowScripts = false,
                X = 0, Y = 0, Width = _draft?.CanvasWidth ?? 160, Height = _draft?.CanvasHeight ?? 90
            });
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Panel Studio HTML import failed.");
            _error = $"HTML import failed: {exception.Message}";
            Notifications.Error(_error, "HTML import failed", nameof(PanelStudio));
        }
    }

    private async Task ReplaceSelectedMedia(InputFileChangeEventArgs args)
    {
        if (SelectedElement is not { } selected) return;
        _error = string.Empty;
        try
        {
            var file = args.File;
            await using var source = file.OpenReadStream(long.MaxValue);
            using var memory = new MemoryStream();
            await source.CopyToAsync(memory).ConfigureAwait(true);
            var mime = MediaData.NormalizeMimeType(file.ContentType, "application/octet-stream");
            var dataUrl = $"data:{mime};base64,{Convert.ToBase64String(memory.ToArray())}";
            switch (selected)
            {
                case ImageFrameElement image:
                    image.DataUrl = dataUrl;
                    image.OriginalDataUrl = dataUrl;
                    image.Name = Path.GetFileNameWithoutExtension(file.Name);
                    break;
                case PublicationMediaElement media:
                    media.DataUrl = dataUrl;
                    media.MimeType = mime;
                    media.Name = Path.GetFileNameWithoutExtension(file.Name);
                    media.DurationSeconds = Math.Max(.01, media.DurationSeconds);
                    media.TrimStartSeconds = 0;
                    media.TrimEndSeconds = media.DurationSeconds;
                    media.Segments = [];
                    break;
            }
            RefreshAdvancedJson();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Panel Studio media import failed.");
            _error = $"Media import failed: {exception.Message}";
            Notifications.Error(_error, "Media import failed", nameof(PanelStudio));
        }
    }

    private void AddElement(PublicationElement element)
    {
        if (CurrentView is { } view) AddElement(view, element);
    }

    private void AddElement(PublicationPanelView view, PublicationElement element)
    {
        element.ZIndex = Layout.NextZ(view.Elements);
        view.Elements.Add(element);
        Layout.NormalizeZOrder(view.Elements);
        if (_draft is not null) Panels.Normalize(Document, _draft);
        SelectElement(element.Id);
    }

    private void DuplicateElement()
    {
        if (CurrentView is null || SelectedElement is null) return;
        var clone = Files.CloneElement(SelectedElement);
        clone.Id = Guid.NewGuid();
        clone.Name += " copy";
        clone.X += 4;
        clone.Y += 4;
        clone.ZIndex = Layout.NextZ(CurrentView.Elements);
        CurrentView.Elements.Add(clone);
        SelectElement(clone.Id);
    }

    private void DeleteElement()
    {
        if (CurrentView is null || SelectedElement is null) return;
        CurrentView.Elements.Remove(SelectedElement);
        Layout.NormalizeZOrder(CurrentView.Elements);
        SelectElement(CurrentView.Elements.OrderByDescending(element => element.ZIndex).FirstOrDefault()?.Id);
    }

    private void BringElementToFront() => MoveElement(PublicationLayerMove.BringToFront);
    private void MoveElementUp() => MoveElement(PublicationLayerMove.BringForward);
    private void MoveElementDown() => MoveElement(PublicationLayerMove.SendBackward);
    private void SendElementToBack() => MoveElement(PublicationLayerMove.SendToBack);

    private void MoveElement(PublicationLayerMove move)
    {
        if (CurrentView is null || SelectedElement is not { } selected) return;
        var id = selected.Id;
        var x = selected.X;
        var y = selected.Y;
        var width = selected.Width;
        var height = selected.Height;
        var rotation = selected.Rotation;
        Layout.MoveLayer(CurrentView.Elements, id, move);
        // A layer command changes only Z order. Preserve the authored geometry even when a
        // browser pointer-up arrives late after the context menu opened.
        if (CurrentView.Elements.FirstOrDefault(element => element.Id == id) is { } moved)
        {
            moved.X = x;
            moved.Y = y;
            moved.Width = width;
            moved.Height = height;
            moved.Rotation = rotation;
        }
        SelectElement(id);
    }

    private void NudgeSelected(double deltaX, double deltaY)
    {
        if (_draft is null || SelectedElement is null) return;
        Layout.Nudge(SelectedElement, deltaX, deltaY, _draft.CanvasWidth, _draft.CanvasHeight);
        RefreshAdvancedJson();
    }

