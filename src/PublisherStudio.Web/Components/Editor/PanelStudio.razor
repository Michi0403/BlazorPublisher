    /// <summary>
    /// Performs save for <see cref="PanelStudio"/>, keeping the operation consistent with the state and invariants of the surrounding panel studio workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task Save()
    {
        if (_draft is null) return;
        _error = string.Empty;
        try
        {
            await FlushPanelStudioInteractionsAsync().ConfigureAwait(false);
            Panels.Normalize(Document, _draft);
            // Pass an isolated graph to the parent. Closing or rerendering the dialog must
            // not mutate the object that was just committed to the Mainframe.
            var committed = (PanelElement)Files.CloneElement(_draft);
            Panels.Normalize(Document, committed);
            await InvokeAsync(() => Saved.InvokeAsync(committed)).ConfigureAwait(false);
            await InvokeAsync(() => Notifications.Success("The panel was saved and remains reusable in Mainframe and exports.", "Panel saved", nameof(PanelStudio))).ConfigureAwait(false);
        }
        catch (OperationCanceledException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio save was cancelled before the Mainframe accepted the project. Binding:{_interactionBindingId} Panel:{_draft?.Id} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} TokenCancellationRequested:{exception.CancellationToken.IsCancellationRequested}.");
            await InvokeAsync(() => _error = "The panel was not saved because the operation was cancelled.").ConfigureAwait(false);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Panel Studio could not commit the panel project to the Mainframe.");
            await InvokeAsync(() =>
            {
                _error = exception.Message;
                Notifications.Error(_error, "Panel save failed", nameof(PanelStudio), persistent: true);
            }).ConfigureAwait(false);
        }
    }

