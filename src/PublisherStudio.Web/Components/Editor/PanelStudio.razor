    [JSInvokable]
    public Task ReportPanelInteractionError(string message)
    {
        var detail = string.IsNullOrWhiteSpace(message) ? "Unknown browser interaction error." : message.Trim();
        if (_disposed || IsExpectedInteractionShutdown(detail))
        {
            Logger.LogDebug($"Panel Studio browser interaction ended normally. Binding:{_interactionBindingId} View:{_selectedViewId} Selected:{_selectedElementId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} Detail:{detail}");
            return Task.CompletedTask;
        }

        Logger.LogWarning("Panel Studio browser interaction failed: {Message}", detail);
        Notifications.Warning(detail, "Panel Studio interaction", nameof(PanelStudio));
        return Task.CompletedTask;
    }

    private bool IsExpectedInteractionShutdown(string message) =>
        PanelText.IsExpectedInteractionShutdown(message, Logger);

    private async Task<PanelCanvasPoint> ResolveCanvasPoint(DragEventArgs args)
    {
        try
        {
            return await JS.InvokeAsync<PanelCanvasPoint>("publisherStudio.panelStudioPoint", _canvasElement, args.ClientX, args.ClientY).ConfigureAwait(true);
        }
        catch (OperationCanceledException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio canvas-point resolution was cancelled; falling back to event offsets. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} TokenCancellationRequested:{exception.CancellationToken.IsCancellationRequested}.");
            var x = Math.Clamp(args.OffsetX / 960d, 0, 1);
            var y = Math.Clamp(args.OffsetY / 540d, 0, 1);
            return new PanelCanvasPoint { X = x, Y = y };
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio canvas-point resolution observed an unavailable renderer; falling back to event offsets. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")}.");
            var x = Math.Clamp(args.OffsetX / 960d, 0, 1);
            var y = Math.Clamp(args.OffsetY / 540d, 0, 1);
            return new PanelCanvasPoint { X = x, Y = y };
        }
        catch (JSException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio canvas-point resolution failed in browser interop; falling back to event offsets. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")}.");
            var x = Math.Clamp(args.OffsetX / 960d, 0, 1);
            var y = Math.Clamp(args.OffsetY / 540d, 0, 1);
            return new PanelCanvasPoint { X = x, Y = y };
        }
    }

    private void EndDrag()
    {
        _dragToolId = string.Empty;
        _dragExistingId = null;
        _dragPrototype = null;
    }

    private string DragGhostStyle
    {
        get
        {
            if (_draft is null || _dragPrototype is null) return "display:none";
            var width = Math.Clamp(_dragPrototype.Width / Math.Max(1, _draft.CanvasWidth) * 100, 1, 100);
            var height = Math.Clamp(_dragPrototype.Height / Math.Max(1, _draft.CanvasHeight) * 100, 1, 100);
            return $"left:50%;top:50%;width:{Inv(width)}%;height:{Inv(height)}%;transform:translate(-50%,-50%)";
        }
    }

    private string HitStyle(PublicationElement element)
    {
        if (_draft is null) return string.Empty;
        var left = element.X / Math.Max(1, _draft.CanvasWidth) * 100;
        var top = element.Y / Math.Max(1, _draft.CanvasHeight) * 100;
        var width = element.Width / Math.Max(1, _draft.CanvasWidth) * 100;
        var height = element.Height / Math.Max(1, _draft.CanvasHeight) * 100;
        return $"left:{Inv(left)}%;top:{Inv(top)}%;width:{Inv(width)}%;height:{Inv(height)}%;z-index:{Math.Max(1, element.ZIndex)};transform:rotate({Inv(element.Rotation)}deg)";
    }

    private string NormalizedX(PublicationElement element) => Inv(element.X / Math.Max(1, _draft?.CanvasWidth ?? 1));
    private string NormalizedY(PublicationElement element) => Inv(element.Y / Math.Max(1, _draft?.CanvasHeight ?? 1));
    private string NormalizedWidth(PublicationElement element) => Inv(element.Width / Math.Max(1, _draft?.CanvasWidth ?? 1));
    private string NormalizedHeight(PublicationElement element) => Inv(element.Height / Math.Max(1, _draft?.CanvasHeight ?? 1));

    private async Task ExportPanelJsonAsync()
    {
        if (_draft is null) return;
        try
        {
            var fileName = SafeFileName(_draft.Name, "panel") + ".publisher-panel.json";
            await JS.InvokeVoidAsync("publisherStudio.downloadTextFile", fileName, Files.SerializeElement(_draft), "application/json;charset=utf-8").ConfigureAwait(true);
            Notifications.Success("The complete reusable panel project was exported.", "Panel project exported", nameof(PanelStudio));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Panel Studio project export failed.");
            Notifications.Error("The panel project could not be exported.", "Panel export failed", nameof(PanelStudio));
        }
    }

    private async Task ExportJsonCanvasAsync()
    {
        if (_draft is null || CurrentView is null) return;
        try
        {
            var nodes = new JsonArray();
            foreach (var element in CurrentView.Elements.Where(item => item.Visible).OrderBy(item => item.ZIndex))
            {
                var node = new JsonObject
                {
                    ["id"] = element.Id.ToString("D"),
                    ["type"] = JsonCanvasNodeType(element),
                    ["x"] = (int)Math.Round(element.X),
                    ["y"] = (int)Math.Round(element.Y),
                    ["width"] = Math.Max(1, (int)Math.Round(element.Width)),
                    ["height"] = Math.Max(1, (int)Math.Round(element.Height)),
                    ["color"] = JsonCanvasColor(element),
                    ["publisherStudioElement"] = JsonNode.Parse(Files.SerializeElement(element))
                };
                if (element is TextFrameElement text)
                    node["text"] = PlainText(text.PreviewHtml);
                else if (element is HtmlEmbedElement html)
                    node["text"] = PlainText(html.Html);
                else if (element is ImageFrameElement image && !string.IsNullOrWhiteSpace(image.DataUrl))
                    node["file"] = image.DataUrl;
                nodes.Add(node);
            }
            var root = new JsonObject
            {
                ["nodes"] = nodes,
                ["edges"] = new JsonArray(),
                ["publisherStudio"] = new JsonObject
                {
                    ["format"] = "PublisherStudio Panel/Div Studio",
                    ["version"] = "2.2.4",
                    ["panelName"] = _draft.Name,
                    ["viewName"] = CurrentView.Name,
                    ["canvasWidth"] = _draft.CanvasWidth,
                    ["canvasHeight"] = _draft.CanvasHeight
                }
            };
            var json = root.ToJsonString(new JsonSerializerOptions { WriteIndented = true });
            await JS.InvokeVoidAsync("publisherStudio.downloadTextFile", SafeFileName(CurrentView.Name, "panel-view") + ".canvas", json, "application/json;charset=utf-8").ConfigureAwait(true);
            Notifications.Success("The active view was exported using the open JSON Canvas format while preserving PublisherStudio element data.", "JSON Canvas exported", nameof(PanelStudio));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Panel Studio JSON Canvas export failed.");
            Notifications.Error("The JSON Canvas file could not be exported.", "JSON Canvas export failed", nameof(PanelStudio));
        }
    }

    private async Task ImportPanelInterchangeAsync(InputFileChangeEventArgs args)
    {
        _error = string.Empty;
        try
        {
            var file = args.File;
            await using var source = file.OpenReadStream(long.MaxValue);
            using var reader = new StreamReader(source, Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
            var json = await reader.ReadToEndAsync().ConfigureAwait(true);
            using var document = JsonDocument.Parse(json);
            if (document.RootElement.ValueKind != JsonValueKind.Object)
                throw new InvalidDataException("The selected file does not contain a JSON object.");

            if (document.RootElement.TryGetProperty("nodes", out var nodes) && nodes.ValueKind == JsonValueKind.Array)
            {
                if (_draft is null || CurrentView is null) return;
                var imported = new List<PublicationElement>();
                foreach (var node in nodes.EnumerateArray())
                {
                    PublicationElement? element = null;
                    if (node.TryGetProperty("publisherStudioElement", out var preserved))
                    {
                        try { element = Files.DeserializeElement(preserved.GetRawText()); }
                        catch (Exception exception) { Logger.LogWarning(exception, "A JSON Canvas node contained invalid PublisherStudio extension data; importing the standard node instead."); }
                    }
                    element ??= ImportStandardJsonCanvasNode(node);
                    if (element is null) continue;
                    element.Id = Guid.NewGuid();
                    element.X = ReadNumber(node, "x", element.X);
                    element.Y = ReadNumber(node, "y", element.Y);
                    element.Width = Math.Max(1, ReadNumber(node, "width", element.Width));
                    element.Height = Math.Max(1, ReadNumber(node, "height", element.Height));
                    imported.Add(element);
                }
                foreach (var element in imported) AddElement(CurrentView, element);
                Panels.Normalize(Document, _draft);
                SelectElement(imported.LastOrDefault()?.Id);
                Notifications.Success($"Imported {imported.Count} JSON Canvas node(s) into the active view.", "JSON Canvas imported", nameof(PanelStudio));
                return;
            }

            var panel = Files.DeserializeElement(json) as PanelElement
                ?? throw new InvalidDataException("The JSON file is neither JSON Canvas nor a PublisherStudio panel project.");
            Panels.Normalize(Document, panel);
            _draft = panel;
            _selectedViewId = panel.ActiveViewId;
            _selectedElementId = panel.ActiveView?.Elements.OrderByDescending(element => element.ZIndex).FirstOrDefault()?.Id;
            // Keep the identity of the Mainframe target. Imported projects may carry a
            // different root id and must not be replaced by OnParametersSet on rerender.
            _loadedId = InitialPanel?.Id;
            RefreshAdvancedJson();
            Notifications.Success("The complete Panel/Div Studio project was imported.", "Panel project imported", nameof(PanelStudio));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Panel Studio interchange import failed.");
            _error = $"The panel project could not be imported: {exception.Message}";
            Notifications.Error(_error, "Panel import failed", nameof(PanelStudio), persistent: true);
        }
    }

    private PublicationElement? ImportStandardJsonCanvasNode(JsonElement node)
    {
        var type = node.TryGetProperty("type", out var typeProperty) ? typeProperty.GetString() ?? string.Empty : string.Empty;
        var text = node.TryGetProperty("text", out var textProperty) ? textProperty.GetString() ?? string.Empty : string.Empty;
        return type.ToLowerInvariant() switch
        {
            "text" => new TextFrameElement
            {
                Name = "Imported text",
                PreviewHtml = $"<p>{WebUtility.HtmlEncode(text).Replace(Environment.NewLine, "<br>")}</p>",
                Background = "#ffffff",
                BorderColor = "#cbd5e1",
                BorderWidth = .2
            },
            "link" => new HtmlEmbedElement
            {
                Name = "Imported link",
                Html = $"<main><a href=\"{WebUtility.HtmlEncode(node.TryGetProperty("url", out var url) ? url.GetString() : string.Empty)}\" target=\"_blank\" rel=\"noopener noreferrer\">{WebUtility.HtmlEncode(text.Length == 0 ? "Open link" : text)}</a></main>",
                Css = "html,body{margin:0;height:100%;font:16px Segoe UI,system-ui,sans-serif}main{box-sizing:border-box;padding:20px}"
            },
            "file" => new TextFrameElement
            {
                Name = "Imported file reference",
                PreviewHtml = $"<p><strong>File</strong><br>{WebUtility.HtmlEncode(node.TryGetProperty("file", out var file) ? file.GetString() : string.Empty)}</p>",
                Background = "#f8fafc",
                BorderColor = "#94a3b8",
                BorderWidth = .2
            },
            "group" => new ShapeElement { Name = string.IsNullOrWhiteSpace(text) ? "Imported group" : text, Shape = PublicationShape.RoundedRectangle, Fill = "#f8fafc", Stroke = "#94a3b8", CornerRadiusMm = 2 },
            _ => null
        };
    }

    private double ReadNumber(JsonElement node, string propertyName, double fallback) =>
        PanelText.ReadNumber(node, propertyName, fallback, Logger);

    private string JsonCanvasNodeType(PublicationElement element) => element switch
    {
        TextFrameElement => "text",
        ImageFrameElement => "file",
        HtmlEmbedElement => "text",
        PanelElement => "group",
        _ => "group"
    };

