    private void AddBehavior()
    {
        try
        {
            if (SelectedElement is not { } selected) return;
            Behaviors.Add(
                selected,
                _behaviorTrigger,
                _behaviorAction,
                BehaviorNeedsTarget ? ParseGuid(_behaviorTargetId) : null,
                _behaviorAction == PublicationBehaviorAction.GoToPage ? ParseGuid(_behaviorTargetPageId) : null,
                _behaviorAction == PublicationBehaviorAction.CallMethod ? _behaviorMethod : null,
                _behaviorAction is PublicationBehaviorAction.SetText or PublicationBehaviorAction.SetValue ? _behaviorValue : null,
                _behaviorAction == PublicationBehaviorAction.OpenUrl ? _behaviorUrl : null);
            RefreshAdvancedJson();
            _previewRevision++;
            Notifications.Success("Behavior added to the selected publication object.", "Panel Studio", nameof(PanelStudio));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, $"{nameof(AddBehavior)} failed.");
            Notifications.Error("The publication behavior could not be added.", "Panel Studio", nameof(PanelStudio));
        }
