    /// <summary>Returns a readable target address for a persisted publication behavior.</summary>
    /// <param name="behavior">Behavior value supplied to the panel studio operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string BehaviorTargetAddress(PublicationBehavior behavior)
    {
        try
        {
            if (behavior.Action == PublicationBehaviorAction.GoToPage && behavior.TargetPageId is { } pageId)
            {
                var page = Document.Pages.FirstOrDefault(item => item.Id == pageId);
                return page is null ? $"page:{pageId}" : Behaviors.Address(Document, page);
            }
            if (behavior.Action == PublicationBehaviorAction.OpenUrl) return behavior.Url;
            if (behavior.TargetElementId is not { } targetId) return SelectedObjectAddress;
            return BehaviorTargets.FirstOrDefault(item => item.ElementId == targetId)?.Address ?? $"element:{targetId}";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, $"{nameof(BehaviorTargetAddress)} failed.");
            return "Target unavailable";
        }
    }

    /// <summary>Returns or creates the explicitly enabled click custom-script action for a component.</summary>
    /// <param name="component">Component value supplied to the panel studio operation and used when producing its result.</param>
    /// <returns>The publication component action produced by the operation.</returns>
    private PublicationComponentAction EnsureClickScriptAction(DevExtremeComponentElement component)
    {
        try
        {
            component.AllowCustomScript = true;
            var action = component.Actions.FirstOrDefault(item =>
                item.Trigger == PublicationComponentActionTrigger.Click &&
                item.Action == PublicationComponentActionKind.CustomScript);
            if (action is not null) return action;

            action = new PublicationComponentAction
            {
                Trigger = PublicationComponentActionTrigger.Click,
                Action = PublicationComponentActionKind.CustomScript
            };
            component.Actions.Add(action);
            return action;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, $"{nameof(EnsureClickScriptAction)} failed.");
            throw;
        }
    }

    /// <summary>Adds a generated object-interface method call to a component's click script.</summary>
    /// <param name="component">Component value supplied to the panel studio operation and used when producing its result.</param>
    private void AddGeneratedComponentScript(DevExtremeComponentElement component)
    {
        try
        {
            var address = ParseGuid(_scriptTargetId) is { } targetId
                ? BehaviorTargets.FirstOrDefault(item => item.ElementId == targetId)?.Address ?? SelectedObjectAddress
                : SelectedObjectAddress;
            var method = ScriptCommonMethods.Contains(_scriptMethod, StringComparer.OrdinalIgnoreCase)
                ? _scriptMethod
                : ScriptCommonMethods.FirstOrDefault() ?? "refresh";
            var action = EnsureClickScriptAction(component);
            action.Script = Behaviors.AppendScript(action.Script, Behaviors.ScriptCall(address, method));
            RefreshAdvancedJson();
            _previewRevision++;
            Notifications.Success($"Added {method}() through the publication object interface.", "JavaScript helper", nameof(PanelStudio));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, $"{nameof(AddGeneratedComponentScript)} failed.");
            Notifications.Error("The generated publication JavaScript could not be added.", "Panel Studio", nameof(PanelStudio));
        }
    }

