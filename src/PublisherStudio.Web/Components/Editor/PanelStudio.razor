    /// <summary>
    /// Handles the parameters set lifecycle or event notification for <see cref="PanelStudio"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnParametersSet()
    {
        try
        {
            if (!Visible)
            {
                _loadedId = null;
                _dropSurfaceBound = false;
                _dropSurfaceBindingKey = null;
                _designSurfaceLayoutKey = null;
                _lastInteractionSurfaceNotification = string.Empty;
                _pictureEditorVisible = false;
                _pictureEditorTargetId = null;
                return;
            }

            var id = InitialPanel?.Id;
            if (_draft is not null && _loadedId == id) return;
            _draft = InitialPanel is null ? Panels.CreateBlank() : (PanelElement)Files.CloneElement(InitialPanel);
            Panels.Normalize(Document, _draft);
            _selectedViewId = _draft.ActiveViewId;
            _selectedElementId = CurrentView?.Elements.OrderByDescending(element => element.ZIndex).FirstOrDefault()?.Id;
            _loadedId = id;
            _error = string.Empty;
            _lastInteractionSurfaceNotification = string.Empty;
            _interactionPreview = false;
            _previewSizeKey = "design";
            RefreshPreviewPresets();
            RefreshAdvancedJson();
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PanelStudio)}.{nameof(OnParametersSet)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Handles the after render async lifecycle or event notification for <see cref="PanelStudio"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="firstRender">Value indicating whether first render should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Browser interaction has one component-lifetime identity. Layout dimensions are deliberately
        // tracked separately: changing the panel-local canvas may refresh the fitted authoring surface,
        // but must never tear down/recreate pointer, keyboard, context-menu, or gamepad handlers.
        var bindingKey = _draft is null ? null : _interactionBindingId;
        var designSurfaceLayoutKey = _draft is null ? null : $"{PanelDesignWidthPx}:{PanelDesignHeightPx}";
        if (!Visible || _draft is null) return;
        try
        {
            _self ??= DotNetObjectReference.Create(this);
            if (!_dropSurfaceBound || !string.Equals(_dropSurfaceBindingKey, bindingKey, StringComparison.Ordinal))
            {
                _dropSurfaceBound = await JS.InvokeAsync<bool>("publisherStudio.bindPanelStudioDropSurface", _canvasElement, _self, _interactionBindingId).ConfigureAwait(true);
                _dropSurfaceBindingKey = _dropSurfaceBound ? bindingKey : null;
                if (!_dropSurfaceBound)
                    throw new InvalidOperationException("The Panel Studio browser interaction surface rejected its binding.");
                _lastInteractionSurfaceNotification = string.Empty;
                Logger.LogInformation($"Panel Studio pointer, keyboard, context-menu, and gamepad interaction binding is active. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} PreviewRevision:{_previewRevision}.");
            }

            if (_dropSurfaceBound && !string.Equals(_designSurfaceLayoutKey, designSurfaceLayoutKey, StringComparison.Ordinal))
            {
                await JS.InvokeVoidAsync("publisherStudio.refreshPanelStudioDesignSurface", _canvasElement).ConfigureAwait(true);
                _designSurfaceLayoutKey = designSurfaceLayoutKey;
                _lastInteractionSurfaceNotification = string.Empty;
                Logger.LogDebug($"Panel Studio authoring layout refreshed without rebinding browser interaction. Binding:{_interactionBindingId} Canvas:{PanelDesignWidthPx}x{PanelDesignHeightPx}.");
            }
        }
        catch (JSDisconnectedException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio interaction binding ended because the browser circuit disconnected. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} Visible:{Visible} Disposed:{_disposed}.");
        }
        catch (OperationCanceledException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio interaction binding was cancelled. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} Visible:{Visible} Disposed:{_disposed} TokenCancellationRequested:{exception.CancellationToken.IsCancellationRequested}.");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Panel Studio interaction binding failed.");
            _error = "The Panel Studio interaction surface could not be initialized.";
            var notificationKey = $"{exception.GetType().FullName}:{exception.Message}";
            if (!string.Equals(_lastInteractionSurfaceNotification, notificationKey, StringComparison.Ordinal))
            {
                _lastInteractionSurfaceNotification = notificationKey;
                Notifications.Error(_error, "Panel Studio", nameof(PanelStudio));
            }
        }
    }

