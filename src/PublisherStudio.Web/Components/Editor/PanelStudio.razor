    /// <summary>
    /// Resolves canvas point for <see cref="PanelStudio"/>, keeping the operation consistent with the state and invariants of the surrounding panel studio workflow.
    /// </summary>
    /// <param name="args">Args value supplied to the panel studio operation and used when producing its result.</param>
    /// <returns>The panel canvas point produced by the operation.</returns>
    private async Task<PanelCanvasPoint> ResolveCanvasPoint(DragEventArgs args)
    {
        try
        {
            return await JS.InvokeAsync<PanelCanvasPoint>("publisherStudio.panelStudioPoint", _canvasElement, args.ClientX, args.ClientY).ConfigureAwait(false);
        }
        catch (OperationCanceledException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio canvas-point resolution was cancelled; falling back to event offsets. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} TokenCancellationRequested:{exception.CancellationToken.IsCancellationRequested}.");
            var x = Math.Clamp(args.OffsetX / 960d, 0, 1);
            var y = Math.Clamp(args.OffsetY / 540d, 0, 1);
            return new PanelCanvasPoint { X = x, Y = y };
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio canvas-point resolution observed an unavailable renderer; falling back to event offsets. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")}.");
            var x = Math.Clamp(args.OffsetX / 960d, 0, 1);
            var y = Math.Clamp(args.OffsetY / 540d, 0, 1);
            return new PanelCanvasPoint { X = x, Y = y };
        }
        catch (JSException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio canvas-point resolution failed in browser interop; falling back to event offsets. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")}.");
            var x = Math.Clamp(args.OffsetX / 960d, 0, 1);
            var y = Math.Clamp(args.OffsetY / 540d, 0, 1);
            return new PanelCanvasPoint { X = x, Y = y };
        }
    }

