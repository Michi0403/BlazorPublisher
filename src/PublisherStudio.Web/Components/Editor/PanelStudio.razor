            var replacement = Files.DeserializeElement(_advancedElementJson);
            replacement.Id = SelectedElement.Id;
            replacement.ZIndex = SelectedElement.ZIndex;
            var index = CurrentView.Elements.IndexOf(SelectedElement);
            CurrentView.Elements[index] = replacement;
            if (_draft is not null) Panels.Normalize(Document, _draft);
            SelectElement(replacement.Id);
            _error = string.Empty;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Panel Studio advanced component configuration could not be applied.");
