    private async Task ActivateElementInteraction(Guid id)
    {
        await CancelPanelPointerAsync().ConfigureAwait(true);
        SelectElement(id);
        if (SelectedElement is ImageFrameElement)
        {
            _interactionPreview = false;
            _pictureEditorTargetId = id;
            _pictureEditorSessionId = Guid.NewGuid();
            _pictureEditorVisible = true;
