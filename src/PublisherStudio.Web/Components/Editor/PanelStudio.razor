    /// <summary>
    /// Waits for queued pointer/keyboard layout commits to reach the Blazor circuit before
    /// a reusable module or the complete panel graph is cloned.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task FlushPanelStudioInteractionsAsync()
    {
        try
        {
            if (!_dropSurfaceBound) return;
