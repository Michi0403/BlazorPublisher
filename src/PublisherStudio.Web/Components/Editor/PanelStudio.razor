    /// <summary>
    /// Performs replace selected media for <see cref="PanelStudio"/>, keeping the operation consistent with the state and invariants of the surrounding panel studio workflow.
    /// </summary>
    /// <param name="args">Input file change event args dependency used by the panel studio workflow to provide the corresponding application capability.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ReplaceSelectedMedia(InputFileChangeEventArgs args)
    {
        if (SelectedElement is not { } selected) return;
        _error = string.Empty;
        try
        {
            var file = args.File;
            var source = file.OpenReadStream(long.MaxValue);
            await using var configuredSource = source.ConfigureAwait(false);
            using var memory = new MemoryStream();
            await source.CopyToAsync(memory).ConfigureAwait(false);
            var mime = MediaData.NormalizeMimeType(file.ContentType, "application/octet-stream");
            var dataUrl = $"data:{mime};base64,{Convert.ToBase64String(memory.ToArray())}";
            switch (selected)
            {
                case ImageFrameElement image:
                    image.DataUrl = dataUrl;
                    image.OriginalDataUrl = dataUrl;
                    image.Name = Path.GetFileNameWithoutExtension(file.Name);
                    break;
                case PublicationMediaElement media:
                    media.DataUrl = dataUrl;
                    media.MimeType = mime;
                    media.Name = Path.GetFileNameWithoutExtension(file.Name);
                    media.DurationSeconds = Math.Max(.01, media.DurationSeconds);
                    media.TrimStartSeconds = 0;
                    media.TrimEndSeconds = media.DurationSeconds;
                    media.Segments = [];
                    break;
            }
            RefreshAdvancedJson();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Panel Studio media import failed.");
            _error = $"Media import failed: {exception.Message}";
            Notifications.Error(_error, "Media import failed", nameof(PanelStudio));
        }
    }

