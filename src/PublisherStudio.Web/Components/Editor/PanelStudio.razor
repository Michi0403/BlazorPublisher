    private async Task Save()
    {
        if (_draft is null) return;
        _error = string.Empty;
        try
        {
            Panels.Normalize(Document, _draft);
            // Pass an isolated graph to the parent. Closing or rerendering the dialog must
            // not mutate the object that was just committed to the Mainframe.
            var committed = (PanelElement)Files.CloneElement(_draft);
            Panels.Normalize(Document, committed);
            await Saved.InvokeAsync(committed).ConfigureAwait(true);
            Notifications.Success("The panel was saved and remains reusable in Mainframe and exports.", "Panel saved", nameof(PanelStudio));
        }
        catch (OperationCanceledException exception)
        {
            Logger.LogDebug(exception, $"Panel Studio save was cancelled before the Mainframe accepted the project. Binding:{_interactionBindingId} Panel:{_draft?.Id} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} TokenCancellationRequested:{exception.CancellationToken.IsCancellationRequested}.");
            _error = "The panel was not saved because the operation was cancelled.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Panel Studio could not commit the panel project to the Mainframe.");
            _error = exception.Message;
            Notifications.Error(_error, "Panel save failed", nameof(PanelStudio), persistent: true);
        }
    }

    private Task Cancel() => Cancelled.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        try
        {
            _disposed = true;
            ClosePanelPictureEditor();
            try
            {
                await JS.InvokeVoidAsync("publisherStudio.unbindPanelStudioDropSurface", _canvasElement).ConfigureAwait(true);
                Logger.LogDebug($"{nameof(DisposeAsync)} unbound the Panel Studio browser interaction surface.");
            }
            catch (JSDisconnectedException exception)
            {
                Logger.LogDebug(exception, $"{nameof(DisposeAsync)} observed a disconnected browser circuit while unbinding Panel Studio.");
            }
            catch (OperationCanceledException exception)
            {
                Logger.LogDebug(exception, $"{nameof(DisposeAsync)} observed cancellation while unbinding Panel Studio. Binding:{_interactionBindingId} View:{_selectedViewId} Mode:{(_interactionPreview ? "Interact" : "Arrange")} TokenCancellationRequested:{exception.CancellationToken.IsCancellationRequested}.");
            }
            catch (InvalidOperationException exception)
            {
                Logger.LogDebug(exception, $"{nameof(DisposeAsync)} observed an unavailable renderer while unbinding Panel Studio.");
            }
            catch (JSException exception)
            {
                Logger.LogDebug(exception, $"{nameof(DisposeAsync)} observed a browser-side shutdown while unbinding Panel Studio.");
            }
            _dropSurfaceBound = false;
            _dropSurfaceBindingKey = null;
            _self?.Dispose();
            _self = null;
            Logger.LogDebug($"{nameof(DisposeAsync)} completed Panel Studio disposal.");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, $"{nameof(DisposeAsync)} failed while releasing Panel Studio resources.");
        }
    }

