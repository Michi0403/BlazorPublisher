@namespace PublisherStudio.Components.Editor
@inject PublicationMediaAssetStore MediaAssets
@inject PublicationBehaviorService Behaviors

@inject ILogger<PanelView> Logger
<div class="publication-panel panel-nav-@Item.NavigationMode.ToString().ToLowerInvariant() panel-layout-@Item.LayoutMode.ToString().ToLowerInvariant() @(DesignerMode ? "panel-designer-preview" : null) @(ForceCanvasLayout ? "panel-force-canvas" : null)"
     data-panel-root
     data-panel-id="@Item.Id"
     data-panel-active-view="@ActiveViewId"
     data-panel-navigation="@Item.NavigationMode.ToString().ToLowerInvariant()"
     style="@PanelStyle">
    @if (Item.NavigationMode != PublicationPanelNavigationMode.Hidden && EnabledViews.Count > 1)
    {
        <nav class="publication-panel-navigation" aria-label="@Item.Name views">
            @foreach (var view in EnabledViews)
            {
                <button type="button" class="@(view.Id == ActiveViewId ? "active" : null)" data-panel-target="@view.Id" aria-current="@(view.Id == ActiveViewId ? "page" : null)">@view.Name</button>
            }
        </nav>
    }
    <div class="publication-panel-viewport" data-panel-authoring-viewport="@(AuthoringOverlay is not null ? "true" : null)">
        <div class="publication-panel-canvas-region" data-panel-canvas-region>
        @foreach (var view in EnabledViews)
        {
            <section @key="view.Id" class="publication-panel-view @(Item.LayoutMode == PublicationPanelLayoutMode.Responsive && !ForceCanvasLayout ? "responsive-panel-view" : null)" data-panel-view="@view.Id" data-panel-slug="@view.Slug" hidden="@(view.Id != ActiveViewId)" style="background:@view.Background">
                @foreach (var element in view.Elements.Where(element => element.Visible).OrderBy(element => element.ZIndex))
                {
                    <div @key="element.Id" class="publication-panel-element kind-@element.Kind.ToString().ToLowerInvariant() @ResponsiveElementClass(element)"
                         data-panel-element
                         data-element-id="@element.Id" data-element-name="@element.Name"
                         data-element-kind="@element.Kind.ToString().ToLowerInvariant()"
                         data-object-address="@Behaviors.Address(Document, Item, view, element)"
                         data-behaviors="@Behaviors.Serialize(element)"
                         data-interaction="@AnimationData.Interaction(element)"
                         data-interaction-action="@element.Interaction.Action"
                         data-media-kind="@(element is PublicationMediaElement ? element.Kind.ToString().ToLowerInvariant() : null)"
                         data-media-start="@(element is PublicationMediaElement media ? Inv(media.TimelineStartSeconds) : null)"
                         data-media-trim-start="@(element is PublicationMediaElement trimStart ? Inv(trimStart.TrimStartSeconds) : null)"
                         data-media-trim-end="@(element is PublicationMediaElement trimEnd ? Inv(trimEnd.EffectiveTrimEndSeconds) : null)"
                         style="@ElementStyle(element)">
                        @if (DesignPreviewOnly)
                        {
                            <PanelElementPreview Item="element" />
                        }
                        else
                        {
                            @switch (element)
                            {
                            case TextFrameElement text:
                                <div class="text-frame-content" style="padding:@Mm(text.PaddingMm);background:@text.Background;border:@Mm(text.BorderWidth) solid @text.BorderColor">@((MarkupString)text.PreviewHtml)</div>
                                break;
                            case ImageFrameElement image:
                                <div class="image-frame" style="@ImageFrameStyle(image)"><img src="@image.DataUrl" alt="@image.AltText" style="@ImageStyle(image)" /></div>
                                break;
                            case VideoElement video:
                                <VideoMediaView Item="video" />
                                break;
                            case AudioElement audio:
                                <div class="audio-object compact"><audio src="@MediaAssets.GetOrRegister(audio)" controls="@audio.ShowControls" muted="@audio.Muted" loop="@audio.Loop" preload="metadata"></audio><span>@audio.Name</span></div>
                                break;
                            case ShapeElement shape:
                                <div class="shape" style="@ShapeStyle(shape)"></div>
                                break;
                            case WordArtElement wordArt:
                                <div class="panel-wordart" style="color:@wordArt.FillColor;font-family:@wordArt.FontFamily;font-size:@(Inv(wordArt.FontSizePt / 2.8))px;font-weight:@(wordArt.Bold ? 700 : 400);font-style:@(wordArt.Italic ? "italic" : "normal")">@wordArt.Text</div>
                                break;
                            case DataVisualElement dataVisual:
                                <DataVisualView Document="Document" Item="dataVisual" CurrentPageId="CurrentPageId" />
                                break;
                            case DevExtremeComponentElement component:
                                <DevExtremeComponentView Document="Document" Item="component" CurrentPageId="CurrentPageId" DesignerMode="@DesignerMode" IdPrefix="panel" />
                                break;
                            case LiveSourceElement liveSource:
                                <LiveSourceView @key="(liveSource.Id, liveSource.SourceKind)" Item="liveSource" DesignerMode="@DesignerMode" />
                                break;
                            case SpreadsheetElement spreadsheet:
                                <div class="spreadsheet-object publication-content-frame" style="background:@spreadsheet.Background;border:@Mm(spreadsheet.BorderWidthMm) solid @spreadsheet.BorderColor">
                                    @if (spreadsheet.ShowSheetName) { <strong>@spreadsheet.ActiveSheetName</strong> }
                                    <div class="spreadsheet-preview-html">@((MarkupString)spreadsheet.PreviewHtml)</div>
                                </div>
                                break;
                            case BarcodeElement barcode:
                                <BarcodeView Item="barcode" />
                                break;
                            case PanelElement nestedPanel:
                                <PanelView Document="Document" Item="nestedPanel" CurrentPageId="CurrentPageId" DesignerMode="@DesignerMode" />
                                break;
                            case HtmlEmbedElement html:
                                <HtmlEmbedView Item="html" DesignerMode="@DesignerMode" />
                                break;
                            }
                        }
                    </div>
                }
            </section>
        }
        @AuthoringOverlay
        </div>
    </div>
</div>

@code {

    /// <summary>
    /// Gets or sets the document value that forms part of the panel view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The document value exposed by <see cref="PanelView"/>.</value>
    [Parameter, EditorRequired] public PublicationDocument Document { get; set; } = default!;
    /// <summary>
    /// Gets or sets the item value that forms part of the panel view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The item value exposed by <see cref="PanelView"/>.</value>
    [Parameter, EditorRequired] public PanelElement Item { get; set; } = default!;
    /// <summary>
    /// Gets or sets the stable current page identifier used to identify or correlate this panel view instance with related application state.
    /// </summary>
    /// <value>The current page identifier value exposed by <see cref="PanelView"/>.</value>
    [Parameter] public Guid CurrentPageId { get; set; }
    /// <summary>
    /// Gets or sets a value indicating whether designer mode applies to the panel view state.
    /// </summary>
    /// <value>The designer mode value exposed by <see cref="PanelView"/>.</value>
    [Parameter] public bool DesignerMode { get; set; }
    /// <summary>
    /// Gets or sets a value indicating whether design preview only applies to the panel view state.
    /// </summary>
    /// <value>The design preview only value exposed by <see cref="PanelView"/>.</value>
    [Parameter] public bool DesignPreviewOnly { get; set; }
    /// <summary>Forces authored canvas coordinates even for responsive panels. Panel Studio uses this in Arrange mode so the live component DOM and selection hitboxes share exactly one geometry.</summary>
    /// <value>The force canvas layout value exposed by <see cref="PanelView"/>.</value>
    [Parameter] public bool ForceCanvasLayout { get; set; }
    /// <summary>Optional authoring overlay rendered inside the exact viewport that owns panel element coordinates.</summary>
    /// <value>The authoring overlay value exposed by <see cref="PanelView"/>.</value>
    [Parameter] public RenderFragment? AuthoringOverlay { get; set; }

    /// <summary>
    /// Gets the enabled views collection maintained or exposed by this panel view instance for downstream processing.
    /// </summary>
    /// <value>The enabled views value exposed by <see cref="PanelView"/>.</value>
    private IReadOnlyList<PublicationPanelView> EnabledViews => Item.Views.Where(view => view.Enabled).ToArray();
    /// <summary>
    /// Gets the stable active view identifier used to identify or correlate this panel view instance with related application state.
    /// </summary>
    /// <value>The active view identifier value exposed by <see cref="PanelView"/>.</value>
    private Guid ActiveViewId => Item.ActiveView?.Id ?? Item.Views.FirstOrDefault()?.Id ?? Guid.Empty;
    /// <summary>
    /// Gets the panel style value that forms part of the panel view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The panel style value exposed by <see cref="PanelView"/>.</value>
    private string PanelStyle => $"background:{Item.Background};border:{Mm(Item.BorderWidthMm)} solid {Item.BorderColor};border-radius:{Mm(Item.CornerRadiusMm)};overflow:{(Item.ClipContent ? "hidden" : "visible")};--panel-canvas-width:{Inv(Item.CanvasWidth)};--panel-canvas-height:{Inv(Item.CanvasHeight)};--panel-canvas-aspect:{Inv(Math.Max(.01, Item.CanvasWidth / Math.Max(.01, Item.CanvasHeight)))}";
    /// <summary>
    /// Performs element style for <see cref="PanelView"/>, keeping the operation consistent with the state and invariants of the surrounding panel view workflow.
    /// </summary>
    /// <param name="element">Element value supplied to the panel view operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string ElementStyle(PublicationElement element)
    {
        try
        {
            if (Item.LayoutMode == PublicationPanelLayoutMode.Responsive && !ForceCanvasLayout)
            {
                var order = Math.Max(0, element.ZIndex);
                var minimumHeight = Math.Clamp(element.Height / Math.Max(1, Item.CanvasHeight) * 620, 72, 420);
                return $"order:{order};min-height:{Inv(minimumHeight)}px;z-index:{element.ZIndex};--panel-element-aspect:{Inv(Math.Max(.25, element.Width / Math.Max(.25, element.Height)))}";
            }
            var left = element.X / Math.Max(1, Item.CanvasWidth) * 100;
            var top = element.Y / Math.Max(1, Item.CanvasHeight) * 100;
            var width = element.Width / Math.Max(1, Item.CanvasWidth) * 100;
            var height = element.Height / Math.Max(1, Item.CanvasHeight) * 100;
            return $"left:{Inv(left)}%;top:{Inv(top)}%;width:{Inv(width)}%;height:{Inv(height)}%;z-index:{element.ZIndex};transform:rotate({Inv(element.Rotation)}deg)";
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PanelView)}.{nameof(ElementStyle)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Performs responsive element class for <see cref="PanelView"/>, keeping the operation consistent with the state and invariants of the surrounding panel view workflow.
    /// </summary>
    /// <param name="element">Element value supplied to the panel view operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string ResponsiveElementClass(PublicationElement element) {
        try
        {
            return ForceCanvasLayout ? string.Empty : element switch
    {
        TextFrameElement => "panel-responsive-title",
        DataVisualElement visual when visual.VisualKind == DataVisualKind.DataTable => "panel-responsive-wide",
        DevExtremeComponentElement => "panel-responsive-wide",
        HtmlEmbedElement or PanelElement or LiveSourceElement or VideoElement => "panel-responsive-wide",
        _ => "panel-responsive-card"
    };
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PanelView)}.{nameof(ResponsiveElementClass)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Performs shape style for <see cref="PanelView"/>, keeping the operation consistent with the state and invariants of the surrounding panel view workflow.
    /// </summary>
    /// <param name="shape">Shape value supplied to the panel view operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string ShapeStyle(ShapeElement shape) {
        try
        {
            return shape.Shape == PublicationShape.Line
        ? $"background:{shape.Stroke};height:{Mm(Math.Max(shape.StrokeWidth, .3))};top:50%;position:absolute;width:100%"
        : $"background:{shape.Fill};border:{Mm(shape.StrokeWidth)} solid {shape.Stroke};border-radius:{(shape.Shape == PublicationShape.Ellipse ? "50%" : shape.Shape == PublicationShape.RoundedRectangle ? Mm(shape.CornerRadiusMm) : "0")}";
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PanelView)}.{nameof(ShapeStyle)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Performs image frame style for <see cref="PanelView"/>, keeping the operation consistent with the state and invariants of the surrounding panel view workflow.
    /// </summary>
    /// <param name="image">Image frame element dependency used by the panel view workflow to provide the corresponding application capability.</param>
    /// <returns>The string produced by the operation.</returns>
    private string ImageFrameStyle(ImageFrameElement image) {
        try
        {
            return $"border-radius:{(image.MaskShape == ImageMaskShape.Ellipse ? "50%" : image.MaskShape == ImageMaskShape.RoundedRectangle ? Mm(image.CornerRadiusMm) : "0")};border:{Mm(image.BorderWidthMm)} solid {image.BorderColor};overflow:hidden";
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PanelView)}.{nameof(ImageFrameStyle)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Performs image style for <see cref="PanelView"/>, keeping the operation consistent with the state and invariants of the surrounding panel view workflow.
    /// </summary>
    /// <param name="image">Image frame element dependency used by the panel view workflow to provide the corresponding application capability.</param>
    /// <returns>The string produced by the operation.</returns>
    private string ImageStyle(ImageFrameElement image)
    {
        try
        {
            var sx = image.FlipHorizontal ? -image.CropScale : image.CropScale;
            var sy = image.FlipVertical ? -image.CropScale : image.CropScale;
            return $"width:100%;height:100%;object-fit:{(image.FitInsideFrame ? "contain" : "cover")};transform:translate({Inv(image.CropX)}%,{Inv(image.CropY)}%) rotate({Inv(image.ImageRotation)}deg) scale({Inv(sx)},{Inv(sy)});opacity:{Inv(image.Opacity)};filter:brightness({Inv(image.Brightness)}) contrast({Inv(image.Contrast)}) saturate({Inv(image.Saturation)}) hue-rotate({Inv(image.HueRotation)}deg) invert({Inv(image.Invert)}) grayscale({Inv(image.Grayscale)}) sepia({Inv(image.Sepia)}) blur({Inv(image.Blur)}px)";
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PanelView)}.{nameof(ImageStyle)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Performs mm for <see cref="PanelView"/>, keeping the operation consistent with the state and invariants of the surrounding panel view workflow.
    /// </summary>
    /// <param name="value">Value value supplied to the panel view operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string Mm(double value) {
        try
        {
            return $"{Inv(value)}mm";
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PanelView)}.{nameof(Mm)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Performs inv for <see cref="PanelView"/>, keeping the operation consistent with the state and invariants of the surrounding panel view workflow.
    /// </summary>
    /// <param name="value">Value value supplied to the panel view operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string Inv(double value) {
        try
        {
            return value.ToString("0.###", CultureInfo.InvariantCulture);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PanelView)}.{nameof(Inv)} failed.");
            throw;
        }
    }

}
