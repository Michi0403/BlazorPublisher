                        <Items>
                            <DxContextMenuItem Text="@(CheckedText(raster.FitMode == PictureRasterFitMode.Contain, "Contain"))" Click="RasterContain" />
                            <DxContextMenuItem Text="@(CheckedText(raster.FitMode == PictureRasterFitMode.Cover, "Cover"))" Click="RasterCover" />
                            <DxContextMenuItem Text="@(CheckedText(raster.FitMode == PictureRasterFitMode.Stretch, "Stretch"))" Click="RasterStretch" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text='@LT("Flip horizontal")' Enabled="@(!raster.Locked)" Click="RasterFlipHorizontal" />
                    <DxContextMenuItem Text='@LT("Flip vertical")' Enabled="@(!raster.Locked)" Click="RasterFlipVertical" />
                    <DxContextMenuItem Text='@LT("Rotate image")'>
                        <Items>
                            <DxContextMenuItem Text='@LT("Rotate 90° left")' Click="RasterRotateLeft" />
                            <DxContextMenuItem Text='@LT("Rotate 90° right")' Click="RasterRotateRight" />
                            <DxContextMenuItem Text='@LT("Reset rotation")' Click="RasterResetRotation" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text='@LT("Tint")'>
                        <Items>
                            <DxContextMenuItem Text='@LT("No tint")' Click="RasterNoTint" />
                            <DxContextMenuItem Text='@LT("Blue tint")' Click="RasterBlueTint" />
                            <DxContextMenuItem Text='@LT("Warm tint")' Click="RasterWarmTint" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text='@LT("Change colors")' IconCssClass="pub-icon pub-icon-color">
                        <Items>
                            <DxContextMenuItem Text='@LT("White / light → red")' Click="RasterWhiteToRed" />
                            <DxContextMenuItem Text='@LT("White / light → tint color")' Click="RasterWhiteToTint" />
                            <DxContextMenuItem Text='@LT("Colorize by luminosity")' Click="RasterLuminosityColorize" />
