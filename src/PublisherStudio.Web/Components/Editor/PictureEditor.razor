@namespace PublisherStudio.Components.Editor
@implements IDisposable
@implements IAsyncDisposable

@if (Visible)
{
    <div class="modal-backdrop picture-studio-backdrop">
        <section id="picture-studio-window" class="picture-studio-dialog" role="dialog" aria-modal="true" aria-label='@LT("Picture Studio")'>
            <header class="picture-studio-titlebar">
                <div>
                    <strong>@LT("Picture Studio")</strong>
                    <span>@State.Document.Name · @State.Document.WidthPx × @State.Document.HeightPx px</span>
                </div>
                <button type="button" class="window-close" title='@LT("Close")' @onclick="Cancel">×</button>
            </header>

            <DxRibbon CssClass="picture-studio-ribbon categorized-ribbon" SizeMode="SizeMode.Medium" AdaptivityAutoCollapseItemsToGroups="true">
                <DxRibbonTab Text='@LT("Home")'>
                    <DxRibbonGroup Text='@LT("History")'>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-undo" Text='@LT("Undo")' Enabled="State.CanUndo" Click="State.Undo" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-redo" Text='@LT("Redo")' Enabled="State.CanRedo" Click="State.Redo" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text='@LT("Edit")'>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-copy" Text='@LT("Clipboard & layers")' DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-copy" Text='@LT("Copy")' Enabled="HasSelection" Click="State.CopySelected" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-paste" Text='@LT("Paste")' Enabled="State.CanPaste" Click="State.Paste" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-duplicate" Text='@LT("Duplicate")' Enabled="HasSelection" Click="State.DuplicateSelected" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-layers" Text='@LT("Move layer up")' Enabled="HasSelection" Click="MoveUp" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-layers" Text='@LT("Move layer down")' Enabled="HasSelection" Click="MoveDown" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text='@LT("Delete")' Enabled="CanDelete" Click="State.DeleteSelected" />
                        </DxRibbonItem>
                    </DxRibbonGroup>
                    <DxRibbonGroup Text='@LT("View")'>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-properties" Text='@LT("Canvas view")' DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-fit" Text='@LT("Fit canvas")' Click="FitCanvas" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-fit" Text='@LT("100%")' Click="Zoom100" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-grid" Text="@GridText" Click="ToggleGridRibbon" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-snap" Text="@SnapText" Click="ToggleSnapRibbon" />
                        </DxRibbonItem>
                    </DxRibbonGroup>
                </DxRibbonTab>
                <DxRibbonTab Text='@LT("Insert")'>
                    <DxRibbonGroup Text='@LT("Content")'>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-insert" Text='@LT("Add content")' IsPrimary="true" DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-picture" Text='@LT("Image")' Click="RequestImage" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-vector" Text='@LT("Layered SVG / OpenRaster")' Click="RequestLayeredImport" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-text" Text='@LT("Text")' Click="AddTextLayer" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-layers" Text='@LT("Paint layer")' Click="AddPaintLayer" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-color" Text='@LT("Solid fill")' Click="AddSolidFill" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-color" Text='@LT("Gradient fill")' Click="AddGradient" />
                        </DxRibbonItem>
                    </DxRibbonGroup>
                    <DxRibbonGroup Text='@LT("Shapes")'>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-shape" Text='@LT("Basic shapes")' DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-rectangle" Text='@LT("Rectangle")' Click="AddRectangle" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-ellipse" Text='@LT("Ellipse")' Click="AddEllipse" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-arrow" Text='@LT("Arrow")' Click="AddArrowShape" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-line" Text='@LT("Line")' Click="AddLineShape" />
                        </DxRibbonItem>
                    </DxRibbonGroup>
                    <DxRibbonGroup Text='@LT("Renderers")'>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Texture & light")' DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Clouds")' Click="AddClouds" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Noise")' Click="AddNoise" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Grain noise")' Click="AddGrainNoise" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Stripes")' Click="AddStripes" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Vignette")' Click="AddVignette" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Bloom")' Click="AddBloom" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Neon")' Click="AddNeon" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Lens flare")' Click="AddLensFlare" />
                        </DxRibbonItem>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-animation" Text='@LT("Motion & surfaces")' DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Motion blur")' Click="AddMotionBlur" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Wind")' Click="AddWind" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Ocean waves")' Click="AddOceanWaves" />
                        </DxRibbonItem>
                    </DxRibbonGroup>
                </DxRibbonTab>
                @if (CanUseLocalGptOcr)
                {
                    <DxRibbonTab Text='@LT("LocalGPT AI")'>
                        <DxRibbonGroup Text='@LT("Text recognition")' IconCssClass="pub-icon pub-icon-text">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-picture" Text='@LT("Recognize text")' IsPrimary="true" Enabled="@(!_ocrBusy && !IsPictureExporting)" Click="StartLocalGptOcrAsync" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-text" Text='@LT("Insert OCR text layer")' Enabled="HasOcrText" Click="InsertOcrTextLayer" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text='@LT("Clear OCR result")' Enabled="HasOcrText" Click="ClearOcrText" />
                        </DxRibbonGroup>
                    </DxRibbonTab>
                }
                <DxRibbonTab Text='@LT("Draw")'>
                    <DxRibbonGroup Text='@LT("Drawing")'>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-brush" Text='@LT("Drawing tools")' IsPrimary="true" DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-select" Text="@SelectToolText" Click="SelectTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-brush" Text="@BrushToolText" Click="BrushTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-pencil" Text="@PencilToolText" Click="PencilTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-spray" Text="@SprayToolText" Click="SprayTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-brush" Text="@ToothbrushToolText" Click="ToothbrushTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-rectangle" Text="@SquareToolText" Click="SquareTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-rectangle" Text="@RectangleToolText" Click="RectangleTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-ellipse" Text="@EllipseToolText" Click="EllipseTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-arrow" Text="@ArrowToolText" Click="ArrowTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-line" Text="@LineToolText" Click="LineTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-line" Text="@PathToolText" Click="PathTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-line" Text='@LT("Paint paths")' DropDownCssClass="publisher-ribbon-menu">
                                <DxRibbonItem IconCssClass="pub-icon pub-icon-brush" Text='@LT("Brush path")' Click="BrushPathTool" />
                                <DxRibbonItem IconCssClass="pub-icon pub-icon-pencil" Text='@LT("Pencil path")' Click="PencilPathTool" />
                                <DxRibbonItem IconCssClass="pub-icon pub-icon-spray" Text='@LT("Spray path")' Click="SprayPathTool" />
                                <DxRibbonItem IconCssClass="pub-icon pub-icon-brush" Text='@LT("Toothbrush path")' Click="ToothbrushPathTool" />
                                <DxRibbonItem IconCssClass="pub-icon pub-icon-eraser" Text='@LT("Eraser path")' Click="EraserPathTool" />
                            </DxRibbonItem>
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-eraser" Text="@EraserToolText" Click="EraserTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-eyedropper" Text="@EyedropperToolText" Click="EyedropperTool" />
                        </DxRibbonItem>
                    </DxRibbonGroup>
                    <DxRibbonGroup Text='@LT("Selection & fill")'>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-select" Text='@LT("Selection tools")' DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-select" Text="@RectangleSelectToolText" Click="RectangleSelectTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-select" Text="@EllipseSelectToolText" Click="EllipseSelectTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-select" Text="@FreeSelectToolText" Click="FreeSelectTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-select" Text="@MagneticSelectToolText" Click="MagneticSelectTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-line" Text="@PolygonSelectToolText" Click="PolygonSelectTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text='@LT("Clear selection")' Click="ClearAreaSelection" />
                        </DxRibbonItem>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-crop" Text='@LT("Area edit")' Enabled="HasSelection" DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-crop" Text='@LT("Keep selected area")' Click="KeepSelectedArea" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text='@LT("Cut selected area")' Click="CutSelectedArea" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-copy" Text='@LT("Copy selected area")' Click="CopySelectedArea" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-duplicate" Text='@LT("Copy area as new layer")' Click="CopySelectedAreaAsLayer" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text='@LT("Clear layer cut")' Enabled="HasLayerClip" Click="ClearLayerCut" />
                        </DxRibbonItem>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-color" Text='@LT("Area fill")' DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-gradient" Text="@FillSolidToolText" Click="FillSolidTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-gradient" Text="@FillGradientToolText" Click="FillGradientTool" />
                        </DxRibbonItem>
                    </DxRibbonGroup>
                    <DxRibbonGroup Text='@LT("Color")'>
                        <DxRibbonColorPaletteItem Text='@LT("Primary")' Value="@_drawColor" ValueChanged="ChangeDrawColor"><Groups><DxRibbonColorGroup Header="Drawing" Colors="@PictureColors" /></Groups></DxRibbonColorPaletteItem>
                        <DxRibbonColorPaletteItem Text='@LT("Secondary")' Value="@_drawSecondaryColor" ValueChanged="ChangeDrawSecondaryColor"><Groups><DxRibbonColorGroup Header="Drawing" Colors="@PictureColors" /></Groups></DxRibbonColorPaletteItem>
                    </DxRibbonGroup>
                    <DxRibbonGroup Text='@LT("Width")'>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-brush" Text='@LT("Brush width")' DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-brush" Text="@DrawWidthText(1)" Click="DrawWidth1" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-brush" Text="@DrawWidthText(3)" Click="DrawWidth3" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-brush" Text="@DrawWidthText(8)" Click="DrawWidth8" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-brush" Text="@DrawWidthText(16)" Click="DrawWidth16" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-brush" Text="@DrawWidthText(32)" Click="DrawWidth32" />
                        </DxRibbonItem>
                    </DxRibbonGroup>
                </DxRibbonTab>
                <DxRibbonTab Text='@LT("Output")'>
                    <DxRibbonGroup Text='@LT("Export")'>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-download" Text='@LT("Download")' DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-download" Text='@LT("Download merged PNG")' Click="DownloadPng" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-download" Text='@LT("Download merged JPEG")' Click="DownloadJpeg" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-download" Text='@LT("Download layered SVG")' Click="DownloadSvg" />
                        </DxRibbonItem>
                    </DxRibbonGroup>
                    <DxRibbonGroup Text='@LT("Publication")'>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-picture" Text="@(EditingExisting ? LT("Apply layered") : LT("Insert layered"))" Enabled="@(!IsPictureExporting)" IsPrimary="true" Click="ApplyLayered" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-picture" Text="@(EditingExisting ? LT("Apply merged") : LT("Insert merged"))" Enabled="@(!IsPictureExporting)" Click="ApplyMerged" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-command" Text='@LT("Cancel")' Click="Cancel" />
                    </DxRibbonGroup>
                </DxRibbonTab>
                <DxRibbonTab Text='@LT("Effects")'>
                    <DxRibbonGroup Text='@LT("Adjust")'>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-audio" Text='@LT("Tone")' DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-color" Text='@LT("Brighten")' Enabled="HasSelection" Click="Brighten" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-color" Text='@LT("Darken")' Enabled="HasSelection" Click="Darken" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-color" Text='@LT("More contrast")' Enabled="HasSelection" Click="MoreContrast" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-color" Text='@LT("More saturation")' Enabled="HasSelection" Click="MoreSaturation" />
                        </DxRibbonItem>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-color" Text='@LT("Soften")' DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-color" Text='@LT("Light soften")' Enabled="HasSelection" Click="SoftenLight" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-color" Text='@LT("Medium soften")' Enabled="HasSelection" Click="SoftenMedium" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text='@LT("Remove soften")' Enabled="HasSelection" Click="RemoveSoftening" />
                        </DxRibbonItem>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-color" Text='@LT("Color effects")' DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-properties" Text='@LT("Grayscale")' Enabled="HasSelection" Click="ToggleGrayscalePreset" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-properties" Text='@LT("Sepia")' Enabled="HasSelection" Click="ToggleSepiaPreset" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-properties" Text='@LT("Invert")' Enabled="HasSelection" Click="ToggleInvertPreset" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-properties" Text='@LT("Reset all")' Enabled="HasSelection" Click="ResetAdjustments" />
                        </DxRibbonItem>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Glow & flare")' DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-save" Text='@LT("Bloom glow")' Enabled="HasSelection" Click="ApplyBloomEffect" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-save" Text='@LT("Neon glow")' Enabled="HasSelection" Click="ApplyNeonEffect" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-save" Text='@LT("Lens flare")' Enabled="HasSelection" Click="ApplyLensFlareEffect" />
                        </DxRibbonItem>
                    </DxRibbonGroup>
                </DxRibbonTab>
                <DxRibbonTab Text='@LT("Render Tools")' Contextual="true" Visible="IsRenderSelected">
                    <DxRibbonGroup Text='@LT("Renderer")'>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Change renderer")' DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Clouds")' Click="MakeRenderClouds" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Noise")' Click="MakeRenderNoise" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Stripes")' Click="MakeRenderStripes" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Vignette")' Click="MakeRenderVignette" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Bloom")' Click="MakeRenderBloom" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Neon")' Click="MakeRenderNeon" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Lens flare")' Click="MakeRenderLensFlare" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Grain noise")' Click="MakeRenderGrainNoise" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Motion blur")' Click="MakeRenderMotionBlur" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Wind")' Click="MakeRenderWind" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("Ocean waves")' Click="MakeRenderOceanWaves" />
                        </DxRibbonItem>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-render" Text='@LT("New seed")' IsPrimary="true" Click="RandomizeRender" />
                    </DxRibbonGroup>
                </DxRibbonTab>
                <DxRibbonTab Text='@LT("Paint Tools")' Contextual="true" Visible="IsPaintSelected">
                    <DxRibbonGroup Text='@LT("Paint layer")'>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-brush" Text='@LT("Paint tool")' IsPrimary="true" DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-brush" Text='@LT("Brush")' Click="BrushTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-spray" Text='@LT("Spray can")' Click="SprayTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-brush" Text='@LT("Toothbrush")' Click="ToothbrushTool" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-eraser" Text='@LT("Eraser")' Click="EraserTool" />
                        </DxRibbonItem>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text='@LT("Clear strokes")' Enabled="CanDelete" Click="State.ClearSelectedPaint" />
                    </DxRibbonGroup>
                </DxRibbonTab>
                <DxRibbonTab Text='@LT("Picture Tools")' Contextual="true" Visible="IsRasterSelected">
                    <DxRibbonGroup Text='@LT("Raster")'>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text='@LT("Replace")' IsPrimary="true" Enabled="CanDelete" Click="RequestRasterReplacement" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-rotate" Text='@LT("Fit and flip")' DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text='@LT("Contain")' Enabled="CanDelete" Click="RasterContain" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text='@LT("Cover")' Enabled="CanDelete" Click="RasterCover" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text='@LT("Stretch")' Enabled="CanDelete" Click="RasterStretch" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text='@LT("Flip horizontal")' Enabled="CanDelete" Click="RasterFlipHorizontal" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text='@LT("Flip vertical")' Enabled="CanDelete" Click="RasterFlipVertical" />
                        </DxRibbonItem>
                    </DxRibbonGroup>
                </DxRibbonTab>
            </DxRibbon>

            <div class="picture-studio-workspace">
                <aside class="picture-studio-layers">
                    <div class="picture-pane-heading">
                        <strong>@LT("Layers")</strong>
                        <span>@State.Document.Layers.Count</span>
                    </div>
                    <div class="picture-layer-actions">
                        <button type="button" title='@LT("Add image")' aria-label='@LT("Add image")' @onclick="RequestImage"><i class="pub-icon pub-icon-picture" aria-hidden="true"></i></button>
                        <button type="button" title='@LT("Import layered SVG / SVGZ / OpenRaster")' aria-label='@LT("Import layered SVG / SVGZ / OpenRaster")' @onclick="RequestLayeredImport"><i class="pub-icon pub-icon-vector" aria-hidden="true"></i></button>
                        <button type="button" title='@LT("Add text")' aria-label='@LT("Add text")' @onclick="AddTextLayer"><i class="pub-icon pub-icon-text" aria-hidden="true"></i></button>
                        <button type="button" title='@LT("Add shape")' aria-label='@LT("Add shape")' @onclick="AddRectangle"><i class="pub-icon pub-icon-shape" aria-hidden="true"></i></button>
                        <button type="button" title='@LT("Add gradient")' aria-label='@LT("Add gradient")' @onclick="AddGradient"><i class="pub-icon pub-icon-gradient" aria-hidden="true"></i></button>
                        <button type="button" title='@LT("Add render layer")' aria-label='@LT("Add render layer")' @onclick="AddClouds"><i class="pub-icon pub-icon-effects" aria-hidden="true"></i></button>
                        <button type="button" title='@LT("Add paint layer")' aria-label='@LT("Add paint layer")' @onclick="AddPaintLayer"><i class="pub-icon pub-icon-edit" aria-hidden="true"></i></button>
                    </div>
                    <div class="picture-layer-list"
                         @oncontextmenu="ShowLayerListContextMenu"
                         @oncontextmenu:preventDefault>
                        @foreach (var layer in State.Document.Layers.AsEnumerable().Reverse())
                        {
                            <div class="picture-layer-row @(layer.Id == State.SelectedLayerId ? "selected" : null)"
                                 data-picture-layer-id="@layer.Id"
                                 draggable="true"
                                 @oncontextmenu="args => ShowLayerContextMenu(layer, args)"
                                 @oncontextmenu:preventDefault
                                 @oncontextmenu:stopPropagation>
                                <button type="button" class="picture-layer-select" @onclick="() => State.SelectLayer(layer.Id)">
                                    <span class="picture-layer-icon"><i class="@LayerIconCss(layer)" aria-hidden="true"></i></span>
                                    <span>
                                        <b>@layer.Name</b>
                                        <small>@LayerDescription(layer)</small>
                                    </span>
                                </button>
                                <button type="button" class="picture-layer-order" title='@LT("Move layer backward")' aria-label='@LT("Move layer backward")' @onclick="() => MoveLayerBackward(layer.Id)"><span aria-hidden="true">↓</span></button>
                                <button type="button" class="picture-layer-order" title='@LT("Move layer forward")' aria-label='@LT("Move layer forward")' @onclick="() => MoveLayerForward(layer.Id)"><span aria-hidden="true">↑</span></button>
                                <button type="button" class="picture-layer-toggle @(layer.Visible ? "active" : null)" title='@LT("Show or hide")' aria-label='@LT("Show or hide")' @onclick="() => State.ToggleVisibility(layer.Id)"><i class="pub-icon pub-icon-visible" aria-hidden="true"></i></button>
                                <button type="button" class="picture-layer-toggle @(layer.Locked ? "active" : null)" title='@LT("Lock or unlock")' aria-label='@LT("Lock or unlock")' @onclick="() => State.ToggleLock(layer.Id)"><i class="pub-icon pub-icon-lock" aria-hidden="true"></i></button>
                            </div>
                        }
                        @if (State.Document.Layers.Count == 0)
                        {
                            <div class="picture-empty-layers">
                                <strong>@LT("Transparent canvas")</strong>
                                <span>@LT("Add an image, text, shape, fill, paint, or procedural render layer.")</span>
                            </div>
                        }
                    </div>
                    <div class="picture-layer-footer">
                        <DxButton Text='@LT("Back")' Enabled="HasSelection" Click="State.SendSelectedToBack" />
                        <DxButton Text='@LT("Front")' Enabled="HasSelection" Click="State.BringSelectedToFront" />
                        <button type="button" class="picture-drag-merged" draggable="true" data-picture-drag-merged="true" title='@LT("Drag the merged Picture Studio result into another application")'>@LT("Drag merged")</button>
                    </div>
                </aside>

                <main id="picture-studio-canvas-host" class="picture-studio-canvas-host">
                    <div class="picture-canvas-scroll">
                        <div class="picture-canvas-mat">
                            <div id="picture-studio-canvas-surface" class="picture-canvas-surface">
                                <canvas id="picture-studio-canvas" class="picture-studio-canvas" tabindex="0" aria-label='@LT("Picture canvas")'
                                        @oncontextmenu="ShowCanvasContextMenu"
                                        @oncontextmenu:preventDefault
                                        @oncontextmenu:stopPropagation></canvas>
                                <div class="picture-studio-gesture-guide" aria-hidden="true">
                                    <span class="picture-gesture-cursor-ring"></span>
                                    <span class="picture-gesture-mode-label"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="picture-canvas-hint">@CanvasHint</div>
                </main>

                <aside class="picture-studio-properties">
                    <div class="picture-pane-heading picture-selection-heading @(State.SelectedLayer is null ? string.Empty : "has-selection")">
                        <span class="picture-selection-glyph"><i class="@(State.SelectedLayer is { } selectedHeadingLayer ? LayerIconCss(selectedHeadingLayer) : "pub-icon pub-icon-properties")" aria-hidden="true"></i></span>
                        <span class="picture-selection-copy">
                            <strong>@(State.SelectedLayer is null ? LT("Canvas properties") : LT("Selected layer"))</strong>
                            <small>@(State.SelectedLayer is { } selectedHeading ? $"{selectedHeading.Name} · {LayerDescription(selectedHeading)}" : $"{State.Document.WidthPx} × {State.Document.HeightPx} px")</small>
                        </span>
                    </div>
                    <div class="picture-property-scroll">
                        <section class="picture-property-section">
                            <h3>@LT("Canvas")</h3>
                            <label>@LT("Name")
                                <input value="@State.Document.Name" @onchange="ChangeDocumentName" /> </label>
                            <div class="picture-property-grid">
                                <label>@LT("Width (px)")
                                    <input type="number" min="16" max="8192" value="@State.Document.WidthPx" @onchange="ChangeCanvasWidth" /> </label>
                                <label>@LT("Height (px)")
                                    <input type="number" min="16" max="8192" value="@State.Document.HeightPx" @onchange="ChangeCanvasHeight" /> </label>
                            </div>
                            <label>@LT("Background")
                                <select value="@State.Document.Background" @onchange="ChangeBackgroundPreset">
                                    <option value="transparent">@LT("Transparent")</option>
                                    <option value="#ffffff">@LT("White")</option>
                                    <option value="#000000">@LT("Black")</option>
                                    <option value="#f1f5f9">@LT("Light gray")</option>
                                </select>
                            </label>
                            <label>@LT("Custom background")
                                <input type="color" value="@CanvasColor" @onchange="ChangeCanvasColor" /> </label>
                            <div class="picture-preset-buttons">
                                <button type="button" @onclick="PresetSquare">@LT("Square")</button>
                                <button type="button" @onclick="PresetLandscape">@LT("Landscape")</button>
                                <button type="button" @onclick="PresetFullHd">@LT("Full HD")</button>
                                <button type="button" @onclick="PresetA4">@LT("A4 300 DPI")</button>
                            </div>
                            <label>@LT("Grid spacing (px)")
                                <input type="number" min="2" max="1000" value="@State.Document.GridSpacingPx" @onchange="ChangeGridSpacing" /> </label>
                        </section>

                        <section class="picture-property-section picture-drawing-properties">
                            <h3>@LT("Drawing tools")</h3>
                            <label>@LT("Tool")
                                <select value="@_drawTool" @onchange="ChangeDrawTool">
                                    @foreach (var tool in Enum.GetValues<PictureDrawTool>())
                                    {
                                        <option value="@tool">@tool</option>
                                    }
                                </select>
                            </label>
                            <div class="picture-property-grid">
                                <label>@LT("Primary color")
                                    <input type="color" value="@SafeColor(_drawColor)" @onchange="ChangeDrawColorInput" /> </label>
                                <label>@LT("Secondary color")
                                    <input type="color" value="@SafeColor(_drawSecondaryColor)" @onchange="ChangeDrawSecondaryColorInput" /> </label>
                                <label>@LT("Exact width (px)")
                                    <input type="number" min="0.25" max="512" step="0.25" value="@Inv(_drawWidth)" @onchange="ChangeDrawWidth" /> </label>
                            </div>
                            <label class="picture-brush-size-label">@LT("Brush size")
                                <span class="picture-brush-size-row">
                                    <input class="picture-dynamic-range"
                                           type="range"
                                           min="0"
                                           max="100"
                                           step="0.1"
                                           value="@Inv(BrushWidthSliderValue)"
                                           style="@BrushWidthSliderStyle"
                                           aria-label='@LT("Brush size")'
                                           aria-valuemin="0.25"
                                           aria-valuemax="512"
                                           aria-valuenow="@Inv(_drawWidth)"
                                           @oninput="ChangeDrawWidthSlider" />
                                    <output>@DrawWidthDisplay</output>
                                </span>
                            </label>
                            <div class="picture-brush-presets" role="group" aria-label='@LT("Brush size presets")'>
                                <button type="button" class="@DrawWidthButtonClass(1)" aria-pressed="@(IsDrawWidth(1) ? "true" : "false")" @onclick="DrawWidth1">1</button>
                                <button type="button" class="@DrawWidthButtonClass(3)" aria-pressed="@(IsDrawWidth(3) ? "true" : "false")" @onclick="DrawWidth3">3</button>
                                <button type="button" class="@DrawWidthButtonClass(8)" aria-pressed="@(IsDrawWidth(8) ? "true" : "false")" @onclick="DrawWidth8">8</button>
                                <button type="button" class="@DrawWidthButtonClass(16)" aria-pressed="@(IsDrawWidth(16) ? "true" : "false")" @onclick="DrawWidth16">16</button>
                                <button type="button" class="@DrawWidthButtonClass(32)" aria-pressed="@(IsDrawWidth(32) ? "true" : "false")" @onclick="DrawWidth32">32</button>
                            </div>
                            <label>@LT("Opacity")
                                <input type="range" min="0" max="1" step="0.01" value="@Inv(_drawOpacity)" @oninput="ChangeDrawOpacity" />
                                <span class="picture-range-value">@Math.Round(_drawOpacity * 100)%</span>
                            </label>
                            <label>@LT("Brush hardness")
                                <input type="range" min="0" max="1" step="0.01" value="@Inv(_drawHardness)" @oninput="ChangeDrawHardness" />
                                <span class="picture-range-value">@Math.Round(_drawHardness * 100)%</span>
                            </label>
                            <DxButton Text='@LT("New paint layer")' Click="AddPaintLayer" CssClass="wide-button" />
                        </section>

                        @if (State.SelectedLayer is PictureLayer selected)
                        {
                            <section class="picture-property-section">
                                <h3>@LT("Layer")</h3>
                                <label>@LT("Name")
                                    <input value="@selected.Name" @onchange="ChangeLayerName" /> </label>
                                <div class="picture-property-grid">
                                    <label>@LT("X")
                                        <input type="number" step="1" value="@Inv(selected.X)" @onchange="ChangeLayerX" /> </label>
                                    <label>@LT("Y")
                                        <input type="number" step="1" value="@Inv(selected.Y)" @onchange="ChangeLayerY" /> </label>
                                    <label>@LT("Width")
                                        <input type="number" min="1" step="1" value="@Inv(selected.Width)" @onchange="ChangeLayerWidth" /> </label>
                                    <label>@LT("Height")
                                        <input type="number" min="1" step="1" value="@Inv(selected.Height)" @onchange="ChangeLayerHeight" /> </label>
                                </div>
                                <label>@LT("Rotation")
                                    <input type="range" min="0" max="359" step="1" value="@Inv(selected.Rotation)" @oninput="ChangeLayerRotation" @onchange="EndLiveEdit" />
                                    <span class="picture-range-value">@Math.Round(selected.Rotation)°</span>
                                </label>
                                <label>@LT("Opacity")
                                    <input type="range" min="0" max="1" step="0.01" value="@Inv(selected.Opacity)" @oninput="ChangeLayerOpacity" @onchange="EndLiveEdit" />
                                    <span class="picture-range-value">@Math.Round(selected.Opacity * 100)%</span>
                                </label>
                                <label>@LT("Blend mode")
                                    <select value="@selected.BlendMode" @onchange="ChangeBlendMode">
                                        @foreach (var mode in Enum.GetValues<PictureBlendMode>())
                                        {
                                            <option value="@mode">@mode</option>
                                        }
                                    </select>
                                </label>
                                <div class="picture-check-grid">
                                    <label><input type="checkbox" checked="@selected.Visible" @onchange="ToggleSelectedVisibility" /> @LT("Visible")</label>
                                    <label><input type="checkbox" checked="@selected.Locked" @onchange="ToggleSelectedLock" /> @LT("Locked")</label>
                                </div>
                            </section>

                            @switch (selected)
                            {
                                case SvgPictureLayer svgLayer:
                                    <section class="picture-property-section">
                                        <h3>@LT("Imported vector")</h3>
                                        <label>@LT("Source format")<input value="@svgLayer.SourceFormat" readonly /></label>
                                        @if (!string.IsNullOrWhiteSpace(svgLayer.GroupPath))
                                        {
                                            <label>@LT("Layer group")<input value="@svgLayer.GroupPath" readonly /></label>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(svgLayer.SourceElementId))
                                        {
                                            <label>@LT("Source element")<input value="@svgLayer.SourceElementId" readonly /></label>
                                        }
                                        <label class="check-row"><input type="checkbox" checked="@svgLayer.PreserveAspectRatio" @onchange="ToggleSvgPreserveAspectRatio" /> @LT("Preserve aspect ratio")</label>
                                        <p class="picture-property-note">@LT("This layer keeps its sanitized SVG paths, paint servers, transforms and clipping definitions as vector markup. Position, size, rotation, opacity and layer order remain editable in Picture Studio.")</p>
                                    </section>
                                    break;
                                case RasterPictureLayer raster:
                                    <section class="picture-property-section">
                                        <h3>@LT("Image")</h3>
                                        <label>@LT("Fit")
                                            <select value="@raster.FitMode" @onchange="ChangeRasterFit">
                                                @foreach (var fit in Enum.GetValues<PictureRasterFitMode>())
                                                {
                                                    <option value="@fit">@fit</option>
                                                }
                                            </select>
                                        </label>
                                        <div class="picture-check-grid">
                                            <label><input type="checkbox" checked="@raster.FlipHorizontal" @onchange="ToggleRasterFlipHorizontal" /> @LT("Flip horizontal")</label>
                                            <label><input type="checkbox" checked="@raster.FlipVertical" @onchange="ToggleRasterFlipVertical" /> @LT("Flip vertical")</label>
                                        </div>
                                        <label>@LT("Tint color")
                                            <input type="color" value="@SafeColor(raster.TintColor)" @onchange="ChangeRasterTintColor" /> </label>
                                        <label>@LT("Tint strength")
                                            <input type="range" min="0" max="1" step="0.01" value="@Inv(raster.TintOpacity)" @oninput="ChangeRasterTintOpacity" @onchange="EndLiveEdit" />
                                            <span class="picture-range-value">@Math.Round(raster.TintOpacity * 100)%</span>
                                        </label>
                                        <h4>@LT("Change colors")</h4>
                                        <label>@LT("Mode")
                                            <select value="@raster.ColorizeMode" @onchange="ChangeRasterColorizeMode">
                                                @foreach (var mode in Enum.GetValues<PictureRasterColorizeMode>())
                                                {
                                                    <option value="@mode">@mode</option>
                                                }
                                            </select>
                                        </label>
                                        @if (raster.ColorizeMode == PictureRasterColorizeMode.ReplaceColor)
                                        {
                                            <div class="picture-property-grid">
                                                <label>@LT("Replace color")<input type="color" value="@SafeColor(raster.ColorizeSourceColor)" @onchange="ChangeRasterColorizeSource" /></label>
                                                <label>@LT("With color")<input type="color" value="@SafeColor(raster.ColorizeTargetColor)" @onchange="ChangeRasterColorizeTarget" /></label>
                                            </div>
                                            <label>@LT("Match tolerance")
                                                <input type="range" min="0" max="255" step="1" value="@raster.ColorizeTolerance" @oninput="ChangeRasterColorizeTolerance" @onchange="EndLiveEdit" />
                                                <span class="picture-range-value">@raster.ColorizeTolerance</span>
                                            </label>
                                        }
                                        else if (raster.ColorizeMode == PictureRasterColorizeMode.Luminosity)
                                        {
                                            <label>@LT("Colorize with")<input type="color" value="@SafeColor(raster.ColorizeTargetColor)" @onchange="ChangeRasterColorizeTarget" /></label>
                                        }
                                        <label>@LT("Color-change strength")
                                            <input type="range" min="0" max="1" step="0.01" value="@Inv(raster.ColorizeStrength)" @oninput="ChangeRasterColorizeStrength" @onchange="EndLiveEdit" />
                                            <span class="picture-range-value">@Math.Round(raster.ColorizeStrength * 100)%</span>
                                        </label>
                                    </section>
                                    break;
                                case TextPictureLayer textLayer:
                                    <section class="picture-property-section">
                                        <h3>@LT("Text")</h3>
                                        <label>@LT("Content")
                                            <textarea rows="4" @onchange="ChangeTextContent">@textLayer.Text</textarea>
                                        </label>
                                        <label>@LT("Font")
                                            <SystemFontPicker Value="@textLayer.FontFamily" Changed="ChangeTextFont" /> </label>
                                        <div class="picture-property-grid">
                                            <label>@LT("Size")
                                                <input type="number" min="4" max="1024" value="@Inv(textLayer.FontSizePx)" @onchange="ChangeTextSize" /> </label>
                                            <label>@LT("Alignment")
                                                <select value="@textLayer.Alignment" @onchange="ChangeTextAlignment">
                                                    @foreach (var alignment in Enum.GetValues<PictureTextAlignment>())
                                                    {
                                                        <option value="@alignment">@alignment</option>
                                                    }
                                                </select>
                                            </label>
                                        </div>
                                        <div class="picture-check-grid">
                                            <label><input type="checkbox" checked="@textLayer.Bold" @onchange="ToggleTextBold" /> @LT("Bold")</label>
                                            <label><input type="checkbox" checked="@textLayer.Italic" @onchange="ToggleTextItalic" /> @LT("Italic")</label>
                                            <label><input type="checkbox" checked="@textLayer.ShadowEnabled" @onchange="ToggleTextShadow" /> @LT("Shadow")</label>
                                        </div>
                                        <div class="picture-property-grid">
                                            <label>@LT("Fill")
                                                <input type="color" value="@SafeColor(textLayer.FillColor)" @onchange="ChangeTextFill" /> </label>
                                            <label>@LT("Outline")
                                                <input type="color" value="@SafeColor(textLayer.OutlineColor)" @onchange="ChangeTextOutline" /> </label>
                                            <label>@LT("Outline width")
                                                <input type="number" min="0" max="64" step="1" value="@Inv(textLayer.OutlineWidthPx)" @onchange="ChangeTextOutlineWidth" /> </label>
                                            <label>@LT("Shadow blur")
                                                <input type="number" min="0" max="200" step="1" value="@Inv(textLayer.ShadowBlurPx)" @onchange="ChangeTextShadowBlur" /> </label>
                                        </div>
                                    </section>
                                    break;
                                case ShapePictureLayer shapeLayer:
                                    <section class="picture-property-section">
                                        <h3>@LT("Shape")</h3>
                                        <label>@LT("Shape")
                                            <select value="@shapeLayer.Shape" @onchange="ChangeShapeKind">
                                                @foreach (var shape in Enum.GetValues<PictureShapeKind>())
                                                {
                                                    <option value="@shape">@shape</option>
                                                }
                                            </select>
                                        </label>
                                        <label>@LT("Fill type")
                                            <select value="@shapeLayer.FillKind" @onchange="ChangeShapeFillKind">
                                                @foreach (var fillKind in Enum.GetValues<PictureFillKind>())
                                                {
                                                    <option value="@fillKind">@fillKind</option>
                                                }
                                            </select>
                                        </label>
                                        <div class="picture-property-grid">
                                            <label>@LT("Fill 1")
                                                <input type="color" value="@SafeColor(shapeLayer.FillColor)" @onchange="ChangeShapeFill" /> </label>
                                            <label>@LT("Fill 2")
                                                <input type="color" value="@SafeColor(shapeLayer.SecondaryFillColor)" @onchange="ChangeShapeSecondaryFill" /> </label>
                                            <label>@LT("Stroke")
                                                <input type="color" value="@SafeColor(shapeLayer.StrokeColor)" @onchange="ChangeShapeStroke" /> </label>
                                            <label>@LT("Stroke width")
                                                <input type="number" min="0" max="200" value="@Inv(shapeLayer.StrokeWidthPx)" @onchange="ChangeShapeStrokeWidth" /> </label>
                                            <label>@LT("Corner radius")
                                                <input type="number" min="0" max="2000" value="@Inv(shapeLayer.CornerRadiusPx)" @onchange="ChangeShapeRadius" /> </label>
                                        </div>
                                        @if (shapeLayer.Shape is PictureShapeKind.Path or PictureShapeKind.Freeform)
                                        {
                                            <div class="picture-check-grid">
                                                <label><input type="checkbox" checked="@shapeLayer.PathClosed" @onchange="ToggleShapePathClosed" /> @LT("Close path")</label>
                                                <label><input type="checkbox" checked="@shapeLayer.PathSmooth" @onchange="ToggleShapePathSmooth" /> @LT("Smooth path")</label>
                                            </div>
                                            <div class="picture-path-toolbar">
                                                <button type="button" @onclick="AddShapePathPoint">@LT("Add point")</button>
                                                <button type="button" @onclick="ReverseShapePath">@LT("Reverse")</button>
                                            </div>
                                            <div class="picture-path-points" aria-label='@LT("Path points")'>
                                                @for (var pointIndex = 0; pointIndex < shapeLayer.PathPoints.Count; pointIndex++)
                                                {
                                                    var index = pointIndex;
                                                    var point = shapeLayer.PathPoints[index];
                                                    <div class="picture-path-point-row">
                                                        <span>@(index + 1)</span>
                                                        <label>@LT("X")<input type="number" step=".1" value="@Inv(point.X)" @onchange="args => ChangeShapePathPointX(index, args)" /></label>
                                                        <label>@LT("Y")<input type="number" step=".1" value="@Inv(point.Y)" @onchange="args => ChangeShapePathPointY(index, args)" /></label>
                                                        <button type="button" class="danger" disabled="@(shapeLayer.PathPoints.Count <= 2)" @onclick="() => RemoveShapePathPoint(index)" title='@LT("Remove point")'>×</button>
                                                    </div>
                                                }
                                            </div>
                                            <p class="picture-property-note">@LT("The Path tool creates editable vector points. Edit X/Y for precise nodes, reverse the direction, or add/remove points. Open paths use the stroke only; closed paths can also use the selected fill.")</p>
                                        }
                                        @if (shapeLayer.FillKind != PictureFillKind.Solid)
                                        {
                                            <label>@LT("Fill angle")
                                                <input type="range" min="0" max="360" step="1" value="@Inv(shapeLayer.FillAngleDegrees)" @oninput="ChangeShapeFillAngle" @onchange="EndLiveEdit" />
                                                <span class="picture-range-value">@Math.Round(shapeLayer.FillAngleDegrees)°</span>
                                            </label>
                                        }
                                    </section>
                                    break;
                                case FillPictureLayer fillLayer:
                                    <section class="picture-property-section">
                                        <h3>@LT("Fill")</h3>
                                        <label>@LT("Type")
                                            <select value="@fillLayer.FillKind" @onchange="ChangeFillKind">
                                                @foreach (var kind in Enum.GetValues<PictureFillKind>())
                                                {
                                                    <option value="@kind">@kind</option>
                                                }
                                            </select>
                                        </label>
                                        <div class="picture-property-grid">
                                            <label>@LT("Color 1")
                                                <input type="color" value="@SafeColor(fillLayer.PrimaryColor)" @onchange="ChangeFillPrimary" /> </label>
                                            <label>@LT("Color 2")
                                                <input type="color" value="@SafeColor(fillLayer.SecondaryColor)" @onchange="ChangeFillSecondary" /> </label>
                                        </div>
                                        <label>@LT("Angle")
                                            <input type="range" min="0" max="360" step="1" value="@Inv(fillLayer.AngleDegrees)" @oninput="ChangeFillAngle" @onchange="EndLiveEdit" />
                                            <span class="picture-range-value">@Math.Round(fillLayer.AngleDegrees)°</span>
                                        </label>
                                    </section>
                                    break;
                                case PaintPictureLayer paintLayer:
                                    <section class="picture-property-section">
                                        <h3>@LT("Paint")</h3>
                                        <p class="picture-property-note">@LT("Brush, pencil, line and eraser strokes stay editable as a separate layer.")</p>
                                        <div class="picture-paint-summary">
                                            <strong>@paintLayer.Strokes.Count</strong>
                                            <span>@LT("stored strokes")</span>
                                        </div>
                                        <DxButton Text='@LT("Continue with brush")' Click="BrushTool" CssClass="wide-button" />
                                        <DxButton Text='@LT("Clear all strokes")' Enabled="@(paintLayer.Strokes.Count > 0 && !paintLayer.Locked)" Click="State.ClearSelectedPaint" CssClass="wide-button" />
                                    </section>
                                    break;
                                case RenderPictureLayer renderLayer:
                                    <section id="picture-render-properties" class="picture-property-section picture-selected-property-section">
                                        <h3><span class="pub-icon pub-icon-render"></span> @LT("Procedural render") · @renderLayer.Name</h3>
                                        <label>@LT("Renderer")
                                            <select value="@renderLayer.RenderKind" @onchange="ChangeRenderKind">
                                                @foreach (var kind in Enum.GetValues<PictureRenderKind>())
                                                {
                                                    <option value="@kind">@kind</option>
                                                }
                                            </select>
                                        </label>
                                        <div class="picture-property-grid">
                                            <label>@LT("Color 1")
                                                <input type="color" value="@SafeColor(renderLayer.PrimaryColor)" @onchange="ChangeRenderPrimary" /> </label>
                                            <label>@LT("Color 2")
                                                <input type="color" value="@SafeColor(renderLayer.SecondaryColor)" @onchange="ChangeRenderSecondary" /> </label>
                                            <label>@LT("Seed")
                                                <input type="number" value="@renderLayer.Seed" @onchange="ChangeRenderSeed" /> </label>
                                            <label>@LT("Scale")
                                                <input type="number" min="4" max="2000" value="@Inv(renderLayer.Scale)" @onchange="ChangeRenderScale" /> </label>
                                            <label>@LT("Detail")
                                                <input type="number" min="1" max="8" value="@renderLayer.Detail" @onchange="ChangeRenderDetail" /> </label>
                                            <label>@LT("Softness")
                                                <input type="number" min="0" max="1" step="0.05" value="@Inv(renderLayer.Softness)" @onchange="ChangeRenderSoftness" /> </label>
                                            <label>@LT("Contrast")
                                                <input type="number" min="0.1" max="5" step="0.1" value="@Inv(renderLayer.RenderContrast)" @onchange="ChangeRenderContrast" /> </label>
                                            <label>@LT("Stripe width")
                                                <input type="number" min="1" max="1000" value="@Inv(renderLayer.StripeWidthPx)" @onchange="ChangeRenderStripeWidth" /> </label>
                                        </div>
                                        <label>@LT("Angle")
                                            <input type="range" min="0" max="360" step="1" value="@Inv(renderLayer.AngleDegrees)" @oninput="ChangeRenderAngle" @onchange="EndLiveEdit" />
                                            <span class="picture-range-value">@Math.Round(renderLayer.AngleDegrees)°</span>
                                        </label>
                                        <DxButton Text='@LT("New random seed")' Click="RandomizeRender" CssClass="wide-button" />
                                    </section>
                                    break;
                            }

                            <section class="picture-property-section">
                                <h3>@LT("Area cut")</h3>
                                <p class="property-note">@LT("Selections use document coordinates, so rectangular, elliptical, freehand, magnetic, and arbitrary polygon cuts stay aligned at every layer angle and canvas size.")</p>
                                <div class="property-action-row">
                                    <DxButton Text='@LT("Keep selected")' Enabled="@(!selected.Locked)" Click="KeepSelectedArea" />
                                    <DxButton Text='@LT("Cut selected")' Enabled="@(!selected.Locked)" Click="CutSelectedArea" />
                                </div>
                                <div class="property-action-row">
                                    <DxButton Text='@LT("Copy region")' Click="CopySelectedArea" />
                                    <DxButton Text='@LT("Copy as layer")' Click="CopySelectedAreaAsLayer" />
                                    <DxButton Text='@LT("Clear cut")' Enabled="@(selected.ClipPolygon.Count >= 3 && !selected.Locked)" Click="ClearLayerCut" />
                                </div>
                                @if (selected.ClipPolygon.Count >= 3)
                                {
                                    <p class="property-note"><b>@(selected.ClipInverted ? "Cut-out" : "Keep") polygon:</b> @selected.ClipPolygon.Count vertices.</p>
                                }
                            </section>

                            <section class="picture-property-section">
                                <h3>@LT("Adjustments")</h3>
                                <label>@LT("Brightness")
                                    <input type="range" min="0" max="2" step="0.01" value="@Inv(selected.Brightness)" @oninput="ChangeBrightness" @onchange="EndLiveEdit" />
                                    <span class="picture-range-value">@Math.Round(selected.Brightness * 100)%</span>
                                </label>
                                <label>@LT("Contrast")
                                    <input type="range" min="0" max="2" step="0.01" value="@Inv(selected.Contrast)" @oninput="ChangeContrast" @onchange="EndLiveEdit" />
                                    <span class="picture-range-value">@Math.Round(selected.Contrast * 100)%</span>
                                </label>
                                <label>@LT("Saturation")
                                    <input type="range" min="0" max="2" step="0.01" value="@Inv(selected.Saturation)" @oninput="ChangeSaturation" @onchange="EndLiveEdit" />
                                    <span class="picture-range-value">@Math.Round(selected.Saturation * 100)%</span>
                                </label>
                                <label>@LT("Hue")
                                    <input type="range" min="-180" max="180" step="1" value="@Inv(selected.HueRotation)" @oninput="ChangeHue" @onchange="EndLiveEdit" />
                                    <span class="picture-range-value">@Math.Round(selected.HueRotation)°</span>
                                </label>
                                <label>@LT("Soften / blur")
                                    <input type="range" min="0" max="50" step="0.25" value="@Inv(selected.Blur)" @oninput="ChangeBlur" @onchange="EndLiveEdit" />
                                    <span class="picture-range-value">@selected.Blur.ToString("0.##", CultureInfo.InvariantCulture) px</span>
                                </label>
                                <div class="picture-property-grid">
                                    <label>@LT("Grayscale")
                                        <input type="range" min="0" max="1" step="0.01" value="@Inv(selected.Grayscale)" @oninput="ChangeGrayscale" @onchange="EndLiveEdit" /> </label>
                                    <label>@LT("Sepia")
                                        <input type="range" min="0" max="1" step="0.01" value="@Inv(selected.Sepia)" @oninput="ChangeSepia" @onchange="EndLiveEdit" /> </label>
                                    <label>@LT("Invert")
                                        <input type="range" min="0" max="1" step="0.01" value="@Inv(selected.Invert)" @oninput="ChangeInvert" @onchange="EndLiveEdit" /> </label>
                                </div>
                                <DxButton Text='@LT("Reset adjustments")' Click="ResetAdjustments" CssClass="wide-button" />
                            </section>
                        }
                    </div>
                </aside>
            </div>

            @if (!string.IsNullOrWhiteSpace(_ocrStatus) || HasOcrText)
            {
                <section class="picture-ocr-review" aria-live="polite">
                    <header><strong>@LT("LocalGPT OCR")</strong><span>@_ocrStatus</span></header>
                    @if (HasOcrText)
                    {
                        <textarea rows="6" @bind="_ocrText" @bind:event="oninput" aria-label='@LT("Recognized text review")'></textarea>
                        <div>
                            <button type="button" class="primary-button" @onclick="InsertOcrTextLayer">@LT("Insert as editable text layer")</button>
                            <button type="button" @onclick="ClearOcrText">@LT("Clear")</button>
                        </div>
                    }
                </section>
            }

            <footer class="picture-studio-footer">
                <div>
                    <span>@StatusText</span>
                    <label>@LT("Zoom")
                        <input type="range" min="0.05" max="2" step="0.05" value="@Inv(State.Document.Zoom)" @oninput="ChangeZoom" />
                        <b>@Math.Round(State.Document.Zoom * 100)%</b>
                    </label>
                </div>
                <div>
                    <DxButton Text='@LT("Cancel")' Click="Cancel" />
                    <DxButton Text="@(IsPictureExporting ? LT("Rendering…") : EditingExisting ? LT("Apply layered") : LT("Insert layered"))" Enabled="@(!IsPictureExporting)" RenderStyle="ButtonRenderStyle.Primary" Click="ApplyLayered" />
                    <DxButton Text="@(EditingExisting ? LT("Apply merged") : LT("Insert merged"))" Enabled="@(!IsPictureExporting)" Click="ApplyMerged" />
                </div>
            </footer>
        </section>
    </div>

    <DxContextMenu @ref="_pictureContextMenu">
        <Items>
            <DxContextMenuItem Text='@LT("Undo")' IconCssClass="pub-icon pub-icon-undo" Enabled="State.CanUndo" Click="State.Undo" />
            <DxContextMenuItem Text='@LT("Redo")' IconCssClass="pub-icon pub-icon-redo" Enabled="State.CanRedo" Click="State.Redo" />

            @if (State.SelectedLayer is PictureLayer selectedLayer)
