                            }
                            @foreach (var font in PictureFonts)
                            {
                                <DxContextMenuItem Text="@(CheckedText(string.Equals(pictureText.FontFamily, font, StringComparison.OrdinalIgnoreCase), font))" Click="() => SetPictureTextFont(font)" />
                            }
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text="@PictureTextFontSizeMenuText(pictureText)">
                        <Items>
                            <DxContextMenuItem Text='@LT("24 px")' Click="TextSize24" />
                            <DxContextMenuItem Text='@LT("48 px")' Click="TextSize48" />
                            <DxContextMenuItem Text='@LT("72 px")' Click="TextSize72" />
                            <DxContextMenuItem Text='@LT("120 px")' Click="TextSize120" />
                            <DxContextMenuItem Text='@LT("180 px")' Click="TextSize180" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text="@(CheckedText(pictureText.Bold, "Bold"))" Click="TogglePictureTextBold" />
                    <DxContextMenuItem Text="@(CheckedText(pictureText.Italic, "Italic"))" Click="TogglePictureTextItalic" />
                    <DxContextMenuItem Text="@(CheckedText(pictureText.ShadowEnabled, "Shadow"))" Click="TogglePictureTextShadow" />
                    <DxContextMenuItem Text='@LT("Alignment")'>
                        <Items>
                            <DxContextMenuItem Text="@(CheckedText(pictureText.Alignment == PictureTextAlignment.Left, "Left"))" Click="TextAlignLeft" />
                            <DxContextMenuItem Text="@(CheckedText(pictureText.Alignment == PictureTextAlignment.Center, "Center"))" Click="TextAlignCenter" />
                            <DxContextMenuItem Text="@(CheckedText(pictureText.Alignment == PictureTextAlignment.Right, "Right"))" Click="TextAlignRight" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text='@LT("Text color")'>
                        <Items>
                            <DxContextMenuItem Text='@LT("Dark blue")' Click="TextColorBlue" />
                            <DxContextMenuItem Text='@LT("Black")' Click="TextColorBlack" />
                            <DxContextMenuItem Text='@LT("White")' Click="TextColorWhite" />
                            <DxContextMenuItem Text='@LT("Red")' Click="TextColorRed" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text='@LT("Outline")'>
                        <Items>
                            <DxContextMenuItem Text='@LT("No outline")' Click="TextOutlineNone" />
                            <DxContextMenuItem Text='@LT("Thin dark outline")' Click="TextOutlineThin" />
                            <DxContextMenuItem Text='@LT("Thick white outline")' Click="TextOutlineThick" />
                        </Items>
                    </DxContextMenuItem>
                }
                else if (selectedLayer is PaintPictureLayer paint)
                {
                    <DxContextMenuItem Text='@LT("Continue with brush")' IconCssClass="pub-icon pub-icon-edit" BeginGroup="true" Click="BrushTool" />
                    <DxContextMenuItem Text='@LT("Continue with pencil")' Click="PencilTool" />
                    <DxContextMenuItem Text='@LT("Continue with spray can")' Click="SprayTool" />
                    <DxContextMenuItem Text='@LT("Continue with toothbrush")' Click="ToothbrushTool" />
                    <DxContextMenuItem Text='@LT("Paint along path")'>
                        <Items>
                            <DxContextMenuItem Text='@LT("Brush path")' Click="BrushPathTool" />
                            <DxContextMenuItem Text='@LT("Pencil path")' Click="PencilPathTool" />
                            <DxContextMenuItem Text='@LT("Spray path")' Click="SprayPathTool" />
                            <DxContextMenuItem Text='@LT("Toothbrush path")' Click="ToothbrushPathTool" />
                            <DxContextMenuItem Text='@LT("Eraser path")' Click="EraserPathTool" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text='@LT("Erase strokes")' Click="EraserTool" />
                    <DxContextMenuItem Text='@LT("Clear all strokes")' Enabled="@(paint.Strokes.Count > 0 && !paint.Locked)" Click="State.ClearSelectedPaint" />
                }
                else if (selectedLayer is RenderPictureLayer render)
                {
                    <DxContextMenuItem Text='@LT("Renderer")' BeginGroup="true">
                        <Items>
                            <DxContextMenuItem Text="@(CheckedText(render.RenderKind == PictureRenderKind.Clouds, "Clouds"))" Click="MakeRenderClouds" />
                            <DxContextMenuItem Text="@(CheckedText(render.RenderKind == PictureRenderKind.Noise, "Noise"))" Click="MakeRenderNoise" />
                            <DxContextMenuItem Text="@(CheckedText(render.RenderKind == PictureRenderKind.Stripes, "Stripes"))" Click="MakeRenderStripes" />
                            <DxContextMenuItem Text="@(CheckedText(render.RenderKind == PictureRenderKind.Vignette, "Vignette"))" Click="MakeRenderVignette" />
                            <DxContextMenuItem Text="@(CheckedText(render.RenderKind == PictureRenderKind.Bloom, "Bloom"))" Click="MakeRenderBloom" />
                            <DxContextMenuItem Text="@(CheckedText(render.RenderKind == PictureRenderKind.Neon, "Neon"))" Click="MakeRenderNeon" />
                            <DxContextMenuItem Text="@(CheckedText(render.RenderKind == PictureRenderKind.LensFlare, "Lens flare"))" Click="MakeRenderLensFlare" />
                            <DxContextMenuItem Text="@(CheckedText(render.RenderKind == PictureRenderKind.GrainNoise, "Grain noise"))" Click="MakeRenderGrainNoise" />
                            <DxContextMenuItem Text="@(CheckedText(render.RenderKind == PictureRenderKind.MotionBlur, "Motion blur"))" Click="MakeRenderMotionBlur" />
                            <DxContextMenuItem Text="@(CheckedText(render.RenderKind == PictureRenderKind.Wind, "Wind"))" Click="MakeRenderWind" />
                            <DxContextMenuItem Text="@(CheckedText(render.RenderKind == PictureRenderKind.OceanWaves, "Ocean waves"))" Click="MakeRenderOceanWaves" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text='@LT("Edit all renderer properties…")' IconCssClass="pub-icon pub-icon-properties" Click="FocusRenderProperties" />
                    <DxContextMenuItem Text='@LT("Colors")'>
                        <Items>
                            <DxContextMenuItem Text='@LT("Primary: white")' Click="RenderPrimaryWhite" />
                            <DxContextMenuItem Text='@LT("Primary: black")' Click="RenderPrimaryBlack" />
                            <DxContextMenuItem Text='@LT("Primary: blue")' Click="RenderPrimaryBlue" />
                            <DxContextMenuItem Text='@LT("Secondary: white")' BeginGroup="true" Click="RenderSecondaryWhite" />
                            <DxContextMenuItem Text='@LT("Secondary: black")' Click="RenderSecondaryBlack" />
                            <DxContextMenuItem Text='@LT("Secondary: blue")' Click="RenderSecondaryBlue" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text="@RenderScaleMenuText(render)">
                        <Items>
                            <DxContextMenuItem Text="@(CheckedText(Math.Abs(render.Scale - 24) < .01, "24 px"))" Click="RenderScale24" />
                            <DxContextMenuItem Text="@(CheckedText(Math.Abs(render.Scale - 64) < .01, "64 px"))" Click="RenderScale64" />
                            <DxContextMenuItem Text="@(CheckedText(Math.Abs(render.Scale - 128) < .01, "128 px"))" Click="RenderScale128" />
                            <DxContextMenuItem Text="@(CheckedText(Math.Abs(render.Scale - 256) < .01, "256 px"))" Click="RenderScale256" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text="@RenderDetailMenuText(render)">
                        <Items>
                            <DxContextMenuItem Text="@(CheckedText(render.Detail == 1, "1 · Fast"))" Click="RenderDetail1" />
                            <DxContextMenuItem Text="@(CheckedText(render.Detail == 2, "2"))" Click="RenderDetail2" />
                            <DxContextMenuItem Text="@(CheckedText(render.Detail == 4, "4 · Balanced"))" Click="RenderDetail4" />
                            <DxContextMenuItem Text="@(CheckedText(render.Detail == 6, "6"))" Click="RenderDetail6" />
                            <DxContextMenuItem Text="@(CheckedText(render.Detail == 8, "8 · Fine"))" Click="RenderDetail8" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text="@RenderSoftnessMenuText(render)">
                        <Items>
                            <DxContextMenuItem Text="@(CheckedText(Math.Abs(render.Softness) < .01, "0%"))" Click="RenderSoftness0" />
                            <DxContextMenuItem Text="@(CheckedText(Math.Abs(render.Softness - .25) < .01, "25%"))" Click="RenderSoftness25" />
                            <DxContextMenuItem Text="@(CheckedText(Math.Abs(render.Softness - .5) < .01, "50%"))" Click="RenderSoftness50" />
                            <DxContextMenuItem Text="@(CheckedText(Math.Abs(render.Softness - .75) < .01, "75%"))" Click="RenderSoftness75" />
                            <DxContextMenuItem Text="@(CheckedText(Math.Abs(render.Softness - 1) < .01, "100%"))" Click="RenderSoftness100" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text="@RenderContrastMenuText(render)">
                        <Items>
                            <DxContextMenuItem Text='@LT("0.5×")' Click="RenderContrast05" />
                            <DxContextMenuItem Text='@LT("1.0×")' Click="RenderContrast10" />
                            <DxContextMenuItem Text='@LT("1.5×")' Click="RenderContrast15" />
                            <DxContextMenuItem Text='@LT("2.0×")' Click="RenderContrast20" />
                            <DxContextMenuItem Text='@LT("3.0×")' Click="RenderContrast30" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text="@RenderAngleMenuText(render)">
                        <Items>
                            <DxContextMenuItem Text='@LT("0°")' Click="RenderAngle0" />
                            <DxContextMenuItem Text='@LT("45°")' Click="RenderAngle45" />
                            <DxContextMenuItem Text='@LT("90°")' Click="RenderAngle90" />
                            <DxContextMenuItem Text='@LT("180°")' Click="RenderAngle180" />
                            <DxContextMenuItem Text='@LT("270°")' Click="RenderAngle270" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text="@RenderStripeWidthMenuText(render)" Enabled="@(render.RenderKind == PictureRenderKind.Stripes)">
                        <Items>
                            <DxContextMenuItem Text='@LT("8 px")' Click="RenderStripe8" />
                            <DxContextMenuItem Text='@LT("16 px")' Click="RenderStripe16" />
                            <DxContextMenuItem Text='@LT("32 px")' Click="RenderStripe32" />
                            <DxContextMenuItem Text='@LT("64 px")' Click="RenderStripe64" />
                            <DxContextMenuItem Text='@LT("128 px")' Click="RenderStripe128" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text='@LT("New random seed")' IconCssClass="pub-icon pub-icon-random" Click="RandomizeRender" />
                    <DxContextMenuItem Text='@LT("Reset renderer settings")' Click="ResetRenderSettings" />
                }
                else if (selectedLayer is ShapePictureLayer shape)
                {
                    <DxContextMenuItem Text='@LT("Shape")' BeginGroup="true">
                        <Items>
                            <DxContextMenuItem Text="@(CheckedText(shape.Shape == PictureShapeKind.Rectangle, "Rectangle"))" Click="ShapeRectangle" />
                            <DxContextMenuItem Text="@(CheckedText(shape.Shape == PictureShapeKind.RoundedRectangle, "Rounded rectangle"))" Click="ShapeRoundedRectangle" />
                            <DxContextMenuItem Text="@(CheckedText(shape.Shape == PictureShapeKind.Ellipse, "Ellipse"))" Click="ShapeEllipse" />
                            <DxContextMenuItem Text="@(CheckedText(shape.Shape == PictureShapeKind.Arrow, "Arrow"))" Click="ShapeArrow" />
                            <DxContextMenuItem Text="@(CheckedText(shape.Shape == PictureShapeKind.Line, "Line"))" Click="ShapeLine" />
                            <DxContextMenuItem Text="@(CheckedText(shape.Shape == PictureShapeKind.Path, "Path"))" Click="ShapePath" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text='@LT("Fill type")'>
                        <Items>
                            <DxContextMenuItem Text="@(CheckedText(shape.FillKind == PictureFillKind.Solid, "Solid"))" Click="ShapeFillSolid" />
                            <DxContextMenuItem Text="@(CheckedText(shape.FillKind == PictureFillKind.LinearGradient, "Linear gradient"))" Click="ShapeFillLinear" />
                            <DxContextMenuItem Text="@(CheckedText(shape.FillKind == PictureFillKind.RadialGradient, "Radial gradient"))" Click="ShapeFillRadial" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text='@LT("Fill colors")'>
                        <Items>
                            <DxContextMenuItem Text='@LT("Blue")' Click="ShapeColorsBlue" />
                            <DxContextMenuItem Text='@LT("Green")' Click="ShapeColorsGreen" />
                            <DxContextMenuItem Text='@LT("Orange")' Click="ShapeColorsOrange" />
                            <DxContextMenuItem Text='@LT("Black / white")' Click="ShapeColorsMono" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text='@LT("Stroke width")'>
                        <Items>
                            <DxContextMenuItem Text='@LT("None")' Click="ShapeStroke0" />
                            <DxContextMenuItem Text='@LT("1 px")' Click="ShapeStroke1" />
                            <DxContextMenuItem Text='@LT("3 px")' Click="ShapeStroke3" />
                            <DxContextMenuItem Text='@LT("8 px")' Click="ShapeStroke8" />
                        </Items>
                    </DxContextMenuItem>
                }
                else if (selectedLayer is FillPictureLayer fill)
                {
                    <DxContextMenuItem Text='@LT("Fill type")' BeginGroup="true">
                        <Items>
                            <DxContextMenuItem Text="@(CheckedText(fill.FillKind == PictureFillKind.Solid, "Solid"))" Click="FillSolid" />
                            <DxContextMenuItem Text="@(CheckedText(fill.FillKind == PictureFillKind.LinearGradient, "Linear gradient"))" Click="FillLinearGradient" />
                            <DxContextMenuItem Text="@(CheckedText(fill.FillKind == PictureFillKind.RadialGradient, "Radial gradient"))" Click="FillRadialGradient" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text='@LT("Color preset")'>
                        <Items>
                            <DxContextMenuItem Text='@LT("Blue")' Click="FillColorsBlue" />
                            <DxContextMenuItem Text='@LT("Green")' Click="FillColorsGreen" />
                            <DxContextMenuItem Text='@LT("Sunset")' Click="FillColorsSunset" />
                            <DxContextMenuItem Text='@LT("Black / white")' Click="FillColorsMono" />
                        </Items>
                    </DxContextMenuItem>
                    <DxContextMenuItem Text='@LT("Angle")'>
                        <Items>
                            <DxContextMenuItem Text='@LT("0°")' Click="FillAngle0" />
                            <DxContextMenuItem Text='@LT("45°")' Click="FillAngle45" />
                            <DxContextMenuItem Text='@LT("90°")' Click="FillAngle90" />
                            <DxContextMenuItem Text='@LT("180°")' Click="FillAngle180" />
                            <DxContextMenuItem Text='@LT("270°")' Click="FillAngle270" />
                        </Items>
                    </DxContextMenuItem>
                }

                <DxContextMenuItem Text='@LT("Area selection")' IconCssClass="pub-icon pub-icon-crop" BeginGroup="true">
                    <Items>
                        <DxContextMenuItem Text='@LT("Polygon selection mode")' Click="PolygonSelectTool" />
                        <DxContextMenuItem Text='@LT("Keep selected area")' Enabled="@(!selectedLayer.Locked)" Click="KeepSelectedArea" />
                        <DxContextMenuItem Text='@LT("Cut selected area")' Enabled="@(!selectedLayer.Locked)" Click="CutSelectedArea" />
                        <DxContextMenuItem Text='@LT("Copy selected area")' Click="CopySelectedArea" />
                        <DxContextMenuItem Text='@LT("Copy selected area as layer")' Click="CopySelectedAreaAsLayer" />
                        <DxContextMenuItem Text='@LT("Clear layer cut")' Enabled="@(selectedLayer.ClipPolygon.Count >= 3 && !selectedLayer.Locked)" Click="ClearLayerCut" />
                        <DxContextMenuItem Text='@LT("Clear area selection overlay")' Click="ClearAreaSelection" />
                    </Items>
                </DxContextMenuItem>

                <DxContextMenuItem Text='@LT("Adjustments")' IconCssClass="pub-icon pub-icon-color" BeginGroup="true">
                    <Items>
                        <DxContextMenuItem Text='@LT("Brighten")' Click="Brighten" />
                        <DxContextMenuItem Text='@LT("Darken")' Click="Darken" />
                        <DxContextMenuItem Text='@LT("More contrast")' Click="MoreContrast" />
                        <DxContextMenuItem Text='@LT("More saturation")' Click="MoreSaturation" />
                        <DxContextMenuItem Text="@(CheckedText(selectedLayer.Grayscale > .5, "Grayscale"))" Click="ToggleGrayscalePreset" />
                        <DxContextMenuItem Text="@(CheckedText(selectedLayer.Sepia > .5, "Sepia"))" Click="ToggleSepiaPreset" />
                        <DxContextMenuItem Text="@(CheckedText(selectedLayer.Invert > .5, "Invert"))" Click="ToggleInvertPreset" />
                        <DxContextMenuItem Text='@LT("Soften")'>
                            <Items>
                                <DxContextMenuItem Text='@LT("None")' Click="RemoveSoftening" />
                                <DxContextMenuItem Text='@LT("Light")' Click="SoftenLight" />
                                <DxContextMenuItem Text='@LT("Medium")' Click="SoftenMedium" />
                            </Items>
                        </DxContextMenuItem>
                        <DxContextMenuItem Text='@LT("Reset all adjustments")' BeginGroup="true" Click="ResetAdjustments" />
                    </Items>
                </DxContextMenuItem>
                <DxContextMenuItem Text='@LT("Opacity")'>
                    <Items>
                        <DxContextMenuItem Text='@LT("100%")' Click="LayerOpacity100" />
                        <DxContextMenuItem Text='@LT("75%")' Click="LayerOpacity75" />
                        <DxContextMenuItem Text='@LT("50%")' Click="LayerOpacity50" />
                        <DxContextMenuItem Text='@LT("25%")' Click="LayerOpacity25" />
                    </Items>
                </DxContextMenuItem>

                <DxContextMenuItem Text='@LT("Copy")' IconCssClass="pub-icon pub-icon-copy" BeginGroup="true" Click="State.CopySelected" />
                <DxContextMenuItem Text='@LT("Paste")' IconCssClass="pub-icon pub-icon-paste" Enabled="State.CanPaste" Click="State.Paste" />
                <DxContextMenuItem Text='@LT("Duplicate")' IconCssClass="pub-icon pub-icon-duplicate" Click="State.DuplicateSelected" />
                <DxContextMenuItem Text='@LT("Delete")' IconCssClass="pub-icon pub-icon-delete" Enabled="CanDelete" Click="State.DeleteSelected" />
                <DxContextMenuItem Text='@LT("Arrange")' BeginGroup="true">
                    <Items>
                        <DxContextMenuItem Text='@LT("Bring to front")' Click="State.BringSelectedToFront" />
                        <DxContextMenuItem Text='@LT("Bring forward")' Click="MoveUp" />
                        <DxContextMenuItem Text='@LT("Send backward")' Click="MoveDown" />
                        <DxContextMenuItem Text='@LT("Send to back")' Click="State.SendSelectedToBack" />
                    </Items>
                </DxContextMenuItem>
                <DxContextMenuItem Text='@LT("Place on canvas")'>
                    <Items>
                        <DxContextMenuItem Text='@LT("Center on canvas")' Click="State.CenterSelected" />
                        <DxContextMenuItem Text='@LT("Fit to canvas")' Click="State.FitSelectedToCanvas" />
                    </Items>
                </DxContextMenuItem>
                <DxContextMenuItem Text="@(selectedLayer.Locked ? LT("Unlock layer") : LT("Lock layer"))" BeginGroup="true" Click="ToggleSelectedLockMenu" />
                <DxContextMenuItem Text="@(selectedLayer.Visible ? LT("Hide layer") : LT("Show layer"))" Click="ToggleSelectedVisibilityMenu" />
            }
            else
            {
                <DxContextMenuItem Text='@LT("Paste layer")' IconCssClass="pub-icon pub-icon-paste" BeginGroup="true" Enabled="State.CanPaste" Click="State.Paste" />
                <DxContextMenuItem Text='@LT("Insert image…")' IconCssClass="pub-icon pub-icon-picture" Click="RequestImage" />
                <DxContextMenuItem Text='@LT("Import layered SVG / OpenRaster…")' IconCssClass="pub-icon pub-icon-vector" Click="RequestLayeredImport" />
                <DxContextMenuItem Text='@LT("Insert text")' IconCssClass="pub-icon pub-icon-text" Click="AddTextLayer" />
                <DxContextMenuItem Text='@LT("Insert shape")'>
                    <Items>
                        <DxContextMenuItem Text='@LT("Rectangle")' Click="AddRectangle" />
                        <DxContextMenuItem Text='@LT("Ellipse")' Click="AddEllipse" />
                        <DxContextMenuItem Text='@LT("Arrow")' Click="AddArrowShape" />
                        <DxContextMenuItem Text='@LT("Line")' Click="AddLineShape" />
                    </Items>
                </DxContextMenuItem>
                <DxContextMenuItem Text='@LT("Insert fill")'>
                    <Items>
                        <DxContextMenuItem Text='@LT("Solid color")' Click="AddSolidFill" />
                        <DxContextMenuItem Text='@LT("Gradient")' Click="AddGradient" />
                    </Items>
                </DxContextMenuItem>
                <DxContextMenuItem Text='@LT("Insert procedural render")'>
                    <Items>
                        <DxContextMenuItem Text='@LT("Clouds")' Click="AddClouds" />
                        <DxContextMenuItem Text='@LT("Noise")' Click="AddNoise" />
                        <DxContextMenuItem Text='@LT("Stripes")' Click="AddStripes" />
                        <DxContextMenuItem Text='@LT("Vignette")' Click="AddVignette" />
                        <DxContextMenuItem Text='@LT("Bloom")' Click="AddBloom" />
                        <DxContextMenuItem Text='@LT("Neon")' Click="AddNeon" />
                        <DxContextMenuItem Text='@LT("Lens flare")' Click="AddLensFlare" />
                        <DxContextMenuItem Text='@LT("Grain noise")' Click="AddGrainNoise" />
                        <DxContextMenuItem Text='@LT("Motion blur")' Click="AddMotionBlur" />
                        <DxContextMenuItem Text='@LT("Wind")' Click="AddWind" />
                        <DxContextMenuItem Text='@LT("Ocean waves")' Click="AddOceanWaves" />
                    </Items>
                </DxContextMenuItem>
                <DxContextMenuItem Text='@LT("Insert paint layer")' IconCssClass="pub-icon pub-icon-edit" Click="AddPaintLayer" />
                <DxContextMenuItem Text='@LT("Area selection")' BeginGroup="true"><Items>
                    <DxContextMenuItem Text='@LT("Rectangle selection")' Click="RectangleSelectTool" />
                    <DxContextMenuItem Text='@LT("Ellipse selection")' Click="EllipseSelectTool" />
                    <DxContextMenuItem Text='@LT("Freehand lasso")' Click="FreeSelectTool" />
                    <DxContextMenuItem Text='@LT("Magnetic lasso")' Click="MagneticSelectTool" />
                    <DxContextMenuItem Text='@LT("Clear selection")' Click="ClearAreaSelection" />
                </Items></DxContextMenuItem>
                <DxContextMenuItem Text='@LT("Fill selected area")'><Items>
                    <DxContextMenuItem Text='@LT("Solid fill")' Click="FillSolidTool" />
                    <DxContextMenuItem Text='@LT("Gradient fill")' Click="FillGradientTool" />
                </Items></DxContextMenuItem>
                <DxContextMenuItem Text='@LT("View")' BeginGroup="true">
                    <Items>
                        <DxContextMenuItem Text='@LT("Fit canvas")' Click="FitCanvas" />
                        <DxContextMenuItem Text='@LT("100% zoom")' Click="Zoom100" />
                        <DxContextMenuItem Text="@GridText" Click="ToggleGridRibbon" />
                        <DxContextMenuItem Text="@SnapText" Click="ToggleSnapRibbon" />
                    </Items>
                </DxContextMenuItem>
            }
        </Items>
    </DxContextMenu>

    <InputFile id="picture-studio-image-input" class="hidden-file-input" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml" OnChange="ImportImage" />
    <InputFile id="picture-studio-image-drop-input" class="hidden-file-input" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml" OnChange="ImportDroppedImage" />
    <InputFile id="picture-studio-layered-input" class="hidden-file-input" accept=".svg,.svgz,.ora,image/svg+xml,application/gzip,application/x-gzip,application/x-openraster" OnChange="ImportLayeredDocument" />
    <InputFile id="picture-studio-layer-drop-input" class="hidden-file-input" accept=".svg,.svgz,.ora,image/svg+xml,application/gzip,application/x-gzip,application/x-openraster" OnChange="ImportDroppedLayeredDocument" />
}
