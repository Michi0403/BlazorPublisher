@namespace PublisherStudio.Components.Editor
@implements IDisposable
@inject NavigationManager Navigation
@inject ILocalGptConnectionService LocalGptConnection
@inject ILocalGptDiscoveryActivationService LocalGptDiscoveryActivation
@inject IPublisherDocumentationViewerService DocumentationViewer
@inject IFileLocalizationService Localization

@inject ILogger<PublicationRibbon> Logger
@inject ISupervisedTaskRunner TaskRunner
<DxRibbon CssClass="publication-ribbon categorized-ribbon" SizeMode="SizeMode.Medium" AdaptivityAutoCollapseItemsToGroups="true">
    <DxRibbonApplicationTab Text='@LT("File")'>
        <DxRibbonApplicationTabItem Text='@LT("New publication")' IconCssClass="pub-icon pub-icon-newpage" Click="RequestNew" />
        <DxRibbonApplicationTabItem Text='@LT("Open publication")' IconCssClass="pub-icon pub-icon-open" Click="RequestOpen" />
        <DxRibbonApplicationTabItem Text='@LT("Import OpenDocument pages (ODG / ODP)")' IconCssClass="pub-icon pub-icon-open" Click="RequestImportOpenDocument" />
        <DxRibbonApplicationTabItem Text='@LT("Save publication")' IconCssClass="pub-icon pub-icon-save" Click="RequestSave" />
        <DxRibbonApplicationTabItem Text='@LT("Export current page as PNG")' IconCssClass="pub-icon pub-icon-image" Click="RequestExportPng" />
        <DxRibbonApplicationTabItem Text='@LT("Export current page as JPEG")' IconCssClass="pub-icon pub-icon-image" Click="RequestExportJpeg" />
        <DxRibbonApplicationTabItem Text='@LT("Export current page as SVG")' IconCssClass="pub-icon pub-icon-vector" Click="RequestExportSvg" />
        <DxRibbonApplicationTabItem Text='@LT("Render current page as PNG (video + effects)")' IconCssClass="pub-icon pub-icon-image" Click="RequestExportPng" />
        <DxRibbonApplicationTabItem Text='@LT("Render current page as JPEG (video + effects)")' IconCssClass="pub-icon pub-icon-image" Click="RequestExportJpeg" />
        <DxRibbonApplicationTabItem Text='@LT("Render current page as SVG (frozen media)")' IconCssClass="pub-icon pub-icon-vector" Click="RequestExportSvg" />
        @if (CanExportSelection)
        {
            <DxRibbonApplicationTabItem Text='@LT("Export selected object as PNG")' IconCssClass="pub-icon pub-icon-image" Click="RequestExportSelectedPng" />
            <DxRibbonApplicationTabItem Text='@LT("Export selected object as SVG")' IconCssClass="pub-icon pub-icon-vector" Click="RequestExportSelectedSvg" />
        }
        <DxRibbonApplicationTabItem Text='@LT("Export interactive presentation as HTML")' IconCssClass="pub-icon pub-icon-web" Click="RequestExportWebsite" />
        <DxRibbonApplicationTabItem Text='@LT("Export single-file website")' IconCssClass="pub-icon pub-icon-web" Click="RequestExportSite" />
        <DxRibbonApplicationTabItem Text='@LT("Export structured website (ZIP)")' IconCssClass="pub-icon pub-icon-web" Click="RequestExportStructuredSite" />
        <DxRibbonApplicationTabItem Text='@LT("Export presentation as video")' IconCssClass="pub-icon pub-icon-video" Click="RequestExportVideo" />
        <DxRibbonApplicationTabItem Text='@LT("Media Converter Studio")' IconCssClass="pub-icon pub-icon-media" Click="RequestMediaConverter" />
        <DxRibbonApplicationTabItem Text='@LT("Print / Save as PDF")' IconCssClass="pub-icon pub-icon-print" Click="RequestPrint" />
    </DxRibbonApplicationTab>

    <DxRibbonTab Text='@LT("Home")'>
        <DxRibbonGroup Text='@LT("History")' IconCssClass="pub-icon pub-icon-undo">
            <DxRibbonItem Text='@LT("Undo")' IconCssClass="pub-icon pub-icon-undo" Enabled="State.CanUndo" Click="Undo" />
            <DxRibbonItem Text='@LT("Redo")' IconCssClass="pub-icon pub-icon-redo" Enabled="State.CanRedo" Click="Redo" />
        </DxRibbonGroup>
        <DxRibbonGroup Text='@LT("Edit")' IconCssClass="pub-icon pub-icon-copy">
            <DxRibbonItem Text='@LT("Clipboard")' IconCssClass="pub-icon pub-icon-copy" DropDownCssClass="publisher-ribbon-menu">
                <DxRibbonItem Text='@LT("Copy")' IconCssClass="pub-icon pub-icon-copy" Enabled="HasSelection" Click="Copy" />
                <DxRibbonItem Text='@LT("Paste")' IconCssClass="pub-icon pub-icon-paste" Enabled="State.CanPaste" Click="Paste" />
                <DxRibbonItem Text='@LT("Duplicate")' IconCssClass="pub-icon pub-icon-duplicate" Enabled="HasSelection" Click="Duplicate" />
                <DxRibbonItem Text='@LT("Delete")' IconCssClass="pub-icon pub-icon-delete" Enabled="HasSelection" Click="Delete" />
            </DxRibbonItem>
        </DxRibbonGroup>
        <DxRibbonGroup Text='@LT("Arrange")' IconCssClass="pub-icon pub-icon-layers">
            <DxRibbonItem Text='@LT("Layer order")' IconCssClass="pub-icon pub-icon-layers" DropDownCssClass="publisher-ribbon-menu">
                <DxRibbonItem Text='@LT("Bring to front")' IconCssClass="pub-icon pub-icon-layers" Enabled="HasSelection" Click="BringToFront" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-layers" Text='@LT("Bring forward")' Enabled="HasSelection" Click="BringForward" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-layers" Text='@LT("Send backward")' Enabled="HasSelection" Click="SendBackward" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-layers" Text='@LT("Send to back")' Enabled="HasSelection" Click="SendToBack" />
            </DxRibbonItem>
            <DxRibbonItem Text='@LT("Align")' IconCssClass="pub-icon pub-icon-align" DropDownCssClass="publisher-ribbon-menu">
                <DxRibbonItem IconCssClass="pub-icon pub-icon-align" Text='@LT("Left")' Enabled="CanAlign" Click="AlignLeft" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-align" Text='@LT("Horizontal center")' Enabled="CanAlign" Click="AlignCenter" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-align" Text='@LT("Right")' Enabled="CanAlign" Click="AlignRight" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-align" Text='@LT("Top")' Enabled="CanAlign" Click="AlignTop" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-align" Text='@LT("Vertical middle")' Enabled="CanAlign" Click="AlignMiddle" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-align" Text='@LT("Bottom")' Enabled="CanAlign" Click="AlignBottom" />
            </DxRibbonItem>
            <DxRibbonItem IconCssClass="pub-icon pub-icon-layers" Text='@LT("Group")' Enabled="State.CanGroupSelection" Click="GroupSelected" />
            <DxRibbonItem IconCssClass="pub-icon pub-icon-layers" Text='@LT("Ungroup")' Enabled="State.CanUngroupSelection" Click="UngroupSelected" />
        </DxRibbonGroup>
        <DxRibbonGroup Text='@LT("LocalGPT")' IconCssClass="pub-icon pub-icon-command">
            <DxRibbonItem Text="@LocalGptButtonText" IconCssClass="pub-icon pub-icon-command" Click="OpenOrganicPlugins" />
        </DxRibbonGroup>
    </DxRibbonTab>

    <DxRibbonTab Text='@LT("Insert")'>
        <DxRibbonGroup Text='@LT("Content")' IconCssClass="pub-icon pub-icon-insert">
            <DxRibbonItem Text='@LT("Objects")' IconCssClass="pub-icon pub-icon-insert" IsPrimary="true" DropDownCssClass="publisher-ribbon-menu">
                <DxRibbonItem Text='@LT("Panel / dashboard")' IconCssClass="pub-icon pub-icon-panel" Click="RequestPanel" />
                <DxRibbonItem Text='@LT("Web content")' IconCssClass="pub-icon pub-icon-web" Click="RequestHtmlEmbed" />
                <DxRibbonItem Text='@LT("Interactive 3D blob")' IconCssClass="pub-icon pub-icon-effects" Click="RequestVideoBlob" />
                <DxRibbonItem Text='@LT("Text Box")' IconCssClass="pub-icon pub-icon-text" Click="AddText" />
                <DxRibbonItem Text='@LT("WordArt")' IconCssClass="pub-icon pub-icon-wordart" Click="AddWordArt" />
                <DxRibbonItem Text='@LT("Picture")' IconCssClass="pub-icon pub-icon-picture" Click="RequestPicture" />
                <DxRibbonItem Text='@LT("Create picture")' IconCssClass="pub-icon pub-icon-picture" Click="RequestCreatePicture" />
                <DxRibbonItem Text='@LT("Spreadsheet")' IconCssClass="pub-icon pub-icon-spreadsheet" Click="RequestSpreadsheet" />
                <DxRibbonItem Text='@LT("Create spreadsheet")' IconCssClass="pub-icon pub-icon-spreadsheet" Click="RequestCreateSpreadsheet" />
            </DxRibbonItem>
            <DxRibbonItem Text='@LT("Media")' IconCssClass="pub-icon pub-icon-command" DropDownCssClass="publisher-ribbon-menu">
                <DxRibbonItem Text='@LT("Insert video")' IconCssClass="pub-icon pub-icon-video" Click="RequestVideo" />
                <DxRibbonItem Text='@LT("Insert audio")' IconCssClass="pub-icon pub-icon-audio" Click="RequestAudio" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-video" Text='@LT("Create video")' Click="RequestCreateVideo" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-audio" Text='@LT("Create audio")' Click="RequestCreateAudio" />
            </DxRibbonItem>
        </DxRibbonGroup>
        <DxRibbonGroup Text='@LT("Data")' IconCssClass="pub-icon pub-icon-chart">
            <DxRibbonItem Text='@LT("Charts and data")' IconCssClass="pub-icon pub-icon-chart" DropDownCssClass="publisher-ribbon-menu">
                <DxRibbonItem IconCssClass="pub-icon pub-icon-line" Text='@LT("Bar / line chart")' Click="AddChart" />
                <DxRibbonItem Text='@LT("Pie / doughnut")' IconCssClass="pub-icon pub-icon-chart" Click="AddPieChart" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-chart" Text='@LT("Polar chart")' Click="AddPolarChart" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-line" Text='@LT("Sparkline")' Click="AddSparkline" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-chart" Text='@LT("Bar gauge")' Click="AddBarGauge" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-chart" Text='@LT("Circular gauge")' Click="AddCircularGauge" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-line" Text='@LT("Linear gauge")' Click="AddLinearGauge" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-line" Text='@LT("Range selector")' Click="AddRangeSelector" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-chart" Text='@LT("Sankey diagram")' Click="AddSankey" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-chart" Text='@LT("Funnel")' Click="AddFunnel" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-chart" Text='@LT("Pyramid")' Click="AddPyramid" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-chart" Text='@LT("Tree map")' Click="AddTreeMap" />
                <DxRibbonItem Text='@LT("Data table")' IconCssClass="pub-icon pub-icon-chart" Click="AddDataTable" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-chart" Text='@LT("KPI progress")' Click="AddKpi" />
                <DxRibbonItem Text='@LT("Manage data")' IconCssClass="pub-icon pub-icon-chart" Click="RequestManageData" />
            </DxRibbonItem>
            <DxRibbonItem Text='@LT("Barcode / QR")' IconCssClass="pub-icon pub-icon-barcode" IsPrimary="true" Click="RequestBarcode" />
        </DxRibbonGroup>
        <DxRibbonGroup Text='@LT("Panels")' IconCssClass="pub-icon pub-icon-panel">
            <DxRibbonItem Text='@LT("Insert blank panel")' IconCssClass="pub-icon pub-icon-panel" IsPrimary="true" Click="RequestPanel" />
            <DxRibbonItem Text='@LT("Panel library")' IconCssClass="pub-icon pub-icon-chart" Click="RequestPanelLibrary" />
            <DxRibbonItem Text='@LT("Media converter")' IconCssClass="pub-icon pub-icon-media" Click="RequestMediaConverter" />
        </DxRibbonGroup>
        <DxRibbonGroup Text='@LT("Interactive")' IconCssClass="pub-icon pub-icon-web">
            <DxRibbonItem Text='@LT("Professional components")' IconCssClass="pub-icon pub-icon-command" IsPrimary="true" DropDownCssClass="publisher-ribbon-menu">
                <DxRibbonItem Text='@LT("Data controls")' DropDownCssClass="publisher-ribbon-menu">
                        <DxRibbonItem Text='@LT("Data Grid")' Click="AddComponentDataGrid" />
                        <DxRibbonItem Text='@LT("Tree List")' Click="AddComponentTreeList" />
                        <DxRibbonItem Text='@LT("Scheduler")' Click="AddComponentScheduler" />
                        <DxRibbonItem Text='@LT("Pivot Grid")' Click="AddComponentPivotGrid" />
                        <DxRibbonItem Text='@LT("Map")' Click="AddComponentMap" />
                        <DxRibbonItem Text='@LT("Vector Map")' Click="AddComponentVectorMap" />
                </DxRibbonItem>
                <DxRibbonItem Text='@LT("Forms and editors")' DropDownCssClass="publisher-ribbon-menu">
                        <DxRibbonItem Text='@LT("Edit Form")' Click="AddComponentForm" />
                        <DxRibbonItem Text='@LT("Text Box")' Click="AddComponentTextBox" />
                        <DxRibbonItem Text='@LT("Text Area")' Click="AddComponentTextArea" />
                        <DxRibbonItem Text='@LT("Number Box")' Click="AddComponentNumberBox" />
                        <DxRibbonItem Text='@LT("Date Box")' Click="AddComponentDateBox" />
                        <DxRibbonItem Text='@LT("Check Box")' Click="AddComponentCheckBox" />
                        <DxRibbonItem Text='@LT("Select Box")' Click="AddComponentSelectBox" />
                        <DxRibbonItem Text='@LT("Tag Box")' Click="AddComponentTagBox" />
                        <DxRibbonItem Text='@LT("Button")' Click="AddComponentButton" />
                </DxRibbonItem>
                <DxRibbonItem Text='@LT("Navigation and layout")' DropDownCssClass="publisher-ribbon-menu">
                        <DxRibbonItem Text='@LT("Menu")' Click="AddComponentMenu" />
                        <DxRibbonItem Text='@LT("Context Menu")' Click="AddComponentContextMenu" />
                        <DxRibbonItem Text='@LT("Tab Panel")' Click="AddComponentTabPanel" />
                        <DxRibbonItem Text='@LT("Multi View")' Click="AddComponentMultiView" />
                        <DxRibbonItem Text='@LT("Splitter")' Click="AddComponentSplitter" />
                        <DxRibbonItem Text='@LT("Scroll View")' Click="AddComponentScrollView" />
                </DxRibbonItem>
                <DxRibbonItem Text='@LT("Visual collections")' DropDownCssClass="publisher-ribbon-menu">
                        <DxRibbonItem Text='@LT("Gallery")' Click="AddComponentGallery" />
                        <DxRibbonItem Text='@LT("Tile View")' Click="AddComponentTileView" />
                        <DxRibbonItem Text='@LT("Chat")' Click="AddComponentChat" />
                </DxRibbonItem>
            </DxRibbonItem>
        </DxRibbonGroup>
        <DxRibbonGroup Text='@LT("Stream components")' IconCssClass="pub-icon pub-icon-video">
            <DxRibbonItem Text='@LT("Live video")' IconCssClass="pub-icon pub-icon-video" DropDownCssClass="publisher-ribbon-menu">
                <DxRibbonItem Text='@LT("Camera")' Click="AddLiveCamera" />
                <DxRibbonItem Text='@LT("Screen")' Click="AddLiveScreen" />
                <DxRibbonItem Text='@LT("Window")' Click="AddLiveWindow" />
                <DxRibbonItem Text='@LT("Browser tab")' Click="AddLiveBrowserTab" />
                <DxRibbonItem Text='@LT("Capture device")' Click="AddLiveCaptureDevice" />
                <DxRibbonItem Text='@LT("Network media")' Click="AddLiveNetworkMedia" />
            </DxRibbonItem>
            <DxRibbonItem Text='@LT("Live audio / metadata")' IconCssClass="pub-icon pub-icon-audio" DropDownCssClass="publisher-ribbon-menu">
                <DxRibbonItem Text='@LT("Microphone")' Click="AddLiveMicrophone" />
                <DxRibbonItem Text='@LT("System audio")' Click="AddLiveSystemAudio" />
                <DxRibbonItem Text='@LT("Application audio")' Click="AddLiveApplicationAudio" />
                <DxRibbonItem Text='@LT("Now Playing")' Click="AddNowPlaying" />
            </DxRibbonItem>
        </DxRibbonGroup>
        <DxRibbonGroup Text='@LT("Drawing")' IconCssClass="pub-icon pub-icon-shape">
            <DxRibbonItem Text='@LT("Shapes")' IconCssClass="pub-icon pub-icon-shape" DropDownCssClass="publisher-ribbon-menu">
                <DxRibbonItem IconCssClass="pub-icon pub-icon-rectangle" Text='@LT("Rectangle")' Click="AddRectangle" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-rectangle" Text='@LT("Rounded rectangle")' Click="AddRoundedRectangle" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-ellipse" Text='@LT("Ellipse")' Click="AddEllipse" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-line" Text='@LT("Line")' Click="AddLine" />
            </DxRibbonItem>
            <DxRibbonItem Text='@LT("Connectors")' IconCssClass="pub-icon pub-icon-connector" DropDownCssClass="publisher-ribbon-menu">
                <DxRibbonItem IconCssClass="pub-icon pub-icon-connector" Text='@LT("Connector")' Click="StartConnector" />
                <DxRibbonItem Text='@LT("Arrow connector")' IconCssClass="pub-icon pub-icon-arrow" Click="StartArrowConnector" />
                <DxRibbonItem Text='@LT("Signal connector")' IconCssClass="pub-icon pub-icon-connector" Click="StartSignalConnector" />
                <DxRibbonItem Text='@LT("Signal arrow")' IconCssClass="pub-icon pub-icon-arrow" Click="StartSignalArrow" />
            </DxRibbonItem>
        </DxRibbonGroup>
        <DxRibbonGroup Text='@LT("Pages")' IconCssClass="pub-icon pub-icon-page">
            <DxRibbonItem Text='@LT("Page")' IconCssClass="pub-icon pub-icon-page" DropDownCssClass="publisher-ribbon-menu">
                <DxRibbonItem Text='@LT("New page")' IconCssClass="pub-icon pub-icon-page" Click="AddPage" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-duplicate" Text='@LT("Duplicate page")' Click="DuplicatePage" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-delete" Text='@LT("Delete page")' Enabled="@(State.Document.Pages.Count > 1)" Click="DeletePage" />
            </DxRibbonItem>
        </DxRibbonGroup>
    </DxRibbonTab>

    <DxRibbonTab Text='@LT("Streaming")'>
        <DxRibbonGroup Text='@LT("Session")' IconCssClass="pub-icon pub-icon-video">
            <DxRibbonItem Text='@LT("Streaming setup")' IconCssClass="pub-icon pub-icon-properties" IsPrimary="true" Click="RequestStreamingSetup" />
            @if (Streaming.Mode == PublicationStreamSessionMode.Idle)
            {
                <DxRibbonItem Text='@LT("Dry run")' IconCssClass="pub-icon pub-icon-play" Click="RequestStartDryRun" />
                <DxRibbonItem Text='@LT("Start streaming")' IconCssClass="pub-icon pub-icon-video" Enabled="@(State.Document.Streaming.Outputs.Any(output => output.Enabled) || State.Document.Streaming.Recording.Enabled || State.Document.Streaming.Lan.Enabled)" Click="RequestStartStreaming" />
            }
            else
            {
                @if (Streaming.Mode == PublicationStreamSessionMode.Live && Streaming.OutputEnabled.Values.Any(enabled => enabled))
                {
                    <DxRibbonItem Text='@LT("Stop streaming")' IconCssClass="pub-icon pub-icon-stop" IsPrimary="true" Click="RequestStopStreaming" />
                }
                @if (Streaming.Recording)
                {
                    <DxRibbonItem Text='@LT("Stop recording")' IconCssClass="pub-icon pub-icon-stop" IsPrimary="true" Click="RequestStopRecording" />
                }
                else
                {
                    <DxRibbonItem Text='@LT("Start recording")' IconCssClass="pub-icon pub-icon-record" Click="RequestToggleRecording" />
                }
                <DxRibbonItem Text='@LT("Stop session")' IconCssClass="pub-icon pub-icon-stop" Click="RequestStopSession" />
            }
            <DxRibbonItem Text="@Streaming.StatusText" IconCssClass="pub-icon pub-icon-info" Enabled="false" />
        </DxRibbonGroup>
        <DxRibbonGroup Text='@LT("Program")' IconCssClass="pub-icon pub-icon-page">
            <DxRibbonItem Text='@LT("Program page")' IconCssClass="pub-icon pub-icon-page" DropDownCssClass="publisher-ribbon-menu">
                @foreach (var page in State.Document.Pages)
                {
                    <DxRibbonItem Text="@CheckText(Streaming.ProgramPageId == page.Id, page.Name)" Click="() => OnSelectProgramPage.InvokeAsync(page.Id)" />
                }
            </DxRibbonItem>
            @foreach (var output in State.Document.Streaming.Outputs)
            {
                var enabled = Streaming.Mode == PublicationStreamSessionMode.Idle ? output.Enabled : Streaming.OutputEnabled.GetValueOrDefault(output.Id);
                <DxRibbonItem Text="@CheckText(enabled, output.Name)" IconCssClass="pub-icon pub-icon-web" Click="() => OnToggleStreamOutput.InvokeAsync(output.Id)" />
            }
        </DxRibbonGroup>
        <DxRibbonGroup Text='@LT("Chat")' IconCssClass="pub-icon pub-icon-command">
            <DxRibbonItem Text='@LT("Operator chat")' IconCssClass="pub-icon pub-icon-command" DropDownCssClass="publisher-ribbon-menu">
                <DxRibbonItem Text='@LT("Preview chat")' Click="() => OnSelectChatOutput.InvokeAsync((Guid?)null)" />
                @foreach (var output in State.Document.Streaming.Outputs.Where(item => item.Enabled))
                {
                    <DxRibbonItem Text="@output.Name" Click="() => OnSelectChatOutput.InvokeAsync(output.Id)" />
                }
            </DxRibbonItem>
            <DxRibbonItem Text='@LT("Viewers never receive the answer field")' Enabled="false" />
        </DxRibbonGroup>
        <DxRibbonGroup Text='@LT("Live sources")' IconCssClass="pub-icon pub-icon-media">
            <DxRibbonItem Text='@LT("Visual source")' IconCssClass="pub-icon pub-icon-video" DropDownCssClass="publisher-ribbon-menu">
                <DxRibbonItem Text='@LT("Camera")' Click="AddLiveCamera" />
                <DxRibbonItem Text='@LT("Screen")' Click="AddLiveScreen" />
                <DxRibbonItem Text='@LT("Window")' Click="AddLiveWindow" />
                <DxRibbonItem Text='@LT("Browser tab")' Click="AddLiveBrowserTab" />
                <DxRibbonItem Text='@LT("Capture device")' Click="AddLiveCaptureDevice" />
                <DxRibbonItem Text='@LT("Network media")' Click="AddLiveNetworkMedia" />
            </DxRibbonItem>
            <DxRibbonItem Text='@LT("Audio source")' IconCssClass="pub-icon pub-icon-audio" DropDownCssClass="publisher-ribbon-menu">
                <DxRibbonItem Text='@LT("Microphone")' Click="AddLiveMicrophone" />
                <DxRibbonItem Text='@LT("System audio")' Click="AddLiveSystemAudio" />
                <DxRibbonItem Text='@LT("Application audio")' Click="AddLiveApplicationAudio" />
                <DxRibbonItem Text='@LT("Now Playing metadata")' Click="AddNowPlaying" />
            </DxRibbonItem>
        </DxRibbonGroup>
    </DxRibbonTab>

    @if (CanShowAiCouncil)
    {
        <DxRibbonTab Text='@LT("LocalGPT AI")'>
            <DxRibbonGroup Text='@LT("Create with AI")' IconCssClass="pub-icon pub-icon-command">
                <DxRibbonItem Text='@LT("AI Assist selected object")' IconCssClass="pub-icon pub-icon-command" IsPrimary="true" Click="OpenOrganicPlugins" />
                @if (HasCouncilTeam("openscad-team"))
                {
                    <DxRibbonItem Text='@LT("OpenSCAD Team")' IconCssClass="pub-icon pub-icon-effects" Click="OpenOrganicPlugins" />
                }
                @if (HasCouncilTeam("spreadsheet-team"))
                {
                    <DxRibbonItem Text='@LT("Spreadsheet Team")' IconCssClass="pub-icon pub-icon-spreadsheet" Click="OpenOrganicPlugins" />
                }
            </DxRibbonGroup>
            <DxRibbonGroup Text='@LT("Connection & safety")' IconCssClass="pub-icon pub-icon-info">
                <DxRibbonItem Text='@LT("Eye/hand actions require permission")' Enabled="false" />
            </DxRibbonGroup>
        </DxRibbonTab>
    }

    <DxRibbonTab Text='@LT("Page Design")'>
        <DxRibbonGroup Text='@LT("Page setup")'>
            <DxRibbonItem Text='@LT("Page size")' IconCssClass="pub-icon pub-icon-page" IsPrimary="true" DropDownCssClass="publisher-ribbon-menu">
                <DxRibbonItem IconCssClass="pub-icon pub-icon-page" Text='@LT("A3 portrait")' Click="SetA3Portrait" />
                <DxRibbonItem IconCssClass="pub-icon pub-icon-page" Text='@LT("A3 landscape")' Click="SetA3Landscape" />
