    private bool HasCouncilTeam(string teamKey) {
        try
        {
            return LocalGptConnection.State.RemoteCapabilities
        .Where(item => item.IsEnabled && item.IsOnline && string.Equals(item.Key, "council.run", StringComparison.OrdinalIgnoreCase))
        .SelectMany(item => item.Skills)
        .Any(item => string.Equals(item, teamKey, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(PublicationRibbon)}.{nameof(HasCouncilTeam)} failed.");
            throw;
        }
    }

