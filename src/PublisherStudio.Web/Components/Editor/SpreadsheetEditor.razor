    /// <summary>
    /// Performs rebuild selection column names for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    private void RebuildSelectionColumnNames()
    {
        try
        {
            var width = SelectionColumnCount;
            IReadOnlyList<string> source = _selectionFirstRowHeaders && _dataSelection?.Rows.Count > 0 ? _dataSelection.Rows[0] : Array.Empty<string>();
            _selectionColumnNames = Enumerable.Range(0, width)
                .Select(index => index < source.Count ? source[index].Trim() : string.Empty)
                .ToList();
            var dataRows = (_dataSelection?.Rows ?? []).Skip(_selectionFirstRowHeaders ? 1 : 0).ToList();
            _selectionInferredKinds = Enumerable.Range(0, width)
                .Select(index => DataService.InferKind(dataRows.Select(row => index < row.Count ? row[index] : string.Empty)))
                .ToList();
            _selectionColumnTypeKeys = Enumerable.Repeat("Auto", width).ToList();
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(RebuildSelectionColumnNames)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Builds selection data object for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <param name="schema">Publication data column dependency used by the spreadsheet editor workflow to provide the corresponding application capability.</param>
    /// <param name="normalizedRows">String dependency used by the spreadsheet editor workflow to provide the corresponding application capability.</param>
    /// <returns>The publication data object produced by the operation.</returns>
    private PublicationDataObject BuildSelectionDataObject(IReadOnlyList<PublicationDataColumn>? schema = null, IReadOnlyList<List<string>>? normalizedRows = null)
    {
        try
        {
            var columns = schema?.ToList() ?? _selectionColumnNames.Select((name, index) => new PublicationDataColumn
            {
                Name = name.Trim(),
                ValueKind = EffectiveSelectionKind(index),
                ValueKindExplicit = index < _selectionColumnTypeKeys.Count && !string.Equals(_selectionColumnTypeKeys[index], "Auto", StringComparison.OrdinalIgnoreCase)
            }).ToList();
            var rows = normalizedRows?.ToList() ?? (_dataSelection?.Rows ?? []).Skip(_selectionFirstRowHeaders ? 1 : 0)
                .Select(row => Enumerable.Range(0, columns.Count).Select(index => index < row.Count ? row[index] : string.Empty).ToList()).ToList();
            return new PublicationDataObject
            {
                Name = _dataObjectName.Trim(),
                SourceKind = PublicationDataSourceKind.Json,
                Columns = columns,
                Rows = rows.Select(row => new PublicationDataRow
                {
                    Values = columns.Select((column, index) => (column.Name, Value: index < row.Count ? row[index] : string.Empty))
                        .ToDictionary(pair => pair.Name, pair => pair.Value, StringComparer.OrdinalIgnoreCase)
                }).ToList()
            };
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(BuildSelectionDataObject)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Gets the selection validation value that forms part of the spreadsheet editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The selection validation value exposed by <see cref="SpreadsheetEditor"/>.</value>
    private PublicationDataValidationResult SelectionValidation
    {
        get
        {
            if (_dataSelection is null || _selectionColumnNames.Count == 0) return new PublicationDataValidationResult { Severity = PublicationDataValidationSeverity.Warning, Message = "Select spreadsheet cells to validate them." };
            try { return DataService.Validate(BuildSelectionDataObject()); }
            catch (Exception exception)
            {
                Logger.LogWarning(exception, "Spreadsheet selection validation failed.");
                return new PublicationDataValidationResult { Severity = PublicationDataValidationSeverity.Error, Message = exception.Message };
            }
        }
    }

