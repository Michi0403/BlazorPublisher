    /// <summary>
    /// Performs looks like headers for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <param name="rows">String dependency used by the spreadsheet editor workflow to provide the corresponding application capability.</param>
    /// <returns>A value indicating whether the requested condition or operation succeeded.</returns>
    private bool LooksLikeHeaders(IReadOnlyList<List<string>> rows)
    {
        try
        {
            if (rows.Count < 2 || rows[0].Count == 0) return false;
            var first = rows[0].Select(value => value?.Trim() ?? string.Empty).ToArray();
            var nonEmpty = first.Where(value => !string.IsNullOrWhiteSpace(value)).ToArray();
            if (nonEmpty.Length == 0 || nonEmpty.Distinct(StringComparer.OrdinalIgnoreCase).Count() != nonEmpty.Length) return false;
            return nonEmpty.Any(value => !DataService.TryParseNumber(value, out _)
                && !bool.TryParse(value, out _)
                && !DateTimeOffset.TryParse(value, out _));
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(LooksLikeHeaders)} failed.");
            throw;
        }
    }

