    /// </summary>
    private IJSObjectReference? _module;
    /// <summary>
    /// Stores the internal self state used by <see cref="SpreadsheetEditor"/> while executing its surrounding workflow.
    /// </summary>
    private DotNetObjectReference<SpreadsheetEditor>? _self;
    /// <summary>
    /// Stores the internal initialized session state used by <see cref="SpreadsheetEditor"/> while executing its surrounding workflow.
    /// </summary>
    private Guid _initializedSession;
    /// <summary>
    /// Stores the internal registered session state used by <see cref="SpreadsheetEditor"/> while executing its surrounding workflow.
    /// </summary>
