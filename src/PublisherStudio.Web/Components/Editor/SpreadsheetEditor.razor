    /// </summary>
    /// <value>The saved value exposed by <see cref="SpreadsheetEditor"/>.</value>
    [Parameter] public EventCallback<SpreadsheetEditorResult> Saved { get; set; }
    /// <summary>
    /// Gets or sets the data object created value that forms part of the spreadsheet editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The data object created value exposed by <see cref="SpreadsheetEditor"/>.</value>
    [Parameter] public EventCallback<SpreadsheetDataObjectResult> DataObjectCreated { get; set; }
    /// <summary>
    /// Gets or sets the cancelled value that forms part of the spreadsheet editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The cancelled value exposed by <see cref="SpreadsheetEditor"/>.</value>
    [Parameter] public EventCallback Cancelled { get; set; }

    /// <summary>
