    /// <summary>
    /// Stores the internal saving state used by <see cref="SpreadsheetEditor"/> while executing its surrounding workflow.
    /// </summary>
    private bool _saving;
    /// <summary>
    /// Stores the internal opening state used by <see cref="SpreadsheetEditor"/> while executing its surrounding workflow.
    /// </summary>
    private bool _opening;
    /// <summary>
    /// Stores the internal error state used by <see cref="SpreadsheetEditor"/> while executing its surrounding workflow.
    /// </summary>
    private string? _error;
    /// <summary>
    /// Stores the internal data selection state used by <see cref="SpreadsheetEditor"/> while executing its surrounding workflow.
    /// </summary>
    private SpreadsheetDataSelection? _dataSelection;
    /// <summary>
    /// Stores the internal data object name state used by <see cref="SpreadsheetEditor"/> while executing its surrounding workflow.
    /// </summary>
    private string _dataObjectName = "Spreadsheet Data";
    /// <summary>
    /// Stores the internal selection first row headers state used by <see cref="SpreadsheetEditor"/> while executing its surrounding workflow.
    /// </summary>
    private bool _selectionFirstRowHeaders = true;
    /// <summary>
    /// Stores the in-memory selection column names collection maintained internally by <see cref="SpreadsheetEditor"/> for its current workflow state.
    /// </summary>
    private List<string> _selectionColumnNames = [];
    /// <summary>
    /// Stores the in-memory selection inferred kinds collection maintained internally by <see cref="SpreadsheetEditor"/> for its current workflow state.
    /// </summary>
    private List<PublicationDataValueKind> _selectionInferredKinds = [];
    /// <summary>
    /// Stores the in-memory selection column type keys collection maintained internally by <see cref="SpreadsheetEditor"/> for its current workflow state.
    /// </summary>
    private List<string> _selectionColumnTypeKeys = [];
    /// <summary>
    /// Stores the internal selection error state used by <see cref="SpreadsheetEditor"/> while executing its surrounding workflow.
    /// </summary>
    private string? _selectionError;
    /// <summary>
    /// Gets the stable frame identifier used to identify or correlate this spreadsheet editor instance with related application state.
    /// </summary>
    /// <value>The frame identifier value exposed by <see cref="SpreadsheetEditor"/>.</value>
    private string FrameId => $"spreadsheet-frame-{SessionId:N}";
    /// <summary>
    /// Gets the editor URL that identifies the network or application endpoint associated with this spreadsheet editor state.
    /// </summary>
    /// <value>The editor URL value exposed by <see cref="SpreadsheetEditor"/>.</value>
    private string EditorUrl => $"/spreadsheet/editor/{SessionId:D}";
    /// <summary>
    /// Gets the selection column count that quantifies the associated spreadsheet editor data.
    /// </summary>
    /// <value>The selection column count value exposed by <see cref="SpreadsheetEditor"/>.</value>
    private int SelectionColumnCount => _dataSelection?.Rows.Count > 0 ? _dataSelection.Rows.Max(row => row.Count) : 0;
    /// <summary>
    /// Gets the selection data row count that quantifies the associated spreadsheet editor data.
    /// </summary>
    /// <value>The selection data row count value exposed by <see cref="SpreadsheetEditor"/>.</value>
    private int SelectionDataRowCount => Math.Max(0, (_dataSelection?.Rows.Count ?? 0) - (_selectionFirstRowHeaders ? 1 : 0));
    /// <summary>
    /// Gets the selection preview rows collection maintained or exposed by this spreadsheet editor instance for downstream processing.
    /// </summary>
    /// <value>The selection preview rows value exposed by <see cref="SpreadsheetEditor"/>.</value>
    private IEnumerable<List<string>> SelectionPreviewRows => (_dataSelection?.Rows ?? new List<List<string>>())
        .Skip(_selectionFirstRowHeaders ? 1 : 0)
        .Take(8);

    /// <summary>
    /// Handles the parameters set lifecycle or event notification for <see cref="SpreadsheetEditor"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnParametersSet()
    {
        try
        {
            if (!Visible)
            {
                _ready = false;
                _saving = false;
                _opening = false;
                _error = null;
                ResetDataSelection();
            }
            else if (_initializedSession != SessionId)
            {
                _initializedSession = SessionId;
                _ready = false;
                _saving = false;
                _opening = false;
                _error = null;
                ResetDataSelection();
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(OnParametersSet)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Handles the after render async lifecycle or event notification for <see cref="SpreadsheetEditor"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="firstRender">Value indicating whether first render should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            try
            {
                if (!Visible)
                {
                    if (_module is not null && _registeredSession != Guid.Empty)
                    {
                        await _module.InvokeVoidAsync("dispose", $"spreadsheet-frame-{_registeredSession:N}").ConfigureAwait(true);
                        _registeredSession = Guid.Empty;
                    }
                    return;
                }
                if (SessionId == Guid.Empty || _initializedSession != SessionId || _registeredSession == SessionId) return;
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/spreadsheetEditorInterop.js").ConfigureAwait(true);
                _self ??= DotNetObjectReference.Create(this);
                if (_registeredSession != Guid.Empty)
                    await _module.InvokeVoidAsync("dispose", $"spreadsheet-frame-{_registeredSession:N}").ConfigureAwait(true);
                await _module.InvokeVoidAsync("initialize", FrameId, SessionId.ToString("D"), _self).ConfigureAwait(true);
                _registeredSession = SessionId;
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
            catch (JSException ex)
            {
                _registeredSession = SessionId;
                _ready = false;
                _error = $"Spreadsheet Studio could not start: {ex.Message}";
                await InvokeAsync(StateHasChanged).ConfigureAwait(true);
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(OnAfterRenderAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs apply for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task Apply() {
        try
        {
            return RequestSave("apply");
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(Apply)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs download for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task Download() {
        try
        {
            return RequestSave("download");
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(Download)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs request data object for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task RequestDataObject()
    {
        try
        {
            if (_module is null || !_ready || _saving || _opening) return;
            _selectionError = null;
            try { await _module.InvokeVoidAsync("requestDataSelection", FrameId, SessionId.ToString("D")).ConfigureAwait(true); }
            catch (JSException ex) { _error = $"The spreadsheet selection could not be read: {ex.Message}"; }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(RequestDataObject)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs request save for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <param name="intent">Intent value supplied to the spreadsheet editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task RequestSave(string intent)
    {
        try
        {
            if (_module is null || !_ready || _saving || _opening) return;
            _saving = true;
            _error = null;
            try
            {
                await _module.InvokeVoidAsync("requestSave", FrameId, SessionId.ToString("D"), intent).ConfigureAwait(true);
            }
            catch (JSDisconnectedException)
            {
                _saving = false;
                _error = "The browser connection closed before the workbook could be saved.";
            }
            catch (JSException ex)
            {
                _saving = false;
                _error = $"The workbook save command failed: {ex.Message}";
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(RequestSave)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Determines whether cel for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task Cancel()
    {
        try
        {
            if (_saving || _opening) return;
            await Cancelled.InvokeAsync().ConfigureAwait(true);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(Cancel)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs spreadsheet opening for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    [JSInvokable]
    public Task SpreadsheetOpening() {
        try
        {
            return InvokeAsync(() =>
    {
        _opening = true;
        _error = null;
        StateHasChanged();
    });
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(SpreadsheetOpening)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs spreadsheet ready for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <param name="fileName">File name value supplied to the spreadsheet editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    [JSInvokable]
    public Task SpreadsheetReady(string? fileName) {
        try
        {
            return InvokeAsync(() =>
    {
        _ready = true;
        _opening = false;
        if (!string.IsNullOrWhiteSpace(fileName)) FileName = fileName;
        _error = null;
        StateHasChanged();
    });
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(SpreadsheetReady)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs spreadsheet saved for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <param name="intent">Intent value supplied to the spreadsheet editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    [JSInvokable]
    public Task SpreadsheetSaved(string intent) {
        try
        {
            return InvokeAsync(async () =>
    {
        _saving = false;
        if (!Sessions.TryGet(SessionId, out var session))
        {
            _error = "The spreadsheet session expired before its workbook could be applied.";
            StateHasChanged();
            return;
        }
        FileName = session.FileName;
        if (string.Equals(intent, "apply", StringComparison.OrdinalIgnoreCase))
            await Saved.InvokeAsync(new SpreadsheetEditorResult(session.Content, session.FileName, session.SourceFormat, session.PreviewHtml, session.ActiveSheetName)).ConfigureAwait(true);
        else
            StateHasChanged();
    });
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(SpreadsheetSaved)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs spreadsheet data selection received for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <param name="selection">Selection value supplied to the spreadsheet editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    [JSInvokable]
    public Task SpreadsheetDataSelectionReceived(SpreadsheetDataSelection selection) {
        try
        {
            return InvokeAsync(() =>
    {
        if (selection.Rows.Count == 0 || selection.Rows.All(row => row.All(string.IsNullOrWhiteSpace)))
        {
            _error = "The selected spreadsheet range is empty.";
            StateHasChanged();
            return;
        }

        _dataSelection = selection;
        _selectionFirstRowHeaders = LooksLikeHeaders(selection.Rows);
        var workbook = Path.GetFileNameWithoutExtension(FileName);
        _dataObjectName = $"{workbook} - {selection.SheetName} {selection.RangeAddress}";
        _selectionError = null;
        RebuildSelectionColumnNames();
        StateHasChanged();
    });
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(SpreadsheetDataSelectionReceived)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs toggle selection headers for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <param name="args">Args value supplied to the spreadsheet editor operation and used when producing its result.</param>
    private void ToggleSelectionHeaders(ChangeEventArgs args)
    {
        try
        {
            _selectionFirstRowHeaders = args.Value is bool value && value;
            _selectionError = null;
            RebuildSelectionColumnNames();
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(ToggleSelectionHeaders)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs change data object name for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <param name="args">Args value supplied to the spreadsheet editor operation and used when producing its result.</param>
    private void ChangeDataObjectName(ChangeEventArgs args) {
        try
        {
            _dataObjectName = args.Value?.ToString() ?? string.Empty;
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(ChangeDataObjectName)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs change selection column name for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <param name="index">Index value supplied to the spreadsheet editor operation and used when producing its result.</param>
    /// <param name="args">Args value supplied to the spreadsheet editor operation and used when producing its result.</param>
    private void ChangeSelectionColumnName(int index, ChangeEventArgs args)
    {
        try
        {
            if (index < 0 || index >= _selectionColumnNames.Count) return;
            _selectionColumnNames[index] = args.Value?.ToString() ?? string.Empty;
            _selectionError = null;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(ChangeSelectionColumnName)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs change selection column type for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <param name="index">Index value supplied to the spreadsheet editor operation and used when producing its result.</param>
    /// <param name="args">Args value supplied to the spreadsheet editor operation and used when producing its result.</param>
    private void ChangeSelectionColumnType(int index, ChangeEventArgs args)
    {
        try
        {
            if (index < 0 || index >= _selectionColumnTypeKeys.Count) return;
            var value = args.Value?.ToString() ?? "Auto";
            _selectionColumnTypeKeys[index] = Enum.TryParse<PublicationDataValueKind>(value, out var kind) ? kind.ToString() : "Auto";
            _selectionError = null;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(ChangeSelectionColumnType)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs effective selection kind for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <param name="index">Index value supplied to the spreadsheet editor operation and used when producing its result.</param>
    /// <returns>The publication data value kind produced by the operation.</returns>
    private PublicationDataValueKind EffectiveSelectionKind(int index)
        {
        try
        {
            return index >= 0 && index < _selectionColumnTypeKeys.Count && Enum.TryParse<PublicationDataValueKind>(_selectionColumnTypeKeys[index], out var explicitKind)
            ? explicitKind
            : index >= 0 && index < _selectionInferredKinds.Count ? _selectionInferredKinds[index] : PublicationDataValueKind.Text;
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(EffectiveSelectionKind)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Creates data object for <see cref="SpreadsheetEditor"/>, keeping the operation consistent with the state and invariants of the surrounding spreadsheet editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task CreateDataObject()
    {
        try
        {
            if (_dataSelection is null) return;
            var name = _dataObjectName.Trim();
            if (string.IsNullOrWhiteSpace(name)) { _selectionError = "Enter a data object name."; return; }
            var columns = _selectionColumnNames.Select(value => value.Trim()).ToList();
            if (columns.Count == 0 || columns.Any(string.IsNullOrWhiteSpace)) { _selectionError = "Every selected column needs a name."; return; }
            if (columns.Distinct(StringComparer.OrdinalIgnoreCase).Count() != columns.Count) { _selectionError = "Column names must be unique."; return; }

            var sourceRows = _dataSelection.Rows.Skip(_selectionFirstRowHeaders ? 1 : 0).ToList();
            if (sourceRows.Count == 0) { _selectionError = "The selection contains headers but no data rows."; return; }
            var normalizedRows = sourceRows.Select(row => Enumerable.Range(0, columns.Count)
                .Select(index => index < row.Count ? row[index] : string.Empty)
                .ToList()).ToList();

            var typedColumns = columns.Select((column, index) => new PublicationDataColumn
            {
                Name = column,
                ValueKind = EffectiveSelectionKind(index),
                ValueKindExplicit = index < _selectionColumnTypeKeys.Count && !string.Equals(_selectionColumnTypeKeys[index], "Auto", StringComparison.OrdinalIgnoreCase)
            }).ToList();
            var candidate = BuildSelectionDataObject(typedColumns, normalizedRows);
            var validation = DataService.Validate(candidate);
            if (validation.Severity == PublicationDataValidationSeverity.Error)
            {
                _selectionError = validation.Issues.FirstOrDefault(issue => issue.Severity == PublicationDataValidationSeverity.Error)?.Message ?? validation.Message;
                return;
            }

            await DataObjectCreated.InvokeAsync(new SpreadsheetDataObjectResult
            {
                Name = name,
                WorkbookFileName = FileName,
                SheetName = _dataSelection.SheetName,
                RangeAddress = _dataSelection.RangeAddress,
                FirstRowContainsHeaders = _selectionFirstRowHeaders,
                ColumnNames = columns,
                Columns = typedColumns,
                Rows = normalizedRows
            }).ConfigureAwait(true);
            ResetDataSelection();
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(CreateDataObject)} failed.");
            throw;
        }
    }

