    /// <summary>
    /// Releases resources owned by <see cref="SpreadsheetEditor"/> and leaves the spreadsheet editor workflow in a safely disposed state.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                try { await _module.InvokeVoidAsync("dispose", FrameId).ConfigureAwait(true); }
                catch (JSDisconnectedException) { }
                catch (TaskCanceledException) { }
                try { await _module.DisposeAsync().ConfigureAwait(true); }
                catch (JSDisconnectedException exception) { Logger.LogDebug(exception, "Spreadsheet Studio module disposal observed an already disconnected circuit."); }
                catch (TaskCanceledException exception) { Logger.LogDebug(exception, "Spreadsheet Studio module disposal was cancelled during circuit shutdown."); }
                catch (ObjectDisposedException exception) { Logger.LogDebug(exception, "Spreadsheet Studio module was already disposed during circuit shutdown."); }
            }
            _self?.Dispose();
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SpreadsheetEditor)}.{nameof(DisposeAsync)} failed.");
            throw;
        }
    }

