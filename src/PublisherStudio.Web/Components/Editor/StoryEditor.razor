    /// <summary>
    /// Performs print story for <see cref="StoryEditor"/>, keeping the operation consistent with the state and invariants of the surrounding story editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task PrintStory()
    {
        try
        {
            if (_richEdit is null || TextFrame is null) return;
            _error = null;
            var title = $"{PublicationName} – {TextFrame.Name}";
            string? previewId = null;
            try
            {
                // Open the preview window before the first asynchronous document export so the
                // browser still treats it as a direct user action instead of blocking the popup.
                previewId = await JS.InvokeAsync<string?>("publisherStudio.claimStoryPrintPreview", title).ConfigureAwait(true);
                if (string.IsNullOrWhiteSpace(previewId))
                    throw new InvalidOperationException("The browser blocked the story print-preview window. Allow popups for this local PublisherStudio address and try again.");

                var openXml = await _richEdit.ExportDocumentAsync(DocumentFormat.OpenXml).ConfigureAwait(true);
                var html = await _richEdit.ExportDocumentAsync(DocumentFormat.Html).ConfigureAwait(true);
                var prepared = await PrepareStoryPreview(
                    html,
                    Files.ExtractOpenXmlDocumentBackground(openXml)).ConfigureAwait(true);
                var pageLayout = Files.ExtractOpenXmlPageLayout(openXml);
                await JS.InvokeVoidAsync(
                    "publisherStudio.completeStoryPrintPreview",
                    previewId,
                    StandaloneStoryHtml(prepared, title, pageLayout, printPreview: true)).ConfigureAwait(true);
            }
            catch (Exception ex)
            {
                _error = ex.Message;
                if (!string.IsNullOrWhiteSpace(previewId))
                {
                    try { await JS.InvokeVoidAsync("publisherStudio.failStoryPrintPreview", previewId, ex.Message).ConfigureAwait(true); }
                    catch (JSDisconnectedException) { }
                    catch (TaskCanceledException) { }
                    catch (JSException) { }
                }
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(StoryEditor)}.{nameof(PrintStory)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs prepare story preview for <see cref="StoryEditor"/>, keeping the operation consistent with the state and invariants of the surrounding story editor workflow.
    /// </summary>
    /// <param name="html">Html value supplied to the story editor operation and used when producing its result.</param>
    /// <param name="preferredBackground">Preferred background value supplied to the story editor operation and used when producing its result.</param>
    /// <returns>The story preview result produced by the operation.</returns>
    private async Task<StoryPreviewResult> PrepareStoryPreview(byte[] html, string? preferredBackground = null)
    {
        try
        {
            var normalizedPreferredBackground = Files.NormalizeCssBackground(preferredBackground);
            var fallback = new StoryPreviewResult
            {
                Html = Files.ExtractHtmlBody(html),
                Background = IsVisibleBackground(normalizedPreferredBackground)
                    ? normalizedPreferredBackground
                    : TextFrame?.DocumentBackground ?? "transparent"
            };
            try
            {
                ResetStoryPreviewTransfer();
                using var htmlStream = new MemoryStream(html, writable: false);
                using var htmlReference = new DotNetStreamReference(htmlStream);
                using var receiverReference = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync(
                    "publisherStudio.prepareStoryPreviewHtmlInChunks",
                    htmlReference,
                    normalizedPreferredBackground,
                    receiverReference).ConfigureAwait(true);

                var prepared = _storyPreviewResult
                    ?? throw new JSException(_storyPreviewTransferError ?? "The formatted story preview transfer did not complete.");
                if (IsVisibleBackground(normalizedPreferredBackground))
                    prepared.Background = normalizedPreferredBackground;
                prepared.Background = Files.NormalizeCssBackground(prepared.Background);
                ResetStoryPreviewTransfer();
                return prepared;
            }
            catch (JSDisconnectedException) { ResetStoryPreviewTransfer(); return fallback; }
            catch (TaskCanceledException) { ResetStoryPreviewTransfer(); return fallback; }
            catch (JSException) { ResetStoryPreviewTransfer(); return fallback; }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(StoryEditor)}.{nameof(PrepareStoryPreview)} failed.");
            throw;
        }
    }

