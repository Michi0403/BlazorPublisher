    [JSInvokable]
    public bool BeginStoryPreviewTransfer(string transferId, int totalLength, int chunkCount, string background)
    {
        try
        {
            ResetStoryPreviewTransfer();
            if (string.IsNullOrWhiteSpace(transferId) || totalLength < 0 || chunkCount <= 0)
            {
                _storyPreviewTransferError = "The story preview transfer metadata is invalid.";
                return false;
            }

            _storyPreviewTransferId = transferId;
            _storyPreviewExpectedLength = totalLength;
            _storyPreviewExpectedChunks = chunkCount;
            _storyPreviewBackground = Files.NormalizeCssBackground(background);
            return true;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(StoryEditor)}.{nameof(BeginStoryPreviewTransfer)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs append story preview chunk for <see cref="StoryEditor"/>, keeping the operation consistent with the state and invariants of the surrounding story editor workflow.
    /// </summary>
    /// <param name="transferId">Identifier of the transfer to use for this operation.</param>
    /// <param name="chunkIndex">Chunk index value supplied to the story editor operation and used when producing its result.</param>
    /// <param name="chunk">Chunk value supplied to the story editor operation and used when producing its result.</param>
    /// <returns>A value indicating whether the requested condition or operation succeeded.</returns>
    [JSInvokable]
    public bool AppendStoryPreviewChunk(string transferId, int chunkIndex, string chunk)
    {
        try
        {
            if (!string.Equals(_storyPreviewTransferId, transferId, StringComparison.Ordinal)
                || chunkIndex != _storyPreviewNextChunk)
            {
                _storyPreviewTransferError = "The formatted story preview chunks arrived out of order.";
                return false;
            }

            _storyPreviewBuffer.Append(chunk ?? string.Empty);
            _storyPreviewNextChunk++;
            return true;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(StoryEditor)}.{nameof(AppendStoryPreviewChunk)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Completes story preview transfer for <see cref="StoryEditor"/>, keeping the operation consistent with the state and invariants of the surrounding story editor workflow.
    /// </summary>
    /// <param name="transferId">Identifier of the transfer to use for this operation.</param>
    /// <returns>A value indicating whether the requested condition or operation succeeded.</returns>
    [JSInvokable]
    public bool CompleteStoryPreviewTransfer(string transferId)
    {
        try
        {
            if (!string.Equals(_storyPreviewTransferId, transferId, StringComparison.Ordinal)
                || _storyPreviewNextChunk != _storyPreviewExpectedChunks
                || _storyPreviewBuffer.Length != _storyPreviewExpectedLength)
            {
                _storyPreviewTransferError = "The formatted story preview transfer was incomplete.";
                return false;
            }

            _storyPreviewResult = new StoryPreviewResult
            {
                Html = _storyPreviewBuffer.ToString(),
                Background = _storyPreviewBackground
            };
            return true;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(StoryEditor)}.{nameof(CompleteStoryPreviewTransfer)} failed.");
            throw;
        }
    }

