    /// <summary>
    /// Exports story for <see cref="StoryEditor"/>, keeping the operation consistent with the state and invariants of the surrounding story editor workflow.
    /// </summary>
    /// <param name="format">Format value supplied to the story editor operation and used when producing its result.</param>
    /// <param name="extension">Extension value supplied to the story editor operation and used when producing its result.</param>
    /// <param name="mimeType">Mime type value supplied to the story editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ExportStory(DocumentFormat format, string extension, string mimeType)
    {
        try
        {
            if (_richEdit is null || TextFrame is null) return;
            try
            {
                var content = await _richEdit.ExportDocumentAsync(format).ConfigureAwait(true);
                if (format == DocumentFormat.Html)
                {
                    var openXml = await _richEdit.ExportDocumentAsync(DocumentFormat.OpenXml).ConfigureAwait(true);
                    var prepared = await PrepareStoryPreview(
                        content,
                        Files.ExtractOpenXmlDocumentBackground(openXml)).ConfigureAwait(true);
                    var pageLayout = Files.ExtractOpenXmlPageLayout(openXml);
                    content = System.Text.Encoding.UTF8.GetBytes(StandaloneStoryHtml(
                        prepared,
                        $"{PublicationName} – {TextFrame.Name}",
                        pageLayout));
                }
                var baseName = Files.SafeFileName($"{PublicationName}-{TextFrame.Name}");
                var stream = new MemoryStream(content);
                await using var configuredStreamAsyncDisposal = stream.ConfigureAwait(true);
                using var reference = new DotNetStreamReference(stream);
                await JS.InvokeVoidAsync("publisherStudio.downloadStream", baseName + extension, reference, mimeType).ConfigureAwait(true);
            }
            catch (Exception ex)
            {
                _error = ex.Message;
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(StoryEditor)}.{nameof(ExportStory)} failed.");
            throw;
        }
    }

