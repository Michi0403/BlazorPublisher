    /// <summary>
    /// Performs apply for <see cref="StoryEditor"/>, keeping the operation consistent with the state and invariants of the surrounding story editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task Apply()
    {
        try
        {
            if (_richEdit is null || _upgradingLegacyStory) return;
            _error = null;
            try
            {
                // Export the live RichEdit document directly. SaveDocumentAsync can rebind the
                // DocumentContent parameter before the export completes and used to drop direct
                // formatting in the persisted copy even though a manual DOCX download was correct.
                var openXml = await _richEdit.ExportDocumentAsync(DocumentFormat.OpenXml).ConfigureAwait(true);
                var html = await _richEdit.ExportDocumentAsync(DocumentFormat.Html).ConfigureAwait(true);
                var openXmlBackground = Files.ExtractOpenXmlDocumentBackground(openXml);
                var prepared = await PrepareStoryPreview(html, openXmlBackground).ConfigureAwait(true);
                var preview = prepared.Html;
                var documentBackground = prepared.Background;
                _content = openXml.ToArray();
                _documentFormat = DocumentFormat.OpenXml;
                await Saved.InvokeAsync((openXml, preview, documentBackground, StoryStorageFormat.OpenXml)).ConfigureAwait(true);
            }
            catch (Exception ex)
            {
                _error = ex.Message;
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(StoryEditor)}.{nameof(Apply)} failed.");
            throw;
        }
    }

