    /// <summary>
    /// Performs submit AI selection edit for <see cref="StoryEditor"/>, keeping the operation consistent with the state and invariants of the surrounding story editor workflow.
    /// </summary>
    /// <param name="instruction">Instruction value supplied to the story editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task SubmitAiSelectionEditAsync(string instruction)
    {
        try
        {
            if (!CanUseAiCouncil || TextFrame is null) return;
            try
            {
                if (!HasSelectedStoryText)
                {
                    _aiStoryPanelVisible = true;
                    _error = "Select text in the story before using an AI text-editing command.";
                    await SafeStateHasChanged().ConfigureAwait(true);
                    return;
                }

                var span = await _selection.ActiveSubDocument.GetTextSpanAsync(_selection.Intervals[0]).ConfigureAwait(true);
                var selectedText = span.Text?.Trim() ?? string.Empty;
                if (string.IsNullOrWhiteSpace(selectedText))
                {
                    _aiStoryPanelVisible = true;
                    _error = "The current selection does not contain editable text.";
                    await SafeStateHasChanged().ConfigureAwait(true);
                    return;
                }

                _aiStoryPrompt = $"{instruction}\n\nSelected story text:\n{selectedText}\n\nReturn only the replacement text as the proposal.";
                _aiStoryPanelVisible = true;
                await SafeStateHasChanged().ConfigureAwait(true);
                await RequestAiStoryAsync().ConfigureAwait(true);
            }
            catch (OperationCanceledException)
            {
                _error = "The AI text-editing request was canceled before the selected text could be read.";
                await SafeStateHasChanged().ConfigureAwait(true);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Could not prepare an AI selection-editing request for story {StoryId}.", TextFrame.Id);
                _error = ex.Message;
                await SafeStateHasChanged().ConfigureAwait(true);
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(StoryEditor)}.{nameof(SubmitAiSelectionEditAsync)} failed.");
            throw;
        }
    }

