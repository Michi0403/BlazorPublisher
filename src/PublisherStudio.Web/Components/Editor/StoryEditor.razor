    /// <summary>
    /// Handles document loaded for <see cref="StoryEditor"/>, keeping the operation consistent with the state and invariants of the surrounding story editor workflow.
    /// </summary>
    /// <param name="_">_ value supplied to the story editor operation and used when producing its result.</param>
