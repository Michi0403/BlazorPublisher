    /// <summary>
    /// Performs request AI story for <see cref="StoryEditor"/>, keeping the operation consistent with the state and invariants of the surrounding story editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task RequestAiStoryAsync()
    {
        try
        {
            if (!CanSendAiStoryRequest || TextFrame is null) return;
            try
            {
                var request = new OrganicCouncilPromptRequest
                {
                    TeamKey = _aiTeamKey,
                    MaxRounds = 1,
                    MaxOutputTokens = 262144,
                    MaxContextTokens = 262144,
                    MaxParallelModels = 1,
                    IncludeMemory = true,
                    SaveToMemory = true,
                    RequestedOrganicCapabilities = ["publisher.business-context", "publisher.text.insert.propose"],
                    ExternalProjectContextJson = System.Text.Json.JsonSerializer.Serialize(new
                    {
                        Source = "PublisherStudio StoryEditor",
                        PublicationName,
                        PageName,
                        StoryId = TextFrame.Id,
                        StoryName = TextFrame.Name,
                        Target = AiProposalTarget,
                        Workflow = "Reviewable story text proposal"
                    })
                };
                request.Prompt = $"""
    PublisherStudio Story Editor user request:
    {_aiStoryPrompt.Trim()}

    Current publication: {PublicationName}
    Current page: {PageName}
    Current story: {TextFrame.Name}

    Required result contract:
    1. Produce polished story text matching the user's topic, audience, tone and requested facts.
    2. Before completing, invoke publisher.text.proposal.request with JSON parameters containing target exactly '{AiProposalTarget}', the final text, and a concise reason.
    3. Never mutate the publication automatically. The user reviews and explicitly inserts the proposal in PublisherStudio.
    """;
                var correlationId = await LocalGptConnection.SendCouncilRequestAsync(request).ConfigureAwait(true);
                Logger.LogInformation("Submitted StoryEditor AI Council request {CorrelationId} for story {StoryId}.", correlationId, TextFrame.Id);
                Notifications.Success($"Council request {correlationId} was submitted. You can close this editor; the run remains active.", "Story proposal requested", nameof(StoryEditor));
                _aiStoryPrompt = string.Empty;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Could not submit an AI Council story request for {StoryId}.", TextFrame.Id);
                _error = ex.Message;
                Notifications.Error(ex.Message, "Story proposal request failed", nameof(StoryEditor));
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(StoryEditor)}.{nameof(RequestAiStoryAsync)} failed.");
            throw;
        }
    }

