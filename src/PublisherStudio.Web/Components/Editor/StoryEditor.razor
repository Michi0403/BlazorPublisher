@namespace PublisherStudio.Components.Editor
@implements IDisposable
@inject IJSRuntime JS
@inject SystemFontCatalog SystemFonts
@inject PublisherStudio.Services.CodeEditing.ICodeLanguageService CodeLanguages
@inject PublisherStudio.Services.CodeEditing.ICodeFormattingService CodeFormatting
@inject PublisherStudio.Services.OrganicPlugins.ILocalGptConnectionService LocalGptConnection
@inject PublisherStudio.Services.OrganicPlugins.IOrganicResultStore OrganicResults
@inject PublisherStudio.Services.UserExperience.IUserNotificationService Notifications
@inject ILogger<StoryEditor> Logger
@inject ISupervisedTaskRunner TaskRunner
@inject PublicationFileService Files

@if (Visible && TextFrame is not null)
{
    <div class="modal-backdrop" role="presentation">
        <section id="story-editor-shell" class="story-editor-dialog" role="dialog" aria-modal="true" aria-label="Edit text story">
            <header>
                <div><strong>Edit story</strong><span>@TextFrame.Name</span></div>
                <button class="window-close" @onclick="Cancel" aria-label="Close">×</button>
            </header>

            <DxRibbon CssClass="story-editor-ribbon categorized-ribbon" SizeMode="SizeMode.Small" AdaptivityAutoCollapseItemsToGroups="true">
                <DxRibbonTab Text="Story">
                    <DxRibbonGroup Text="Dynamic fields">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-insert" Text="Insert field" DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-insert" Text="Date" Click="InsertDateField" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-insert" Text="Time" Click="InsertTimeField" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-page" Text="Page number" Click="InsertPageField" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-page" Text="Page count" Click="InsertPageCountField" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-insert" Text="Publication name" Click="InsertPublicationField" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-page" Text="Page name" Click="InsertPageNameField" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-text" Text="Story name" Click="InsertStoryNameField" />
                        </DxRibbonItem>
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-command" Text="Update fields" IsPrimary="true" Click="UpdateFields" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-play" Text="Field display" DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-visible" Text="Show results" Click="ShowFieldResults" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-visible" Text="Show codes" Click="ShowFieldCodes" />
                        </DxRibbonItem>
                    </DxRibbonGroup>
                </DxRibbonTab>
                @if (CanUseAiCouncil)
                {
                    <DxRibbonTab Text="LocalGPT AI">
                        <DxRibbonGroup Text="Text generation">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-text" Text="Generate text" IsPrimary="true" Click="OpenAiStoryPanel" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-command" Text="Edit selection" DropDownCssClass="publisher-ribbon-menu">
                                <DxRibbonItem Text="Proofread" Click="AiProofreadSelection" />
                                <DxRibbonItem Text="Shorten" Click="AiShortenSelection" />
                                <DxRibbonItem Text="Expand" Click="AiExpandSelection" />
                                <DxRibbonItem Text="Summarize" Click="AiSummarizeSelection" />
                                <DxRibbonItem Text="Explain" Click="AiExplainSelection" />
                                <DxRibbonItem Text="Professional tone" Click="AiProfessionalSelection" />
                                <DxRibbonItem Text="Friendly tone" Click="AiFriendlySelection" />
                                <DxRibbonItem Text="Translate" Click="AiTranslateSelection" />
                            </DxRibbonItem>
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-command" Text="Refresh proposals" Click="RefreshAiProposals" />
                        </DxRibbonGroup>
                    </DxRibbonTab>
                }
                <DxRibbonTab Text="Code">
                    <DxRibbonGroup Text="Programming language">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-code" Text="Code workspace" IsPrimary="true" Click="OpenCodeWorkspace" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-command" Text="Format" Click="FormatCodeWorkspace" />
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-text" Text="Toggle comments" Click="ToggleCodeComments" />
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Insert">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-insert" Text="Insert code at caret" Click="InsertCodeAtCaret" />
                    </DxRibbonGroup>
                </DxRibbonTab>
                <DxRibbonTab Text="Export">
                    <DxRibbonGroup Text="Download">
                        <DxRibbonItem IconCssClass="pub-icon pub-icon-download" Text="Download document" IsPrimary="true" DropDownCssClass="publisher-ribbon-menu">
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-download" Text="DOCX" Click="ExportDocx" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-download" Text="RTF" Click="ExportRtf" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-download" Text="Plain text" Click="ExportText" />
                            <DxRibbonItem IconCssClass="pub-icon pub-icon-download" Text="HTML" Click="ExportHtml" />
                        </DxRibbonItem>
                    </DxRibbonGroup>
                    <DxRibbonGroup Text="Output"><DxRibbonItem Text="Print" IconCssClass="pub-icon pub-icon-print" Click="PrintStory" /></DxRibbonGroup>
                </DxRibbonTab>
            </DxRibbon>
            @if (_aiStoryPanelVisible && CanUseAiCouncil)
            {
                <section class="story-ai-workspace" aria-label="LocalGPT AI story assistance">
                    <header>
                        <div>
                            <strong>LocalGPT AI text generation</strong>
                            <span>Paired with @LocalGptConnection.State.DisplayName. The Council returns a reviewable proposal; only you can insert it.</span>
                        </div>
                        <button class="window-close" @onclick="CloseAiStoryPanel" aria-label="Close LocalGPT AI story assistance">×</button>
                    </header>
                    <div class="story-ai-request">
                        <label>Team
                            <select @bind="_aiTeamKey">
                                @foreach (var team in AiCouncilTeams)
                                {
                                    <option value="@team.Key">@team.Name</option>
                                }
                            </select>
                        </label>
                        <label class="story-ai-prompt">What should the story contain?
                            <textarea rows="4" @bind="_aiStoryPrompt" @bind:event="oninput" @onkeydown="HandleAiPromptKeyDown" placeholder="Describe the topic, audience, tone, facts and desired length. Press Ctrl+Enter to send."></textarea>
                        </label>
                        <button type="button" disabled="@(!CanSendAiStoryRequest)" @onclick="RequestAiStoryAsync">Generate proposal</button>
                    </div>
                    <div class="story-ai-proposals" aria-live="polite">
                        <div class="story-ai-proposal-heading">
                            <strong>Reviewable proposals</strong>
                            <button type="button" @onclick="RefreshAiProposals">Refresh</button>
                        </div>
                        @if (MatchingAiProposals.Count == 0)
                        {
                            <p>No proposal has arrived for this story yet. The Council run can continue after this editor closes; reopen it and refresh later.</p>
                        }
                        else
                        {
                            @foreach (var proposal in MatchingAiProposals)
                            {
                                <article @key="proposal.Id">
                                    <header><strong>@proposal.Reason</strong><time>@proposal.CreatedUtc.LocalDateTime.ToString("g")</time></header>
                                    <textarea rows="6" readonly>@proposal.Text</textarea>
                                    <div>
                                        <button type="button" @onclick="() => InsertAiProposalAsync(proposal)">Insert at caret</button>
                                        @if (HasSelectedStoryText)
                                        {
                                            <button type="button" @onclick="() => ReplaceSelectionWithAiProposalAsync(proposal)">Replace selection</button>
                                        }
                                        <button type="button" @onclick="() => DismissAiProposal(proposal.Id)">Dismiss</button>
                                    </div>
                                </article>
                            }
                        }
                    </div>
                </section>
            }
            @if (_codeWorkspaceVisible)
            {
                <section class="story-code-workspace" aria-label="Programming language workspace">
                    <header>
                        <strong>Code workspace</strong>
                        <span>Language profiles, formatting, comments and token analysis are also available through <code>/api/code</code>.</span>
                        <button class="window-close" @onclick="CloseCodeWorkspace" aria-label="Close code workspace">×</button>
                    </header>
                    <div class="story-code-toolbar">
                        <label>Language
                            <select @bind="_codeLanguageId">
                                @foreach (var language in CodeLanguages.GetProfiles())
                                {
                                    <option value="@language.Id">@language.DisplayName</option>
                                }
                            </select>
                        </label>
                        <label>Indent
                            <input type="number" min="1" max="8" @bind="_codeIndentSize" />
                        </label>
                        <button type="button" @onclick="FormatCodeWorkspace">Format</button>
                        <button type="button" @onclick="ToggleCodeComments">Toggle comments</button>
                        <button type="button" @onclick="InsertCodeAtCaret">Insert at caret</button>
                    </div>
                    <div class="story-code-grid">
                        <textarea rows="10" spellcheck="false" @bind="_codeWorkspaceText" @bind:event="oninput" aria-label="Code source"></textarea>
                        <pre class="story-code-preview" aria-label="Syntax analysis preview">@_codeWorkspaceText</pre>
                    </div>
                    <footer><span>@CodeWorkspaceSummary</span></footer>
                </section>
            }

            <details class="story-field-help story-field-help-strip">
                <summary>Available dynamic fields</summary>
                <div>
                    <strong>Dynamic fields in this publication</strong>
                    <span><code>DATE</code> Current date</span>
                    <span><code>TIME</code> Current time</span>
                    <span><code>PAGE</code> Current story page</span>
                    <span><code>NUMPAGES</code> Story page count</span>
                    <span><code>PublicationName</code> Publication title</span>
                    <span><code>PageName</code> Canvas page name</span>
                    <span><code>StoryName</code> Text-frame name</span>
                    <small>The RichEdit References → Add Text menu contains the additional built-in field commands.</small>
                </div>
            </details>

            <div id="story-editor-host" class="story-editor-host">
                <DxRichEdit @key="_editorRevision" @ref="_richEdit"
                            DocumentFormat="@_documentFormat"
                            @bind-DocumentContent="_content"
                            @bind-Selection="_selection"
                            DocumentLoaded="HandleDocumentLoaded"
                            CustomizeRibbon="CustomizeRichEditRibbon"
                            MailMergeSettings="@_mailMergeSettingsContent"
                            BarMode="BarMode.Ribbon"
                            ViewType="ViewType.PrintLayout"
                            ReadOnly="false"
                            CheckSpelling="true"
                            HorizontalRulerVisible="true"
                            CssClass="story-rich-edit" />
                @if (_upgradingLegacyStory)
                {
                    <div class="story-upgrade-notice">Upgrading this legacy HTML story to DOCX so page layout, fonts, fields, colors, headers, and footers work correctly…</div>
                }
            </div>
            <footer>
                <span>Stories are stored as Office Open XML (DOCX). The canvas preview is generated as HTML.</span>
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <strong class="story-error">@_error</strong>
                }
                <div>
                    <DxButton Text="Cancel" Click="Cancel" />
                    <DxButton Text="Apply to frame" RenderStyle="ButtonRenderStyle.Primary" Click="Apply" />
                </div>
            </footer>
        </section>
    </div>
}

@code {

    /// <summary>
    /// Gets or sets a value indicating whether the value is visible applies to the story editor state.
    /// </summary>
    /// <value>The visible value exposed by <see cref="StoryEditor"/>.</value>
    [Parameter] public bool Visible { get; set; }
    /// <summary>
    /// Gets or sets the text frame value that forms part of the story editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The text frame value exposed by <see cref="StoryEditor"/>.</value>
    [Parameter] public TextFrameElement? TextFrame { get; set; }
    /// <summary>
    /// Gets or sets the publication name value that forms part of the story editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The publication name value exposed by <see cref="StoryEditor"/>.</value>
    [Parameter] public string PublicationName { get; set; } = "Publication";
    /// <summary>
    /// Gets or sets the page name value that forms part of the story editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The page name value exposed by <see cref="StoryEditor"/>.</value>
    [Parameter] public string PageName { get; set; } = "Page";
    /// <summary>
    /// Gets or sets the page number value that forms part of the story editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The page number value exposed by <see cref="StoryEditor"/>.</value>
    [Parameter] public int PageNumber { get; set; } = 1;
    /// <summary>
    /// Gets or sets the page count that quantifies the associated story editor data.
    /// </summary>
    /// <value>The page count value exposed by <see cref="StoryEditor"/>.</value>
    [Parameter] public int PageCount { get; set; } = 1;
    /// <summary>
    /// Gets or sets a value indicating whether open AI on show applies to the story editor state.
    /// </summary>
    /// <value>The open AI on show value exposed by <see cref="StoryEditor"/>.</value>
    [Parameter] public bool OpenAiOnShow { get; set; }
    /// <summary>
    /// Gets or sets the saved value that forms part of the story editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The saved value exposed by <see cref="StoryEditor"/>.</value>
    [Parameter] public EventCallback<(byte[] Content, string PreviewHtml, string DocumentBackground, StoryStorageFormat Format)> Saved { get; set; }
    /// <summary>
    /// Gets or sets the cancelled value that forms part of the story editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The cancelled value exposed by <see cref="StoryEditor"/>.</value>
    [Parameter] public EventCallback Cancelled { get; set; }

    /// <summary>
    /// Stores the internal rich edit state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private DxRichEdit? _richEdit;
    /// <summary>
    /// Stores the internal self reference state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private DotNetObjectReference<StoryEditor>? _selfReference;
    /// <summary>
    /// Stores the internal selection state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private Selection _selection = default!;
    /// <summary>
    /// Stores the internal content state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private byte[] _content = [];
    /// <summary>
    /// Stores the internal loaded identifier state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private Guid? _loadedId;
    /// <summary>
    /// Stores the internal document format state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private DocumentFormat _documentFormat = DocumentFormat.OpenXml;
    /// <summary>
    /// Stores the internal editor revision state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private int _editorRevision;
    /// <summary>
    /// Stores the internal legacy conversion pending state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private bool _legacyConversionPending;
    /// <summary>
    /// Stores the internal upgrading legacy story state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private bool _upgradingLegacyStory;
    /// <summary>
    /// Stores the internal document load generation state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private int _documentLoadGeneration;
    /// <summary>
    /// Stores the internal mail merge settings content state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private RenderFragment? _mailMergeSettingsContent;
    /// <summary>
    /// Stores the internal error state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private string? _error;
    /// <summary>
    /// Stores the in-memory field data collection maintained internally by <see cref="StoryEditor"/> for its current workflow state.
    /// </summary>
    private IReadOnlyList<PublicationFieldRecord> _fieldData = [];
    /// <summary>
    /// Stores the internal story preview transfer identifier state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private string? _storyPreviewTransferId;
    /// <summary>
    /// Stores the internal story preview buffer state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private readonly System.Text.StringBuilder _storyPreviewBuffer = new();
    /// <summary>
    /// Stores the internal story preview expected length state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private int _storyPreviewExpectedLength;
    /// <summary>
    /// Stores the internal story preview expected chunks state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private int _storyPreviewExpectedChunks;
    /// <summary>
    /// Stores the internal story preview next chunk state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private int _storyPreviewNextChunk;
    /// <summary>
    /// Stores the internal story preview background state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private string _storyPreviewBackground = "transparent";
    /// <summary>
    /// Stores the internal story preview result state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private StoryPreviewResult? _storyPreviewResult;
    /// <summary>
    /// Stores the internal story preview transfer error state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private string? _storyPreviewTransferError;
    /// <summary>
    /// Stores the internal code workspace visible state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private bool _codeWorkspaceVisible;
    /// <summary>
    /// Stores the internal code language identifier state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private string _codeLanguageId = "csharp";
    /// <summary>
    /// Stores the internal code workspace text state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private string _codeWorkspaceText = "// PublisherStudio code block";
    /// <summary>
    /// Stores the internal code indent size state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private int _codeIndentSize = 4;
    /// <summary>
    /// Stores the in-memory code tokens collection maintained internally by <see cref="StoryEditor"/> for its current workflow state.
    /// </summary>
    private IReadOnlyList<CodeTokenSpan> _codeTokens = [];
    /// <summary>
    /// Stores the internal AI story panel visible state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private bool _aiStoryPanelVisible;
    /// <summary>
    /// Stores the internal AI story prompt state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private string _aiStoryPrompt = string.Empty;
    /// <summary>
    /// Stores the internal AI team key state used by <see cref="StoryEditor"/> while executing its surrounding workflow.
    /// </summary>
    private string _aiTeamKey = "general";
    /// <summary>
    /// Stores the in-memory AI proposals collection maintained internally by <see cref="StoryEditor"/> for its current workflow state.
    /// </summary>
    private IReadOnlyList<OrganicTextInsertionProposal> _aiProposals = [];
    /// <summary>
    /// Gets the code workspace summary value that forms part of the story editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The code workspace summary value exposed by <see cref="StoryEditor"/>.</value>
    private string CodeWorkspaceSummary => $"{CodeLanguages.Get(_codeLanguageId).DisplayName} · {_codeTokens.Count} recognized token(s) · {_codeWorkspaceText.Length} character(s)";
    /// <summary>
    /// Gets a value indicating whether use AI council applies to the story editor state.
    /// </summary>
    /// <value>The can use AI council value exposed by <see cref="StoryEditor"/>.</value>
    private bool CanUseAiCouncil => LocalGptConnection.State.IsLinked && LocalGptConnection.State.HasCapability("council.run");
    /// <summary>
    /// Gets a value indicating whether send AI story request applies to the story editor state.
    /// </summary>
    /// <value>The can send AI story request value exposed by <see cref="StoryEditor"/>.</value>
    private bool CanSendAiStoryRequest => CanUseAiCouncil && !string.IsNullOrWhiteSpace(_aiStoryPrompt) && TextFrame is not null;
    /// <summary>
    /// Gets a value indicating whether selected story text applies to the story editor state.
    /// </summary>
    /// <value>The has selected story text value exposed by <see cref="StoryEditor"/>.</value>
    private bool HasSelectedStoryText => _selection?.Intervals is { Count: > 0 } && _selection.Intervals[0].Length > 0;
    /// <summary>
    /// Gets the AI council teams collection maintained or exposed by this story editor instance for downstream processing.
    /// </summary>
    /// <value>The AI council teams value exposed by <see cref="StoryEditor"/>.</value>
    private IReadOnlyList<(string Key, string Name)> AiCouncilTeams
    {
        get
        {
            var keys = LocalGptConnection.State.RemoteCapabilities
                .Where(item => item.IsEnabled && item.IsOnline && string.Equals(item.Key, "council.run", StringComparison.OrdinalIgnoreCase))
                .SelectMany(item => item.Skills)
                .Where(key => !string.IsNullOrWhiteSpace(key))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            if (keys.Count == 0) keys.Add("general");
            return keys.Select(key => (key, key switch
            {
                "general" => "General Council",
                "learning-round" => "Learning Round",
                "spreadsheet-team" => "Spreadsheet Team",
                "openscad-team" => "OpenSCAD Team",
                _ => key
            })).ToList();
        }
    }
    /// <summary>
    /// Gets the matching AI proposals collection maintained or exposed by this story editor instance for downstream processing.
    /// </summary>
    /// <value>The matching AI proposals value exposed by <see cref="StoryEditor"/>.</value>
    private IReadOnlyList<OrganicTextInsertionProposal> MatchingAiProposals => _aiProposals
        .Where(proposal => TextFrame is not null &&
            (string.Equals(proposal.Target, TextFrame.Name, StringComparison.OrdinalIgnoreCase)
             || string.Equals(proposal.Target, AiProposalTarget, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(proposal => proposal.CreatedUtc)
        .ToList();
    /// <summary>
    /// Gets the AI proposal target value that forms part of the story editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The AI proposal target value exposed by <see cref="StoryEditor"/>.</value>
    private string AiProposalTarget => TextFrame is null ? "PublisherStudio story" : $"StoryEditor:{TextFrame.Id}:{TextFrame.Name}";

    /// <summary>
    /// Performs customize rich edit ribbon for <see cref="StoryEditor"/>, keeping the operation consistent with the state and invariants of the surrounding story editor workflow.
    /// </summary>
    /// <param name="ribbon">Ribbon dependency used by the story editor workflow to provide the corresponding application capability.</param>
    private void CustomizeRichEditRibbon(IRibbon ribbon)
    {
        try
        {
            var fontGroup = ribbon.Tabs[RichEditRibbonTabNames.Home].Groups[RichEditRibbonGroupNames.HomeFont];
            var fontNameItem = fontGroup.Items[RichEditBarItemNames.FontName];
            if (fontNameItem.Type != BarItemTypes.ComboBox) return;

            var fontNameComboBox = (IBarComboBox)fontNameItem;
            // Preserve DevExpress' built-in entries and append the operating-system catalog.
            // Clearing the collection left the control at "No data to display" whenever font
            // discovery was delayed or one duplicate entry was rejected by the ribbon runtime.
            foreach (var font in SystemFonts.FontFamilies)
            {
                try { fontNameComboBox.Items.Add(font, font); }
                catch (ArgumentException) { }
                catch (InvalidOperationException) { }
            }
            fontNameComboBox.AllowUserInput = true;
            fontNameComboBox.Tooltip = "Select an installed system font or type another font family.";
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(StoryEditor)}.{nameof(CustomizeRichEditRibbon)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Handles the initialized lifecycle or event notification for <see cref="StoryEditor"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnInitialized()
    {
        try
        {
            LocalGptConnection.Changed += OnOrganicStateChanged;
            OrganicResults.Changed += OnOrganicStateChanged;
            RefreshAiProposals();
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(StoryEditor)}.{nameof(OnInitialized)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Handles the parameters set lifecycle or event notification for <see cref="StoryEditor"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnParametersSet()
    {
        try
        {
            if (Visible && TextFrame is not null && _loadedId != TextFrame.Id)
            {
                _editorRevision++;
                _documentLoadGeneration++;
                _mailMergeSettingsContent = null;
                var hasStoredStoryContent = TextFrame.DocumentContent is { Length: > 0 };
                _content = hasStoredStoryContent
                    ? TextFrame.DocumentContent.ToArray()
                    : RichTextFactory.CreateOpenXmlFromPreviewHtml(TextFrame.PreviewHtml);
                _documentFormat = hasStoredStoryContent && TextFrame.StoryFormat == StoryStorageFormat.Html
                    ? DocumentFormat.Html
                    : DocumentFormat.OpenXml;
                _legacyConversionPending = hasStoredStoryContent && TextFrame.StoryFormat == StoryStorageFormat.Html;
                _upgradingLegacyStory = false;
                _loadedId = TextFrame.Id;
                _error = null;
                RefreshAiProposals();
                _aiStoryPanelVisible = OpenAiOnShow && CanUseAiCouncil;
                _fieldData =
                [
                    new PublicationFieldRecord
                    {
                        PublicationName = PublicationName,
                        PageName = PageName,
                        StoryName = TextFrame.Name,
                        PageNumber = PageNumber,
                        PageCount = PageCount,
                        CurrentDate = DateTime.Today,
                        CurrentDateTime = DateTime.Now
                    }
                ];
            }

            if (!Visible)
            {
                _documentLoadGeneration++;
                _mailMergeSettingsContent = null;
                _loadedId = null;
                _legacyConversionPending = false;
