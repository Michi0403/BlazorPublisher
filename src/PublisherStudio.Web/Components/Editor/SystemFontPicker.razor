@inject SystemFontCatalog SystemFonts
@inject ILogger<SystemFontPicker> Logger
<div class="razor-component-boundary">
<DxFormLayout CssClass="razor-component-layout-owner SystemFontPicker">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext001">
            <DxComboBox TData="string" TValue="string" Data="@SystemFonts.FontFamilies"
                        Text="@Value"
                        TextChanged="HandleTextChanged"
                        AllowUserInput="true"
                        SearchMode="ListSearchMode.AutoSearch"
                        SearchFilterCondition="ListSearchFilterCondition.Contains"
                        SearchDelay="250"
                        ListRenderMode="ListRenderMode.Virtual"
                        NullText="Type or select a system font"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        CssClass="@FontPickerCssClass"
                        Attributes="@FontPickerAttributes" />
        </Template>
    </DxFormLayoutItem>
</DxFormLayout>
</div>

@code {
    /// <summary>Gets or sets the current font-family text shown by the DevExpress system-font picker.</summary>
    /// <value>The current font family.</value>
    [Parameter] public string Value { get; set; } = string.Empty;

    /// <summary>Gets or sets an optional CSS class applied to the DevExpress font picker.</summary>
    /// <value>The optional CSS class.</value>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Gets or sets the callback invoked when the selected or custom font family changes.</summary>
    /// <value>The font change callback.</value>
    [Parameter] public EventCallback<ChangeEventArgs> Changed { get; set; }

    /// <summary>Gets the CSS class applied to the DevExpress font picker without mixed Razor attribute content.</summary>
    /// <value>The required picker class followed by the optional caller-provided class.</value>
    private string FontPickerCssClass => string.IsNullOrWhiteSpace(CssClass) ? "system-font-picker" : $"system-font-picker {CssClass}";

    /// <summary>Supplies accessible metadata without falling back to native input/select/datalist controls.</summary>
    /// <value>ARIA, title, spellcheck, and autocomplete attributes applied to the DevExpress font editor.</value>
    private IReadOnlyDictionary<string, object> FontPickerAttributes { get; } = new Dictionary<string, object>
    {
        ["aria-label"] = "Installed operating-system fonts",
        ["title"] = "Select an installed system font or type another font family",
        ["spellcheck"] = "false",
        ["autocomplete"] = "off"
    };

    /// <summary>Forwards the DevExpress ComboBox edit text through the component's established change contract.</summary>
    /// <param name="text">Selected or custom font-family text.</param>
    /// <returns>A task that completes when the parent accepted the change.</returns>
    private Task HandleTextChanged(string? text)
    {
        try
        {
            return Changed.InvokeAsync(new ChangeEventArgs { Value = text ?? string.Empty });
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, "Component method {Component}.{Method} failed.", nameof(SystemFontPicker), nameof(HandleTextChanged));
            throw;
        }
    }
}
