@inject SystemFontCatalog SystemFonts

@inject ILogger<SystemFontPicker> Logger
<div class="system-font-picker @CssClass">
    <input type="text"
           class="system-font-picker-input"
           value="@Value"
           list="@_listId"
           autocomplete="off"
           spellcheck="false"
           placeholder="Type or select a system font"
           title="Select an installed system font or type another font family"
           @onchange="HandleChanged" />
    <select class="system-font-picker-dropdown"
            value="@Value"
            title="Installed operating-system fonts"
            aria-label="Installed operating-system fonts"
            @onchange="HandleChanged">
        <option value="">Installed fonts…</option>
        @foreach (var font in SystemFonts.FontFamilies)
        {
            <option value="@font">@font</option>
        }
    </select>
</div>
<datalist id="@_listId">
    @foreach (var font in SystemFonts.FontFamilies)
    {
        <option value="@font"></option>
    }
</datalist>

@code {

    /// <summary>
    /// Stores the internal list identifier state used by <see cref="SystemFontPicker"/> while executing its surrounding workflow.
    /// </summary>
    private readonly string _listId = $"publisher-system-fonts-{Guid.NewGuid():N}";

    /// <summary>
    /// Gets or sets the value value that forms part of the system font picker state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The value value exposed by <see cref="SystemFontPicker"/>.</value>
    [Parameter] public string Value { get; set; } = string.Empty;
    /// <summary>
    /// Gets or sets the CSS class value that forms part of the system font picker state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The CSS class value exposed by <see cref="SystemFontPicker"/>.</value>
    [Parameter] public string? CssClass { get; set; }
    /// <summary>
    /// Gets or sets the changed value that forms part of the system font picker state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The changed value exposed by <see cref="SystemFontPicker"/>.</value>
    [Parameter] public EventCallback<ChangeEventArgs> Changed { get; set; }

    /// <summary>
    /// Handles changed for <see cref="SystemFontPicker"/>, keeping the operation consistent with the state and invariants of the surrounding system font picker workflow.
    /// </summary>
    /// <param name="args">Args value supplied to the system font picker operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task HandleChanged(ChangeEventArgs args) {
        try
        {
            return Changed.InvokeAsync(args);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(SystemFontPicker)}.{nameof(HandleChanged)} failed.");
            throw;
        }
    }

}
