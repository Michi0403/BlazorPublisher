@namespace PublisherStudio.Components.Editor
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject PublicationMediaAssetStore MediaAssets

@inject ILogger<VideoMediaView> Logger
<div class="publication-video-renderer" style="background:@Item.Background">
    <video id="@VideoId"
           class="publication-video-source"
           src="@MediaAssets.GetOrRegister(Item)"
           poster="@Poster"
           controls="@Item.ShowControls"
           muted="@Item.Muted"
           loop="@Item.Loop"
           preload="metadata"
           playsinline
           data-media-control
           draggable="false"
           style="object-fit:@FitMode">
        @foreach (var segment in Item.EffectiveSegments)
        {
            <source data-media-segment
                    src="@MediaAssets.GetOrRegister(segment)"
                    type="@segment.MimeType"
                    data-media-name="@segment.Name"
                    data-media-trim-start="@Inv(segment.TrimStartSeconds)"
                    data-media-trim-end="@Inv(segment.EffectiveTrimEndSeconds)"
                    data-media-poster="@segment.PosterDataUrl" />
        }
    </video>
    <canvas id="@CanvasId" class="publication-video-effect-canvas" aria-hidden="true"></canvas>
    <span class="media-object-badge">▶ @Time(Item.TimelineLengthSeconds)</span>
</div>

@code {

    /// <summary>
    /// Gets or sets the item value that forms part of the video media view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The item value exposed by <see cref="VideoMediaView"/>.</value>
    [Parameter, EditorRequired] public VideoElement Item { get; set; } = default!;

    /// <summary>
    /// Gets the stable runtime key used to identify or correlate this video media view instance with related application state.
    /// </summary>
    /// <value>The runtime key value exposed by <see cref="VideoMediaView"/>.</value>
    private string RuntimeKey => $"publication-video-{Item.Id:N}";
    /// <summary>
    /// Gets the stable video identifier used to identify or correlate this video media view instance with related application state.
    /// </summary>
    /// <value>The video identifier value exposed by <see cref="VideoMediaView"/>.</value>
    private string VideoId => $"publication-video-source-{Item.Id:N}";
    /// <summary>
    /// Gets the stable canvas identifier used to identify or correlate this video media view instance with related application state.
    /// </summary>
    /// <value>The canvas identifier value exposed by <see cref="VideoMediaView"/>.</value>
    private string CanvasId => $"publication-video-effects-{Item.Id:N}";
    /// <summary>
    /// Tracks whether the browser video-effects runtime has installed this media instance; static prerender instances remain false.
    /// </summary>
    private bool _browserAttached;
    /// <summary>
    /// Gets the poster value that forms part of the video media view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The poster value exposed by <see cref="VideoMediaView"/>.</value>
    private string Poster => Item.EffectiveSegments.FirstOrDefault()?.PosterDataUrl is { Length: > 0 } poster ? poster : Item.PosterDataUrl;
    /// <summary>
    /// Gets the fit mode value that forms part of the video media view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The fit mode value exposed by <see cref="VideoMediaView"/>.</value>
    private string FitMode => Item.FitMode switch
    {
        PublicationVideoFitMode.Contain => "contain",
        PublicationVideoFitMode.Stretch => "fill",
        _ => "cover"
    };

    /// <summary>
    /// Handles the after render async lifecycle or event notification for <see cref="VideoMediaView"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="firstRender">Value indicating whether first render should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            var segment = Item.EffectiveSegments.FirstOrDefault();
            if (segment is null) return;
            try
            {
                await JS.InvokeVoidAsync("publisherVideoEffects.installById", RuntimeKey, VideoId, CanvasId, new
                {
                    fitMode = FitMode,
                    forceCanvas = segment.VideoLayers.Any(LayerNeedsCanvas),
                    layers = segment.VideoLayers.Select(LayerPayload).ToArray()
                }).ConfigureAwait(true);
                _browserAttached = true;
            }
            catch { }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(VideoMediaView)}.{nameof(OnAfterRenderAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs layer needs canvas for <see cref="VideoMediaView"/>, keeping the operation consistent with the state and invariants of the surrounding video media view workflow.
    /// </summary>
    /// <param name="layer">Layer value supplied to the video media view operation and used when producing its result.</param>
    /// <returns>A value indicating whether the requested condition or operation succeeded.</returns>
    private bool LayerNeedsCanvas(VideoEffectLayer layer) {
        try
        {
            return layer.Kind == VideoEffectLayerKind.Blob3D || !layer.Visible || layer.Opacity < .999 || layer.BlendMode != VideoEffectBlendMode.Normal ||
        layer.HasTemporalRange || layer.Region.Points.Count >= 3 || layer.Filters.Any(filter => filter.Enabled);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(VideoMediaView)}.{nameof(LayerNeedsCanvas)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs layer payload for <see cref="VideoMediaView"/>, keeping the operation consistent with the state and invariants of the surrounding video media view workflow.
    /// </summary>
    /// <param name="layer">Layer value supplied to the video media view operation and used when producing its result.</param>
    /// <returns>The object produced by the operation.</returns>
    private object LayerPayload(VideoEffectLayer layer) {
        try
        {
            return new
    {
        id = layer.Id.ToString("D"),
        layer.Name,
        layer.Visible,
        kind = layer.Kind.ToString(),
        layer.Opacity,
        blendMode = layer.BlendMode.ToString(),
        layer.HasTemporalRange,
        layer.TemporalStartSeconds,
        layer.TemporalEndSeconds,
        layer.MorphEnabled,
        layer.AnimateMorph,
        layer.MorphAmount,
        layer.AnimationSpeed,
        layer.Depth,
        layer.Roundness,
        htmlExportSupport = layer.HtmlExportSupport.ToString(),
        region = new
        {
            layer.Region.Inverted,
            points = layer.Region.Points.Select(point => new { point.X, point.Y }).ToArray()
        },
        morphRegion = new
        {
            layer.MorphRegion.Inverted,
            points = layer.MorphRegion.Points.Select(point => new { point.X, point.Y }).ToArray()
        },
        filters = layer.Filters.Select(filter => new
        {
            id = filter.Id.ToString("D"),
            kind = filter.Kind.ToString(),
            filter.Enabled,
            filter.Amount,
            filter.SecondaryAmount,
            filter.TertiaryAmount,
            filter.ResidualOpacity,
            filter.Color,
            htmlExportSupport = filter.HtmlExportSupport.ToString()
        }).ToArray()
    };
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(VideoMediaView)}.{nameof(LayerPayload)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Releases resources owned by <see cref="VideoMediaView"/> and leaves the video media view workflow in a safely disposed state.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_browserAttached)
            {
                try { await JS.InvokeVoidAsync("publisherVideoEffects.dispose", RuntimeKey).ConfigureAwait(true); }
                catch { }
                finally { _browserAttached = false; }
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(VideoMediaView)}.{nameof(DisposeAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs time for <see cref="VideoMediaView"/>, keeping the operation consistent with the state and invariants of the surrounding video media view workflow.
    /// </summary>
    /// <param name="seconds">Seconds value supplied to the video media view operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string Time(double seconds) {
        try
        {
            return TimeSpan.FromSeconds(Math.Max(0, seconds)).ToString(seconds >= 3600 ? @"h\:mm\:ss" : @"m\:ss");
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(VideoMediaView)}.{nameof(Time)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Performs inv for <see cref="VideoMediaView"/>, keeping the operation consistent with the state and invariants of the surrounding video media view workflow.
    /// </summary>
    /// <param name="value">Value value supplied to the video media view operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string Inv(double value) {
        try
        {
            return value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(VideoMediaView)}.{nameof(Inv)} failed.");
            throw;
        }
    }

}
