@namespace PublisherStudio.Components.Editor
@implements IAsyncDisposable

@inject ILogger<WebDataRefreshHost> Logger
@code {

    /// <summary>
    /// Gets or sets the state value that forms part of the web data refresh host state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The state value exposed by <see cref="WebDataRefreshHost"/>.</value>
    [Parameter, EditorRequired] public EditorStateService State { get; set; } = default!;

    /// <summary>
    /// Stores the cancellation source used by <see cref="WebDataRefreshHost"/> to stop its current background or asynchronous operation.
    /// </summary>
    private readonly CancellationTokenSource _cancellation = new();
    /// <summary>
    /// Stores the internal loop state used by <see cref="WebDataRefreshHost"/> while executing its surrounding workflow.
    /// </summary>
    private Task? _loop;
    /// <summary>
    /// Stores the internal refreshing state used by <see cref="WebDataRefreshHost"/> while executing its surrounding workflow.
    /// </summary>
    private int _refreshing;
    /// <summary>
    /// Stores the internal observed document identifier state used by <see cref="WebDataRefreshHost"/> while executing its surrounding workflow.
    /// </summary>
    private Guid _observedDocumentId;

    /// <summary>
    /// Handles the after render lifecycle or event notification for <see cref="WebDataRefreshHost"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="firstRender">Value indicating whether first render should apply to this operation.</param>
    protected override void OnAfterRender(bool firstRender)
    {
        try
        {
            if (firstRender) _loop = RunAsync(_cancellation.Token);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(WebDataRefreshHost)}.{nameof(OnAfterRender)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs run for <see cref="WebDataRefreshHost"/>, keeping the operation consistent with the state and invariants of the surrounding web data refresh host workflow.
    /// </summary>
    /// <param name="cancellationToken">Cancellation token that allows the caller to stop the asynchronous operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task RunAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            try
            {
                while (!cancellationToken.IsCancellationRequested)
                {
                    if (_observedDocumentId != State.Document.Id)
                    {
                        _observedDocumentId = State.Document.Id;
                        await RefreshAsync(onOpen: true, cancellationToken).ConfigureAwait(true);
                    }
                    if (!await timer.WaitForNextTickAsync(cancellationToken).ConfigureAwait(true)) break;
                    if (State.HasDueWebData) await RefreshAsync(onOpen: false, cancellationToken).ConfigureAwait(true);
                }
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(WebDataRefreshHost)}.{nameof(RunAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs refresh for <see cref="WebDataRefreshHost"/>, keeping the operation consistent with the state and invariants of the surrounding web data refresh host workflow.
    /// </summary>
    /// <param name="onOpen">Value indicating whether on open should apply to this operation.</param>
    /// <param name="cancellationToken">Cancellation token that allows the caller to stop the asynchronous operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task RefreshAsync(bool onOpen, CancellationToken cancellationToken)
    {
        try
        {
            if (Interlocked.Exchange(ref _refreshing, 1) != 0) return;
            try
            {
                if (onOpen)
                    await InvokeAsync(() => State.RefreshWebDataOnOpenAsync(cancellationToken)).ConfigureAwait(true);
                else
                    await InvokeAsync(() => State.RefreshWebDataAsync(force: false, cancellationToken: cancellationToken)).ConfigureAwait(true);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
            catch (Exception ex) { Console.Error.WriteLine($"Web data refresh failed: {ex}"); }
            finally { Interlocked.Exchange(ref _refreshing, 0); }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(WebDataRefreshHost)}.{nameof(RefreshAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Releases resources owned by <see cref="WebDataRefreshHost"/> and leaves the web data refresh host workflow in a safely disposed state.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    public async ValueTask DisposeAsync()
    {
        try
        {
            _cancellation.Cancel();
            if (_loop is not null)
            {
                try { await _loop.ConfigureAwait(true); }
                catch (OperationCanceledException) { }
            }
            _cancellation.Dispose();
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(WebDataRefreshHost)}.{nameof(DisposeAsync)} failed.");
            throw;
        }
    }

}
