    }
    /// <summary>
    /// Performs s curve preset for <see cref="WordArtPathEditor"/>, keeping the operation consistent with the state and invariants of the surrounding word art path editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
