    /// </summary>
    /// <param name="enabled">Value indicating whether enabled should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task SetDrawModeAsync(bool enabled)
    {
        try
        {
            if (_module is not null)
                await _module.InvokeVoidAsync("setWordArtPathDrawMode", EditorId, enabled).ConfigureAwait(true);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(WordArtPathEditor)}.{nameof(SetDrawModeAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs commit word art path for <see cref="WordArtPathEditor"/>, keeping the operation consistent with the state and invariants of the surrounding word art path editor workflow.
    /// </summary>
    /// <param name="points">Points value supplied to the word art path editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    [JSInvokable]
    public async Task CommitWordArtPath(WordArtPathPoint[] points)
    {
        try
        {
            _drawingArmed = false;
            var normalized = WordArtGeometry.Normalize(points);
            await PathChanged.InvokeAsync(normalized).ConfigureAwait(true);
            await InvokeAsync(StateHasChanged).ConfigureAwait(true);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(WordArtPathEditor)}.{nameof(CommitWordArtPath)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Releases resources owned by <see cref="WordArtPathEditor"/> and leaves the word art path editor workflow in a safely disposed state.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null && _initialized)
            {
                try { await _module.InvokeVoidAsync("disposeWordArtPathEditor", EditorId).ConfigureAwait(true); }
                catch (JSDisconnectedException) { }
            }
            _self?.Dispose();
            try
            {
                if (_module is not null) await _module.DisposeAsync().ConfigureAwait(true);
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(WordArtPathEditor)}.{nameof(DisposeAsync)} failed.");
            throw;
        }
    }

}
