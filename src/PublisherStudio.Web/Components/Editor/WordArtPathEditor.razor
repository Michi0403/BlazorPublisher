@namespace PublisherStudio.Components.Editor
@implements IAsyncDisposable
@inject IJSRuntime JS

@inject ILogger<WordArtPathEditor> Logger
<div class="wordart-path-editor">
    <div class="wordart-path-heading">
        <strong>Custom text path</strong>
        <span>Choose a curve or draw one. Drag the round points to refine it.</span>
    </div>

    <div class="wordart-path-presets" role="group" aria-label="WordArt path presets">
        <button type="button" title="Straight" @onclick="StraightPresetAsync">—</button>
        <button type="button" title="Rising" @onclick="RisePresetAsync">↗</button>
        <button type="button" title="Falling" @onclick="FallPresetAsync">↘</button>
        <button type="button" title="Arch up" @onclick="ArchUpPresetAsync">⌒</button>
        <button type="button" title="Arch down" @onclick="ArchDownPresetAsync">⌣</button>
        <button type="button" title="Gentle wave" @onclick="GentleWavePresetAsync">∿</button>
        <button type="button" title="S curve" @onclick="SCurvePresetAsync">S</button>
        <button type="button" title="Circular arc" @onclick="CircleArcPresetAsync">◠</button>
    </div>

    <svg id="@EditorId"
         class="wordart-path-canvas @(_drawingArmed ? "drawing-armed" : null)"
         style="aspect-ratio:@EditorAspectRatio"
         viewBox="0 0 1000 300"
         preserveAspectRatio="none"
         role="application"
         aria-label="Draw and edit the WordArt baseline">
        <defs>
            <pattern id="@GridId" width="50" height="50" patternUnits="userSpaceOnUse">
                <path d="M 50 0 L 0 0 0 50" class="wordart-path-grid-line" />
            </pattern>
        </defs>
        <rect class="wordart-path-background" width="1000" height="300" fill="@GridFill" />
        <line class="wordart-path-center-line" x1="0" y1="150" x2="1000" y2="150" />
        <path class="wordart-path-preview" data-wordart-editor-path d="@PathData" />
        <g data-wordart-editor-points></g>
    </svg>

    <div class="wordart-path-actions">
        <DxButton Text="@(_drawingArmed ? "Draw on the canvas…" : "Draw freehand")" Click="ArmDrawingAsync" CssClass="path-action-primary" />
        <DxButton Text="Reverse" Click="ReverseAsync" />
        <DxButton Text="Fewer points" Enabled="@((Item.CustomPathPoints?.Count ?? 0) > 4)" Click="ReduceAsync" />
    </div>
    <p class="property-note">Draw from left to right for normal reading direction. A new stroke replaces the previous path; Undo restores it.</p>
</div>

@code {

    /// <summary>
    /// Gets or sets the item value that forms part of the word art path editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The item value exposed by <see cref="WordArtPathEditor"/>.</value>
    [Parameter, EditorRequired] public WordArtElement Item { get; set; } = default!;
    /// <summary>
    /// Gets or sets the path changed used by this word art path editor instance to locate the associated file-system resource.
    /// </summary>
    /// <value>The path changed value exposed by <see cref="WordArtPathEditor"/>.</value>
    [Parameter] public EventCallback<List<WordArtPathPoint>> PathChanged { get; set; }

    /// <summary>
    /// Stores the JavaScript object reference dependency used by <see cref="WordArtPathEditor"/> to delegate that application responsibility to its owning collaborator.
    /// </summary>
    private IJSObjectReference? _module;
    /// <summary>
    /// Stores the internal self state used by <see cref="WordArtPathEditor"/> while executing its surrounding workflow.
    /// </summary>
    private DotNetObjectReference<WordArtPathEditor>? _self;
    /// <summary>
    /// Stores the internal initialized state used by <see cref="WordArtPathEditor"/> while executing its surrounding workflow.
    /// </summary>
    private bool _initialized;
    /// <summary>
    /// Stores the internal drawing armed state used by <see cref="WordArtPathEditor"/> while executing its surrounding workflow.
    /// </summary>
    private bool _drawingArmed;
    /// <summary>
    /// Gets the stable editor identifier used to identify or correlate this word art path editor instance with related application state.
    /// </summary>
    /// <value>The editor identifier value exposed by <see cref="WordArtPathEditor"/>.</value>
    private string EditorId => $"wordart-path-editor-{Item.Id:N}";
    /// <summary>
    /// Gets the stable grid identifier used to identify or correlate this word art path editor instance with related application state.
    /// </summary>
    /// <value>The grid identifier value exposed by <see cref="WordArtPathEditor"/>.</value>
    private string GridId => $"wordart-path-grid-{Item.Id:N}";
    /// <summary>
    /// Gets the grid fill value that forms part of the word art path editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The grid fill value exposed by <see cref="WordArtPathEditor"/>.</value>
    private string GridFill => $"url(#{GridId})";
    /// <summary>
    /// Gets the path data used by this word art path editor instance to locate the associated file-system resource.
    /// </summary>
    /// <value>The path data value exposed by <see cref="WordArtPathEditor"/>.</value>
    private string PathData => WordArtGeometry.Build(Item.CustomPathPoints);
    /// <summary>
    /// Gets the editor aspect ratio value that forms part of the word art path editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The editor aspect ratio value exposed by <see cref="WordArtPathEditor"/>.</value>
    private string EditorAspectRatio => Math.Clamp(Item.Width / Math.Max(Item.Height, 1), .35, 6).ToString("0.###", CultureInfo.InvariantCulture);

    /// <summary>
    /// Handles the after render async lifecycle or event notification for <see cref="WordArtPathEditor"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="firstRender">Value indicating whether first render should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/publisherInterop.js").ConfigureAwait(true);
            _self ??= DotNetObjectReference.Create(this);

            if (!_initialized)
            {
                await _module.InvokeVoidAsync("initializeWordArtPathEditor", EditorId, _self, Item.CustomPathPoints).ConfigureAwait(true);
                _initialized = true;
            }
            else
            {
                await _module.InvokeVoidAsync("updateWordArtPathEditor", EditorId, Item.CustomPathPoints).ConfigureAwait(true);
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(WordArtPathEditor)}.{nameof(OnAfterRenderAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs straight preset for <see cref="WordArtPathEditor"/>, keeping the operation consistent with the state and invariants of the surrounding word art path editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task StraightPresetAsync() {
        try
        {
            return ApplyPresetAsync("Straight");
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(WordArtPathEditor)}.{nameof(StraightPresetAsync)} failed.");
            throw;
        }
    }
