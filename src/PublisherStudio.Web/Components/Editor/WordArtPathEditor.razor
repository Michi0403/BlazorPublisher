    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ArmDrawingAsync()
    {
        try
        {
            _drawingArmed = !_drawingArmed;
            await SetDrawModeAsync(_drawingArmed).ConfigureAwait(true);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(WordArtPathEditor)}.{nameof(ArmDrawingAsync)} failed.");
            throw;
        }
    }

