            throw;
        }
    }

    /// <summary>
    /// Applies preset for <see cref="WordArtPathEditor"/>, keeping the operation consistent with the state and invariants of the surrounding word art path editor workflow.
    /// </summary>
    /// <param name="key">Key value supplied to the word art path editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ApplyPresetAsync(string key)
    {
        try
        {
            _drawingArmed = false;
            await SetDrawModeAsync(false).ConfigureAwait(true);
            await PathChanged.InvokeAsync(WordArtGeometry.CreatePreset(key)).ConfigureAwait(true);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(WordArtPathEditor)}.{nameof(ApplyPresetAsync)} failed.");
            throw;
        }
    }

    /// <summary>
