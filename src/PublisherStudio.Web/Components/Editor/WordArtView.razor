@namespace PublisherStudio.Components.Editor
@inject PublicationMediaAssetStore MediaAssets

@inject ILogger<WordArtView> Logger
<svg class="wordart-svg"
     viewBox="0 0 1000 300"
     preserveAspectRatio="none"
     role="img"
     aria-label="@DisplayText">
    <defs>
        <linearGradient id="@GradientId"
                        gradientUnits="userSpaceOnUse"
                        x1="0" y1="0" x2="0" y2="300">
            <stop offset="0%" stop-color="@SecondaryColor" />
            <stop offset="100%" stop-color="@FillColor" />
        </linearGradient>

        @if (Item.Warp != WordArtWarp.None)
        {
            <path id="@PathId" d="@WarpPath" fill="none" />
        }

        @if (UsesMediaFill)
        {
            <mask id="@MediaMaskId" maskUnits="userSpaceOnUse" x="0" y="0" width="1000" height="300">
                <rect x="0" y="0" width="1000" height="300" fill="black" />
                @if (Item.Warp == WordArtWarp.None)
                {
                    <SvgWordArtText CssClass="wordart-media-mask"
                                    X="500" Y="150"
                                    TextAnchor="middle"
                                    DominantBaseline="middle"
                                    FontFamily="@FontFamily"
                                    FontSize="@FontSize"
                                    FontWeight="@FontWeight"
                                    FontStyle="@FontStyle"
                                    LetterSpacing="@LetterSpacing"
                                    Fill="#ffffff"
                                    Text="@DisplayText" />
                }
                else
                {
                    <SvgWordArtText CssClass="wordart-media-mask"
                                    X="0" Y="0" Dy="@Inv(Item.PathBaselineOffset)"
                                    TextAnchor="middle"
                                    FontFamily="@FontFamily"
                                    FontSize="@FontSize"
                                    FontWeight="@FontWeight"
                                    FontStyle="@FontStyle"
                                    LetterSpacing="@LetterSpacing"
                                    Fill="#ffffff"
                                    PathHref="@PathHref"
                                    PathStartOffset="@PathStartOffset"
                                    PathTextAnchor="middle"
                                    Text="@DisplayText" />
                }
            </mask>
        }
    </defs>

    @if (Item.ShadowEnabled)
    {
        @if (Item.Warp == WordArtWarp.None)
        {
            <SvgWordArtText CssClass="wordart-shadow-face"
                            X="500" Y="150" Dx="10" Dy="12"
                            TextAnchor="middle"
                            DominantBaseline="middle"
                            FontFamily="@FontFamily"
                            FontSize="@FontSize"
                            FontWeight="@FontWeight"
                            FontStyle="@FontStyle"
                            LetterSpacing="@LetterSpacing"
                            Fill="@ShadowColor"
                            FillOpacity="0.45"
                            Text="@DisplayText" />
        }
        else
        {
            <SvgWordArtText CssClass="wordart-shadow-face"
                            X="0" Y="0" Dx="10" Dy="@Inv(Item.PathBaselineOffset + 12)"
                            TextAnchor="middle"
                            FontFamily="@FontFamily"
                            FontSize="@FontSize"
                            FontWeight="@FontWeight"
                            FontStyle="@FontStyle"
                            LetterSpacing="@LetterSpacing"
                            Fill="@ShadowColor"
                            FillOpacity="0.45"
                            PathHref="@PathHref"
                            PathStartOffset="@PathStartOffset"
                            PathTextAnchor="middle"
                            Text="@DisplayText" />
        }
    }

    @foreach (var depth in ExtrusionLayers)
    {
        @if (Item.Warp == WordArtWarp.None)
        {
            <SvgWordArtText CssClass="wordart-extrusion"
                            X="500" Y="150"
                            Dx="@Inv(depth * 4)" Dy="@Inv(Item.PathBaselineOffset + depth * 4)"
                            TextAnchor="middle"
                            DominantBaseline="middle"
                            FontFamily="@FontFamily"
                            FontSize="@FontSize"
                            FontWeight="@FontWeight"
                            FontStyle="@FontStyle"
                            LetterSpacing="@LetterSpacing"
                            Fill="@ExtrudeColor"
                            Text="@DisplayText" />
        }
        else
        {
            <SvgWordArtText CssClass="wordart-extrusion"
                            X="0" Y="0"
                            Dx="@Inv(depth * 4)" Dy="@Inv(Item.PathBaselineOffset + depth * 4)"
                            TextAnchor="middle"
                            FontFamily="@FontFamily"
                            FontSize="@FontSize"
                            FontWeight="@FontWeight"
                            FontStyle="@FontStyle"
                            LetterSpacing="@LetterSpacing"
                            Fill="@ExtrudeColor"
                            PathHref="@PathHref"
                            PathStartOffset="@PathStartOffset"
                            PathTextAnchor="middle"
                            Text="@DisplayText" />
        }
    }

    @* A solid face remains below every advanced fill. It is the deterministic fallback for
       print engines, rasterizers, or browsers that reject a local paint server/media mask. *@
    @if (Item.Warp == WordArtWarp.None)
    {
        <SvgWordArtText CssClass="wordart-face wordart-face-fallback"
                        X="500" Y="150"
                        TextAnchor="middle"
                        DominantBaseline="middle"
                        FontFamily="@FontFamily"
                        FontSize="@FontSize"
                        FontWeight="@FontWeight"
                        FontStyle="@FontStyle"
                        LetterSpacing="@LetterSpacing"
                        Fill="@FillColor"
                        Text="@DisplayText" />
    }
    else
    {
        <SvgWordArtText CssClass="wordart-face wordart-face-fallback"
                        X="0" Y="0" Dy="@Inv(Item.PathBaselineOffset)"
                        TextAnchor="middle"
                        FontFamily="@FontFamily"
                        FontSize="@FontSize"
                        FontWeight="@FontWeight"
                        FontStyle="@FontStyle"
                        LetterSpacing="@LetterSpacing"
                        Fill="@FillColor"
                        PathHref="@PathHref"
                        PathStartOffset="@PathStartOffset"
                        PathTextAnchor="middle"
                        Text="@DisplayText" />
    }

    @if (EffectiveFillKind == WordArtFillKind.Gradient)
    {
        @if (Item.Warp == WordArtWarp.None)
        {
            <SvgWordArtText CssClass="wordart-face wordart-face-gradient"
                            X="500" Y="150"
                            TextAnchor="middle"
                            DominantBaseline="middle"
                            FontFamily="@FontFamily"
                            FontSize="@FontSize"
                            FontWeight="@FontWeight"
                            FontStyle="@FontStyle"
                            LetterSpacing="@LetterSpacing"
                            Fill="@GradientFill"
                            Text="@DisplayText" />
        }
        else
        {
            <SvgWordArtText CssClass="wordart-face wordart-face-gradient"
                            X="0" Y="0" Dy="@Inv(Item.PathBaselineOffset)"
                            TextAnchor="middle"
                            FontFamily="@FontFamily"
                            FontSize="@FontSize"
                            FontWeight="@FontWeight"
                            FontStyle="@FontStyle"
                            LetterSpacing="@LetterSpacing"
                            Fill="@GradientFill"
                            PathHref="@PathHref"
                            PathStartOffset="@PathStartOffset"
                            PathTextAnchor="middle"
                            Text="@DisplayText" />
        }
    }
    else if (UsesStaticMediaImage)
    {
        <image class="wordart-media-fill wordart-media-image"
               href="@StaticMediaSource"
               x="@MediaX" y="@MediaY" width="@MediaWidth" height="@MediaHeight"
               preserveAspectRatio="@MediaPreserveAspectRatio"
               mask="@MediaMask" />
    }
    else if (UsesLiveVideo)
    {
        <foreignObject class="wordart-media-fill wordart-media-video"
                       x="0" y="0" width="1000" height="300"
                       mask="@MediaMask">
            <div xmlns="http://www.w3.org/1999/xhtml" style="width:100%;height:100%;overflow:hidden;background:transparent;">
                <video src="@VideoMediaSource"
                       poster="@Item.FillMediaPosterDataUrl"
                       autoplay
                       muted
                       loop="@Item.FillMediaLoop"
                       playsinline
                       preload="metadata"
                       style="@VideoStyle"></video>
            </div>
        </foreignObject>
    }

    @* Keep the outline above picture/video content so it is never swallowed by the masked fill. *@
    @if (Item.Warp == WordArtWarp.None)
    {
        <SvgWordArtText CssClass="wordart-face wordart-face-outline"
                        X="500" Y="150"
                        TextAnchor="middle"
                        DominantBaseline="middle"
                        FontFamily="@FontFamily"
                        FontSize="@FontSize"
                        FontWeight="@FontWeight"
                        FontStyle="@FontStyle"
                        LetterSpacing="@LetterSpacing"
                        Fill="transparent"
                        Stroke="@OutlineColor"
                        StrokeWidth="@OutlineWidth"
                        PaintOrder="stroke"
                        Text="@DisplayText" />
    }
    else
    {
        <SvgWordArtText CssClass="wordart-face wordart-face-outline"
                        X="0" Y="0" Dy="@Inv(Item.PathBaselineOffset)"
                        TextAnchor="middle"
                        FontFamily="@FontFamily"
                        FontSize="@FontSize"
                        FontWeight="@FontWeight"
                        FontStyle="@FontStyle"
                        LetterSpacing="@LetterSpacing"
                        Fill="transparent"
                        Stroke="@OutlineColor"
                        StrokeWidth="@OutlineWidth"
                        PaintOrder="stroke"
                        PathHref="@PathHref"
                        PathStartOffset="@PathStartOffset"
                        PathTextAnchor="middle"
                        Text="@DisplayText" />
    }
</svg>

@code {

    /// <summary>
    /// Gets or sets the item value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The item value exposed by <see cref="WordArtView"/>.</value>
    [Parameter, EditorRequired] public WordArtElement Item { get; set; } = default!;
    /// <summary>
    /// Gets or sets the identifier prefix value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The identifier prefix value exposed by <see cref="WordArtView"/>.</value>
    [Parameter] public string IdPrefix { get; set; } = "canvas";
    /// <summary>
    /// Gets or sets a value indicating whether static media fill applies to the word art view state.
    /// </summary>
    /// <value>The static media fill value exposed by <see cref="WordArtView"/>.</value>
    [Parameter] public bool StaticMediaFill { get; set; }

    /// <summary>
    /// Gets the stable gradient identifier used to identify or correlate this word art view instance with related application state.
    /// </summary>
    /// <value>The gradient identifier value exposed by <see cref="WordArtView"/>.</value>
    private string GradientId => $"{IdPrefix}-wordart-gradient-{Item.Id:N}";
    /// <summary>
    /// Gets the stable path identifier used to identify or correlate this word art view instance with related application state.
    /// </summary>
    /// <value>The path identifier value exposed by <see cref="WordArtView"/>.</value>
    private string PathId => $"{IdPrefix}-wordart-path-{Item.Id:N}";
    /// <summary>
    /// Gets the stable media mask identifier used to identify or correlate this word art view instance with related application state.
    /// </summary>
    /// <value>The media mask identifier value exposed by <see cref="WordArtView"/>.</value>
    private string MediaMaskId => $"{IdPrefix}-wordart-media-mask-{Item.Id:N}";
    /// <summary>
    /// Gets the path href used by this word art view instance to locate the associated file-system resource.
    /// </summary>
    /// <value>The path href value exposed by <see cref="WordArtView"/>.</value>
    private string PathHref => $"#{PathId}";
    /// <summary>
    /// Gets the media mask value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The media mask value exposed by <see cref="WordArtView"/>.</value>
    private string MediaMask => $"url(#{MediaMaskId})";
    /// <summary>
    /// Gets the gradient fill value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The gradient fill value exposed by <see cref="WordArtView"/>.</value>
    private string GradientFill => $"url(#{GradientId})";
    /// <summary>
    /// Gets the display text value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The display text value exposed by <see cref="WordArtView"/>.</value>
    private string DisplayText => string.IsNullOrWhiteSpace(Item.Text) ? "WordArt" : Item.Text;
    /// <summary>
    /// Gets the font family value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The font family value exposed by <see cref="WordArtView"/>.</value>
    private string FontFamily => string.IsNullOrWhiteSpace(Item.FontFamily) ? "Arial Black, Arial, sans-serif" : Item.FontFamily;
    /// <summary>
    /// Gets the font size that quantifies the associated word art view data.
    /// </summary>
    /// <value>The font size value exposed by <see cref="WordArtView"/>.</value>
    private string FontSize => Inv(Math.Clamp(Item.FontSizePt, 8, 300) * 3.5);
    /// <summary>
    /// Gets the font weight value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The font weight value exposed by <see cref="WordArtView"/>.</value>
    private string FontWeight => Item.Bold ? "700" : "400";
    /// <summary>
    /// Gets the font style value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The font style value exposed by <see cref="WordArtView"/>.</value>
    private string FontStyle => Item.Italic ? "italic" : "normal";
    /// <summary>
    /// Gets the letter spacing value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The letter spacing value exposed by <see cref="WordArtView"/>.</value>
    private string LetterSpacing => Inv(Math.Clamp(Item.LetterSpacing, -5, 30) * 2);
    /// <summary>
    /// Gets the fill color value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The fill color value exposed by <see cref="WordArtView"/>.</value>
    private string FillColor => SafeColor(Item.FillColor, "#2f75b5");
    /// <summary>
    /// Gets the secondary color value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The secondary color value exposed by <see cref="WordArtView"/>.</value>
    private string SecondaryColor => SafeColor(Item.SecondaryColor, "#8ec5ff");
    /// <summary>
    /// Gets the outline color value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The outline color value exposed by <see cref="WordArtView"/>.</value>
    private string OutlineColor => SafeColor(Item.OutlineColor, "#17365d");
    /// <summary>
    /// Gets the extrude color value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The extrude color value exposed by <see cref="WordArtView"/>.</value>
    private string ExtrudeColor => SafeColor(Item.ExtrudeColor, "#17365d");
    /// <summary>
    /// Gets the shadow color value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The shadow color value exposed by <see cref="WordArtView"/>.</value>
    private string ShadowColor => SafeColor(Item.ShadowColor, "#000000");
    /// <summary>
    /// Gets the outline width value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The outline width value exposed by <see cref="WordArtView"/>.</value>
    private string OutlineWidth => Inv(Math.Clamp(Item.OutlineWidth, 0, 20));
    /// <summary>
    /// Gets the extrusion layers collection maintained or exposed by this word art view instance for downstream processing.
    /// </summary>
    /// <value>The extrusion layers value exposed by <see cref="WordArtView"/>.</value>
    private IEnumerable<int> ExtrusionLayers => Enumerable.Range(1, Math.Clamp((int)Math.Round(Item.ExtrudeDepth), 0, 18)).Reverse();

    /// <summary>
    /// Gets the effective fill kind value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The effective fill kind value exposed by <see cref="WordArtView"/>.</value>
    private WordArtFillKind EffectiveFillKind => Item.FillKind == WordArtFillKind.Solid && Item.GradientFill
        ? WordArtFillKind.Gradient
        : Item.FillKind;
    /// <summary>
    /// Gets a value indicating whether uses media fill applies to the word art view state.
    /// </summary>
    /// <value>The uses media fill value exposed by <see cref="WordArtView"/>.</value>
    private bool UsesMediaFill => EffectiveFillKind is WordArtFillKind.Picture or WordArtFillKind.Video;
    /// <summary>
    /// Gets a value indicating whether picture source applies to the word art view state.
    /// </summary>
    /// <value>The has picture source value exposed by <see cref="WordArtView"/>.</value>
    private bool HasPictureSource => Item.FillMediaDataUrl.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase);
    /// <summary>
    /// Gets a value indicating whether video source applies to the word art view state.
    /// </summary>
    /// <value>The has video source value exposed by <see cref="WordArtView"/>.</value>
    private bool HasVideoSource => Item.FillMediaDataUrl.StartsWith("data:video/", StringComparison.OrdinalIgnoreCase);
    /// <summary>
    /// Gets a value indicating whether poster source applies to the word art view state.
    /// </summary>
    /// <value>The has poster source value exposed by <see cref="WordArtView"/>.</value>
    private bool HasPosterSource => Item.FillMediaPosterDataUrl.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase);
    /// <summary>
    /// Gets a value indicating whether uses static media image applies to the word art view state.
    /// </summary>
    /// <value>The uses static media image value exposed by <see cref="WordArtView"/>.</value>
    private bool UsesStaticMediaImage =>
        (EffectiveFillKind == WordArtFillKind.Picture && HasPictureSource) ||
        (EffectiveFillKind == WordArtFillKind.Video && (StaticMediaFill || !HasVideoSource) && HasPosterSource);
    /// <summary>
    /// Gets a value indicating whether uses live video applies to the word art view state.
    /// </summary>
    /// <value>The uses live video value exposed by <see cref="WordArtView"/>.</value>
    private bool UsesLiveVideo => EffectiveFillKind == WordArtFillKind.Video && !StaticMediaFill && HasVideoSource;
    /// <summary>
    /// Gets the video media source value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The video media source value exposed by <see cref="WordArtView"/>.</value>
    private string VideoMediaSource => UsesLiveVideo ? MediaAssets.Register(Item.Id, Item.FillMediaDataUrl, Item.FillMediaMimeType) : string.Empty;
    /// <summary>
    /// Gets the static media source value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The static media source value exposed by <see cref="WordArtView"/>.</value>
    private string StaticMediaSource => EffectiveFillKind == WordArtFillKind.Picture ? Item.FillMediaDataUrl : Item.FillMediaPosterDataUrl;
    /// <summary>
    /// Gets the media preserve aspect ratio value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The media preserve aspect ratio value exposed by <see cref="WordArtView"/>.</value>
    private string MediaPreserveAspectRatio => Item.FillMediaFitMode switch
    {
        PublicationVideoFitMode.Stretch => "none",
        PublicationVideoFitMode.Contain => "xMidYMid meet",
        _ => "xMidYMid slice"
    };
    /// <summary>
    /// Gets the media x value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The media x value exposed by <see cref="WordArtView"/>.</value>
    private string MediaX => Inv(-((Math.Clamp(Item.FillMediaScale, .1, 10) - 1) * 500) + Math.Clamp(Item.FillMediaOffsetXPercent, -100, 100) * 5);
    /// <summary>
    /// Gets the media y value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The media y value exposed by <see cref="WordArtView"/>.</value>
    private string MediaY => Inv(-((Math.Clamp(Item.FillMediaScale, .1, 10) - 1) * 150) + Math.Clamp(Item.FillMediaOffsetYPercent, -100, 100) * 1.5);
    /// <summary>
    /// Gets the media width value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The media width value exposed by <see cref="WordArtView"/>.</value>
    private string MediaWidth => Inv(1000 * Math.Clamp(Item.FillMediaScale, .1, 10));
    /// <summary>
    /// Gets the media height value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The media height value exposed by <see cref="WordArtView"/>.</value>
    private string MediaHeight => Inv(300 * Math.Clamp(Item.FillMediaScale, .1, 10));
    /// <summary>
    /// Gets the video style value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The video style value exposed by <see cref="WordArtView"/>.</value>
    private string VideoStyle => $"width:100%;height:100%;object-fit:{VideoFit};transform:translate({Inv(Item.FillMediaOffsetXPercent)}%,{Inv(Item.FillMediaOffsetYPercent)}%) scale({Inv(Math.Clamp(Item.FillMediaScale, .1, 10))});transform-origin:center center;";
    /// <summary>
    /// Gets the video fit value that forms part of the word art view state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The video fit value exposed by <see cref="WordArtView"/>.</value>
    private string VideoFit => Item.FillMediaFitMode switch
    {
        PublicationVideoFitMode.Contain => "contain",
        PublicationVideoFitMode.Stretch => "fill",
        _ => "cover"
    };

    /// <summary>
    /// Gets the warp path used by this word art view instance to locate the associated file-system resource.
    /// </summary>
    /// <value>The warp path value exposed by <see cref="WordArtView"/>.</value>
    private string WarpPath => WordArtGeometry.Build(Item);
    /// <summary>
    /// Gets the path start offset used by this word art view instance to locate the associated file-system resource.
    /// </summary>
    /// <value>The path start offset value exposed by <see cref="WordArtView"/>.</value>
    private string PathStartOffset => $"{Math.Clamp(Item.PathStartOffsetPercent, 0, 100).ToString("0.##", CultureInfo.InvariantCulture)}%";

    /// <summary>
    /// Performs safe color for <see cref="WordArtView"/>, keeping the operation consistent with the state and invariants of the surrounding word art view workflow.
    /// </summary>
    /// <param name="value">Value value supplied to the word art view operation and used when producing its result.</param>
    /// <param name="fallback">Fallback value supplied to the word art view operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string SafeColor(string? value, string fallback)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(value)) return fallback;
            var color = value.Trim();
            if (color.Equals("transparent", StringComparison.OrdinalIgnoreCase)) return fallback;
            return color;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(WordArtView)}.{nameof(SafeColor)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs inv for <see cref="WordArtView"/>, keeping the operation consistent with the state and invariants of the surrounding word art view workflow.
    /// </summary>
    /// <param name="value">Value value supplied to the word art view operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string Inv(double value) {
        try
        {
            return value.ToString("0.###", CultureInfo.InvariantCulture);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(WordArtView)}.{nameof(Inv)} failed.");
            throw;
        }
    }

}
