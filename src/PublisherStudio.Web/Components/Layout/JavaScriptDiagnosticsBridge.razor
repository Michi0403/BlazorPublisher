@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@namespace PublisherStudio.Components.Layout
@inject IJSRuntime JS
@inject ILogger<JavaScriptDiagnosticsBridge> Logger

@code {

    /// <summary>
    /// Stores the internal diagnostics reference state used by <see cref="JavaScriptDiagnosticsBridge"/> while executing its surrounding workflow.
    /// </summary>
    private DotNetObjectReference<JavaScriptDiagnosticsBridge>? _diagnosticsReference;
    /// <summary>
    /// Stores the internal disposed state used by <see cref="JavaScriptDiagnosticsBridge"/> while executing its surrounding workflow.
    /// </summary>
    private bool _disposed;

    /// <summary>
    /// Handles the after render async lifecycle or event notification for <see cref="JavaScriptDiagnosticsBridge"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="firstRender">Value indicating whether first render should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            try
            {
                if (!firstRender || _disposed)
                    return;

                _diagnosticsReference = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("publisherStudioJavaScriptDiagnostics.bindDotNet", _diagnosticsReference).ConfigureAwait(true);
                Logger.LogInformation($"PublisherStudio browser diagnostics attached; JavaScript failures will be mirrored to the application logger.");
            }
            catch (JSDisconnectedException exception)
            {
                Logger.LogDebug(exception, $"PublisherStudio browser diagnostics ended because the circuit disconnected.");
            }
            catch (OperationCanceledException exception)
            {
                Logger.LogDebug(exception, $"PublisherStudio browser diagnostics were cancelled during circuit shutdown.");
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, $"PublisherStudio browser diagnostics could not attach.");
                OperationalNotifications.Error(
                    "Browser diagnostics could not attach. Review the application log for the underlying error.",
                    "Browser diagnostics",
                    nameof(JavaScriptDiagnosticsBridge));
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(JavaScriptDiagnosticsBridge)}.{nameof(OnAfterRenderAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs report java script error for <see cref="JavaScriptDiagnosticsBridge"/>, keeping the operation consistent with the state and invariants of the surrounding java script diagnostics bridge workflow.
    /// </summary>
    /// <param name="context">Context value supplied to the java script diagnostics bridge operation and used when producing its result.</param>
    /// <param name="message">Message value supplied to the java script diagnostics bridge operation and used when producing its result.</param>
    /// <param name="stack">Stack value supplied to the java script diagnostics bridge operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    [JSInvokable]
    public Task ReportJavaScriptErrorAsync(string context, string message, string stack)
    {
        try
        {
            try
            {
                Logger.LogError($"Browser JavaScript failure in {context}: {message}{Environment.NewLine}{stack}");
                return Task.CompletedTask;
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, $"PublisherStudio could not record a browser JavaScript failure from {context}.");
                return Task.CompletedTask;
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(JavaScriptDiagnosticsBridge)}.{nameof(ReportJavaScriptErrorAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Releases resources owned by <see cref="JavaScriptDiagnosticsBridge"/> and leaves the java script diagnostics bridge workflow in a safely disposed state.
    /// </summary>
    public void Dispose()
    {
        try
        {
            try
            {
                if (_disposed)
                    return;

                _disposed = true;
                _diagnosticsReference?.Dispose();
                _diagnosticsReference = null;
                Logger.LogDebug($"The PublisherStudio JavaScript diagnostics bridge was disposed.");
            }
            catch (Exception exception)
            {
                Logger.LogWarning(exception, $"The PublisherStudio JavaScript diagnostics bridge could not be disposed cleanly.");
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(JavaScriptDiagnosticsBridge)}.{nameof(Dispose)} failed.");
            throw;
        }
    }

}
