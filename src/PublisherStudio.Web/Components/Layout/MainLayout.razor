@inherits LayoutComponentBase
@namespace PublisherStudio.Components.Layout
@inject PublisherStudio.Services.Configuration.IFileLocalizationService Localization

<main class="application-root">
    <UserNotificationHost />
    <OperationalErrorBoundary @key="Navigation.Uri">
        <ChildContent>
            @Body
        </ChildContent>
        <ErrorContent Context="exception">
            <section class="publisher-component-error" role="alert">
                <strong>@Localization.Get("Text.PublisherStudio␠could␠not␠render␠this␠view.", fallback: "PublisherStudio could not render this view.")</strong>
                <span>@Localization.Get("Text.The␠exception␠was␠written␠to␠the␠local␠application␠log.", fallback: "The exception was written to the local application log.")</span>
            </section>
        </ErrorContent>
    </OperationalErrorBoundary>
    <OrganicApprovalBar />
</main>

