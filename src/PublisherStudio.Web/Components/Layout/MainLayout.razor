@inherits LayoutComponentBase
@namespace PublisherStudio.Components.Layout
@inject PublisherStudio.Services.Configuration.IFileLocalizationService Localization
@inject NavigationManager Navigation

@inject ILogger<MainLayout> Logger
<div class="razor-component-boundary">
<DxFormLayout CssClass="razor-component-layout-owner MainLayout">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext001">
<main class="application-root">
    <UserNotificationHost />
    <OperationalErrorBoundary @key="Navigation.Uri">
        <ChildContent>
            @Body
        </ChildContent>
        <ErrorContent Context="exception">
            <DxFormLayout CssClass="razor-section-layout-owner">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext002">
        <div class="publisher-component-error" role="alert">
                <strong>@Localization.Get("Text.PublisherStudio␠could␠not␠render␠this␠view.", fallback: "PublisherStudio could not render this view.")</strong>
                <span>@Localization.Get("Text.The␠exception␠was␠written␠to␠the␠local␠application␠log.", fallback: "The exception was written to the local application log.")</span>
            </div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
        </ErrorContent>
    </OperationalErrorBoundary>
    <OrganicApprovalBar />
</main>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
</div>

