@namespace PublisherStudio.Components
@implements IDisposable
@inject IOrganicWorkCoordinator WorkCoordinator
@inject ILocalGptConnectionService Connection
@inject IUserNotificationService Notifications
@inject IJSRuntime JS

@inject ILogger<OrganicApprovalBar> Logger
@inject ISupervisedTaskRunner TaskRunner
@if (_visible && _pending.Count > 0)
{
    <aside class="organic-approval-bar" role="region" aria-label="Organic plugin approvals">
        <button type="button" class="organic-approval-toggle" @onclick="ToggleCollapsed" aria-expanded="@(!_collapsed)">
            AI Council actions <span class="organic-approval-count">@_pending.Count</span>
        </button>
        @if (!_collapsed)
        {
            var current = _pending[0];
            <div class="organic-approval-content">
                <div class="organic-approval-summary">
                    <strong>@current.CapabilityKey</strong>
                    <span>@DescribeInteraction(current.Request)</span>
                    <small>@(string.IsNullOrWhiteSpace(current.Request.WorkOrderKey) ? current.CorrelationId.ToString("N") : current.Request.WorkOrderKey)</small>
                </div>
                @if (NeedsEditor(current.Request))
                {
                    <div class="organic-approval-editor">
                        <label for="organic-interaction-value">@EditorLabel(current.Request)</label>
                        @if (TryReadParameter(current.Request, "question", out var question) && !string.IsNullOrWhiteSpace(question))
                        {
                            <p class="organic-approval-question">@question</p>
                        }
                        <textarea id="organic-interaction-value" class="form-control" rows="@(ReadEditor(current.Request) == OrganicInteractionEditor.RichText ? 8 : 4)" @bind="_interactionValue"></textarea>
                        <small>The value is returned through the exact 1-Wire request only after you approve it in this PublisherStudio frontend.</small>
                    </div>
                }
                <div class="organic-approval-actions">
                    <button type="button" class="organic-primary" disabled="@_busy" @onclick="ApproveCurrentAsync">@ApproveButtonText(current.Request)</button>
                    <button type="button" class="organic-danger" disabled="@_busy" @onclick="DeclineCurrentAsync">Decline</button>
                    <button type="button" class="organic-secondary" @onclick="Hide">Hide bar</button>
                </div>
            </div>
        }
    </aside>
}
else if (!_visible && _pending.Count > 0)
{
    <button type="button" class="organic-approval-reopen" @onclick="Show">
        Review AI actions <span>@_pending.Count</span>
    </button>
}

@code {

    /// <summary>
    /// Stores the in-memory pending collection maintained internally by <see cref="OrganicApprovalBar"/> for its current workflow state.
    /// </summary>
    private IReadOnlyList<OrganicPluginWorkItem> _pending = [];
    /// <summary>
    /// Stores the internal collapsed state used by <see cref="OrganicApprovalBar"/> while executing its surrounding workflow.
    /// </summary>
    private bool _collapsed;
    /// <summary>
    /// Stores the internal visible state used by <see cref="OrganicApprovalBar"/> while executing its surrounding workflow.
    /// </summary>
    private bool _visible = true;
    /// <summary>
    /// Stores the internal busy state used by <see cref="OrganicApprovalBar"/> while executing its surrounding workflow.
    /// </summary>
    private bool _busy;
    /// <summary>
    /// Stores the internal editor work item identifier state used by <see cref="OrganicApprovalBar"/> while executing its surrounding workflow.
    /// </summary>
    private Guid? _editorWorkItemId;
    /// <summary>
    /// Stores the internal interaction value state used by <see cref="OrganicApprovalBar"/> while executing its surrounding workflow.
    /// </summary>
    private string _interactionValue = string.Empty;

    /// <summary>
    /// Handles the initialized lifecycle or event notification for <see cref="OrganicApprovalBar"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnInitialized()
    {
        try
        {
            WorkCoordinator.Changed += OnChanged;
            Refresh();
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicApprovalBar)}.{nameof(OnInitialized)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs refresh for <see cref="OrganicApprovalBar"/>, keeping the operation consistent with the state and invariants of the surrounding organic approval bar workflow.
    /// </summary>
    private void Refresh()
    {
        try
        {
            _pending = WorkCoordinator.GetWork()
                .Where(item => item.Status == OrganicWorkStatus.PendingApproval)
                .OrderBy(item => item.CreatedUtc)
                .ToList();
            var current = _pending.FirstOrDefault();
            if (current is null)
            {
                _editorWorkItemId = null;
                _interactionValue = string.Empty;
            }
            else if (_editorWorkItemId != current.Id)
            {
                _editorWorkItemId = current.Id;
                _interactionValue = current.Request.InteractionValueJson ?? string.Empty;
                if (string.IsNullOrWhiteSpace(_interactionValue) && TryReadParameter(current.Request, "initialText", out var initialText))
                    _interactionValue = initialText;
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicApprovalBar)}.{nameof(Refresh)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Handles the changed lifecycle or event notification for <see cref="OrganicApprovalBar"/>, updating the state required by the surrounding workflow.
    /// </summary>
    private void OnChanged()
    {
        try
        {
            TaskRunner.Run(
                nameof(OrganicApprovalBar),
                nameof(OnChanged),
                async _ => await InvokeAsync(() =>
                {
                        Refresh();
                        StateHasChanged();
                }).ConfigureAwait(false));
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicApprovalBar)}.{nameof(OnChanged)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Approves current for <see cref="OrganicApprovalBar"/>, keeping the operation consistent with the state and invariants of the surrounding organic approval bar workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ApproveCurrentAsync()
    {
        try
        {
            if (_busy || _pending.Count == 0) return;
            _busy = true;
            try
            {
                var pending = _pending[0];
                if (string.Equals(pending.CapabilityKey, "publisher.screen.capture", StringComparison.OrdinalIgnoreCase))
                {
                    var captureJson = await JS.InvokeAsync<string>("publisherSecureCapture.captureScreen").ConfigureAwait(true);
                    if (!WorkCoordinator.UpdateInteractionValue(pending.Id, captureJson))
                        throw new InvalidOperationException("The approved browser screenshot could not be attached to the current 1-Wire work item.");
                }
                else if (string.Equals(pending.CapabilityKey, "publisher.screen.record", StringComparison.OrdinalIgnoreCase))
                {
                    var maximumSeconds = TryReadIntParameter(pending.Request, "maximumSeconds", 10);
                    var includeAudio = TryReadBooleanParameter(pending.Request, "includeAudio", false);
                    var captureJson = await JS.InvokeAsync<string>("publisherSecureCapture.recordScreen", maximumSeconds, includeAudio).ConfigureAwait(true);
                    if (!WorkCoordinator.UpdateInteractionValue(pending.Id, captureJson))
                        throw new InvalidOperationException("The approved browser screen recording could not be attached to the current 1-Wire work item.");
                }
                else if (NeedsEditor(pending.Request) && !WorkCoordinator.UpdateInteractionValue(pending.Id, _interactionValue))
                    throw new InvalidOperationException("The pending interaction value could not be attached to the current 1-Wire work item.");
                var item = await WorkCoordinator.ApproveAsync(pending.Id).ConfigureAwait(true);
                if (item is not null && Connection.State.IsConnected)
                    await Connection.SendWorkResultAsync(item).ConfigureAwait(true);
                Notifications.Success("The requested AI Council action was approved once.", "Organic approval", nameof(OrganicApprovalBar));
            }
            finally
            {
                _busy = false;
                Refresh();
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicApprovalBar)}.{nameof(ApproveCurrentAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs decline current for <see cref="OrganicApprovalBar"/>, keeping the operation consistent with the state and invariants of the surrounding organic approval bar workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task DeclineCurrentAsync()
    {
        try
        {
            if (_busy || _pending.Count == 0) return;
            _busy = true;
            try
            {
                var id = _pending[0].Id;
                if (WorkCoordinator.Decline(id, "Declined by the PublisherStudio user."))
                {
                    var item = WorkCoordinator.Get(id);
                    if (item is not null && Connection.State.IsConnected)
                        await Connection.SendWorkResultAsync(item).ConfigureAwait(true);
                    Notifications.Warning("The requested AI Council action was declined.", "Organic approval", nameof(OrganicApprovalBar));
                }
            }
            finally
            {
                _busy = false;
                Refresh();
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicApprovalBar)}.{nameof(DeclineCurrentAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs needs editor for <see cref="OrganicApprovalBar"/>, keeping the operation consistent with the state and invariants of the surrounding organic approval bar workflow.
    /// </summary>
    /// <param name="request">Request containing the caller-supplied values that control this operation.</param>
    /// <returns>A value indicating whether the requested condition or operation succeeded.</returns>
    private bool NeedsEditor(OrganicWireEnvelope request) {
        try
        {
            return ReadEditor(request) is
        OrganicInteractionEditor.PlainText or OrganicInteractionEditor.RichText or OrganicInteractionEditor.Json;
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicApprovalBar)}.{nameof(NeedsEditor)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs editor label for <see cref="OrganicApprovalBar"/>, keeping the operation consistent with the state and invariants of the surrounding organic approval bar workflow.
    /// </summary>
    /// <param name="request">Request containing the caller-supplied values that control this operation.</param>
    /// <returns>The string produced by the operation.</returns>
    private string EditorLabel(OrganicWireEnvelope request) {
        try
        {
            return ReadEditor(request) switch
    {
        OrganicInteractionEditor.RichText => "Text or formatted story content requested by LocalGPT",
        OrganicInteractionEditor.Json => "Structured JSON requested by LocalGPT",
        _ => "Information requested by LocalGPT"
    };
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicApprovalBar)}.{nameof(EditorLabel)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Reads editor for <see cref="OrganicApprovalBar"/>, keeping the operation consistent with the state and invariants of the surrounding organic approval bar workflow.
    /// </summary>
    /// <param name="request">Request containing the caller-supplied values that control this operation.</param>
    /// <returns>The organic interaction editor produced by the operation.</returns>
    private OrganicInteractionEditor ReadEditor(OrganicWireEnvelope request)
    {
        try
        {
            if (request.Properties is not null && request.Properties.TryGetValue("InteractionEditor", out var value))
            {
                if (value.ValueKind == System.Text.Json.JsonValueKind.String && Enum.TryParse<OrganicInteractionEditor>(value.GetString(), true, out var parsed))
                    return parsed;
                if (value.ValueKind == System.Text.Json.JsonValueKind.Number && value.TryGetInt32(out var numeric) && Enum.IsDefined(typeof(OrganicInteractionEditor), numeric))
                    return (OrganicInteractionEditor)numeric;
            }
            return request.RequiresHumanInteractionOnTargetSystem ? OrganicInteractionEditor.ConfirmationOnly : OrganicInteractionEditor.None;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicApprovalBar)}.{nameof(ReadEditor)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs describe interaction for <see cref="OrganicApprovalBar"/>, keeping the operation consistent with the state and invariants of the surrounding organic approval bar workflow.
    /// </summary>
    /// <param name="request">Request containing the caller-supplied values that control this operation.</param>
    /// <returns>The string produced by the operation.</returns>
    private string DescribeInteraction(OrganicWireEnvelope request) {
        try
        {
            return request.InteractionKind switch
    {
        OrganicInteractionKind.HumanAndAutomated => "Needs human confirmation and automated interaction on PublisherStudio.",
        OrganicInteractionKind.Human => "Needs human interaction on PublisherStudio.",
        OrganicInteractionKind.Automated => "Uses an automated PublisherStudio interaction after approval.",
        _ => "Requests a bounded PublisherStudio function."
    };
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicApprovalBar)}.{nameof(DescribeInteraction)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Approves button text for <see cref="OrganicApprovalBar"/>, keeping the operation consistent with the state and invariants of the surrounding organic approval bar workflow.
    /// </summary>
    /// <param name="request">Request containing the caller-supplied values that control this operation.</param>
    /// <returns>The string produced by the operation.</returns>
    private string ApproveButtonText(OrganicWireEnvelope request) {
        try
        {
            return request.CapabilityKey switch
    {
        "publisher.text.edit.request" => "Save & return to LocalGPT",
        "publisher.website.content.request" => "Return approved content",
        "publisher.screen.capture" => "Choose screen & capture",
        "publisher.screen.record" => "Choose screen & record",
        _ => "Approve once"
    };
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicApprovalBar)}.{nameof(ApproveButtonText)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Attempts to read parameter for <see cref="OrganicApprovalBar"/>, keeping the operation consistent with the state and invariants of the surrounding organic approval bar workflow.
    /// </summary>
    /// <param name="request">Request containing the caller-supplied values that control this operation.</param>
    /// <param name="name">Name value supplied to the organic approval bar operation and used when producing its result.</param>
    /// <param name="value">Value value supplied to the organic approval bar operation and used when producing its result.</param>
    /// <returns>A value indicating whether the requested condition or operation succeeded.</returns>
    private bool TryReadParameter(OrganicWireEnvelope request, string name, out string value)
    {
        try
        {
            value = string.Empty;
            if (request.Properties is null || !request.Properties.TryGetValue("Parameters", out var parameters) ||
                parameters.ValueKind != System.Text.Json.JsonValueKind.Object || !parameters.TryGetProperty(name, out var property) ||
                property.ValueKind != System.Text.Json.JsonValueKind.String) return false;
            value = property.GetString() ?? string.Empty;
            return true;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicApprovalBar)}.{nameof(TryReadParameter)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Attempts to read int parameter for <see cref="OrganicApprovalBar"/>, keeping the operation consistent with the state and invariants of the surrounding organic approval bar workflow.
    /// </summary>
    /// <param name="request">Request containing the caller-supplied values that control this operation.</param>
    /// <param name="name">Name value supplied to the organic approval bar operation and used when producing its result.</param>
    /// <param name="fallback">Fallback value supplied to the organic approval bar operation and used when producing its result.</param>
    /// <returns>The int produced by the operation.</returns>
    private int TryReadIntParameter(OrganicWireEnvelope request, string name, int fallback)
    {
        try
        {
            if (request.Properties is not null && request.Properties.TryGetValue("Parameters", out var parameters) &&
                parameters.ValueKind == System.Text.Json.JsonValueKind.Object && parameters.TryGetProperty(name, out var property) && property.TryGetInt32(out var value))
                return value;
            return fallback;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicApprovalBar)}.{nameof(TryReadIntParameter)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Attempts to read boolean parameter for <see cref="OrganicApprovalBar"/>, keeping the operation consistent with the state and invariants of the surrounding organic approval bar workflow.
    /// </summary>
    /// <param name="request">Request containing the caller-supplied values that control this operation.</param>
    /// <param name="name">Name value supplied to the organic approval bar operation and used when producing its result.</param>
    /// <param name="fallback">Value indicating whether fallback should apply to this operation.</param>
    /// <returns>A value indicating whether the requested condition or operation succeeded.</returns>
    private bool TryReadBooleanParameter(OrganicWireEnvelope request, string name, bool fallback)
    {
        try
        {
            if (request.Properties is not null && request.Properties.TryGetValue("Parameters", out var parameters) &&
                parameters.ValueKind == System.Text.Json.JsonValueKind.Object && parameters.TryGetProperty(name, out var property) &&
                property.ValueKind is System.Text.Json.JsonValueKind.True or System.Text.Json.JsonValueKind.False)
                return property.GetBoolean();
            return fallback;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicApprovalBar)}.{nameof(TryReadBooleanParameter)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs toggle collapsed for <see cref="OrganicApprovalBar"/>, keeping the operation consistent with the state and invariants of the surrounding organic approval bar workflow.
    /// </summary>
    private void ToggleCollapsed() {
        try
        {
            _collapsed = !_collapsed;
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicApprovalBar)}.{nameof(ToggleCollapsed)} failed.");
