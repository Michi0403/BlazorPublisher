        }
    }
    /// <summary>
    /// Performs show for <see cref="OrganicApprovalBar"/>, keeping the operation consistent with the state and invariants of the surrounding organic approval bar workflow.
    /// </summary>
    private void Show() {
        try
        {
     _visible = true; _collapsed = false; 
        }
        catch (Exception __componentMethodException)
        {
