    /// Releases resources owned by <see cref="OrganicApprovalBar"/> and leaves the organic approval bar workflow in a safely disposed state.
    /// </summary>
    public void Dispose() {
        try
        {
            WorkCoordinator.Changed -= OnChanged;
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicApprovalBar)}.{nameof(Dispose)} failed.");
            throw;
        }
    }

}
