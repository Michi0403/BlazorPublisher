@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DevExpress.Blazor.RichEdit
@using Microsoft.JSInterop
@using Microsoft.Extensions.Options
@inject IJSRuntime JS
@inject PublicationFileService Files
@inject IOptions<OrganicPluginOptions> OrganicOptions
@namespace PublisherStudio.Components
@implements IDisposable
@inject IPublisherEditorSessionRegistry SessionRegistry
@inject PublisherAiDocumentInsertionService DocumentInsertion
@inject ILogger<OrganicDocumentCreationBridge> Logger

@* razor-structural-renderer | reason: The off-screen RichEdit needs a sized host for document export without affecting the publication layout. *@
<div aria-hidden="true" style="position:fixed;left:-10000px;top:0;width:800px;height:400px" inert>
    <DxRichEdit @ref="_exportEditor" />
</div>

@code {
    private DxRichEdit? _exportEditor;
    private readonly SemaphoreSlim _exportGate = new(1);

    private async Task<byte[]> ExportStoryAsync(byte[] content, string kind)
    {
        await _exportGate.WaitAsync().ConfigureAwait(true);
        try
        {
            var editor = _exportEditor ?? throw new InvalidOperationException("The story export editor is unavailable.");
            var format = kind == "rtf" ? DocumentFormat.Rtf : DocumentFormat.Html;
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(Math.Max(1, OrganicOptions.Value.DocumentCreation.EditorCreationTimeoutSeconds)));
            await editor.LoadDocumentAsync(content, DocumentFormat.OpenXml, timeout.Token).ConfigureAwait(true);
            var exported = await editor.ExportDocumentAsync(format, timeout.Token).ConfigureAwait(true);
            if (kind != "pdf") return exported;

            var preview = new PublisherStudio.Components.Editor.StoryEditor.StoryPreviewResult
            {
                Html = Files.ExtractHtmlBody(exported),
                Background = Files.ExtractOpenXmlDocumentBackground(content) ?? "transparent"
            };
            var html = PublisherStudio.Components.Editor.StoryEditor.StandaloneStoryHtml(
                Files, Logger, preview, "Council document", Files.ExtractOpenXmlPageLayout(content),
                printPreview: true, returnPdf: true);
            var maximumBytes = Math.Max(1, OrganicOptions.Value.MediaTools.MaximumTransferFileBytes);
            await using var pdf = await JS.InvokeAsync<IJSStreamReference>(
                "publisherStudio.renderStoryPdf", timeout.Token, html, maximumBytes);
            await using var input = await pdf.OpenReadStreamAsync(maximumBytes, timeout.Token);
            using var output = new MemoryStream();
            await input.CopyToAsync(output, timeout.Token);
            return output.ToArray();
        }
        finally
        {
            _exportGate.Release();
        }
    }


    /// <summary>
    /// Stores the identifier under which this interactive circuit is registered as an open editor session.
    /// </summary>
    private Guid _sessionId;
    /// <summary>
    /// Stores whether the component was disposed so late callbacks are ignored.
    /// </summary>
    private bool _disposed;

    /// <summary>
    /// Registers this interactive circuit as an editor session after the first interactive render; prerendered instances never register.
    /// </summary>
    /// <param name="firstRender">Value indicating whether this is the first interactive render.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender && !_disposed && _sessionId == Guid.Empty)
                _sessionId = SessionRegistry.Register(DescribeSessionAsync, CreateDocumentAsync, ExportPublicationAsync);
            return base.OnAfterRenderAsync(firstRender);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicDocumentCreationBridge)}.{nameof(OnAfterRenderAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Builds the session snapshot on this circuit's synchronization context.
    /// </summary>
    /// <param name="sessionId">Identifier under which the session is registered.</param>
    /// <returns>The current session snapshot.</returns>
    private async Task<PublisherEditorSessionSnapshot> DescribeSessionAsync(Guid sessionId)
    {
        try
        {
            PublisherEditorSessionSnapshot? snapshot = null;
            await InvokeAsync(() => { snapshot = DocumentInsertion.DescribeSession(sessionId); }).ConfigureAwait(true);
            return snapshot ?? throw new InvalidOperationException("The editor session produced no snapshot.");
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicDocumentCreationBridge)}.{nameof(DescribeSessionAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Creates the approved document on this circuit's synchronization context and refreshes the layout.
    /// </summary>
    /// <param name="request">The approved creation request.</param>
    /// <returns>The creation result.</returns>
    private async Task<PublisherDocumentCreateResult> CreateDocumentAsync(PublisherDocumentCreateRequest request)
    {
        try
        {
            PublisherDocumentCreateResult? created = null;
            await InvokeAsync(async () =>
            {
                created = await DocumentInsertion.CreateDocumentAsync(request, ExportStoryAsync).ConfigureAwait(true);
                if (created.Success)
                    OperationalNotifications.Success($"A {created.Kind} named '{created.Title}' was added to page {created.Page} of the publication by an approved 1-Wire request.", "Organic document", nameof(OrganicDocumentCreationBridge));
                else
                    OperationalNotifications.Warning(created.Message, "Organic document", nameof(OrganicDocumentCreationBridge));
                if (!_disposed) StateHasChanged();
            }).ConfigureAwait(true);
            return created ?? throw new InvalidOperationException("The editor session produced no result.");
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicDocumentCreationBridge)}.{nameof(CreateDocumentAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Exports the open publication through the editor's own export producers on this circuit and returns the file.
    /// The browser prepares the file first, so a format or budget problem is reported before any bytes move.
    /// </summary>
    /// <param name="request">The approved and validated export request.</param>
    /// <returns>The exported file, or a failure that says what the user must change.</returns>
    private async Task<PublisherPublicationExportResult> ExportPublicationAsync(PublisherPublicationExportRequest request)
    {
        try
        {
            PublisherPublicationExportResult? exported = null;
            await InvokeAsync(async () =>
            {
                var snapshot = DocumentInsertion.DescribeSession(_sessionId);
                using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(Math.Max(1, OrganicOptions.Value.MediaTools.EditorExportTimeoutSeconds)));
                var prepared = await JS.InvokeAsync<PreparedWireExport>("publisherStudio.prepareWireExport", timeout.Token, new
                {
                    scope = request.Scope,
                    format = request.Format,
                    page = request.Page,
                    elementId = request.ElementId,
                    dpi = request.Dpi,
                    title = snapshot.Title
                }, request.MaximumBytes).ConfigureAwait(true);
                var file = await JS.InvokeAsync<IJSStreamReference>("publisherStudio.takeWireExport", timeout.Token, prepared.Token).ConfigureAwait(true);
                using var output = new MemoryStream();
                await using (file.ConfigureAwait(true))
                {
                    var input = await file.OpenReadStreamAsync(request.MaximumBytes, timeout.Token).ConfigureAwait(true);
                    await using (input.ConfigureAwait(true))
                        await input.CopyToAsync(output, timeout.Token).ConfigureAwait(true);
                }
                exported = new PublisherPublicationExportResult
                {
                    Success = true,
                    Scope = request.Scope,
                    Kind = Path.GetExtension(prepared.FileName).TrimStart('.').ToLowerInvariant(),
                    MimeType = prepared.MimeType,
                    FileName = prepared.FileName,
                    PageCount = prepared.PageCount,
                    DocumentBytes = output.ToArray(),
                    Message = $"Exported {prepared.FileName} from the open publication."
                };
                OperationalNotifications.Success($"An approved 1-Wire request exported {prepared.FileName} ({request.Scope}).", "Organic export", nameof(OrganicDocumentCreationBridge));
            }).ConfigureAwait(true);
            return exported ?? throw new InvalidOperationException("The editor session produced no export result.");
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "The browser could not produce the approved {Scope} export.", request.Scope);
            OperationalNotifications.Warning(exception.Message, "Organic export", nameof(OrganicDocumentCreationBridge));
            return new PublisherPublicationExportResult { Success = false, Scope = request.Scope, Message = exception.Message };
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicDocumentCreationBridge)}.{nameof(ExportPublicationAsync)} failed.");
            throw;
        }
    }

    /// <summary>Describes a file the browser prepared for one approved 1-Wire export.</summary>
    /// <param name="Token">Browser-side handle used to take the prepared file exactly once.</param>
    /// <param name="FileName">Suggested file name.</param>
    /// <param name="MimeType">MIME type of the prepared file.</param>
    /// <param name="Size">File size in bytes.</param>
    /// <param name="PageCount">Number of exported publication pages.</param>
    private sealed record PreparedWireExport(string Token, string FileName, string MimeType, long Size, int PageCount);

    /// <summary>
    /// Removes the session registration when the circuit or layout goes away.
    /// </summary>
    public void Dispose()
    {
        try
        {
            if (_disposed) return;
            _disposed = true;
            if (_sessionId != Guid.Empty) SessionRegistry.Unregister(_sessionId);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicDocumentCreationBridge)}.{nameof(Dispose)} failed.");
            throw;
        }
    }

}
