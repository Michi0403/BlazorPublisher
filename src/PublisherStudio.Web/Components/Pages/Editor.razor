            LocalGptConnection.Changed += LocalGptConnectionChanged;
            _recoveryCandidate = Recovery.TryReadLatest();
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(OnInitialized)} failed.");
