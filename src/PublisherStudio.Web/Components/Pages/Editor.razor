        /// Gets or sets the size bytes value that forms part of the video export state consumed or produced by the surrounding workflow.
        /// </summary>
        /// <value>The size bytes value exposed by <see cref="VideoExportResult"/>.</value>
        public long SizeBytes { get; set; }
    }

    /// <summary>
    /// Represents the outcome of page export, carrying the data and status produced by the corresponding application operation.
    /// </summary>
    private sealed class PageExportResult
    {
        /// <summary>
        /// Gets or sets the count that quantifies the associated page export data.
        /// </summary>
        /// <value>The count value exposed by <see cref="PageExportResult"/>.</value>
        public int Count { get; set; }
        /// <summary>
        /// Gets or sets the file name used by this page export instance to locate the associated file-system resource.
        /// </summary>
        /// <value>The file name value exposed by <see cref="PageExportResult"/>.</value>
        public string FileName { get; set; } = string.Empty;
    }

    /// <summary>
    /// Releases resources owned by <see cref="Editor"/> and leaves the editor workflow in a safely disposed state.
    /// </summary>
    public void Dispose()
    {
        try
        {
            if (_disposed) return;
            _disposed = true;
            State.Changed -= StateChanged;
            StreamingSession.Changed -= StateChanged;
            StreamingSession.HotkeyTriggered -= HandleGlobalStreamingHotkey;
            LocalGptConnection.Changed -= LocalGptConnectionChanged;
            if (_interactiveAttached)
            {
                _interactiveAttached = false;
                TaskRunner.Run(
                    nameof(Editor),
                    "UnbindStreamingHotkeys",
                    async _ =>
                    {
                        try
                        {
                            await JS.InvokeVoidAsync("publisherStreaming.unbindHotkeys").ConfigureAwait(false);
                        }
                        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
                        {
                            Logger.LogDebug(exception, "Streaming hotkey unbind ended during interactive editor disposal/browser teardown.");
                        }
                    });
            }
            else
            {
                Logger.LogDebug("Editor disposal skipped browser hotkey cleanup because this component instance never attached to an interactive browser circuit (normal prerender disposal).");
            }
            _streamingHotkeyReference?.Dispose();
            lock (_recoveryCancellationSync)
            {
                var recoveryCancellation = _recoverySaveCancellation;
                _recoverySaveCancellation = null;
                recoveryCancellation?.Cancel();
            }
            if (_spreadsheetEditorSessionId != Guid.Empty) SpreadsheetSessions.Remove(_spreadsheetEditorSessionId);
            if (State.IsDirty)
            {
                try
                {
                    var documentId = State.Document.Id;
                    var documentName = State.Document.Name;
                    var modifiedUtc = State.Document.ModifiedUtc;
                    var json = Files.Serialize(State.Document);
                    TaskRunner.Run(
                        nameof(Editor),
                        "PersistDirtyRecoveryOnDispose",
                        cancellationToken => Recovery.SaveAsync(documentId, documentName, modifiedUtc, json, cancellationToken));
                }
                catch (Exception exception)
                {
                    Logger.LogError(exception, "Could not schedule the final dirty recovery snapshot during editor disposal.");
                    throw;
                }
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(Dispose)} failed.");
            throw;
        }
    }

