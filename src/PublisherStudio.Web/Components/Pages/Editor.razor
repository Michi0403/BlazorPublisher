    /// <summary>
    /// Performs toggle stream output for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="outputId">Identifier of the output to use for this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ToggleStreamOutput(Guid outputId)
    {
        try
        {
            if (StreamingSession.Snapshot.Mode != PublicationStreamSessionMode.Idle)
            {
                await StreamingSession.ToggleOutputAsync(outputId).ConfigureAwait(true);
                return;
            }
            var settings = CloneStreaming(State.Document.Streaming);
            var output = settings.Outputs.FirstOrDefault(item => item.Id == outputId);
            if (output is null) return;
            output.Enabled = !output.Enabled;
            State.ApplyStreamingSettings(settings);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(ToggleStreamOutput)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs select chat output for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="outputId">Identifier of the output to use for this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task SelectChatOutput(Guid? outputId)
    {
        try
        {
            if (outputId is null)
            {
                await JS.InvokeVoidAsync("publisherStreaming.setOutputContext", new { mode = "operator", platform = "Preview", channel = "", outputId = "" }).ConfigureAwait(true);
                ShowNotice("Chat switched to preview messages.");
                return;
            }
            var output = State.Document.Streaming.Outputs.FirstOrDefault(item => item.Id == outputId.Value);
            if (output is null) return;
            var channel = output.ChatChannel;
            if (string.IsNullOrWhiteSpace(channel))
            {
                var machine = await StreamingProfiles.LoadAsync().ConfigureAwait(true);
                channel = machine.Providers.FirstOrDefault(profile => profile.Id == output.ProfileId)?.ChannelId ?? string.Empty;
            }
            await JS.InvokeVoidAsync("publisherStreaming.setOutputContext", new
            {
                mode = "operator",
                platform = output.Provider.ToString(),
                channel,
                outputId = output.Id.ToString("D")
            }).ConfigureAwait(true);
            ShowNotice($"Operator Chat: {output.Name}. Broadcast outputs remain isolated.");
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(SelectChatOutput)} failed.");
            throw;
        }
    }

