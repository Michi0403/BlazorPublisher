    /// <summary>
    /// Opens converted in studio for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="converted">Converted value supplied to the editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task OpenConvertedInStudio(MediaConversionInsertRequest converted)
    {
        try
        {
            var mime = MediaData.NormalizeMimeType(converted.MimeType, "application/octet-stream");
            var dataUrl = $"data:{mime};base64,{Convert.ToBase64String(converted.Content)}";
            await CancelPublisherPointerAsync().ConfigureAwait(true);
            _mediaConverterVisible = false;

            if (mime.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            {
                _pictureEditorTargetId = null;
                _pictureEditorInitialDocument = null;
                _pictureEditorInitialRaster = dataUrl;
                _pictureEditorInitialName = Path.GetFileNameWithoutExtension(converted.FileName);
                _pictureEditorSessionId = Guid.NewGuid();
                _pictureEditorVisible = true;
                return;
            }

            if (mime.StartsWith("video/", StringComparison.OrdinalIgnoreCase) || mime.StartsWith("audio/", StringComparison.OrdinalIgnoreCase))
            {
                var isVideo = mime.StartsWith("video/", StringComparison.OrdinalIgnoreCase);
                _mediaStudioTargetId = null;
                _mediaStudioKind = isVideo ? PublicationElementKind.Video : PublicationElementKind.Audio;
                _mediaStudioInitial = isVideo
                    ? new VideoElement
                    {
                        Name = Path.GetFileNameWithoutExtension(converted.FileName),
                        DataUrl = dataUrl,
                        MimeType = mime,
                        DurationSeconds = .01,
                        TrimStartSeconds = 0,
                        TrimEndSeconds = .01,
                        FitMode = PublicationVideoFitMode.Stretch,
                        FitModeExplicit = true
                    }
                    : new AudioElement
                    {
                        Name = Path.GetFileNameWithoutExtension(converted.FileName),
                        DataUrl = dataUrl,
                        MimeType = mime,
                        DurationSeconds = .01,
                        TrimStartSeconds = 0,
                        TrimEndSeconds = .01
                    };
                _mediaStudioInitialInsertedSegment = null;
                _mediaStudioSessionId = Guid.NewGuid();
                _mediaStudioVisible = true;
                return;
            }

            ShowError(new InvalidDataException($"The converted output type '{mime}' cannot be opened in a PublisherStudio media editor."));
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(OpenConvertedInStudio)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Performs insert converted media for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="converted">Converted value supplied to the editor operation and used when producing its result.</param>
    private void InsertConvertedMedia(MediaConversionInsertRequest converted)
    {
        try
        {
            var mime = MediaData.NormalizeMimeType(converted.MimeType, "application/octet-stream");
            var dataUrl = $"data:{mime};base64,{Convert.ToBase64String(converted.Content)}";
            if (mime.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                State.AddImage(dataUrl, converted.FileName);
            else if (mime.StartsWith("video/", StringComparison.OrdinalIgnoreCase))
                State.AddVideo(dataUrl, mime, converted.FileName, 0);
            else if (mime.StartsWith("audio/", StringComparison.OrdinalIgnoreCase))
                State.AddAudio(dataUrl, mime, converted.FileName, 0);
            else
            {
                ShowError(new InvalidDataException($"The converted output type '{mime}' cannot be inserted as a publication media object."));
                return;
            }
            ShowNotice($"Inserted converted media: {converted.FileName}");
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(InsertConvertedMedia)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Handles canvas insert for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="request">Request containing the caller-supplied values that control this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task HandleCanvasInsert(CanvasInsertRequest request)
    {
        try
        {
            var kind = request.Kind.Trim().ToLowerInvariant();
            if (kind == "text")
            {
                State.AddText(request.X, request.Y);
                return;
            }
            if (kind == "panel")
            {
                State.AddPanel("blank", request.X, request.Y);
                OpenPanelStudio();
                return;
            }

            _pendingCanvasInsert = request with { Kind = kind };
            if (kind == "picture")
            {
                await CancelPublisherPointerAsync().ConfigureAwait(true);
                await OpenHiddenFileInput("picture-file-input").ConfigureAwait(true);
                return;
            }
            if (kind == "spreadsheet")
            {
                await CreateSpreadsheet().ConfigureAwait(true);
                return;
            }
            if (kind == "video")
            {
                await OpenMediaStudio(PublicationElementKind.Video, null).ConfigureAwait(true);
                return;
            }
            _pendingCanvasInsert = null;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(HandleCanvasInsert)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Handles external file drop for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="request">Request containing the caller-supplied values that control this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task HandleExternalFileDrop(ExternalFileDropRequest request)
    {
        try
        {
            if (!MediaAssets.TryGet(request.AssetId, out var bytes, out var storedMimeType, out _))
            {
                ShowError(new InvalidDataException("The dropped file was not available after upload."));
                return;
            }

            try
            {
                State.SetInsertionPoint(request.X, request.Y);
                var kind = request.Kind.Trim().ToLowerInvariant();
                var mimeType = ResolveDroppedMimeType(request.Name, request.MimeType, storedMimeType, kind);
                var target = request.TargetElementId is Guid targetId
                    ? State.CurrentPage.Elements.FirstOrDefault(element => element.Id == targetId)
                    : null;
                if (kind == "picture")
                {
                    var dataUrl = $"data:{mimeType};base64,{Convert.ToBase64String(bytes)}";
                    if (target is ImageFrameElement image)
                    {
                        await OpenPictureStudioWithInsertedRaster(image, dataUrl, request.Name,
                            request.PixelWidth, request.PixelHeight, request.TargetX, request.TargetY).ConfigureAwait(true);
                        ShowNotice($"Added {request.Name} as a new Picture Studio layer. Apply the Studio project to update the picture.");
                        return;
                    }

                    State.AddImage(dataUrl, request.Name, centerX: request.X, centerY: request.Y,
                        pixelWidth: request.PixelWidth, pixelHeight: request.PixelHeight);
                    ShowNotice($"Inserted {request.Name} at the drop position.");
                    return;
                }

                if (kind is "video" or "audio")
                {
                    var videoKind = kind == "video";
                    mimeType = MediaData.NormalizeMimeType(mimeType, videoKind ? "video/webm" : "audio/webm");
                    var dataUrl = MediaData.NormalizeDataUrl($"data:{mimeType};base64,{Convert.ToBase64String(bytes)}", mimeType);
                    var duration = request.DurationSeconds > 0 ? request.DurationSeconds : 5;
                    if (target is PublicationMediaElement media &&
                        media.Kind == (videoKind ? PublicationElementKind.Video : PublicationElementKind.Audio))
                    {
                        var segment = new PublicationMediaSegment
                        {
                            Name = string.IsNullOrWhiteSpace(request.Name) ? (videoKind ? "Video clip" : "Audio clip") : request.Name,
                            DataUrl = dataUrl,
                            MimeType = mimeType,
                            DurationSeconds = duration,
                            TrimStartSeconds = 0,
                            TrimEndSeconds = duration
                        };
                        await OpenMediaStudio(media.Kind, media, segment).ConfigureAwait(true);
                        ShowNotice($"Added {request.Name} to the {(videoKind ? "Video" : "Audio")} Studio sequence. Apply the Studio project to update the media object.");
                        return;
                    }

                    PublicationMediaElement inserted = videoKind
                        ? State.AddVideo(dataUrl, mimeType, request.Name, duration, centerX: request.X, centerY: request.Y)
                        : State.AddAudio(dataUrl, mimeType, request.Name, duration, centerX: request.X, centerY: request.Y);
                    MediaAssets.Copy(request.AssetId, inserted.Id);
                    _timelineVisible = true;
                    ShowNotice($"Inserted {request.Name} at the drop position. The timeline is open for timing and trimming.");
                    return;
                }

                if (kind == "spreadsheet")
                {
                    var format = Spreadsheets.DetectFormat(request.Name, mimeType);
                    var spreadsheet = State.AddSpreadsheet(bytes, request.Name, format, request.X, request.Y);
                    _pendingNewSpreadsheetId = spreadsheet.Id;
                    await OpenSpreadsheetEditorById(spreadsheet.Id, pendingNew: true).ConfigureAwait(true);
                    ShowNotice($"Opened {request.Name} in Spreadsheet Studio. Apply it to keep the new frame.");
                    return;
                }

                if (kind is "text" or "markdown" or "docx")
                {
                    if (kind == "docx" && !Files.IsOpenXmlDocument(bytes))
                        throw new InvalidDataException($"'{request.Name}' is not a valid Office Open XML DOCX document.");

                    var text = State.AddText(request.X, request.Y);
                    State.UpdateSelected(_ =>
                    {
                        text.Name = string.IsNullOrWhiteSpace(request.Name)
                            ? kind == "docx" ? "Imported Word document" : "Dropped text"
                            : request.Name;
                        if (kind == "docx")
                        {
                            text.DocumentContent = bytes.ToArray();
                            text.PreviewHtml = Files.CreateOpenXmlPreviewHtml(bytes, text.Name);
                            text.DocumentBackground = Files.ExtractOpenXmlDocumentBackground(bytes);
                        }
                        else
                        {
                            var content = DecodeText(bytes);
                            text.PreviewHtml = kind == "markdown" ? MarkdownToHtml(content) : PlainTextToHtml(content);
                            text.DocumentContent = kind == "markdown"
                                ? RichTextFactory.CreateOpenXmlFromMarkdown(content)
                                : RichTextFactory.CreateOpenXmlFromPlainText(content);
                            text.DocumentBackground = "transparent";
                        }
                        text.StoryFormat = StoryStorageFormat.OpenXml;
                        text.Width = Math.Min(125, Math.Max(75, State.CurrentPage.WidthMm * .48));
                        text.Height = Math.Min(95, Math.Max(40, State.CurrentPage.HeightMm * .30));
                        text.X = Math.Clamp(request.X - text.Width / 2, -text.Width + 2, State.CurrentPage.WidthMm - 2);
                        text.Y = Math.Clamp(request.Y - text.Height / 2, -text.Height + 2, State.CurrentPage.HeightMm - 2);
                    });
                    ShowNotice(kind == "docx"
                        ? $"Inserted {request.Name} as an editable DOCX story. Double-click the frame for full Word-document fidelity."
                        : $"Inserted {request.Name} as an editable text frame.");
                    return;
                }

                throw new InvalidDataException("Drop a picture, spreadsheet, video, audio, DOCX, text, or Markdown file.");
            }
            catch (Exception ex)
            {
                ShowError(ex);
            }
            finally
            {
                MediaAssets.Remove(request.AssetId);
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(HandleExternalFileDrop)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Opens picture studio with inserted raster for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="image">Image frame element dependency used by the editor workflow to provide the corresponding application capability.</param>
    /// <param name="dataUrl">Data url value supplied to the editor operation and used when producing its result.</param>
    /// <param name="name">Name value supplied to the editor operation and used when producing its result.</param>
    /// <param name="naturalWidth">Natural width value supplied to the editor operation and used when producing its result.</param>
    /// <param name="naturalHeight">Natural height value supplied to the editor operation and used when producing its result.</param>
    /// <param name="targetX">Target x value supplied to the editor operation and used when producing its result.</param>
    /// <param name="targetY">Target y value supplied to the editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task OpenPictureStudioWithInsertedRaster(
        ImageFrameElement image,
        string dataUrl,
        string name,
        int naturalWidth,
        int naturalHeight,
        double targetX,
        double targetY)
    {
        try
        {
            await CancelPublisherPointerAsync().ConfigureAwait(true);
            var document = image.PictureSource is not null
                ? PictureDocuments.Clone(image.PictureSource)
                : CreateManagedPictureDocument(image);
            PictureDocuments.AddRasterLayer(
                document,
                dataUrl,
                name,
                naturalWidth,
                naturalHeight,
                Math.Clamp(targetX, 0, 1) * document.WidthPx,
                Math.Clamp(targetY, 0, 1) * document.HeightPx);
            _pictureEditorTargetId = image.Id;
            _pictureEditorInitialDocument = document;
            _pictureEditorInitialRaster = null;
            _pictureEditorInitialName = string.IsNullOrWhiteSpace(image.Name) ? "Picture" : image.Name;
            _pictureEditorSessionId = Guid.NewGuid();
            _pictureEditorVisible = true;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(OpenPictureStudioWithInsertedRaster)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Creates managed picture document for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="image">Image frame element dependency used by the editor workflow to provide the corresponding application capability.</param>
    /// <returns>The picture document produced by the operation.</returns>
    private PictureDocument CreateManagedPictureDocument(ImageFrameElement image)
    {
        try
        {
            var width = RuntimePolicy.DefaultEditorViewportWidth;
            var frameAspect = image.Width > .01 ? image.Height / image.Width : 2d / 3d;
            var height = Math.Clamp((int)Math.Round(width * frameAspect), 16, 8192);
            return DocumentFactory.CreatePictureFromRaster(image.DataUrl, image.Name, width, height);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(CreateManagedPictureDocument)} failed.");
            throw;
        }
    }

