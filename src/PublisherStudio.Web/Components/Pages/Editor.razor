@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@implements IDisposable
@inject EditorStateService State
@inject PublicationFileService Files
@inject IPublisherDocumentFactory DocumentFactory
@inject PublisherStudio.Services.Publication.Import.OpenDocumentImportService OpenDocumentImporter
@inject PublicationMediaAssetStore MediaAssets
@inject PublisherStudio.Services.MediaStudio.UseCases.MediaTimelineEditService TimelineEdits
@inject VideoLayerInterchangeService VideoLayerInterchange
@inject PictureDocumentService PictureDocuments
@inject SpreadsheetDocumentService Spreadsheets
@inject SpreadsheetSessionStore SpreadsheetSessions
@inject PublicationRecoveryService Recovery
@inject StreamingSessionService StreamingSession
@inject StreamingProfileStore StreamingProfiles
@inject IJSRuntime JS
@inject IUserNotificationService Notifications
@inject ILogger<Editor> Logger
@inject IPublisherRuntimePolicyDataService RuntimePolicy
@inject IFileLocalizationService Localization
@inject NavigationManager Navigation
@inject PublisherStudio.Services.OrganicPlugins.ILocalGptConnectionService LocalGptConnection

<PageTitle>BlazorPublisher</PageTitle>

<UserNotificationHost />

<div class="publisher-shell @(_recoveryCandidate is not null ? "has-recovery" : null)">
    <WebDataRefreshHost State="State" />
    <header class="title-bar">
        <div class="brand-mark">P</div>
        <input class="document-name" value="@State.Document.Name" @onchange="RenameDocument" aria-label='@LT("Publication name")' />
        <span class="modified-label">@LT("Modified") @State.Document.ModifiedUtc.LocalDateTime.ToString("g")</span>
        <label class="title-bar-language" for="publisherstudio-language-select">
            <span>@LanguageLabel</span>
            <select id="publisherstudio-language-select"
                    name="culture"
                    aria-label="@LanguageLabel"
                    data-enhance-nav="false"
                    onchange="window.location.assign(this.selectedOptions[0].dataset.selectionUrl)">
                @foreach (var culture in Localization.GetAvailableCultures())
                {
                    var selectionUrl = Localization.BuildCultureSelectionUrl(Navigation.Uri, culture);
                    if (string.Equals(culture, CurrentCulture, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@culture" data-selection-url="@selectionUrl" selected>@Localization.GetCultureDisplayName(culture)</option>
                    }
                    else
                    {
                        <option value="@culture" data-selection-url="@selectionUrl">@Localization.GetCultureDisplayName(culture)</option>
                    }
                }
            </select>
        </label>
    </header>

    @if (_recoveryCandidate is not null)
    {
        <aside class="publisher-recovery-banner" role="status">
            <span><b>@LT("Recovered work is available:")</b> @_recoveryCandidate.DocumentName · @_recoveryCandidate.SavedUtc.LocalDateTime.ToString("g")</span>
            <button type="button" @onclick="RestoreRecovery">@LT("Restore")</button>
            <button type="button" @onclick="DismissRecovery">@LT("Dismiss")</button>
        </aside>
    }

    <PublicationRibbon State="State"
                       TimelineVisible="_timelineVisible"
                       OnNew="NewDocument"
                       OnOpen="OpenPublicationPicker"
                       OnImportOpenDocument="OpenOpenDocumentPicker"
                       OnSave="SavePublication"
                       OnPrint="Print"
                       OnExportPng="ExportPng"
                       OnExportJpeg="ExportJpeg"
                       OnExportSvg="ExportSvg"
                       OnExportSelectedPng="ExportSelectedPng"
                       OnExportSelectedSvg="ExportSelectedSvg"
                       OnExportWebsite="ExportPresentationHtml"
                       OnExportSite="ExportSite"
                       OnExportStructuredSite="OpenStructuredWebsiteExport"
                       OnExportVideo="ExportVideo"
                       OnInsertPicture="OpenPicturePicker"
                       OnCreatePicture="CreatePicture"
                       OnEditPicture="EditSelectedPicture"
                       OnInsertSpreadsheet="OpenSpreadsheetPicker"
                       OnCreateSpreadsheet="CreateSpreadsheet"
                       OnEditSpreadsheet="OpenSpreadsheetEditor"
                       OnDownloadSpreadsheet="DownloadSelectedSpreadsheet"
                       OnInsertVideo="OpenVideoPicker"
                       OnInsertAudio="OpenAudioPicker"
                       OnCreateVideo="CreateVideo"
                       OnCreateAudio="CreateAudio"
                       OnEditMedia="EditSelectedMedia"
                       OnInsertBarcode="InsertBarcode"
                       OnToggleTimeline="ToggleTimeline"
                       OnEditStory="OpenStoryEditor"
                       OnFitPage="FitPage"
                       OnTogglePagesPane="TogglePagesPane"
                       OnToggleInspectorPane="ToggleInspectorPane"
                       OnResetWorkspace="ResetWorkspace"
                       OnInsertDataVisual="InsertDataVisual"
                       OnEditDataVisual="OpenDataVisualEditor"
                       OnManageData="OpenDataManager"
                       OnInsertComponent="InsertComponent"
                       OnEditComponent="OpenComponentEditor"
                       OnInsertPanel="InsertPanel"
                       OnInsertHtmlEmbed="InsertHtmlEmbed"
                       OnInsertVideoBlob="InsertDefaultVideoBlob"
                       OnTogglePanelLibrary="TogglePanelLibrary"
                       OnOpenMediaConverter="OpenMediaConverter"
                       OnPreviewPageAnimations="PreviewPageAnimations"
                       OnEditPageEffects="OpenPageEffectStudio"
                       OnPreviewObjectAnimations="PreviewObjectAnimations"
                       OnStopAnimations="StopAnimations"
                       Streaming="StreamingSession.Snapshot"
                       OnStreamingSetup="OpenStreamingStudio"
                       OnStartDryRun="StartDryRun"
                       OnStartStreaming="StartStreaming"
                       OnStopStreaming="StopStreaming"
                       OnStopRecording="StopStreamRecording"
                       OnStopSession="StopStreamingSession"
                       OnToggleRecording="ToggleStreamRecording"
                       OnToggleStreamOutput="ToggleStreamOutput"
                       OnSelectProgramPage="SelectProgramPage"
                       OnInsertLiveSource="InsertLiveSource"
                       OnSelectChatOutput="SelectChatOutput" />

    <div class="publisher-quick-insert" aria-label='@LT("Drag objects onto the publication page")'>
        <span>@LT("Drag to canvas")</span>
        <button type="button" draggable="true" data-publisher-insert="panel" title='@LT("Drag a reusable panel or dashboard to the canvas")' @onclick="InsertPanel"><i class="pub-icon pub-icon-panel"></i>@LT("Panel")</button>
        <button type="button" draggable="true" data-publisher-insert="text" title='@LT("Drag a text box to an exact position, or click to insert")' @onclick="AddTextQuick"><i class="pub-icon pub-icon-text"></i>@LT("Text")</button>
        @if (CanUseAiCouncil)
        {
            <button type="button" title='@LT("Create a text frame and open LocalGPT AI assistance in Story Editor")' @onclick="AddAiTextQuick"><i class="pub-icon pub-icon-text"></i>@LT("AI Text")</button>
            <button type="button" title='@LT("Insert a DevExtreme Chat already wired to the paired LocalGPT Council bridge")' @onclick="InsertAiChatQuick"><i class="pub-icon pub-icon-command"></i>@LT("AI Chat")</button>
        }
        <button type="button" draggable="true" data-publisher-insert="picture" title='@LT("Drag to choose and place a picture, or click to insert")' @onclick="OpenPicturePicker"><i class="pub-icon pub-icon-picture"></i>@LT("Picture")</button>
        <button type="button" draggable="true" data-publisher-insert="spreadsheet" title='@LT("Drag to create and place a spreadsheet, or click to open a workbook")' @onclick="OpenSpreadsheetPicker"><i class="pub-icon pub-icon-spreadsheet"></i>@LT("Sheet")</button>
        <button type="button" draggable="true" data-publisher-insert="video" title='@LT("Drag to create or import and place a video, or click to insert")' @onclick="OpenVideoPicker"><i class="pub-icon pub-icon-video"></i>@LT("Video")</button>
        <button type="button" title='@LT("Create an animated HTML-compatible 3D blob with embedded OpenSCAD interchange source")' @onclick="InsertDefaultVideoBlob"><i class="pub-icon pub-icon-effects"></i>@LT("3D Blob")</button>
        <small>@LT("Ctrl/Shift-click objects for multi-selection")</small>
    </div>

    <div id="publisher-workspace" class="editor-workspace @(_timelineVisible ? "timeline-open" : null)">
        <PageNavigator State="State" TimelineVisible="_timelineVisible" RequestToggleTimeline="ToggleTimeline" />
        <button type="button" class="workspace-splitter splitter-left" data-workspace-splitter="left" title="Drag to resize pages pane; double-click to collapse" aria-label="Resize pages pane"></button>
        <PageSurface @ref="_pageSurface" State="State" SelectionVisualsEnabled="@MainframeSelectionVisualsEnabled" EditTextRequested="OpenStoryEditorById" RequestPicture="OpenPicturePicker" RequestReplacePicture="OpenReplacePicturePicker" RequestCreatePicture="CreatePicture" RequestEditPicture="EditSelectedPicture"
                     RequestInsertSpreadsheet="OpenSpreadsheetPicker" RequestCreateSpreadsheet="CreateSpreadsheet" RequestEditSpreadsheet="OpenSpreadsheetEditor" RequestDownloadSpreadsheet="DownloadSelectedSpreadsheet"
                     RequestInsertDataVisual="InsertDataVisual" RequestEditDataVisual="OpenDataVisualEditor" RequestManageData="OpenDataManager"
                     RequestInsertComponent="InsertComponent" RequestEditComponent="OpenComponentEditor"
                     RequestInsertVideo="OpenVideoPicker" RequestInsertAudio="OpenAudioPicker" RequestCreateVideo="CreateVideo" RequestCreateAudio="CreateAudio" RequestEditMedia="EditSelectedMedia"
                     RequestInsertBarcode="InsertBarcode" RequestEditBarcode="EditBarcode"
                     RequestInsertPanel="InsertPanel" RequestInsertHtmlEmbed="InsertHtmlEmbed" RequestEditPanel="OpenPanelStudio"
                     TimelineVisible="_timelineVisible" RequestToggleTimeline="ToggleTimeline" RequestCanvasInsert="HandleCanvasInsert"
                     RequestExternalFileDrop="HandleExternalFileDrop" RequestExternalDropError="HandleExternalDropError" />
        <button type="button" class="workspace-splitter splitter-right" data-workspace-splitter="right" title="Drag to resize properties pane; double-click to collapse" aria-label="Resize properties pane"></button>
        <InspectorPanel State="State"
                        OnEditStory="OpenStoryEditor"
                        OnReplacePicture="OpenReplacePicturePicker"
                        OnInsertPicture="OpenPicturePicker"
                        OnCreatePicture="CreatePicture"
                        OnEditPicture="EditSelectedPicture"
                        OnInsertSpreadsheet="OpenSpreadsheetPicker"
                        OnCreateSpreadsheet="CreateSpreadsheet"
                        OnEditSpreadsheet="OpenSpreadsheetEditor"
                        OnDownloadSpreadsheet="DownloadSelectedSpreadsheet"
                        OnApplyTransparentColor="ApplyTransparentColor"
                        OnRestoreOriginalPicture="RestoreOriginalPicture"
                        OnInsertDataVisual="InsertDataVisual"
                        OnEditDataVisual="OpenDataVisualEditor"
                        OnManageData="OpenDataManager"
                        OnInsertComponent="InsertComponent"
                        OnEditComponent="OpenComponentEditor"
                        OnInsertVideo="OpenVideoPicker"
                        OnInsertAudio="OpenAudioPicker"
                        OnCreateVideo="CreateVideo"
                        OnCreateAudio="CreateAudio"
                        OnEditMedia="EditSelectedMedia"
                        OnInsertBarcode="InsertBarcode"
                        OnEditBarcode="EditBarcode"
                        OnInsertPanel="InsertPanel"
                        OnEditPanel="OpenPanelStudio"
                        OnOpenMediaConverter="OpenMediaConverter" />

        @if (_timelineVisible)
        {
            <PublicationTimeline State="State"
                                 RequestClose="HideTimeline"
                                 RequestInsertAudio="OpenAudioPicker"
                                 RequestInsertVideo="OpenVideoPicker"
                                 RequestCreateAudio="CreateAudio"
                                 RequestCreateVideo="CreateVideo"
                                 RequestEditMedia="EditSelectedMedia" />
        }
    </div>

    @if (State.Document.View.PanelLibraryVisible)
    {
        <PanelLibrary Insert="InsertPanelPreset" Close="ClosePanelLibrary" />
    }

    <footer class="status-bar">
        <span>Page @(State.Document.Pages.FindIndex(p => p.Id == State.SelectedPageId) + 1) of @State.Document.Pages.Count</span>
        <span>@SelectionStatus</span>
        <span>@State.CurrentPage.WidthMm.ToString("0.#", CultureInfo.InvariantCulture) × @State.CurrentPage.HeightMm.ToString("0.#", CultureInfo.InvariantCulture) mm</span>
        <label class="zoom-control" title="Drag or use the arrow keys in 1% steps, type an exact percentage, or reset to 100%. Slider changes are committed after release so the thumb cannot fight a canvas rerender.">
            <span>Zoom</span>
            <button type="button" title="Zoom out by 5%" @onclick="ZoomOut">−</button>
            <input class="zoom-range" type="range" min="20" max="400" step="1" value="@ZoomPercent"
                   oninput="const field=this.closest('.zoom-control')?.querySelector('.zoom-percent-input'); if(field) field.value=this.value;"
                   @onchange="ChangeZoomPercent" aria-label="Canvas zoom" />
            <button type="button" title="Zoom in by 5%" @onclick="ZoomIn">+</button>
            <input class="zoom-percent-input" type="number" min="20" max="400" step="1" value="@ZoomPercent"
                   @onchange="ChangeZoomPercent" aria-label="Exact canvas zoom percentage" />
            <span aria-hidden="true">%</span>
            <button type="button" class="zoom-reset" title="Reset zoom to 100%" @onclick="Zoom100">100%</button>
        </label>
    </footer>
</div>

<InputFile id="publication-file-input" class="hidden-file-input" accept=".json,.pubstudio.json,application/json" OnChange="OpenPublication" />
<InputFile id="opendocument-file-input" class="hidden-file-input" accept=".odg,.odp,.fodg,.fodp,application/vnd.oasis.opendocument.graphics,application/vnd.oasis.opendocument.presentation,application/xml,text/xml" OnChange="ImportOpenDocument" />
<InputFile id="picture-file-input" class="hidden-file-input" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml" OnChange="InsertPicture" />
<InputFile id="spreadsheet-file-input" class="hidden-file-input" accept=".xlsx,.xlsm,.xls,.csv,.txt,.tsv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv,text/plain" OnChange="InsertSpreadsheet" />
<InputFile id="video-file-input" class="hidden-file-input" accept=".mp4,.m4v,.webm,.ogv,.ogg,.mov,video/mp4,video/x-m4v,video/webm,video/ogg,video/quicktime" OnChange="InsertVideo" />
<InputFile id="audio-file-input" class="hidden-file-input" accept="audio/mpeg,audio/mp4,audio/wav,audio/x-wav,audio/ogg,audio/webm,audio/flac" OnChange="InsertAudio" />

<PrintPublication Document="State.Document" />

<StoryEditor Visible="_storyEditorVisible"
             TextFrame="@(State.SelectedElement as TextFrameElement)"
             PublicationName="@State.Document.Name"
             PageName="@State.CurrentPage.Name"
             PageNumber="@CurrentPageNumber"
             PageCount="@State.Document.Pages.Count"
             OpenAiOnShow="_storyOpenAiOnShow"
             Saved="SaveStory"
             Cancelled="CloseStoryEditor" />

<SpreadsheetEditor Visible="@_spreadsheetEditorVisible"
                   SessionId="@_spreadsheetEditorSessionId"
                   FileName="@_spreadsheetEditorFileName"
                   Saved="SaveSpreadsheet"
                   DataObjectCreated="CreateSpreadsheetDataObject"
                   Cancelled="CloseSpreadsheetEditor" />

<PictureEditor Visible="@_pictureEditorVisible"
               SessionId="@_pictureEditorSessionId"
               InitialDocument="@_pictureEditorInitialDocument"
               InitialRasterDataUrl="@_pictureEditorInitialRaster"
               InitialName="@_pictureEditorInitialName"
               EditingExisting="@(_pictureEditorTargetId is not null)"
               Saved="SavePictureStudio"
               Cancelled="ClosePictureStudio" />

<MediaStudio Visible="_mediaStudioVisible"
             SessionId="_mediaStudioSessionId"
             Kind="_mediaStudioKind"
             InitialMedia="_mediaStudioInitial"
             InitialInsertedSegment="_mediaStudioInitialInsertedSegment"
             EditingExisting="@(_mediaStudioTargetId is not null)"
             Saved="SaveMediaStudio"
             SendToMediaConverter="OpenMediaConverterFromStudio"
             InsertLayerIntoMainframe="InsertVideoLayerIntoMainframe"
             Cancelled="CloseMediaStudio" />

<DataVisualEditor Visible="_dataVisualEditorVisible" State="State" Saved="SaveDataVisualEditor" Cancelled="CancelDataVisualEditor" ManageDataRequested="OpenDataManagerFromVisual" />
<DevExtremeComponentEditor Visible="_componentEditorVisible" State="State" Saved="SaveComponentEditor" Cancelled="CancelComponentEditor" ManageDataRequested="OpenDataManagerFromComponent" />
<DataManager Visible="_dataManagerVisible" State="State" Closed="CloseDataManager" DataChanged="DataManagerChanged" />
<BarcodeEditor Visible="_barcodeEditorVisible" Item="@(State.SelectedElement as BarcodeElement)" Saved="SaveBarcode" Cancelled="CancelBarcode" />
<StreamingStudio Visible="_streamingStudioVisible" Document="State.Document" Saved="SaveStreamingStudio" Cancelled="CloseStreamingStudio" />
<PanelStudio Visible="_panelStudioVisible" Document="State.Document" CurrentPageId="State.SelectedPageId" InitialPanel="_panelStudioInitial" Saved="SavePanelStudio" Cancelled="ClosePanelStudio" />
<MediaConverterStudio Visible="_mediaConverterVisible" InitialSource="_mediaConverterInitialSource" Closed="CloseMediaConverter" Inserted="InsertConvertedMedia" OpenedInStudio="OpenConvertedInStudio" />
<PageEffectStudio Visible="_pageEffectStudioVisible" State="State" Closed="ClosePageEffectStudio" />

@if (_selectedPictureExportVisible)
{
    <div class="publisher-dialog-backdrop" role="presentation" @onclick="CloseSelectedPictureExport">
        <section class="publisher-dialog selected-picture-export-dialog" role="dialog" aria-modal="true" aria-labelledby="selected-picture-export-title" @onclick:stopPropagation>
            <header>
                <div>
                    <h2 id="selected-picture-export-title">Export Picture Studio object</h2>
                    <p>This picture still owns editable Picture Studio layers. Choose whether the file should contain the final merged appearance or the editable layer stack.</p>
                </div>
                <button type="button" class="publisher-dialog-close" title="Close" @onclick="CloseSelectedPictureExport">×</button>
            </header>
            <div class="selected-picture-export-options">
                <button type="button" class="primary" @onclick="ExportSelectedMergedChoice">Merged @(_selectedPictureExportFormat.ToUpperInvariant())</button>
                <button type="button" @onclick="ExportSelectedLayeredChoice">Layered Picture Studio SVG</button>
                <small>Merged export bakes recoloring, paint, effects and all visible layers into the final pixels. Layered SVG preserves the Picture Studio layer document for later editing.</small>
            </div>
            <footer><button type="button" @onclick="CloseSelectedPictureExport">Cancel</button></footer>
        </section>
    </div>
}

@if (_singleWebsiteExportVisible)
{
    <div class="publisher-dialog-backdrop" role="presentation" @onclick="CloseSingleWebsiteExport">
        <section class="publisher-dialog website-export-dialog" role="dialog" aria-modal="true" aria-labelledby="single-website-export-title" @onclick:stopPropagation>
            <header>
                <div>
                    <h2 id="single-website-export-title">@(_singleWebsiteMode == "presentation" ? "Interactive presentation website" : "Single-file website")</h2>
                    <p>Creates one portable HTML file. Choose whether embedded pictures and videos stay exact or are recompressed before they are embedded.</p>
                </div>
                <button type="button" class="publisher-dialog-close" title="Close" @onclick="CloseSingleWebsiteExport">×</button>
            </header>
            <div class="website-export-grid">
                <label>
                    <span>Pictures</span>
                    <select @bind="_singleWebsiteOptions.ImageMode">
                        <option value="preserve">Preserve source — exact/lossless</option>
                        <option value="png">PNG — lossless pixels</option>
                        <option value="webp">WebP — smaller, lossy</option>
                        <option value="avif">AVIF — smallest when browser encoding is available</option>
                    </select>
                    <small>SVG and animated images remain untouched. Unsupported conversions automatically retain the source.</small>
                </label>
                @if (_singleWebsiteOptions.ImageMode is "webp" or "avif")
                {
                    <label>
                        <span>Picture quality: @Math.Round(_singleWebsiteOptions.ImageQuality * 100)%</span>
                        <input type="range" min="0.35" max="1" step="0.01" @bind="_singleWebsiteOptions.ImageQuality" @bind:event="oninput" />
                    </label>
                }
                <label>
                    <span>Videos</span>
                    <select @bind="_singleWebsiteOptions.VideoMode">
                        <option value="preserve">Preserve source — exact/lossless</option>
                        <option value="webm">WebM VP9/VP8 + Opus — browser conversion</option>
                    </select>
                    <small>WebM conversion is local and can take approximately the duration of the video.</small>
                </label>
                @if (_singleWebsiteOptions.VideoMode == "webm")
                {
                    <label>
                        <span>Video quality: @Math.Round(_singleWebsiteOptions.VideoQuality * 100)%</span>
                        <input type="range" min="0.35" max="1" step="0.01" @bind="_singleWebsiteOptions.VideoQuality" @bind:event="oninput" />
                    </label>
                    <label class="publisher-check-row">
                        <input type="checkbox" @bind="_singleWebsiteOptions.KeepVideoFallback" />
                        <span>Keep source video if conversion fails or is not smaller</span>
                    </label>
                }
            </div>
            <aside class="website-export-doctrine">Preserve is the default and changes nothing. Compression only affects media embedded into this exported file; publication source data stays untouched.</aside>
            <footer>
                <DxButton Text="Cancel" Enabled="@(!_singleWebsiteExporting)" Click="CloseSingleWebsiteExport" />
                <DxButton Text="@(_singleWebsiteExporting ? "Exporting…" : "Export HTML")" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!_singleWebsiteExporting)" Click="ExportSingleWebsite" />
            </footer>
        </section>
    </div>
}

@if (_structuredWebsiteExportVisible)
{
    <div class="publisher-dialog-backdrop" role="presentation" @onclick="CloseStructuredWebsiteExport">
        <section class="publisher-dialog website-export-dialog" role="dialog" aria-modal="true" aria-labelledby="structured-export-title" @onclick:stopPropagation>
            <header>
                <div>
                    <h2 id="structured-export-title">Structured website export</h2>
                    <p>Creates an offline ZIP with <code>index.html</code>, separate CSS/JavaScript, and deduplicated media assets.</p>
                </div>
                <button type="button" class="publisher-dialog-close" title="Close" @onclick="CloseStructuredWebsiteExport">×</button>
            </header>

            <div class="website-export-grid">
                <label>
                    <span>Website behavior</span>
                    <select @bind="_structuredWebsiteOptions.Mode">
                        <option value="site">Website</option>
                        <option value="presentation">Interactive presentation</option>
                    </select>
                    <small>Uses the same runtime and interactions as the matching single-file export.</small>
                </label>

                <label>
                    <span>Pictures</span>
                    <select @bind="_structuredWebsiteOptions.ImageMode">
                        <option value="preserve">Preserve source — exact/lossless</option>
                        <option value="png">PNG — lossless pixels</option>
                        <option value="webp">WebP — smaller, lossy</option>
                        <option value="avif">AVIF — smallest when browser encoding is available</option>
                    </select>
                    <small>SVG and animated images are preserved so vector data and animation are not flattened.</small>
                </label>

                @if (_structuredWebsiteOptions.ImageMode is "webp" or "avif")
                {
                    <label>
                        <span>Picture quality: @Math.Round(_structuredWebsiteOptions.ImageQuality * 100)%</span>
                        <input type="range" min="0.35" max="1" step="0.01" @bind="_structuredWebsiteOptions.ImageQuality" @bind:event="oninput" />
                        <small>The exporter keeps the original whenever conversion is unsupported or does not reduce the file.</small>
                    </label>
                }

                <label>
                    <span>Videos</span>
                    <select @bind="_structuredWebsiteOptions.VideoMode">
                        <option value="preserve">Preserve source — exact/lossless</option>
                        <option value="webm">WebM VP9/VP8 + Opus — optional browser conversion</option>
                    </select>
                    <small>WebM conversion runs locally in the browser and can take approximately the video duration.</small>
                </label>

                @if (_structuredWebsiteOptions.VideoMode == "webm")
                {
                    <label>
                        <span>Video quality: @Math.Round(_structuredWebsiteOptions.VideoQuality * 100)%</span>
                        <input type="range" min="0.35" max="1" step="0.01" @bind="_structuredWebsiteOptions.VideoQuality" @bind:event="oninput" />
                    </label>
                    <label class="publisher-check-row">
                        <input type="checkbox" @bind="_structuredWebsiteOptions.KeepVideoFallback" />
                        <span>Keep the original video as a compatibility fallback</span>
                    </label>
                }

                <label class="publisher-check-row">
                    <input type="checkbox" @bind="_structuredWebsiteOptions.CompressArchive" />
                    <span>Deflate HTML, CSS, and JavaScript inside the ZIP when the browser supports it</span>
                </label>
            </div>

            <aside class="website-export-doctrine">
                Separating media from HTML is already lossless and removes Base64 overhead. PublisherStudio never labels video transcoding as lossless; exact preservation remains the default.
            </aside>

            <footer>
                <button type="button" @onclick="CloseStructuredWebsiteExport" disabled="@_structuredWebsiteExporting">Cancel</button>
                <button type="button" class="primary" @onclick="ExportStructuredWebsite" disabled="@_structuredWebsiteExporting">
                    @(_structuredWebsiteExporting ? "Exporting…" : "Export website ZIP")
                </button>
            </footer>
        </section>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="toast error" @onclick="() => _error = null">@_error</div>
}

@if (!string.IsNullOrWhiteSpace(_notice))
{
    <div class="toast notice" @onclick="() => _notice = null">@_notice</div>
}

<DocumentationViewerHost />

@code {
    private PageSurface? _pageSurface;
    private bool MainframeSelectionVisualsEnabled =>
        !_storyEditorVisible && !_spreadsheetEditorVisible && !_pictureEditorVisible &&
        !_dataVisualEditorVisible && !_componentEditorVisible && !_mediaStudioVisible &&
        !_barcodeEditorVisible && !_streamingStudioVisible && !_panelStudioVisible &&
        !_mediaConverterVisible && !_structuredWebsiteExportVisible && !_singleWebsiteExportVisible && !_selectedPictureExportVisible && !_pageEffectStudioVisible;
    private bool _storyEditorVisible;
    private bool _storyOpenAiOnShow;
    private bool _spreadsheetEditorVisible;
    private Guid _spreadsheetEditorSessionId;
    private Guid? _spreadsheetEditorTargetId;
    private Guid? _pendingNewSpreadsheetId;
    private string _spreadsheetEditorFileName = "Spreadsheet.xlsx";
    private bool _pictureEditorVisible;
    private bool _dataVisualEditorVisible;
    private bool _componentEditorVisible;
    private bool _dataManagerVisible;
    private bool _mediaStudioVisible;
    private bool _timelineVisible;
    private bool _barcodeEditorVisible;
    private bool _streamingStudioVisible;
    private bool _panelStudioVisible;
    private bool _mediaConverterVisible;
    private bool _pageEffectStudioVisible;
    private MediaConversionInsertRequest? _mediaConverterInitialSource;
    private PanelElement? _panelStudioInitial;
    private Guid? _panelStudioTargetId;
    private bool _panelStudioTargetsHtml;
    private bool _videoExporting;
    private bool _singleWebsiteExportVisible;
    private bool _singleWebsiteExporting;
    private string _singleWebsiteMode = "site";
    private bool _structuredWebsiteExportVisible;
    private bool _structuredWebsiteExporting;
    private bool _selectedPictureExportVisible;
    private string _selectedPictureExportFormat = "png";
    private Guid? _selectedPictureExportTargetId;
    private readonly StructuredWebsiteExportOptions _structuredWebsiteOptions = new();
    private readonly SingleWebsiteExportOptions _singleWebsiteOptions = new();
    private Guid? _pendingNewBarcodeId;
    private Guid _mediaStudioSessionId;
    private Guid? _mediaStudioTargetId;
    private PublicationElementKind _mediaStudioKind = PublicationElementKind.Audio;
    private PublicationMediaElement? _mediaStudioInitial;
    private PublicationMediaSegment? _mediaStudioInitialInsertedSegment;
    private Guid? _pendingNewDataVisualId;
    private Guid? _pendingNewComponentId;
    private bool _resumeDataVisualAfterManager;
    private bool _resumeComponentAfterManager;
    private Guid _pictureEditorSessionId;
    private Guid? _pictureEditorTargetId;
    private PictureDocument? _pictureEditorInitialDocument;
    private string? _pictureEditorInitialRaster;
    private string _pictureEditorInitialName = "Picture";
    private CanvasInsertRequest? _pendingCanvasInsert;
