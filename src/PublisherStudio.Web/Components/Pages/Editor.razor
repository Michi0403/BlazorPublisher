    /// <summary>
    /// Opens panel studio for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    private void OpenPanelStudio()
    {
        try
        {
            if (State.SelectedElement is PanelElement panel)
            {
                _panelStudioTargetId = panel.Id;
                _panelStudioTargetsHtml = false;
                _panelStudioInitial = (PanelElement)Files.CloneElement(panel);
            }
            else if (State.SelectedElement is HtmlEmbedElement html)
            {
                // Mainframe coordinates belong to the outer object. Panel Studio uses its own
                // local canvas and must never reuse the outer element id for a descendant.
                var embeddedHtml = (HtmlEmbedElement)Files.CloneElement(html);
                embeddedHtml.Id = Guid.NewGuid();
                embeddedHtml.X = 0;
                embeddedHtml.Y = 0;
                embeddedHtml.Width = 160;
                embeddedHtml.Height = 90;
                embeddedHtml.Rotation = 0;
                embeddedHtml.ZIndex = 1;
                var view = new PublicationPanelView { Name = "Web content", Slug = "web-content", Elements = [embeddedHtml] };
                _panelStudioTargetId = html.Id;
                _panelStudioTargetsHtml = true;
                _panelStudioInitial = new PanelElement
                {
                    Id = html.Id,
                    Name = html.Name,
                    Width = html.Width,
                    Height = html.Height,
                    CanvasWidth = 160,
                    CanvasHeight = 90,
                    NavigationMode = PublicationPanelNavigationMode.Hidden,
                    ActiveViewId = view.Id,
                    Views = [view]
                };
            }
            else return;
            _panelStudioVisible = true;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(OpenPanelStudio)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Persists panel studio for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="draft">Draft value supplied to the editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task SavePanelStudio(PanelElement draft)
    {
        try
        {
            if (_panelStudioTargetId is not { } targetId)
                throw new InvalidOperationException("Panel Studio no longer has a valid Mainframe target.");

            State.SelectElement(targetId);
            bool applied;
            if (_panelStudioTargetsHtml)
            {
                var authored = draft.Views.SelectMany(view => view.Elements).Where(element => element.Visible).ToArray();
                var html = ElementTraversal.Descendants(authored).OfType<HtmlEmbedElement>().FirstOrDefault();
                // A single HTML object can stay a lightweight Mainframe HTML element only while it
                // still represents the complete local Panel Studio canvas. Once the author moves,
                // resizes or rotates it, that geometry is meaningful panel-local state and must be
                // preserved by promoting the Mainframe object to a PanelElement.
                var fillsLocalCanvas = html is not null
                    && Math.Abs(html.X) < 0.0001
                    && Math.Abs(html.Y) < 0.0001
                    && Math.Abs(html.Width - draft.CanvasWidth) < 0.0001
                    && Math.Abs(html.Height - draft.CanvasHeight) < 0.0001
                    && Math.Abs(html.Rotation) < 0.0001;
                var remainsStandaloneHtml = draft.Views.Count == 1
                    && authored.Length == 1
                    && authored[0] is HtmlEmbedElement
                    && draft.NavigationMode == PublicationPanelNavigationMode.Hidden
                    && fillsLocalCanvas;
                applied = remainsStandaloneHtml && html is not null
                    ? State.ApplySelectedHtmlEmbed(html)
                    : State.PromoteSelectedHtmlEmbedToPanel(draft);
            }
            else applied = State.ApplySelectedPanel(draft);

            if (!applied)
                throw new InvalidOperationException("The selected Mainframe object changed while Panel Studio was open. The panel was not overwritten.");

            ClosePanelStudio();
            ShowNotice("Panel changes applied to the Mainframe and export model.");
            return Task.CompletedTask;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(SavePanelStudio)} failed.");
            throw;
        }
    }
