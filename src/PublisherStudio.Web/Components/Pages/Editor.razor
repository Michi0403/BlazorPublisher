    /// Performs select program page for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="pageId">Identifier of the page to use for this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task SelectProgramPage(Guid pageId)
    {
        try
        {
            var page = State.Document.Pages.FirstOrDefault(item => item.Id == pageId);
            if (page is null) return Task.CompletedTask;
            StreamingSession.SetProgramPage(pageId);
            var settings = CloneStreaming(State.Document.Streaming);
            settings.ProgramPageId = pageId;
            settings.FollowSelectedPage = false;
            State.ApplyStreamingSettings(settings);
            if (State.SelectedPageId != pageId) State.SelectPage(pageId);
            ShowNotice($"Program page: {page.Name}");
            return Task.CompletedTask;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(SelectProgramPage)} failed.");
            throw;
