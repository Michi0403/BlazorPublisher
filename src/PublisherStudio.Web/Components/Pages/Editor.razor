    /// <param name="elementId">Identifier of the element to use for this operation.</param>
    /// <param name="pendingNew">Value indicating whether pending new should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task OpenSpreadsheetEditorById(Guid elementId, bool pendingNew = false)
    {
        try
        {
            var spreadsheet = State.CurrentPage.Elements.OfType<SpreadsheetElement>().FirstOrDefault(item => item.Id == elementId);
            if (spreadsheet is null) return;
            await CancelPublisherPointerAsync().ConfigureAwait(true);
            if (_spreadsheetEditorSessionId != Guid.Empty) SpreadsheetSessions.Remove(_spreadsheetEditorSessionId);
            State.SelectElement(spreadsheet.Id);
            var session = SpreadsheetSessions.Create(spreadsheet.Id, spreadsheet.WorkbookFileName, spreadsheet.StorageFormat, spreadsheet.WorkbookContent);
            _spreadsheetEditorSessionId = session.Id;
            _spreadsheetEditorTargetId = spreadsheet.Id;
            _spreadsheetEditorFileName = session.FileName;
            if (!pendingNew) _pendingNewSpreadsheetId = null;
            _spreadsheetEditorVisible = true;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(OpenSpreadsheetEditorById)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Creates spreadsheet data object for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="result">Result value supplied to the editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task CreateSpreadsheetDataObject(SpreadsheetDataObjectResult result)
    {
        try
        {
            try
            {
                var schema = result.Columns.Count > 0
                    ? result.Columns.Select(column => new PublicationDataColumn { Name = column.Name, ValueKind = column.ValueKind, ValueKindExplicit = column.ValueKindExplicit }).ToList()
                    : result.ColumnNames.Select(name => new PublicationDataColumn { Name = name }).ToList();
                var rows = result.Rows.Select(row =>
                {
                    var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                    for (var index = 0; index < schema.Count; index++)
                        values[schema[index].Name] = index < row.Count ? row[index] : string.Empty;
                    return values;
                }).ToList();
                var data = new PublicationDataObject
                {
                    Name = result.Name,
                    SourceKind = PublicationDataSourceKind.Json,
                    SourceReference = $"{result.WorkbookFileName} · {result.SheetName}!{result.RangeAddress}",
                    Columns = schema,
                    RawSource = System.Text.Json.JsonSerializer.Serialize(rows)
                };
                State.UpsertDataObject(data);
                ShowNotice($"Created data object '{data.Name}' from {result.SheetName}!{result.RangeAddress}. It is ready for charts.");
            }
            catch (Exception ex)
            {
                ShowError(ex);
            }
            return Task.CompletedTask;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(CreateSpreadsheetDataObject)} failed.");
            throw;
        }
