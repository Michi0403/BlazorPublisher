    /// <summary>
    /// Exports video for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ExportVideo()
    {
        try
        {
            if (_videoExporting) return;
            _videoExporting = true;
            try
            {
                await State.RefreshWebDataAsync(force: true).ConfigureAwait(true);
                await InvokeAsync(StateHasChanged).ConfigureAwait(true);
                await SaveRecoveryNow().ConfigureAwait(true);
                var fileName = Files.SafeFileName(State.Document.Name) + ".webm";
                ShowNotice("Choose this browser tab in the capture dialog and enable tab audio when media sound should be included.");
                var result = await JS.InvokeAsync<VideoExportResult>(
                    "publisherStudio.exportPresentationVideo",
                    System.Threading.CancellationToken.None,
                    [".print-publication", fileName, State.Document.Name]).ConfigureAwait(true);
                var frame = result.PageSizedCapture && result.Width > 0 && result.Height > 0
                    ? $" · page frame {result.Width} × {result.Height}"
                    : " · full-tab fallback";
                if (Guid.TryParse(result.AssetId, out var retainedAssetId)
                    && MediaAssets.TryGet(retainedAssetId, out var exportedBytes, out var storedMimeType, out _))
                {
                    _mediaConverterInitialSource = new MediaConversionInsertRequest(
                        result.FileName,
                        MediaData.NormalizeMimeType(result.MimeType, storedMimeType),
                        exportedBytes,
                        "Mainframe video export");
                    _mediaConverterVisible = true;
                    ShowNotice($"Exported {result.FileName} ({result.DurationSeconds:0.##} seconds){frame}. The result is loaded in Media Converter Studio.");
                }
                else
                {
                    ShowNotice($"Exported {result.FileName} ({result.DurationSeconds:0.##} seconds){frame}. The download completed, but the converter hand-off was unavailable.");
                }
            }
            catch (Exception ex) when (ex.Message.Contains("cancel", StringComparison.OrdinalIgnoreCase))
            {
                ShowNotice("Video export cancelled. Your publication remains open and the latest recovery copy was kept.");
            }
            catch (Exception ex) { ShowError(ex); }
            finally
            {
                _videoExporting = false;
                try { await JS.InvokeVoidAsync("publisherStudio.restorePublisherWorkspaceAfterExport", "publisher-stage").ConfigureAwait(true); }
                catch (JSDisconnectedException) { }
                catch (TaskCanceledException) { }
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(ExportVideo)} failed.");
            throw;
        }
    }

