    /// <summary>
    /// Handles streaming hotkey for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="command">Command value supplied to the editor operation and used when producing its result.</param>
    /// <param name="targetId">Identifier of the target to use for this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    [JSInvokable]
    public Task HandleStreamingHotkey(string command, string? targetId) {
        try
        {
            return InvokeAsync(async () =>
    {
        switch (command?.Trim())
        {
            case "ToggleStreaming":
                if (StreamingSession.Snapshot.Mode == PublicationStreamSessionMode.Idle) await StartStreaming().ConfigureAwait(true);
                else await StopStreamingSession().ConfigureAwait(true);
                break;
            case "ToggleRecording":
                if (StreamingSession.Snapshot.Mode != PublicationStreamSessionMode.Idle) await ToggleStreamRecording().ConfigureAwait(true);
                else ShowNotice("Start a dry run or stream before toggling recording.");
                break;
            case "NextPage":
                await SelectAdjacentStreamingPage(1).ConfigureAwait(true);
                break;
            case "PreviousPage":
                await SelectAdjacentStreamingPage(-1).ConfigureAwait(true);
                break;
            case "SelectPage" when Guid.TryParse(targetId, out var pageId):
                await SelectProgramPage(pageId).ConfigureAwait(true);
                break;
            case "ToggleOutput" when Guid.TryParse(targetId, out var outputId):
                await ToggleStreamOutput(outputId).ConfigureAwait(true);
                break;
        }
    });
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(HandleStreamingHotkey)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs select adjacent streaming page for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="offset">Offset value supplied to the editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task SelectAdjacentStreamingPage(int offset)
    {
        try
        {
            if (State.Document.Pages.Count == 0) return;
            var currentId = StreamingSession.Snapshot.ProgramPageId ?? State.SelectedPageId;
            var currentIndex = State.Document.Pages.FindIndex(page => page.Id == currentId);
            if (currentIndex < 0) currentIndex = 0;
            var nextIndex = (currentIndex + offset + State.Document.Pages.Count) % State.Document.Pages.Count;
            await SelectProgramPage(State.Document.Pages[nextIndex].Id).ConfigureAwait(true);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(SelectAdjacentStreamingPage)} failed.");
            throw;
        }
    }

