    private async Task SelectChatOutput(Guid? outputId)
    {
        if (outputId is null)
        {
            await JS.InvokeVoidAsync("publisherStreaming.setOutputContext", new { mode = "operator", platform = "Preview", channel = "", outputId = "" });
            ShowNotice("Chat switched to preview messages.");
            return;
        }
        var output = State.Document.Streaming.Outputs.FirstOrDefault(item => item.Id == outputId.Value);
        if (output is null) return;
        var channel = output.ChatChannel;
        if (string.IsNullOrWhiteSpace(channel))
        {
            var machine = await StreamingProfiles.LoadAsync();
            channel = machine.Providers.FirstOrDefault(profile => profile.Id == output.ProfileId)?.ChannelId ?? string.Empty;
        }
        await JS.InvokeVoidAsync("publisherStreaming.setOutputContext", new
        {
            mode = "operator",
            platform = output.Provider.ToString(),
            channel,
            outputId = output.Id.ToString("D")
        });
        ShowNotice($"Operator Chat: {output.Name}. Broadcast outputs remain isolated.");
    }

    private Task SelectProgramPage(Guid pageId)
    {
        var page = State.Document.Pages.FirstOrDefault(item => item.Id == pageId);
        if (page is null) return Task.CompletedTask;
        StreamingSession.SetProgramPage(pageId);
        var settings = CloneStreaming(State.Document.Streaming);
        settings.ProgramPageId = pageId;
        settings.FollowSelectedPage = false;
        State.ApplyStreamingSettings(settings);
        if (State.SelectedPageId != pageId) State.SelectPage(pageId);
        ShowNotice($"Program page: {page.Name}");
        return Task.CompletedTask;
    }

    private PublicationStreamingSettings CloneStreaming(PublicationStreamingSettings settings) =>
        System.Text.Json.JsonSerializer.Deserialize<PublicationStreamingSettings>(
            System.Text.Json.JsonSerializer.Serialize(settings)) ?? new PublicationStreamingSettings();

    private Task OpenStoryEditorById(Guid id)
    {
        State.SelectElement(id);
        return OpenStoryEditor();
    }

    private async Task OpenStoryEditor()
    {
        if (State.SelectedElement is not TextFrameElement) return;
        await CancelPublisherPointerAsync();
        _storyEditorVisible = true;
    }

    private Task CloseStoryEditor()
    {
        _storyEditorVisible = false;
        _storyOpenAiOnShow = false;
        return Task.CompletedTask;
    }

    private Task SaveStory((byte[] Content, string PreviewHtml, string DocumentBackground, StoryStorageFormat Format) result)
    {
        State.UpdateTextDocument(result.Content, result.PreviewHtml, result.DocumentBackground, result.Format);
        _storyEditorVisible = false;
        _storyOpenAiOnShow = false;
        return Task.CompletedTask;
    }

    private bool CanUseAiCouncil => LocalGptConnection.State.IsLinked && LocalGptConnection.State.HasCapability("council.run");
    private string LT(string text) => Localization.GetText(text);
    private string CurrentCulture => Localization.ResolveAvailableCulture(System.Globalization.CultureInfo.CurrentUICulture.Name);
    private string LanguageLabel => Localization.Get("Text.Language", fallback: "Language");

    private void RenameDocument(ChangeEventArgs args)
    {
        State.RenameDocument(args.Value?.ToString() ?? string.Empty);
    }

    private int ZoomPercent => (int)Math.Round(State.Document.Zoom * 100, MidpointRounding.AwayFromZero);

    private void ChangeZoomPercent(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var percent))
            State.SetZoomPercent(percent);
    }

    private void ZoomIn() => State.StepZoomPercent(5);
    private void ZoomOut() => State.StepZoomPercent(-5);
    private void Zoom100() => State.SetZoomPercent(100);

    private void ShowError(Exception ex)
    {
        Logger.LogError(ex, "PublisherStudio editor operation failed.");
        _error = ex.Message;
        _notice = null;
        Notifications.Error(ex.Message, "PublisherStudio operation failed", nameof(Editor));
        StateChanged();
    }

    private void ShowNotice(string message)
    {
        Logger.LogInformation("PublisherStudio editor notice: {Message}", message);
        _notice = message;
        _error = null;
        Notifications.Information(message, source: nameof(Editor));
        StateChanged();
    }

