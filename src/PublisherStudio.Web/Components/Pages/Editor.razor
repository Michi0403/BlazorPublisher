        }
    }

    /// <summary>
    /// Handles the after render async lifecycle or event notification for <see cref="Editor"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="firstRender">Value indicating whether first render should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!_workspaceInitialized)
            {
                await JS.InvokeVoidAsync("publisherStudio.initializeWorkspace", "publisher-workspace").ConfigureAwait(true);
                await JS.InvokeVoidAsync("publisherStudio.setDocumentDirty", State.IsDirty).ConfigureAwait(true);
                _workspaceInitialized = true;
                _interactiveAttached = true;
                Logger.LogDebug("PublisherStudio Editor attached to the InteractiveServer circuit; browser interop is now available for this component instance.");
            }

            var hotkeySignature = System.Text.Json.JsonSerializer.Serialize(State.Document.Streaming.Hotkeys);
            if (!string.Equals(hotkeySignature, _boundStreamingHotkeys, StringComparison.Ordinal))
            {
                _streamingHotkeyReference ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("publisherStreaming.bindHotkeys", State.Document.Streaming.Hotkeys, _streamingHotkeyReference).ConfigureAwait(true);
                _boundStreamingHotkeys = hotkeySignature;
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(OnAfterRenderAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs state changed for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    private void StateChanged()
    {
        try
        {
            if (StreamingSession.Snapshot.Mode != PublicationStreamSessionMode.Idle
                && State.Document.Streaming.FollowSelectedPage
                && StreamingSession.Snapshot.ProgramPageId != State.SelectedPageId)
                StreamingSession.SetProgramPage(State.SelectedPageId);
            TaskRunner.Run(
                nameof(Editor),
                nameof(StateChanged),
                async _ => await InvokeAsync(async () =>
                {
                    try
                    {
                        if (_interactiveAttached)
                            await JS.InvokeVoidAsync("publisherStudio.setDocumentDirty", State.IsDirty).ConfigureAwait(true);
                    }
                    catch (InvalidOperationException exception)
                    {
                        Logger.LogDebug(exception, "Document dirty-state synchronization was unavailable during prerendering or teardown.");
                    }
                    catch (JSDisconnectedException exception)
                    {
                        Logger.LogDebug(exception, "Document dirty-state synchronization ended because the browser disconnected.");
                    }
                    catch (TaskCanceledException exception)
                    {
                        Logger.LogDebug(exception, "Document dirty-state synchronization was canceled.");
                    }
                    StateHasChanged();
                }).ConfigureAwait(false));
            if (State.IsDirty && State.Revision != _scheduledRecoveryRevision)
                ScheduleRecoverySave();
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(StateChanged)} failed.");
            throw;
        }
    }
