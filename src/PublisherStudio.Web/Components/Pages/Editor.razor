    /// <summary>
    /// Exports picture studio merged selection for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="selected">Image frame element dependency used by the editor workflow to provide the corresponding application capability.</param>
    /// <param name="format">Format value supplied to the editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ExportPictureStudioMergedSelection(ImageFrameElement selected, string format)
    {
        try
        {
            try
            {
                if (selected.PictureSource is null)
                    throw new InvalidOperationException("The selected picture no longer contains its Picture Studio document.");
                var normalized = format == "svg" ? "svg" : "png";
                var baseName = Files.SafeFileName(State.Document.Name);
                var objectName = Files.SafeFileName(selected.Name);
                var fileName = $"{baseName}-{objectName}.{normalized}";
                ShowNotice($"Rendering {selected.Name} through Picture Studio as merged {normalized.ToUpperInvariant()}…");
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pictureStudioInterop.js?v=2.6.5").ConfigureAwait(true);
                try
                {
                    if (normalized == "svg")
                        await module.InvokeVoidAsync("downloadPictureStudioMergedSvg", selected.PictureSource, fileName).ConfigureAwait(true);
                    else
                        await module.InvokeVoidAsync("downloadPictureStudio", selected.PictureSource, fileName, "image/png", 1d).ConfigureAwait(true);
                }
                finally
                {
                    try { await module.DisposeAsync().ConfigureAwait(true); } catch (JSDisconnectedException) { }
                }
                ShowNotice($"Exported {selected.Name} from the full Picture Studio canvas without Mainframe cropping.");
            }
            catch (Exception ex)
            {
                ShowError(ex);
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(ExportPictureStudioMergedSelection)} failed.");
            throw;
        }
    }

