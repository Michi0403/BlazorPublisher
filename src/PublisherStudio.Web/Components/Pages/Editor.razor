    /// <summary>
    /// Performs decode text for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="bytes">Bytes value supplied to the editor operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string DecodeText(byte[] bytes)
    {
        try
        {
            if (bytes.Length >= 3 && bytes[0] == 0xef && bytes[1] == 0xbb && bytes[2] == 0xbf)
                return Encoding.UTF8.GetString(bytes, 3, bytes.Length - 3);
            if (bytes.Length >= 2 && bytes[0] == 0xff && bytes[1] == 0xfe)
                return Encoding.Unicode.GetString(bytes, 2, bytes.Length - 2);
            if (bytes.Length >= 2 && bytes[0] == 0xfe && bytes[1] == 0xff)
                return Encoding.BigEndianUnicode.GetString(bytes, 2, bytes.Length - 2);
            return Encoding.UTF8.GetString(bytes);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(DecodeText)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Resolves dropped MIME type for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="name">Name value supplied to the editor operation and used when producing its result.</param>
    /// <param name="requested">Requested value supplied to the editor operation and used when producing its result.</param>
    /// <param name="stored">Stored value supplied to the editor operation and used when producing its result.</param>
    /// <param name="kind">Kind value supplied to the editor operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string ResolveDroppedMimeType(string name, string requested, string stored, string kind)
    {
        try
        {
            var declared = MediaData.NormalizeMimeType(requested, stored);
            if ((kind == "picture" && declared.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) ||
                (kind == "video" && declared.StartsWith("video/", StringComparison.OrdinalIgnoreCase)) ||
                (kind == "audio" && declared.StartsWith("audio/", StringComparison.OrdinalIgnoreCase)) ||
                kind is "spreadsheet" or "text" or "markdown" or "docx")
                return declared;
            return Path.GetExtension(name).ToLowerInvariant() switch
            {
                ".png" => "image/png",
                ".jpg" or ".jpeg" => "image/jpeg",
                ".gif" => "image/gif",
                ".webp" => "image/webp",
                ".svg" => "image/svg+xml",
                ".mp4" => "video/mp4",
                ".m4v" => "video/x-m4v",
                ".webm" => "video/webm",
                ".ogv" => "video/ogg",
                ".ogg" or ".oga" => kind == "audio" ? "audio/ogg" : "video/ogg",
                ".mov" => "video/quicktime",
                ".mp3" => "audio/mpeg",
                ".m4a" or ".aac" => "audio/mp4",
                ".wav" => "audio/wav",
                ".flac" => "audio/flac",
                ".md" or ".markdown" => "text/markdown",
                ".docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                ".xlsx" => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                ".xlsm" or ".xls" => "application/vnd.ms-excel",
                ".csv" => "text/csv",
                ".tsv" or ".txt" => "text/plain",
                _ => kind == "picture" ? "image/png"
                    : kind == "video" ? "video/mp4"
                    : kind == "audio" ? "audio/mpeg"
                    : kind == "docx" ? "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                    : "text/plain"
            };
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(ResolveDroppedMimeType)} failed.");
            throw;
        }
    }

