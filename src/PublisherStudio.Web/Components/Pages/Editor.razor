    /// <summary>
    /// Exports single website for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ExportSingleWebsite()
    {
        try
        {
            if (_singleWebsiteExporting) return;
            _singleWebsiteExporting = true;
            try
            {
                await State.RefreshWebDataAsync(force: true).ConfigureAwait(true);
                await InvokeAsync(StateHasChanged).ConfigureAwait(true);
                await SaveRecoveryNow().ConfigureAwait(true);
                var presentation = string.Equals(_singleWebsiteMode, "presentation", StringComparison.OrdinalIgnoreCase);
                var fileName = Files.SafeFileName(State.Document.Name) + (presentation ? ".html" : "-site.html");
                ShowNotice(presentation ? "Preparing interactive presentation HTML…" : "Preparing single-file website export…");
                await InvokeAsync(StateHasChanged).ConfigureAwait(true);
                await Task.Delay(1).ConfigureAwait(true);
                var result = presentation
                    ? await JS.InvokeAsync<SingleWebsiteExportResult>("publisherStudio.exportWebsite", fileName, State.Document.Name, _singleWebsiteOptions).ConfigureAwait(true)
                    : await JS.InvokeAsync<SingleWebsiteExportResult>("publisherStudio.exportSite", fileName, State.Document.Name, _singleWebsiteOptions).ConfigureAwait(true);
                _singleWebsiteExportVisible = false;
                var warningText = result.Warnings.Count > 0 ? $" · {result.Warnings.Count} warning(s)" : string.Empty;
                var savedText = result.SourceBytes > result.OutputBytes && result.SourceBytes > 0
                    ? $" · {100d - result.OutputBytes * 100d / result.SourceBytes:0.#}% media reduction"
                    : string.Empty;
                ShowNotice($"Exported {fileName}{savedText}{warningText}");
            }
            catch (Exception ex)
            {
                ShowError(ex);
            }
            finally
            {
                _singleWebsiteExporting = false;
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(ExportSingleWebsite)} failed.");
            throw;
        }
    }

