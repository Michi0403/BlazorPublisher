    /// <summary>
    /// Performs schedule recovery save for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    private void ScheduleRecoverySave()
    {
        try
        {
            _scheduledRecoveryRevision = State.Revision;
            var cancellation = new CancellationTokenSource();
            CancellationToken cancellationToken;
            lock (_recoveryCancellationSync)
            {
                cancellationToken = cancellation.Token;
                var previousCancellation = _recoverySaveCancellation;
                _recoverySaveCancellation = cancellation;
                previousCancellation?.Cancel();
            }

            try
            {
                TaskRunner.Run(
                    nameof(Editor),
                    nameof(DebouncedRecoverySaveAsync),
                    async _ =>
                    {
                        try
                        {
                            await DebouncedRecoverySaveAsync(cancellationToken).ConfigureAwait(false);
                        }
                        finally
                        {
                            lock (_recoveryCancellationSync)
                            {
                                if (ReferenceEquals(_recoverySaveCancellation, cancellation))
                                    _recoverySaveCancellation = null;
                                cancellation.Dispose();
                            }
                        }
                    },
                    cancellationToken);
            }
            catch
            {
                lock (_recoveryCancellationSync)
                {
                    if (ReferenceEquals(_recoverySaveCancellation, cancellation))
                        _recoverySaveCancellation = null;
                    cancellation.Dispose();
                }
                throw;
            }

        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(ScheduleRecoverySave)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs debounced recovery save for <see cref="Editor"/>, keeping the operation consistent with the state and invariants of the surrounding editor workflow.
    /// </summary>
    /// <param name="cancellationToken">Cancellation token that allows the caller to stop the asynchronous operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task DebouncedRecoverySaveAsync(CancellationToken cancellationToken)
    {
        try
        {
            try
            {
                if (cancellationToken.IsCancellationRequested)
                {
                    Logger.LogDebug("Publication recovery debounce was superseded before its delay started.");
                    return;
                }

                var cancellationSignal = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
                using var cancellationRegistration = cancellationToken.Register(
                    static state => ((TaskCompletionSource<bool>)state!).TrySetResult(true),
                    cancellationSignal);
                var delayTask = Task.Delay(1800);
                var completedTask = await Task.WhenAny(delayTask, cancellationSignal.Task).ConfigureAwait(false);
                if (!ReferenceEquals(completedTask, delayTask) || cancellationToken.IsCancellationRequested)
                {
                    Logger.LogDebug("Publication recovery debounce was superseded by a newer revision or editor disposal.");
                    return;
                }

                await InvokeAsync(() => SaveRecoveryNow(cancellationToken)).ConfigureAwait(false);
            }
            catch (OperationCanceledException exception) when (cancellationToken.IsCancellationRequested)
            {
                Logger.LogDebug(exception, "Publication recovery persistence was canceled after the debounce elapsed.");
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Publication recovery save failed.");
                throw;
            }

        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Editor)}.{nameof(DebouncedRecoverySaveAsync)} failed.");
            throw;
        }
    }

