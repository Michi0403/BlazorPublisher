@rendermode InteractiveServer
@page "/help"
@inject PublisherStudio.Services.Documentation.IPublisherDocumentationCatalogService Documentation
@inject IUserNotificationService Notifications
@inject ILogger<Help> Logger
@inject NavigationManager Navigation
@inject IPublisherDocumentationViewerService Viewer

<PageTitle>PublisherStudio Documentation</PageTitle>
<UserNotificationHost />

<main class="publisher-help-page">
    <header class="publisher-help-hero">
        <div class="publisher-help-copy">
            <p class="publisher-help-kicker">PublisherStudio @Status.Version · documentation nook 🐾</p>
            <h1>Help and documentation</h1>
            <p>Open the complete guide, keep a PDF nearby, or jump straight to the part of the studio you are using now.</p>
            <div class="publisher-help-status" aria-label="Documentation status">
                <span class="publisher-help-badge @(Status.HtmlAvailable ? "ready" : "missing")">HTML @(Status.HtmlAvailable ? "ready" : "not built")</span>
                <span class="publisher-help-badge @(Status.PdfAvailable ? "ready" : "missing")">PDF @(Status.PdfAvailable ? "ready" : "not built")</span>
                <span class="publisher-help-badge neutral">@Status.CommentCount XML members</span>
                @if (Status.GeneratedAtUtc is DateTime generatedAtUtc)
                {
                    <span>Generated @generatedAtUtc.ToLocalTime().ToString("g")</span>
                }
            </div>
        </div>
        <div class="publisher-help-actions" aria-label="Documentation actions">
            <button class="publisher-help-primary" type="button" @onclick="OpenHtmlGuide">Open HTML guide</button>
            <button class="publisher-help-secondary" type="button" @onclick="OpenPdfBook">Open PDF book</button>
            <button class="publisher-help-secondary" type="button" @onclick="OpenApiReference">Browse API reference</button>
            <button class="publisher-help-secondary" type="button" @onclick="OpenBuildStatus">Build status</button>
        </div>
    </header>

    <section class="publisher-help-grid" aria-label="Documentation chapters">
        <button class="publisher-help-card" type="button" @onclick="OpenGettingStarted">
            <span aria-hidden="true">🌸</span><strong>Getting started</strong><small>Create a publication and learn the main flow.</small>
        </button>
        <button class="publisher-help-card" type="button" @onclick="OpenEditorWorkspace">
            <span aria-hidden="true">🖋️</span><strong>Editor workspace</strong><small>Pages, Mainframe, inspector, timeline, and arranging.</small>
        </button>
        <button class="publisher-help-card" type="button" @onclick="OpenPicturesAndMedia">
            <span aria-hidden="true">🎨</span><strong>Pictures and media</strong><small>Picture Studio, video, audio, selections, and preview behavior.</small>
        </button>
        <button class="publisher-help-card" type="button" @onclick="OpenStreamingAndRecording">
            <span aria-hidden="true">🎥</span><strong>Streaming and recording</strong><small>Profiles, sources, dry runs, recording, and outputs.</small>
        </button>
        <button class="publisher-help-card" type="button" @onclick="OpenPublishingAndExport">
            <span aria-hidden="true">✨</span><strong>Publishing and export</strong><small>PDF, images, websites, and recorded presentations.</small>
        </button>
        <button class="publisher-help-card" type="button" @onclick="OpenLocalGptAndOneWire">
            <span aria-hidden="true">🐾</span><strong>LocalGPT and 1-Wire</strong><small>The optional connection, ports, and approval boundaries.</small>
        </button>
        <button class="publisher-help-card" type="button" @onclick="OpenInstallerAndUpdates">
            <span aria-hidden="true">📦</span><strong>Installer and updates</strong><small>One-click AppData install, update, start, and shortcuts.</small>
        </button>
        <button class="publisher-help-card" type="button" @onclick="OpenTroubleshooting">
            <span aria-hidden="true">🛟</span><strong>Troubleshooting</strong><small>Build assets, ports, circuits, recording previews, and docs.</small>
        </button>
    </section>

    <footer class="publisher-help-footer">
        <button type="button" @onclick="BackToStudio">Back to PublisherStudio</button>
        <p>The documentation opens in an in-app viewer, so closing it returns to the unchanged studio state.</p>
    </footer>
</main>

<DocumentationViewerHost />

@code {

    /// <summary>
    /// Gets or sets the status value that forms part of the help state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The status value exposed by <see cref="Help"/>.</value>
    private PublisherDocumentationStatus Status { get; set; } = new();

    /// <summary>
    /// Handles the initialized lifecycle or event notification for <see cref="Help"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnInitialized()
    {
        try
        {
            try
            {
                Status = Documentation.GetStatus();
                Logger.LogInformation("Loaded PublisherStudio documentation status for version {Version}.", Status.Version);
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Loading PublisherStudio documentation status failed.");
                Notifications.Warning("The generated guide is not available yet. Run a normal build or release build to create it.", "Documentation is not ready", nameof(Help));
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Help)}.{nameof(OnInitialized)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Opens HTML guide for <see cref="Help"/>, keeping the operation consistent with the state and invariants of the surrounding help workflow.
    /// </summary>
    private void OpenHtmlGuide() {
        try
        {
            OpenDocumentation(Status.HtmlUrl, "PublisherStudio HTML guide", Status.HtmlAvailable);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Help)}.{nameof(OpenHtmlGuide)} failed.");
            throw;
        }
    }

