    /// <summary>
    /// Opens documentation for <see cref="Help"/>, keeping the operation consistent with the state and invariants of the surrounding help workflow.
    /// </summary>
    /// <param name="url">Url value supplied to the help operation and used when producing its result.</param>
    /// <param name="title">Title value supplied to the help operation and used when producing its result.</param>
    /// <param name="available">Value indicating whether available should apply to this operation.</param>
    private void OpenDocumentation(string url, string title, bool available = true)
    {
        try
        {
            try
            {
                if (!available)
                {
                    Notifications.Warning("The requested documentation artifact is not available in this build.", "Documentation is not ready", nameof(Help));
                    return;
                }

                Viewer.Open(new PublisherDocumentationViewerRequest { Url = url, Title = title });
                Logger.LogInformation("Opened PublisherStudio documentation view {DocumentationTitle} at {DocumentationUrl}.", title, url);
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Opening PublisherStudio documentation failed for {DocumentationUrl}.", url);
                Notifications.Warning("The documentation viewer could not be opened.", "Documentation viewer", nameof(Help));
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Help)}.{nameof(OpenDocumentation)} failed.");
            throw;
        }
    }


    /// <summary>
    /// Performs back to studio for <see cref="Help"/>, keeping the operation consistent with the state and invariants of the surrounding help workflow.
    /// </summary>
    private void BackToStudio() {
        try
        {
            Navigation.NavigateTo("/");
        }
        catch (Exception __componentMethodException)
        {
