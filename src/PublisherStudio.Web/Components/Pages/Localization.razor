@rendermode InteractiveServer
@page "/localization"
@using System.Text.Json
@inject PublisherStudio.Services.Configuration.IFileLocalizationService LocalizationService
@inject IUserNotificationService Notifications
@inject ILogger<Localization> Logger
@inject NavigationManager Navigation

<PageTitle>@L("Localization.Editor.PageTitle", "PublisherStudio translations")</PageTitle>

<main class="localization-editor-page">
    <header>
        <div>
            <p class="organic-plugin-kicker">PublisherStudio</p>
            <h1>@L("Localization.Editor.Title", "Translation editor")</h1>
            <p>@L("Localization.Editor.Intro", "Edit browser and application strings without changing the shipped source files. Overrides are stored in LocalAppData.")</p>
        </div>
        <button type="button" @onclick="Back">@L("Localization.Editor.Back", "Back to Publisher")</button>
    </header>

    <section class="localization-editor-toolbar">
        <label>@L("Localization.Editor.Culture", "Culture")
            <select value="@_culture" @onchange="ChangeCultureAsync">
                @foreach (var culture in LocalizationService.GetAvailableCultures())
                {
                    <option value="@culture">@LocalizationService.GetCultureDisplayName(culture)</option>
                }
            </select>
        </label>
        <label>@L("Localization.Editor.Filter", "Filter")<input @bind="_filter" @bind:event="oninput" placeholder='@L("Localization.Editor.SearchPlaceholder", "Search key or text")' /></label>
        <button type="button" @onclick="SaveAsync" disabled="@_saving">@(_saving ? L("Localization.Editor.Saving", "Saving…") : L("Localization.Editor.Save", "Save overrides"))</button>
        <button type="button" @onclick="ApplyCulture">@L("Localization.Editor.UseLanguage", "Use this language")</button>
    </section>

    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <p class="localization-editor-status" role="status">@_status</p>
    }

    <section class="localization-editor-grid">
        @foreach (var pair in FilteredStrings)
        {
            <label>
                <code>@pair.Key</code>
                <textarea rows="2" value="@pair.Value" @onchange="args => Update(pair.Key, args.Value?.ToString())"></textarea>
            </label>
        }
    </section>
</main>

@code {

    /// <summary>
    /// Stores the internal culture state used by <see cref="Localization"/> while executing its surrounding workflow.
    /// </summary>
    private string _culture = CultureInfo.CurrentUICulture.Name;
    /// <summary>
    /// Stores the internal filter state used by <see cref="Localization"/> while executing its surrounding workflow.
    /// </summary>
    private string _filter = string.Empty;
    /// <summary>
    /// Stores the in-memory strings collection maintained internally by <see cref="Localization"/> for its current workflow state.
    /// </summary>
    private Dictionary<string, string> _strings = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>
    /// Stores the internal status state used by <see cref="Localization"/> while executing its surrounding workflow.
    /// </summary>
    private string _status = string.Empty;
    /// <summary>
    /// Stores the internal saving state used by <see cref="Localization"/> while executing its surrounding workflow.
    /// </summary>
    private bool _saving;

    /// <summary>
    /// Gets the filtered strings collection maintained or exposed by this localization instance for downstream processing.
    /// </summary>
    /// <value>The filtered strings value exposed by <see cref="Localization"/>.</value>
    private IEnumerable<KeyValuePair<string, string>> FilteredStrings => _strings
        .Where(pair => string.IsNullOrWhiteSpace(_filter)
            || pair.Key.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || pair.Value.Contains(_filter, StringComparison.OrdinalIgnoreCase))
        .OrderBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Handles the initialized lifecycle or event notification for <see cref="Localization"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnInitialized()
    {
        try
        {
            try
            {
                if (!LocalizationService.GetAvailableCultures().Contains(_culture, StringComparer.OrdinalIgnoreCase)) _culture = "en-US";
                Load();
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Could not initialize the PublisherStudio localization editor.");
                _status = exception.Message;
                Notifications.Error(exception.Message, L("Localization.Editor.LoadFailed", "Translations could not be loaded"), nameof(Localization));
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Localization)}.{nameof(OnInitialized)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs change culture for <see cref="Localization"/>, keeping the operation consistent with the state and invariants of the surrounding localization workflow.
    /// </summary>
    /// <param name="args">Args value supplied to the localization operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task ChangeCultureAsync(ChangeEventArgs args)
    {
        try
        {
            _culture = args.Value?.ToString() ?? "en-US";
            Load();
            return Task.CompletedTask;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Localization)}.{nameof(ChangeCultureAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs load for <see cref="Localization"/>, keeping the operation consistent with the state and invariants of the surrounding localization workflow.
    /// </summary>
    private void Load()
    {
        try
        {
            _strings = new Dictionary<string, string>(LocalizationService.GetStrings(_culture), StringComparer.OrdinalIgnoreCase);
            _status = string.Format(CultureInfo.CurrentCulture, L("Localization.Editor.Loaded", "Loaded {0} strings for {1}."), _strings.Count, LocalizationService.GetCultureDisplayName(_culture));
            Logger.LogInformation("Loaded {StringCount} localization strings for culture {Culture}.", _strings.Count, _culture);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Localization)}.{nameof(Load)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs update for <see cref="Localization"/>, keeping the operation consistent with the state and invariants of the surrounding localization workflow.
    /// </summary>
    /// <param name="key">Key value supplied to the localization operation and used when producing its result.</param>
    /// <param name="value">Value value supplied to the localization operation and used when producing its result.</param>
    private void Update(string key, string? value) {
        try
        {
            _strings[key] = value ?? string.Empty;
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Localization)}.{nameof(Update)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs save for <see cref="Localization"/>, keeping the operation consistent with the state and invariants of the surrounding localization workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task SaveAsync()
    {
        try
        {
            _saving = true;
            try
            {
                await LocalizationService.SaveOverridesAsync(_culture, _strings).ConfigureAwait(true);
                _status = string.Format(CultureInfo.CurrentCulture, L("Localization.Editor.Saved", "Saved {0} {1} string overrides."), _strings.Count, LocalizationService.GetCultureDisplayName(_culture));
                Logger.LogInformation("Saved {StringCount} localization overrides for culture {Culture}.", _strings.Count, _culture);
                Notifications.Success(_status, L("Localization.Editor.SavedTitle", "Translations saved"), nameof(Localization));
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Could not save localization overrides for culture {Culture}.", _culture);
                _status = exception.Message;
                Notifications.Error(exception.Message, L("Localization.Editor.SaveFailed", "Translations were not saved"), nameof(Localization));
            }
            finally { _saving = false; }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Localization)}.{nameof(SaveAsync)} failed.");
            throw;
        }
    }


    /// <summary>Resolves one Translation Editor UI string through the existing file-localization service.</summary>
    /// <param name="key">Localization catalog key.</param>
    /// <param name="fallback">English fallback displayed when the catalog does not contain the key.</param>
    /// <returns>The localized user-interface text.</returns>
    private string L(string key, string fallback)
    {
        try
        {
            return LocalizationService.Get(key, CultureInfo.CurrentUICulture.Name, fallback);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Translation Editor localization lookup failed for key {LocalizationKey}.", key);
            return fallback;
        }
    }

    /// <summary>
    /// Applies culture for <see cref="Localization"/>, keeping the operation consistent with the state and invariants of the surrounding localization workflow.
    /// </summary>
    private void ApplyCulture() {
        try
        {
            Navigation.NavigateTo($"api/configuration/localization/select?culture={Uri.EscapeDataString(_culture)}&returnUrl=%2F", true);
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Localization)}.{nameof(ApplyCulture)} failed.");
            throw;
        }
    }
    /// <summary>
    /// Performs back for <see cref="Localization"/>, keeping the operation consistent with the state and invariants of the surrounding localization workflow.
    /// </summary>
    private void Back() {
        try
        {
            Navigation.NavigateTo("/");
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(Localization)}.{nameof(Back)} failed.");
            throw;
        }
    }

}
