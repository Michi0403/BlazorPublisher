    private async Task GenerateTextProposalAsync()
    {
        try
        {
            if (!CanGenerateTextProposal)
                return;

            try
            {
                var resolvedTeamKey = ResolveAiAssistTeamKey();
                var request = NewCouncilRequest(resolvedTeamKey);
                request.RequestedOrganicCapabilities = ResolveAiAssistCapabilities();
                request.ExternalProjectContextJson = System.Text.Json.JsonSerializer.Serialize(new
                {
                    Source = "PublisherStudio",
                    Target = _textGenerationTarget,
                    Workflow = "Reviewable PublisherStudio AI Assist proposal",
                    Profile = _aiAssistProfile,
                    TeamKey = resolvedTeamKey,
                    Publication = EditorState.Document.Name,
                    Page = EditorState.CurrentPage.Name,
                    SelectedElementId = EditorState.SelectedElement?.Id,
                    SelectedElementName = EditorState.SelectedElement?.Name,
                    SelectedElementKind = EditorState.SelectedElement?.Kind.ToString()
                });
                request.Prompt = $"""
    PublisherStudio AI Assist request:
    Profile: {_aiAssistProfile}
    Target: {_textGenerationTarget.Trim()}
    User request:
    {_textGenerationPrompt.Trim()}

    Required result contract:
    1. Use the connected PublisherStudio context and any requested organic capability that is actually advertised; do not invent unavailable routes.
    2. Generate the final reviewable text/result description for the target above. For spreadsheet, project or OpenSCAD work, preserve domain-specific structure and include exact source/formula/code where useful.
    3. Before completing the Council run, invoke the LocalGPT DX function publisher.text.proposal.request with JSON parameters containing target, text and a concise reason.
    4. Do not mutate the publication automatically. Once the user inserts the proposal it becomes ordinary PublisherStudio content and is included in normal HTML/export output.
    """;
                var id = await Connection.SendCouncilRequestAsync(request).ConfigureAwait(true);
                Notifications.Success($"Text-generation Council request {id} was submitted.", "Text proposal requested", nameof(OrganicPlugins));
                _textGenerationPrompt = string.Empty;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Could not submit the PublisherStudio text-generation request to LocalGPT.");
                Notifications.Error(ex.Message, "Text proposal request failed", nameof(OrganicPlugins));
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicPlugins)}.{nameof(GenerateTextProposalAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Prefills AI Assist from the currently selected PublisherStudio object without copying private document payloads into navigation state.
    /// </summary>
    private void ApplyCurrentPublisherContext()
    {
        try
        {
            try
            {
                var selected = EditorState.SelectedElement;
                if (selected is null)
                {
                    _textGenerationTarget = $"{EditorState.CurrentPage.Name} in {EditorState.Document.Name}";
                    return;
                }

                _textGenerationTarget = $"{selected.Name} ({selected.Kind})";
                _aiAssistProfile = selected switch
                {
                    TextFrameElement or WordArtElement => "writing",
                    SpreadsheetElement => "spreadsheet",
                    HtmlEmbedElement or DevExtremeComponentElement => "project",
                    _ when selected.Name.Contains("OpenSCAD", StringComparison.OrdinalIgnoreCase) || selected.Name.Contains("3D", StringComparison.OrdinalIgnoreCase) => "openscad",
                    _ => "auto"
                };
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "PublisherStudio could not prefill LocalGPT AI Assist from the current selection.");
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicPlugins)}.{nameof(ApplyCurrentPublisherContext)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Resolves the simple AI Assist profile to an advertised LocalGPT team while preserving the explicit team override as a fallback.
    /// </summary>
    private string ResolveAiAssistTeamKey()
    {
        try
        {
            try
            {
                var target = $"{_textGenerationTarget} {_textGenerationPrompt}".ToLowerInvariant();
                var preferredKey = _aiAssistProfile switch
                {
                    "spreadsheet" => "spreadsheet-team",
                    "openscad" => "openscad-team",
                    "project" => "general-project",
                    "writing" => "general",
                    _ when target.Contains("spreadsheet", StringComparison.Ordinal) || target.Contains("sheet", StringComparison.Ordinal) || target.Contains("table", StringComparison.Ordinal) => "spreadsheet-team",
                    _ when target.Contains("openscad", StringComparison.Ordinal) || target.Contains("scad", StringComparison.Ordinal) || target.Contains("3d", StringComparison.Ordinal) => "openscad-team",
                    _ when target.Contains("project", StringComparison.Ordinal) || target.Contains("source", StringComparison.Ordinal) || target.Contains("code", StringComparison.Ordinal) || target.Contains("file", StringComparison.Ordinal) => "general-project",
                    _ => _textGenerationTeamKey
                };

                return CouncilTeams.FirstOrDefault(team => string.Equals(team.Key, preferredKey, StringComparison.OrdinalIgnoreCase)).Key
                    ?? CouncilTeams.FirstOrDefault(team => string.Equals(team.Key, _textGenerationTeamKey, StringComparison.OrdinalIgnoreCase)).Key
                    ?? CouncilTeams.First().Key;
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "PublisherStudio could not resolve the requested AI Assist profile to a LocalGPT Council team.");
                return _textGenerationTeamKey;
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicPlugins)}.{nameof(ResolveAiAssistTeamKey)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Builds the PublisherStudio capabilities that may help the selected AI Assist profile without requiring unavailable routes.
    /// </summary>
    private List<string> ResolveAiAssistCapabilities()
    {
        try
        {
            try
            {
                var requested = new List<string> { "publisher.business-context", "publisher.text.insert.propose" };
                switch (_aiAssistProfile)
                {
                    case "spreadsheet":
                        requested.Add("publisher.spreadsheet.inspect");
                        break;
                    case "openscad":
                        requested.Add("publisher.openscad.generate");
                        break;
                }

                var localKeys = _capabilities
                    .Where(item => item.IsEnabled && item.IsOnline)
                    .Select(item => item.Key)
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);
                return requested.Where(key => localKeys.Contains(key)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "PublisherStudio could not build the AI Assist organic capability request.");
                return ["publisher.business-context", "publisher.text.insert.propose"];
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicPlugins)}.{nameof(ResolveAiAssistCapabilities)} failed.");
            throw;
        }
    }

