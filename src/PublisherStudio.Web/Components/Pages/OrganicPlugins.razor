    private async Task RunRoundTripTestAsync()
    {
        try
        {
            if (!Connection.State.IsConnected) return;
            try
            {
                _roundTripStatus = "Testing the linked 1-Wire transport…";
                var envelope = new OrganicWireEnvelope
                {
                    MessageType = OrganicWireMessageType.Ping,
                    TargetPeerId = Connection.State.PeerId,
                    UserConfirmed = true,
                    ExpiresUtc = DateTimeOffset.UtcNow.AddSeconds(10)
                };
                var correlationId = await Connection.SendEnvelopeAsync(envelope).ConfigureAwait(true);
                var result = await Connection.WaitForResultAsync(correlationId, TimeSpan.FromSeconds(10)).ConfigureAwait(true);
                if (result.MessageType != OrganicWireMessageType.Pong)
                    throw new InvalidDataException($"Expected a 1-Wire Pong but received {result.MessageType}.");

                _roundTripStatus = $"1-Wire {result.ProtocolVersion} Ping/Pong succeeded; {Connection.State.RemoteCapabilities.Count} LocalGPT capabilities are currently negotiated.";
                Notifications.Success(_roundTripStatus, "Organic connection verified", nameof(OrganicPlugins));
            }
            catch (Exception exception)
            {
                _roundTripStatus = $"Round-trip test failed: {exception.Message}";
                Notifications.Error(_roundTripStatus, "Organic connection test", nameof(OrganicPlugins));
            }
            await InvokeAsync(StateHasChanged).ConfigureAwait(true);
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(OrganicPlugins)}.{nameof(RunRoundTripTestAsync)} failed.");
            throw;
        }
    }

