@implements IDisposable
@inject IPublisherDocumentationViewerService Viewer
@inject ILogger<DocumentationViewerHost> Logger
@inject ISupervisedTaskRunner TaskRunner
@inject IUserNotificationService Notifications

@if (Viewer.State.IsOpen)
{
    <dialog open
            class="publisher-documentation-native-dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="publisher-documentation-viewer-title"
            @onclick="Close">
        <section class="publisher-documentation-dialog" @onclick:stopPropagation="true">
            <header>
                <h2 id="publisher-documentation-viewer-title">@Viewer.State.Title</h2>
                <div>
                    <a href="@Viewer.State.Url" target="_blank" rel="noopener noreferrer" data-enhance-nav="false">Open in browser tab</a>
                    <button data-documentation-viewer-close type="button" aria-label="Close documentation viewer" @onclick="Close">Close</button>
                </div>
            </header>
            <iframe @key="Viewer.State.Revision" src="@Viewer.State.Url" title="@Viewer.State.Title" loading="eager"></iframe>
        </section>
    </dialog>
}

@code {

    /// <summary>
    /// Handles the initialized lifecycle or event notification for <see cref="DocumentationViewerHost"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnInitialized()
    {
        try
        {
            try
            {
                Viewer.StateChanged += OnViewerStateChanged;
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Subscribing the PublisherStudio documentation viewer failed.");
                Notifications.Error("PublisherStudio could not attach the documentation viewer.", "Documentation viewer", nameof(DocumentationViewerHost));
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(DocumentationViewerHost)}.{nameof(OnInitialized)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Handles the viewer state changed lifecycle or event notification for <see cref="DocumentationViewerHost"/>, updating the state required by the surrounding workflow.
    /// </summary>
    private void OnViewerStateChanged()
    {
        try
        {
            TaskRunner.Run(nameof(DocumentationViewerHost), nameof(RefreshViewerAsync), _ => RefreshViewerAsync());
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(DocumentationViewerHost)}.{nameof(OnViewerStateChanged)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Refreshes viewer for <see cref="DocumentationViewerHost"/>, keeping the operation consistent with the state and invariants of the surrounding documentation viewer host workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task RefreshViewerAsync()
    {
        try
        {
            try
            {
                await InvokeAsync(StateHasChanged).ConfigureAwait(false);
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Refreshing the PublisherStudio documentation viewer state failed.");
                Notifications.Error("PublisherStudio could not refresh the documentation viewer.", "Documentation viewer", nameof(DocumentationViewerHost));
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(DocumentationViewerHost)}.{nameof(RefreshViewerAsync)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Performs close for <see cref="DocumentationViewerHost"/>, keeping the operation consistent with the state and invariants of the surrounding documentation viewer host workflow.
    /// </summary>
    private void Close()
    {
        try
        {
            try
            {
                Viewer.Close();
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Closing the PublisherStudio documentation viewer failed.");
                Notifications.Error("PublisherStudio could not close the documentation viewer.", "Documentation viewer", nameof(DocumentationViewerHost));
            }
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(DocumentationViewerHost)}.{nameof(Close)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Closes from browser for <see cref="DocumentationViewerHost"/>, keeping the operation consistent with the state and invariants of the surrounding documentation viewer host workflow.
    /// </summary>
    [Microsoft.JSInterop.JSInvokable]
    public void CloseFromBrowser() {
        try
        {
            Close();
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(DocumentationViewerHost)}.{nameof(CloseFromBrowser)} failed.");
            throw;
        }
    }

    /// <summary>
    /// Releases resources owned by <see cref="DocumentationViewerHost"/> and leaves the documentation viewer host workflow in a safely disposed state.
    /// </summary>
    public void Dispose()
    {
        try
        {
            Viewer.StateChanged -= OnViewerStateChanged;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, $"Component method {nameof(DocumentationViewerHost)}.{nameof(Dispose)} failed.");
            throw;
        }
    }

}
