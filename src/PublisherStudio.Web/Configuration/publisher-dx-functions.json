    {
      "key": "publisher.screen.capture",
      "displayName": "Eyes: screen capture",
      "description": "Captures one user-selected screen or window only after PublisherStudio confirmation and the browser's current getDisplayMedia prompt.",
      "controller": "OrganicPlugins",
      "method": "POST",
      "route": "/api/organic/capabilities/publisher.screen.capture",
      "parameterSchemaJson": "{\"type\":\"object\",\"properties\":{\"selector\":{\"type\":\"string\"},\"format\":{\"type\":\"string\"},\"quality\":{\"type\":\"number\"}}}",
      "organs": [
        "eyes"
      ],
      "skills": [
        "vision",
        "screen",
        "screenshot"
      ],
      "requiredSkillKeys": [
        "vision",
        "screen",
        "screenshot"
      ],
      "uiActivationKeys": [
        "publisherstudio.screenreader.recurring"
      ],
      "isOnline": true,
      "isEnabled": true,
      "isReadOnly": false,
      "requiresHumanConfirmation": true,
      "supportsScheduling": false,
      "supportsRecurringExecution": false,
      "requiresHumanInteractionOnTargetSystem": true,
      "requiresAutomatedInteractionOnTargetSystem": true,
      "interactionValueSchemaJson": "{\"type\":\"object\",\"properties\":{}}",
      "inputContract": "No image path. The PublisherStudio user selects a screen/window in a fresh browser prompt.",
      "outputContract": "A bounded PNG data URL and pixel metadata returned in the current WorkResult.",
      "securityContract": "Always asks in LocalGPT, always asks in PublisherStudio, and always invokes the browser's current getDisplayMedia permission prompt. Saved permission cannot bypass it.",
      "organicUseCase": "Eyes organ for current visual evidence.",
      "suggestedCouncilRoles": [
        "vision member",
        "evidence verifier"
      ],
      "isExposedToPeer": true,
      "allowPeerInvocation": true,
      "requiresFrontendUserConfirmation": true,
      "interactionEditor": 1,
      "configurationKey": "publisher:publisher.screen.capture",
      "source": "PublisherStudio object store"
    },
