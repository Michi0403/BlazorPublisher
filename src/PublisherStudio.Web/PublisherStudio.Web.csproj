<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>PublisherStudio</RootNamespace>
    <AssemblyName>PublisherStudio.Web</AssemblyName>
    <Version>2.9.6</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <ApplicationIcon>..\..\assets\PublisherStudio.ico</ApplicationIcon>
    <DevExpressVersion>25.2.9</DevExpressVersion>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PrepareSpreadsheetAssetsOnBuild Condition="'$(PrepareSpreadsheetAssetsOnBuild)' == ''">false</PrepareSpreadsheetAssetsOnBuild>
    <SpreadsheetClientAsset>$(MSBuildProjectDirectory)\wwwroot\vendor\devexpress-aspnetcore-spreadsheet\dist\dx-aspnetcore-spreadsheet.js</SpreadsheetClientAsset>
    <DevExtremeRuntimeLicenseAsset>$(MSBuildProjectDirectory)\wwwroot\vendor\devextreme-license.js</DevExtremeRuntimeLicenseAsset>
    <DevExtremeRuntimeLicenseMetadata>$(MSBuildProjectDirectory)\wwwroot\vendor\devextreme-license.meta.json</DevExtremeRuntimeLicenseMetadata>
    <DevExtremeRuntimeKeyGeneratorVersionFile>$(MSBuildProjectDirectory)\wwwroot\vendor\devextreme-license.version</DevExtremeRuntimeKeyGeneratorVersionFile>
    <DevExtremeClientAssetMetadata>$(MSBuildProjectDirectory)\wwwroot\vendor\devextreme-assets.meta.json</DevExtremeClientAssetMetadata>
  </PropertyGroup>
  <ItemGroup>
    <!-- 2.7.5 upgrade compatibility: ignore the transient 2.7.4 logger location if an in-place source update leaves it behind. -->
    <Compile Remove="Logging\FileLogger.cs;Logging\FileLoggerProvider.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LocalGPT.WireProtocolVersion" Version="$(LocalGptWireProtocolVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.Blazor" Version="$(DevExpressVersion)" />
    <PackageReference Include="DevExpress.Blazor.RichEdit" Version="$(DevExpressVersion)" />
    <PackageReference Include="DevExpress.Blazor.de" Version="$(DevExpressVersion)" />
    <PackageReference Include="DevExpress.Blazor.es" Version="$(DevExpressVersion)" />
    <PackageReference Include="DevExpress.Blazor.ja" Version="$(DevExpressVersion)" />
    <PackageReference Include="DevExpress.Blazor.RichEdit.de" Version="$(DevExpressVersion)" />
    <PackageReference Include="DevExpress.Blazor.RichEdit.es" Version="$(DevExpressVersion)" />
    <PackageReference Include="DevExpress.Blazor.RichEdit.ja" Version="$(DevExpressVersion)" />
    <PackageReference Include="DevExpress.AspNetCore.Spreadsheet" Version="$(DevExpressVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="10.0.11" />
    <PackageReference Include="System.CodeDom" Version="10.0.11" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.11" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="System.ServiceModel.Http" Version="10.0.652802" />
    <PackageReference Include="System.ServiceModel.NetTcp" Version="10.0.652802" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="10.0.652802" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\PublisherStudio.ico" Link="PublisherStudio.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Localization\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Configuration\panel-text-patterns.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Configuration\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Configuration\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="wwwroot\help-docs\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    npm/npx are deliberately not invoked during an ordinary Visual Studio build. MSB3073/9009
    otherwise hides the useful error when Node.js is not installed, Visual Studio has an old
    PATH, or the licensed build identity is not registered. Run Prepare-DevExpressAssets.cmd
    once after cloning the source package. The historical Prepare-SpreadsheetAssets.cmd name
    remains as a compatibility alias.

    Automated licensed build agents may opt in with:
      dotnet build -p:PrepareSpreadsheetAssetsOnBuild=true
  -->
  <Target Name="PrepareSpreadsheetClientAssets" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(PrepareSpreadsheetAssetsOnBuild)' == 'true' and (!Exists('$(SpreadsheetClientAsset)') or !Exists('$(DevExtremeRuntimeLicenseAsset)') or !Exists('$(DevExtremeRuntimeLicenseMetadata)') or !Exists('$(DevExtremeRuntimeKeyGeneratorVersionFile)') or !Exists('$(DevExtremeClientAssetMetadata)'))">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\Prepare-DevExpressAssets.ps1&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="SpreadsheetClientAssetBuildNotice" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(PrepareSpreadsheetAssetsOnBuild)' != 'true' and (!Exists('$(SpreadsheetClientAsset)') or !Exists('$(DevExtremeRuntimeLicenseAsset)') or !Exists('$(DevExtremeRuntimeLicenseMetadata)') or !Exists('$(DevExtremeRuntimeKeyGeneratorVersionFile)') or !Exists('$(DevExtremeClientAssetMetadata)'))">
    <Warning Text="DevExpress browser assets or the generated public DevExtreme runtime license are not prepared. Run Prepare-DevExpressAssets.cmd once from the solution root on a licensed developer/build machine. The .NET solution may compile without them, but Spreadsheet Studio and standalone HTML export will not be release-ready." />
  </Target>

  <Target Name="ValidateSpreadsheetClientAssetsForPublish" BeforeTargets="ComputeFilesToPublish" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(SpreadsheetClientAsset)')" Text="Spreadsheet Studio browser assets are missing. Run Prepare-DevExpressAssets.cmd from the solution root before publishing." />
    <Error Condition="!Exists('$(DevExtremeRuntimeLicenseAsset)')" Text="The generated public DevExtreme runtime license is missing. Run Prepare-DevExpressAssets.cmd on the licensed build machine before publishing." />
    <Error Condition="!Exists('$(DevExtremeRuntimeLicenseMetadata)')" Text="The DevExtreme runtime-license metadata is missing. Run Prepare-DevExpressAssets.cmd again before publishing." />
    <Error Condition="!Exists('$(DevExtremeRuntimeKeyGeneratorVersionFile)')" Text="The DevExtreme runtime-key generator version marker is missing. Run Prepare-DevExpressAssets.cmd again before publishing." />
    <Error Condition="!Exists('$(DevExtremeClientAssetMetadata)')" Text="The DevExtreme client-asset metadata is missing. Run Prepare-DevExpressAssets.cmd again before publishing." />
    <ReadLinesFromFile File="$(DevExtremeRuntimeKeyGeneratorVersionFile)" Condition="Exists('$(DevExtremeRuntimeKeyGeneratorVersionFile)')">
      <Output TaskParameter="Lines" ItemName="DevExtremeRuntimeKeyGeneratorVersionLines" />
    </ReadLinesFromFile>
    <Error Condition="Exists('$(DevExtremeRuntimeKeyGeneratorVersionFile)') and '@(DevExtremeRuntimeKeyGeneratorVersionLines)' != '$(DevExpressVersion)'" Text="The DevExtreme runtime key was generated with devextreme version '@(DevExtremeRuntimeKeyGeneratorVersionLines)', but this project uses $(DevExpressVersion). Run Prepare-DevExpressAssets.cmd again." />
  </Target>
  <ItemGroup>
    <PublisherStudioConfigurationFile Include="appsettings*.json;Configuration\**\*;Localization\**\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PublisherStudioDocumentationPublishFile Include="wwwroot\help-docs\index.html;wwwroot\help-docs\api\index.html;wwwroot\help-docs\documentation-status.json;wwwroot\help-docs\public\docfx.min.css;wwwroot\help-docs\public\docfx.min.js;wwwroot\help-docs\styles\publisherstudio-kawaii.css;wwwroot\help-docs\styles\publisherstudio-kawaii.js" />
  </ItemGroup>

  <Target Name="ValidatePublisherStudioDocumentationFilesForPublish" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true' and '$(PublishDir)' != ''">
    <ItemGroup>
      <MissingPublisherStudioDocumentationPublishFile Include="@(PublisherStudioDocumentationPublishFile)" Condition="!Exists('$(PublishDir)%(Identity)')" />
    </ItemGroup>
    <Error Condition="'@(MissingPublisherStudioDocumentationPublishFile)' != ''" Text="PublisherStudio publish output is missing installed HTML documentation files: @(MissingPublisherStudioDocumentationPublishFile, ', ')" />
  </Target>

  <Target Name="ValidatePublisherConfigurationFilesForPublish" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true' and '$(PublishDir)' != ''">
    <ItemGroup>
      <MissingPublisherStudioConfigurationFile Include="@(PublisherStudioConfigurationFile)" Condition="!Exists('$(PublishDir)%(Identity)')" />
    </ItemGroup>
    <Error Condition="'@(MissingPublisherStudioConfigurationFile)' != ''" Text="PublisherStudio publish output is missing configuration files: @(MissingPublisherStudioConfigurationFile, ', ')" />
  </Target>

</Project>
