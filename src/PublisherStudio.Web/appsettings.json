      "RegexPatterns": {
        "PublicationBody": {
          "Pattern": "<body[^>]*>([\\s\\S]*?)</body>",
          "Options": "IgnoreCase, CultureInvariant",
          "TimeoutMilliseconds": 2000
        },
        "PublicationStyle": {
          "Pattern": "<style[^>]*>[\\s\\S]*?</style>",
          "Options": "IgnoreCase, CultureInvariant",
          "TimeoutMilliseconds": 2000
        },
        "PublicationDangerousElements": {
          "Pattern": "<(script|iframe|object|embed|form|input|button|meta|link)[^>]*>[\\s\\S]*?</\\1\\s*>|<(script|iframe|object|embed|form|input|button|meta|link)[^>]*/?>",
          "Options": "IgnoreCase, CultureInvariant",
          "TimeoutMilliseconds": 2000
        },
        "PublicationEventAttribute": {
          "Pattern": "\\s+on[a-z]+\\s*=\\s*(?:\"[^\"]*\"|\\'[^\\']*\\'|[^\\s>]+)",
          "Options": "IgnoreCase, CultureInvariant",
          "TimeoutMilliseconds": 2000
        },
        "PublicationJavascriptUrl": {
          "Pattern": "(href|src)\\s*=\\s*[\"\\']?\\s*javascript:[^\\s>\"\\']*",
          "Options": "IgnoreCase, CultureInvariant",
          "TimeoutMilliseconds": 2000
        },
        "CodeString": {
          "Pattern": "(?:\"(?:\\\\.|[^\"])*\"|\\'(?:\\\\.|[^\\'])*\\')",
          "Options": "Compiled, CultureInvariant",
          "TimeoutMilliseconds": 2000
        },
        "CodeNumber": {
          "Pattern": "\\b(?:0x[0-9a-f]+|\\d+(?:\\.\\d+)?)\\b",
          "Options": "IgnoreCase, Compiled, CultureInvariant",
          "TimeoutMilliseconds": 2000
        },
        "OpenDocumentLength": {
          "Pattern": "^([+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:e[+-]?\\d+)?)\\s*(mm|cm|in|pt|pc|px)?$",
          "Options": "IgnoreCase, CultureInvariant",
          "TimeoutMilliseconds": 2000
        },
        "OpenDocumentRotate": {
          "Pattern": "rotate\\s*\\(\\s*([+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+))",
          "Options": "IgnoreCase, CultureInvariant",
          "TimeoutMilliseconds": 2000
        },
        "OpenDocumentColor": {
          "Pattern": "^(?:#[0-9a-f]{3,8}|rgba?\\([^)]*\\)|hsla?\\([^)]*\\)|transparent)$",
          "Options": "IgnoreCase, CultureInvariant",
          "TimeoutMilliseconds": 2000
        },
        "VideoEdlEvent": {
          "Pattern": "^\\s*(?<event>\\d+)\\s+(?<reel>\\S+)\\s+(?<track>\\S+)\\s+(?<transition>\\S+)(?:\\s+\\d+)?\\s+(?<sourceIn>\\d{2}[:;]\\d{2}[:;]\\d{2}[:;]\\d{2})\\s+(?<sourceOut>\\d{2}[:;]\\d{2}[:;]\\d{2}[:;]\\d{2})\\s+(?<recordIn>\\d{2}[:;]\\d{2}[:;]\\d{2}[:;]\\d{2})\\s+(?<recordOut>\\d{2}[:;]\\d{2}[:;]\\d{2}[:;]\\d{2})\\s*$",
          "Options": "IgnoreCase, CultureInvariant",
          "TimeoutMilliseconds": 2000
        },
        "VideoEdlClipName": {
          "Pattern": "^\\s*\\*\\s*(?:FROM\\s+)?CLIP\\s+NAME\\s*:\\s*(?<name>.+?)\\s*$",
          "Options": "IgnoreCase, CultureInvariant",
          "TimeoutMilliseconds": 2000
        },
        "VideoEdlSourceFile": {
          "Pattern": "^\\s*\\*\\s*(?:SOURCE|FROM)\\s+FILE\\s*:\\s*(?<path>.+?)\\s*$",
          "Options": "IgnoreCase, CultureInvariant",
          "TimeoutMilliseconds": 2000
        },
        "MediaDuration": {
          "Pattern": "Duration:\\s*(?<h>\\d+):(?<m>\\d+):(?<s>\\d+(?:\\.\\d+)?)",
          "Options": "IgnoreCase, CultureInvariant",
          "TimeoutMilliseconds": 2000
        },
        "NativeDirectShowDevice": {
          "Pattern": "\"(?<name>[^\"]+)\"\\s*\\((?<type>video|audio)\\)",
          "Options": "IgnoreCase, CultureInvariant",
          "TimeoutMilliseconds": 2000
        },
        "NativeAvFoundationDevice": {
          "Pattern": "\\[(?<index>\\d+)\\]\\s+(?<name>.+)$",
          "Options": "CultureInvariant",
          "TimeoutMilliseconds": 2000
        }
      },
